---
import Layout from '../layouts/Layout.astro';
import FeaturesBuiltWithSection from '../components/features/FeaturesBuiltWithSection.astro';
import { getCompanyConfig } from '../lib/companyConfig';
import { ArrowRight } from 'lucide-astro';

const company = await getCompanyConfig(Astro.request);
---

<Layout
  title="Platform"
  description={`How ${company.name} is built — production-grade stack on Railway and Postgres, deploy as a full website, standalone app, or both.`}
>
  <div class="platform-page">
    <section class="platform-hero scroll-fade-in" aria-labelledby="platform-title">
      <p class="platform-kicker">Under the hood</p>
      <h1 id="platform-title" class="platform-h1">Platform</h1>
      <p class="platform-lead">
        {company.name} is not a no-code wrapper — it is a real codebase you own, deployed
        on Railway with Postgres, Clerk, Resend, and the services below. Run it as a
        public website, a standalone admin + portal app, or both on one domain.
      </p>
      <div class="platform-cta-row">
        <a class="platform-btn platform-btn--primary" href="/demo">
          Demo now
          <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
        </a>
        <a class="platform-btn platform-btn--ghost brand-btn-glass" href="/features"
          >Feature tour</a
        >
      </div>
    </section>

    <FeaturesBuiltWithSection />
  </div>
</Layout>

<style>
  .platform-page {
    min-height: 100vh;
    padding: calc(
        var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) +
          40px
      )
      20px 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .platform-hero {
    width: 100%;
    max-width: 760px;
    text-align: center;
    margin-bottom: 24px;
  }

  .platform-kicker {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a78bfa;
    margin: 0 0 14px;
  }

  .platform-h1 {
    margin: 0 0 16px;
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: #fff;
  }

  .platform-lead {
    margin: 0 auto 28px;
    max-width: 580px;
    font-family: var(--font-content);
    font-size: 1.02rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.68);
  }

  .platform-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .platform-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      filter 0.15s ease;
    white-space: nowrap;
  }

  .platform-btn--primary {
    color: #0b0512;
    background: linear-gradient(145deg, #f472b6 0%, #c026d3 52%, #6366f1 100%);
    box-shadow: 0 8px 24px rgba(192, 38, 211, 0.35);
  }

  .platform-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .platform-btn--ghost:hover {
    transform: translateY(-1px);
  }
</style>
