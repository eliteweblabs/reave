---
/**
 * Public Digital Audit — same Siri audit pipeline + portal report card.
 * Provide a business name (and optional website), Generate, then watch the
 * online-presence diagnostic fill in.
 */
import Layout from '../layouts/MarketingLayout.astro';
import PortalAuditReportCard from '../components/PortalAuditReportCard.astro';
import { getCompanyConfig } from '../lib/companyConfig';
import { hasFeature } from '../lib/features';
import { isSafeWorkSlug, storeReadWork } from '../lib/workStore';
import { AUDIT_SCAN_STACK, buildAuditReportCard, isAuditJob } from '../lib/auditReportCard';
import { googlePlacesListedForContact } from '../lib/auditPlacesListing';
import { getSiriAuditRun } from '../lib/siriAuditRuns';
export const prerender = false;

const company = await getCompanyConfig(Astro.request);
const auditsEnabled = hasFeature('site_audits');

const runSlug = (Astro.url.searchParams.get('run') || '').trim().toLowerCase();
let report: ReturnType<typeof buildAuditReportCard> = null;
let clientName = '';
let bodyHtml = '';
let inProgress = false;
let runLabel = '';

if (auditsEnabled && runSlug && isSafeWorkSlug(runSlug)) {
  const doc = await storeReadWork(runSlug);
  if (
    doc &&
    (doc.source === 'siri_audit' ||
      isAuditJob({
        tags: doc.tags,
        source: doc.source,
        title: doc.title,
        body: doc.body,
      }))
  ) {
    clientName = (doc.contact_name || '').trim();
    const googlePlacesListed = await googlePlacesListedForContact(doc.contact_uid);
    report = buildAuditReportCard({
      tags: doc.tags,
      source: doc.source,
      title: doc.title,
      body: doc.body || '',
      clientName,
      googlePlacesListed,
    });
    runLabel = clientName || doc.title || runSlug;
    const activeRun = getSiriAuditRun(runSlug);
    inProgress = Boolean(report?.inProgress) || Boolean(activeRun);
    if (!inProgress && doc.body?.trim()) {
      bodyHtml = escapeLines(doc.body.trim());
    }
  }
}

function escapeLines(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .split('\n')
    .map((line) => (line.trim() ? line : '&nbsp;'))
    .join('<br />');
}

const showResults = Boolean(report);

/** Prefill from ?url=&business= (e.g. “reproduce here” from a report card). */
const prefillUrl = (Astro.url.searchParams.get('url') || '').trim().slice(0, 400);
const prefillBusiness = (Astro.url.searchParams.get('business') || '').trim().slice(0, 300);
const openOptionalDetails = Boolean(prefillUrl);
---

<Layout
  title="Digital Audit"
  description={`Free online presence diagnostic from ${company.name} — enter a business name and get the same audit report we use for clients.`}
>
  <div class="da-page" data-da-page data-run={showResults ? runSlug : ''} data-in-progress={inProgress ? '1' : '0'}>
    <header class="da-hero" aria-labelledby="da-title">
      <p class="da-kicker">Free diagnostic</p>
      <h1 id="da-title" class="da-h1">Digital Audit</h1>
      {!showResults && (
        <p class="da-lead">
          Tell us who to check. We’ll scan the website, listings, and reputation — then show the
          same report card we build for clients.
        </p>
      )}
      {showResults && runLabel && (
        <p class="da-lead">
          {inProgress ? `Auditing ${runLabel}…` : `Results for ${runLabel}`}
        </p>
      )}
    </header>

    {!auditsEnabled ? (
      <p class="da-unavailable" role="status">Digital audits aren’t available on this install.</p>
    ) : !showResults ? (
      <form id="da-form" class="da-form" autocomplete="on">
        <label class="da-field da-field--main">
          <span class="da-label">Business</span>
          <input
            id="da-business"
            name="business"
            type="text"
            required
            maxlength="300"
            placeholder="Joe’s Pizza on Main Street in Portland"
            autocomplete="organization"
            autofocus
            value={prefillBusiness}
          />
        </label>

        <details class="da-more" open={openOptionalDetails || undefined}>
          <summary>Optional details</summary>
          <div class="da-more-fields">
            <label class="da-field">
              <span class="da-label">Website</span>
              <input
                id="da-url"
                name="url"
                type="url"
                maxlength="400"
                placeholder="https://example.com"
                autocomplete="url"
                inputmode="url"
                value={prefillUrl}
              />
            </label>
            <label class="da-field">
              <span class="da-label">Phone</span>
              <input id="da-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" />
            </label>
            <label class="da-field">
              <span class="da-label">Email</span>
              <input id="da-email" name="email" type="email" maxlength="120" autocomplete="email" />
            </label>
            <label class="da-field">
              <span class="da-label">Notes</span>
              <input id="da-notes" name="notes" type="text" maxlength="500" placeholder="Anything else that helps find them" />
            </label>
          </div>
        </details>

        {/* Honeypot — leave empty */}
        <label class="da-hp" aria-hidden="true">
          <span>Company website</span>
          <input type="text" name="website_url" tabindex="-1" autocomplete="off" />
        </label>

        <p id="da-error" class="da-error" hidden></p>

        <div class="da-actions">
          <button type="submit" class="brand-btn brand-btn-solid da-submit" id="da-submit">
            Generate
          </button>
        </div>
      </form>

      <section class="da-stack" aria-label="Audit tech stack">
        <p class="da-stack-kicker">How we scan</p>
        <ul class="da-stack-list">
          {AUDIT_SCAN_STACK.map((tool) => (
            <li class="da-stack-item">
              <span class="da-stack-name">{tool.name}</span>
              <span class="da-stack-role">{tool.role}</span>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <div class="da-results">
        <PortalAuditReportCard
          report={report!}
          bodyHtml={bodyHtml}
          clientName={clientName}
        />
        {!inProgress && (
          <p class="da-again">
            <a class="brand-btn brand-btn-glass" href="/digital-audit">Run another audit</a>
          </p>
        )}
      </div>
    )}
  </div>

  <script>
    const page = document.querySelector('[data-da-page]');
    if (!page) {
      // no-op
    } else {
      const form = document.getElementById('da-form') as HTMLFormElement | null;
      const errorEl = document.getElementById('da-error');
      const submitBtn = document.getElementById('da-submit') as HTMLButtonElement | null;
      const runSlug = page.getAttribute('data-run') || '';
      const wasInProgress = page.getAttribute('data-in-progress') === '1';

      function showError(msg: string) {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.hidden = !msg;
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        showError('');
        const fd = new FormData(form);
        const business = String(fd.get('business') || '').trim();
        if (!business) {
          showError('Enter a business name to get started.');
          return;
        }
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Starting…';
        }
        try {
          const res = await fetch('/api/digital-audit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              business,
              url: String(fd.get('url') || '').trim(),
              phone: String(fd.get('phone') || '').trim(),
              email: String(fd.get('email') || '').trim(),
              notes: String(fd.get('notes') || '').trim(),
              website_url: String(fd.get('website_url') || '').trim(),
              tier: 'quick',
            }),
          });
          const data = (await res.json().catch(() => ({}))) as {
            ok?: boolean;
            error?: string;
            data?: { slug?: string };
          };
          if (!res.ok || !data.ok || !data.data?.slug) {
            showError(data.error || 'Could not start the audit. Try again in a moment.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Generate';
            }
            return;
          }
          window.location.href = `/digital-audit?run=${encodeURIComponent(data.data.slug)}`;
        } catch {
          showError('Network error — check your connection and try again.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Generate';
          }
        }
      });

      // Poll while the diagnostic is building, then soft-reload for the full card.
      if (runSlug && wasInProgress) {
        let stopped = false;
        const poll = async () => {
          if (stopped) return;
          try {
            const res = await fetch(
              `/api/digital-audit?slug=${encodeURIComponent(runSlug)}`,
              { headers: { Accept: 'application/json' } },
            );
            const data = (await res.json().catch(() => ({}))) as {
              ok?: boolean;
              data?: { inProgress?: boolean };
            };
            if (data.ok && data.data && data.data.inProgress === false) {
              stopped = true;
              window.location.reload();
              return;
            }
          } catch {
            // keep polling
          }
          if (!stopped) window.setTimeout(poll, 4000);
        };
        window.setTimeout(poll, 3500);
      }
    }
  </script>
</Layout>

<style>
  .da-page {
    padding: 0 var(--site-page-gutter, 20px) calc(96px + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .da-hero {
    width: 100%;
    max-width: 760px;
    text-align: center;
    margin-bottom: 36px;
  }

  .da-kicker {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--site-fg-muted);
    margin: 0 0 14px;
  }

  .da-h1 {
    margin: 0 0 16px;
    font-family: var(--font-primary);
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--site-fg);
  }

  .da-lead {
    margin: 0 auto;
    max-width: 580px;
    font-family: var(--font-content);
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--site-fg-muted);
  }

  .da-form {
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .da-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .da-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--site-fg);
  }

  .da-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--site-border);
    background: var(--site-card);
    color: var(--site-fg);
    font-size: 1rem;
    line-height: 1.3;
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .da-field input::placeholder {
    color: var(--site-fg-faint);
  }

  .da-field--main input {
    font-size: 1.05rem;
    padding: 14px 16px;
  }

  .da-field input:focus {
    border-color: var(--site-fg);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--site-fg) 12%, transparent);
  }

  .da-more {
    border-radius: 12px;
    border: 1px solid var(--site-border);
    background: var(--site-card);
    padding: 4px 14px 10px;
  }

  .da-more summary {
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--site-fg-muted);
    padding: 10px 0;
    list-style: none;
  }

  .da-more summary::-webkit-details-marker {
    display: none;
  }

  .da-more[open] summary {
    color: var(--site-fg);
  }

  .da-more-fields {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 8px;
  }

  .da-hp {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }

  .da-error {
    margin: 0;
    color: #f87171;
    font-size: 0.95rem;
  }

  .da-actions {
    display: flex;
    justify-content: flex-start;
  }

  .da-stack {
    width: 100%;
    max-width: 560px;
    margin-top: 36px;
    text-align: center;
  }

  .da-stack-kicker {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--site-fg-faint);
    margin: 0 0 14px;
  }

  .da-stack-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .da-stack-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 10px;
    border-radius: 12px;
    border: 1px solid var(--site-card-border);
    background: var(--site-card);
    text-align: left;
  }

  .da-stack-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--site-fg);
  }

  .da-stack-role {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--site-fg-faint);
  }

  .da-submit.brand-btn {
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
  }

  .da-submit:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .da-submit:hover:not(:disabled) {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .da-unavailable {
    text-align: center;
    color: var(--site-fg-muted);
  }

  .da-results {
    width: 100%;
    max-width: 640px;
  }

  .da-again {
    text-align: center;
    margin: 28px 0 0;
  }

  .da-again .brand-btn {
    font-size: 0.92rem;
  }

  @media (max-width: 560px) {
    .da-page {
      padding-left: 14px;
      padding-right: 14px;
    }
  }
</style>
