---
/**
 * Alternate focus chat skin — minimal full-screen agent chats with a speed-dial
 * FAB. Gated by install config `chatFocusSkin: true` (see `src/lib/chatFocusSkin.ts`).
 *
 * New chats ask "Is this a new or existing project?" before opening. Existing
 * projects can be linked for reference; the full admin chat UI is unchanged.
 */
import Favicon from '../components/Favicon.astro';
import BrandFontHead from '../components/BrandFontHead.astro';
import ViewportMeta from '../components/ViewportMeta.astro';
import IosBottomSheet from '../components/IosBottomSheet.astro';
import { companyHtmlStyleAttr } from '../lib/companyBrandColors';
import { getCompanyConfig, companyToBrandContext, companyStaffAvatarUrl } from '../lib/companyConfig';
import { isChatFocusSkinEnabled } from '../lib/chatFocusSkin';
import '../styles/brand.css';

export const prerender = false;

const { userId } = Astro.locals.auth();
if (!isChatFocusSkinEnabled()) {
  return Astro.redirect('/admin/', 302);
}
if (!userId) {
  const returnTo = encodeURIComponent('/focus' + Astro.url.search);
  return Astro.redirect(`/admin/?auth=sign-in&returnTo=${returnTo}`, 302);
}

const company = await getCompanyConfig(Astro.request);
const companyBrand = companyToBrandContext(company, Astro.request);
const staffAvatarUrl = companyStaffAvatarUrl(company);
const chatId = Astro.url.searchParams.get('chat')?.trim() || '';
---

<!doctype html>
<html lang="en" style={companyHtmlStyleAttr(company.fonts, company.brandPrimary, company.brandSecondary)}>
  <head>
    <meta charset="utf-8" />
    <ViewportMeta />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0d14" media="(prefers-color-scheme: dark)" />
    <title>Session — {company.name}</title>
    <Favicon />
    <BrandFontHead fonts={company.fonts} />
  </head>
  <body class="focus-body">
    <div
      id="focus-root"
      class="focus-root"
      data-company-name={companyBrand.name}
      data-chat-id={chatId}
    >
      <div id="focus-idle" class="focus-idle">
        <p class="focus-idle-kicker">{companyBrand.name}</p>
        <h1 class="focus-idle-heading">What are we working on?</h1>
        <p class="focus-idle-sub">Tap <strong>+</strong> to start a chat. Link a project anytime for context.</p>
      </div>

      <header id="focus-header" class="focus-header" hidden>
        <button id="focus-back" class="focus-icon-btn" type="button" aria-label="Back">
          <!-- IOS_ICONS.chevron-left — keep in sync with public/admin/admin-ui.js -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div id="focus-project-chips" class="focus-project-chips"></div>
        <button id="focus-add-project" class="focus-icon-btn" type="button" aria-label="Add project reference">
          <!-- IOS_ICONS.plus — keep in sync with public/admin/admin-ui.js -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        </button>
      </header>

      <main id="focus-chat" class="focus-chat" hidden>
        <div id="focus-thread-root" class="focus-thread-root"></div>
      </main>

      <IosBottomSheet
        id="focus-project-prompt"
        title="Is this a new or existing project?"
        titleId="focus-project-prompt-title"
        dismissible={true}
        class="focus-sheet"
      >
        <p class="focus-overlay-sub">Linking a project gives the agent files, notes, and history for reference.</p>
        <div class="focus-prompt-actions">
          <button type="button" class="focus-prompt-btn" data-focus-project-kind="new">New project</button>
          <button type="button" class="focus-prompt-btn focus-prompt-btn-primary" data-focus-project-kind="existing">Existing project</button>
        </div>
      </IosBottomSheet>

      <IosBottomSheet
        id="focus-project-picker"
        title="Choose a project"
        titleId="focus-picker-title"
        dismissible={true}
        class="focus-sheet focus-sheet--list"
      >
        <input id="focus-project-search" class="focus-project-search" type="search" placeholder="Search projects…" autocomplete="off" />
        <div id="focus-project-list" class="focus-project-list"></div>
      </IosBottomSheet>

      <IosBottomSheet
        id="focus-recent"
        title="Recent sessions"
        titleId="focus-recent-title"
        dismissible={true}
        class="focus-sheet focus-sheet--list"
      >
        <div id="focus-recent-list" class="focus-recent-list"></div>
      </IosBottomSheet>

      <nav id="focus-dial" class="focus-dial" aria-label="Session actions">
        <button type="button" class="focus-dial-action" data-focus-dial-action="new">
          <span class="focus-dial-action-label">New session</span>
        </button>
        <button type="button" class="focus-dial-action" data-focus-dial-action="recent">
          <span class="focus-dial-action-label">Recent</span>
        </button>
        <button type="button" class="focus-dial-action" data-focus-dial-action="admin">
          <span class="focus-dial-action-label">Full dashboard</span>
        </button>
        <button id="focus-fab" class="focus-fab" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="Session menu">
          <!-- IOS_ICONS.plus / IOS_ICONS.x — keep in sync with public/admin/admin-ui.js -->
          <svg class="focus-fab-icon-plus" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          <svg class="focus-fab-icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </nav>
    </div>

    <script is:inline define:vars={{ staffAvatarUrl }}>
      window.__companyStaffAvatarUrl = staffAvatarUrl;
    </script>
    <script>
      import '../admin/agent-chat-mount.tsx';
    </script>
    <script is:inline src={`/ios-sheet.js?v=${__PUBLIC_ASSET_VERSION__}`} defer></script>
    <script src="/focus/focus-chat.js" defer></script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --fg: #0f172a;
    --muted: #64748b;
    --card-border: #e2e8f0;
    --surface-hover: rgba(0, 0, 0, 0.05);
    --footer-nav-h: 0px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a0d14;
      --fg: #f1f5f9;
      --muted: #94a3b8;
      --card-border: rgba(255, 255, 255, 0.1);
      --surface-hover: rgba(255, 255, 255, 0.06);
    }
  }

  html,
  body.focus-body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-primary, system-ui, sans-serif);
    -webkit-font-smoothing: antialiased;
  }

  .focus-root {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .focus-idle {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem calc(env(safe-area-inset-bottom) + 6rem);
    text-align: center;
  }

  body.focus-chat-active .focus-idle {
    display: none;
  }

  body.focus-chat-active .focus-dial {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .focus-idle-kicker {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .focus-idle-heading {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 5vw, 2.35rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .focus-idle-sub {
    margin: 0;
    max-width: 22rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .focus-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: max(env(safe-area-inset-top), 0.65rem) 0.75rem 0.5rem;
    border-bottom: 1px solid var(--card-border);
    background: var(--bg);
    z-index: 2;
  }

  .focus-icon-btn {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }

  .focus-icon-btn:active {
    background: var(--surface-hover);
  }

  .focus-project-chips {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: center;
  }

  .focus-project-chip {
    max-width: 100%;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--card-border);
    background: var(--surface-hover);
    color: var(--fg);
    font: inherit;
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
  }

  .focus-chat {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .focus-thread-root {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .focus-sheet .ios-sheet {
    --ios-sheet-bg: var(--bg);
    --ios-sheet-fg: var(--fg);
    --ios-sheet-border: var(--card-border);
    --ios-sheet-muted: var(--muted);
    --ios-sheet-grabber: color-mix(in srgb, var(--muted) 55%, transparent);
    --ios-sheet-close-bg: var(--surface-hover);
    --ios-sheet-close-hover: color-mix(in srgb, var(--muted) 25%, transparent);
    max-width: 420px;
  }

  .focus-sheet--list .ios-sheet {
    max-height: min(70vh, 520px);
  }

  .focus-sheet--list .ios-sheet-body {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .focus-overlay-sub {
    margin: 0 0 1.1rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .focus-prompt-actions {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .focus-prompt-btn {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--card-border);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    text-align: center;
  }

  .focus-prompt-btn-primary {
    background: var(--create-fab-bg, linear-gradient(135deg, #a855f7, #ec4899));
    border-color: transparent;
    color: #fff;
    font-weight: 500;
  }

  .focus-project-search {
    width: 100%;
    margin-bottom: 0.65rem;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    border: 1px solid var(--card-border);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 0.95rem;
  }

  .focus-project-list,
  .focus-recent-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .focus-picker-item,
  .focus-recent-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.7rem 0.85rem;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .focus-picker-item:hover,
  .focus-recent-item:hover,
  .focus-picker-item:focus-visible,
  .focus-recent-item:focus-visible {
    background: var(--surface-hover);
    border-color: var(--card-border);
  }

  .focus-recent-item.active {
    border-color: color-mix(in srgb, var(--brand-magenta, #c026d3) 40%, var(--card-border));
  }

  .focus-recent-copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .focus-recent-author-icon {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 7px;
    overflow: hidden;
    border: 1px solid var(--card-border);
    background: var(--card);
  }

  .focus-recent-author-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1px;
    display: block;
  }

  .focus-picker-title,
  .focus-recent-title {
    font-size: 0.95rem;
    font-weight: 500;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .focus-picker-sub,
  .focus-recent-sub {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .focus-picker-empty,
  .focus-recent-empty {
    margin: 0.5rem 0;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }

  .focus-dial {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: calc(env(safe-area-inset-bottom) + 20px);
    z-index: 70;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.55rem;
  }

  .focus-dial-action {
    display: flex;
    align-items: center;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--card-border);
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-size: 0.85rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease;
  }

  .focus-dial.open .focus-dial-action {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .focus-dial.open .focus-dial-action:nth-child(1) { transition-delay: 0.02s; }
  .focus-dial.open .focus-dial-action:nth-child(2) { transition-delay: 0.05s; }
  .focus-dial.open .focus-dial-action:nth-child(3) { transition-delay: 0.08s; }

  .focus-fab {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: var(--create-fab-bg, var(--brand-gradient));
    border: none;
    box-shadow: var(--create-fab-shadow, 0 8px 24px rgba(192, 38, 211, 0.45));
    cursor: pointer;
    transition: transform 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .focus-fab:active {
    transform: scale(0.93);
  }

  .focus-fab-icon-close {
    display: none;
  }

  .focus-dial.open .focus-fab .focus-fab-icon-plus {
    display: none;
  }

  .focus-dial.open .focus-fab .focus-fab-icon-close {
    display: block;
  }
</style>
