---
import Layout from "../layouts/MarketingLayout.astro";
import FeaturesPricingSection from "../components/features/FeaturesPricingSection.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import { ArrowRight } from "lucide-astro";

const company = await getCompanyConfig(Astro.request);
---

<Layout
  title="Pricing"
  description={`${company.name} installation tiers — Core OS, Operations, Growth, and Full platform. Month-one ramp, flat monthly fee from month five.`}
>
  <div class="pricing-page">
    <section
      class="pricing-hero scroll-fade-in"
      aria-labelledby="pricing-title"
    >
      <h1 id="pricing-title" class="pricing-h1">Pricing</h1>
      <p class="pricing-lead">
        Four tiers mapped to how much of the Business OS you need on day one.
        Every tier includes the 90% core — CRM, inbox triage, client portal,
        agentic support, push notifications and more — with higher tiers adding
        operations, growth, and industry plugins.
      </p>
      <div class="pricing-cta-row">
        <a class="pricing-btn pricing-btn--primary" href="/demo-loader">
          Demo now
          <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
        </a>
        <a
          class="pricing-btn pricing-btn--ghost brand-btn-glass"
          href="/features">Platform tour</a
        >
      </div>
    </section>

    <FeaturesPricingSection variant="standalone" />
  </div>
</Layout>

<style>
  .pricing-page {
    padding: 0 var(--site-page-gutter, 20px) calc(96px + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pricing-hero {
    width: 100%;
    max-width: 760px;
    text-align: center;
    margin-bottom: 32px;
  }

  .pricing-kicker {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--site-fg-muted, #525252);
    margin: 0 0 14px;
  }

  .pricing-h1 {
    margin: 0 0 16px;
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--site-fg, #171717);
  }

  .pricing-lead {
    margin: 0 auto 28px;
    max-width: 580px;
    font-family: var(--font-content);
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--site-fg-muted, #525252);
  }

  .pricing-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .pricing-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      filter 0.15s ease;
    white-space: nowrap;
  }

  .pricing-btn--primary {
    color: #fff;
    -webkit-text-fill-color: #fff;
    background: var(--brand-gradient);
    box-shadow: var(--brand-gradient-shadow);
  }

  .pricing-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .pricing-btn--ghost:hover {
    transform: translateY(-1px);
  }
</style>
