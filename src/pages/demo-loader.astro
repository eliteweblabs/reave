---
/**
 * /demo-loader — public page to pick modules + industry and request a custom demo.
 */
import Layout from "../layouts/Layout.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import "../styles/demo-loader.css";

export const prerender = false;

const company = await getCompanyConfig(Astro.request);
---

<Layout
  title="Demo loader"
  description={`Request a custom ${company.name} demo — pick the modules your business needs and an industry preset.`}
>
  <div class="demo-loader-page">
    <header class="dl-hero">
      <p class="dl-kicker">Try it yourself</p>
      <h1 class="dl-h1">Build your demo</h1>
      <p class="dl-lead">
        Every demo starts with the core platform — CRM, portal, billing, agent
        chat, and more. Pick optional modules below — only
        <strong>Deployed</strong> ones can be toggled on — then enter your name
        and email to request a personalized demo environment.
      </p>
      <p class="dl-notice" role="note">
        We’ll prepare your sandbox and notify you as soon as it’s ready.
      </p>
    </header>

    <div id="demo-loader-app" class="dl-app" aria-live="polite">
      <p class="dl-loading">Loading modules…</p>
    </div>
  </div>

  <script is:inline src={`/demo-loader.js?v=${__PUBLIC_ASSET_VERSION__}`}></script>
</Layout>
