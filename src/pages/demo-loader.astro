---
/**
 * /demo-loader — public page to pick modules + industry and request a custom demo.
 */
import Layout from "../layouts/MarketingLayout.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import "../styles/demo-loader.css";

export const prerender = false;

const company = await getCompanyConfig(Astro.request);
---

<Layout
  title="Demo loader"
  description={`Request a custom ${company.name} demo — pick the modules your business needs and an industry preset.`}
>
  <div class="demo-loader-page">
    <header class="dl-hero">
      <h1 class="dl-h1">Spec to your needs, not maximum profit</h1>
      <p class="dl-lead">
        Pick the optional modules you want or select from pre-configured
        packages. No credit card necessary. Check your inbox in ~five
        minutes.
      </p>
    </header>

    <div
      id="demo-loader-app"
      class="dl-app"
      data-toggles="true"
      aria-live="polite"
    >
      <p class="dl-loading">Loading modules…</p>
    </div>
  </div>

  <script is:inline src={`/module-loader-shared.js?v=${__PUBLIC_ASSET_VERSION__}`}></script>
  <script is:inline src={`/demo-loader.js?v=${__PUBLIC_ASSET_VERSION__}`}></script>
</Layout>
