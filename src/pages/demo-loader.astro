---
/**
 * /demo-loader — public page to pick production modules + industry and launch the live demo.
 */
import Layout from "../layouts/Layout.astro";
import SiteAssistantWidget from "../components/SiteAssistantWidget.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import { hasFeature } from "../lib/features";
import { getPublicDemoSiteUrl } from "../lib/publicDemo";
import { isSiteAssistantConfigured } from "../lib/siteAssistant";

export const prerender = false;

const company = await getCompanyConfig(Astro.request);
const demoSiteUrl = getPublicDemoSiteUrl();
const showSiteAssistant =
  hasFeature("portal_assistant") && isSiteAssistantConfigured();
---

<Layout
  title="Demo loader"
  description={`Configure a live ${company.name} demo — pick the modules your business needs and an industry preset, then open the sandbox.`}
>
  <div class="demo-loader-page">
    <header class="dl-hero">
      <p class="dl-kicker">Try it yourself</p>
      <h1 class="dl-h1">Build your demo</h1>
      <p class="dl-lead">
        Choose the modules you want to explore and an industry preset. We show every
        optional module; toggles are only available for features live on production
        Reave. Launch opens the live sandbox with your selection.
      </p>
      {demoSiteUrl && (
        <p class="dl-sandbox-note">
          Sandbox: <a href={demoSiteUrl} rel="noopener noreferrer">{demoSiteUrl.replace(/^https?:\/\//, "")}</a>
        </p>
      )}
    </header>

    <div id="demo-loader-app" class="dl-app" aria-live="polite">
      <p class="dl-loading">Loading modules…</p>
    </div>

    <footer class="dl-footer">
      <p>
        Prefer a guided tour?
        <a href="/deck">Walkthrough</a>
        {" · "}
        <a href="/demo">Demo hub</a>
      </p>
    </footer>
  </div>

  {
    showSiteAssistant && (
      <SiteAssistantWidget
        brandTitle={company.name}
        supportPhone={company.supportPhone}
        supportEmail={company.supportEmail}
      />
    )
  }

  <script is:inline src="/demo-loader.js?v=20260806a"></script>
</Layout>

<style>
  .demo-loader-page {
    min-height: 100vh;
    padding: calc(
        var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) +
          40px
      )
      20px 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dl-hero,
  .dl-app,
  .dl-footer {
    width: 100%;
    max-width: 820px;
  }

  .dl-hero {
    text-align: center;
    margin-bottom: 28px;
  }

  .dl-kicker {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a855f7;
    margin: 0 0 14px;
  }

  .dl-h1 {
    margin: 0 0 14px;
    font-family: var(--font-primary);
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .dl-lead {
    margin: 0 auto;
    max-width: 620px;
    font-family: var(--font-content);
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.68);
  }

  .dl-sandbox-note {
    margin: 14px 0 0;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .dl-sandbox-note a {
    color: rgba(255, 255, 255, 0.82);
  }

  .dl-app {
    margin-bottom: 32px;
  }

  .dl-loading,
  .dl-error {
    text-align: center;
    color: rgba(255, 255, 255, 0.6);
    padding: 2rem;
  }

  .dl-error {
    color: #fca5a5;
  }

  .dl-panel {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
  }

  .dl-toolbar {
    padding: 1rem 1.1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .dl-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .dl-field-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .dl-select {
    font: inherit;
    font-size: 0.92rem;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(0, 0, 0, 0.25);
    color: #fff;
    max-width: 16rem;
  }

  .dl-toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .dl-btn {
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: filter 0.15s ease, transform 0.15s ease;
  }

  .dl-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .dl-btn--primary {
    color: #0b0512;
    background: var(--brand-gradient);
  }

  .dl-btn--primary:not(:disabled):hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .dl-btn--ghost {
    color: rgba(255, 255, 255, 0.88);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .dl-meta {
    margin: 0;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.48);
  }

  .dl-list-head {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 0.75rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dl-list-head span:nth-child(2),
  .dl-list-head span:nth-child(3) {
    text-align: center;
    min-width: 4.5rem;
  }

  .dl-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.7rem 1.1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dl-row--readonly {
    opacity: 0.65;
  }

  .dl-row-main {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    min-width: 0;
  }

  .dl-id {
    flex-shrink: 0;
    font-size: 0.76rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.72);
  }

  .dl-text {
    min-width: 0;
  }

  .dl-label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    line-height: 1.35;
  }

  .dl-feature {
    display: block;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.45);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .dl-row-end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .dl-status {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
    min-width: 4rem;
    text-align: center;
  }

  .dl-dash {
    display: inline-flex;
    width: 2.75rem;
    justify-content: center;
    color: rgba(255, 255, 255, 0.35);
  }

  .dl-toggle {
    flex-shrink: 0;
    width: 2.75rem;
    height: 1.55rem;
    border: none;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    position: relative;
    cursor: pointer;
    transition: background 0.15s;
  }

  .dl-toggle[aria-checked='true'] {
    background: #22c55e;
  }

  .dl-toggle::after {
    content: '';
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.15s;
  }

  .dl-toggle[aria-checked='true']::after {
    transform: translateX(1.15rem);
  }

  .dl-footnote {
    margin: 0;
    padding: 0.85rem 1.1rem 1rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.55);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dl-footnote a {
    color: rgba(255, 255, 255, 0.88);
  }

  .dl-footer {
    text-align: center;
    font-family: var(--font-content);
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .dl-footer a {
    color: rgba(255, 255, 255, 0.88);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 640px) {
    .dl-list-head {
      display: none;
    }

    .dl-row {
      grid-template-columns: 1fr;
    }

    .dl-row-end {
      justify-content: space-between;
    }
  }
</style>
