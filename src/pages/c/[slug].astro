      .wrap:has([data-tab-panel="audit"].active) {
        max-width: 960px;
      }
      .logo { font-weight: 700; letter-spacing: 2px; font-size: 18px; color: var(--site-fg-muted, #525252); }
      .hero { text-align: center; margin-bottom: 24px; }
      .hero h1 { margin: 18px 0 4px; font-size: 30px; font-weight: 700; line-height: 1.15; }
      .hero-no-logo {
        margin: 18px auto 4px;
        max-width: 28em;
        font-size: 14px;
        font-weight: 400;
        line-height: 1.45;
        color: var(--site-fg-muted, #525252);
      }
      .hero-no-logo strong {
        display: block;
        margin-bottom: 4px;
        font-size: 15px;
        font-weight: 600;
        color: var(--site-fg, #171717);
      }
      .hero-updated {
        margin: 0;
        font-size: 12px;
        color: var(--site-fg-faint, #a3a3a3);
      }
      .hero h1 + .hero-updated,
      .hero-no-logo + .hero-updated {
        margin-top: 6px;
      }
      .client-logo {
        display: block;
        max-width: min(200px, 70vw);
        max-height: 72px;
        width: auto;
        height: auto;
        /* Match .wrap top gap below the fixed header (24px) */
        margin: 0 auto 24px;
        object-fit: contain;
      }
      .overview-intro {
        margin-bottom: 20px;
        text-align: center;
      }
      .overview-intro .client-tagline {
        margin: 0 auto;
        max-width: 420px;
        color: var(--site-fg-muted, #525252);
        font-size: 14px;
        line-height: 1.55;
      }
      .overview-intro .client-website {
        display: inline-block;
        margin-top: 8px;
        color: var(--site-fg, #171717);
        font-size: 13px;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .overview-intro .client-website:active { opacity: 0.8; }
      .overview-intro .client-contact {
        margin: 8px 0 0;
        color: var(--site-fg-faint, #a3a3a3);
        font-size: 14px;
      }
      .company { margin: 0; color: var(--site-fg-muted, #525252); font-size: 15px; }

      .actions {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 1fr;
        gap: 10px;
        margin-bottom: 22px;
      }
      .action.brand-btn {
        flex-direction: column;
        width: 100%;
        height: auto;
        gap: 6px;
        padding: 14px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 500;
        white-space: normal;
        box-shadow: none;
      }
      .action:active { transform: scale(0.97); }
      .action.action--icon-only { padding: 14px 10px; }
      .action .ico {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        color: currentColor;
      }
      .action .ico svg { display: block; }
      .action-label {
        text-align: center;
        line-height: 1.25;
        max-width: 100%;
      }

      .tabbar {
        display: flex; gap: 6px; padding: 5px;
        background: var(--site-card, rgba(23, 23, 23, 0.03));
        border: 1px solid var(--site-border, rgba(23, 23, 23, 0.1));
        border-radius: 14px; margin-bottom: 22px;
      }
      .tabbar .tab.brand-btn {
        flex: 1;
        height: auto;
        padding: 10px 8px;
        border-radius: 999px;
        box-shadow: none;
        font-size: 14px;
        font-weight: 600;
      }

      .panel { display: none; }
      .panel.active { display: block; }

      .muted { color: var(--site-fg-muted, #525252); font-size: 15px; line-height: 1.6; }

      .headline { font-size: 20px; font-weight: 600; margin: 0 0 12px; }
      .body {
        font-size: 16px; line-height: 1.7; color: var(--site-fg, #171717);
        padding: 18px 20px; border-radius: 16px;
        border: 1px solid var(--site-card-border, rgba(23, 23, 23, 0.1));
        background: var(--site-card, rgba(23, 23, 23, 0.03));
        word-wrap: break-word; overflow-wrap: anywhere;
      }
      .body a { color: var(--site-fg, #171717); }
      .fields {
        margin-top: 18px; display: flex; flex-direction: column; gap: 1px;
        border-radius: 16px; overflow: hidden; border: 1px solid var(--site-card-border);
      }
      .field { display: flex; justify-content: space-between; gap: 16px; padding: 14px 18px; background: var(--site-card); }
      .field-label { color: var(--site-fg-muted); font-size: 14px; }
      .field-value { text-align: right; font-size: 15px; font-weight: 500; word-break: break-word; }

      .billing-head {
        display: flex; justify-content: space-between; align-items: baseline;
        padding: 4px 2px 16px;
      }
      .billing-title { font-size: 13px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--site-fg-muted); }
      .billing-total { font-size: 24px; font-weight: 700; }
      .billing-total.due { color: #fca5a5; }
      .billing-total.clear { color: #86efac; }

      .bill-group { margin-bottom: 18px; }
      .group-title {
        font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px;
        color: var(--site-fg-faint); margin: 0 0 8px 2px;
      }
      .uptime-block { margin-top: 20px; }
      .uptime-monitors, .uptime-incidents {
        list-style: none; margin: 0 0 12px; padding: 0;
        border-radius: 14px; overflow: hidden; border: 1px solid var(--site-card-border);
      }
      .uptime-monitor, .uptime-incident {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 12px 16px; background: var(--site-card);
        border-top: 1px solid var(--site-border);
      }
      .uptime-monitor:first-child, .uptime-incident:first-child { border-top: none; }
      .uptime-dot {
        width: 10px; height: 10px; border-radius: 50%; margin-top: 5px;
        background: var(--site-fg-faint); flex-shrink: 0;
      }
      .uptime-monitor.up .uptime-dot { background: #86efac; }
      .uptime-monitor.down .uptime-dot { background: #fca5a5; }
      .uptime-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
      .uptime-name { font-weight: 600; font-size: 15px; }
      .uptime-meta { font-size: 13px; color: var(--site-fg-muted); }
      .uptime-incident { flex-direction: column; gap: 4px; }
      .uptime-incident-type { font-size: 13px; font-weight: 600; text-transform: capitalize; }
      .uptime-incident-when { font-size: 12px; color: var(--site-fg-faint); }
      .uptime-incident-msg { font-size: 13px; color: var(--site-fg-muted); }
      .invoices {
        list-style: none; margin: 0; padding: 0;
        border-radius: 14px; overflow: hidden; border: 1px solid var(--site-card-border);
      }
      .invoice {
        display: flex; justify-content: space-between; align-items: center; gap: 12px;
        padding: 13px 16px; background: var(--site-card);
        border-top: 1px solid var(--site-border);
      }
      .invoice:first-child { border-top: none; }
      .invoice-stack {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .invoice-block {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid var(--site-card-border);
        background: var(--site-card);
      }
      .invoice-block .invoice,
      .invoice-block > summary.invoice {
        border-top: none;
        background: transparent;
      }
      .invoice-block > summary.invoice {
        list-style: none;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }
      .invoice-block > summary.invoice::-webkit-details-marker { display: none; }
      .invoice-block > summary.invoice::marker { content: ''; }
      .invoice-block > summary.invoice::after {
        content: '';
        flex: none;
        width: 8px;
        height: 8px;
        border-right: 2px solid var(--site-fg-faint);
        border-bottom: 2px solid var(--site-fg-faint);
        transform: rotate(45deg);
        transition: transform 0.2s;
        margin-top: -2px;
      }
      .invoice-block[open] > summary.invoice {
        border-bottom: 1px solid var(--site-border);
      }
      .invoice-block[open] > summary.invoice::after {
        transform: rotate(-135deg);
        margin-top: 2px;
      }
      .invoice-payments {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--site-border);
        background: var(--site-card);
      }
      .invoice-payments-standalone {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid var(--site-card-border);
      }
      .invoice-payment {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 11px 16px 11px 28px;
        border-top: 1px solid var(--site-border);
      }
      .invoice-payment:first-child { border-top: none; }
      .invoice-payment .pay-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
      .invoice-payment .pay-date { font-size: 14px; font-weight: 600; }
      .invoice-payment .pay-meta { font-size: 12px; color: var(--site-fg-faint); }
      .invoice-payment .pay-amount { font-size: 14px; font-weight: 600; flex: none; color: #86efac; }
      .inv-main { display: flex; flex-direction: column; gap: 2px; }
      .inv-num { font-size: 15px; font-weight: 600; }
      .inv-meta { font-size: 12px; color: var(--site-fg-faint); text-transform: capitalize; }
      .inv-side { display: flex; align-items: center; gap: 12px; }
      .inv-due { font-size: 15px; font-weight: 600; }
      .inv-due.paid { color: var(--site-fg-muted); }
      .inv-due.upcoming { color: #fcd34d; }
      .pay.brand-btn {
        padding: 7px 16px;
        font-size: 13px;
      }
      .pay:active { opacity: 0.85; }
      .view { color: var(--site-fg, #171717); text-decoration: none; font-size: 13px; font-weight: 500; }

      /* Documents tab */
      .doc-card {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        padding: 14px 16px; margin-bottom: 10px; border-radius: 14px;
        border: 1px solid var(--site-card-border); background: var(--site-card);
        text-decoration: none; color: var(--site-fg); transition: background 0.2s, border-color 0.2s;
      }
      .doc-card:active { background: var(--site-card); border-color: var(--site-border); }
      .doc-card-left { flex: 1; min-width: 0; }
      .doc-card-title { font-size: 15px; font-weight: 600; margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .doc-card-meta { font-size: 12px; color: var(--site-fg-faint); }
      .doc-card-arrow { font-size: 18px; color: var(--site-fg-muted, #525252); flex: none; }

      .data-note { color: var(--site-fg-muted); font-size: 13px; margin: 0 0 14px; }
      .vault-empty {
        text-align: center;
        padding: 28px 20px;
        border-radius: 14px;
        border: 1px dashed var(--site-border);
        background: var(--site-card);
      }
      .vault-empty .muted { margin: 0 0 16px; }
      .vault-submit-link.brand-btn {
        width: 100%;
        max-width: 280px;
        padding: 14px 20px;
        font-size: 15px;
      }
      .vault-submit-link:active { opacity: 0.85; }
      .data-card {
        margin-bottom: 12px; border-radius: 14px;
        border: 1px solid var(--site-card-border); background: var(--site-card);
        overflow: hidden;
      }
      .data-card > summary.data-label {
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 14px 16px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }
      .data-card > summary.data-label::-webkit-details-marker { display: none; }
      .data-card > summary.data-label::marker { content: ''; }
      .data-label-text {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .data-card > summary.data-label::after {
        content: '';
        flex: none;
        width: 8px;
        height: 8px;
        border-right: 2px solid var(--site-fg-faint);
        border-bottom: 2px solid var(--site-fg-faint);
        transform: rotate(45deg);
        transition: transform 0.2s;
        margin-top: -2px;
      }
      .data-card[open] > summary.data-label {
        border-bottom: 1px solid var(--site-card-border);
      }
      .data-card[open] > summary.data-label::after {
        transform: rotate(-135deg);
        margin-top: 2px;
      }
      .data-card-body { padding: 12px 16px 14px; }
      .data-card-body > :first-child { margin-top: 0; }
      .data-url { display: block; color: var(--site-fg, #171717); font-size: 14px; margin-bottom: 8px; word-break: break-all; }
      .data-value { font-size: 14px; color: var(--site-fg); white-space: pre-wrap; word-break: break-word; }
      .cred { display: flex; align-items: center; gap: 8px; margin-top: 6px; }
      .cred-key { width: 42px; font-size: 12px; color: var(--site-fg-faint); flex: none; }
      .cred-val {
        flex: 1; min-width: 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px;
        background: var(--site-card); padding: 7px 10px; border-radius: 8px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--site-fg);
      }
      .cred-val.secret { -webkit-text-security: disc; text-security: disc; }
      .cred-val.secret.revealed { -webkit-text-security: none; text-security: none; }
      .mini {
        flex: none; padding: 7px 10px; border-radius: 999px; border: 1px solid var(--site-border);
        background: var(--site-border); color: var(--site-fg); font: inherit; font-size: 12px; cursor: pointer;
      }
      .mini-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        padding: 0;
      }
      .mini-icon svg { display: block; }
      .mini:active { background: var(--site-border); }

      .empty { display: flex; min-height: 80vh; align-items: center; justify-content: center; text-align: center; }
      .empty .card h1 { font-size: 22px; margin: 18px 0 10px; }
      .empty .card p { color: var(--site-fg-muted); font-size: 15px; line-height: 1.6; max-width: 340px; margin: 0 auto; }

      /* Submit mode */
      .submit-intro {
        color: var(--site-fg-muted); font-size: 15px; line-height: 1.6;
        margin: 0 0 20px;
      }
      .submit-intro strong { color: var(--site-fg); }
      .entry-card {
        padding: 16px; margin-bottom: 14px; border-radius: 16px;
        border: 1px solid var(--site-border); background: var(--site-card);
        display: flex; flex-direction: column; gap: 10px;
      }
      .entry-header { display: flex; justify-content: space-between; align-items: center; }
      .entry-num { font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--site-fg-faint); }
      .entry-field-label {
        font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;
        color: var(--site-fg-muted); margin-top: 2px;
      }
      .entry-required { color: #f87171; }
      .entry-remove {
        background: none; border: none; color: var(--site-fg-faint);
        font-size: 16px; cursor: pointer; padding: 4px; line-height: 1;
      }
      .entry-remove:hover { color: var(--site-fg-muted); }
      .entry-label, .entry-value {
        width: 100%; background: var(--site-card); border: 1px solid var(--site-border);
        border-radius: 10px; color: var(--site-fg); font-family: inherit; font-size: 15px;
        padding: 11px 14px; outline: none; resize: none;
        transition: border-color 0.2s;
      }
      .entry-label::placeholder, .entry-value::placeholder { color: var(--site-fg-faint); }
      .entry-label:focus, .entry-value:focus { border-color: var(--site-fg); }
      .entry-label.input-error { border-color: #f87171; }
      .entry-value { font-size: 14px; line-height: 1.5; }
      .add-btn.brand-btn {
        width: 100%;
        padding: 13px;
        margin-bottom: 14px;
        font-size: 14px;
      }
      .submit-btn.brand-btn {
        width: 100%;
        padding: 16px;
        font-size: 16px;
      }
      .submit-btn:active { transform: scale(0.98); }
      .submit-btn:disabled { opacity: 0.5; cursor: default; }
      .success-card {
        text-align: center; padding: 48px 24px;
        border-radius: 20px; border: 1px solid var(--site-card-border);
        background: var(--site-card);
      }
      .success-icon {
        font-size: 36px; width: 64px; height: 64px; border-radius: 50%;
        background: var(--brand-btn-bg, #111);
        color: var(--brand-btn-fg, #fff);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 20px;
      }
      .success-card h2 { margin: 0 0 10px; font-size: 22px; }
      .success-card p { margin: 0; color: var(--site-fg-muted); font-size: 15px; line-height: 1.6; }
    </style>
    {
      !notFound && (
        <script is:inline>
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/c/sw.js', { scope: '/c/' }).catch(() => {});
          }
        </script>
      )
    }
    {
      !notFound && org.portalOutreachNotice && (
        <PortalOutreachSheet
          alertId="reave-automatic-outreach"
          content={org.portalOutreachNotice}
          greetingName={outreachGreetingName}
        />
      )
    }
  </body>
</html>
