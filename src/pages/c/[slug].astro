---
/**
 * Public client portal — a shareable, iOS-first page per contact.
 *
 * URL: /c/<uid>  (uid is an unguessable UUID from contact-api, so the link
 * itself is the access token — only people you send it to can open it.)
 *
 * Rendered server-side so the CONTACT_API_KEY never reaches the browser. Content
 * comes from the `portal` link metadata on the contact (see src/lib/contactApi).
 * Internal `notes` are intentionally NOT shown.
 *
 * Tabs: Overview, Punch list (shared to-dos), Audit (online presence
 * diagnostic), Projects (Work), Billing (Crater invoices), Vault
 * (web-design handoff). Punch list and Vault show even if empty so
 * clients can add the first entry. Other tabs appear when populated.
 */
import {
  getContact,
  extractPortal,
  contactStringField,
  type ContactRecord,
  type ClientPortal,
  type PortalDocument,
} from '../../lib/contactApi';
import { getCompanyConfig, companyStaffAvatarUrl } from '../../lib/companyConfig';
import { getPostAlias } from '../../lib/postAlias';
import { hasFeature } from '../../lib/features';
import { isCraterConfigured, craterGetClientBilling, craterGetClientPayments, buildPortalBillingView, type ClientBilling, type ClientPayments, type PortalBillingInvoiceGroup } from '../../lib/craterClient';
import { isBookingConfigured, publicBookingPageUrl } from '../../lib/bookingClient';
import { scheduleFormUrl } from '../../lib/inboundEmailReply';
import { isWorkArchived, storeListWorkForContact, storeReadWork, type WorkJobSummary } from '../../lib/workStore';
import { storeListWorkCommentsForSlugs, type WorkJobComment } from '../../lib/workComments';
import { portalProjectFileUrl, storeListProjectFiles } from '../../lib/projectFiles';
import { enrichClientPortalBrand } from '../../lib/clientBrand';
import { resolveClientHeroLogoUrl, resolveClientLogoUrl } from '../../lib/clientBranding';
import { NO_LOGO_FOUND_HTML } from '../../lib/clientLogoCopy';
import { isPortalAssistantConfigured } from '../../lib/portalAssistant';
import PortalAssistantWidget from '../../components/PortalAssistantWidget.astro';
import { getClientUptimeView } from '../../lib/uptimeMonitoring';
import { uptimeStatusLabel } from '../../lib/uptimerobotClient';
import { PORTAL_OG_HEIGHT, PORTAL_OG_WIDTH, formatPortalPageTitle } from '../../lib/portalOgImage';
import { requestOrigin } from '../../lib/requestOrigin';
import { projectPortalUrl, auditPortalUrl } from '../../lib/contactApi';
import { LOGO_ICON_OG_PATH } from '../../lib/companyLogo';
import PortalWorkPanel, { type PortalWorkJobItem, type PortalWorkFileItem } from '../../components/PortalWorkPanel.astro';
import PortalPunchlist from '../../components/PortalPunchlist.astro';
import PortalAuditPanel from '../../components/PortalAuditPanel.astro';
import { isTodoDbConfigured, storeListTodos } from '../../lib/todoStore';
import { toPublicPunchlistItem, type PublicPunchlistItem } from '../../lib/punchlist';
import { buildAuditReportCard, isAuditJob } from '../../lib/auditReportCard';
import { googlePlacesListedFlag } from '../../lib/auditPlacesListing';
import SiteFooter from '../../components/SiteFooter.astro';
import Header from '../../components/Header.astro';
import Favicon from '../../components/Favicon.astro';
import ViewportMeta from '../../components/ViewportMeta.astro';
import SiteBackground from '../../components/SiteBackground.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import { companyHtmlStyleAttr } from '../../lib/companyBrandColors';
import '../../styles/brand.css';
import '../../styles/mobile-touch.css';
import PortalOutreachSheet from '../../components/PortalOutreachSheet.astro';
import { contactGreetingName, splitClientNameParts } from '../../lib/contactPersonName';
import { escapeHtml } from '../../lib/htmlEscape';

const org = await getCompanyConfig(Astro.request);

const { slug } = Astro.params;
const uid = (slug ?? '').trim();

let contact: ContactRecord | null = null;
let portal: ClientPortal = {};
let notFound = false;

if (uid) {
  const res = await getContact(uid);
  if (res.ok && !res.data.archived) {
    const p = extractPortal(res.data);
    // Every client has a page by default; only an explicit `enabled:false`
    // (revoked) hides it. Custom content is optional.
    if (!p || p.enabled !== false) {
      contact = res.data;
      portal = p ?? {};
      // Best-effort: fetch logo + tagline from their website on first visit.
      if (!contactStringField(portal.logoUrl)) {
        await enrichClientPortalBrand(uid);
        const refreshed = await getContact(uid);
        if (refreshed.ok) {
          contact = refreshed.data;
          portal = extractPortal(refreshed.data) ?? portal;
        }
      }
      void import('../../lib/contactPortalEnrich')
        .then((m) => m.triggerContactPortalEnrich(uid))
        .catch(() => {});
    }
  }
}
if (!contact) notFound = true;
if (notFound) Astro.response.status = 404;

// Billing from Crater (best-effort; skipped if not configured/matched).
let billing: ClientBilling | null = null;
let clientPayments: ClientPayments | null = null;
if (contact && hasFeature('billing') && isCraterConfigured()) {
  try {
    const match = {
      email: contactStringField(contact.email) || undefined,
      name: contactStringField(contact.name) || undefined,
      company: contactStringField(contact.company) || undefined,
      phone: contactStringField(contact.phone) || undefined,
    };
    const b = await craterGetClientBilling(match);
    if (b.ok && b.data) {
      billing = b.data;
    }
    const p = await craterGetClientPayments(match);
    if (p.ok && p.data && p.data.payments.length > 0) {
      clientPayments = p.data;
    }
  } catch {
    // Crater is optional on the portal — never take down the page for billing drift.
  }
}

const portalBillingView = buildPortalBillingView(billing, clientPayments?.payments);

const money = (n: number) => `$${Number(n).toFixed(2)}`;
const fmtDate = (s: string | null | undefined) => {
  if (!s) return '';
  const d = new Date(s);
  return Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};

function richText(s: string): string {
  const escaped = escapeHtml(s);
  const linked = escaped.replace(
    /(https?:\/\/[^\s<]+)/g,
    (url) => `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`
  );
  return linked.replace(/\n/g, '<br />');
}

function vaultDataHref(value: string): string | null {
  const trimmed = value.trim();
  if (/^https?:\/\//i.test(trimmed)) return trimmed;
  return null;
}

function workFileUrlForPortal(url: string, contactUid: string, jobSlug: string): string {
  const m = url.match(/\/api\/work\/([^/]+)\/files\/([^/?#]+)/);
  if (!m || m[1] !== jobSlug) return url;
  return `/api/c/${encodeURIComponent(contactUid)}/work/${encodeURIComponent(jobSlug)}/files/${encodeURIComponent(m[2])}`;
}

function workBodyHtml(body: string, contactUid: string, jobSlug: string): string {
  const lines = body.split('\n');
  const out: string[] = [];
  const imgRe = /^!\[([^\]]*)\]\(([^)]+)\)\s*$/;
  for (const line of lines) {
    const trimmed = line.trim();
    const m = trimmed.match(imgRe);
    if (m) {
      const src = workFileUrlForPortal(m[2], contactUid, jobSlug);
      out.push(
        `<img class="work-body-img" src="${escapeHtml(src)}" alt="${escapeHtml(m[1])}" loading="lazy" />`,
      );
    } else if (trimmed) {
      out.push(richText(trimmed));
    } else {
      out.push('');
    }
  }
  return out.join('<br />');
}

const displayName = contactStringField(contact?.name) || 'Contact';
const company = contactStringField(contact?.company);
// Serve through /api/clients/:uid/logo so mostly-black scraped marks flip to white.
const avatarUrl = contact ? resolveClientLogoUrl(portal, uid) : '';
const logoUrl = contact ? await resolveClientHeroLogoUrl(portal, uid) : '';
/** Hero fallback when the profile has no brand mark — a finding, not a label. */
const noLogoFoundHtml = NO_LOGO_FOUND_HTML;
const clientWebsite = contactStringField(portal?.website);
const clientTagline = contactStringField(portal?.tagline);
const brandTitle = company || displayName;
const headline = contactStringField(portal?.headline);
const bodyRaw = contactStringField(portal?.body);
const bodyHtml = bodyRaw ? richText(bodyRaw) : '';
const fields = (portal?.fields ?? []).filter((f) => f && f.label && f.value);

const dataEntries = hasFeature('web_handoff')
  ? (portal?.data ?? []).filter(
      (e) => e && e.label && (e.value || e.username || e.password || e.url)
    )
  : [];

const portalDocs = hasFeature('documents')
  ? (portal?.documents ?? [])
      .slice()
      .sort((a, b) => {
        const bt = Date.parse(contactStringField(b.signedAt));
        const at = Date.parse(contactStringField(a.signedAt));
        return (Number.isNaN(bt) ? 0 : bt) - (Number.isNaN(at) ? 0 : at);
      })
  : [];

const staffAvatarUrl = companyStaffAvatarUrl(org);
const providerName = org.name?.trim() || 'us';
const contactsBrand = providerName.replace(/\s+automation$/i, '').trim() || providerName;
const addContactsLabel = `Add ${contactsBrand} to contacts`;
const showClientContact = Boolean(company && displayName !== company && displayName !== brandTitle);
const vcardHref = '/contact.vcf';
const schedulePrefill = {
  name: contactStringField(contact?.name) || undefined,
  email: contactStringField(contact?.email) || undefined,
};
const scheduleHref = hasFeature('scheduling')
  ? publicBookingPageUrl('30min', schedulePrefill) ||
    (isBookingConfigured()
      ? scheduleFormUrl(requestOrigin(Astro.request), schedulePrefill)
      : null)
  : null;
const showQuickActions = Boolean(vcardHref || scheduleHref);

const updatedAt = fmtDate(portal?.updatedAt);

const CLIENT_WORK_STATUS: Record<string, string> = {
  inquiry: 'Submitted',
  audit: 'Audit',
  active: 'In progress',
  done: 'Archived',
  archived: 'Archived',
};

// Jobs linked to this client — archived projects stay visible, flagged, and closed.
let clientJobs: WorkJobSummary[] = [];
let commentsBySlug: Record<string, WorkJobComment[]> = {};
let filesBySlug: Record<string, PortalWorkFileItem[]> = {};
const jobBodies: Record<string, string> = {};
if (contact && uid) {
  try {
    clientJobs = await storeListWorkForContact(uid);
    if (clientJobs.length) {
      commentsBySlug = await storeListWorkCommentsForSlugs(clientJobs.map((j) => j.slug));
      await Promise.all(
        clientJobs.map(async (job) => {
          const [doc, files] = await Promise.all([
            storeReadWork(job.slug),
            storeListProjectFiles(job.slug),
          ]);
          if (doc?.body?.trim()) jobBodies[job.slug] = doc.body.trim();
          filesBySlug[job.slug] = files.map((file) => ({
            id: file.id,
            filename: file.filename,
            mediaType: file.mediaType,
            sizeBytes: file.sizeBytes,
            source: file.source,
            url: portalProjectFileUrl(uid, job.slug, file.id),
          }));
        }),
      );
    }
  } catch {
    // Jobs are optional on the portal — never take down the page for storage drift.
  }
}

const origin = requestOrigin(Astro.request);

type PortalJobBuilt = PortalWorkJobItem & {
  isAudit: boolean;
  auditReport: ReturnType<typeof buildAuditReportCard>;
  updatedAt: string;
};

const portalJobsBuilt: PortalJobBuilt[] = await Promise.all(
  clientJobs.map(async (job) => {
    const bodyRaw = jobBodies[job.slug] || '';
    const auditReport = buildAuditReportCard({
      tags: job.tags,
      source: job.source,
      title: job.title,
      body: bodyRaw,
      clientName: company || displayName,
      googlePlacesListed: googlePlacesListedFlag(portal?.placesListing),
    });
    const isAudit = Boolean(auditReport) || isAuditJob({
      tags: job.tags,
      source: job.source,
      title: job.title,
      body: bodyRaw,
    });
    const portalUrl = isAudit
      ? auditPortalUrl(uid, job.slug, { base: origin })
      : projectPortalUrl(uid, job.slug, { base: origin });
    return {
      slug: job.slug,
      title: job.title,
      status: job.status,
      statusLabel: CLIENT_WORK_STATUS[job.status] || job.status,
      bodyHtml: bodyRaw ? workBodyHtml(bodyRaw, uid, job.slug) : '',
      dateLabel: fmtDate(job.updated || job.created),
      portalUrl,
      isAudit,
      auditReport,
      updatedAt: job.updated || job.created || '',
    };
  }),
);

/** Non-audit projects for the Projects tab. Archived jobs sort last. */
const portalWorkJobs: PortalWorkJobItem[] = portalJobsBuilt
  .filter((j) => !j.isAudit)
  .map(({ isAudit: _a, auditReport: _r, updatedAt: _u, ...job }) => job)
  .sort((a, b) => Number(isWorkArchived(a.status)) - Number(isWorkArchived(b.status)));

const livePortalWorkJobs = portalWorkJobs.filter((j) => !isWorkArchived(j.status));

/**
 * One live diagnostic per client — prefer the newest completed audit,
 * else the newest in-progress stub.
 */
const portalAuditJob = (() => {
  const audits = portalJobsBuilt.filter((j) => j.isAudit);
  if (!audits.length) return null;
  const sorted = [...audits].sort((a, b) => {
    const ta = Date.parse(a.updatedAt) || 0;
    const tb = Date.parse(b.updatedAt) || 0;
    return tb - ta;
  });
  const completed = sorted.find((j) => j.auditReport && !j.auditReport.inProgress);
  return completed || sorted[0] || null;
})();

const expandProjectSlug = (() => {
  const raw = Astro.url.searchParams.get('project')?.trim();
  if (!raw) return '';
  return portalWorkJobs.some((j) => j.slug === raw) ? raw : '';
})();

const trackToken = Astro.url.searchParams.get('track')?.trim() || '';

let clientUptimeMonitors: Awaited<ReturnType<typeof getClientUptimeView>>['monitors'] = [];
let clientUptimeIncidents: Awaited<ReturnType<typeof getClientUptimeView>>['incidents'] = [];
if (contact && uid && hasFeature('uptime_monitoring')) {
  try {
    const uptimeView = await getClientUptimeView(uid);
    clientUptimeMonitors = uptimeView.monitors;
    clientUptimeIncidents = uptimeView.incidents;
  } catch {
    // Uptime is optional on the portal.
  }
}
const hasUptime = clientUptimeMonitors.length > 0 || clientUptimeIncidents.length > 0;

let punchlistItems: PublicPunchlistItem[] = [];
const hasPunchlist = Boolean(contact && uid && hasFeature('client_portal') && isTodoDbConfigured());
if (hasPunchlist && uid) {
  try {
    punchlistItems = (await storeListTodos({ contact_uid: uid })).map(toPublicPunchlistItem);
  } catch {
    // Punch list is optional — never take down the page for to-do drift.
  }
}

// Which tabs to show
const hasOverview = Boolean(
  clientTagline || clientWebsite || showClientContact || headline || bodyHtml || fields.length > 0
);
const hasBilling = Boolean(portalBillingView);
const hasVault = hasFeature('web_handoff');
const hasDocs = portalDocs.length > 0;
const hasWork = portalWorkJobs.length > 0;
const hasAudit = Boolean(portalAuditJob);
const postAlias = getPostAlias();
const tabs: Array<{ id: string; label: string }> = [];
tabs.push({ id: 'overview', label: 'Overview' });
if (hasPunchlist) tabs.push({ id: 'punchlist', label: 'Punch list' });
if (hasAudit) tabs.push({ id: 'audit', label: 'Audit' });
if (hasWork) tabs.push({ id: 'work', label: postAlias.pluralTitle });
if (hasBilling) tabs.push({ id: 'billing', label: 'Billing' });
if (hasVault) tabs.push({ id: 'vault', label: 'Vault' });
if (hasDocs) tabs.push({ id: 'documents', label: 'Documents' });
const showTabs = tabs.length > 1;

const initialTab = (() => {
  const raw = Astro.url.searchParams.get('tab')?.trim().toLowerCase();
  const normalized =
    raw === 'data' ? 'vault'
    : raw === 'payments' ? 'billing'
    : raw === 'projects' ? 'work'
    : raw;
  // Deep-linked audit project → Audit tab even if tab param was still "work".
  const projectParam = Astro.url.searchParams.get('project')?.trim();
  if (
    projectParam &&
    portalAuditJob &&
    (projectParam === portalAuditJob.slug ||
      portalJobsBuilt.some((j) => j.isAudit && j.slug === projectParam))
  ) {
    if (!normalized || normalized === 'work' || normalized === 'audit') return 'audit';
  }
  if (normalized && tabs.some((t) => t.id === normalized)) return normalized;
  if (hasAudit) return 'audit';
  if (hasWork) return 'work';
  return tabs[0]?.id ?? 'overview';
})();

type BillingSectionBlock = {
  title: string;
  groups: PortalBillingInvoiceGroup[];
};

const billingSections: BillingSectionBlock[] = portalBillingView
  ? [
      ...(portalBillingView.outstandingGroups.length
        ? [{ title: 'Outstanding', groups: portalBillingView.outstandingGroups }]
        : []),
      ...(portalBillingView.previousGroups.length
        ? [{ title: 'Previous', groups: portalBillingView.previousGroups }]
        : []),
      ...(portalBillingView.paymentsOnlyGroups.length
        ? [{ title: 'Payment history', groups: portalBillingView.paymentsOnlyGroups }]
        : []),
    ]
  : [];

const pageTitle = formatPortalPageTitle(brandTitle, org.name);
const appTitle = brandTitle;
const manifestHref = uid ? `/c/${encodeURIComponent(uid)}/manifest.json` : '';
const themeColor = '#ffffff';
const portalUrl = uid ? `${origin}/c/${encodeURIComponent(uid)}` : origin;
const ogDescription = clientTagline || `${brandTitle} client portal`;
const ogImagePath = uid ? `/c/${encodeURIComponent(uid)}/og.png` : LOGO_ICON_OG_PATH;
const ogImageAbsolute = ogImagePath.startsWith('http') ? ogImagePath : `${origin}${ogImagePath}`;
const ogImageSafe = /\.gif(?:\?|$)/i.test(ogImageAbsolute)
  ? `${origin}${LOGO_ICON_OG_PATH}`
  : ogImageAbsolute;

// ?submit — show a focused data-submission form instead of the full portal.
const submitMode = !notFound && Astro.url.searchParams.has('submit');

const showAssistant =
  !notFound && !submitMode && hasFeature('portal_assistant') && isPortalAssistantConfigured();
// Form fields are First / Last / company title — never invent a first name
// from the company (contact-api still splits that title into firstName).
const clientFirstName = contact ? splitClientNameParts(contact).firstName : '';
const outreachGreetingName = contact ? contactGreetingName(contact) : company;

const submitEndpoint = `/api/c/${encodeURIComponent(uid)}/submit`;
---

<!doctype html>
<html lang="en" style={companyHtmlStyleAttr(org.fonts, org.brandPrimary, org.brandSecondary)}>
  <head>
    <ThemeInit />
    <meta charset="UTF-8" />
    <ViewportMeta />
    <meta name="robots" content="noindex, nofollow" />
    <title>{notFound ? 'Not found' : pageTitle}</title>
    {!notFound && (
      <>
        <meta name="description" content={ogDescription} />
        <link rel="canonical" href={portalUrl} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={portalUrl} />
        <meta property="og:image" content={ogImageSafe} />
        <meta property="og:image:width" content={String(PORTAL_OG_WIDTH)} />
        <meta property="og:image:height" content={String(PORTAL_OG_HEIGHT)} />
        <meta property="og:image:alt" content={`${brandTitle} client portal`} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={ogDescription} />
        <meta name="twitter:image" content={ogImageSafe} />
      </>
    )}
    <Favicon />
    {!notFound && manifestHref && <link rel="manifest" href={manifestHref} />}
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    {!notFound && <meta name="apple-mobile-web-app-title" content={appTitle} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteBackground />
    <Header />
    {
      notFound ? (
        <main class="wrap empty">
          <div class="card">
            <h1>This page isn’t available</h1>
            <p>The link may be expired or incorrect. Please reach out and we’ll send you a fresh one.</p>
          </div>
          <SiteFooter />
        </main>
      ) : submitMode ? (
        <main class="wrap">
          <header class="hero">
            <h1>{displayName}</h1>
            {company && <p class="company">{company}</p>}
          </header>

          <div id="submit-form">
            <p class="submit-intro">Fill in the details below and tap <strong>Submit</strong>. Add as many entries as you need.</p>

            <div id="entries-list"></div>

            <button class="brand-btn brand-btn-glass add-btn" id="add-entry" type="button">+ Add another</button>

            <button class="brand-btn brand-btn-solid submit-btn" id="submit-btn" type="button">Submit</button>
          </div>

          <div id="submit-success" style="display:none">
            <div class="success-card">
              <div class="success-icon">&#x2713;</div>
              <h2>Submitted</h2>
              <p>Your info has been received. You can close this page.</p>
            </div>
          </div>

          <SiteFooter />
        </main>
      ) : (
        <main class="wrap">
          <header class="hero">
            {logoUrl ? (
              <img
                class="client-logo"
                src={logoUrl}
                alt={brandTitle}
                width="160"
                height="64"
                loading="eager"
                data-logo-fallback
              />
            ) : (
              <p class="hero-no-logo" set:html={noLogoFoundHtml} />
            )}
            {updatedAt && <p class="hero-updated">Updated {updatedAt}</p>}
          </header>

          {showQuickActions && (
            <nav class="actions" aria-label={`Contact ${providerName}`}>
              <a class="brand-btn brand-btn-glass action" href={vcardHref} aria-label={addContactsLabel}>
                <span class="ico" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg></span><span class="action-label">{addContactsLabel}</span>
              </a>
              {scheduleHref && (
                <a
                  class="brand-btn brand-btn-glass action"
                  href={scheduleHref}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="ico" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span><span class="action-label">Schedule</span>
                </a>
              )}
            </nav>
          )}

          {showTabs && (
            <div class="tabbar" role="tablist">
              {tabs.map((t) => (
                <button
                  class={`tab brand-btn ${t.id === initialTab ? 'brand-btn-solid active' : 'brand-btn-glass'}`}
                  data-tab-btn={t.id}
                  type="button"
                >
                  {t.label}
                </button>
              ))}
            </div>
          )}

          {/* Overview */}
          <section class={`panel ${initialTab === 'overview' ? 'active' : ''}`} data-tab-panel="overview">
            {(clientTagline || clientWebsite || showClientContact) && (
              <div class="overview-intro">
                {clientTagline && <p class="client-tagline">{clientTagline}</p>}
                {clientWebsite && (
                  <a class="client-website" href={clientWebsite.startsWith('http') ? clientWebsite : `https://${clientWebsite}`} target="_blank" rel="noopener noreferrer">
                    {clientWebsite.replace(/^https?:\/\//i, '').replace(/\/$/, '')}
                  </a>
                )}
                {showClientContact && <p class="client-contact">{displayName}</p>}
              </div>
            )}
            {headline && <h2 class="headline">{headline}</h2>}
            {bodyHtml && <div class="body" set:html={bodyHtml} />}
            {fields.length > 0 && (
              <div class="fields">
                {fields.map((f) => (
                  <div class="field">
                    <div class="field-label">{f.label}</div>
                    <div class="field-value">{f.value}</div>
                  </div>
                ))}
              </div>
            )}
            {!hasOverview && !hasWork && !hasUptime && !hasPunchlist && <p class="muted">Welcome{company ? `, ${company}` : ''}. Use the tabs above to view your billing and account details.</p>}
            {!hasOverview && hasWork && !hasUptime && <p class="muted">Welcome{company ? `, ${company}` : ''}. Check the {postAlias.pluralTitle} tab for your {postAlias.plural}.</p>}
            {!hasOverview && hasPunchlist && !hasWork && !hasUptime && <p class="muted">Welcome{company ? `, ${company}` : ''}. Use the Punch list tab to send us leftover work.</p>}
            {hasUptime && (
              <div class="uptime-block">
                <h3 class="group-title">Website uptime</h3>
                {clientUptimeMonitors.length > 0 && (
                  <ul class="uptime-monitors">
                    {clientUptimeMonitors.map((m) => (
                      <li class={`uptime-monitor ${m.status === 8 || m.status === 9 ? 'down' : m.status === 2 ? 'up' : ''}`}>
                        <span class="uptime-dot" aria-hidden="true" />
                        <div class="uptime-main">
                          <span class="uptime-name">{m.friendly_name}</span>
                          <span class="uptime-meta">
                            {uptimeStatusLabel(m.status)}
                            {m.uptime_ratio_7d != null ? ` · ${Number(m.uptime_ratio_7d).toFixed(2)}% (7d)` : ''}
                          </span>
                        </div>
                      </li>
                    ))}
                  </ul>
                )}
                {clientUptimeIncidents.length > 0 && (
                  <ul class="uptime-incidents">
                    {clientUptimeIncidents.slice(0, 8).map((inc) => (
                      <li class="uptime-incident">
                        <span class="uptime-incident-type">{inc.alert_type || 'incident'}</span>
                        <span class="uptime-incident-when">{fmtDate(inc.created_at)}</span>
                        {inc.message && <span class="uptime-incident-msg">{inc.message}</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            )}
          </section>

          {/* Audit — single live online-presence diagnostic */}
          {hasAudit && uid && portalAuditJob?.auditReport && (
            <PortalAuditPanel
              report={portalAuditJob.auditReport}
              bodyHtml={portalAuditJob.bodyHtml}
              clientName={company || displayName}
              website={clientWebsite}
              active={initialTab === 'audit'}
              jobSlug={portalAuditJob.slug}
              comments={commentsBySlug[portalAuditJob.slug] ?? []}
              contactUid={uid}
              clientAvatarUrl={avatarUrl}
              staffAvatarUrl={staffAvatarUrl}
            />
          )}

          {hasPunchlist && uid && (
            <PortalPunchlist items={punchlistItems} contactUid={uid} active={initialTab === 'punchlist'} />
          )}

          {/* Work (client-visible jobs + comments) */}
          {hasWork && uid && (
            <PortalWorkPanel
              jobs={portalWorkJobs}
              commentsBySlug={commentsBySlug}
              filesBySlug={filesBySlug}
              contactUid={uid}
              clientAvatarUrl={avatarUrl}
              staffAvatarUrl={staffAvatarUrl}
              active={initialTab === 'work'}
              autoExpand={livePortalWorkJobs.length === 1}
              expandSlug={expandProjectSlug}
              trackToken={trackToken}
            />
          )}

          {/* Billing (invoices + nested payments) */}
          {hasBilling && portalBillingView && (
            <section class={`panel ${initialTab === 'billing' ? 'active' : ''}`} data-tab-panel="billing">
              <div class="billing-head">
                <span class="billing-title">Balance due</span>
                <span class={`billing-total ${portalBillingView.totalDue > 0 ? 'due' : 'clear'}`}>
                  {money(portalBillingView.totalDue)}
                </span>
              </div>

              {portalBillingView.upcoming.length > 0 && (
                <div class="bill-group">
                  <h3 class="group-title">Upcoming</h3>
                  <ul class="invoices">
                    {portalBillingView.upcoming.map((r) => (
                      <li class="invoice">
                        <div class="inv-main">
                          <span class="inv-num">{r.frequency || 'Recurring'}</span>
                          <span class="inv-meta">{r.nextAt ? `Next: ${fmtDate(r.nextAt)}` : r.status}</span>
                        </div>
                        <div class="inv-side">
                          <span class="inv-due upcoming">{money(r.total)}</span>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {billingSections.map((section) => (
                <div class="bill-group">
                  <h3 class="group-title">{section.title}</h3>
                  <div class="invoice-stack">
                    {section.groups.map((group) => {
                      const inv = group.invoice;
                      const isOutstanding = group.section === 'outstanding';
                      const hasPayments = group.payments.length > 0;
                      const invoiceHead = (
                        <>
                          <div class="inv-main">
                            <span class="inv-num">#{inv.number}</span>
                            <span class="inv-meta">
                              {inv.date ? fmtDate(inv.date) : '—'}
                              {' · '}
                              {isOutstanding ? inv.status : 'Paid'}
                              {hasPayments && (
                                <>
                                  {' · '}
                                  {group.payments.length === 1
                                    ? '1 payment'
                                    : `${group.payments.length} payments`}
                                </>
                              )}
                            </span>
                          </div>
                          <div class="inv-side">
                            {isOutstanding ? (
                              <>
                                <span class="inv-due">{money(inv.due)}</span>
                                {inv.url && (
                                  <a
                                    class="brand-btn brand-btn-solid pay"
                                    href={inv.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    onclick="event.stopPropagation()"
                                  >
                                    Pay
                                  </a>
                                )}
                              </>
                            ) : (
                              <>
                                <span class="inv-due paid">{money(inv.total)}</span>
                                {inv.url && (
                                  <a
                                    class="view"
                                    href={inv.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    onclick="event.stopPropagation()"
                                  >
                                    View
                                  </a>
                                )}
                              </>
                            )}
                          </div>
                        </>
                      );
                      return hasPayments ? (
                        <details class="invoice-block">
                          <summary class="invoice">{invoiceHead}</summary>
                          <ul class="invoice-payments">
                            {group.payments.map((pay) => (
                              <li class="invoice-payment">
                                <div class="pay-main">
                                  <span class="pay-date">{fmtDate(pay.date)}</span>
                                  <span class="pay-meta">
                                    {pay.method}
                                    {pay.paymentNumber ? ` · ${pay.paymentNumber}` : ''}
                                  </span>
                                </div>
                                <span class="pay-amount">{money(pay.amount)}</span>
                              </li>
                            ))}
                          </ul>
                        </details>
                      ) : (
                        <div class="invoice-block invoice-block--static">
                          <div class="invoice">{invoiceHead}</div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))}

              {portalBillingView.orphanPayments.length > 0 && (
                <div class="bill-group">
                  <h3 class="group-title">Other payments</h3>
                  <ul class="invoice-payments invoice-payments-standalone">
                    {portalBillingView.orphanPayments.map((pay) => (
                      <li class="invoice-payment">
                        <div class="pay-main">
                          <span class="pay-date">{fmtDate(pay.date)}</span>
                          <span class="pay-meta">
                            {pay.method}
                            {pay.paymentNumber ? ` · ${pay.paymentNumber}` : ''}
                          </span>
                        </div>
                        <span class="pay-amount">{money(pay.amount)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          )}

          {/* Vault (web-design handoff) */}
          {hasVault && (
            <section class={`panel ${initialTab === 'vault' ? 'active' : ''}`} data-tab-panel="vault">
              {dataEntries.length > 0 ? (
                dataEntries.map((e) => (
                  <details class="data-card">
                    <summary class="data-label"><span class="data-label-text">{e.label}</span></summary>
                    <div class="data-card-body">
                      {e.url && (() => {
                        const href = vaultDataHref(e.url);
                        return href ? (
                          <a class="data-url" href={href} target="_blank" rel="noopener noreferrer">{e.url}</a>
                        ) : (
                          <div class="cred">
                            <span class="cred-key">Data</span>
                            <code class="cred-val">{e.url}</code>
                            <button class="mini mini-icon" data-copy type="button" aria-label="Copy data">
                              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                            </button>
                          </div>
                        );
                      })()}
                      {e.username && (
                        <div class="cred">
                          <span class="cred-key">User</span>
                          <code class="cred-val">{e.username}</code>
                          <button class="mini mini-icon" data-copy type="button" aria-label="Copy username">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                          </button>
                        </div>
                      )}
                      {e.password && (
                        <div class="cred">
                          <span class="cred-key">Pass</span>
                          <code class="cred-val secret">{e.password}</code>
                          <button class="mini mini-icon" data-reveal type="button" aria-label="Show password">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                          </button>
                          <button class="mini mini-icon" data-copy type="button" aria-label="Copy password">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                          </button>
                        </div>
                      )}
                      {e.value && <div class="data-value">{e.value}</div>}
                    </div>
                  </details>
                ))
              ) : (
                <div class="vault-empty">
                  <p class="muted">Account details &amp; credentials for your {postAlias.singular}. Keep this link private.</p>
                  <a class="brand-btn brand-btn-solid vault-submit-link" href="?submit">Add account details</a>
                </div>
              )}
            </section>
          )}

          {/* Documents */}
          {hasDocs && (
            <section class={`panel ${initialTab === 'documents' ? 'active' : ''}`} data-tab-panel="documents">
              <p class="data-note">Signed documents — tap to view or download as PDF.</p>
              {portalDocs.map((doc) => (
                <a
                  class="doc-card"
                  href={`/doc/${encodeURIComponent(uid)}/view/${encodeURIComponent(doc.id)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="doc-card-left">
                    <div class="doc-card-title">{doc.title}</div>
                    <div class="doc-card-meta">Signed by {doc.signerName} · {fmtDate(doc.signedAt)}</div>
                  </div>
                  <span class="doc-card-arrow">↗</span>
                </a>
              ))}
            </section>
          )}

          <SiteFooter />
        </main>
      )
    }

    {showAssistant && (
      <PortalAssistantWidget
        contactUid={uid}
        brandTitle={brandTitle}
        clientFirstName={clientFirstName}
        supportPhone={org.supportPhone}
        supportEmail={org.supportEmail}
      />
    )}

    <script define:vars={{ submitEndpoint, submitMode, noLogoFoundHtml }}>
      // Pack glyphs — keep in sync with IOS_ICONS in public/admin/admin-ui.js
      const iconEye =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>';
      const iconEyeOff =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 13.058-4.076"/><path d="m2 2 20 20"/></svg>';
      const iconCopy =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      const iconCheck =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

      document.querySelectorAll('img[data-logo-fallback]').forEach((img) => {
        const showMissingLogo = () => {
          const note = document.createElement('p');
          note.className = 'hero-no-logo';
          note.innerHTML = noLogoFoundHtml;
          img.replaceWith(note);
        };
        img.addEventListener('error', showMissingLogo);
        img.addEventListener('load', () => {
          if (img.naturalWidth < 48 && img.naturalHeight < 48) showMissingLogo();
        });
      });
      document.querySelectorAll('[data-tab-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-tab-btn');
          document.querySelectorAll('[data-tab-btn]').forEach((b) => {
            const on = b === btn;
            b.classList.toggle('active', on);
            b.classList.toggle('brand-btn-solid', on);
            b.classList.toggle('brand-btn-glass', !on);
          });
          document
            .querySelectorAll('[data-tab-panel]')
            .forEach((p) => p.classList.toggle('active', p.getAttribute('data-tab-panel') === id));
        });
      });
      document.querySelectorAll('[data-reveal]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const code = btn.parentElement?.querySelector('code');
          if (!code) return;
          const revealed = code.classList.toggle('revealed');
          btn.innerHTML = revealed ? iconEyeOff : iconEye;
          btn.setAttribute('aria-label', revealed ? 'Hide password' : 'Show password');
        });
      });
      document.querySelectorAll('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const code = btn.parentElement?.querySelector('code');
          if (!code) return;
          const label = btn.getAttribute('aria-label') || 'Copy';
          try {
            await navigator.clipboard.writeText(code.textContent || '');
            btn.innerHTML = iconCheck;
            btn.setAttribute('aria-label', 'Copied');
            setTimeout(() => {
              btn.innerHTML = iconCopy;
              btn.setAttribute('aria-label', label);
            }, 1000);
          } catch {}
        });
      });

      // Submit-mode form logic
      const entriesList = document.getElementById('entries-list');
      const addBtn = document.getElementById('add-entry');
      const submitBtn = document.getElementById('submit-btn');
      const submitForm = document.getElementById('submit-form');
      const submitSuccess = document.getElementById('submit-success');

      if (entriesList && addBtn && submitBtn) {
        let entryCount = 0;

        function addEntry() {
          entryCount++;
          const idx = entryCount;
          const card = document.createElement('div');
          card.className = 'entry-card';
          card.dataset.idx = String(idx);
          card.innerHTML = `
            <div class="entry-header">
              <span class="entry-num">Entry ${idx}</span>
              ${idx > 1 ? '<button class="entry-remove" type="button" aria-label="Remove">✕</button>' : ''}
            </div>
            <label class="entry-field-label" for="entry-label-${idx}">Label <span class="entry-required" aria-hidden="true">*</span></label>
            <input id="entry-label-${idx}" class="entry-label" type="text" placeholder="e.g. Hosting, cPanel, Domain…" autocomplete="off" required aria-required="true" />
            <label class="entry-field-label" for="entry-value-${idx}">Details</label>
            <textarea id="entry-value-${idx}" class="entry-value" rows="4" placeholder="Paste your info here…"></textarea>
          `;
          const removeBtn = card.querySelector('.entry-remove');
          if (removeBtn) {
            removeBtn.addEventListener('click', () => {
              card.remove();
              // Renumber remaining entries
              entriesList.querySelectorAll('.entry-card').forEach((c, i) => {
                const numEl = c.querySelector('.entry-num');
                if (numEl) numEl.textContent = `Entry ${i + 1}`;
              });
              entryCount = entriesList.querySelectorAll('.entry-card').length;
            });
          }
          entriesList.appendChild(card);
          card.querySelector('input')?.focus();
        }

        addEntry(); // start with one

        addBtn.addEventListener('click', addEntry);

        submitBtn.addEventListener('click', async () => {
          const cards = entriesList.querySelectorAll('.entry-card');
          const entries = [];
          let hasError = false;

          cards.forEach((card) => {
            const label = (card.querySelector('.entry-label')).value.trim();
            const value = (card.querySelector('.entry-value')).value.trim();
            if (!label) {
              (card.querySelector('.entry-label')).classList.add('input-error');
              hasError = true;
              return;
            }
            (card.querySelector('.entry-label')).classList.remove('input-error');
            if (label || value) entries.push({ label, value });
          });

          if (hasError || entries.length === 0) return;

          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting…';

          try {
            const res = await fetch(submitEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ entries }),
            });
            const json = await res.json();
            if (!res.ok || !json.ok) throw new Error(json.error || 'Submit failed');
            if (submitForm) submitForm.style.display = 'none';
            if (submitSuccess) submitSuccess.style.display = '';
          } catch (err) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit';
            alert('Something went wrong. Please try again or contact us directly.');
          }
        });
      }
    </script>

    <style is:global>
      * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
      html {
        background-color: var(--site-canvas);
      }
      html, body {
        margin: 0;
        min-height: 100%;
        background-color: var(--site-canvas);
        color: var(--site-fg, #171717);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      body {
        position: relative;
      }
      button,
      .tab,
      .action {
        -webkit-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
      }
