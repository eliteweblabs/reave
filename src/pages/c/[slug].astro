        pointer-events: none;
      }
      .wrap {
        position: relative;
        z-index: 1;
        max-width: 560px;
        margin: 0 auto;
        padding: calc(env(safe-area-inset-top) + 64px + 24px) 20px calc(env(safe-area-inset-bottom) + 96px);
        transition: max-width 0.2s ease;
      }
