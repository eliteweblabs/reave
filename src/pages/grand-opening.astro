---
import Layout from "../layouts/MarketingLayout.astro";
import BrandBtn from "../components/ui/BrandBtn.astro";
import ConversationalForm from "../components/ConversationalForm.astro";
import CardFanVisual from "../components/grand-opening/CardFanVisual.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import { FEATURE_LABELS } from "../lib/featureCatalog";
import { SIMPLE_ICONS_CDN } from "../lib/platformStack";
import { ArrowRight, Layers } from "lucide-astro";
import "../styles/marketing-sections.css";

type PlatformItem =
  | {
      kind: "brand";
      slug: string;
      color: string;
      title: string;
      blurb: string;
      iconSlug?: string;
    }
  | {
      kind: "lucide";
      title: string;
      blurb: string;
    };

const platformItems: PlatformItem[] = [
  {
    kind: "brand",
    slug: "railway",
    color: "var(--site-fg, #171717)",
    title: "Railway™ hosting",
    blurb: "Production-grade deploys — not shared drag-and-drop hosting.",
  },
  {
    kind: "brand",
    slug: "postgresql",
    color: "#4169E1",
    title: "PostgreSQL database",
    blurb: "Structured data from day one — contacts, content, and workflows in one place.",
  },
  {
    kind: "brand",
    slug: "clerk",
    color: "#6C47FF",
    title: "Clerk authentication",
    blurb: "Passkeys, phone sign-in, and secure admin sessions on every install.",
  },
  {
    kind: "brand",
    slug: "apple",
    color: "var(--site-fg, #171717)",
    title: FEATURE_LABELS.siri,
    blurb:
      "Apple Shortcuts tied to the agent — voice lookup, timers, SMS, and more from your iPhone.",
  },
  {
    kind: "lucide",
    title: "Modular & extendable",
    blurb:
      "Turn on CMS, client portals, Crater Financial, and more when you're ready — same stack we use in production.",
  },
];

export const prerender = false;

const company = await getCompanyConfig(Astro.request);
const brandName = company.name || "reave.app";
---

<Layout
  title="Grand Opening — Free Website Design"
  description={`${brandName} grand opening: free custom website design when you purchase one year of managed hosting ($500/year or $50/month).`}
  showSiteAssistant={false}
>
  <div class="go-page">
    <section class="go-hero" aria-labelledby="go-title">
      <div class="go-hero__inner">
        <div class="go-hero__copy">
          <p class="go-hero__pill">Grand opening · limited time only</p>
          <h1 id="go-title" class="go-hero__title">
            Free website design<br />with a one-year hosting plan.
          </h1>
          <p class="go-hero__lead">
            Limited grand opening offer: purchase one year of managed hosting —
            <strong>$500/year</strong> or <strong>$50/month</strong> — and we design and build
            your site at no extra charge.
          </p>

          <div class="go-hero__ctas">
            <BrandBtn href="#apply" variant="filled">
              Get started
              <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
            </BrandBtn>
            <BrandBtn href="/digital-audit" variant="glass">Free web audit</BrandBtn>
          </div>
        </div>

        <div class="go-hero__visual">
          <CardFanVisual />
        </div>
      </div>
    </section>

    <section class="go-details" aria-labelledby="go-details-title">
      <div class="go-details__inner">
        <h2 id="go-details-title" class="go-details__title">What's included</h2>
        <div class="go-details__grid">
          <article class="go-detail-card">
            <h3>Custom website design</h3>
            <p>
              A site built for your business — not a template dump. We handle layout, copy
              structure, and polish so you look credible on day one.
            </p>
          </article>
          <article class="go-detail-card">
            <h3>One year of hosting</h3>
            <p>
              Managed hosting with daily scans, malware protection, and a team that actually
              responds — <strong>$500/year</strong> or <strong>$50/month</strong>.
            </p>
          </article>
          <article class="go-detail-card">
            <h3>Unlimited edits</h3>
            <p>
              Copy tweaks, new photos, layout changes — included for your first year. We keep
              your site current without nickel-and-diming you for every update.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="go-platform" aria-labelledby="go-platform-title">
      <div class="go-platform__inner">
        <p class="marketing-label">Real infrastructure</p>
        <h2 id="go-platform-title" class="go-platform__title">
          Not a Squarespace template. A platform you can grow into.
        </h2>
        <p class="go-platform__lead">
          Your site is a real product — custom-built on <strong>Railway™</strong>, backed by
          <strong>PostgreSQL</strong>, with <strong>Clerk</strong> sign-in and optional
          <strong>{FEATURE_LABELS.siri}</strong>. Start with design and hosting; add CMS, client
          login, scheduling, and the rest when you're ready.
        </p>
        <ul class="go-platform__stack">
          {
            platformItems.map((item) => (
              <li>
                {item.kind === "brand" ? (
                  <span
                    class="go-platform__logo"
                    style={`--brand-color: ${item.color}; --brand-icon: url(${JSON.stringify(SIMPLE_ICONS_CDN(item.iconSlug ?? item.slug))})`}
                    aria-hidden="true"
                  />
                ) : (
                  <Layers size={20} strokeWidth={1.75} aria-hidden="true" />
                )}
                <div>
                  <strong>{item.title}</strong>
                  <span>{item.blurb}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="apply" class="go-apply" aria-labelledby="go-apply-title">
      <div class="go-apply__inner">
        <header class="go-apply__header">
          <p class="marketing-label">Limited time</p>
          <h2 id="go-apply-title">Let's get started!</h2>
          <p class="go-apply__lead">
            Share your domain and registrar access — the faster we get that, the faster we launch.
          </p>
        </header>
        <ConversationalForm slug="grand-opening" embedded heroChat brandName={brandName} />
        <p class="go-apply__fine-print">
          Offer subject to approval. One year of managed hosting required ($500 total or $50/month).
          Design scope covers a standard business site; complex builds may be quoted separately.
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .go-page {
    padding: 0 var(--site-page-gutter, 20px) calc(80px + env(safe-area-inset-bottom, 0px));
  }

  .go-hero {
    padding: clamp(2rem, 6vw, 4rem) 0 clamp(2.5rem, 5vw, 3.5rem);
    overflow: visible;
  }

  .go-hero__inner {
    display: grid;
    gap: 40px;
    max-width: 1080px;
    margin: 0 auto;
    align-items: center;
  }

  @media (min-width: 860px) {
    .go-hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
      gap: 48px;
      align-items: start;
    }

    .go-hero__visual {
      align-self: start;
      overflow: visible;
    }
  }

  .go-hero__copy {
    max-width: 560px;
  }

  .go-hero__pill {
    display: inline-block;
    margin: 0 0 14px;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    color: #fff;
    background: linear-gradient(135deg, #171717 0%, #404040 100%);
    box-shadow:
      0 4px 14px rgba(0, 0, 0, 0.18),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
  }

  .go-hero__title {
    margin: 0 0 16px;
    font-size: clamp(2rem, 5.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--site-fg, #171717);
  }

  .go-hero__lead {
    margin: 0 0 28px;
    font-family: var(--font-content);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--site-fg-muted, #525252);
  }

  .go-hero__lead strong {
    color: var(--site-fg, #171717);
    font-weight: 600;
  }

  .go-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .go-hero__ctas :global(.brand-btn) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .go-hero__ctas :global(.brand-btn-glass) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
    border: 1.5px solid var(--brand-glass-border-color);
    color: var(--site-fg, #171717);
    -webkit-text-fill-color: var(--site-fg, #171717);
  }

  .go-hero__ctas :global(.brand-btn-glass:hover) {
    background: transparent;
    border-color: var(--brand-glass-border-color-hover);
    color: var(--site-fg, #171717);
    -webkit-text-fill-color: var(--site-fg, #171717);
    filter: none;
  }

  :global(html.site-marketing[data-theme="dark"]) .go-hero__ctas :global(.brand-btn-glass),
  :global(html.site-marketing[data-theme="dark"]) .go-hero__ctas :global(.brand-btn-glass:hover) {
    color: var(--site-fg, #e5e5e5);
    -webkit-text-fill-color: var(--site-fg, #e5e5e5);
  }

  .go-hero__visual {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    max-width: 100%;
    overflow: visible;
  }

  @media (max-width: 859px) {
    .go-page {
      overflow-x: clip;
    }

    .go-hero__visual {
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }
  }

  .go-details {
    padding: clamp(2rem, 4vw, 3rem) 0;
  }

  .go-details__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .go-details__title {
    margin: 0 0 24px;
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--site-fg, #171717);
  }

  .go-details__grid {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 720px) {
    .go-details__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  .go-detail-card {
    padding: 22px 20px;
    border-radius: 14px;
    border: 1.5px solid var(--site-card-border, rgba(23, 23, 23, 0.18));
    background: transparent;
  }

  .go-detail-card h3 {
    margin: 0 0 8px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--site-fg, #171717);
  }

  .go-detail-card p {
    margin: 0;
    font-family: var(--font-content);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--site-fg-muted, #525252);
  }

  .go-detail-card p strong {
    color: var(--site-fg, #171717);
    font-weight: 600;
  }

  .go-platform {
    padding: clamp(2rem, 4vw, 3rem) 0;
  }

  .go-platform__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .go-platform__title {
    margin: 0 0 14px;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--site-fg, #171717);
  }

  .go-platform__lead {
    margin: 0 auto 28px;
    max-width: 680px;
    font-family: var(--font-content);
    font-size: 1rem;
    line-height: 1.65;
    text-align: center;
    color: var(--site-fg-muted, #525252);
  }

  .go-platform__lead strong {
    color: var(--site-fg, #171717);
    font-weight: 600;
  }

  .go-platform__stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  @media (min-width: 720px) {
    .go-platform__stack {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  @media (min-width: 1080px) {
    .go-platform__stack {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .go-platform__stack li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 18px 16px;
    border-radius: 14px;
    border: 1.5px solid var(--site-card-border, rgba(23, 23, 23, 0.18));
    background: transparent;
  }

  .go-platform__logo {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    background-color: var(--brand-color);
    mask: var(--brand-icon) center / contain no-repeat;
    -webkit-mask: var(--brand-icon) center / contain no-repeat;
  }

  .go-platform__stack li :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--site-fg, #171717);
  }

  .go-platform__stack strong {
    display: block;
    margin-bottom: 4px;
    font-size: 0.95rem;
    color: var(--site-fg, #171717);
  }

  .go-platform__stack span {
    display: block;
    font-family: var(--font-content);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--site-fg-muted, #525252);
  }

  .go-apply {
    padding: clamp(2.5rem, 5vw, 4rem) 0 0;
    scroll-margin-top: calc(var(--app-header-offset, 4rem) + 12px);
  }

  .go-apply__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .go-apply__header {
    text-align: center;
    margin-bottom: 8px;
  }

  .go-apply__header h2 {
    margin: 0 0 10px;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--site-fg, #171717);
  }

  .go-apply__lead {
    margin: 0;
    font-family: var(--font-content);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--site-fg-muted, #525252);
  }

  .go-apply__fine-print {
    margin: 20px 0 0;
    font-size: 0.78rem;
    line-height: 1.55;
    text-align: center;
    color: var(--site-fg-faint, #a3a3a3);
  }

  .go-apply :global(.conversational-form-root--embedded .input-area) {
    justify-content: center;
  }

  .go-apply :global(.conversational-form-root--embedded .input-pill) {
    flex: 0 1 auto;
    width: min(100%, 420px);
    max-width: 420px;
  }

  :global(html.page-grand-opening .app-header:not(.app-header--admin)) {
    padding-right: 0;
  }
</style>
