---
import Layout from "../layouts/MarketingLayout.astro";
import BrandBtn from "../components/ui/BrandBtn.astro";
import ConversationalForm from "../components/ConversationalForm.astro";
import CardFanVisual from "../components/grand-opening/CardFanVisual.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import { ArrowRight, Check, PenLine, ShieldCheck } from "lucide-astro";
import "../styles/marketing-sections.css";

export const prerender = false;

const company = await getCompanyConfig(Astro.request);
const brandName = company.name || "reave.app";
---

<Layout
  title="Grand Opening — Free Website Design"
  description={`${brandName} grand opening offer: free custom website design with one year of managed hosting ($500). Unlimited edits, subject to approval.`}
>
  <div class="go-page">
    <section class="go-hero" aria-labelledby="go-title">
      <div class="go-hero__inner">
        <div class="go-hero__copy">
          <p class="marketing-label">Grand opening</p>
          <h1 id="go-title" class="go-hero__title">
            Free website design.<br />One year of hosting included.
          </h1>
          <p class="go-hero__lead">
            We're celebrating our launch with a limited offer: we design and build your site at
            no charge when you sign up for one year of managed hosting — a <strong>$500</strong> value
            (or <strong>$50/month</strong>).
          </p>

          <ul class="go-hero__highlights" aria-label="Offer highlights">
            <li>
              <PenLine size={18} strokeWidth={1.75} aria-hidden="true" />
              <span><strong>Unlimited edits</strong> for your first year</span>
            </li>
            <li>
              <ShieldCheck size={18} strokeWidth={1.75} aria-hidden="true" />
              <span><strong>Subject to approval</strong> — we review every application</span>
            </li>
            <li>
              <Check size={18} strokeWidth={1.75} aria-hidden="true" />
              <span>Custom design, mobile-ready, managed hosting included</span>
            </li>
          </ul>

          <div class="go-hero__ctas">
            <BrandBtn href="#apply" variant="filled">
              Apply now
              <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
            </BrandBtn>
            <BrandBtn href="/schedule" variant="glass">Book a call</BrandBtn>
          </div>
        </div>

        <div class="go-hero__visual">
          <CardFanVisual />
        </div>
      </div>
    </section>

    <section class="go-details" aria-labelledby="go-details-title">
      <div class="go-details__inner">
        <h2 id="go-details-title" class="go-details__title">What's included</h2>
        <div class="go-details__grid">
          <article class="go-detail-card">
            <h3>Custom website design</h3>
            <p>
              A site built for your business — not a template dump. We handle layout, copy
              structure, and polish so you look credible on day one.
            </p>
          </article>
          <article class="go-detail-card">
            <h3>One year of hosting</h3>
            <p>
              Managed hosting with daily scans, malware protection, and a team that actually
              responds — <strong>$500/year</strong> or <strong>$50/month</strong>.
            </p>
          </article>
          <article class="go-detail-card">
            <h3>Unlimited edits</h3>
            <p>
              Copy tweaks, new photos, layout changes — included for your first year. We keep
              your site current without nickel-and-diming you for every update.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="apply" class="go-apply" aria-labelledby="go-apply-title">
      <div class="go-apply__inner">
        <header class="go-apply__header">
          <p class="marketing-label">Limited time</p>
          <h2 id="go-apply-title">Let's get started!</h2>
          <p class="go-apply__lead">
            Share your domain and registrar access — the faster we get that, the faster we launch.
          </p>
        </header>
        <ConversationalForm slug="grand-opening" embedded heroChat brandName={brandName} />
        <p class="go-apply__fine-print">
          Offer subject to approval. One year of managed hosting required ($500 total or $50/month).
          Design scope covers a standard business site; complex builds may be quoted separately.
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .go-page {
    padding: 0 var(--site-page-gutter, 20px) calc(80px + env(safe-area-inset-bottom, 0px));
  }

  .go-hero {
    padding: clamp(2rem, 6vw, 4rem) 0 clamp(2.5rem, 5vw, 3.5rem);
  }

  .go-hero__inner {
    display: grid;
    gap: 40px;
    max-width: 1080px;
    margin: 0 auto;
    align-items: center;
  }

  @media (min-width: 860px) {
    .go-hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
      gap: 48px;
    }
  }

  .go-hero__copy {
    max-width: 560px;
  }

  .go-hero__title {
    margin: 0 0 16px;
    font-size: clamp(2rem, 5.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--site-fg, #171717);
  }

  .go-hero__lead {
    margin: 0 0 24px;
    font-family: var(--font-content);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--site-fg-muted, #525252);
  }

  .go-hero__lead strong {
    color: var(--site-fg, #171717);
    font-weight: 600;
  }

  .go-hero__highlights {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .go-hero__highlights li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-content);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--site-fg-muted, #525252);
  }

  .go-hero__highlights li :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--site-fg, #171717);
  }

  .go-hero__highlights strong {
    color: var(--site-fg, #171717);
    font-weight: 600;
  }

  .go-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .go-hero__ctas :global(.brand-btn) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .go-hero__ctas :global(.brand-btn-glass) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
    border: 1.5px solid var(--site-fg, #171717);
    color: var(--site-fg, #171717);
    -webkit-text-fill-color: var(--site-fg, #171717);
  }

  .go-hero__ctas :global(.brand-btn-glass:hover) {
    background: transparent;
    border-color: var(--site-fg-muted, #525252);
    filter: none;
  }

  .go-hero__visual {
    display: flex;
    justify-content: center;
  }

  .go-details {
    padding: clamp(2rem, 4vw, 3rem) 0;
  }

  .go-details__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .go-details__title {
    margin: 0 0 24px;
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--site-fg, #171717);
  }

  .go-details__grid {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 720px) {
    .go-details__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  .go-detail-card {
    padding: 22px 20px;
    border-radius: 14px;
    border: 1.5px solid var(--site-card-border, rgba(23, 23, 23, 0.18));
    background: transparent;
  }

  .go-detail-card h3 {
    margin: 0 0 8px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--site-fg, #171717);
  }

  .go-detail-card p {
    margin: 0;
    font-family: var(--font-content);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--site-fg-muted, #525252);
  }

  .go-detail-card p strong {
    color: var(--site-fg, #171717);
    font-weight: 600;
  }

  .go-apply {
    padding: clamp(2.5rem, 5vw, 4rem) 0 0;
    scroll-margin-top: calc(var(--app-header-offset, 4rem) + 12px);
  }

  .go-apply__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .go-apply__header {
    text-align: center;
    margin-bottom: 8px;
  }

  .go-apply__header h2 {
    margin: 0 0 10px;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--site-fg, #171717);
  }

  .go-apply__lead {
    margin: 0;
    font-family: var(--font-content);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--site-fg-muted, #525252);
  }

  .go-apply__fine-print {
    margin: 20px 0 0;
    font-size: 0.78rem;
    line-height: 1.55;
    text-align: center;
    color: var(--site-fg-faint, #a3a3a3);
  }
</style>
