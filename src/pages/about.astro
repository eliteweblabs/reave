---
import Layout from "../layouts/Layout.astro";
import ClientLogos from "../components/ClientLogos.astro";
import TestimonialsCarousel from "../components/TestimonialsCarousel.astro";
import HomePortfolioSection from "../components/home/HomePortfolioSection.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import { getSiteContent } from "../lib/siteContent";
import "../styles/marketing-sections.css";

const company = await getCompanyConfig(Astro.request);
const siteContent = getSiteContent();
const aboutImage = siteContent.aboutImage || "";
const supportMail = company.supportEmail || (company.domain ? `hello@${company.domain}` : "");
const contactHref = supportMail ? `mailto:${supportMail}` : "/#contact";
---

<Layout
  title="About"
  description={`About ${company.name} — the team behind the Business OS and two decades of client work across branding, development, and automation.`}
>
  <div class="about-page">
    <header class="about-intro">
      <p class="about-kicker">About</p>
      <h1 class="about-h1">Built by operators, for operators.</h1>
      <p class="about-lead">
        {company.name} started as a design and development studio — logos, sites,
        plugins, and custom apps for clients who needed more than a template. That
        work turned into a platform when we kept rebuilding the same CRM, inbox,
        billing, and portal stack from scratch.
      </p>
    </header>

    <section
      class="home-section home-section--photo about-page-main"
      aria-labelledby="about-expertise-title"
    >
      <div class="marketing-bg" aria-hidden="true">
        <div class="sketch-draw-reveal marketing-bg-photo" data-sketch-draw>
          {aboutImage && (
          <img
            class="sketch-draw-reveal__fallback"
            src={aboutImage}
            alt=""
            width="1024"
            height="768"
            loading="eager"
            decoding="async"
          />
          )}
          <canvas class="sketch-draw-reveal__canvas" hidden aria-hidden="true"></canvas>
        </div>
        
      </div>

      <div class="home-section-inner">
        <header class="home-section-hero">
          <h2 id="about-expertise-title">Automation Expertise</h2>
          <p class="marketing-lead">
            Over 20 years designing logos &amp; graphics to building websites, developing plugins &amp;
            apps for prestigious brands...
          </p>
        </header>

        {(siteContent.clientLogos?.length ?? 0) > 0 && (
        <section class="section--full-bleed" aria-label="Clients we've worked with">
          <ClientLogos />
        </section>
        )}

        <TestimonialsCarousel />
      </div>
    </section>

    <HomePortfolioSection />

    <section class="about-block about-closing" aria-labelledby="about-contact-title">
      <h2 id="about-contact-title">Work with us</h2>
      <p>
        Need the full platform, a custom integration, or help migrating off the tools
        you're paying for separately? Tell us what you're running today and we'll map
        the shortest path.
      </p>
      <div class="about-cta-row">
        <a class="about-btn about-btn--primary" href="/schedule">Book a call</a>
        <a class="about-btn about-btn--ghost brand-btn-glass" href={contactHref}>Get in touch</a>
      </div>
    </section>
  </div>
</Layout>

<script>
  import "../lib/sketchDrawReveal.ts";
</script>

<style>
  .about-page {
    min-height: 100vh;
    padding: calc(var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) + 40px) 0 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .about-intro,
  .about-block {
    width: 100%;
    max-width: 760px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .about-intro {
    text-align: center;
    margin-bottom: 48px;
  }

  .about-kicker {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a855f7;
    margin: 0 0 14px;
  }

  .about-h1 {
    margin: 0 0 16px;
    font-family: var(--font-primary);
    font-size: clamp(1.85rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: #fff;
  }

  .about-lead {
    margin: 0 auto;
    max-width: 580px;
    font-family: var(--font-content);
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.68);
  }

  .about-page-main {
    width: 100%;
    min-height: min(100vh, 100svh);
    margin-bottom: 56px;
  }

  .about-block {
    margin-bottom: 56px;
  }

  .about-block h2 {
    margin: 0 0 14px;
    font-family: var(--font-primary);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .about-block p {
    margin: 0 0 14px;
    font-family: var(--font-content);
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.68);
  }

  .about-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .about-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, filter 0.15s ease, background 0.15s ease;
  }

  .about-btn--primary {
    color: #fff;
    -webkit-text-fill-color: #fff;
    background: var(--brand-gradient);
    box-shadow: 0 8px 24px rgba(var(--brand-magenta-rgb), 0.35);
  }

  .about-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .about-btn--ghost:hover {
    transform: translateY(-1px);
  }

  .about-closing {
    text-align: center;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .about-closing .about-cta-row {
    justify-content: center;
  }

  .about-portfolio {
    width: 100%;
    margin-bottom: 56px;
  }
</style>
