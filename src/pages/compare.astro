---
import Layout from "../layouts/MarketingLayout.astro";
import ComparePageContent from "../components/compare/ComparePageContent.astro";
import { getCompanyConfig } from "../lib/companyConfig";

const company = await getCompanyConfig(Astro.request);
---

<Layout
  title="Compare"
  description={`Interactive graph visualizations — SaaS waste, stack topology, feature radar, and cumulative TCO for ${company.name} vs box-stock SaaS vs bespoke development.`}
>
  <ComparePageContent />
</Layout>
