---
/**
 * Temporary video-cover test — 0819 loop, full-width, pinned to the bottom.
 * Not in nav. noindex. Delete when the experiment is done.
 */
import Layout from "../layouts/Layout.astro";
---

<Layout title="Video cover test" description="Full-width looping video cover pinned to the bottom." noIndex>
  <section class="video-test" aria-label="Looping video background">
    <video
      class="video-test-media"
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      preload="auto"
      aria-hidden="true"
    >
      <source src="/video/0819.mp4" type="video/mp4" />
    </video>
  </section>
</Layout>

<style is:global>
  body:has(.video-test) main#main-content {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  body:has(.video-test) .site-foot-wrap {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: none;
  }
</style>

<style>
  .video-test {
    position: relative;
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
  }

  .video-test-media {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom center;
    pointer-events: none;
  }
</style>
