---
/**
 * /deck — redirects to the public demo loader.
 * Kept as a route so old bookmarks and shared links still resolve.
 */
const dest = new URL('/demo-loader', Astro.url);
for (const [key, value] of Astro.url.searchParams) {
  dest.searchParams.set(key, value);
}
return Astro.redirect(dest.pathname + dest.search, 302);
