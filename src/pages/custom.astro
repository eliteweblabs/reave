---
import Layout from "../layouts/Layout.astro";
import ConversationalForm from "../components/ConversationalForm.astro";
import { getCompanyConfig } from "../lib/companyConfig";

const company = await getCompanyConfig(Astro.request);
---

<Layout
  title="Custom"
  description={`Tell ${company.name} the biggest bottleneck in your workflow — we help small businesses automate the tricky parts.`}
>
  <div class="custom-page">
    <header class="custom-intro">
      <p class="custom-kicker">Custom</p>
      <h1 class="custom-h1">What’s the bottleneck?</h1>
      <p class="custom-lead">
        We thrive helping small businesses automate the tricky situations — the
        step that still eats the day, the handoff that always breaks, the thing
        you keep doing by hand because nothing else fits. Tell us the biggest
        bottleneck in your workflow. We’ll map a way through it.
      </p>
    </header>

    <ConversationalForm
      slug="custom"
      embedded
      brandName={company.name || "REΛVE"}
    />
  </div>
</Layout>

<style>
  .custom-page {
    min-height: 100vh;
    padding: calc(var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) + 40px) 24px 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .custom-intro {
    width: 100%;
    max-width: 640px;
    text-align: center;
    margin-bottom: 28px;
  }

  .custom-kicker {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a855f7;
    margin: 0 0 14px;
  }

  .custom-h1 {
    margin: 0 0 16px;
    font-family: var(--font-primary);
    font-size: clamp(1.85rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: #fff;
  }

  .custom-lead {
    margin: 0 auto;
    max-width: 580px;
    font-family: var(--font-content);
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.68);
  }

  .custom-page :global(.conversational-form-root--embedded) {
    width: 100%;
    max-width: 640px;
  }
</style>
