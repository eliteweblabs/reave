---
import Layout from "../layouts/Layout.astro";
import HostingPricingSection from "../components/hosting/HostingPricingSection.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import { ArrowRight } from "lucide-astro";

const company = await getCompanyConfig(Astro.request);
---

<Layout
  title="Managed Hosting"
  description={`${company.name} managed hosting — WordPress or web apps, with Core OS and Growth plans from $600/year. Daily scans, malware protection, weekly SEO reports, and optional unlimited edits.`}
>
  <div class="hosting-page">
    <section
      class="hosting-hero scroll-fade-in"
      aria-labelledby="hosting-title"
    >
      <p class="hosting-kicker">Managed hosting</p>
      <h1 id="hosting-title" class="hosting-h1">We host it. We watch it. We fix it.</h1>
      <p class="hosting-lead">
        Premium WordPress and web-app hosting wrapped in a Core OS plan — daily site scans,
        malware protection, weekly SEO reports, and a team that actually handles the
        boring stuff. From {company.name}, starting at $600/year.
      </p>
      <div class="hosting-cta-row">
        <a class="hosting-btn hosting-btn--primary" href="#plans">
          See hosting plans
          <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
        </a>
        <a
          class="hosting-btn hosting-btn--ghost brand-btn-glass"
          href="/schedule">Book a call</a
        >
      </div>
    </section>

    <HostingPricingSection />

    <section
      class="hosting-audit-cta scroll-fade-in"
      aria-labelledby="hosting-audit-title"
    >
      <p class="hosting-kicker">Digital audit</p>
      <h2 id="hosting-audit-title" class="hosting-audit-h2">
        Not sure what needs fixing first?
      </h2>
      <p class="hosting-audit-lead">
        Run a free digital audit of your site — speed, SEO, and online presence —
        then we can talk hosting with a clear picture of what’s broken.
      </p>
      <a class="hosting-btn hosting-btn--primary" href="/digital-audit">
        Start a digital audit
        <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
      </a>
    </section>
  </div>
</Layout>

<style>
  .hosting-page {
    min-height: 100vh;
    padding: calc(
        var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) +
          40px
      )
      20px 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hosting-hero {
    width: 100%;
    max-width: 760px;
    text-align: center;
    margin-bottom: 32px;
  }

  .hosting-kicker {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #4ade80;
    margin: 0 0 14px;
  }

  .hosting-h1 {
    margin: 0 0 16px;
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--site-fg, #171717);
  }

  .hosting-lead {
    margin: 0 auto 28px;
    max-width: 580px;
    font-family: var(--font-content);
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--site-fg-muted, #525252);
  }

  .hosting-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .hosting-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      filter 0.15s ease;
    white-space: nowrap;
  }

  .hosting-btn--primary {
    color: var(--site-fg, #171717);
    -webkit-text-fill-color: #fff;
    background: var(--brand-gradient);
    box-shadow: var(--brand-gradient-shadow);
  }

  .hosting-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .hosting-btn--ghost:hover {
    transform: translateY(-1px);
  }

  .hosting-audit-cta {
    width: 100%;
    max-width: 640px;
    margin-top: 56px;
    padding: 36px 28px;
    text-align: center;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }

  .hosting-audit-h2 {
    margin: 0 0 12px;
    font-size: clamp(1.25rem, 3vw, 1.65rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--site-fg, #171717);
  }

  .hosting-audit-lead {
    margin: 0 auto 24px;
    max-width: 480px;
    font-family: var(--font-content);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--site-fg-muted, #525252);
  }
</style>
