---
import Favicon from "../components/Favicon.astro";
import ViewportMeta from "../components/ViewportMeta.astro";
import "../styles/mobile-touch.css";

export const prerender = false;

const assetVersion = __PUBLIC_ASSET_VERSION__;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ViewportMeta />
    <title>Signing out…</title>
    <Favicon />
    <style>
      body { background: #050505; color: #fff; font-family: sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    </style>
  </head>
  <body>
    <p>Signing out…</p>
    <script type="module" define:vars={{ assetVersion }}>
      const sharedMod = await import(`/admin/shared.js?v=${assetVersion}`);
      await sharedMod.performStaffSignOut({ fromDedicatedPage: true });
    </script>
  </body>
</html>
