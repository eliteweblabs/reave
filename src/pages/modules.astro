---
/**
 * /modules — browse the module catalog (same UI as /demo-loader, no toggles).
 */
import Layout from "../layouts/MarketingLayout.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import "../styles/demo-loader.css";

export const prerender = false;

const company = await getCompanyConfig(Astro.request);
---

<Layout
  title="Modules"
  description={`Optional modules for the ${company.name} platform — dealership, fleet, real estate, documents, voice, monitoring, and more.`}
>
  <div class="demo-loader-page">
    <header class="dl-hero">
      <p class="dl-kicker">Optional modules</p>
      <h1 class="dl-h1">Modules</h1>
      <p class="dl-lead">
        Vertical-specific add-ons that plug into the {company.name} platform,
        grouped as Social, E-commerce, and Web Development. Buy them from
        admin → Modules (or call). You cannot flip them on yourself. Every
        module shares the same admin, contacts, and AI agent.
      </p>
    </header>

    <div
      id="demo-loader-app"
      class="dl-app"
      data-toggles="false"
      aria-live="polite"
    >
      <p class="dl-loading">Loading modules…</p>
    </div>
  </div>

  <script is:inline src={`/demo-loader.js?v=${__PUBLIC_ASSET_VERSION__}`}></script>
</Layout>
