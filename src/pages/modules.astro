---
import Layout from "../layouts/Layout.astro";
import SiteAssistantWidget from "../components/SiteAssistantWidget.astro";
import FeaturesPluginsSection from "../components/features/FeaturesPluginsSection.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import { hasFeature } from "../lib/features";
import { isSiteAssistantConfigured } from "../lib/siteAssistant";
import { CORE_PLATFORM_MODULES } from "../lib/platformPlugins";
import { ArrowRight } from "lucide-astro";

const company = await getCompanyConfig(Astro.request);
const showSiteAssistant =
  hasFeature("portal_assistant") && isSiteAssistantConfigured();
---

<Layout
  title="Modules"
  description={`Optional modules for the ${company.name} platform — dealership, fleet, real estate, documents, voice, monitoring, and more. Turn on only what your business needs.`}
>
  <div class="modules-page">
    <section class="modules-hero scroll-fade-in" aria-labelledby="modules-title">
      <p class="modules-kicker">Optional modules</p>
      <h1 id="modules-title" class="modules-h1">Modules</h1>
      <p class="modules-lead">
        Vertical-specific add-ons that plug into the {company.name} platform — turn on
        what fits your business and leave the rest off. Every module shares the same
        admin, contacts, and AI agent.
      </p>
      <div class="modules-core">
        <p class="modules-core-label">Included in the core OS (not add-ons)</p>
        <ul class="modules-core-list">
          {
            CORE_PLATFORM_MODULES.map((name) => (
              <li>{name}</li>
            ))
          }
        </ul>
        <a class="modules-core-link" href="/features">Full platform tour →</a>
      </div>
      <div class="modules-cta-row">
        <a class="modules-btn modules-btn--primary" href="/demo">
          Demo now
          <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
        </a>
        <a class="modules-btn modules-btn--ghost brand-btn-glass" href="/pricing">See pricing</a>
      </div>
    </section>

    <FeaturesPluginsSection standalone />
  </div>

  {
    showSiteAssistant && (
      <SiteAssistantWidget
        brandTitle={company.name}
        supportPhone={company.supportPhone}
        supportEmail={company.supportEmail}
      />
    )
  }
</Layout>

<style>
  .modules-page {
    min-height: 100vh;
    padding: calc(
        var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) +
          40px
      )
      20px 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .modules-hero {
    width: 100%;
    max-width: 760px;
    text-align: center;
    margin-bottom: 24px;
  }

  .modules-kicker {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #38bdf8;
    margin: 0 0 14px;
  }

  .modules-h1 {
    margin: 0 0 16px;
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: #fff;
  }

  .modules-lead {
    margin: 0 auto 24px;
    max-width: 580px;
    font-family: var(--font-content);
    font-size: 1.02rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.68);
  }

  .modules-core {
    margin: 0 auto 28px;
    max-width: 520px;
    padding: 16px 18px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    text-align: left;
  }

  .modules-core-label {
    margin: 0 0 10px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .modules-core-list {
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .modules-core-list li {
    font-size: 0.78rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.22);
  }

  .modules-core-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: #c084fc;
    text-decoration: none;
  }

  .modules-core-link:hover {
    color: #e9d5ff;
  }

  .modules-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .modules-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, filter 0.15s ease;
    white-space: nowrap;
  }

  .modules-btn--primary {
    color: #0b0512;
    background: linear-gradient(145deg, #f472b6 0%, #c026d3 52%, #6366f1 100%);
    box-shadow: 0 8px 24px rgba(192, 38, 211, 0.35);
  }

  .modules-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .modules-btn--ghost:hover {
    transform: translateY(-1px);
  }
</style>
