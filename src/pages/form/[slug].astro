---
import Layout from "../../layouts/Layout.astro";
import ConversationalForm from "../../components/ConversationalForm.astro";
import { getCompanyConfig } from "../../lib/companyConfig";

const { slug } = Astro.params;
const company = await getCompanyConfig(Astro.request);
---

<Layout>
  <style is:global>
    body {
      margin: 0;
      background: #0a0a0a;
    }
  </style>
  {
    slug ? (
      <ConversationalForm
        slug={slug}
        recipientEmail={company.supportEmail || ""}
        brandName={company.name || "REΛVE"}
      />
    ) : null
  }
</Layout>
