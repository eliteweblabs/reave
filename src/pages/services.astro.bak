---
import Layout from "../layouts/Layout.astro";
import HomeServicesSection from "../components/home/HomeServicesSection.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import "../styles/marketing-sections.css";

const company = await getCompanyConfig(Astro.request);
---

<Layout
  title="Services"
  description={`${company.name} — digital consulting, custom development, WordPress, full-stack branding, managed hosting, and one-on-one training.`}
>
  <div class="services-page">
    <HomeServicesSection />
  </div>
</Layout>

<style>
  .services-page {
    min-height: 100vh;
    padding: calc(
        var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) +
          40px
      )
      0 96px;
  }
</style>
