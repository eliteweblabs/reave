---
/**
 * /deploy — super-admin wizard on the official reave.app Railway install only.
 */
import Layout from "../layouts/MarketingLayout.astro";
import { denyUnlessDeploymentOwner } from "../lib/deploymentOwner";
import { hasFeature } from "../lib/features";
import { isCanonicalReaveInstall } from "../lib/installConfig";
import "../styles/demo-loader.css";

export const prerender = false;

if (!isCanonicalReaveInstall() || !hasFeature("deploy_wizard")) {
  return new Response("Not found", { status: 404 });
}

const { userId } = Astro.locals.auth();
if (!userId) {
  return Astro.redirect(
    `/admin/?auth=sign-in&returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
  );
}

const denied = await denyUnlessDeploymentOwner(Astro);
if (denied) return denied;
---

<Layout
  title="Deploy wizard"
  description="Pick modules, then wire Railway with reference variables — no pasted URLs."
  noIndex={true}
>
  <div class="demo-loader-page">
    <header class="dl-hero">
      <p class="dl-kicker">New install</p>
      <h1 class="dl-h1">Deploy wizard</h1>
      <p class="dl-lead">
        Same module picker as the demo loader. After you choose a suite, we
        create the Railway <strong>project and services</strong>, fill
        <strong>reference variables</strong>, and write Cloudflare
        <strong>DNS</strong> — you only type third-party secrets and Clerk’s
        two CNAMEs.
      </p>
    </header>

    <div id="deploy-wizard-app" class="dl-app" aria-live="polite">
      <p class="dl-loading">Loading modules…</p>
    </div>
  </div>

  <script is:inline src={`/module-loader-shared.js?v=${__PUBLIC_ASSET_VERSION__}`}></script>
  <script is:inline src={`/deploy-wizard.js?v=${__PUBLIC_ASSET_VERSION__}`}></script>
</Layout>
