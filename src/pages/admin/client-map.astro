---
/**
 * Standalone owner-only Mapbox map of contacts — full-bleed geographic pins
 * with independent status toggles. Outside the OS map SPA for now.
 */
export const prerender = false;

import ViewportMeta from "../../components/ViewportMeta.astro";
import "../../styles/mobile-touch.css";
import { isDeploymentOwner } from "../../lib/deploymentOwner";
import { getPublicMapboxAccessToken } from "../../lib/mapboxAccessToken";

const { userId } = Astro.locals.auth();
if (!userId) {
  return Astro.redirect(
    `/admin/?auth=sign-in&returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
  );
}

if (!(await isDeploymentOwner(Astro))) {
  return new Response("Forbidden", { status: 403 });
}

const mapboxAccessToken = getPublicMapboxAccessToken() || "";
const assetVersion = __PUBLIC_ASSET_VERSION__;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ViewportMeta />
    <title>Contact map</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="/admin-shell.css" />
    <style>
      :root {
        --bg: #0d1117;
        --fg: #e9eef6;
        --panel: rgba(22, 27, 34, 0.92);
        --panel-border: rgba(48, 54, 61, 0.95);
        --muted: #8b949e;
        --surface-hover: rgba(177, 186, 196, 0.14);
        --radius-input: 10px;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Helvetica", "Arial", sans-serif;
        background: var(--bg);
        color: var(--fg);
      }

      .cgm-root {
        position: relative;
        width: 100%;
        height: 100%;
      }

      .cgm-map-host,
      .cgm-map-canvas {
        position: absolute;
        inset: 0;
      }

      .cgm-map-empty {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.95rem;
        background: rgba(13, 17, 23, 0.55);
        pointer-events: none;
      }

      .cgm-map-empty[hidden] {
        display: none;
      }

      .cgm-chrome {
        position: absolute;
        z-index: 3;
        top: max(0.75rem, env(safe-area-inset-top));
        left: max(0.75rem, env(safe-area-inset-left));
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        width: min(320px, calc(100vw - 1.5rem));
        pointer-events: none;
      }

      .cgm-back,
      .cgm-chrome-panel {
        pointer-events: auto;
      }

      .cgm-back {
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.7rem;
        border: 1px solid var(--panel-border);
        border-radius: var(--radius-input);
        background: var(--panel);
        backdrop-filter: blur(10px);
        color: inherit;
        text-decoration: none;
        font-size: 0.88rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
      }

      .cgm-back:hover {
        background: rgba(28, 33, 40, 0.96);
      }

      .cgm-chrome-panel {
        border: 1px solid var(--panel-border);
        border-radius: 14px;
        background: var(--panel);
        backdrop-filter: blur(12px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
        padding: 0.85rem 0.9rem;
      }

      .cgm-chrome-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.7rem;
      }

      .cgm-title {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
      }

      .cgm-count {
        margin: 0;
        color: var(--muted);
        font-size: 0.78rem;
        white-space: nowrap;
      }

      .cgm-toggles {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      .cgm-toggle {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.35rem 0.2rem;
        cursor: pointer;
        user-select: none;
      }

      .cgm-toggle-switch {
        flex-shrink: 0;
        width: 2.55rem;
        height: 1.45rem;
        border: none;
        border-radius: 999px;
        background: #30363d;
        position: relative;
        cursor: pointer;
        transition: background 0.15s;
        padding: 0;
      }

      .cgm-toggle-switch::after {
        content: '';
        position: absolute;
        top: 0.14rem;
        left: 0.14rem;
        width: 1.15rem;
        height: 1.15rem;
        border-radius: 50%;
        background: #fff;
        transition: transform 0.15s;
      }

      .cgm-toggle.is-on .cgm-toggle-switch {
        background: var(--cgm-kind, #2563eb);
      }

      .cgm-toggle.is-on .cgm-toggle-switch::after {
        transform: translateX(1.1rem);
      }

      .cgm-toggle-meta {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        min-width: 0;
        flex: 1;
      }

      .cgm-toggle-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
      }

      .cgm-toggle-label {
        font-size: 0.86rem;
        font-weight: 600;
      }

      .cgm-toggle-count {
        margin-left: auto;
        font-size: 0.75rem;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }

      .cgm-toggle:not(.is-on) {
        opacity: 0.55;
      }

      .cgm-pin {
        position: relative;
        width: 36px;
        height: 44px;
        padding: 0;
        border: none;
        background: transparent;
        cursor: pointer;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.35));
      }

      .cgm-pin-face {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2.5px solid var(--cgm-kind, #2563eb);
        background: #fff;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
      }

      .cgm-pin-face--initial {
        background: var(--cgm-kind, #2563eb);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 700;
      }

      .cgm-pin-icon {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .cgm-pin-tip {
        position: absolute;
        left: 50%;
        bottom: 2px;
        width: 12px;
        height: 12px;
        transform: translateX(-50%) rotate(45deg);
        background: var(--cgm-kind, #2563eb);
        border-radius: 0 0 2px 0;
      }

      .cgm-pin.is-active {
        z-index: 2;
        filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.45));
      }

      .cgm-pin.is-active .cgm-pin-face {
        width: 36px;
        height: 36px;
        border-width: 3px;
      }

      .cgm-status {
        position: absolute;
        z-index: 4;
        left: 50%;
        bottom: max(1rem, env(safe-area-inset-bottom));
        transform: translateX(-50%);
        max-width: min(420px, calc(100vw - 2rem));
        padding: 0.7rem 0.95rem;
        border-radius: var(--radius-input);
        border: 1px solid var(--panel-border);
        background: var(--panel);
        backdrop-filter: blur(10px);
        font-size: 0.88rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      }

      .cgm-status--error {
        border-color: rgba(248, 113, 113, 0.35);
        background: rgba(60, 20, 20, 0.92);
        color: #f87171;
      }

      .mapboxgl-ctrl-bottom-right {
        margin-bottom: 0.5rem;
        margin-right: 0.5rem;
      }

      .mapboxgl-popup-content {
        padding: 0.7rem 0.8rem;
        border-radius: 10px;
        color: #0d1117;
        font-size: 0.85rem;
        line-height: 1.35;
      }

      .cgm-popup {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .cgm-popup-kind {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #57606a;
      }

      .cgm-popup-addr {
        color: #57606a;
        font-size: 0.78rem;
      }

      .cgm-popup a {
        margin-top: 0.25rem;
        color: #0969da;
        font-weight: 600;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div
      id="clients-geo-map"
      data-mapbox-token={mapboxAccessToken}
    ></div>
    <script is:inline define:vars={{ mapboxAccessToken }}>
      window.__mapboxAccessToken = mapboxAccessToken || "";
    </script>
    <script is:inline type="module" src={`/admin/clients-geo-map.js?v=${assetVersion}`}></script>
  </body>
</html>
