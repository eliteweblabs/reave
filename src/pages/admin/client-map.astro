---
/**
 * Standalone contact geo map — public URL under /admin (no auth), noindex,
 * not linked from main nav. Full-bleed Mapbox pins with status toggles.
 */
export const prerender = false;

import ViewportMeta from "../../components/ViewportMeta.astro";
import "../../styles/mobile-touch.css";
import { loadClientsMapData } from "../../lib/clientsMapData";
import { getPublicMapboxAccessToken } from "../../lib/mapboxAccessToken";

const mapboxAccessToken = getPublicMapboxAccessToken() || "";
const assetVersion = __PUBLIC_ASSET_VERSION__;
const mapResult = await loadClientsMapData();
const initialMapPayload = mapResult.ok ? mapResult.data : { ok: false, error: mapResult.error };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ViewportMeta />
    <meta name="theme-color" content="#0d1117" />
    <title>Contact map</title>
    <meta name="robots" content="noindex, nofollow" />
    <!--
      is:inline keeps CSS in the HTML (no /_astro extract). JS also injects the
      same critical rules + inline layout, so the map cannot go blank again.
    -->
    <style is:inline>
      :root {
        --bg: #0d1117;
        --fg: #e9eef6;
        --panel: rgba(22, 27, 34, 0.92);
        --panel-border: rgba(48, 54, 61, 0.95);
        --muted: #8b949e;
        --surface-hover: rgba(177, 186, 196, 0.14);
        --radius-input: 10px;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        width: 100%;
        height: 100%;
        min-height: 100%;
        min-height: -webkit-fill-available;
        min-height: 100dvh;
        min-height: 100lvh;
        overflow: hidden;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Helvetica", "Arial", sans-serif;
        background-color: var(--bg);
        color: var(--fg);
      }

      .cgm-root {
        position: fixed;
        inset: 0;
        width: auto;
        height: auto;
        min-width: 100%;
        min-height: -webkit-fill-available;
        min-height: 100lvh;
      }

      .cgm-map-host,
      .cgm-map-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        min-height: 100%;
      }

      .cgm-map-empty {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.95rem;
        background: rgba(13, 17, 23, 0.55);
        pointer-events: none;
      }

      .cgm-map-empty[hidden] {
        display: none;
      }

      .cgm-chrome {
        position: absolute;
        z-index: 3;
        top: max(0.75rem, env(safe-area-inset-top));
        left: max(0.75rem, env(safe-area-inset-left));
        right: max(0.75rem, env(safe-area-inset-right));
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 0.55rem;
        width: auto;
        max-width: 360px;
        pointer-events: none;
      }

      .cgm-back {
        pointer-events: auto;
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        border: 1px solid var(--panel-border);
        border-radius: 14px;
        background: var(--panel);
        backdrop-filter: blur(12px);
        color: inherit;
        text-decoration: none;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
      }

      .cgm-back:hover {
        background: rgba(28, 33, 40, 0.96);
      }

      .cgm-back svg {
        display: block;
      }

      .cgm-chrome-panel {
        pointer-events: auto;
        flex: 1 1 auto;
        min-width: 0;
        border: 1px solid var(--panel-border);
        border-radius: 14px;
        background: var(--panel);
        backdrop-filter: blur(12px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
        padding: 0.45rem 0.65rem;
      }

      .cgm-toolbar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 1.85rem;
      }

      .cgm-count {
        margin: 0;
        margin-right: auto;
        color: var(--muted);
        font-size: 0.78rem;
        white-space: nowrap;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .cgm-settings-btn {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: inherit;
        cursor: pointer;
      }

      .cgm-settings-btn:hover,
      .cgm-settings-btn[aria-expanded='true'] {
        background: var(--surface-hover);
      }

      .cgm-settings-btn svg {
        display: block;
      }

      .cgm-filters {
        margin-top: 0.45rem;
        padding-top: 0.35rem;
        border-top: 1px solid var(--panel-border);
      }

      .cgm-filters[hidden] {
        display: none !important;
      }

      .cgm-toggles {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
      }

      .cgm-toggle {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.4rem 0.15rem;
        cursor: pointer;
        user-select: none;
      }

      .cgm-toggle-input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
        pointer-events: none;
      }

      .cgm-toggle-track {
        flex-shrink: 0;
        width: 2.55rem;
        height: 1.45rem;
        border-radius: 999px;
        background: #30363d;
        position: relative;
        transition: background 0.15s;
      }

      .cgm-toggle-track::after {
        content: '';
        position: absolute;
        top: 0.14rem;
        left: 0.14rem;
        width: 1.15rem;
        height: 1.15rem;
        border-radius: 50%;
        background: #fff;
        transition: transform 0.15s;
      }

      .cgm-toggle.is-on .cgm-toggle-track,
      .cgm-toggle-input:checked + .cgm-toggle-track {
        background: var(--cgm-kind, #2563eb);
      }

      .cgm-toggle.is-on .cgm-toggle-track::after,
      .cgm-toggle-input:checked + .cgm-toggle-track::after {
        transform: translateX(1.1rem);
      }

      .cgm-toggle-meta {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        min-width: 0;
        flex: 1;
      }

      .cgm-toggle-label {
        font-size: 0.86rem;
        font-weight: 600;
      }

      .cgm-toggle-count {
        margin-left: auto;
        font-size: 0.75rem;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }

      .cgm-toggle:not(.is-on) {
        opacity: 0.55;
      }

      .cgm-pin {
        position: relative;
        box-sizing: border-box;
        width: 36px;
        height: 52px;
        padding: 0;
        border: none;
        background: transparent;
        cursor: pointer;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.35));
        transform-origin: bottom center;
      }

      .cgm-pin-body {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        pointer-events: none;
      }

      .cgm-pin-body path {
        fill: var(--cgm-kind, #2563eb);
        stroke: none;
      }

      .cgm-pin-face {
        position: absolute;
        top: 6px;
        left: 50%;
        transform: translateX(-50%);
        width: 20px;
        height: 20px;
        border: none;
        border-radius: 50%;
        background: transparent;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
      }

      .cgm-pin-face--initial {
        background: transparent;
        color: #fff;
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1;
      }

      .cgm-pin-face--photo {
        background: #fff;
      }

      .cgm-pin-icon {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .cgm-pin.is-active {
        z-index: 2;
        filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.45));
        transform: scale(1.08);
      }

      .cgm-status {
        position: absolute;
        z-index: 4;
        left: 50%;
        bottom: max(1rem, env(safe-area-inset-bottom));
        transform: translateX(-50%);
        max-width: min(420px, calc(100vw - 2rem));
        padding: 0.7rem 0.95rem;
        border-radius: var(--radius-input);
        border: 1px solid var(--panel-border);
        background: var(--panel);
        backdrop-filter: blur(10px);
        font-size: 0.88rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      }

      .cgm-status--error {
        border-color: rgba(248, 113, 113, 0.35);
        background: rgba(60, 20, 20, 0.92);
        color: #f87171;
      }

      .mapboxgl-ctrl-bottom-right {
        margin-bottom: 0.5rem;
        margin-right: 0.5rem;
      }

      .mapboxgl-popup-content {
        padding: 0.7rem 0.8rem;
        border-radius: 10px;
        color: #0d1117;
        font-size: 0.85rem;
        line-height: 1.35;
      }

      .cgm-popup {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .cgm-popup-kind {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #57606a;
      }

      .cgm-popup-addr {
        color: #57606a;
        font-size: 0.78rem;
      }

      .cgm-popup a {
        margin-top: 0.25rem;
        color: #0969da;
        font-weight: 600;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div
      id="clients-geo-map"
      data-mapbox-token={mapboxAccessToken}
    ></div>
    <script is:inline define:vars={{ mapboxAccessToken, initialMapPayload }}>
      window.__mapboxAccessToken = mapboxAccessToken || "";
      window.__clientsMapPayload = initialMapPayload;
    </script>
    <script is:inline type="module" src={`/admin/clients-geo-map.js?v=${assetVersion}`}></script>
  </body>
</html>
