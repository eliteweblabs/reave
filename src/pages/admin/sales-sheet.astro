---
/**
 * Dummy-first preview for the audit sales one-pager.
 *
 * Same admin shell as the rest of /admin: header, deploy indicator, footer
 * nav, settings in a resizable sidebar, print preview in the detail pane.
 * Print is two-sided: custom client audit + a static reΛVe.app trifold
 * (gate / back / front cover).
 */
export const prerender = false;

import AdminSpecialLayout from '../../layouts/AdminSpecialLayout.astro';
import { denyUnlessDeploymentOwner } from '../../lib/deploymentOwner';
import { getCompanyConfig } from '../../lib/companyConfig';
import { getStoredCompanyConfig } from '../../lib/companyConfigStore';
import { renderCompanyBrandIconPng } from '../../lib/brandImageRender';
import { getTemplate, fillTemplate, renderFilledDocumentHtml } from '../../lib/documentTemplates';
import {
  applyPlacesMissForSheet,
  applySalesSheetParamOverrides,
  auditOnePagerSlug,
  fillAuditOnePager,
  injectAuditDisclaimerIntoFooter,
  listAuditCompanies,
  parseSalesSheetOrientation,
  renderAuditDisclaimerHtml,
  salesSheetAuditUrl,
  salesSheetWantsGoogleShot,
  salesSheetInputFromReportCard,
  salesSheetInputFromSearchParams,
} from '../../lib/auditSalesSheet';
import { extractPortal, getContact, type ContactRecord } from '../../lib/contactApi';
import { buildAuditReportCard } from '../../lib/auditReportCard';
import { googlePlacesListedForContact } from '../../lib/auditPlacesListing';
import { isSafeWorkSlug, storeListWork, storeReadWork } from '../../lib/workStore';
import { fetchSalesSheetPlaces } from '../../lib/salesSheetPlaces';
import {
  auditUrlShotLooksDown,
  probeAuditHttps,
  screenshotAuditUrl,
  screenshotGoogleSearchResults,
} from '../../lib/salesSheetPlacesShot';
import {
  injectAuditQrIntoHeader,
  renderPlacesPhoneMockHtml,
  renderSalesSheetQrHtml,
  resolveIphoneFrameSrc,
  shortPlaceFromAddress,
} from '../../lib/salesSheetPlacesView';
import {
  applyLiveUrlToFindings,
  dropWorkingSiteDownFindings,
  injectAuditHeroIntoHeader,
  renderFindingPhoneHtml,
  renderSalesSheetFrontExhibitsHtml,
  renderSalesSheetHeaderHeroHtml,
  replaceOnePagerColsInner,
  replaceOnePagerLogo,
  salesSheetClientLogoHtml,
  salesSheetExhibitKind,
  salesSheetWantsPlacesExhibit,
} from '../../lib/salesSheetExhibits';
import { inlineClientHeroLogoDataUrl } from '../../lib/clientBranding';
import { lighthousePsiMobile } from '../../lib/lighthouseClient';
import { psiMobileFromAudit, type PsiMobileCard } from '../../lib/salesSheetPsi';
import { qrCodeDataUrl } from '../../lib/qrCode';
import { companyBrandMarkHtml } from '../../lib/documentPrintLayout';
import { storeGetMediaBySlug } from '../../lib/mediaLibrary';
import { listModuleCatalog } from '../../lib/moduleCatalogStore';
import { renderSalesSheetBackHtml, salesSheetBackModules, salesSheetStackLogos } from '../../lib/salesSheetBack';
import {
  DIRECTORY_ICON_GROUPS,
  directoryIconGroupById,
  parseDirectoryIconGroup,
  pinDirectoryCoverageFirst,
  summarizeDirectoryChecks,
} from '../../lib/salesSheetDirectories';
import { checkDirectoryCoverage } from '../../lib/salesSheetDirectoryCheck';
import { isSocialCoveredByDirectories } from '../../lib/salesSheetCascade';

const { userId } = Astro.locals.auth();
if (!userId) {
  const returnTo = encodeURIComponent(Astro.url.pathname + Astro.url.search);
  return Astro.redirect(`/admin/?auth=sign-in&returnTo=${returnTo}`);
}

const denied = await denyUnlessDeploymentOwner(Astro);
if (denied) return denied;

const params = Astro.url.searchParams;
const orientation = parseSalesSheetOrientation(params.get('orientation'));
const runSlug = (params.get('run') || '').trim();
const auditCompanies = listAuditCompanies(await storeListWork());
const selectedAudit = auditCompanies.find((c) => c.slug === runSlug) || null;

let input = salesSheetInputFromSearchParams(params);
let sourceNote = 'Dummy fixture';
let directoryNotes = '';
const renderStarted = Date.now();
const renderLog: string[] = [];
const logRender = (line: string) => {
  renderLog.push(line);
};

if (selectedAudit && isSafeWorkSlug(selectedAudit.slug)) {
  const doc = await storeReadWork(selectedAudit.slug);
  if (doc) {
    let contact: ContactRecord = {
      uid: doc.contact_uid || 'preview',
      name: doc.contact_name || selectedAudit.contactName || selectedAudit.company,
      company: selectedAudit.company,
    };
    if (doc.contact_uid) {
      try {
        const res = await getContact(doc.contact_uid);
        if (res.ok) {
          contact = {
            ...res.data,
            company: res.data.company || selectedAudit.company || res.data.name,
          };
        }
      } catch {
        /* keep job-derived contact */
      }
    }
    const listedFlag = await googlePlacesListedForContact(doc.contact_uid);
    const portal = extractPortal(contact);
    const contactWebsite =
      portal?.website?.trim() ||
      portal?.fields?.find((f) => /^(website|site) url$/i.test(f.label || ''))?.value?.trim() ||
      '';
    const card = buildAuditReportCard({
      tags: doc.tags,
      source: doc.source,
      title: doc.title,
      body: doc.body || '',
      clientName: contact.company || contact.name,
      googlePlacesListed: listedFlag,
      website: contactWebsite,
    });
    if (card && !card.inProgress) {
      input = applySalesSheetParamOverrides(
        salesSheetInputFromReportCard(card, contact, {
          googlePlacesListed: listedFlag,
          body: doc.body || '',
        }),
        params,
      );
      const listings = card.categories.find((c) => c.id === 'local_listings');
      directoryNotes = [listings?.summary || '', ...(listings?.why || [])].filter(Boolean).join('\n');
      sourceNote = `Live audit · ${selectedAudit.company}`;
      logRender(`Audit ${selectedAudit.slug} · ${selectedAudit.company}`);
    } else {
      sourceNote = card?.inProgress
        ? `Audit still running for ${selectedAudit.company} — showing dummy until it finishes.`
        : `Could not parse the audit for ${selectedAudit.company} — showing dummy.`;
      logRender(sourceNote);
    }
  }
}

const company = await getCompanyConfig(Astro.request);
const slug = auditOnePagerSlug(orientation);
const tmpl = getTemplate(slug);

const skipPlaces = params.get('places') === '0';
const googleParam = params.get('google');
const wantGoogleShot = salesSheetWantsGoogleShot(googleParam);
const listedParam = (params.get('listed') || '').trim();
const iconGroup = parseDirectoryIconGroup(params.get('iconGroup'));
const iconGroupMeta = directoryIconGroupById(iconGroup);
const forceNotListed = listedParam === '0';
const forceListed = listedParam === '1';
const contactPortal = extractPortal(input.contact);
const near =
  (params.get('near') || '').trim() ||
  shortPlaceFromAddress(contactPortal?.address || '');
const category = (params.get('category') || '').trim();
const placesQuery = (input.contact.company || input.contact.name || '').trim();
const businessName = (input.contact.company || input.contact.name || '').trim();

if (!selectedAudit) logRender('Dummy fixture');
logRender(`Site ${input.website || '(none)'} · ${input.findings.length} cascade rows`);
logRender(`Pool: ${input.findings.map((f) => f.id).join(', ') || '(empty)'}`);

const places = await fetchSalesSheetPlaces({
  query: placesQuery,
  near,
  category,
  forceNotListed,
  skipNetwork: skipPlaces,
});
if (places.error) logRender(`FAIL Places lookup — ${places.error}`);
else {
  logRender(
    `Places ${places.source} · listed=${places.listed ? 'yes' : 'no'} · ${places.competitors.length} nearby`,
  );
}

const frameSrc = await resolveIphoneFrameSrc();
let placesScreenSrc = '';
let siteScreenSrc = '';
let shotNote = '';
let serpListed: boolean | null = null;

const liveAudit = Boolean(selectedAudit);
const placesForce = forceListed || forceNotListed;
const notListedGuess = forceListed ? false : forceNotListed ? true : !places.listed;
input = applyPlacesMissForSheet(input, notListedGuess, { liveAudit, force: placesForce });
let findings = input.findings;
const showPlaces = salesSheetWantsPlacesExhibit(findings);

if (showPlaces && wantGoogleShot && notListedGuess) {
  logRender(`Capturing search results for “${placesQuery}”${near ? ` near ${near}` : ''}…`);
  const serp = await screenshotGoogleSearchResults({
    query: placesQuery,
    near,
    lat: contactPortal?.geo?.lat,
    lng: contactPortal?.geo?.lng,
  });
  if (serp.ok) {
    serpListed = serp.listed;
    if (serp.listed) {
      const before = findings.length;
      input = applyPlacesMissForSheet(input, false, { liveAudit, force: placesForce });
      findings = input.findings;
      if (findings.length < before) {
        shotNote = 'Google opened their listing — Maps is working, so it is not an exhibit.';
        logRender('Search results show a listing — dropped the Places phone.');
      } else {
        shotNote = 'Dummy Maps phone kept — live Google matched a different listing.';
        logRender('Dummy fixture keeps four phones (live Google listing ignored).');
      }
    } else {
      placesScreenSrc = `data:image/png;base64,${serp.pngBase64}`;
      shotNote = 'Live Google results in the Places iPhone — they are missing.';
      logRender('Search results captured — business is missing.');
    }
  } else {
    shotNote = `Google screenshot failed (${serp.error}).`;
    logRender(`FAIL search screenshot — ${serp.error}`);
  }
} else if (showPlaces && !wantGoogleShot) {
  logRender('Live search screenshot is off.');
}

const notListed = forceListed
  ? false
  : forceNotListed
    ? true
    : serpListed === true
      ? false
      : notListedGuess;
findings = input.findings;

const hasDownExhibit = findings.some((f) => {
  const kind = salesSheetExhibitKind(f);
  return kind === 'site-down' || kind === 'domain';
});
const hasSslExhibit = findings.some((f) => salesSheetExhibitKind(f) === 'ssl');
if ((hasDownExhibit || hasSslExhibit) && input.website.trim()) {
  logRender(`Probing HTTPS for ${input.website} (www + apex)…`);
  const probe = await probeAuditHttps(input.website);
  for (const url of probe.cleanUrls) logRender(`OK ${url}`);
  for (const url of probe.insecureUrls) logRender(`FAIL cert/HTTP ${url}`);
  for (const url of probe.downUrls) logRender(`FAIL down ${url}`);
  const live = applyLiveUrlToFindings(findings, probe);
  findings = live.findings;
  if (live.website) input = { ...input, website: live.website, findings };
  else input = { ...input, findings };
  if (live.note) {
    shotNote = `${shotNote} ${live.note}`.trim();
    logRender(live.note);
  }

  const stillDown = findings.some((f) => {
    const kind = salesSheetExhibitKind(f);
    return kind === 'site-down' || kind === 'domain';
  });
  if (stillDown && probe.downUrls[0]) {
    logRender(`Capturing down page ${probe.downUrls[0]}…`);
    const siteShot = await screenshotAuditUrl(probe.downUrls[0]);
    if (siteShot.ok && !auditUrlShotLooksDown(siteShot)) {
      findings = dropWorkingSiteDownFindings(findings);
      input = { ...input, findings };
      shotNote = `${shotNote} Live site loaded — dropped Site Down.`.trim();
      logRender('Live capture loaded — dropped Site Down.');
    } else if (siteShot.ok && auditUrlShotLooksDown(siteShot)) {
      siteScreenSrc = `data:image/png;base64,${siteShot.pngBase64}`;
      shotNote = `${shotNote} Live ${probe.downUrls[0]} is down — showing the error screen.`.trim();
      logRender(`Down capture kept (${siteShot.status ?? 'no status'} · ${siteShot.title || siteShot.finalUrl}).`);
    } else if (!siteShot.ok) {
      shotNote = `${shotNote} Live site shot failed (${siteShot.error}) — using the phone error screen.`.trim();
      logRender(`FAIL site shot — ${siteShot.error}`);
    }
  }
} else if ((hasDownExhibit || hasSslExhibit) && !input.website.trim()) {
  logRender('FAIL no site URL — cannot live-check SSL / Site Down.');
}

findings = pinDirectoryCoverageFirst(
  findings.filter((finding) => !isSocialCoveredByDirectories(finding)),
).slice(0, 4);
input = { ...input, findings };
if (!shotNote) shotNote = 'Four iPhone exhibits from the top cascade hits.';
logRender(`Four phones: ${findings.map((f) => `${f.categoryLabel} (${f.id})`).join(', ') || '(none)'}`);
logRender(`Icon group: ${iconGroupMeta.label}`);

let directoryChecks = undefined as Awaited<ReturnType<typeof checkDirectoryCoverage>> | undefined;
let speedPsi: PsiMobileCard | undefined;
const skipPsi = params.get('psi') === '0';
const hasSpeedExhibit = findings.some((finding) => salesSheetExhibitKind(finding) === 'speed');
const siteLooksLive =
  Boolean(input.website.trim()) &&
  !/\.example(?:$|\/)/i.test(input.website) &&
  !/^https?:\/\/(?:localhost|127\.0\.0\.1)\b/i.test(input.website);

if (input.website.trim()) {
  logRender(`Checking directory links on ${input.website}…`);
  const dirPromise = checkDirectoryCoverage({
    website: input.website,
    businessName,
    googlePlacesListed: !notListed,
    iconGroup,
  });
  const psiPromise =
    hasSpeedExhibit && siteLooksLive && !skipPsi
      ? lighthousePsiMobile(
          /^https?:\/\//i.test(input.website) ? input.website : `https://${input.website}`,
        ).catch((e) => ({
          ok: false as const,
          error: e instanceof Error ? e.message : String(e),
        }))
      : Promise.resolve(null);
  const [dirResult, psiResult] = await Promise.all([dirPromise, psiPromise]);
  directoryChecks = dirResult;
  const summary = summarizeDirectoryChecks(directoryChecks);
  findings = findings.map((finding) =>
    salesSheetExhibitKind(finding) === 'directories' ? { ...finding, problem: summary } : finding,
  );
  input = { ...input, findings };
  logRender(summary);
  if (psiResult?.ok) {
    speedPsi = psiMobileFromAudit(psiResult);
    const perf = speedPsi.scores.performance;
    const lcp = speedPsi.metrics.lcp;
    logRender(
      `PageSpeed Insights · mobile${perf != null ? ` ${perf}` : ''}${lcp ? ` · LCP ${lcp}` : ''}`,
    );
  } else if (hasSpeedExhibit && psiResult && !psiResult.ok) {
    logRender(`FAIL PageSpeed Insights — ${psiResult.error}`);
  } else if (hasSpeedExhibit) {
    logRender('Site Speed using the PageSpeed Insights stand-in (no live mobile run).');
  }
}

logRender(`Done in ${((Date.now() - renderStarted) / 1000).toFixed(1)}s`);

const exhibitPhones = findings.map((finding) => {
  const kind = salesSheetExhibitKind(finding);
  if (kind === 'places' && notListed) {
    return renderPlacesPhoneMockHtml(
      { ...places, near, listed: false },
      { frameSrc, screenSrc: placesScreenSrc },
    );
  }
  const live = (kind === 'site-down' || kind === 'domain') && siteScreenSrc ? siteScreenSrc : '';
  return renderFindingPhoneHtml(finding, {
    website: input.website,
    businessName,
    frameSrc,
    screenSrc: live,
    googlePlacesListed: !notListed,
    directoryNotes,
    directoryChecks: kind === 'directories' ? directoryChecks : undefined,
    directoryIconGroup: iconGroup,
    psi: kind === 'speed' ? speedPsi : undefined,
  });
});

const frontExhibits = renderSalesSheetFrontExhibitsHtml({
  findings,
  phones: exhibitPhones,
  snapshot: {
    overall: input.overall,
    overallScore: input.overallScore,
    performance: input.performance,
    security: input.security,
    visibility: input.visibility,
  },
});

const auditUrl = selectedAudit?.contactUid
  ? salesSheetAuditUrl(
      new URLSearchParams({ uid: selectedAudit.contactUid, project: selectedAudit.slug }),
      Astro.url.origin,
    )
  : salesSheetAuditUrl(params, Astro.url.origin);
let qrHtml = '';
try {
  const qrSrc = await qrCodeDataUrl(auditUrl, 160);
  qrHtml = renderSalesSheetQrHtml(qrSrc, auditUrl);
} catch (e) {
  shotNote = `${shotNote} QR failed (${e instanceof Error ? e.message : String(e)}).`.trim();
}

async function inlineMediaSrc(src: string, slugHint = ''): Promise<string> {
  const fromUrl = src.match(/\/api\/media\/([^/?#]+)/)?.[1] || '';
  const mediaSlug = decodeURIComponent(slugHint || fromUrl).trim();
  if (!mediaSlug) return src;
  try {
    const rec = await storeGetMediaBySlug(mediaSlug);
    if (rec?.dataBase64 && rec.mediaType) {
      return `data:${rec.mediaType};base64,${rec.dataBase64}`;
    }
  } catch {
    /* keep the public URL */
  }
  return src;
}

const backStackLogos = await Promise.all(
  salesSheetStackLogos().map(async (logo) => ({
    ...logo,
    src: await inlineMediaSrc(logo.src, logo.slug || ''),
  })),
);
const storedBrand = await getStoredCompanyConfig();
const backIconPng = await renderCompanyBrandIconPng(storedBrand, 256, { transparent: true });
const backIconSrc = `data:image/png;base64,${backIconPng.toString('base64')}`;
const backHtml = renderSalesSheetBackHtml({
  company,
  orientation,
  stackLogos: backStackLogos,
  iconSrc: backIconSrc,
  logoHtml: companyBrandMarkHtml('logo', company, { size: 'xl', idPrefix: 'ss-back-logo' }),
  modules: salesSheetBackModules(await listModuleCatalog()),
});

let error = '';
let sheetHtml = '';

if (!tmpl) {
  error = `Template ${slug} is missing.`;
  logRender(`FAIL ${error}`);
} else {
  try {
    const source = fillAuditOnePager(tmpl.markdown, input);
    const filled = fillTemplate(source, input.contact, company);
    const rendered = await renderFilledDocumentHtml(filled, company, slug, input.contact);
    const heroHtml = renderSalesSheetHeaderHeroHtml({
      overall: input.overall,
      overallScore: input.overallScore,
      headline: input.headline,
      heroStats: input.heroStats,
      findings: input.findings,
      performance: input.performance,
      security: input.security,
      visibility: input.visibility,
    });
    const clientLogoSrc = await inlineClientHeroLogoDataUrl(input.contact.uid || '');
    sheetHtml = replaceOnePagerLogo(
      injectAuditDisclaimerIntoFooter(
        injectAuditHeroIntoHeader(
          injectAuditQrIntoHeader(
            replaceOnePagerColsInner(rendered, `<div class="doc-onepager-col">${frontExhibits}</div>`),
            qrHtml,
          ),
          heroHtml,
        ),
        renderAuditDisclaimerHtml(input.findings),
      ),
      salesSheetClientLogoHtml({
        src: clientLogoSrc,
        name: businessName,
      }),
    );
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    logRender(`FAIL render — ${error}`);
  }
}

const finding1 = input.findings[0];
const finding2 = input.findings[1];
const finding3 = input.findings[2];
const finding4 = input.findings[3];
const placesNote = places.error
  ? `${places.source === 'places' ? 'Places' : 'Places lookup'} — ${places.error}`
  : places.source === 'places'
    ? `Google Places · ${places.competitors.length} nearby results`
    : 'No Places neighbors for this search';

const assetVersion = __PUBLIC_ASSET_VERSION__;
---

<AdminSpecialLayout
  title="Audit sales sheet"
  requireOwner
  showFooterNav
  backHref="/admin/?tab=documents"
  backLabel="Back to documents"
  bodyClass="admin-split-view"
>
  <link
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap"
    rel="stylesheet"
  />

  <div id="sales-sheet-editor">
    <aside class="ch-sidebar" aria-label="Sales sheet settings">
      <form class="ss-settings" id="ss-form" method="get" action="/admin/sales-sheet">
        <header>
          <h1 class="prof-title">Audit sales sheet</h1>
          <p class="prof-subtitle">
            {sourceNote}. Top four problems, each as an iPhone. Print is
            two-sided — client audit on the front, reΛVe.app back on every sheet.
          </p>
        </header>

        {error ? <p class="ss-error">{error}</p> : null}

        <div class="ss-settings-grid">
          <div class="prof-field">
            <label for="orientation">Orientation</label>
            <select id="orientation" name="orientation">
              <option value="landscape" selected={orientation === 'landscape'}>Landscape</option>
              <option value="portrait" selected={orientation === 'portrait'}>Portrait</option>
            </select>
          </div>
          <div class="prof-field">
            <label for="run">Company</label>
            <select id="run" name="run">
              <option value="" selected={!selectedAudit}>Dummy — Hale &amp; Co.</option>
              {auditCompanies.map((opt) => (
                <option value={opt.slug} selected={selectedAudit?.slug === opt.slug}>
                  {opt.company}
                </option>
              ))}
            </select>
          </div>
          <div class="prof-field">
            <label for="name">Prepared for</label>
            <input id="name" name="name" value={input.contact.name} />
          </div>
          <div class="prof-field">
            <label for="site">Site</label>
            <input id="site" name="site" value={input.website} />
          </div>
          <div class="prof-field">
            <label for="overall">Overall</label>
            <input id="overall" name="overall" maxlength="1" value={input.overall ?? ''} />
          </div>
          <div class="prof-field">
            <label for="score">Score</label>
            <input id="score" name="score" inputmode="numeric" value={input.overallScore ?? ''} />
          </div>
          <div class="prof-field">
            <label for="performance">Performance</label>
            <input id="performance" name="performance" maxlength="1" value={input.performance ?? ''} />
          </div>
          <div class="prof-field">
            <label for="security">Security</label>
            <input id="security" name="security" maxlength="1" value={input.security ?? ''} />
          </div>
          <div class="prof-field">
            <label for="visibility">Visibility</label>
            <input id="visibility" name="visibility" maxlength="1" value={input.visibility ?? ''} />
          </div>
          <div class="prof-field">
            <label for="near">Near (city or lat,lng)</label>
            <input id="near" name="near" value={near} placeholder="Boston, MA" />
          </div>
          <div class="prof-field">
            <label for="category">Competitor search</label>
            <input id="category" name="category" value={category} placeholder="law firm" />
          </div>
          <div class="prof-field">
            <label for="listed">Listed override</label>
            <select id="listed" name="listed">
              <option value="" selected={listedParam === ''}>Use Places</option>
              <option value="0" selected={listedParam === '0'}>Force not listed</option>
              <option value="1" selected={listedParam === '1'}>Force listed</option>
            </select>
          </div>
          <div class="prof-field">
            <label for="iconGroup">Industry icon group</label>
            <select id="iconGroup" name="iconGroup" title={iconGroupMeta.hint}>
              {DIRECTORY_ICON_GROUPS.map((group) => (
                <option value={group.id} selected={iconGroup === group.id}>
                  {group.label}
                </option>
              ))}
              <option disabled>More packs later</option>
            </select>
          </div>
          <div class="ss-check prof-field">
            <input id="google" name="google" type="checkbox" value="1" checked={wantGoogleShot} />
            <label for="google">Live Google screenshot</label>
          </div>
          <div class="prof-field">
            <label for="headline">Headline</label>
            <input id="headline" name="headline" value={input.headline} />
          </div>
          <div class="prof-field">
            <label for="audit">Full audit URL (QR)</label>
            <input id="audit" name="audit" value={auditUrl} />
          </div>
          <div class="prof-field">
            <label for="label1">Finding 1 label</label>
            <input id="label1" name="label1" value={finding1?.categoryLabel ?? ''} />
          </div>
          <div class="prof-field">
            <label for="finding1">Finding 1 problem</label>
            <textarea id="finding1" name="finding1">{finding1?.problem ?? ''}</textarea>
          </div>
          <div class="prof-field">
            <label for="label2">Finding 2 label</label>
            <input id="label2" name="label2" value={finding2?.categoryLabel ?? ''} />
          </div>
          <div class="prof-field">
            <label for="finding2">Finding 2 problem</label>
            <textarea id="finding2" name="finding2">{finding2?.problem ?? ''}</textarea>
          </div>
          <div class="prof-field">
            <label for="label3">Finding 3 label</label>
            <input id="label3" name="label3" value={finding3?.categoryLabel ?? ''} />
          </div>
          <div class="prof-field">
            <label for="finding3">Finding 3 problem</label>
            <textarea id="finding3" name="finding3">{finding3?.problem ?? ''}</textarea>
          </div>
          <div class="prof-field">
            <label for="label4">Finding 4 label</label>
            <input id="label4" name="label4" value={finding4?.categoryLabel ?? ''} />
          </div>
          <div class="prof-field">
            <label for="finding4">Finding 4 problem</label>
            <textarea id="finding4" name="finding4">{finding4?.problem ?? ''}</textarea>
          </div>
        </div>

        <div class="prof-actions">
          <button class="prof-btn-primary" id="ss-update" type="submit">Update sheet</button>
          <a class="prof-btn-secondary" href="/admin/sales-sheet">Reset dummy</a>
          <button class="prof-btn-secondary" type="button" onclick="window.print()">Print / Save PDF</button>
        </div>
        <section class="ss-log" id="ss-render-log" aria-label="Render log">
          <h2>Render log</h2>
          <ol>
            {renderLog.map((line) => (
              <li class={/fail|error|timeout/i.test(line) ? 'ss-log-fail' : ''}>{line}</li>
            ))}
          </ol>
          <p>
            {placesNote}. {shotNote}
            {notListed
              ? ' Places miss is on the sheet because they are not listed.'
              : ' Maps listing is working — not shown.'}
          </p>
        </section>
      </form>
    </aside>

    <section class="de-pane" aria-label="Sales sheet preview">
      {sheetHtml ? (
        <div class="ss-sheet">
          <div set:html={sheetHtml} />
          <div set:html={backHtml} />
        </div>
      ) : (
        <p class="de-placeholder">No sheet to preview.</p>
      )}
      <div class="ss-busy-mask" id="ss-busy-mask" hidden>
        <div class="ss-render" role="status" aria-live="polite">
          <div class="ss-render-spin" aria-hidden="true"></div>
          <p class="ss-render-title">Rendering</p>
          <p class="ss-render-time" id="ss-render-time">0s</p>
          <ol class="ss-render-live" id="ss-render-live"></ol>
        </div>
      </div>
    </section>
  </div>

  <script is:inline type="module" src={`/admin/sales-sheet-page.js?v=${assetVersion}`}></script>
</AdminSpecialLayout>
