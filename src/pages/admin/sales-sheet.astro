---
/**
 * Dummy-first preview for the audit sales one-pager.
 *
 * First paint is the form + a letter-page skeleton. Places / Playwright
 * run on GET /api/admin/sales-sheet so the dashboard link is not a blank wait.
 * Print is two-sided: custom client audit + a static REΛVE back
 * (hosting with stack marks along the bottom + cover).
 */
export const prerender = false;

import ViewportMeta from '../../components/ViewportMeta.astro';
import Favicon from '../../components/Favicon.astro';
import { denyUnlessDeploymentOwner } from '../../lib/deploymentOwner';
import { listSalesSheetCompanies } from '../../lib/salesSheetPage';
import {
  renderSalesSheetSkeletonHtml,
  salesSheetShellFromParams,
} from '../../lib/salesSheetSkeleton';

const { userId } = Astro.locals.auth();
if (!userId) {
  const returnTo = encodeURIComponent(Astro.url.pathname + Astro.url.search);
  return Astro.redirect(`/admin/?auth=sign-in&returnTo=${returnTo}`);
}

const denied = await denyUnlessDeploymentOwner(Astro);
if (denied) return denied;

const params = Astro.url.searchParams;
const shell = salesSheetShellFromParams(params, Astro.url.origin);
const auditCompanies = await listSalesSheetCompanies();
const selectedAudit = auditCompanies.find((c) => c.slug === shell.runSlug) || null;
const orientation = shell.orientation;
const form = shell.form;
const skeletonHtml = renderSalesSheetSkeletonHtml(
  orientation,
  shell.wantGoogleShot ? 'Loading Google Places…' : 'Loading sales sheet…',
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ViewportMeta />
    <meta name="robots" content="noindex, nofollow" />
    <title>Audit sales sheet (dummy)</title>
    <Favicon />
    <link rel="stylesheet" href="/admin-shell.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #0d1117;
        --fg: #e9eef6;
        --panel: #161b22;
        --panel-border: #30363d;
        --card: #1c2128;
        --muted: #8b949e;
        --accent: #58a6ff;
        --surface-hover: rgba(177, 186, 196, 0.12);
        --radius-input: 8px;
        --sk-base: rgba(255, 255, 255, 0.065);
        --sk-shine: rgba(255, 255, 255, 0.2);
      }
      html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--fg); }
      body {
        font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }
      .ss-chrome { max-width: 1100px; margin: 0 auto; padding: 1.25rem 1rem 2rem; }
      .ss-back {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.45rem 0.65rem;
        border: 1px solid var(--panel-border);
        border-radius: var(--radius-input);
        color: inherit;
        text-decoration: none;
        font-size: 0.88rem;
        margin-bottom: 1rem;
      }
      .ss-back:hover { background: var(--surface-hover); }
      .ss-title { font-size: 1.6rem; font-weight: 700; margin: 0 0 0.35rem; }
      .ss-sub { color: var(--muted); margin: 0 0 1.25rem; line-height: 1.5; font-size: 0.95rem; }
      .ss-panel {
        background: var(--panel);
        border: 1px solid var(--panel-border);
        border-radius: 12px;
        padding: 1.1rem 1.15rem 1.2rem;
        margin-bottom: 1.25rem;
      }
      .ss-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 0.75rem;
        align-items: end;
      }
      .ss-grid-wide { grid-template-columns: 1fr; }
      .ss-field { display: flex; flex-direction: column; gap: 0.3rem; }
      .ss-field label {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      .ss-field input, .ss-field select, .ss-field textarea {
        padding: 0.5rem 0.6rem;
        border: 1px solid var(--panel-border);
        border-radius: var(--radius-input);
        background: var(--card);
        color: var(--fg);
        font-size: 0.9rem;
        font-family: inherit;
      }
      .ss-field textarea { min-height: 3.2rem; resize: vertical; }
      .ss-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.9rem; }
      .ss-btn {
        padding: 0.55rem 1rem;
        border: none;
        border-radius: var(--radius-input);
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        text-decoration: none;
      }
      .ss-btn-secondary {
        background: var(--card);
        border: 1px solid var(--panel-border);
        color: var(--fg);
      }
      .ss-btn:disabled { opacity: 0.7; cursor: wait; }
      .ss-error {
        background: #3d1f1f;
        border: 1px solid #8b3a3a;
        color: #ffd7d7;
        border-radius: 10px;
        padding: 0.85rem 1rem;
        margin-bottom: 1rem;
      }
      .ss-sheet { margin: 0 -1rem; }
      .ss-check {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2.35rem;
        font-size: 0.88rem;
      }
      .ss-check input { width: 1rem; height: 1rem; accent-color: #667eea; }
      .sk-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      @keyframes sk-shimmer {
        100% { transform: translateX(100%); }
      }
      .sk-bone {
        position: relative;
        overflow: hidden;
        display: block;
        border-radius: 6px;
        background-color: var(--sk-base);
      }
      .sk-bone::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, transparent 0%, var(--sk-shine) 50%, transparent 100%);
        transform: translateX(-100%);
        animation: sk-shimmer 1.4s ease-in-out infinite;
      }
      .ss-skel { margin: 0; }
      .ss-skel-stage {
        box-sizing: border-box;
        width: 100%;
        padding: 16px;
        background: #e4e4de;
        display: flex;
        justify-content: center;
      }
      .ss-skel-page {
        box-sizing: border-box;
        width: 100%;
        max-width: 11in;
        aspect-ratio: 11 / 8.5;
        background: #fff;
        box-shadow: 0 2px 18px rgba(0, 0, 0, 0.1);
        padding: 0.25in;
        display: flex;
        flex-direction: column;
        gap: 3.2%;
      }
      .ss-skel-page[data-orientation="portrait"] {
        max-width: 8.5in;
        aspect-ratio: 8.5 / 11;
      }
      .ss-skel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 2.4%;
        border-bottom: 1.5px solid #141414;
      }
      .ss-skel-logo { width: 7.5rem; height: 1.35rem; --sk-base: rgba(0, 0, 0, 0.08); --sk-shine: rgba(255, 255, 255, 0.55); }
      .ss-skel-qr { width: 3.1rem; height: 3.1rem; border-radius: 8px; --sk-base: rgba(0, 0, 0, 0.08); --sk-shine: rgba(255, 255, 255, 0.55); }
      .ss-skel-cols {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 0.9fr 1fr 1fr 1fr;
        gap: 0.85rem;
      }
      .ss-skel-cols--portrait { grid-template-columns: 1fr; }
      .ss-skel-col { display: flex; flex-direction: column; gap: 0.55rem; padding-top: 0.35rem; }
      .ss-skel-line { height: 0.7rem; --sk-base: rgba(0, 0, 0, 0.08); --sk-shine: rgba(255, 255, 255, 0.55); }
      .ss-skel-phone {
        flex: 1;
        min-height: 12rem;
        border-radius: 1.6rem;
        --sk-base: rgba(0, 0, 0, 0.08);
        --sk-shine: rgba(255, 255, 255, 0.55);
      }
      .ss-skel-footer { margin-top: auto; }
      body.ss-busy { cursor: wait; }
      @media (prefers-reduced-motion: reduce) {
        .sk-bone::after { animation: none; }
      }
      @media print {
        .ss-chrome { display: none !important; }
        .ss-skel { display: none !important; }
        html, body { background: #fff !important; }
        .ss-sheet { margin: 0; }
        .ss-sheet .doc-onepager-stage {
          break-after: page;
          page-break-after: always;
        }
        .ss-sheet .doc-onepager-stage:last-child {
          break-after: auto;
          page-break-after: auto;
        }
      }
    </style>
  </head>
  <body>
    <div class="ss-chrome">
      <a class="ss-back" href="/admin/?tab=documents">← Documents</a>
      <h1 class="ss-title">Audit sales sheet</h1>
      <p class="ss-sub" id="ss-source">
        Pick a company with an existing audit to refill the sheet. <span id="ss-source-note">Loading preview…</span>
        A Places miss is finding #1. The iPhone shows the live google.com
        Places/Maps search — competitors when there is no listing, not a
        mocked result list. Print is two-sided: custom audit on the client
        side, the same REΛVE back (hosting, cover, stack logos) on every
        sheet. Landscape
        duplex uses short-edge bind so the back is right-side up. Uncheck for
        <code>?google=0</code>. Use <code>?near=</code>,
        <code>?category=plumber</code>, <code>?listed=0</code>,
        <code>?shot=1</code> (rasterize the phone), <code>?places=0</code>
        (skip the API), or <code>?audit=</code> / <code>?run=</code> for the
        header QR.
      </p>

      <noscript>
        <div class="ss-error">Turn on JavaScript to load the sales sheet preview.</div>
      </noscript>
      <div class="ss-error" id="ss-error" hidden></div>

      <form class="ss-panel" id="ss-form" method="get" action="/admin/sales-sheet">
        <div class="ss-grid">
          <div class="ss-field">
            <label for="orientation">Orientation</label>
            <select id="orientation" name="orientation">
              <option value="landscape" selected={orientation === 'landscape'}>Landscape</option>
              <option value="portrait" selected={orientation === 'portrait'}>Portrait</option>
            </select>
          </div>
          <div class="ss-field">
            <label for="run">Company</label>
            <select id="run" name="run">
              <option value="" selected={!selectedAudit}>Dummy — Hale &amp; Co.</option>
              {auditCompanies.map((opt) => (
                <option value={opt.slug} selected={selectedAudit?.slug === opt.slug}>
                  {opt.company}
                </option>
              ))}
            </select>
          </div>
          <div class="ss-field">
            <label for="name">Prepared for</label>
            <input id="name" name="name" value={form.name} />
          </div>
          <div class="ss-field">
            <label for="site">Site</label>
            <input id="site" name="site" value={form.site} />
          </div>
          <div class="ss-field">
            <label for="overall">Overall</label>
            <input id="overall" name="overall" maxlength="1" value={form.overall} />
          </div>
          <div class="ss-field">
            <label for="score">Score</label>
            <input id="score" name="score" inputmode="numeric" value={form.score} />
          </div>
          <div class="ss-field">
            <label for="performance">Performance</label>
            <input id="performance" name="performance" maxlength="1" value={form.performance} />
          </div>
          <div class="ss-field">
            <label for="security">Security</label>
            <input id="security" name="security" maxlength="1" value={form.security} />
          </div>
          <div class="ss-field">
            <label for="visibility">Visibility</label>
            <input id="visibility" name="visibility" maxlength="1" value={form.visibility} />
          </div>
          <div class="ss-field">
            <label for="near">Near (city or lat,lng)</label>
            <input id="near" name="near" value={shell.near} placeholder="Boston, MA" />
          </div>
          <div class="ss-field">
            <label for="category">Competitor search</label>
            <input id="category" name="category" value={shell.category} placeholder="law firm" />
          </div>
          <div class="ss-field">
            <label for="listed">Listed override</label>
            <select id="listed" name="listed">
              <option value="" selected={shell.listedParam === ''}>Use Places</option>
              <option value="0" selected={shell.listedParam === '0'}>Force not listed</option>
              <option value="1" selected={shell.listedParam === '1'}>Force listed</option>
            </select>
          </div>
          <div class="ss-field">
            <span class="ss-check">
              <input id="google" name="google" type="checkbox" value="1" checked={shell.wantGoogleShot} />
              <label for="google">Live Google screenshot</label>
            </span>
          </div>
        </div>

        <div class="ss-grid ss-grid-wide" style="margin-top: 0.85rem;">
          <div class="ss-field">
            <label for="headline">Headline</label>
            <input id="headline" name="headline" value={form.headline} />
          </div>
          <div class="ss-field">
            <label for="audit">Full audit URL (QR)</label>
            <input id="audit" name="audit" value={form.audit} />
          </div>
        </div>

        <div class="ss-grid" style="margin-top: 0.85rem;">
          <div class="ss-field">
            <label for="label1">Finding 1 label</label>
            <input id="label1" name="label1" value={form.label1} />
          </div>
          <div class="ss-field">
            <label for="finding1">Finding 1 problem</label>
            <textarea id="finding1" name="finding1">{form.finding1}</textarea>
          </div>
          <div class="ss-field">
            <label for="solution1">Finding 1 next step</label>
            <textarea id="solution1" name="solution1">{form.solution1}</textarea>
          </div>
          <div class="ss-field">
            <label for="label2">Finding 2 label</label>
            <input id="label2" name="label2" value={form.label2} />
          </div>
          <div class="ss-field">
            <label for="finding2">Finding 2 problem</label>
            <textarea id="finding2" name="finding2">{form.finding2}</textarea>
          </div>
          <div class="ss-field">
            <label for="solution2">Finding 2 next step</label>
            <textarea id="solution2" name="solution2">{form.solution2}</textarea>
          </div>
          <div class="ss-field">
            <label for="label3">Finding 3 label</label>
            <input id="label3" name="label3" value={form.label3} />
          </div>
          <div class="ss-field">
            <label for="finding3">Finding 3 problem</label>
            <textarea id="finding3" name="finding3">{form.finding3}</textarea>
          </div>
          <div class="ss-field">
            <label for="solution3">Finding 3 next step</label>
            <textarea id="solution3" name="solution3">{form.solution3}</textarea>
          </div>
        </div>

        <div class="ss-actions">
          <button class="ss-btn" id="ss-update" type="submit">Update sheet</button>
          <a class="ss-btn ss-btn-secondary" href="/admin/sales-sheet">Reset dummy</a>
          <button class="ss-btn ss-btn-secondary" id="ss-print" type="button" disabled>Print / Save PDF</button>
        </div>
        <p class="ss-sub" id="ss-notes" style="margin: 0.85rem 0 0;">
          Building the preview — live Google and Places can take a few seconds.
        </p>
      </form>
    </div>

    <div class="ss-sheet" id="ss-sheet" set:html={skeletonHtml} />
    <script is:inline>
      (function () {
        const form = document.getElementById('ss-form');
        const run = document.getElementById('run');
        const updateBtn = document.getElementById('ss-update');
        const printBtn = document.getElementById('ss-print');
        const sheet = document.getElementById('ss-sheet');
        const notes = document.getElementById('ss-notes');
        const sourceNote = document.getElementById('ss-source-note');
        const errorBox = document.getElementById('ss-error');
        const skeletonHtml = sheet ? sheet.innerHTML : '';
        const initial = {};
        const FORM_IDS = [
          'name', 'site', 'overall', 'score', 'performance', 'security', 'visibility',
          'headline', 'audit', 'label1', 'finding1', 'solution1', 'label2', 'finding2',
          'solution2', 'label3', 'finding3', 'solution3',
        ];

        FORM_IDS.forEach(function (id) {
          const el = document.getElementById(id);
          if (el) initial[id] = el.value;
        });

        function setBusy(on, label) {
          document.body.classList.toggle('ss-busy', on);
          if (updateBtn) {
            updateBtn.disabled = on;
            updateBtn.textContent = on ? (label || 'Updating…') : 'Update sheet';
          }
          if (printBtn) printBtn.disabled = on || !sheet || !sheet.querySelector('.doc-onepager-stage');
        }

        function showSkeleton(label) {
          if (!sheet) return;
          sheet.innerHTML = skeletonHtml;
          const sr = sheet.querySelector('.sk-sr');
          if (sr && label) sr.textContent = label;
        }

        function applyForm(next) {
          if (!next) return;
          FORM_IDS.forEach(function (id) {
            const el = document.getElementById(id);
            if (!el || next[id] == null) return;
            if (el.value === initial[id]) {
              el.value = next[id];
              initial[id] = next[id];
            }
          });
        }

        function applyView(view) {
          if (errorBox) {
            if (view.error) {
              errorBox.hidden = false;
              errorBox.textContent = view.error;
            } else {
              errorBox.hidden = true;
              errorBox.textContent = '';
            }
          }
          if (sourceNote && view.sourceNote) {
            sourceNote.textContent = view.sourceNote + '.';
          }
          if (notes) {
            var listed = view.notListed
              ? ' Finding 1 is the Google Places miss.'
              : ' Places found a listing — miss is not pinned.';
            notes.textContent = [view.placesNote, view.shotNote].filter(Boolean).join('. ') + '.' + listed;
          }
          applyForm(view.form);
          if (sheet && view.sheetHtml) {
            sheet.innerHTML = view.sheetHtml + (view.backHtml || '');
          }
          setBusy(false);
        }

        function wantGoogleShotOnSubmit() {
          const google = document.getElementById('google');
          if (google && google.checked) return true;
          if (google && !google.checked) return false;
          return !!(run && run.value);
        }

        function loadClient() {
          const q = new URLSearchParams();
          if (run && run.value) q.set('run', run.value);
          const ori = document.getElementById('orientation');
          if (ori && ori.value && ori.value !== 'landscape') q.set('orientation', ori.value);
          const google = document.getElementById('google');
          if (google && !google.checked) q.set('google', '0');
          else if (google && google.checked && !(run && run.value)) q.set('google', '1');
          const label = google && !google.checked ? 'Loading sheet…' : 'Loading Google Places…';
          showSkeleton(label);
          setBusy(true, label);
          location.assign('/admin/sales-sheet' + (q.toString() ? '?' + q : ''));
        }

        async function hydrate() {
          const label = shellWantsGoogle() ? 'Loading Google Places…' : 'Loading sales sheet…';
          setBusy(true, label);
          try {
            const res = await fetch('/api/admin/sales-sheet' + window.location.search, {
              headers: { Accept: 'application/json' },
            });
            const data = await res.json();
            if (!res.ok || !data || data.ok === false) {
              throw new Error((data && data.error) || ('HTTP ' + res.status));
            }
            applyView(data);
          } catch (err) {
            if (errorBox) {
              errorBox.hidden = false;
              errorBox.textContent = err instanceof Error ? err.message : String(err);
            }
            setBusy(false);
          }
        }

        function shellWantsGoogle() {
          const google = document.getElementById('google');
          return !google || google.checked;
        }

        run?.addEventListener('change', loadClient);
        form?.addEventListener('submit', function () {
          const google = document.getElementById('google');
          if (form && google && !google.checked) {
            google.disabled = true;
            let hidden = form.querySelector('input[name="google"][type="hidden"]');
            if (!hidden) {
              hidden = document.createElement('input');
              hidden.type = 'hidden';
              hidden.name = 'google';
              form.appendChild(hidden);
            }
            hidden.value = '0';
          }
          const label = wantGoogleShotOnSubmit() ? 'Capturing Google Places…' : 'Updating…';
          showSkeleton(label);
          setBusy(true, label);
        });
        printBtn?.addEventListener('click', function () {
          if (!printBtn.disabled) window.print();
        });

        hydrate();
      })();
    </script>
  </body>
</html>
