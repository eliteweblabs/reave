---
/**
 * In-scope PWA sign-in. The admin manifest scope is `/admin`, so `/sign-in`
 * opens Safari on iOS and the Clerk session never returns to the installed app.
 */
import Header from "../../components/Header.astro";
import AdminHead from "../../components/admin/AdminHead.astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import "../../styles/mobile-touch.css";

const company = await getCompanyConfig(Astro.request);
const { userId } = Astro.locals.auth();
if (userId) {
  const next = Astro.url.searchParams.get("redirect_url") || "/admin/";
  return Astro.redirect(next.startsWith("/") && !next.startsWith("//") ? next : "/admin/");
}
---

<!doctype html>
<html lang="en">
  <AdminHead
    companyName={company.name}
    fonts={company.fonts}
    pageTitle={`Sign in — ${company.name}`}
  />
  <body data-user-id={userId ?? ""}>
    <Header signInAutoOpen={!userId} />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    color-scheme: dark;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    background: #050505;
  }
</style>
