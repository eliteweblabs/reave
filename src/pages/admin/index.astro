---
/**
 * Personal Business OS map (v2): interactive, Railway-style canvas.
 * /dashboard redirects here. Nodes/edges live in `public/admin/os-map-data.js`.
 * Tabs switch between the "System" runtime map and the "MCP & CLI" tooling map.
 * Drag cards (snap to grid), drag background to pan, wheel/±/Fit to zoom.
 */
import Header from "../../components/Header.astro";
import AdminFooterNav from "../../components/AdminFooterNav.astro";
import AdminHead from "../../components/admin/AdminHead.astro";
import AdminMapChrome from "../../components/admin/AdminMapChrome.astro";
import AdminPanelMounts from "../../components/admin/AdminPanelMounts.astro";
import AdminSearchOverlay from "../../components/admin/AdminSearchOverlay.astro";
import AdminDialogs from "../../components/admin/AdminDialogs.astro";
import AdminBootScripts from "../../components/admin/AdminBootScripts.astro";
import DeployStatusBanner from "../../components/DeployStatusBanner.astro";
import { companyHtmlStyleAttr } from "../../lib/companyBrandColors";
import { getCompanyConfig, companyToBrandContext, companyStaffAvatarUrl } from "../../lib/companyConfig";
import { getInstallConfigClient } from "../../lib/installConfig";
import { isSpecialAdminPageKey } from "../../lib/adminSpecialPages";
import { enabledFeatures } from "../../lib/features";
import { getDeployStatusClientSummary } from "../../lib/deployModuleStatus";
import { getAuthUser, isDeploymentOwner } from "../../lib/deploymentOwner";
import { getPublicMapboxAccessToken } from "../../lib/mapboxAccessToken";
import { serverEnv } from "../../lib/serverEnv";
import { githubRepoSlug } from "../../lib/githubClient";
import { ensureInstallSeed, shouldSeedOnBoot } from "../../lib/installSeed";
import { ensureSeededInboxClearedOnLiveEmail } from "../../lib/seededInboxCleanup";
import "../../styles/brand.css";
import "../../styles/admin/index.css";

export const prerender = false;

const { userId } = Astro.locals.auth();
if (!userId) {
  // OTP push tap — copy without signing in (code is already on-device).
  if (Astro.url.searchParams.get('copy') === '1') {
    return Astro.redirect('/admin/copy');
  }
  const returnTo = Astro.url.pathname + Astro.url.search;
  return Astro.redirect(`/sign-in?redirect_url=${encodeURIComponent(returnTo)}`);
}
const company = await getCompanyConfig(Astro.request);
const companyBrand = companyToBrandContext(company, Astro.request);
const staffAvatarUrl = companyStaffAvatarUrl(company);
const installConfigClient = {
  ...getInstallConfigClient(),
  features: [...enabledFeatures()],
  deployStatus: getDeployStatusClientSummary(),
};
const isOwner = userId ? await isDeploymentOwner(Astro) : false;
const deniedUser = userId && !isOwner ? await getAuthUser(Astro) : null;
const signedInAs =
  deniedUser?.emailAddresses?.[0]?.emailAddress?.trim() ||
  deniedUser?.username?.trim() ||
  "";
if (userId && !isOwner) {
  Astro.response.status = 403;
}
if (isOwner && shouldSeedOnBoot()) {
  void ensureInstallSeed();
} else if (isOwner) {
  void ensureSeededInboxClearedOnLiveEmail();
}
const mapboxAccessToken = isOwner ? getPublicMapboxAccessToken() || '' : '';
const craterFinanceUrl = serverEnv('CRATER_API_BASE_URL')?.trim().replace(/\/$/, '') || '';
const githubRepo = githubRepoSlug();
const specialPage = isSpecialAdminPageKey(
  Astro.url.searchParams.get("tab") || Astro.url.searchParams.get("map"),
);
---

<!doctype html>
<html
  lang="en"
  class:list={[{ "admin-special-page": specialPage }]}
  style={companyHtmlStyleAttr(company.fonts, company.brandPrimary, company.brandSecondary)}
>
  <AdminHead
    companyName={company.name}
    fonts={company.fonts}
    pageTitle={isOwner ? undefined : `Access pending — ${company.name}`}
  />
  <body
    class:list={[{ "admin-special-page": specialPage }]}
    data-user-id={userId ?? ""}
    data-is-owner={isOwner ? "1" : ""}
  >
    <DeployStatusBanner />
    <Header
      adminShell
      profileMenu={installConfigClient.profileMenu}
      signInAutoOpen={!userId}
    />

    {isOwner ? (
      <>
        <AdminMapChrome />
        <AdminPanelMounts />
        <AdminSearchOverlay />
        <AdminDialogs />
        <AdminFooterNav />
        <AdminBootScripts
          companyBrand={companyBrand}
          staffAvatarUrl={staffAvatarUrl}
          installConfigClient={installConfigClient}
          mapboxAccessToken={mapboxAccessToken}
          craterFinanceUrl={craterFinanceUrl}
          githubRepo={githubRepo}
        />
      </>
    ) : (
      <main class="admin-access-denied">
        <div class="admin-access-denied-card">
          <p class="admin-access-denied-kicker">Signed in</p>
          <h1>This account isn’t an administrator yet</h1>
          <p>
            You’re signed in{signedInAs ? ` as ${signedInAs}` : ""}, but admin
            access hasn’t been granted to this account.
          </p>
          <p>Ask the site owner to enable it, then refresh this page.</p>
          <a class="admin-access-denied-home" href="/">Back to the site</a>
        </div>
      </main>
    )}
  </body>
</html>

<style>
  .admin-access-denied {
    box-sizing: border-box;
    min-height: calc(100dvh - 4rem);
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem 3rem;
  }
  .admin-access-denied-card {
    width: min(32rem, 100%);
    display: grid;
    gap: 0.85rem;
    padding: 1.75rem 1.5rem;
    border-radius: 16px;
    background: color-mix(in srgb, currentColor 6%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }
  .admin-access-denied-kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .admin-access-denied-card h1 {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.25;
    font-weight: 650;
  }
  .admin-access-denied-card p {
    margin: 0;
    line-height: 1.5;
    opacity: 0.78;
  }
  .admin-access-denied-home {
    justify-self: start;
    margin-top: 0.4rem;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  }
  .admin-access-denied-home:hover {
    border-bottom-color: currentColor;
  }
</style>
