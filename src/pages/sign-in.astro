---
import Header from "../components/Header.astro";
import Favicon from "../components/Favicon.astro";
import ViewportMeta from "../components/ViewportMeta.astro";
import ThemeInit from "../components/ThemeInit.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import "../styles/mobile-touch.css";
import "../styles/brand.css";

const company = await getCompanyConfig(Astro.request);
const { userId } = Astro.locals.auth();
if (userId) {
  const next = Astro.url.searchParams.get("redirect_url") || "/admin/";
  return Astro.redirect(next.startsWith("/") ? next : "/admin/");
}
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeInit />
    <meta charset="UTF-8" />
    <ViewportMeta />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <title>Sign In — {company.name}</title>
    <Favicon />
  </head>
  <body data-user-id={userId ?? ""}>
    <Header signInAutoOpen={!userId} />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    color-scheme: light dark;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    background: var(--site-canvas, #fff);
    color: var(--site-fg, #171717);
  }
</style>
