---
import LandingLayout from "../layouts/LandingLayout.astro";
import LuxuryLandingPage from "../components/home/LuxuryLandingPage.astro";
import { luxuryPageTitle, resolveLuxurySitePage } from "../lib/luxurySitePage";

export const prerender = false;

const resolved = resolveLuxurySitePage(Astro, "contact");
if (resolved instanceof Response) return resolved;
const { landing } = resolved;
---

<LandingLayout title={luxuryPageTitle("contact", landing)}>
  <LuxuryLandingPage landing={landing} page="contact" />
</LandingLayout>
