---
/**
 * NFC business-card landing — branding only, no site nav.
 * Program chips to https://{domain}/card (or /nfc).
 */
import BrandFontHead from '../components/BrandFontHead.astro';
import BrandIconLockup from '../components/BrandIconLockup.astro';
import CardPhoneLogin from '../components/CardPhoneLogin.astro';
import Favicon from '../components/Favicon.astro';
import PwaDocumentTitle from '../components/PwaDocumentTitle.astro';
import SiteBackground from '../components/SiteBackground.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ViewportMeta from '../components/ViewportMeta.astro';
import PlausibleScript from '../components/PlausibleScript.astro';
import { cardPhoneToE164, resolveCardPhoneRaw } from '../lib/cardPhoneAuth';
import { readCardPasskeyTrust } from '../lib/cardPasskeyTrust';
import { storeHasCardPasskeys } from '../lib/cardPasskeyStore';
import {
  appleMapsDirectionsUrl,
  mapsDirectionsUrl,
  nativeMapsDirectionsUrl,
} from '../lib/calendarLinks';
import { companyHtmlStyleAttr } from '../lib/companyBrandColors';
import { getCompanyConfig } from '../lib/companyConfig';
import { getStoredCompanyConfig } from '../lib/companyConfigStore';
import { qrCodeDataUrl } from '../lib/qrCode';
import { formatHtmlPageTitle, formatPwaAppTitle } from '../lib/pageTitle';
import { contactTelHref } from '../lib/contactApi';
import { BRANDING_OG_PATH } from '../lib/companyLogo';
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from '../lib/ogImageSize';
import { requestOrigin } from '../lib/requestOrigin';
import { shareSafeText } from '../lib/shareSafeText';
import { isCardDemoPortfolioEnabled, parseCardDemoParam } from '../lib/cardDemoSites';
import { serverEnv } from '../lib/serverEnv';
import '../styles/brand.css';

export const prerender = false;

const company = await getCompanyConfig(Astro.request);

const displayName = company.name?.trim() || 'Contact';
const tagline = company.description?.trim() || '';
const phoneRaw = await resolveCardPhoneRaw(Astro, company.supportPhone);
const telDigits = contactTelHref(phoneRaw);
const phoneHref = telDigits ? `tel:${telDigits}` : '';
const smsHref = telDigits ? `sms:${telDigits}` : '';
const phoneE164 = cardPhoneToE164(phoneRaw);
let signedIn = false;
let userId: string | null = null;
try {
  userId = Astro.locals.auth?.()?.userId ?? null;
  signedIn = Boolean(userId);
} catch {
  signedIn = false;
  userId = null;
}
const passkeyTrust = readCardPasskeyTrust(Astro.request);
const hasPasskeys = await storeHasCardPasskeys();
const address = company.address?.trim() || '';
const geo = company.geo;

// ?demo= param — a temporary preview/demo URL shown as a top button on the card.
// Program NFC chips as: /card?client=slug&demo=https://preview.up.railway.app
// No DB change needed — the param lives only in the URL.
const demoUrl = parseCardDemoParam(Astro.url.searchParams.get('demo'));
const showDemoPortfolio = isCardDemoPortfolioEnabled();
/** Optional — WordPress / Webflow / other CMS sign-in for the public site. */
const cmsLoginUrl =
  serverEnv('PUBLIC_CMS_LOGIN_URL')?.trim() ||
  serverEnv('CMS_LOGIN_URL')?.trim() ||
  '';

function formatPhoneDisplay(raw: string): string {
  const digits = raw.replace(/\D/g, '');
  const n = digits.length === 11 && digits.startsWith('1') ? digits.slice(1) : digits;
  if (n.length === 10) return `(${n.slice(0, 3)}) ${n.slice(3, 6)}-${n.slice(6)}`;
  return raw.trim();
}

const phoneLabel = phoneRaw ? formatPhoneDisplay(phoneRaw) : '';

const directionsDest =
  geo && Number.isFinite(geo.lat) && Number.isFinite(geo.lng)
    ? `${geo.lat},${geo.lng}`
    : address;
const directionsHref = directionsDest
  ? nativeMapsDirectionsUrl(directionsDest, Astro.request.headers.get('user-agent'))
  : '';
const appleDirectionsHref = directionsDest ? appleMapsDirectionsUrl(directionsDest) : '';
const googleDirectionsHref = directionsDest ? mapsDirectionsUrl(directionsDest) : '';

const vcardLabel = `Add ${displayName}`;
const pwaTitle = formatPwaAppTitle(displayName);
const pageTitle = formatHtmlPageTitle({ siteName: displayName, tagline });
const shareTitle = shareSafeText(displayName);
const description =
  tagline || `Call, text, save ${displayName} to contacts, or get directions.`;
const origin = requestOrigin(Astro.request);
const canonical = company.domain
  ? `https://${company.domain.replace(/^https?:\/\//, '').replace(/\/+$/, '')}/card`
  : `${origin}/card`;
const ogImage = company.ogImageUrl;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${origin}${ogImage}`;
const logoShareFallback = company.logoPath && company.logoSource !== 'hidden'
  ? `${origin}${company.logoPath.startsWith('/') ? company.logoPath : `/${company.logoPath}`}`
  : `${origin}${BRANDING_OG_PATH}`;
const ogImageSafe = /\.gif(?:\?|$)/i.test(ogImageAbsolute)
  ? logoShareFallback
  : ogImageAbsolute;

let cardQrSrc = '';
try {
  const storedBrand = await getStoredCompanyConfig();
  cardQrSrc = await qrCodeDataUrl(canonical, 400, storedBrand);
} catch {
  cardQrSrc = '';
}

---

<!doctype html>
<html lang="en" style={companyHtmlStyleAttr(company.fonts, company.brandPrimary, company.brandSecondary, company.headerLogoSize)}>
  <head>
    <ThemeInit />
    <meta charset="UTF-8" />
    <ViewportMeta />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={pwaTitle} />
    <meta name="application-name" content={pwaTitle} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{pageTitle}</title>
    <PwaDocumentTitle pwaTitle={pwaTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageSafe} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageSafe} />
    <Favicon />
    <BrandFontHead fonts={company.fonts} />
    <PlausibleScript />
  </head>
  <body class="nfc-body" data-user-id={userId ?? ''}>
    <SiteBackground />
    <main class="nfc-shell">
      <header class="nfc-brand">
        <a class="nfc-brand-home" href="/" aria-label={`${displayName} homepage`}>
          <BrandIconLockup company={company} variant="hero" idPrefix="nfc-mark" />
        </a>
        <h1 class="nfc-sr-only">{displayName}</h1>
      </header>

      <nav class="nfc-actions" aria-label={`Contact ${displayName}`}>

        {demoUrl && (
          <a
            class="nfc-btn nfc-btn--demo"
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View demo site"
          >
            <span class="nfc-btn-ico" aria-hidden="true">
              <!-- external link icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            </span>
            <span class="nfc-btn-copy">
              <span class="nfc-btn-label">View Demo Site</span>
              <span class="nfc-btn-meta">Preview your new website</span>
            </span>
          </a>
        )}

        <a class="nfc-btn nfc-btn--primary" href="/contact.vcf" aria-label={vcardLabel}>
          <span class="nfc-btn-ico" aria-hidden="true">
            <!-- IOS_ICONS.user-plus — keep in sync with public/admin/admin-ui.js -->
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
          </span>
          <span class="nfc-btn-copy">
            <span class="nfc-btn-label">Add contact</span>
            <span class="nfc-btn-meta">Save to your phone</span>
          </span>
        </a>

        {phoneHref && (
          <a class="nfc-btn" href={phoneHref} aria-label={`Call ${phoneLabel || displayName}`}>
            <span class="nfc-btn-ico" aria-hidden="true">
              <!-- IOS_ICONS.phone — keep in sync with public/admin/admin-ui.js -->
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
            </span>
            <span class="nfc-btn-copy">
              <span class="nfc-btn-label">Call</span>
              {phoneLabel && <span class="nfc-btn-meta">{phoneLabel}</span>}
            </span>
          </a>
        )}

        {smsHref && (
          <a class="nfc-btn" href={smsHref} aria-label={`Text ${phoneLabel || displayName}`}>
            <span class="nfc-btn-ico" aria-hidden="true">
              <!-- IOS_ICONS.message — keep in sync with public/admin/admin-ui.js -->
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            </span>
            <span class="nfc-btn-copy">
              <span class="nfc-btn-label">Text</span>
              <span class="nfc-btn-meta">Send a message</span>
            </span>
          </a>
        )}

        {directionsHref && (
          <a
            class="nfc-btn"
            id="nfc-directions"
            href={directionsHref}
            data-apple-maps={appleDirectionsHref}
            data-google-maps={googleDirectionsHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={address ? `Directions to ${address}` : `Directions to ${displayName}`}
          >
            <span class="nfc-btn-ico" aria-hidden="true">
              <!-- IOS_ICONS.map-pin — keep in sync with public/admin/admin-ui.js -->
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span class="nfc-btn-copy">
              <span class="nfc-btn-label">Directions</span>
              {address && <span class="nfc-btn-meta">{address}</span>}
            </span>
          </a>
        )}

        <CardPhoneLogin
          phoneE164={phoneE164}
          signedIn={signedIn}
          cmsLoginUrl={cmsLoginUrl}
          hasPasskeys={hasPasskeys}
          passkeyTrusted={
            passkeyTrust
              ? { displayName: passkeyTrust.displayName || 'You' }
              : null
          }
        />
      </nav>

      {cardQrSrc && (
        <figure class="nfc-qr" aria-label={`QR code for ${displayName} contact card`}>
          <img
            class="nfc-qr-img"
            src={cardQrSrc}
            width={400}
            height={400}
            alt=""
            decoding="async"
          />
          <figcaption class="nfc-qr-caption">Scan to open this card</figcaption>
        </figure>
      )}

      {
        showDemoPortfolio && (
          <section
            class="demo-section demo-section--pending"
            id="nfc-demo-section"
            aria-label="Demo Sites"
            hidden
            data-demo-url={demoUrl || undefined}
          >
            <h2 class="demo-heading">
              <span class="demo-heading-line"></span>
              <span class="demo-heading-text" id="nfc-demo-heading">
                Local Demo Sites
              </span>
              <span class="demo-heading-line"></span>
            </h2>
            <p class="demo-subtext" id="nfc-demo-subtext">
              Tap any business to see what your site could look like.
            </p>
            <div class="nfc-demo-grid" id="nfc-demo-grid"></div>
          </section>
        )
      }

    </main>
    {directionsHref && (
      <script is:inline>
        (function () {
          var a = document.getElementById('nfc-directions');
          if (!a) return;
          var apple = a.getAttribute('data-apple-maps');
          var google = a.getAttribute('data-google-maps');
          if (!apple || !google) return;
          var ua = navigator.userAgent || '';
          var useApple = /iPhone|iPad|iPod|Macintosh|Mac OS X/i.test(ua);
          a.href = useApple ? apple : google;
        })();
      </script>
    )}
    {
      showDemoPortfolio && (
        <script type="module">
          import { initCardDemoPortfolio } from '../client/cardDemoPortfolio.ts';
          initCardDemoPortfolio();
        </script>
      )
    }
  </body>
</html>

<style is:global>
  /* Standalone /card shell — mirror Layout full-bleed + safe-area gutters. */
  html:has(.nfc-body) {
    min-height: 100%;
    background-color: var(--site-canvas, #fff);
  }

  html:has(.nfc-body),
  html:has(.nfc-body) body {
    margin: 0;
    width: 100%;
    color-scheme: light dark;
  }
</style>

<style>
  .nfc-body {
    margin: 0;
    min-height: 100%;
    min-height: 100dvh;
    font-family: var(--font-content);
    color: var(--site-fg, #171717);
    background-color: var(--site-canvas, #fff);
    -webkit-font-smoothing: antialiased;
    -webkit-user-select: none;
    user-select: none;
  }

  .nfc-body a[href^="mailto:"],
  .nfc-body a[href^="tel:"] {
    -webkit-user-select: text;
    user-select: text;
  }

  /* No sticky header/CTA on /card — paint canvas through the full safe area. */
  .nfc-body :global(.site-bg-atmosphere) {
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    --site-bg-bleed-top: 0;
    --site-bg-bleed-bottom: 0;
  }

  .nfc-body :global(.site-bg-atmosphere::before) {
    bottom: calc(-1 * (env(safe-area-inset-bottom, 0px) + var(--browser-ui-bottom, 0px)));
  }

  .nfc-shell {
    --nfc-gutter: max(24px, env(safe-area-inset-left, 0px), env(safe-area-inset-right, 0px));
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    min-height: 100dvh;
    width: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    scroll-padding-bottom: env(safe-area-inset-bottom, 0px);
    padding:
      max(20px, env(safe-area-inset-top, 0px))
      var(--nfc-gutter)
      max(20px, env(safe-area-inset-bottom, 0px));
  }

  .nfc-brand-home {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 24px;
    -webkit-tap-highlight-color: transparent;
  }

  .nfc-brand-home:focus-visible {
    outline: 2px solid var(--site-fg, #171717);
    outline-offset: 4px;
  }

  .nfc-brand {
    --home-hero-icon-size: clamp(190px, 42vw, 312px);
    --home-hero-icon-pad: 1.25rem;
    --home-hero-icon-ink-above: 0.269;
    --home-hero-icon-ink-below: 0.285;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: min(100%, 540px);
    padding: 0 12px;
    margin-bottom: 36px;
  }

  .nfc-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-height: 720px) {
    .nfc-brand {
      --home-hero-icon-size: clamp(140px, 32vw, 220px);
    }
  }

  .nfc-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: min(100%, 22rem);
  }

  .nfc-btn {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 64px;
    padding: 14px 16px;
    border-radius: 16px;
    text-decoration: none;
    color: var(--site-fg, #171717);
    background: var(--brand-glass-bg);
    border: 1px solid var(--brand-glass-border-color);
    backdrop-filter: var(--brand-glass-blur);
    -webkit-backdrop-filter: var(--brand-glass-blur);
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .nfc-btn:hover,
  .nfc-btn:focus-visible {
    background: var(--brand-glass-bg-hover);
    border-color: var(--brand-glass-border-color-hover);
  }

  .nfc-btn:active {
    transform: scale(0.985);
  }

  .nfc-btn--primary {
    background: var(--brand-btn-bg, #111);
    color: var(--brand-btn-fg, #fff);
    border-color: transparent;
  }

  .nfc-btn--primary:hover,
  .nfc-btn--primary:focus-visible {
    background: var(--brand-btn-bg, #111);
    border-color: transparent;
    filter: brightness(1.06);
  }

  /* Demo button — accent color, sits above the primary CTA */
  .nfc-btn--demo {
    background: color-mix(in srgb, var(--brand-primary, #7c3aed) 12%, transparent);
    color: var(--brand-primary, #7c3aed);
    border-color: color-mix(in srgb, var(--brand-primary, #7c3aed) 30%, transparent);
  }

  .nfc-btn--demo:hover,
  .nfc-btn--demo:focus-visible {
    background: color-mix(in srgb, var(--brand-primary, #7c3aed) 20%, transparent);
    border-color: color-mix(in srgb, var(--brand-primary, #7c3aed) 50%, transparent);
  }

  .nfc-btn--demo .nfc-btn-meta {
    color: color-mix(in srgb, var(--brand-primary, #7c3aed) 70%, transparent);
  }

  .nfc-btn-ico {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    color: inherit;
  }

  .nfc-btn-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    text-align: left;
  }

  .nfc-btn-label {
    font-family: var(--font-primary);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .nfc-btn-meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8rem;
    line-height: 1.3;
    color: var(--site-fg-muted, #525252);
  }

  .nfc-btn--primary .nfc-btn-meta {
    color: color-mix(in srgb, var(--brand-btn-fg, #fff) 68%, transparent);
  }

  .nfc-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: min(100%, 22rem);
    margin: 28px 0 0;
    padding: 0;
  }

  .nfc-qr-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    background: #fff;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--site-fg, #171717) 8%, transparent),
      0 8px 28px color-mix(in srgb, var(--site-fg, #171717) 10%, transparent);
  }

  .nfc-qr-caption {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.35;
    text-align: center;
    color: var(--site-fg-muted, #525252);
  }

  /* ── Demo Sites Section ── */
  .demo-section {
    width: min(100%, 36rem);
    margin-top: 40px;
    padding-top: 4px;
  }

  .demo-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 6px;
    font-family: var(--font-primary);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--site-fg-muted, #737373);
  }

  .demo-heading-line {
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--site-fg, #171717) 12%, transparent);
  }

  .demo-heading-text {
    white-space: nowrap;
  }

  .demo-subtext {
    margin: 0 0 14px;
    font-size: 0.82rem;
    line-height: 1.4;
    text-align: center;
    color: var(--site-fg-muted, #737373);
  }

  /* Client-rendered tiles — :global so injected markup picks up styles. */
  :global(.nfc-demo-grid) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
  }

  :global(.nfc-demo-grid--single) {
    grid-template-columns: minmax(0, 1fr);
    max-width: 14rem;
    margin-inline: auto;
  }

  :global(.nfc-demo-tile) {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: var(--site-fg, #171717);
    background: var(--brand-glass-bg);
    border: 1px solid var(--brand-glass-border-color);
    backdrop-filter: var(--brand-glass-blur);
    -webkit-backdrop-filter: var(--brand-glass-blur);
    -webkit-tap-highlight-color: transparent;
    box-shadow: 0 6px 20px color-mix(in srgb, var(--site-fg, #171717) 6%, transparent);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  :global(.nfc-demo-tile:hover),
  :global(.nfc-demo-tile:focus-visible) {
    border-color: var(--brand-glass-border-color-hover);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--site-fg, #171717) 10%, transparent);
  }

  :global(.nfc-demo-tile:active) {
    transform: scale(0.98);
  }

  :global(.nfc-demo-tile-preview) {
    position: relative;
    aspect-ratio: 5 / 4;
