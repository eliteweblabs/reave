---
import Layout from "../layouts/Layout.astro";
import LandingLayout from "../layouts/LandingLayout.astro";
import HomeHeroSection from "../components/home/HomeHeroSection.astro";
import HomeDialogueSection from "../components/home/HomeDialogueSection.astro";
import HomeIntegrationsSection from "../components/home/HomeIntegrationsSection.astro";
import FeaturesPageContent from "../components/features/FeaturesPageContent.astro";
import HomeFeaturedProjectSection from "../components/home/HomeFeaturedProjectSection.astro";
import HomeContactSection from "../components/home/HomeContactSection.astro";
import SiteLandingPage from "../components/home/SiteLandingPage.astro";
import HomeLoginPage from "../components/home/HomeLoginPage.astro";
import BarbersEdgeLayout from "../layouts/BarbersEdgeLayout.astro";
import BarbersEdgeProfile from "../components/barbers-edge/BarbersEdgeProfile.astro";
import { BARBERS_EDGE, getBarbersEdgeBarber } from "../lib/barbersEdge";
import { getSiteContent, resolveHomepageTemplate } from "../lib/siteContent";
import { resolvePublicHost } from "../lib/requestHost";
import "../styles/marketing-sections.css";

export const prerender = false;

const siteContent = getSiteContent();
const homepage = siteContent.homepage;
const homepageTemplate = resolveHomepageTemplate(siteContent, {
  requestHost: resolvePublicHost(Astro.request),
});
const isLogin = homepageTemplate === "login";
const isBarbersEdge = siteContent.key === "barbersedge";
const barbersEdgeOwner = getBarbersEdgeBarber("horell-cruz");
const isLanding = !isBarbersEdge && homepageTemplate === "landing" && siteContent.landing;

if (isLogin) {
  let userId: string | null = null;
  try {
    userId = Astro.locals.auth?.()?.userId ?? null;
  } catch {
    userId = null;
  }
  if (userId) {
    return Astro.redirect("/admin/");
  }
}
---

{
  isLogin ? (
    <HomeLoginPage />
  ) : isBarbersEdge && barbersEdgeOwner ? (
    <BarbersEdgeLayout
      title={`${barbersEdgeOwner.name} — ${BARBERS_EDGE.name}`}
      description={`${barbersEdgeOwner.role} at Barber's Edge. ${barbersEdgeOwner.tagline}.`}
    >
      <BarbersEdgeProfile barber={barbersEdgeOwner} />
    </BarbersEdgeLayout>
  ) : isLanding ? (
    <LandingLayout>
      <SiteLandingPage landing={siteContent.landing!} />
    </LandingLayout>
  ) : (
    <Layout>
      <div class="home-scroll">
        <HomeHeroSection siteContent={siteContent} />

        {homepage.showIntegrations && <HomeIntegrationsSection />}
        {homepage.showFeatures && <FeaturesPageContent embedded showLogoStack={false} />}
        <HomeFeaturedProjectSection />
        {homepage.showDialogue && <HomeDialogueSection variant="editorial" id="dialogue" />}
        {homepage.showContact && <HomeContactSection />}
      </div>
    </Layout>
  )
}

{
  !isLanding && !isLogin && (
    <style>
      .home-scroll {
        position: relative;
        z-index: 0;
        padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));
      }
    </style>
  )
}
