---
/**
 * reave.app `/` serves the grand opening offer via rewrite to /grand-opening.
 * Previous marketing homepage preserved at /home and src/pages/_backup/index.marketing-home.astro.
 */
import LandingLayout from "../layouts/LandingLayout.astro";
import ComingSoonLayout from "../layouts/ComingSoonLayout.astro";
import SiteLandingPage from "../components/home/SiteLandingPage.astro";
import HomeLoginPage from "../components/home/HomeLoginPage.astro";
import ReaveMarketingHomePage from "../components/home/ReaveMarketingHomePage.astro";
import BarbersEdgeLayout from "../layouts/BarbersEdgeLayout.astro";
import BarbersEdgeProfile from "../components/barbers-edge/BarbersEdgeProfile.astro";
import { BARBERS_EDGE, getBarbersEdgeBarber } from "../lib/barbersEdge";
import { getSiteContent, resolveHomepageTemplate } from "../lib/siteContent";
import { isReaveMarketingHost, resolvePublicHost } from "../lib/requestHost";

export const prerender = false;

const requestHost = resolvePublicHost(Astro.request);
const siteContent = getSiteContent();
const homepageTemplate = resolveHomepageTemplate(siteContent, { requestHost });
const isLogin = homepageTemplate === "login";
if (isLogin) {
  let signedInUserId: string | null = null;
  try {
    signedInUserId = Astro.locals.auth?.()?.userId ?? null;
  } catch {
    signedInUserId = null;
  }
  if (signedInUserId) {
    const next = Astro.url.searchParams.get("redirect_url") || "/admin/";
    return Astro.redirect(next.startsWith("/") && !next.startsWith("//") ? next : "/admin/");
  }
}
const isBarbersEdge = siteContent.key === "barbersedge";
const barbersEdgeOwner = getBarbersEdgeBarber("horell-cruz");
const isLanding = !isBarbersEdge && homepageTemplate === "landing" && siteContent.landing;
const isComingSoon = isLanding && siteContent.landing?.variant === "coming-soon";
const isReaveGrandOpening =
  isReaveMarketingHost(requestHost) && homepageTemplate === "default" && !isBarbersEdge;

if (isReaveGrandOpening) {
  return Astro.rewrite("/grand-opening");
}
---

{
  isLogin ? (
    <HomeLoginPage />
  ) : isBarbersEdge && barbersEdgeOwner ? (
    <BarbersEdgeLayout
      title={`${barbersEdgeOwner.name} — ${BARBERS_EDGE.name}`}
      description={`${barbersEdgeOwner.role} at Barber's Edge. ${barbersEdgeOwner.tagline}.`}
    >
      <BarbersEdgeProfile barber={barbersEdgeOwner} />
    </BarbersEdgeLayout>
  ) : isComingSoon ? (
    <ComingSoonLayout
      title={siteContent.landing?.title}
      description={siteContent.landing?.description}
      themeColor={siteContent.landing?.themeColor}
    >
      <SiteLandingPage landing={siteContent.landing!} />
    </ComingSoonLayout>
  ) : isLanding ? (
    <LandingLayout>
      <SiteLandingPage landing={siteContent.landing!} />
    </LandingLayout>
  ) : (
    <ReaveMarketingHomePage />
  )
}
