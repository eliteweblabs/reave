---
import Layout from "../layouts/Layout.astro";
import QuantumLogo from "../components/QuantumLogo.astro";
import SiteAssistantWidget from "../components/SiteAssistantWidget.astro";
import SiteFooterNav from "../components/SiteFooterNav.astro";
import SiteLegalLinks from "../components/SiteLegalLinks.astro";
import HomeAboutSection from "../components/home/HomeAboutSection.astro";
import HomeIntegrationsSection from "../components/home/HomeIntegrationsSection.astro";
import HomeServicesSection from "../components/home/HomeServicesSection.astro";
import HomePortfolioSection from "../components/home/HomePortfolioSection.astro";
import HomeContactSection from "../components/home/HomeContactSection.astro";
import { getCompanyConfig, homepageHeroMask, homepageHeroLogo } from "../lib/companyConfig";
import { hasFeature } from "../lib/features";
import { isSiteAssistantConfigured } from "../lib/siteAssistant";
import "../styles/marketing-sections.css";

const company = await getCompanyConfig(Astro.request);
const heroMask = homepageHeroMask(company);
const heroLogo = homepageHeroLogo(company);
const showSiteAssistant =
  hasFeature("portal_assistant") && isSiteAssistantConfigured();
---

<Layout>
  <div class="home-scroll">
    <section
      id="home"
      class="home-hero"
      data-home-section="home"
      aria-label={company.name}
    >
      {
        heroLogo && (
          <QuantumLogo
            heroMask={heroMask ?? undefined}
            logoSrc={heroLogo}
            layout="homepage"
          />
        )
      }
      <div class="quantum-vignette" aria-hidden="true"></div>
    </section>

    <HomeAboutSection />
    <HomeIntegrationsSection />
    <HomeServicesSection />
    <HomePortfolioSection />
    <HomeContactSection />
    <SiteLegalLinks />
  </div>

  <SiteFooterNav active="home" />

  {
    showSiteAssistant && (
      <SiteAssistantWidget
        brandTitle={company.name}
        supportPhone={company.supportPhone}
        supportEmail={company.supportEmail}
        offsetFooterNav={true}
      />
    )
  }
</Layout>

<script>
  import "../lib/homepageLogoReveal.ts";
</script>

<style>
  :global(html),
  :global(body) {
    min-height: 100%;
  }

  /*
   * Default page scroll is vertical; the hero overrides with pan-up so only
   * upward pans scroll — down/left/right drive the particle cloud.
   */
  :global(html.quantum-page-touch),
  :global(html.quantum-page-touch body) {
    touch-action: pan-y;
    overscroll-behavior-y: none;
  }

  .home-scroll {
    position: relative;
    z-index: 1;
    padding-bottom: calc(var(--site-footer-nav-offset, 3.35rem) + 24px);
  }

  .home-hero {
    position: relative;
    z-index: 0;
    width: 100%;
    min-height: 100vh;
    /* svh stays fixed while scrolling; dvh shrinks/grows with the mobile URL bar. */
    min-height: 100svh;
    /* Let the particle stack bleed ~30% into the following section. */
    overflow: visible;
    scroll-margin-top: 0;
    touch-action: pan-up;
    overscroll-behavior-y: none;
  }

  .quantum-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    /* Keep vignette clipped to the hero band (not the particle bleed). */
    overflow: hidden;
    background: radial-gradient(
      ellipse 120% 120% at center,
      transparent 48%,
      rgba(0, 0, 0, 0.35) 78%,
      rgba(0, 0, 0, 0.72) 115%
    );
  }

  @media screen and (max-width: 768px) {
    .quantum-vignette {
      background: radial-gradient(
        ellipse 125% 125% at center,
        transparent 52%,
        rgba(0, 0, 0, 0.28) 80%,
        rgba(0, 0, 0, 0.65) 118%
      );
    }
  }
</style>
