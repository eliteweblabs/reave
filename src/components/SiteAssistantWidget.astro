---
/** Marketing-site wrapper — `/api/site/assistant`, engagement-delay FAB reveal. */
import AssistantWidget from './AssistantWidget.astro';

export interface Props {
  brandTitle: string;
  supportPhone?: string;
  supportEmail?: string;
  /** Slide the FAB in a few seconds after the user engages (marketing site). */
  revealFabOnEngagement?: boolean;
  /**
   * Slide the FAB away while homepage hero / contact are in view.
   * Defaults on for the marketing site so the button doesn't cover those sections.
   */
  hideFabForHero?: boolean;
}

const {
  brandTitle,
  supportPhone = '',
  supportEmail = '',
  revealFabOnEngagement = false,
  hideFabForHero = true,
} = Astro.props;
---

<AssistantWidget
  instanceId="site"
  endpoint="/api/site/assistant"
  storageKey="sa-chat-site"
  brandTitle={brandTitle}
  headerTitle="Help & Support"
  greeting="Hi. What can I assist you with today?"
  fabLabel={`Get help from ${brandTitle}`}
  footerPrefix="Urgent?"
  supportPhone={supportPhone}
  supportEmail={supportEmail}
  variant="site"
  revealFabOnEngagement={revealFabOnEngagement}
  hideFabForHero={hideFabForHero}
/>
