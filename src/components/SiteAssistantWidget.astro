---
/** Marketing-site wrapper — `/api/site/assistant`, engagement-delay FAB reveal. */
import AssistantWidget from './AssistantWidget.astro';
import { siteAssistantGreetingForPath } from '../lib/siteAssistant';

export interface Props {
  brandTitle: string;
  supportPhone?: string;
  supportEmail?: string;
  /** Current page path — used for a page-aware opening greeting. */
  pagePath?: string;
  /** Slide the FAB in horizontally a few seconds after the user engages (marketing site). */
  revealFabOnEngagement?: boolean;
  /**
   * Slide the FAB away while a page hero / contact section is in view.
   * Unused on the homepage — that page does not mount this widget.
   */
  hideFabForHero?: boolean;
}

const {
  brandTitle,
  supportPhone = '',
  supportEmail = '',
  pagePath = '',
  revealFabOnEngagement = false,
  hideFabForHero = false,
} = Astro.props;

const greeting = siteAssistantGreetingForPath(pagePath || Astro.url.pathname);
---

<AssistantWidget
  instanceId="site"
  endpoint="/api/site/assistant"
  storageKey="sa-chat-site"
  brandTitle={brandTitle}
  headerTitle="Help & Support"
  greeting={greeting}
  fabLabel={`Get help from ${brandTitle}`}
  footerPrefix="Urgent?"
  supportPhone={supportPhone}
  supportEmail={supportEmail}
  variant="site"
  revealFabOnEngagement={revealFabOnEngagement}
  hideFabForHero={hideFabForHero}
/>
