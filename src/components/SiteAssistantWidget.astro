---
/** Marketing-site wrapper — `/api/site/assistant`, scroll-reveal FAB. */
import AssistantWidget from './AssistantWidget.astro';

export interface Props {
  brandTitle: string;
  supportPhone?: string;
  supportEmail?: string;
  /** Slide the FAB in on first scroll (marketing site). */
  revealFabOnScroll?: boolean;
}

const {
  brandTitle,
  supportPhone = '',
  supportEmail = '',
} = Astro.props;
---

<AssistantWidget
  instanceId="site"
  endpoint="/api/site/assistant"
  storageKey="sa-chat-site"
  brandTitle={brandTitle}
  headerTitle="Questions?"
  greeting="Hi. What can I assist you with today?"
  fabLabel={`Session with ${brandTitle}`}
  footerPrefix="Prefer a person?"
  supportPhone={supportPhone}
  supportEmail={supportEmail}
  variant="site"
  revealFabOnScroll={true}
/>
