---
/** Full-page intro crossfade — locked beat order from creative. */
const frames = [
  {
    src: '/sites/upsidedownbottle/hero-assets/scene1_bottle_upright.jpg',
    alt: 'An ordinary bottle, upright, on the ground',
  },
  {
    src: '/sites/upsidedownbottle/hero-assets/person1_weary.jpg',
    alt: 'A person looking weary',
  },
  {
    src: '/sites/upsidedownbottle/hero-assets/scene2_bottle_inverted.jpg',
    alt: 'The same bottle, now upside down',
  },
  {
    src: '/sites/upsidedownbottle/hero-assets/person2_confused_a.jpg',
    alt: 'A person looking confused',
  },
  {
    src: '/sites/upsidedownbottle/hero-assets/scene3_bottles_two.jpg',
    alt: 'Two bottles, both upside down',
  },
  {
    src: '/sites/upsidedownbottle/hero-assets/person3_investigating.jpg',
    alt: 'A person investigating on their phone',
  },
] as const;

/** ms each beat stays on screen before the next crossfade. */
const beatMs = 1800;
/** Hold the final frame, then fade the overlay to the page beneath. */
const finalHoldMs = 2200;
const fadeOutMs = 900;
const frameSrcs = frames.map((frame) => frame.src);
---

{
  frameSrcs.map((src) => (
    <link rel="preload" as="image" href={src} />
  ))
}

<div class="udb-intro" data-udb-intro aria-hidden="true">
  <div class="udb-hero" data-udb-hero>
    {
      frames.map((frame, i) => (
        <img
          class:list={['udb-hero-frame', { 'is-active': i === 0 }]}
          src={frame.src}
          alt=""
          width={750}
          height={750}
          loading="eager"
          decoding="async"
          data-index={i}
        />
      ))
    }
  </div>
</div>

<script define:vars={{ beatMs, finalHoldMs, fadeOutMs, frameSrcs }}>
  const intro = document.querySelector('[data-udb-intro]');
  const content = document.querySelector('[data-udb-content]');
  let finished = false;

  const landOnPage = () => {
    if (finished) return;
    finished = true;
    document.body.classList.remove('udb-intro-active');
    intro?.classList.add('is-out');
    content?.removeAttribute('aria-hidden');
    window.dispatchEvent(new CustomEvent('udb-intro-done'));
    window.setTimeout(() => intro?.remove(), fadeOutMs);
  };

  const preloadFrames = () =>
    Promise.all(
      frameSrcs.map(
        (src) =>
          new Promise((resolve) => {
            const img = new Image();
            img.onload = () => resolve(true);
            img.onerror = () => resolve(false);
            img.src = src;
          }),
      ),
    );

  const runIntro = () => {
    if (!intro || finished) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) intro.classList.add('udb-intro--instant');

    document.body.classList.add('udb-intro-active');
    const frameEls = [...intro.querySelectorAll('.udb-hero-frame')];
    let index = 0;

    const show = (n) => {
      frameEls.forEach((el, i) => el.classList.toggle('is-active', i === n));
    };

    const advance = () => {
      if (index >= frameEls.length - 1) {
        window.setTimeout(landOnPage, finalHoldMs);
        return;
      }
      index += 1;
      show(index);
      window.setTimeout(advance, beatMs);
    };

    window.setTimeout(advance, beatMs);
  };

  if (!intro) {
    content?.removeAttribute('aria-hidden');
    window.dispatchEvent(new CustomEvent('udb-intro-done'));
  } else {
    const start = () => {
      void preloadFrames().then(runIntro);
    };

    // bfcache restore — DOM may still show the intro overlay; skip replay.
    window.addEventListener(
      'pageshow',
      (event) => {
        if (event.persisted) landOnPage();
      },
      { once: true },
    );

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  }
</script>
