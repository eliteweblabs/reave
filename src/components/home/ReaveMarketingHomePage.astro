---
import Layout from "../../layouts/Layout.astro";
import HomeHeroSection from "./HomeHeroSection.astro";
import HomeStickyCtas from "./HomeStickyCtas.astro";
import FeaturesPageContent from "../features/FeaturesPageContent.astro";
import HomeClientLogosSection from "./HomeClientLogosSection.astro";
import HomeFeaturedProjectSection from "./HomeFeaturedProjectSection.astro";
import HomeSoftwareShowcaseSection from "./HomeSoftwareShowcaseSection.astro";
import HomeContactSection from "./HomeContactSection.astro";
import { getSiteContent } from "../../lib/siteContent";
import "../../styles/marketing-sections.css";

const siteContent = getSiteContent();
const homepage = siteContent.homepage;
---

<Layout>
  <div class="home-scroll">
    {homepage.showFeatures ? (
      <div class="home-sticky-cta-track" data-home-sticky-ctas-track>
        <div class="home-sticky-cta-track__body">
          <HomeHeroSection siteContent={siteContent} />
          <FeaturesPageContent embedded introOnly />
          <HomeClientLogosSection />
          <HomeSoftwareShowcaseSection />
          <FeaturesPageContent embedded hideIntro showLogoStack={false} showAccordion={false} />
        </div>
        <HomeStickyCtas siteContent={siteContent} />
      </div>
    ) : (
      <HomeHeroSection siteContent={siteContent} />
    )}
    <HomeFeaturedProjectSection />
    {homepage.showContact && <HomeContactSection />}
  </div>
  {!homepage.showFeatures && <HomeStickyCtas siteContent={siteContent} />}
</Layout>

<style>
  .home-scroll {
    position: relative;
    z-index: 0;
    max-width: 100%;
    padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    overflow: clip;
    /*
     * Section titles sit under the hero lockup (title tracks the mark, 2.89rem at max).
     * One scale for every h2 on this scroll so they don’t leapfrog
     * the lockup — integrations used to hit 40px, features 2.75rem.
     */
    --home-section-title-size: clamp(1.5rem, 3.5vw, 2rem);
    --home-section-title-weight: 700;
  }

  .home-scroll :global(.home-integrations-copy h2),
  .home-scroll :global(.fx-h1),
  .home-scroll :global(.fx-examples-h2),
  .home-scroll :global(.fx-custom-h2),
  .home-scroll :global(.fx-closing-h2),
  .home-scroll :global(.home-featured-copy h2),
  .home-scroll :global(.home-section-hero h2),
  .home-scroll :global(.sw-title) {
    font-size: var(--home-section-title-size);
    font-weight: var(--home-section-title-weight);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }
</style>
