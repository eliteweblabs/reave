---
/**
 * Homeaglow-style conversion landing — single scroll, booking-first UX.
 * Uses luxury palette tokens (brandColors) — not Homeaglow orange.
 */
import type { SiteLandingConfig } from "../../lib/siteContent";
import { getCompanyConfig } from "../../lib/companyConfig";
import { contactTelHref } from "../../lib/contactApi";
import { hasFeature } from "../../lib/features";
import { isSiteAssistantConfigured } from "../../lib/siteAssistant";
import { resolveSiteChat } from "../../lib/siteChat";
import ConversationalForm from "../ConversationalForm.astro";
import SiteAssistantWidget from "../SiteAssistantWidget.astro";

interface Props {
  landing: SiteLandingConfig;
}

const { landing } = Astro.props;
const company = await getCompanyConfig(Astro.request);
const year = new Date().getFullYear();

const phoneDisplay = (landing.contact?.phone || company.supportPhone || "").trim();
const digits = contactTelHref(
  landing.contact?.phoneHref?.replace(/^tel:/i, "") || phoneDisplay,
);
const phoneHref = digits ? `tel:${digits}` : "";

const brandName = landing.name || company.name || "Chat";
const scheduleUrl = landing.scheduleUrl || "/form/schedule";
const formSlug =
  landing.schedule?.formSlug === false
    ? ""
    : (landing.schedule?.formSlug || "schedule").trim();
const showHeroForm =
  landing.heroEmbedForm === true && hasFeature("scheduling") && Boolean(formSlug);
const bookHref = showHeroForm ? "#book" : scheduleUrl;
const bookPrimary = landing.bookingCta?.primaryLabel || "Book your cleaning";
const bookHeader = landing.bookingCta?.headerLabel || bookPrimary;
const bookSticky = landing.bookingCta?.stickyLabel || bookPrimary;
const promo = landing.promoBanner;

const logoSrc = (landing.heroLogo || "").trim();
const navLinks = landing.conversionNav ?? [
  { href: "#how-it-works", label: "How it works" },
  { href: "#included", label: "What's included" },
  { href: "#reviews", label: "Reviews" },
  { href: "#faq", label: "FAQ" },
  { href: "#service-area", label: "Service area" },
];

const schedule = landing.schedule;
const siteChat = resolveSiteChat({
  chat: landing.chat,
  legacy: schedule,
  brandName,
  photoSrc: landing.chat?.avatarSrc,
  photoAlt: landing.chat?.avatarAlt,
  supportEmail: company.supportEmail,
  domain: company.domain,
  serviceLanding: true,
});
const showFooterChat =
  Boolean(siteChat) &&
  hasFeature("portal_assistant") &&
  isSiteAssistantConfigured();

const brand = landing.brandColors;
const brandStyle = brand
  ? Object.fromEntries(
      Object.entries({
        "--lc-bg": brand.background,
        "--lc-ink": brand.ink,
        "--lc-muted": brand.muted,
        "--lc-accent": brand.accent,
        "--lc-accent-soft": brand.accentSoft,
      }).filter((entry): entry is [string, string] => typeof entry[1] === "string" && entry[1].trim() !== ""),
    )
  : undefined;
---

<div
  class="lc"
  style={brandStyle}
  data-has-chat={showFooterChat ? "1" : "0"}
  data-has-promo={promo ? "1" : "0"}
  data-has-hero-form={showHeroForm ? "1" : "0"}
>
  {
    promo ? (
      <aside class="lc-promo" aria-label="Limited-time offer">
        {promo.label ? <span class="lc-promo__label">{promo.label}</span> : null}
        <p class="lc-promo__message">{promo.message}</p>
        {
          promo.href && promo.ctaLabel ? (
            <a class="lc-promo__cta" href={promo.href}>{promo.ctaLabel}</a>
          ) : null
        }
      </aside>
    ) : null
  }
  <header class="lc-header">
    {
      logoSrc ? (
        <a class="lc-header__brand" href="/" aria-label={brandName}>
          <img src={logoSrc} alt="" width="280" height="120" decoding="async" />
        </a>
      ) : (
        <a class="lc-header__word" href="/">{brandName}</a>
      )
    }
    <nav class="lc-header__nav" aria-label="Site">
      {navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <div class="lc-header__actions">
      {phoneHref ? <a class="lc-header__phone" href={phoneHref}>{phoneDisplay}</a> : null}
      <a class="lc-btn lc-btn--primary lc-header__book" href={bookHref}>{bookHeader}</a>
    </div>
  </header>

  <main class="lc-main">
    <section class="lc-hero" id={showHeroForm ? "book" : undefined}>
      <div class="lc-hero__copy">
        {landing.eyebrow ? <p class="lc-eyebrow">{landing.eyebrow}</p> : null}
        <h1>{landing.heroHeadline || landing.tagline}</h1>
        {landing.heroBody ? <p class="lc-lede">{landing.heroBody}</p> : null}
        {
          showHeroForm ? null : (
            <div class="lc-hero__actions">
              <a class="lc-btn lc-btn--primary lc-btn--lg" href={bookHref}>{bookPrimary}</a>
              {phoneHref ? (
                <a class="lc-btn lc-btn--ghost" href={phoneHref}>Or call {phoneDisplay}</a>
              ) : null}
            </div>
          )
        }
        {
          showHeroForm && phoneHref ? (
            <p class="lc-hero__call">
              Prefer to talk? <a href={phoneHref}>Call {phoneDisplay}</a>
            </p>
          ) : null
        }
        {landing.tagline && landing.heroHeadline && !showHeroForm ? (
          <p class="lc-hero__note">{landing.tagline}</p>
        ) : null}
      </div>
      {
        showHeroForm ? (
          <div class="lc-hero__form">
            <p class="lc-hero__form-title">{bookPrimary}</p>
            <ConversationalForm
              slug={formSlug}
              embedded
              heroChat
              eager
              brandName={brandName}
              inputPlaceholder="Type your answer…"
            />
          </div>
        ) : null
      }
    </section>

    {
      landing.benefits?.items?.length ? (
        <section class="lc-section lc-benefits" id="benefits">
          <h2>{landing.benefits.heading}</h2>
          {landing.benefits.intro ? <p class="lc-section__intro">{landing.benefits.intro}</p> : null}
          <ul class="lc-benefits__list">
            {landing.benefits.items.map((item) => (
              <li>
                <span class="lc-check" aria-hidden="true">✓</span>
                <div>
                  <strong>{item.title}</strong>
                  {item.body ? <p>{item.body}</p> : null}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      landing.featuredReview ? (
        <section class="lc-quote" aria-label="Customer quote">
          <blockquote>“{landing.featuredReview.quote}”</blockquote>
          <cite>— {landing.featuredReview.cite}</cite>
        </section>
      ) : null
    }

    {
      landing.reviews?.items?.length ? (
        <section class="lc-section lc-reviews" id="reviews">
          {
            landing.reviewSummary ? (
              <div class="lc-review-summary">
                <p class="lc-review-summary__score">{landing.reviewSummary.rating}</p>
                <div>
                  <h2>{landing.reviewSummary.heading || landing.reviews.heading}</h2>
                  <p>{landing.reviewSummary.count} {landing.reviewSummary.intro || landing.reviews.intro}</p>
                </div>
              </div>
            ) : (
              <div class="lc-section__head">
                <h2>{landing.reviews.heading}</h2>
                {landing.reviews.intro ? <p>{landing.reviews.intro}</p> : null}
              </div>
            )
          }
          <ul class="lc-reviews__grid">
            {landing.reviews.items.map((item) => (
              <li>
                {item.stars ? <p class="lc-reviews__stars" aria-hidden="true">{item.stars}</p> : null}
                <blockquote>“{item.quote}”</blockquote>
                {item.cite ? <cite>{item.cite}</cite> : null}
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      landing.hoursGuide?.tiers?.length ? (
        <section class="lc-section lc-hours" id="hours">
          <h2>{landing.hoursGuide.heading}</h2>
          {landing.hoursGuide.intro ? <p class="lc-section__intro">{landing.hoursGuide.intro}</p> : null}
          <ul class="lc-hours__grid">
            {landing.hoursGuide.tiers.map((tier) => (
              <li>
                <p class="lc-hours__label">{tier.hours}</p>
                <ul>
                  {tier.rooms.map((room) => (
                    <li>{room}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      landing.steps?.items?.length ? (
        <section class="lc-section lc-steps" id="how-it-works">
          <h2>{landing.steps.heading || "How it works"}</h2>
          <ol class="lc-steps__list">
            {landing.steps.items.map((step, i) => (
              <li>
                <span class="lc-steps__num">{i + 1}</span>
                <p>{step}</p>
              </li>
            ))}
          </ol>
          {
            landing.steps.ctaHref && landing.steps.ctaLabel ? (
              <p class="lc-steps__cta">
                <a class="lc-btn lc-btn--primary" href={landing.steps.ctaHref}>{landing.steps.ctaLabel}</a>
              </p>
            ) : null
          }
        </section>
      ) : null
    }

    {
      landing.includes?.rooms?.length ? (
        <section class="lc-section lc-included" id="included">
          <h2>{landing.includes.heading}</h2>
          {landing.includes.intro ? <p class="lc-section__intro">{landing.includes.intro}</p> : null}
          <ul class="lc-included__grid">
            {landing.includes.rooms.map((room) => (
              <li>
                <h3>{room.name}</h3>
                <ul>
                  {room.items.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      landing.pricing?.tiers?.length ? (
        <section class="lc-section lc-pricing" id="pricing">
          <h2>{landing.pricing.heading}</h2>
          {landing.pricing.intro ? <p class="lc-section__intro">{landing.pricing.intro}</p> : null}
          <ul class="lc-pricing__grid">
            {landing.pricing.tiers.map((tier) => (
              <li class:list={[tier.featured && "is-featured"]}>
                <h3>{tier.name}</h3>
                <p class="lc-pricing__price">{tier.price}</p>
                {tier.description ? <p class="lc-pricing__desc">{tier.description}</p> : null}
              </li>
            ))}
          </ul>
          {landing.pricing.note ? <p class="lc-pricing__note">{landing.pricing.note}</p> : null}
        </section>
      ) : null
    }

    {
      landing.faq?.items?.length ? (
        <section class="lc-section lc-faq" id="faq">
          <h2>{landing.faq.heading}</h2>
          {landing.faq.intro ? <p class="lc-section__intro">{landing.faq.intro}</p> : null}
          <div class="lc-faq__list">
            {landing.faq.items.map((item) => (
              <details class="lc-faq__item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      ) : null
    }

    {
      landing.areas || landing.serviceAreaZip ? (
        <section class="lc-section lc-area" id="service-area">
          <h2>{landing.serviceAreaZip?.heading || landing.areas?.heading || "Service area"}</h2>
          <p class="lc-section__intro">
            {landing.serviceAreaZip?.intro || landing.areas?.intro}
          </p>
          {
            landing.serviceAreaZip ? (
              <form class="lc-zip" action={showHeroForm ? "/" : scheduleUrl} method="get" data-zip-to-book={showHeroForm ? "1" : undefined}>
                <label class="sr-only" for="lc-zip-input">Zip code</label>
                <input
                  id="lc-zip-input"
                  name="zip"
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]{5}"
                  maxlength="5"
                  placeholder={landing.serviceAreaZip.placeholder || "Enter zip code"}
                  required
                />
                <button type="submit" class="lc-btn lc-btn--primary">
                  {landing.serviceAreaZip.buttonLabel || "Check availability"}
                </button>
              </form>
            ) : null
          }
          {
            landing.areas?.cities?.length ? (
              <ul class="lc-area__cities">
                {landing.areas.cities.map((city) => (
                  <li>{city}</li>
                ))}
              </ul>
            ) : null
          }
          {(landing.serviceAreaZip?.note || landing.areas?.note) && (
            <p class="lc-area__note">{landing.serviceAreaZip?.note || landing.areas?.note}</p>
          )}
        </section>
      ) : null
    }

    {
      landing.about ? (
        <section class="lc-section lc-about" id="about">
          <h2>{landing.about.heading}</h2>
          {landing.about.body?.map((p) => (
            <p class="lc-copy">{p}</p>
          ))}
          {
            landing.about.highlights?.length ? (
              <ul class="lc-about__tags">
                {landing.about.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : null
          }
        </section>
      ) : null
    }

    {
      landing.numbers?.stats?.length ? (
        <section class="lc-section lc-why" id="why-us">
          <h2>{landing.numbers.heading || "Why homeowners choose us"}</h2>
          <ul class="lc-why__grid">
            {landing.numbers.stats.map((stat) => (
              <li>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      landing.contact && (phoneHref || landing.contact.email) ? (
        <section class="lc-section lc-contact" id="contact">
          <h2>{landing.contact.heading || "Ready to book?"}</h2>
          <div class="lc-contact__actions">
            <a class="lc-btn lc-btn--primary lc-btn--lg" href={bookHref}>{bookPrimary}</a>
            {phoneHref ? <a class="lc-btn lc-btn--ghost" href={phoneHref}>{phoneDisplay}</a> : null}
            {landing.contact.email ? (
              <a class="lc-contact__email" href={`mailto:${landing.contact.email}`}>{landing.contact.email}</a>
            ) : null}
          </div>
        </section>
      ) : null
    }
  </main>

  <footer class="lc-foot">
    <p>&copy; {year} {landing.footer || brandName}</p>
  </footer>

  <a class="lc-sticky" href={bookHref} aria-label={bookSticky}>{bookSticky}</a>

  {
    showFooterChat ? (
      <SiteAssistantWidget
        brandTitle={brandName}
        headerTitle={siteChat?.headerTitle || brandName}
        headerSubtitle={siteChat?.headerSubtitle}
        greeting={siteChat?.greeting || `Hi — how can we help?`}
        fabLabel={`Chat with ${brandName}`}
        footerPrefix={siteChat?.footerPrefix || "Questions?"}
        supportPhone={phoneDisplay || company.supportPhone}
        supportEmail={company.supportEmail}
        pagePath={Astro.url.pathname}
        inputPlaceholder={siteChat?.inputPlaceholder || "Ask a question…"}
        avatarSrc={siteChat?.avatarSrc || undefined}
        storageKey={siteChat?.historyStorageKey || "sa-chat-site"}
        hideFab={siteChat?.hideFab !== false}
        revealFabOnEngagement={siteChat?.revealFabOnEngagement === true}
      />
    ) : null
  }
</div>

<style>
  .lc {
    --lc-bg: #f5faf9;
    --lc-ink: #0a3d3d;
    --lc-muted: #4a6565;
    --lc-accent: #007070;
    --lc-accent-soft: rgba(0, 112, 112, 0.12);
    --lc-line: rgba(10, 61, 61, 0.12);
    --lc-card: #ffffff;
    min-height: 100dvh;
    color: var(--lc-ink);
    background: var(--lc-bg);
    padding-bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
    font-family: Outfit, system-ui, sans-serif;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .lc-promo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.75rem;
    padding: 0.55rem 1rem;
    background: var(--lc-accent);
    color: #fff;
    text-align: center;
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .lc-promo__label {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lc-promo__message {
    margin: 0;
    font-weight: 600;
  }

  .lc-promo__cta {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .lc-promo__cta:hover {
    opacity: 0.9;
  }

  .lc-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding: calc(0.75rem + env(safe-area-inset-top, 0px)) 1.25rem 0.75rem;
    background: var(--lc-card);
    border-bottom: 1px solid var(--lc-line);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .lc[data-has-promo="1"] .lc-header {
    top: 0;
  }

  .lc-header__brand img {
    display: block;
    width: min(9.5rem, 36vw);
    height: auto;
  }

  .lc-header__word {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--lc-ink);
  }

  .lc-header__nav {
    display: none;
    gap: 1.25rem;
    flex: 1;
    justify-content: center;
  }

  .lc-header__nav a {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--lc-muted);
    text-decoration: none;
  }

  .lc-header__nav a:hover {
    color: var(--lc-accent);
  }

  .lc-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .lc-header__phone {
    display: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--lc-muted);
    text-decoration: none;
  }

  .lc-header__book {
    padding: 0.55rem 1rem;
    font-size: 0.82rem;
  }

  .lc-main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.25rem 2rem;
  }

  .lc-section {
    padding: 2.5rem 0;
    border-top: 1px solid var(--lc-line);
  }

  .lc-section h2 {
    margin: 0;
    font-size: clamp(1.45rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .lc-section__intro,
  .lc-lede,
  .lc-copy {
    color: var(--lc-muted);
    line-height: 1.65;
    font-size: 1rem;
  }

  .lc-section__intro {
    margin: 0.75rem 0 0;
    max-width: 40rem;
  }

  .lc-hero {
    text-align: center;
    padding: 2rem 0 2.5rem;
  }

  .lc[data-has-hero-form="1"] .lc-hero {
    display: grid;
    gap: 1.75rem;
    text-align: left;
    align-items: start;
  }

  .lc-hero__copy {
    min-width: 0;
  }

  .lc[data-has-hero-form="1"] .lc-hero h1 {
    margin-inline: 0;
    max-width: none;
  }

  .lc[data-has-hero-form="1"] .lc-lede {
    margin-inline: 0;
  }

  .lc-hero__call {
    margin: 1rem 0 0;
    font-size: 0.92rem;
    color: var(--lc-muted);
  }

  .lc-hero__call a {
    color: var(--lc-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .lc-hero__call a:hover {
    text-decoration: underline;
  }

  .lc-hero__form {
    --site-fg: var(--lc-ink);
    --site-fg-muted: var(--lc-muted);
    --site-card: #fff;
    --site-card-border: var(--lc-line);
    --site-border: var(--lc-line);
    --brand-btn-bg: var(--lc-accent);
    --brand-btn-fg: #fff;
    --demo-fg: var(--lc-ink);
    --demo-fg-muted: var(--lc-muted);
    --demo-line: var(--lc-line);
    --demo-bubble-fill: #fff;
    min-width: 0;
    padding: 1.25rem 1.15rem 1.35rem;
    border-radius: 1rem;
    border: 1px solid var(--lc-line);
    background: var(--lc-card);
    box-shadow: 0 12px 32px rgba(10, 61, 61, 0.08);
  }

  .lc-hero__form-title {
    margin: 0 0 0.85rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--lc-ink);
  }

  .lc-eyebrow {
    margin: 0 0 0.75rem;
    color: var(--lc-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lc-hero h1 {
    margin: 0;
    font-size: clamp(1.85rem, 6vw, 2.75rem);
    font-weight: 800;
    line-height: 1.12;
    max-width: 18ch;
    margin-inline: auto;
  }

  .lc-lede {
    margin: 1rem auto 0;
    max-width: 36rem;
  }

  .lc-hero__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .lc-hero__note {
    margin: 1.25rem auto 0;
    max-width: 32rem;
    color: var(--lc-muted);
    font-size: 0.92rem;
  }

  .lc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.35rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none !important;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .lc-btn--lg {
    padding: 1rem 1.75rem;
    font-size: 1.02rem;
  }

  .lc-btn--primary {
    background: var(--lc-accent);
    color: #fff !important;
    box-shadow: 0 10px 24px rgba(0, 112, 112, 0.22);
  }

  .lc-btn--ghost {
    background: transparent;
    color: var(--lc-ink) !important;
    border: 1px solid var(--lc-line);
  }

  .lc-btn:active {
    transform: scale(0.985);
  }

  .lc-benefits__list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .lc-benefits__list > li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    background: var(--lc-card);
    border: 1px solid var(--lc-line);
    border-radius: 0.85rem;
  }

  .lc-check {
    flex-shrink: 0;
    width: 1.5rem;
