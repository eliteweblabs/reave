<script>
  document.querySelectorAll<HTMLFormElement>("form.lc-zip[data-zip-to-book]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const zip = new FormData(form).get("zip");
      const value = String(zip ?? "").trim();
      if (!value) return;
      window.location.assign(`/?zip=${encodeURIComponent(value)}#book`);
    });
  });
</script>
