---
/**
 * Mobile-first call-first landing for travel service businesses.
 * No map, no address, no directions — phone is the product.
 */
import type { SiteLandingConfig } from "../../lib/siteContent";
import { getCompanyConfig } from "../../lib/companyConfig";
import { contactTelHref } from "../../lib/contactApi";
import ConversationalForm from "../ConversationalForm.astro";
import { siApplepay, siVenmo } from "simple-icons";
import { Banknote, CreditCard } from "lucide-astro";

interface Props {
  landing: SiteLandingConfig;
}

/** Brand marks from the `simple-icons` package — never hand-draw these. */
const SIMPLE_ICON_BY_SLUG = {
  applepay: siApplepay,
  venmo: siVenmo,
} as const;

const LUCIDE_BY_NAME = {
  banknote: Banknote,
  "credit-card": CreditCard,
} as const;

const { landing } = Astro.props;
const company = await getCompanyConfig(Astro.request);
const year = new Date().getFullYear();

const phoneDisplay =
  (landing.contact?.phone || company.supportPhone || "").trim();
const digits = contactTelHref(
  landing.contact?.phoneHref?.replace(/^tel:/i, "") || phoneDisplay,
);
const phoneHref = digits ? `tel:${digits}` : "";

const callLabel = landing.callCta?.label || "Call now";
const stickyLabel = landing.callCta?.stickyLabel || callLabel;
const services = landing.services;
const serviceItems =
  services?.items?.map((item) =>
    typeof item === "string" ? { label: item, icon: undefined as string | undefined } : item,
  ) ?? [];
const payments = landing.payments;
const paymentMethods =
  payments?.methods?.map((method) => {
    const slug = method.simpleIcon?.trim().toLowerCase() || "";
    const brand =
      slug && slug in SIMPLE_ICON_BY_SLUG
        ? SIMPLE_ICON_BY_SLUG[slug as keyof typeof SIMPLE_ICON_BY_SLUG]
        : null;
    const lucideKey = method.lucide?.trim().toLowerCase() || "";
    const LucideIcon =
      lucideKey && lucideKey in LUCIDE_BY_NAME
        ? LUCIDE_BY_NAME[lucideKey as keyof typeof LUCIDE_BY_NAME]
        : null;
    return { label: method.label, brand, LucideIcon };
  }) ?? [];
const schedule = landing.schedule;
const scheduleFormSlug =
  schedule?.formSlug === false
    ? ""
    : (typeof schedule?.formSlug === "string" && schedule.formSlug.trim()) ||
      (schedule ? "schedule" : "");
const scheduleUrl = (landing.scheduleUrl || "").trim();
const chatPlaceholder =
  (schedule?.dockPlaceholder || "").trim() || "How can I help you?";
const introPhrases = (schedule?.introPhrases || [])
  .map((p) => String(p || "").trim())
  .filter(Boolean);
const showFooterChat = Boolean(scheduleFormSlug);
const about = landing.about;
const contact = landing.contact;
const reviews = landing.reviews;
const face = landing.photo;
const footerImage = landing.footerImage || "";
const chatFaceSrc = (face?.src || "").trim();
const chatFaceAlt = face?.alt || landing.name || "Pat";

/** Prefer a static site logo so admin branding reprocessing cannot mangle it. */
const logoSrc = (landing.heroLogo || "").trim()
  || (company.logoPath && company.logoSource !== "hidden"
    ? `${company.logoPath}${company.logoVersion ? `?v=${encodeURIComponent(company.logoVersion)}` : ""}`
    : "");
---

<div class={`svc${footerImage ? " svc--skyline" : ""}`} data-has-phone={phoneHref ? "1" : "0"} data-has-chat={showFooterChat ? "1" : "0"}>
  <div class="svc-login-bar">
    <a class="svc-login" href="/sign-in">Login</a>
    {
      phoneHref ? (
        <a class="svc-top-call" href={phoneHref} aria-label={callLabel}>
          <!-- IOS_ICONS.phone — keep in sync with public/admin/admin-ui.js -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
        </a>
      ) : null
    }
  </div>

  <main class="svc-main">
    <section class="svc-hero">
      {
        logoSrc ? (
          <img
            class="svc-logo"
            src={logoSrc}
            alt={landing.name || company.name}
            width="907"
            height="1014"
          />
        ) : null
      }
      {landing.eyebrow && <p class="svc-eyebrow">{landing.eyebrow}</p>}
      <h1>{landing.heroHeadline || landing.name || company.name}</h1>
      {
        landing.heroBody && (
          <p class="svc-lede">{landing.heroBody}</p>
        )
      }
      {
        phoneHref ? (
          <a class="svc-call" href={phoneHref}>
            <!-- IOS_ICONS.phone — keep in sync with public/admin/admin-ui.js -->
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
            <span class="svc-call__label">
              <strong>{callLabel}</strong>
              {phoneDisplay && <span class="svc-call__num">{phoneDisplay}</span>}
            </span>
          </a>
        ) : (
          <p class="svc-call-missing">Phone number coming soon — check back shortly.</p>
        )
      }
      {landing.tagline && <p class="svc-tagline">{landing.tagline}</p>}
    </section>

    {
      serviceItems.length ? (
        <section class="svc-section" id="services">
          <h2>{services?.heading}</h2>
          <ul class="svc-services">
            {serviceItems.map((item) => (
              <li>
                {item.icon ? (
                  <img class="svc-services__icon" src={item.icon} alt="" width="72" height="72" />
                ) : null}
                <span>{item.label}</span>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      payments && paymentMethods.length ? (
        <section class="svc-section" id="payments">
          <h2>{payments.heading}</h2>
          {payments.intro && <p class="svc-copy">{payments.intro}</p>}
          <ul class="svc-pay">
            {paymentMethods.map((method) => (
              <li>
                {method.brand ? (
                  <span
                    class="svc-pay__mark"
                    style={`--pay-brand:#${method.brand.hex}`}
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" width="28" height="28" role="img">
                      <title>{method.brand.title}</title>
                      <path fill="currentColor" d={method.brand.path} />
                    </svg>
                  </span>
                ) : method.LucideIcon === Banknote ? (
                  <span class="svc-pay__mark svc-pay__mark--stroke" aria-hidden="true">
                    <Banknote size={28} strokeWidth={1.75} />
                  </span>
                ) : method.LucideIcon === CreditCard ? (
                  <span class="svc-pay__mark svc-pay__mark--stroke" aria-hidden="true">
                    <CreditCard size={28} strokeWidth={1.75} />
                  </span>
                ) : null}
                <span>{method.label}</span>
              </li>
            ))}
          </ul>
          {payments.onlineNote && (
            <p class="svc-pay__online">{payments.onlineNote}</p>
          )}
        </section>
      ) : null
    }

    {
      reviews?.items?.length ? (
        <section class="svc-section" id="reviews">
          <h2>{reviews.heading}</h2>
          {reviews.intro && <p class="svc-copy">{reviews.intro}</p>}
          <ul class="svc-reviews">
            {reviews.items.map((item) => (
              <li>
                {item.stars && <p class="svc-reviews__stars">{item.stars}</p>}
                <blockquote>“{item.quote}”</blockquote>
                <cite>{item.cite}</cite>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      about && (
        <section class="svc-section" id="about">
          <div class={`svc-about${face?.src ? " svc-about--face" : ""}`}>
            {face?.src ? (
              <img
                class="svc-about__face"
                src={face.src}
                alt={face.alt || landing.name || "Pat"}
                width={face.width || 512}
                height={face.height || 512}
              />
            ) : null}
            <div class="svc-about__copy">
              <h2>{about.heading}</h2>
              {about.body?.map((p) => (
                <p class="svc-copy">{p}</p>
              ))}
            </div>
          </div>
          {about.highlights?.length ? (
            <ul class="svc-highlights">
              {about.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : null}
        </section>
      )
    }

    {
      contact && (phoneHref || contact.email) && (
        <section class="svc-section" id="contact">
          <h2>{contact.heading || "Contact"}</h2>
          <ul class="svc-contact">
            {phoneHref && phoneDisplay && (
              <li>
                <span>Phone</span>
                <a href={phoneHref}>{phoneDisplay}</a>
              </li>
            )}
            {contact.email && (
              <li>
                <span>Email</span>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </li>
            )}
          </ul>
        </section>
      )
    }
  </main>

  <footer class={`svc-foot${footerImage ? " svc-foot--art" : ""}`}>
    {
      footerImage ? (
        <img
          class="svc-foot__art"
          src={footerImage}
          alt=""
          width="8192"
          height="5269"
          decoding="async"
        />
      ) : null
    }
    <div class="svc-foot__meta">
      <p>&copy; {year} {landing.footer || landing.name || company.name}</p>
    </div>
  </footer>

  {
    showFooterChat ? (
      <div class="svc-footer-chat" data-svc-footer-chat role="region" aria-label="Chat">
        {
          introPhrases.length ? (
            <div
              class="svc-footer-chat__intro"
              data-svc-intro
              hidden
              aria-hidden="true"
            >
              {
                chatFaceSrc ? (
                  <img
                    class="svc-footer-chat__face"
                    src={chatFaceSrc}
                    alt=""
                    width="40"
                    height="40"
                    decoding="async"
                  />
                ) : (
                  <span class="svc-footer-chat__face svc-footer-chat__face--fallback" aria-hidden="true">
                    {(landing.name || "P").trim().charAt(0)}
                  </span>
                )
              }
              <p class="svc-footer-chat__bubble" data-svc-intro-text></p>
            </div>
          ) : null
        }
        <ConversationalForm
          slug={scheduleFormSlug}
          dock
          brandName={landing.name || company.name || "Pat the Plumber"}
          inputPlaceholder={chatPlaceholder}
        />
        {
          scheduleUrl && scheduleUrl !== `/form/${scheduleFormSlug}` ? (
            <p class="svc-footer-chat__link">
              <a href={scheduleUrl}>Open full scheduler</a>
            </p>
          ) : null
        }
      </div>
    ) : phoneHref ? (
      <div class="svc-sticky" role="region" aria-label="Call">
        <a class="svc-sticky__btn" href={phoneHref}>
          <!-- IOS_ICONS.phone — keep in sync with public/admin/admin-ui.js -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
          {stickyLabel}
        </a>
      </div>
    ) : null
  }
</div>

{
  showFooterChat && introPhrases.length ? (
    <script is:inline define:vars={{ introPhrases, chatFaceAlt }}>
      (function () {
        const root = document.querySelector("[data-svc-footer-chat]");
        const intro = root?.querySelector("[data-svc-intro]");
        const textEl = intro?.querySelector("[data-svc-intro-text]");
        if (!root || !intro || !textEl || !introPhrases.length) return;

        const face = intro.querySelector(".svc-footer-chat__face");
        if (face instanceof HTMLImageElement && chatFaceAlt) {
          face.alt = chatFaceAlt;
        }

        const pick = introPhrases[Math.floor(Math.random() * introPhrases.length)];
        textEl.textContent = pick;

        const hideIntro = () => {
          intro.hidden = true;
          intro.setAttribute("aria-hidden", "true");
          intro.classList.remove("is-visible");
        };

        root.addEventListener("cf-dock-expand", hideIntro);

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          intro.hidden = false;
          intro.setAttribute("aria-hidden", "false");
          intro.classList.add("is-visible");
          return;
        }

        const DELAY_MS = 3000;
        let revealed = false;
        let timer = null;
        const ENGAGE = ["scroll", "pointerdown", "keydown", "touchstart"];

        const reveal = () => {
          if (revealed || root.querySelector(".conversational-form-root--dock.is-active")) {
            return;
          }
          revealed = true;
          if (timer) clearTimeout(timer);
          ENGAGE.forEach((ev) => window.removeEventListener(ev, onEngage));
          intro.hidden = false;
          intro.setAttribute("aria-hidden", "false");
          requestAnimationFrame(() => intro.classList.add("is-visible"));
        };

        const onEngage = () => {
          if (revealed || timer) return;
          timer = setTimeout(reveal, DELAY_MS);
        };

        ENGAGE.forEach((ev) =>
          window.addEventListener(ev, onEngage, { passive: true }),
        );
      })();
    </script>
  ) : null
}

<style>
  .svc {
    --svc-ink: #0f172a;
    --svc-muted: #475569;
    --svc-line: #dbe3ef;
    --svc-bg: #f4f7fb;
    --svc-panel: #ffffff;
    --svc-call: #0b6e4f;
    --svc-call-ink: #ffffff;
    --svc-accent: #0c4a6e;
    /* Exact water fill from footer.svg (.st for harbor blue). */
    --svc-water: #589bb5;
    min-height: 100dvh;
    padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));
    color: var(--svc-ink);
    background: transparent;
  }

  .svc--skyline {
    padding-bottom: 0;
  }

  .svc-login-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
    padding: calc(0.65rem + env(safe-area-inset-top, 0px)) 1rem 0.25rem;
  }

  .svc-login {
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(15, 23, 42, 0.18);
    border-radius: 999px;
    color: var(--svc-ink);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none !important;
    background: rgba(255, 255, 255, 0.72);
  }

  .svc-top-call {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--svc-call);
    color: var(--svc-call-ink);
    text-decoration: none;
  }

  .svc-main {
    max-width: 34rem;
    margin: 0 auto;
    padding: 0.5rem 1.15rem 2rem;
  }

  .svc-hero {
    padding: 0.5rem 0 1.75rem;
    text-align: center;
  }

  .svc-logo {
    display: block;
    width: min(20rem, 78vw);
    height: auto;
    margin: 0 auto 1.15rem;
    image-rendering: auto;
  }

  .svc-eyebrow {
    margin: 0 0 0.55rem;
    color: var(--svc-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .svc-hero h1 {
    margin: 0;
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
    font-size: clamp(2.35rem, 11vw, 3.25rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.01em;
  }

  .svc-lede {
    margin: 0.9rem auto 0;
    max-width: 28rem;
    color: var(--svc-muted);
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .svc-call {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    margin-top: 1.35rem;
    padding: 1rem 1.15rem;
    border-radius: 1rem;
    background: var(--svc-call);
    color: var(--svc-call-ink) !important;
    text-align: left;
    text-decoration: none !important;
    box-shadow: 0 14px 28px rgba(11, 110, 79, 0.28);
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .svc-call:active {
    transform: scale(0.985);
  }

  .svc-call__label {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .svc-call__label strong {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .svc-call__num {
    font-size: 0.95rem;
    opacity: 0.92;
  }

  .svc-call-missing {
    margin: 1.25rem 0 0;
    padding: 1rem;
    border: 1px dashed rgba(15, 23, 42, 0.25);
    border-radius: 0.85rem;
    color: var(--svc-muted);
    background: rgba(255, 255, 255, 0.65);
  }

  .svc-tagline {
    margin: 1rem auto 0;
    max-width: 28rem;
    color: var(--svc-muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .svc-section {
    margin-top: 0.35rem;
    padding: 1.35rem 0 0.35rem;
    border-top: 1px solid var(--svc-line);
    text-align: left;
  }

  .svc-section h2 {
    margin: 0 0 0.85rem;
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .svc-list,
  .svc-highlights,
  .svc-contact,
  .svc-services,
  .svc-reviews {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-list li,
  .svc-highlights li {
    position: relative;
    padding: 0.7rem 0 0.7rem 1.15rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    color: var(--svc-ink);
    line-height: 1.4;
  }

  .svc-list li:last-child,
  .svc-highlights li:last-child {
    border-bottom: 0;
  }

  .svc-list li::before,
  .svc-highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--svc-accent);
  }

  .svc-services {
    display: grid;
    gap: 0.85rem;
  }

  .svc-services li {
    display: grid;
    grid-template-columns: 4.25rem 1fr;
    gap: 0.85rem;
    align-items: center;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.72);
    line-height: 1.35;
    font-weight: 600;
  }

  .svc-services__icon {
    width: 4.25rem;
    height: 4.25rem;
    object-fit: contain;
  }

  .svc-pay {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-pay li {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    padding: 0.85rem 0.65rem 0.75rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.78);
    text-align: center;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .svc-pay__mark {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.7rem;
    color: #fff;
    background: var(--pay-brand, #0f172a);
  }

  .svc-pay__mark--stroke {
    color: var(--svc-accent);
    background: rgba(12, 74, 110, 0.08);
  }

  .svc-pay__mark svg {
    display: block;
  }

  .svc-pay__online {
    margin: 0.95rem 0 0;
    padding: 0.85rem 1rem;
    border-radius: 0.85rem;
    border: 1px dashed rgba(12, 74, 110, 0.35);
    background: rgba(255, 255, 255, 0.7);
    color: var(--svc-accent);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .svc-footer-chat {
    --svc-footer-chat-max: 34rem;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: grid;
    justify-items: stretch;
    gap: 0.55rem;
    padding: 0.55rem 1rem calc(0.65rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(180deg, rgba(244, 247, 251, 0), rgba(244, 247, 251, 0.97) 40%);
    pointer-events: none;
  }

  .svc-footer-chat > :global(*) {
    pointer-events: auto;
  }

  .svc-footer-chat :global(.conversational-form-root--dock),
  .svc-footer-chat__intro,
  .svc-footer-chat__link {
    width: 100%;
    max-width: var(--svc-footer-chat-max);
    margin-left: auto;
    margin-right: auto;
  }

  .svc-footer-chat__intro {
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    opacity: 0;
    transform: translateY(0.55rem);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .svc-footer-chat__intro.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .svc-footer-chat__face {
    flex-shrink: 0;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 999px;
    object-fit: cover;
    border: 1.5px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.16);
    background: #e2e8f0;
  }

  .svc-footer-chat__face--fallback {
    display: grid;
    place-items: center;
    color: #fff;
