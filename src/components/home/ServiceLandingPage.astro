---
/**
 * Mobile-first call-first landing for travel service businesses.
 * No map, no address, no directions — phone is the product.
 */
import type { SiteLandingConfig } from "../../lib/siteContent";
import { getCompanyConfig } from "../../lib/companyConfig";
import { contactTelHref } from "../../lib/contactApi";

interface Props {
  landing: SiteLandingConfig;
}

const { landing } = Astro.props;
const company = await getCompanyConfig(Astro.request);
const year = new Date().getFullYear();

const phoneDisplay =
  (landing.contact?.phone || company.supportPhone || "").trim();
const digits = contactTelHref(
  landing.contact?.phoneHref?.replace(/^tel:/i, "") || phoneDisplay,
);
const phoneHref = digits ? `tel:${digits}` : "";

const callLabel = landing.callCta?.label || "Call now";
const stickyLabel = landing.callCta?.stickyLabel || callLabel;
const services = landing.services;
const serviceItems =
  services?.items?.map((item) =>
    typeof item === "string" ? { label: item, icon: undefined as string | undefined } : item,
  ) ?? [];
const about = landing.about;
const contact = landing.contact;
const footerImage = landing.footerImage || "";

const logoSrc =
  company.logoPath && company.logoSource !== "hidden"
    ? `${company.logoPath}${company.logoVersion ? `?v=${encodeURIComponent(company.logoVersion)}` : ""}`
    : "";
const iconSrc =
  company.iconPath && company.iconSource !== "hidden"
    ? (() => {
        const u = new URL(company.iconPath, "https://pat-the-plumber.com");
        if (!u.searchParams.has("size")) u.searchParams.set("size", "192");
        if (!u.searchParams.has("transparent")) u.searchParams.set("transparent", "1");
        if (company.iconVersion) u.searchParams.set("v", company.iconVersion);
        return `${u.pathname}${u.search}`;
      })()
    : "";
---

<div class={`svc${footerImage ? " svc--skyline" : ""}`} data-has-phone={phoneHref ? "1" : "0"}>
  <header class="svc-top">
    {
      iconSrc ? (
        <a class="svc-brand" href="/" aria-label={landing.name || company.name}>
          <img class="svc-brand__mark" src={iconSrc} alt="" width="36" height="36" />
          <span>{landing.name || company.name}</span>
        </a>
      ) : (
        <p class="svc-brand">{landing.name || company.name}</p>
      )
    }
    <div class="svc-top-actions">
      <a class="svc-login" href="/sign-in">Login</a>
      {
        phoneHref ? (
          <a class="svc-top-call" href={phoneHref} aria-label={callLabel}>
            <!-- IOS_ICONS.phone — keep in sync with public/admin/admin-ui.js -->
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
          </a>
        ) : null
      }
    </div>
  </header>

  <main class="svc-main">
    <section class="svc-hero">
      {
        logoSrc ? (
          <img
            class="svc-logo"
            src={logoSrc}
            alt={landing.name || company.name}
            width="320"
            height="354"
          />
        ) : null
      }
      {landing.eyebrow && <p class="svc-eyebrow">{landing.eyebrow}</p>}
      <h1>{landing.heroHeadline || landing.name || company.name}</h1>
      {
        landing.heroBody && (
          <p class="svc-lede">{landing.heroBody}</p>
        )
      }
      {
        phoneHref ? (
          <a class="svc-call" href={phoneHref}>
            <!-- IOS_ICONS.phone — keep in sync with public/admin/admin-ui.js -->
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
            <span class="svc-call__label">
              <strong>{callLabel}</strong>
              {phoneDisplay && <span class="svc-call__num">{phoneDisplay}</span>}
            </span>
          </a>
        ) : (
          <p class="svc-call-missing">Phone number coming soon — check back shortly.</p>
        )
      }
      {landing.tagline && <p class="svc-tagline">{landing.tagline}</p>}
    </section>

    {
      serviceItems.length ? (
        <section class="svc-section" id="services">
          <h2>{services?.heading}</h2>
          <ul class="svc-services">
            {serviceItems.map((item) => (
              <li>
                {item.icon ? (
                  <img class="svc-services__icon" src={item.icon} alt="" width="72" height="72" />
                ) : null}
                <span>{item.label}</span>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      about && (
        <section class="svc-section" id="about">
          <h2>{about.heading}</h2>
          {about.body?.map((p) => (
            <p class="svc-copy">{p}</p>
          ))}
          {about.highlights?.length ? (
            <ul class="svc-highlights">
              {about.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : null}
        </section>
      )
    }

    {
      contact && (phoneHref || contact.email) && (
        <section class="svc-section" id="contact">
          <h2>{contact.heading || "Contact"}</h2>
          <ul class="svc-contact">
            {phoneHref && phoneDisplay && (
              <li>
                <span>Phone</span>
                <a href={phoneHref}>{phoneDisplay}</a>
              </li>
            )}
            {contact.email && (
              <li>
                <span>Email</span>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </li>
            )}
          </ul>
        </section>
      )
    }
  </main>

  <footer class={`svc-foot${footerImage ? " svc-foot--art" : ""}`}>
    {
      footerImage ? (
        <img
          class="svc-foot__art"
          src={footerImage}
          alt=""
          width="1024"
          height="655"
          decoding="async"
        />
      ) : null
    }
    <div class="svc-foot__meta">
      <p>&copy; {year} {landing.footer || landing.name || company.name}</p>
      <a class="svc-staff" href="/sign-in">Login</a>
    </div>
  </footer>

  {
    phoneHref && (
      <div class="svc-sticky" role="region" aria-label="Call">
        <a class="svc-sticky__btn" href={phoneHref}>
          <!-- IOS_ICONS.phone — keep in sync with public/admin/admin-ui.js -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
          {stickyLabel}
        </a>
      </div>
    )
  }
</div>

<style>
  .svc {
    --svc-ink: #0f172a;
    --svc-muted: #475569;
    --svc-line: #dbe3ef;
    --svc-bg: #f4f7fb;
    --svc-panel: #ffffff;
    --svc-call: #0b6e4f;
    --svc-call-ink: #ffffff;
    --svc-accent: #0c4a6e;
    --svc-sky: #fefefe;
    --svc-water: #6998a9;
    min-height: 100dvh;
    padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));
    color: var(--svc-ink);
    background:
      radial-gradient(120% 80% at 50% -10%, #dceaf8 0%, transparent 55%),
      linear-gradient(180deg, #eef3f8 0%, var(--svc-bg) 40%, #e8eef5 100%);
  }

  /* Match the skyline art sky so the footer doesn’t read as a pasted image. */
  .svc--skyline {
    background:
      radial-gradient(120% 70% at 50% -8%, #e7f3fb 0%, transparent 52%),
      linear-gradient(180deg, #eef3f8 0%, #f4f7fb 38%, #fafcfd 72%, var(--svc-sky) 100%);
    padding-bottom: 0;
  }

  .svc-top {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: calc(0.65rem + env(safe-area-inset-top, 0px)) 1rem 0.65rem;
    background: rgba(244, 247, 251, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
  }

  .svc-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    min-width: 0;
    color: inherit;
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .svc-brand__mark {
    width: 2.05rem;
    height: 2.05rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .svc-brand span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .svc-top-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  .svc-login {
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(15, 23, 42, 0.18);
    border-radius: 999px;
    color: var(--svc-ink);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none !important;
    background: rgba(255, 255, 255, 0.72);
  }

  .svc-top-call {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--svc-call);
    color: var(--svc-call-ink);
    text-decoration: none;
  }

  .svc-main {
    max-width: 34rem;
    margin: 0 auto;
    padding: 1.25rem 1.15rem 2rem;
  }

  .svc-hero {
    padding: 1.25rem 0 1.75rem;
    text-align: left;
  }

  .svc-logo {
    display: block;
    width: min(13.5rem, 62vw);
    height: auto;
    margin: 0 0 1rem;
    image-rendering: auto;
  }

  .svc-eyebrow {
    margin: 0 0 0.55rem;
    color: var(--svc-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .svc-hero h1 {
    margin: 0;
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
    font-size: clamp(2.35rem, 11vw, 3.25rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.01em;
  }

  .svc-lede {
    margin: 0.9rem 0 0;
    max-width: 28rem;
    color: var(--svc-muted);
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .svc-call {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    margin-top: 1.35rem;
    padding: 1rem 1.15rem;
    border-radius: 1rem;
    background: var(--svc-call);
    color: var(--svc-call-ink) !important;
    text-decoration: none !important;
    box-shadow: 0 14px 28px rgba(11, 110, 79, 0.28);
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .svc-call:active {
    transform: scale(0.985);
  }

  .svc-call__label {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .svc-call__label strong {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .svc-call__num {
    font-size: 0.95rem;
    opacity: 0.92;
  }

  .svc-call-missing {
    margin: 1.25rem 0 0;
    padding: 1rem;
    border: 1px dashed rgba(15, 23, 42, 0.25);
    border-radius: 0.85rem;
    color: var(--svc-muted);
    background: rgba(255, 255, 255, 0.65);
  }

  .svc-tagline {
    margin: 1rem 0 0;
    color: var(--svc-muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .svc-section {
    margin-top: 0.35rem;
    padding: 1.35rem 0 0.35rem;
    border-top: 1px solid var(--svc-line);
  }

  .svc-section h2 {
    margin: 0 0 0.85rem;
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .svc-list,
  .svc-highlights,
  .svc-contact,
  .svc-services {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-list li,
  .svc-highlights li {
    position: relative;
    padding: 0.7rem 0 0.7rem 1.15rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    color: var(--svc-ink);
    line-height: 1.4;
  }

  .svc-list li:last-child,
  .svc-highlights li:last-child {
    border-bottom: 0;
  }

  .svc-list li::before,
  .svc-highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--svc-accent);
  }

  .svc-services {
    display: grid;
    gap: 0.85rem;
  }

  .svc-services li {
    display: grid;
    grid-template-columns: 4.25rem 1fr;
    gap: 0.85rem;
    align-items: center;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.72);
    line-height: 1.35;
    font-weight: 600;
  }

  .svc-services__icon {
    width: 4.25rem;
    height: 4.25rem;
    object-fit: contain;
  }

  .svc-copy {
    margin: 0 0 0.85rem;
    color: var(--svc-muted);
    line-height: 1.55;
  }

  .svc-contact li {
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
  }

  .svc-contact li:last-child {
    border-bottom: 0;
  }

  .svc-contact span {
    color: var(--svc-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .svc-contact a {
    color: var(--svc-ink);
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .svc-foot {
    margin-top: 0.5rem;
  }

  .svc-foot--art {
    position: relative;
    left: 50%;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 -50vw;
    padding: 0;
    background: var(--svc-water);
    overflow: hidden;
  }

  .svc-foot__art {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    vertical-align: top;
  }

  .svc-foot__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0.75rem 1.15rem calc(0.85rem + env(safe-area-inset-bottom, 0px));
    color: #f4fbff;
    font-size: 0.8rem;
    background: var(--svc-water);
  }

  .svc--skyline[data-has-phone="1"] .svc-foot__meta {
    padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));
  }

  .svc-foot__meta p {
    margin: 0;
  }

  .svc-staff {
    color: inherit;
    text-decoration: none;
    opacity: 0.85;
  }

  .svc:not(:has(.svc-foot--art)) .svc-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: 34rem;
    margin: 0 auto;
    padding: 1.25rem 1.15rem 0.5rem;
    color: var(--svc-muted);
    font-size: 0.8rem;
  }

  .svc:not(:has(.svc-foot--art)) .svc-foot p {
    margin: 0;
  }

  .svc-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(180deg, rgba(105, 152, 169, 0), rgba(105, 152, 169, 0.92) 40%);
  }

  .svc:not(.svc--skyline) .svc-sticky {
    background: linear-gradient(180deg, rgba(244, 247, 251, 0), rgba(244, 247, 251, 0.96) 35%);
  }

  .svc-sticky__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    padding: 0.95rem 1rem;
    border-radius: 999px;
    background: var(--svc-call);
    color: var(--svc-call-ink) !important;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none !important;
    box-shadow: 0 10px 24px rgba(11, 110, 79, 0.3);
  }

  @media (min-width: 720px) {
    .svc-main {
      max-width: 40rem;
    }

    .svc:not(.svc--skyline) .svc-foot {
      max-width: 40rem;
    }

    .svc-hero {
      padding-top: 2rem;
    }
  }
</style>
