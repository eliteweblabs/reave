---
/**
 * Homepage hero CTAs — pinned from the top of the large viewport so the
 * pills sit in the last --home-hero-copy-h of the screen (same band as the
 * mock chat footer). `bottom` + a fake Safari-toolbar inset letterboxed the
 * hero; `top: 100lvh` + a negative margin fills the screen instead.
 * Sibling of .home-scroll — .home-hero is isolation:isolate and would trap
 * position:fixed. No rest-state transform (WebKit clips the pill glow).
 */
import { ArrowRight } from "lucide-astro";
import type { SiteContentConfig } from "../../lib/siteContent";

interface Props {
  siteContent: SiteContentConfig;
}

const { siteContent } = Astro.props;
const ctas = siteContent.homepage.ctas ?? [];
if (ctas.length === 0) return;
---

<div
  id="home-sticky-ctas"
  class="home-sticky-ctas"
  data-home-sticky-ctas
  data-hero-copy
>
  <div class="home-sticky-ctas__row">
    {
      ctas.map((cta) => (
        <a
          class:list={[
            "home-sticky-ctas__btn",
            cta.variant === "primary"
              ? "home-sticky-ctas__btn--primary"
              : "home-sticky-ctas__btn--ghost brand-btn-glass",
          ]}
          href={cta.href}
        >
          {cta.label}
          {cta.variant === "primary" && (
            <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
          )}
        </a>
      ))
    }
  </div>
</div>

<script>
  import "../../lib/homeStickyCtas.ts";
</script>

<style is:global>
  .home-sticky-ctas {
    --home-hero-copy-h: 120px;
    position: fixed;
    left: 0;
    right: 0;
    top: 100vh;
    top: 100lvh;
    bottom: auto;
    z-index: 100;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    width: min(100%, 540px);
    max-width: calc(100vw - 40px);
    height: var(--home-hero-copy-h);
    margin-inline: auto;
    margin-top: calc(-1 * var(--home-hero-copy-h));
    /*
     * No rest-state transform — WebKit clips box-shadow on a transformed
     * fixed layer (hard line under the Demo glow). Pin with top + height.
     * Padding is only for the glow; do not reserve Safari toolbar space.
     */
    padding: 20px 28px 12px;
    overflow: visible;
    box-sizing: border-box;
    text-align: center;
    pointer-events: none;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease,
      visibility 0s linear 0s;
  }

  .home-sticky-ctas.is-contact-occluding {
    transform: translateY(calc(100% + 28px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease,
      visibility 0s linear 0.55s;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-sticky-ctas {
      transition: none;
    }

    .home-sticky-ctas.is-contact-occluding {
      transform: none;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  .home-sticky-ctas :is(a, button) {
    pointer-events: auto;
  }

  .home-sticky-ctas__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }

  .home-sticky-ctas__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .home-sticky-ctas__btn--primary {
    color: #0b0512;
    background: var(--brand-gradient);
    box-shadow: 0 8px 28px rgba(192, 38, 211, 0.38);
  }

  .home-sticky-ctas__btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-sticky-ctas__btn--ghost {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: rgba(255, 255, 255, 0.12);
  }

  .home-sticky-ctas__btn--ghost:hover {
    transform: translateY(-1px);
  }
</style>
