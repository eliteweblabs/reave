---
/**
 * Homepage hero CTAs. On the features tour they live in a CSS sticky
 * track that ends at the closing row (no JS top-chasing). Without that
 * track they stay viewport-fixed and hide at #contact.
 */
import { ArrowRight } from "lucide-astro";
import { isDeploymentOwner } from "../../lib/deploymentOwner";
import type { SiteContentConfig } from "../../lib/siteContent";

interface Props {
  siteContent: SiteContentConfig;
}

const { siteContent } = Astro.props;
const ctas = siteContent.homepage.ctas ?? [];
let userId: string | null = null;
try {
  userId = Astro.locals.auth?.()?.userId ?? null;
} catch {
  userId = null;
}
const showDemoControls = Boolean(
  siteContent.homepage.showHeroDemo && userId && (await isDeploymentOwner(Astro)),
);
if (ctas.length === 0 && !showDemoControls) return;

const leadingCtas = ctas.slice(0, Math.min(1, ctas.length));
const trailingCtas = ctas.slice(1);
---

<div
  id="home-sticky-ctas"
  class="home-sticky-ctas"
  data-home-sticky-ctas
  data-hero-copy
>
  <div class="home-sticky-ctas__row">
    {
      leadingCtas.map((cta) => (
        <a
          class:list={[
            "home-sticky-ctas__btn",
            cta.variant === "primary"
              ? "home-sticky-ctas__btn--primary"
              : "home-sticky-ctas__btn--ghost brand-btn-glass",
          ]}
          href={cta.href}
        >
          {cta.label}
          {cta.variant === "primary" && (
            <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
          )}
        </a>
      ))
    }
    {
      showDemoControls && (
        <div class="home-hero-demo-controls" data-hero-demo-controls data-state="paused">
          <button type="button" class="home-hero-demo-control" data-hero-demo-play aria-label="Play demo">
            {/* IOS_ICONS.play — keep in sync with public/admin/admin-ui.js */}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"/></svg>
          </button>
          <button type="button" class="home-hero-demo-control" data-hero-demo-pause aria-label="Pause demo" hidden>
            {/* IOS_ICONS.pause — keep in sync with public/admin/admin-ui.js */}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/></svg>
          </button>
          <button type="button" class="home-hero-demo-control" data-hero-demo-next aria-label="Next demo scene">
            {/* IOS_ICONS.skip-forward — keep in sync with public/admin/admin-ui.js */}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" x2="19" y1="5" y2="19"/></svg>
          </button>
        </div>
      )
    }
    {
      trailingCtas.map((cta) => (
        <a
          class:list={[
            "home-sticky-ctas__btn",
            cta.variant === "primary"
              ? "home-sticky-ctas__btn--primary"
              : "home-sticky-ctas__btn--ghost brand-btn-glass",
          ]}
          href={cta.href}
        >
          {cta.label}
          {cta.variant === "primary" && (
            <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
          )}
        </a>
      ))
    }
  </div>
</div>

<script>
  import "../../lib/homeStickyCtas.ts";
</script>

<style is:global>
  .home-sticky-ctas {
    --home-hero-copy-h: calc(120px + env(safe-area-inset-bottom, 0px));
    --home-sticky-cta-bottom: 5px;
    --home-sticky-cta-floor: calc(
      var(--home-sticky-cta-bottom) + env(safe-area-inset-bottom, 0px) +
        var(--browser-ui-bottom, 0px)
    );
    position: fixed;
    left: 0;
    right: 0;
    bottom: var(--home-sticky-cta-floor);
    z-index: 100;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    width: fit-content;
    max-width: calc(100vw - 40px);
    margin-inline: auto;
    padding:
      10px
      max(28px, env(safe-area-inset-right, 0px))
      10px
      max(28px, env(safe-area-inset-left, 0px));
    overflow: visible;
    box-sizing: border-box;
    text-align: center;
    pointer-events: none;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease,
      visibility 0s linear 0s;
  }

  @media (min-width: 640px) {
    .home-sticky-ctas {
      --home-sticky-cta-bottom: 20px;
    }
  }

  .home-sticky-ctas.is-contact-occluding {
    transform: translateY(calc(100% + 28px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease,
      visibility 0s linear 0.55s;
  }

  /*
   * Overlap the tour and stick to the viewport bottom until the track
   * ends — the compositor owns scroll, so fast flicks stay glued.
   */
  .home-sticky-cta-track {
    display: grid;
    width: 100%;
    overflow: clip;
    /* Glow sits in the padding so overflow:clip cannot shave the Demo pill. */
    padding-bottom: 20px;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    /*
     * Bottom sticky tracks the live scrollport — the old 100dvh top parking
     * sat on the layout viewport and blocked Safari's toolbar collapse.
     */
    .home-sticky-cta-track > .home-sticky-ctas {
      bottom: var(--home-sticky-cta-floor);
      top: auto;
      align-self: end;
    }
  }

  .home-sticky-cta-track__body,
  .home-sticky-cta-track > .home-sticky-ctas {
    grid-area: 1 / 1;
  }

  .home-sticky-cta-track__body {
    min-width: 0;
    width: 100%;
  }

  .home-sticky-cta-track > .home-sticky-ctas {
    position: sticky;
    left: auto;
    right: auto;
    bottom: auto;
    top: calc(
      100vh - var(--home-sticky-cta-h, 2.75rem) - var(--home-sticky-cta-bottom) -
        env(safe-area-inset-bottom, 0px)
    );
    top: calc(
      100dvh - var(--home-sticky-cta-h, 2.75rem) - var(--home-sticky-cta-bottom) -
        env(safe-area-inset-bottom, 0px)
    );
    z-index: 100;
    align-self: start;
    justify-self: center;
    width: fit-content;
    height: max-content;
    max-width: calc(100vw - 40px);
    margin-inline: auto;
    padding: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-sticky-ctas {
      transition: none;
    }

    .home-sticky-ctas.is-contact-occluding {
      transform: none;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  .home-sticky-ctas :is(a, button) {
    pointer-events: auto;
  }

  .home-sticky-ctas__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }

  .home-sticky-ctas__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .home-sticky-ctas__btn--primary {
    color: var(--brand-on-gradient, #fff);
    -webkit-text-fill-color: var(--brand-on-gradient, #fff);
    background: var(--brand-gradient);
    box-shadow: var(--brand-gradient-shadow);
  }

  .home-sticky-ctas__btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-sticky-ctas__btn--ghost {
    color: var(--site-fg, #171717);
  }

  .home-sticky-ctas__btn--ghost:hover {
    transform: translateY(-1px);
  }

  /*
   * The chip marquee paints pills in the canvas's inverse, so a 42%-alpha
   * ghost pill washes out to mid-grey the moment it scrolls over that band.
   * Go opaque there — canvas fill is black on the dark theme, white on light,
   * either way the opposite of the chips underneath. `data-cta-over` is set
   * by homeStickyCtas.ts from any [data-cta-backdrop] band it overlaps.
   */
  .home-sticky-ctas[data-cta-over="invert"] .home-sticky-ctas__btn--ghost {
    background: var(--site-canvas, #fff);
    border-color: color-mix(in srgb, var(--site-fg) 45%, transparent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* Filled pill matches the chips exactly — ring it so it keeps an edge. */
  .home-sticky-ctas[data-cta-over="invert"] .home-sticky-ctas__btn--primary {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--brand-btn-fg, #fff) 45%, transparent),
      var(--brand-gradient-shadow);
  }

  .home-hero-demo-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.18rem;
    border-radius: 999px;
    border: 1px solid var(--demo-line, var(--site-border));
    background: var(--demo-fill, var(--site-card));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    pointer-events: auto;
  }

  .home-hero-demo-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--demo-fg, var(--site-fg));
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .home-hero-demo-control:hover {
    background: var(--demo-fill-strong, var(--site-card));
    color: var(--demo-fg, var(--site-fg));
  }

  .home-hero-demo-control:focus-visible {
    outline: 2px solid var(--demo-line, var(--site-border));
    outline-offset: 1px;
  }

  .home-hero-demo-control[hidden] {
    display: none;
  }

  /* Unused on phones and it breaks the CTA row. Keep on desktop for debug. */
  @media (max-width: 640px) {
    .home-hero-demo-controls {
      display: none;
    }
  }
</style>
