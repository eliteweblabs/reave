---
/**
 * Vapi-style dual marquee: two horizontal logo rows scrolling in opposite
 * directions. Icons come from public/logos/replaced-apps/ (same folder as the
 * /features logo wall).
 */
import { ArrowRight } from "lucide-astro";
import BrandLogoMarquee from "../BrandLogoMarquee.astro";
import { listBrandLogos } from "../../lib/brandLogos";

const logos = listBrandLogos("replaced-apps");
---

{
  logos.length > 0 && (
    <section
      id="integrations"
      class="home-integrations"
      data-home-section="integrations"
      aria-labelledby="integrations-title"
    >
      <div class="home-integrations-inner">
        <div class="home-integrations-copy">
          <p class="home-integrations-eyebrow">Replace your stack</p>
          <h2 id="integrations-title">One platform instead of dozens</h2>
          <p class="home-integrations-lead">
            Siri enabled, email triage, CRM, scheduling, billing, documents,
            file manager &amp; more...
          </p>
          <a href="/pricing" class="home-integrations-cta brand-btn-glass">
            Explore the platform
            <ArrowRight size={16} strokeWidth={1.75} aria-hidden="true" />
          </a>
        </div>

        <div class="home-integrations-marquees">
          <BrandLogoMarquee folder="replaced-apps" />
        </div>
      </div>
    </section>
  )
}

<style>
  .home-integrations {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--home-section-padding-y) 0;
    overflow: hidden;
  }

  .home-integrations-inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
    max-width: 1296px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .home-integrations-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .home-integrations-eyebrow {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(254, 254, 254, 0.72);
    margin: 0;
  }

  .home-integrations-copy h2 {
    font-family: var(--font-primary);
    font-size: clamp(24px, 4vw, 40px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fefefe;
    margin: 0;
    max-width: 14ch;
  }

  .home-integrations-lead {
    font-family: var(--font-content);
    font-size: 15px;
    line-height: 1.65;
    color: rgba(254, 254, 254, 0.58);
    margin: 0;
    max-width: 42ch;
  }

  .home-integrations-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease;
  }

  .home-integrations-cta:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-integrations-marquees {
    position: relative;
    min-width: 0;
    flex: 1;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  @media (min-width: 768px) {
    .home-integrations-inner {
      padding: 0 32px;
    }

    .home-integrations-eyebrow {
      font-size: 13px;
      letter-spacing: 0.14em;
    }
  }

  @media (min-width: 1280px) {
    .home-integrations-inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 48px;
      padding: 0 72px;
    }

    .home-integrations-copy {
      flex-shrink: 0;
      width: 240px;
    }

    .home-integrations-marquees {
      width: auto;
      max-width: none;
      margin-left: 0;
      margin-right: -24px;
      flex: 1;
    }
  }
</style>
