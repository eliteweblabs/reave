---
/**
 * Vapi-style dual marquee: two horizontal logo rows scrolling in opposite
 * directions. Icons come from public/logos/replaced-apps/ (same folder as the
 * hero particle cloud and /features logo wall).
 */
import { ArrowRight } from "lucide-astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import { listBrandLogos, type BrandLogo } from "../../lib/brandLogos";

const company = await getCompanyConfig(Astro.request);
const logos = listBrandLogos("replaced-apps");

const midpoint = Math.ceil(logos.length / 2);
const topRow = logos.slice(0, midpoint);
const bottomRow = logos.slice(midpoint);

/** Duplicate each row so -50% translate loops seamlessly. */
function loopRow(row: BrandLogo[]): BrandLogo[] {
  return row.length > 0 ? [...row, ...row] : [];
}

const topLoop = loopRow(topRow);
const bottomLoop = loopRow(bottomRow);
---

{
  logos.length > 0 && (
    <section
      id="integrations"
      class="home-integrations"
      data-home-section="integrations"
      aria-labelledby="integrations-title"
    >
      <div class="home-integrations-inner">
        <div class="home-integrations-copy">
          <p class="home-integrations-eyebrow">Replace your stack</p>
          <h2 id="integrations-title">One platform instead of dozens</h2>
          <p class="home-integrations-lead">
            {company.name} consolidates the SaaS tools your business runs on — email,
            CRM, scheduling, billing, documents, and more — into one tailored system.
          </p>
          <a href="/features" class="home-integrations-cta">
            Explore the platform
            <ArrowRight size={16} strokeWidth={1.75} aria-hidden="true" />
          </a>
        </div>

        <div class="home-integrations-marquees" aria-hidden="true">
          {
            topLoop.length > 0 && (
              <div
                class="integrations-scroller"
                style="--marquee-direction: normal; --marquee-duration: 80s;"
              >
                <ul class="integrations-marquee-track">
                  {topLoop.map((logo) => (
                    <li class="integrations-tile">
                      <img
                        src={logo.src}
                        alt=""
                        width="40"
                        height="40"
                        loading="lazy"
                        decoding="async"
                      />
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            bottomLoop.length > 0 && (
              <div
                class="integrations-scroller"
                style="--marquee-direction: reverse; --marquee-duration: 80s;"
              >
                <ul class="integrations-marquee-track">
                  {bottomLoop.map((logo) => (
                    <li class="integrations-tile">
                      <img
                        src={logo.src}
                        alt=""
                        width="40"
                        height="40"
                        loading="lazy"
                        decoding="async"
                      />
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          <div class="integrations-fade integrations-fade--left" />
          <div class="integrations-fade integrations-fade--right" />
        </div>
      </div>
    </section>
  )
}

<style>
  .home-integrations {
    position: relative;
    z-index: 1;
    width: 100%;
    background: #000;
    padding: 40px 0;
    overflow: hidden;
  }

  .home-integrations-inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
    max-width: 1296px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .home-integrations-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .home-integrations-eyebrow {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(254, 254, 254, 0.72);
    margin: 0;
  }

  .home-integrations-copy h2 {
    font-family: var(--font-primary);
    font-size: clamp(24px, 4vw, 40px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fefefe;
    margin: 0;
    max-width: 14ch;
  }

  .home-integrations-lead {
    font-family: var(--font-content);
    font-size: 15px;
    line-height: 1.65;
    color: rgba(254, 254, 254, 0.58);
    margin: 0;
    max-width: 42ch;
  }

  .home-integrations-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    align-self: flex-start;
    padding: 4px 8px;
    border-radius: 4px;
    border: 0.5px solid rgba(254, 254, 254, 0.85);
    font-family: var(--font-primary);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #fefefe;
    text-decoration: none;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .home-integrations-cta:hover {
    background: rgba(254, 254, 254, 0.06);
    border-color: #fefefe;
    text-decoration: none;
  }

  .home-integrations-marquees {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    flex: 1;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .integrations-scroller {
    overflow: hidden;
    width: 100%;
  }

  .integrations-marquee-track {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 16px;
    width: max-content;
    min-width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: integrations-marquee var(--marquee-duration, 80s) linear infinite;
    animation-direction: var(--marquee-direction, normal);
    will-change: transform;
  }

  @keyframes integrations-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .integrations-tile {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border: 1px solid rgba(120, 144, 140, 0.5);
    background: rgba(255, 255, 255, 0.02);
  }

  .integrations-tile img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    opacity: 0.92;
  }

  .integrations-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: min(128px, 18vw);
    pointer-events: none;
    z-index: 2;
  }

  .integrations-fade--left {
    left: 0;
    background: linear-gradient(to right, #000 0%, transparent 100%);
  }

  .integrations-fade--right {
    right: 0;
    background: linear-gradient(to left, #000 0%, transparent 100%);
  }

  @media (min-width: 768px) {
    .home-integrations {
      padding: 56px 0;
    }

    .home-integrations-inner {
      padding: 0 32px;
    }

    .home-integrations-eyebrow {
      font-size: 13px;
      letter-spacing: 0.14em;
    }
  }

  @media (min-width: 1280px) {
    .home-integrations {
      padding: 80px 0;
    }

    .home-integrations-inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 48px;
      padding: 0 72px;
    }

    .home-integrations-copy {
      flex-shrink: 0;
      width: 240px;
    }

    .home-integrations-marquees {
      width: auto;
      max-width: none;
      margin-left: 0;
      margin-right: -24px;
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .integrations-marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
      gap: 12px;
    }

    .integrations-scroller {
      overflow: visible;
    }

    .integrations-fade {
      display: none;
    }
  }
</style>
