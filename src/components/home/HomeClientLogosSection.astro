---
/**
 * Homepage "worked with" logo wall — same reels as /about, sitting under the
 * feature chips. Renders nothing when the install has no client logos configured.
 */
import ClientLogos from "../ClientLogos.astro";
import { getSiteContent } from "../../lib/siteContent";

const hasLogos = (getSiteContent().clientLogos?.length ?? 0) > 0;
---

{
  hasLogos && (
    <section class="home-client-logos" aria-labelledby="home-client-logos-title">
      <header class="home-client-logos-copy scroll-fade-in">
        <h2 class="home-client-logos-title" id="home-client-logos-title">
          Current &amp; past company
        </h2>
      </header>

      {/*
        Reels stay out of the fade: an infinite translateY + mask-image inside
        a view() subject stalls the next section's fade-in (iOS especially).
      */}
      <div class="home-client-logos-grid" data-no-scroll-fade>
        <ClientLogos />
      </div>
    </section>
  )
}

<style>
  .home-client-logos {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 100%;
    padding: 0 20px var(--home-section-padding-y);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .home-client-logos-copy {
    width: 100%;
    max-width: 760px;
    text-align: center;
    margin-bottom: 20px;
  }

  .home-client-logos-title {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--site-fg-muted, #525252);
  }

  .home-client-logos-grid {
    width: 100%;
    max-width: 1100px;
  }
</style>
