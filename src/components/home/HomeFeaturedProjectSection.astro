---
import { ArrowRight } from "lucide-astro";
import { getSiteContent } from "../../lib/siteContent";

const featured = (getSiteContent().portfolio ?? []).find((item) => item.featured);
---

{
  featured && (
    <section
      id="featured"
      class="home-featured"
      data-home-section="featured"
      aria-labelledby="featured-title"
    >
      <div class="home-featured-inner">
        <p class="marketing-label">Featured Project</p>
        <div class="home-featured-layout">
          <a class="home-featured-visual" href="/about#portfolio">
            <img
              src={featured.image}
              alt={featured.imageAlt}
              width="1600"
              height="1867"
              loading="lazy"
              decoding="async"
              style={featured.imagePosition ? `--image-position: ${featured.imagePosition}` : undefined}
            />
          </a>
          <div class="home-featured-copy">
            <h2 id="featured-title">{featured.title}</h2>
            <p class="home-featured-lead">{featured.description}</p>
            {
              featured.tags.length > 0 && (
                <ul class="home-featured-tags" aria-label="Tags">
                  {featured.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )
            }
            <a href="/about#portfolio" class="home-featured-cta brand-btn-glass">
              See the portfolio
              <ArrowRight size={16} strokeWidth={1.75} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .home-featured {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--home-section-padding-y) 24px;
    scroll-margin-top: calc(
      var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) + 8px
    );
  }

  .home-featured-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .home-featured-layout {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .home-featured-visual {
    display: block;
    border-radius: 14px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    text-decoration: none;
  }

  .home-featured-visual img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: var(--image-position, center);
    filter: none;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-featured-copy h2 {
    font-family: var(--font-primary);
    font-size: clamp(28px, 4.4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--site-fg, #171717);
    margin: 0 0 14px;
  }

  .home-featured-lead {
    font-family: var(--font-content);
    font-size: 15px;
    line-height: 1.65;
    color: var(--site-fg-muted, #525252);
    margin: 0 0 18px;
    max-width: 46ch;
  }

  .home-featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
  }

  .home-featured-tags li {
    font-family: var(--font-primary);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--site-fg, #171717);
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid var(--site-border, rgba(23, 23, 23, 0.16));
    background: var(--site-card, rgba(23, 23, 23, 0.04));
    line-height: 1.2;
  }

  .home-featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease;
  }

  .home-featured-cta:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .home-featured-visual:hover img,
    .home-featured-visual:focus-visible img {
      transform: scale(1.03);
    }
  }

  @media (min-width: 860px) {
    .home-featured-layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
      gap: 48px;
    }
  }

  @media (max-width: 768px) {
    .home-featured {
      padding-left: 18px;
      padding-right: 18px;
    }
  }
</style>
