---
import { ArrowRight } from "lucide-astro";
import { getSiteContent } from "../../lib/siteContent";

const featured = (getSiteContent().portfolio ?? []).find((item) => item.featured);
const slides = featured
  ? [
      {
        image: featured.image,
        imageAlt: featured.imageAlt,
        imagePosition: featured.imagePosition,
      },
      ...(featured.alternateImages ?? []),
    ].filter((slide) => slide.image)
  : [];
---

{
  featured && (
    <section
      id="featured"
      class="home-featured"
      data-home-section="featured"
      aria-labelledby="featured-title"
    >
      <div class="home-featured-inner">
        <p class="marketing-label">Featured Project</p>
        <div class="home-featured-layout">
          <a
            class="home-featured-visual"
            href="/about#portfolio"
            data-featured-fade={slides.length > 1 ? "" : undefined}
          >
            {slides.map((slide, index) => (
              <img
                src={slide.image}
                alt={index === 0 ? slide.imageAlt : ""}
                width="1600"
                height="1867"
                loading="lazy"
                decoding="async"
                class:list={[{ "is-active": index === 0 }]}
                aria-hidden={index === 0 ? undefined : "true"}
                style={slide.imagePosition ? `--image-position: ${slide.imagePosition}` : undefined}
              />
            ))}
          </a>
          <div class="home-featured-copy">
            <h2 id="featured-title">{featured.title}</h2>
            <p class="home-featured-lead">{featured.description}</p>
            {
              featured.tags.length > 0 && (
                <ul class="home-featured-tags" aria-label="Tags">
                  {featured.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )
            }
            <a href="/about#portfolio" class="home-featured-cta brand-btn-glass">
              See the portfolio
              <ArrowRight size={16} strokeWidth={1.75} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .home-featured {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--home-section-padding-y) 24px;
    scroll-margin-top: calc(
      var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) + 8px
    );
  }

  .home-featured-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .home-featured-layout {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .home-featured-visual {
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    text-decoration: none;
  }

  .home-featured-visual img {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--image-position, center);
    filter: none;
    opacity: 0;
    transition:
      opacity 1.2s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-featured-visual img.is-active {
    opacity: 1;
  }

  .home-featured-copy h2 {
    font-family: var(--font-primary);
    font-size: clamp(28px, 4.4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--site-fg, #171717);
    margin: 0 0 14px;
  }

  .home-featured-lead {
    font-family: var(--font-content);
    font-size: 15px;
    line-height: 1.65;
    color: var(--site-fg-muted, #525252);
    margin: 0 0 18px;
    max-width: 46ch;
  }

  .home-featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
  }

  .home-featured-tags li {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-primary);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: lowercase;
    color: #111;
    -webkit-text-fill-color: #111;
    height: 1.8em;
    padding: 0 0.8em;
    border-radius: 999px;
    border: 1px solid #fff;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(23, 23, 23, 0.12);
    line-height: 1;
  }

  .home-featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease;
  }

  .home-featured-cta:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .home-featured-visual:hover img,
    .home-featured-visual:focus-visible img {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-featured-visual img {
      transition: none;
    }
  }

  @media (min-width: 860px) {
    .home-featured-layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
      gap: 48px;
    }
  }

  @media (max-width: 768px) {
    .home-featured {
      padding-left: 18px;
      padding-right: 18px;
    }
  }
</style>

{
  slides.length > 1 && (
    <script>
      const root = document.querySelector("[data-featured-fade]");
      if (root instanceof HTMLElement) {
        const frames = [...root.querySelectorAll("img")];
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (frames.length > 1 && !reduceMotion) {
          let index = 0;
          window.setInterval(() => {
            frames[index]?.classList.remove("is-active");
            frames[index]?.setAttribute("aria-hidden", "true");
            index = (index + 1) % frames.length;
            frames[index]?.classList.add("is-active");
            frames[index]?.removeAttribute("aria-hidden");
          }, 5000);
        }
      }
    </script>
  )
}
