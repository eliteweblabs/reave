---
/**
 * Temporary stack of dialogue layout variants for visual comparison.
 * Remove or replace with a single chosen variant once decided.
 */
import HomeDialogueSection, { type HomeDialogueVariant } from "./HomeDialogueSection.astro";

const variants: { variant: HomeDialogueVariant; label: string; id: string }[] = [
  { variant: "chat", label: "Look A · Chat bubbles", id: "dialogue-chat" },
  { variant: "letter", label: "Look B · Letter", id: "dialogue-letter" },
  { variant: "transcript", label: "Look C · Transcript", id: "dialogue-transcript" },
  { variant: "cards", label: "Look D · Numbered cards", id: "dialogue-cards" },
  { variant: "split", label: "Look E · Split column", id: "dialogue-split" },
  { variant: "editorial", label: "Look F · Editorial pull quote", id: "dialogue-editorial" },
];
---

<div class="home-dialogue-showcase" data-home-section="dialogue-showcase">
  {
    variants.map(({ variant, label, id }) => (
      <>
        {variant !== "chat" && <hr class="home-dialogue-showcase-divider" aria-hidden="true" />}
        <HomeDialogueSection variant={variant} showcaseLabel={label} id={id} />
      </>
    ))
  }
</div>

<style>
  .home-dialogue-showcase {
    width: 100%;
  }

  .home-dialogue-showcase-divider {
    width: min(960px, calc(100% - 48px));
    margin: 0 auto;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
</style>
