---
/**
 * Vercel-style homepage hero — product-led copy over the quantum logo,
 * with a live product preview and dual CTAs.
 */
import { ArrowRight, Play } from "lucide-astro";
import QuantumLogo from "../QuantumLogo.astro";
import { getCompanyConfig, homepageHeroMask, homepageHeroLogo } from "../../lib/companyConfig";

const company = await getCompanyConfig(Astro.request);
const heroMask = homepageHeroMask(company);
const heroLogo = homepageHeroLogo(company);
---

<section
  id="home"
  class="home-hero"
  data-home-section="home"
  aria-labelledby="home-hero-title"
>
  <div class="home-hero-mesh" aria-hidden="true"></div>

  {
    heroLogo && (
      <QuantumLogo
        heroMask={heroMask ?? undefined}
        logoSrc={heroLogo}
        layout="homepage"
      />
    )
  }

  <div class="home-hero-inner">
    <div class="home-hero-copy">
      <h1 id="home-hero-title" class="home-hero-title">
        One platform for your whole business.
      </h1>
      <p class="home-hero-lead">
        CRM, inbox, billing, scheduling, and AI — wired together by default. Your
        clients get a portal on their phone. You stop paying for a dozen apps that
        never talk to each other.
      </p>
      <div class="home-hero-cta">
        <a class="home-hero-btn home-hero-btn--primary" href="/demo">
          Demo now
          <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
        </a>
        <a class="home-hero-btn home-hero-btn--ghost" href="/features#plan">
          See pricing
        </a>
      </div>
    </div>

    <a class="home-hero-preview" href="/demo" aria-label="Open the interactive demo">
      <div class="home-hero-preview-chrome">
        <span class="home-hero-preview-dot" aria-hidden="true"></span>
        <span class="home-hero-preview-dot" aria-hidden="true"></span>
        <span class="home-hero-preview-dot" aria-hidden="true"></span>
        <span class="home-hero-preview-url">{company.domain || "reave.app"}/admin</span>
      </div>
      <div class="home-hero-preview-media" aria-hidden="true">
        <div class="home-hero-preview-ui">
          <div class="home-hero-preview-sidebar"></div>
          <div class="home-hero-preview-main">
            <div class="home-hero-preview-bar"></div>
            <div class="home-hero-preview-row"></div>
            <div class="home-hero-preview-row home-hero-preview-row--short"></div>
            <div class="home-hero-preview-row"></div>
          </div>
        </div>
        <span class="home-hero-preview-play">
          <Play size={18} strokeWidth={2} aria-hidden="true" />
          Live walkthrough
        </span>
      </div>
    </a>
  </div>

  <div class="quantum-vignette" aria-hidden="true"></div>
</section>

<style>
  .home-hero {
    position: relative;
    z-index: 0;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    overflow: visible;
    scroll-margin-top: 0;
    touch-action: pan-up;
    overscroll-behavior-y: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: calc(var(--app-header-h, 3.25rem) + 32px) 20px 48px;
  }

  .home-hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 55% at 15% 20%, rgba(244, 114, 182, 0.22) 0%, transparent 62%),
      radial-gradient(ellipse 70% 50% at 85% 25%, rgba(99, 102, 241, 0.2) 0%, transparent 58%),
      radial-gradient(ellipse 90% 60% at 50% 100%, rgba(192, 38, 211, 0.14) 0%, transparent 55%);
  }

  .home-hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 920px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    text-align: center;
  }

  .home-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 720px;
  }

  .home-hero-title {
    margin: 0;
    font-family: var(--font-primary);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: #fff;
    text-wrap: balance;
  }

  .home-hero-lead {
    margin: 0;
    max-width: 560px;
    font-family: var(--font-content);
    font-size: clamp(1rem, 2.2vw, 1.12rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.68);
    text-wrap: pretty;
  }

  .home-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 4px;
  }

  .home-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .home-hero-btn--primary {
    color: #0b0512;
    background: var(--brand-gradient);
    box-shadow: 0 8px 28px rgba(192, 38, 211, 0.38);
  }

  .home-hero-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-hero-btn--ghost {
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .home-hero-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.38);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-hero-preview {
    display: block;
    width: 100%;
    max-width: 760px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(8, 8, 12, 0.72);
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .home-hero-preview:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.22);
    text-decoration: none;
  }

  .home-hero-preview-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.35);
  }

  .home-hero-preview-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .home-hero-preview-url {
    margin-left: auto;
    font-family: var(--font-secondary);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.42);
  }

  .home-hero-preview-media {
    position: relative;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(ellipse 80% 60% at 20% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 55%),
      radial-gradient(ellipse 70% 55% at 90% 20%, rgba(99, 102, 241, 0.16) 0%, transparent 50%),
      #07070a;
    overflow: hidden;
  }

  .home-hero-preview-ui {
    position: absolute;
    inset: 12% 8% 10%;
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 10px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .home-hero-preview-sidebar {
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.04) 0%,
      rgba(255, 255, 255, 0.01) 100%
    );
  }

  .home-hero-preview-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 14px 0 0;
  }

  .home-hero-preview-bar,
  .home-hero-preview-row {
    border-radius: 4px;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.03) 100%
    );
  }

  .home-hero-preview-bar {
    height: 14px;
    width: 42%;
  }

  .home-hero-preview-row {
    height: 10px;
    width: 88%;
  }

  .home-hero-preview-row--short {
    width: 62%;
  }

  .home-hero-preview-play {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    background: rgba(0, 0, 0, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
  }

  .quantum-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    overflow: hidden;
    background: radial-gradient(
      ellipse 120% 120% at center,
      transparent 42%,
      rgba(0, 0, 0, 0.28) 72%,
      rgba(0, 0, 0, 0.62) 115%
    );
  }

  @media screen and (max-width: 768px) {
    .home-hero {
      padding-top: calc(var(--app-header-h, 3.25rem) + 20px);
      padding-bottom: 32px;
    }

    .home-hero-inner {
      gap: 28px;
    }

    .quantum-vignette {
      background: radial-gradient(
        ellipse 125% 125% at center,
        transparent 48%,
        rgba(0, 0, 0, 0.24) 78%,
        rgba(0, 0, 0, 0.58) 118%
      );
    }
  }

  @media (min-width: 900px) {
    .home-hero {
      padding-bottom: 64px;
    }
  }
</style>
