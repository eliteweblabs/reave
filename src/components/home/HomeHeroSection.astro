---
/**
 * Homepage hero — brand icon, scripted demo conversation, headline, and CTAs.
 */
import { ArrowRight } from "lucide-astro";
import BrandIconInline from "../../components/BrandIconInline.astro";
import ReaveBgPattern from "../../components/ReaveBgPattern.astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import { HERO_DEMO_EXCHANGES } from "../../lib/heroDemoConversation";

const company = await getCompanyConfig(Astro.request);
const demoExchanges = HERO_DEMO_EXCHANGES;
---

<section
  id="home"
  class="home-hero"
  data-home-section="home"
  aria-labelledby="home-hero-title"
>
  <div class="home-hero-mesh" aria-hidden="true"></div>
  <ReaveBgPattern class="home-hero-pattern" fit="cover" opacity={0.085} reveal />

  <div class="home-hero-center">
    <div class="home-hero-icon-wrap">
      <BrandIconInline company={company} />
    </div>

    <div
      class="home-hero-demo"
      data-hero-demo
      data-exchanges={JSON.stringify(demoExchanges)}
      aria-live="polite"
      aria-atomic="false"
    >
      <div class="home-hero-demo-stack" data-hero-demo-stack></div>
    </div>

    <div class="home-hero-copy">
      <h1 id="home-hero-title" class="home-hero-title">Take Your Time Back</h1>
      <div class="home-hero-cta">
        <a class="home-hero-btn home-hero-btn--ghost" href="/#plan">
          See pricing
        </a>
        <a class="home-hero-btn home-hero-btn--primary" href="/demo">
          Demo now
          <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../lib/heroDemoLoop.ts";
</script>

<style>
  .home-hero {
    position: relative;
    z-index: 0;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    padding: calc(var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) + 24px) 20px 64px;
    scroll-margin-top: 0;
    overflow: hidden;
  }

  .home-hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 55% at 15% 20%, rgba(244, 114, 182, 0.2) 0%, transparent 62%),
      radial-gradient(ellipse 70% 50% at 85% 25%, rgba(99, 102, 241, 0.18) 0%, transparent 58%),
      radial-gradient(ellipse 90% 60% at 50% 100%, rgba(192, 38, 211, 0.12) 0%, transparent 55%);
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.55) 78%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.55) 78%,
      transparent 100%
    );
  }

  .home-hero-pattern {
    z-index: 1;
    mix-blend-mode: soft-light;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 62%,
      rgba(0, 0, 0, 0.45) 82%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 62%,
      rgba(0, 0, 0, 0.45) 82%,
      transparent 100%
    );
  }

  .home-hero-center {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(100%, 720px);
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 3vw, 22px);
    text-align: center;
    pointer-events: none;
  }

  .home-hero-center :is(a, button) {
    pointer-events: auto;
  }

  .home-hero-icon-wrap {
    position: relative;
    z-index: 1;
    width: clamp(180px, 35vw, 280px);
    height: clamp(180px, 35vw, 280px);
    flex-shrink: 0;
  }

  .home-hero-icon-wrap :global(svg),
  .home-hero-icon-wrap :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    filter: var(--brand-glow-filter);
  }

  .home-hero-demo {
    width: 100%;
    min-height: 4.5em;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .home-hero-demo[hidden] {
    display: none;
  }

  .home-hero-demo-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 560px;
  }

  .home-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
  }

  .home-hero-title {
    margin: 0;
    font-family: var(--font-primary);
    font-size: clamp(2.1rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #fff;
    text-wrap: balance;
  }

  .home-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 4px;
  }

  .home-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .home-hero-btn--primary {
    color: #0b0512;
    background: var(--brand-gradient);
    box-shadow: 0 8px 28px rgba(192, 38, 211, 0.38);
  }

  .home-hero-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-hero-btn--ghost {
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .home-hero-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.38);
    transform: translateY(-1px);
    text-decoration: none;
  }
</style>

<style is:global>
  .home-hero-demo-line {
    margin: 0;
    max-width: 100%;
    font-family: var(--font-content);
    font-size: clamp(0.88rem, 2.2vw, 1.05rem);
    line-height: 1.45;
    text-wrap: balance;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .home-hero-demo-line--user {
    font-family: var(--font-primary);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: #fff;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .home-hero-demo-line--slash {
    font-style: normal;
    font-weight: 600;
    font-size: clamp(0.84rem, 2vw, 0.98rem);
  }

  .home-hero-demo-line--assistant {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(0.82rem, 2vw, 0.96rem);
  }

  .home-hero-demo-line--enter {
    animation: heroDemoEnter 0.45s ease-out both;
  }

  .home-hero-demo-line--exit {
    animation: heroDemoExit 0.65s ease-in forwards;
  }

  @keyframes heroDemoEnter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroDemoExit {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-22px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-demo-line--enter,
    .home-hero-demo-line--exit {
      animation: none;
    }
  }
</style>
