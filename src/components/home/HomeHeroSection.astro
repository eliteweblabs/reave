---
/**
 * Homepage hero — fixed viewport layout: icon + headline mid-upper, chat scrolls up
 * under them, CTAs fixed to the viewport footer (slide away at Contact).
 */
import { ArrowRight } from "lucide-astro";
import BrandIconInline from "../../components/BrandIconInline.astro";
import ReaveIcon from "../../components/ReaveIconAnimated.astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import { isDeploymentOwner } from "../../lib/deploymentOwner";
import { getPublicMapboxAccessToken } from "../../lib/mapboxAccessToken";
import { getSiteContent, type SiteContentConfig } from "../../lib/siteContent";
import { HERO_DEMO_SCENES } from "../../lib/heroDemoConversation";

interface Props {
  siteContent?: SiteContentConfig;
}

const { siteContent: siteContentProp } = Astro.props;
const siteContent = siteContentProp ?? getSiteContent();
const company = await getCompanyConfig(Astro.request);
const demoScenes = HERO_DEMO_SCENES;
const homepage = siteContent.homepage;
const ctas = homepage.ctas ?? [];
const showHeroDemo = homepage.showHeroDemo === true && demoScenes.length > 0;
const userId = Astro.locals.auth()?.userId ?? null;
const showDemoControls = Boolean(userId && (await isDeploymentOwner(Astro)));
const mapboxToken = getPublicMapboxAccessToken() || "";
---

<section
  id="home"
  class="home-hero"
  data-home-section="home"
  aria-labelledby="home-hero-title"
>
  <div class="home-hero-brand" data-hero-brand>
    <div class="home-hero-icon-wrap" data-hero-icon>
      <BrandIconInline company={company} />
    </div>
    <h1 id="home-hero-title" class="home-hero-title" set:html={homepage.heroHeadlineHtml} />
  </div>

  {
    showHeroDemo && (
      <div
        class="home-hero-demo"
        data-hero-demo
        data-scenes={JSON.stringify(demoScenes)}
        data-start-scene="susie-proposal"
        data-mapbox-token={mapboxToken}
        aria-live="polite"
        aria-atomic="false"
      >
        <template id="hero-demo-agent-avatar">
          <span class="home-hero-demo-avatar home-hero-demo-avatar--agent" aria-hidden="true">
            <ReaveIcon class="home-hero-demo-avatar-icon" />
          </span>
        </template>
        <template id="hero-demo-user-avatar">
          <span class="home-hero-demo-avatar home-hero-demo-avatar--user" aria-hidden="true">
            <svg class="home-hero-demo-avatar-photo" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <linearGradient id="hero-demo-user-bg" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#64748b"/>
                  <stop offset="100%" stop-color="#334155"/>
                </linearGradient>
              </defs>
              <rect width="64" height="64" rx="32" fill="url(#hero-demo-user-bg)"/>
              <circle cx="32" cy="24" r="11" fill="#e2e8f0"/>
              <ellipse cx="32" cy="54" rx="18" ry="14" fill="#e2e8f0"/>
            </svg>
          </span>
        </template>
        <div class="home-hero-demo-viewport" data-hero-demo-viewport>
          <div class="home-hero-demo-stack" data-hero-demo-stack role="list"></div>
        </div>
      </div>
    )
  }

  {
    showHeroDemo && showDemoControls && (
      <div class="home-hero-demo-controls" data-hero-demo-controls data-state="paused">
        <button type="button" class="home-hero-demo-control" data-hero-demo-play aria-label="Play demo">
          {/* IOS_ICONS.play — keep in sync with public/admin/admin-ui.js */}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"/></svg>
        </button>
        <button type="button" class="home-hero-demo-control" data-hero-demo-pause aria-label="Pause demo" hidden>
          {/* IOS_ICONS.pause — keep in sync with public/admin/admin-ui.js */}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/></svg>
        </button>
        <button type="button" class="home-hero-demo-control" data-hero-demo-next aria-label="Next demo scene">
          {/* IOS_ICONS.skip-forward — keep in sync with public/admin/admin-ui.js */}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" x2="19" y1="5" y2="19"/></svg>
        </button>
      </div>
    )
  }

  <div id="home-hero-copy" class="home-hero-copy" data-hero-copy>
    <div class="home-hero-cta">
      {
        ctas.map((cta) => (
          <a
            class:list={[
              "home-hero-btn",
              cta.variant === "primary" ? "home-hero-btn--primary" : "home-hero-btn--ghost brand-btn-glass",
            ]}
            href={cta.href}
          >
            {cta.label}
            {cta.variant === "primary" && (
              <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
            )}
          </a>
        ))
      }
    </div>
  </div>

  {/* Reparent before paint so hero overflow cannot trap position:fixed on iOS. */}
  <script is:inline>
    (function () {
      var el = document.getElementById("home-hero-copy");
      if (el && el.parentElement !== document.body) document.body.appendChild(el);
    })();
  </script>
</section>

{
  showHeroDemo && (
    <script>
      import "../../lib/heroDemoLoop.ts";
    </script>
  )
}

<script>
  import "../../lib/homeHeroCtaPin.ts";
</script>

<style is:global>
  /*
   * CTAs live on <body> (inline reparent + homeHeroCtaPin). Keep the shell
   * positioning global so scoped Astro CSS cannot fail after the move.
   * visualViewport pin adjusts `bottom` so mobile Safari chrome does not
   * drift them from the page-load footer spot; Contact toggles
   * .is-contact-occluding to slide them out of view.
   */
  .home-hero-copy {
    position: fixed;
    top: auto;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 940;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 0 20px calc(28px + env(safe-area-inset-bottom, 0px));
    text-align: center;
    /* No fill — a opaque/translucent bg here becomes Safari’s bottom chin tint. */
    background-color: transparent;
    pointer-events: none;
    /*
     * No resting transform — iOS Safari can stop compositing position:fixed
     * at the visual viewport while a transform is present, so the CTAs drift
     * from their page-load footer spot during scroll.
     */
    transform: none;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease,
      visibility 0s linear 0s;
  }

  .home-hero-copy.is-contact-occluding {
    transform: translateY(calc(100% + 28px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease,
      visibility 0s linear 0.55s;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-copy {
      transition: none;
    }

    .home-hero-copy.is-contact-occluding {
      transform: none;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  .home-hero-copy :is(a, button) {
    pointer-events: auto;
  }
</style>

<style>
  .home-hero {
    --home-hero-copy-h: 88px;
    --home-hero-brand-bottom: 42%;
    /*
     * With the brand block centred there is no room for the chat below it, so
     * the lane runs up behind it: --rise is how far past the headline a turn
     * may travel, --fade how long the mask takes to reach full opacity under
     * it. A turn is gone by the time it clears the headline.
     */
    --home-hero-demo-rise: clamp(120px, 18vh, 190px);
    --home-hero-demo-fade: calc(var(--home-hero-demo-rise) + clamp(90px, 13vh, 140px));
    position: relative;
    z-index: 0;
    width: 100%;
    isolation: isolate;
    /*
     * Stable fold height — prefer svh so iOS URL-bar show/hide during drag
     * does not resize the hero (that was the old visualViewport --home-hero-vh pin).
     */
    min-height: 100vh;
    min-height: -webkit-fill-available;
    min-height: 100dvh;
    min-height: 100svh;
    height: 100vh;
    height: 100dvh;
    height: 100svh;
    overflow: hidden;
    scroll-margin-top: 0;
  }

  /*
   * Ambient bright pulse when the demo simulates an action-button click.
   * Sits behind headline, chat, and CTAs but covers the full hero section.
   */
  .home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(ellipse 90% 70% at 50% 40%, rgba(255, 255, 255, 0.1) 0%, transparent 62%),
      radial-gradient(ellipse 80% 55% at 15% 20%, rgba(255, 0, 255, 0.08) 0%, transparent 58%),
      radial-gradient(ellipse 70% 50% at 85% 25%, rgba(99, 102, 241, 0.08) 0%, transparent 55%),
      radial-gradient(ellipse 90% 60% at 50% 100%, rgba(192, 38, 211, 0.05) 0%, transparent 52%);
  }

  .home-hero--action-pulse::before {
    animation: heroActionPulse 1s ease-out forwards;
  }

  @keyframes heroActionPulse {
    0% {
      opacity: 0;
    }
    22% {
      opacity: 0.5;
    }
    100% {
      opacity: 0;
    }
  }

  /* Icon + headline — highest layer, dead centre of the viewport */
  .home-hero-brand {
    position: absolute;
    z-index: 10;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 2vh, 16px);
    width: min(100%, 540px);
    padding: 0 20px;
    pointer-events: none;
  }

  .home-hero-icon-wrap {
    flex: none;
    width: clamp(150px, 32vw, 240px);
    height: clamp(150px, 32vw, 240px);
    pointer-events: none;
  }

  .home-hero-icon-wrap :global(svg),
  .home-hero-icon-wrap :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    filter: var(--brand-glow-filter);
  }

  .home-hero-title {
    margin: 0;
    font-family: var(--font-primary);
    font-size: clamp(1.39rem, 3.9vw, 2.625rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: #fff;
    text-align: center;
    /* Keep the headline on one line above small screens (brand column can wrap it otherwise). */
    white-space: nowrap;
  }

  /* Forced mid-title break only on narrow screens.
     :global — class lives on set:html markup, so scoped attrs never attach. */
  .home-hero-title :global(.home-hero-title-break) {
    display: none;
  }

  @media (max-width: 640px) {
    .home-hero {
      /* Keep the chat lane tucked under the raised brand block. */
      --home-hero-brand-bottom: 32%;
    }

    /* Mid-screen feels low on phones — lift icon + title ~10% of the viewport. */
    .home-hero-brand {
      top: 40%;
    }

    .home-hero-title {
      white-space: normal;
      text-wrap: balance;
    }

    .home-hero-title :global(.home-hero-title-break) {
      display: inline;
    }
  }

  @media (max-width: 480px) {
    .home-hero-title {
      font-size: clamp(1.24rem, 5.625vw, 1.61rem);
    }
  }

  .home-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 4px;
  }

  .home-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .home-hero-btn--primary {
    color: #0b0512;
    background: var(--brand-gradient);
    box-shadow: 0 8px 28px rgba(192, 38, 211, 0.38);
  }

  .home-hero-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-hero-btn--ghost:hover {
    transform: translateY(-1px);
  }

  /* Chat — between headline and CTAs; recedes under the brand block */
  .home-hero-demo {
    position: absolute;
    z-index: 8;
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, 540px);
    padding: 0 20px;
    top: calc(var(--home-hero-brand-bottom, 42%) - var(--home-hero-demo-rise));
    bottom: calc(var(--home-hero-copy-h, 88px) + 16px);
    min-height: 140px;
    overflow: visible;
    pointer-events: none;
    /*
     * Holds near-transparent across the headline before ramping up, so turns
     * are already gone by the time they reach it rather than half-visible
     * behind it. Also clips the stack's overflow past the lane top.
     */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #0000 0,
      #0002 calc(var(--home-hero-demo-fade) * 0.45),
      #000 var(--home-hero-demo-fade)
    );
    mask-image: linear-gradient(
      to bottom,
      #0000 0,
      #0002 calc(var(--home-hero-demo-fade) * 0.45),
      #000 var(--home-hero-demo-fade)
    );
  }

  .home-hero-demo[hidden] {
    display: none;
  }

  .home-hero-demo--stopped {
    opacity: 0;
    transition: opacity 1.13s ease;
  }

  /* Admin-only testing transport — sits above the chat lane. */
  .home-hero-demo-controls {
    position: absolute;
    z-index: 12;
    left: 50%;
    bottom: calc(var(--home-hero-copy-h, 88px) + 10px);
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.22rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(10, 10, 14, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    pointer-events: auto;
  }

  .home-hero-demo-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.88);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .home-hero-demo-control:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .home-hero-demo-control:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.45);
    outline-offset: 1px;
  }

  .home-hero-demo-control[hidden] {
    display: none;
  }

  .home-hero-demo-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /*
   * Top-anchored on purpose: a single JS-owned translateY is the whole scroll
   * position (it parks the newest turn on the lane's bottom edge), so the
   * transition below animates every shift instead of only the overflow.
   */
  .home-hero-demo-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    text-align: left;
    overflow: visible;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* Scene resets jump back to the start rather than gliding in from below. */
  .home-hero-demo-stack--instant {
    transition: none;
  }
</style>

<style is:global>
  /* Scene + messages are built in JS — must be global (scoped CSS never matches). */
  .home-hero-demo-scene {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: 2px;
    opacity: 1;
    /* Duration set from JS (see --hero-scene-exit-ms / SCENE_EXIT_MS). */
    transition: opacity var(--hero-scene-exit-ms, 350ms) ease;
  }

  .home-hero-demo-scene--exit {
    opacity: 0;
    transition: opacity var(--hero-scene-exit-ms, 350ms) ease;
  }

  .home-hero-demo-msg {
    /*
     * Gutter on the side a turn is *not* coming from. A bubble that fills its
     * max width still stops short of the far edge, so the stack reads as a
     * back-and-forth instead of one column of same-width blocks.
     */
    --demo-gutter: clamp(1.5rem, 18%, 4.5rem);
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    width: 100%;
    margin: 0;
    padding: 0;
    opacity: 1;
    transform: scale(1);
    filter: blur(0px);
    transition:
      opacity 0.53s ease,
      transform 0.53s ease,
      filter 0.53s ease;
  }

  /* Safari: opacity + scale only — blur is skipped in JS and filter breaks easing. */
  .home-hero-demo--safari .home-hero-demo-msg {
    transition:
      opacity 0.53s ease,
      transform 0.53s ease;
  }

  .home-hero-demo-msg--user {
    position: relative;
    flex-direction: row;
    justify-content: flex-end;
    padding-inline-start: var(--demo-gutter);
    transform-origin: bottom right;
  }

  .home-hero-demo-msg--assistant {
    flex-direction: row;
    justify-content: flex-start;
    padding-inline-end: var(--demo-gutter);
    transform-origin: bottom left;
  }

  .home-hero-demo-avatar {
    flex: none;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(15, 15, 20, 0.85);
  }

  .home-hero-demo-avatar--agent {
    padding: 0.28rem;
    background: rgba(8, 8, 12, 0.92);
  }

  .home-hero-demo-avatar-icon {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-hero-demo-avatar-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero-demo-bubble {
    max-width: min(100%, 22rem);
    padding: 0.55rem 0.78rem;
    border-radius: 1rem;
    font-family: var(--font-content);
    font-size: clamp(0.8rem, 2vw, 0.92rem);
    line-height: 1.45;
    word-wrap: break-word;
    overflow-wrap: anywhere;
    /* Greedy wrap — pretty/balance shortens early lines and looks "halved". */
    text-wrap: wrap;
  }

  .home-hero-demo-bubble-text {
    margin: 0;
  }

  .home-hero-demo-ellipsis {
    display: inline-block;
    width: 1.15em;
    text-align: left;
    vertical-align: baseline;
  }

  .home-hero-demo-ellipsis::after {
    content: "…";
    animation: heroDemoEllipsis 1.35s steps(4, end) infinite;
  }

  @keyframes heroDemoEllipsis {
    0%, 20% { content: ""; }
    40% { content: "."; }
    60% { content: ".."; }
    80%, 100% { content: "…"; }
  }

  .home-hero-demo-msg--composing .home-hero-demo-bubble {
    min-width: 2.6rem;
    min-height: 1.45rem;
  }

  .home-hero-demo-bubble-text--cursor::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 0.95em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: rgba(255, 255, 255, 0.92);
    animation: heroDemoCursor 1.13s step-end infinite;
  }

  @keyframes heroDemoCursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .home-hero-demo-slash-picker {
    position: absolute;
    right: calc(1.85rem + 0.55rem);
    bottom: calc(100% + 10px);
    z-index: 5;
    width: min(16.5rem, calc(100vw - 3rem));
    padding: 0.28rem 0;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(12, 12, 16, 0.96);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transform-origin: bottom right;
    transition:
      opacity 0.37s ease,
      transform 0.37s ease;
    pointer-events: none;
  }

  .home-hero-demo-slash-picker--visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .home-hero-demo-slash-picker--exit {
    opacity: 0;
    transform: translateY(4px) scale(0.98);
  }

  .home-hero-demo-slash-picker-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-hero-demo-slash-option {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.38rem 0.65rem;
    font-size: 0.74rem;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background 0.15s ease;
  }

  .home-hero-demo-slash-option.active {
    background: rgba(255, 255, 255, 0.08);
  }

  .home-hero-demo-slash-option-cmd {
    flex: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
  }

  .home-hero-demo-slash-option-summary {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgba(255, 255, 255, 0.48);
  }

  .home-hero-demo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.55rem;
  }

  .home-hero-demo-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.32rem 0.62rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.9);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .home-hero-demo-action--primary {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .home-hero-demo-action--secondary {
    background: rgba(255, 255, 255, 0.06);
  }

  .home-hero-demo-action--pressed {
    transform: scale(0.96);
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.38);
  }

  /* Artifact cards — full chat width, no avatar gutter. */
  .home-hero-demo-msg--artifact {
    padding-inline: 0;
    --demo-gutter: 0;
    justify-content: stretch;
  }

  .home-hero-demo-sk-invoice {
    width: 100%;
    padding: 0.85rem 0.95rem 0.8rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    transform-origin: center center;
    opacity: 0;
    transform: scale(0.72);
  }

  .home-hero-demo-sk-invoice--pop {
    animation: heroDemoSkInvoicePop 0.7s cubic-bezier(0.22, 1.35, 0.36, 1) forwards;
  }

  .home-hero-demo-sk-invoice--settled {
    opacity: 1;
    transform: scale(1);
  }

  @keyframes heroDemoSkInvoicePop {
    0% {
      opacity: 0;
      transform: scale(0.72);
    }
    58% {
      opacity: 1;
      transform: scale(1.06);
    }
    78% {
      transform: scale(0.985);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .home-hero-demo-sk-invoice-header,
  .home-hero-demo-sk-invoice-line,
  .home-hero-demo-sk-invoice-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .home-hero-demo-sk-invoice-client {
    display: flex;
  }

  .home-hero-demo-sk-invoice-lines {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    padding: 0.4rem 0 0.12rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Collapsed until after the card pop — bones grow it and shove the footer down. */
  .home-hero-demo-sk-invoice-payments {
    border-top: 1px solid transparent;
    padding: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease,
      padding 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease;
  }

  .home-hero-demo-sk-invoice-payments--open {
    max-height: 3.5rem;
    opacity: 1;
    padding: 0.38rem 0 0.12rem;
    border-top-color: rgba(255, 255, 255, 0.1);
  }

  .home-hero-demo-sk-invoice-payment {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "label ."
      "detail amt";
    column-gap: 0.7rem;
    row-gap: 0.28rem;
    align-items: center;
  }

  .home-hero-demo-sk-invoice-footer {
    padding-top: 0.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Static bones — no continuous shimmer. */
  .home-hero-demo-sk-bone {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.16);
  }

  .home-hero-demo-sk-bone--title {
    width: 38%;
    height: 0.55rem;
  }

  .home-hero-demo-sk-bone--meta {
    width: 18%;
    height: 0.4rem;
  }

  .home-hero-demo-sk-bone--client {
    width: 48%;
    height: 0.45rem;
  }

  .home-hero-demo-sk-bone--label {
    width: 22%;
    height: 0.35rem;
  }

  .home-hero-demo-sk-bone--line {
    flex: 1 1 auto;
    height: 0.4rem;
    max-width: 68%;
  }

  .home-hero-demo-sk-bone--amt {
    flex: none;
    width: 2.1rem;
    height: 0.4rem;
  }

  .home-hero-demo-sk-bone--total {
    flex: none;
    width: 2.6rem;
    height: 0.5rem;
  }

  .home-hero-demo-sk-bone--pay-label {
    grid-area: label;
    width: 28%;
    min-width: 2.4rem;
  }

  .home-hero-demo-sk-bone--pay-detail {
    grid-area: detail;
    width: 72%;
  }

  .home-hero-demo-sk-bone--pay-amt {
    grid-area: amt;
    width: 2.1rem;
  }

  /* Payment bones start collapsed; stagger L→R via --pay-in. */
  .home-hero-demo-sk-invoice-payment [data-hero-sk-pay] {
    height: 0;
    opacity: 0;
    transform: translateX(-10px) scale(0.9);
    transition:
      height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      transform 0.36s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-hero-demo-sk-bone--pay-label.home-hero-demo-sk-bone--pay-in {
    height: 0.32rem;
    opacity: 1;
    transform: translateX(0) scale(1);
  }

  .home-hero-demo-sk-bone--pay-detail.home-hero-demo-sk-bone--pay-in,
  .home-hero-demo-sk-bone--pay-amt.home-hero-demo-sk-bone--pay-in {
    height: 0.4rem;
    opacity: 1;
    transform: translateX(0) scale(1);
  }

  .home-hero-demo-sk-bone--total-pulse {
    animation: heroDemoSkTotalPulse 0.85s ease;
  }

  @keyframes heroDemoSkTotalPulse {
    0% {
      transform: scale(1);
      background: rgba(255, 255, 255, 0.16);
      box-shadow: none;
    }
    35% {
      transform: scale(1.18);
      background: rgba(255, 255, 255, 0.34);
      box-shadow: 0 0 12px rgba(255, 255, 255, 0.22);
    }
    100% {
      transform: scale(1);
      background: rgba(255, 255, 255, 0.16);
      box-shadow: none;
    }
  }

  .home-hero-demo-sk-bone--total-pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.65) 45%,
      rgba(255, 255, 255, 0.15) 55%,
      transparent 100%
    );
    transform: translateX(-120%);
    animation: heroDemoSkTotalShine 0.85s ease;
  }

  @keyframes heroDemoSkTotalShine {
    0% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(120%);
    }
  }

  .home-hero-demo-sk-invoice--exit {
    /* Duration set from JS to half the sit hold (see --hero-sk-invoice-exit-ms). */
    animation: heroDemoSkInvoiceExit var(--hero-sk-invoice-exit-ms, 0.5s)
      cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes heroDemoSkInvoiceExit {
    0% {
      opacity: 1;
      transform: scale(1) translateX(0);
    }
    100% {
      opacity: 0;
      transform: scale(0.98) translateX(28%);
    }
  }

  /* Dashboard notification toast — same center-scale overshoot as the invoice. */
  .home-hero-demo-sk-notif {
    width: min(100%, 18.5rem);
    margin-inline: auto;
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.78rem 0.9rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
    transform-origin: center center;
    opacity: 0;
    transform: scale(0.72);
  }

  .home-hero-demo-sk-notif--pop {
    animation: heroDemoSkInvoicePop 0.7s cubic-bezier(0.22, 1.35, 0.36, 1) forwards;
  }

  .home-hero-demo-sk-notif--settled {
    opacity: 1;
    transform: scale(1);
  }

  .home-hero-demo-sk-notif-dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.28rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.1);
  }

  .home-hero-demo-sk-notif-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
  }

  .home-hero-demo-sk-notif-title,
  .home-hero-demo-sk-notif-detail {
    margin: 0;
    font-family: var(--font-primary);
    line-height: 1.25;
  }

  .home-hero-demo-sk-notif-title {
    font-size: 0.86rem;
    font-weight: 650;
    color: rgba(255, 255, 255, 0.94);
  }

  .home-hero-demo-sk-notif-detail {
    font-size: 0.74rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.55);
  }

  /* Contract card — line bones draw in, then signature strokes. */
  .home-hero-demo-sk-contract {
    width: 100%;
    padding: 0.9rem 0.95rem 0.85rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    transform-origin: center center;
    opacity: 0;
    transform: scale(0.72);
  }

  .home-hero-demo-sk-contract--pop {
    animation: heroDemoSkInvoicePop 0.7s cubic-bezier(0.22, 1.35, 0.36, 1) forwards;
  }

  .home-hero-demo-sk-contract--settled {
    opacity: 1;
    transform: scale(1);
  }

  .home-hero-demo-sk-contract-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .home-hero-demo-sk-contract-body {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    padding: 0.35rem 0 0.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .home-hero-demo-sk-contract-line {
    display: block;
    height: 0.38rem;
    width: 0;
    max-width: var(--hero-contract-line-w, 90%);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.16);
    opacity: 0;
    transition:
      width 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.28s ease;
  }

  .home-hero-demo-sk-contract-line--in {
    width: var(--hero-contract-line-w, 90%);
    opacity: 1;
  }

  .home-hero-demo-sk-contract-sign {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.45rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .home-hero-demo-sk-contract-sign-label {
    display: block;
    width: 22%;
    height: 0.32rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.14);
  }

  .home-hero-demo-sk-contract-signature {
    width: min(100%, 11.5rem);
    height: 2.4rem;
    overflow: visible;
  }

  .home-hero-demo-sk-contract-signature-path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.92);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 240;
    stroke-dashoffset: 240;
  }

  .home-hero-demo-sk-contract-signature--drawn .home-hero-demo-sk-contract-signature-path {
    animation: heroDemoSkContractSign 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes heroDemoSkContractSign {
    to {
      stroke-dashoffset: 0;
    }
  }

  .home-hero-demo-sk-contract-sign-rule {
    display: block;
    width: 58%;
    height: 1px;
    background: rgba(255, 255, 255, 0.22);
  }

  /* GPS map bubble — map bleeds edge-to-edge; chrome is just the clip + border. */
  .home-hero-demo-msg--gps {
    align-items: flex-end;
  }

  .home-hero-demo-sk-gps {
    width: min(100%, 22rem);
    padding: 0;
    border-radius: 1rem;
    border-bottom-left-radius: 0.28rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #0b0d10;
    overflow: hidden;
    transform-origin: bottom left;
    opacity: 0;
    transform: scale(0.72);
  }

  .home-hero-demo-sk-gps--pop {
    animation: heroDemoSkInvoicePop 0.7s cubic-bezier(0.22, 1.35, 0.36, 1) forwards;
  }

  .home-hero-demo-sk-gps--settled {
    opacity: 1;
    transform: none;
  }

  .home-hero-demo-sk-gps-viewport {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 9.5rem;
    max-height: 12rem;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #0b0d10;
  }

  .home-hero-demo-sk-gps-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }

  /* WebGL canvas must fill the letterbox — iOS often leaves a dead bar otherwise. */
  .home-hero-demo-sk-gps-map .mapboxgl-map,
  .home-hero-demo-sk-gps-map .mapboxgl-canvas-container,
  .home-hero-demo-sk-gps-map .mapboxgl-canvas {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  .home-hero-demo-sk-gps-map .mapboxgl-canvas {
    outline: none;
  }

  .home-hero-demo-sk-gps-map .mapboxgl-ctrl,
  .home-hero-demo-sk-gps-map .mapboxgl-ctrl-logo,
  .home-hero-demo-sk-gps-map .mapboxgl-ctrl-attrib {
    display: none !important;
  }

  /* Static Images path (iOS / GL fallback) — overview zooms, detail crossfades in. */
  .home-hero-demo-sk-gps-map--static {
    overflow: hidden;
  }

  .home-hero-demo-sk-gps-static-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero-demo-sk-gps-static-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    object-position: center;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .home-hero-demo-sk-gps-static-img--overview {
    z-index: 0;
    transform: scale(1);
    opacity: 1;
  }

  .home-hero-demo-sk-gps-static-img--detail {
    z-index: 1;
    transform: scale(1.18);
    opacity: 0;
  }

  .home-hero-demo-sk-gps-static-stage--fly .home-hero-demo-sk-gps-static-img--overview {
    animation: heroDemoSkGpsStaticOverview var(--hero-gps-fly-ms, 2.6s)
      cubic-bezier(0.22, 0.8, 0.28, 1) forwards;
  }

  .home-hero-demo-sk-gps-static-stage--fly .home-hero-demo-sk-gps-static-img--detail {
    animation: heroDemoSkGpsStaticDetail var(--hero-gps-fly-ms, 2.6s)
      cubic-bezier(0.22, 0.8, 0.28, 1) forwards;
  }

  .home-hero-demo-sk-gps-static-stage--settled .home-hero-demo-sk-gps-static-img--overview {
    opacity: 0;
    transform: scale(2.35);
  }

  .home-hero-demo-sk-gps-static-stage--settled .home-hero-demo-sk-gps-static-img--detail {
    opacity: 1;
    transform: scale(1);
  }

  @keyframes heroDemoSkGpsStaticOverview {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    55% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: scale(2.35);
    }
  }

  @keyframes heroDemoSkGpsStaticDetail {
    0%,
    42% {
      opacity: 0;
      transform: scale(1.18);
    }
    72% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Fixed in the letterbox center — not a Mapbox HTML marker. */
  .home-hero-demo-sk-gps-marker {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 3.25rem;
    height: 3.25rem;
    margin: -1.625rem 0 0 -1.625rem;
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
  }

  .home-hero-demo-sk-gps-marker--in {
    animation: heroDemoSkGpsMarkerIn 0.45s cubic-bezier(0.22, 1.35, 0.36, 1) forwards;
  }

  @keyframes heroDemoSkGpsMarkerIn {
    0% {
      opacity: 0;
      transform: scale(0.35) translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Reverse-teardrop person pin — circular face, tip on map center. */
  .home-hero-demo-sk-gps-pin {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 2.35rem;
    height: 2.9rem;
    transform: translate(-50%, -100%);
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
  }

  .home-hero-demo-sk-gps-pin::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.05rem;
    width: 0.78rem;
    height: 0.78rem;
    background: #fff;
    border-radius: 0.1rem;
    transform: translateX(-50%) rotate(45deg);
  }

  .home-hero-demo-sk-gps-pin-face {
    position: absolute;
    left: 50%;
    top: 0;
    width: 2.2rem;
    height: 2.2rem;
    margin-left: -1.1rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
    background: #94a3b8;
    border: 2px solid #fff;
    box-sizing: border-box;
    display: block;
  }

  .home-hero-demo-sk-gps-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    opacity: 0;
    transform: scale(0.35);
  }

  /* Looping radar pulse — active target. */
  .home-hero-demo-sk-gps-marker--active .home-hero-demo-sk-gps-ring {
    animation: heroDemoSkGpsRadar 2.1s ease-out infinite;
  }

  .home-hero-demo-sk-gps-marker--active .home-hero-demo-sk-gps-ring--mid {
    animation-delay: 0.7s;
  }

  .home-hero-demo-sk-gps-marker--active .home-hero-demo-sk-gps-ring--late {
    animation-delay: 1.4s;
  }

  @keyframes heroDemoSkGpsRadar {
    0% {
      opacity: 0.7;
      transform: scale(0.35);
    }
    70% {
      opacity: 0.2;
    }
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  .home-hero-demo-msg--user .home-hero-demo-bubble {
    color: rgba(255, 255, 255, 0.95);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom-right-radius: 0.28rem;
  }

  .home-hero-demo-msg--assistant .home-hero-demo-bubble {
    color: rgba(255, 255, 255, 0.88);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-left-radius: 0.28rem;
  }

  .home-hero-demo-bubble--slash {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.74rem, 1.85vw, 0.86rem);
    letter-spacing: -0.01em;
  }

  .home-hero-demo-bubble--typing {
    display: flex;
    align-items: center;
    min-height: 1.45rem;
    padding-top: 0.62rem;
    padding-bottom: 0.62rem;
  }

  .home-hero-demo-typing {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    height: 0.55rem;
  }

  .home-hero-demo-typing span {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    animation: heroDemoTyping 1.46s ease-in-out infinite;
  }

  .home-hero-demo-typing span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .home-hero-demo-typing span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes heroDemoTyping {
    0%, 60%, 100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  /*
   * `backwards`, not `both`. A filled-forwards animation outranks inline styles
   * for the whole life of the message, which silently discarded every opacity
   * the depth pass wrote — the fade never rendered at all.
   */
  .home-hero-demo-msg--enter {
    animation: heroDemoEnter 0.56s ease-out backwards;
  }

  @keyframes heroDemoEnter {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero--action-pulse::before {
      animation: none;
    }

    .home-hero-demo-msg--enter,
    .home-hero-demo-scene--exit {
      animation: none;
      transition: none;
    }

    .home-hero-demo-stack {
      transition: none;
    }

    /* Keep the user compose cursor — it's the typing affordance for the demo. */
    .home-hero-demo-slash-picker {
      transition: none;
    }

    .home-hero-demo-ellipsis::after {
      animation: none;
      content: "…";
    }

    .home-hero-demo-sk-invoice--pop,
    .home-hero-demo-sk-invoice--exit,
    .home-hero-demo-sk-bone--total-pulse,
    .home-hero-demo-sk-bone--total-pulse::after,
    .home-hero-demo-sk-notif--pop,
    .home-hero-demo-sk-contract--pop,
    .home-hero-demo-sk-contract-signature--drawn .home-hero-demo-sk-contract-signature-path,
    .home-hero-demo-sk-gps--pop,
    .home-hero-demo-sk-gps-marker--in,
    .home-hero-demo-sk-gps-marker--active .home-hero-demo-sk-gps-ring {
      animation: none;
    }

    .home-hero-demo-sk-invoice--pop,
    .home-hero-demo-sk-invoice--settled,
    .home-hero-demo-sk-notif--pop,
    .home-hero-demo-sk-notif--settled,
    .home-hero-demo-sk-contract--pop,
    .home-hero-demo-sk-contract--settled {
      opacity: 1;
      transform: scale(1);
    }

    .home-hero-demo-sk-contract-line {
      transition: none;
      width: var(--hero-contract-line-w, 90%);
      opacity: 1;
    }

    .home-hero-demo-sk-contract-signature-path {
      stroke-dashoffset: 0;
    }

    .home-hero-demo-sk-gps--pop,
    .home-hero-demo-sk-gps--settled {
      opacity: 1;
