---
/**
 * Homepage hero — brand icon, headline, and shuffling industry tagline.
 */
import { ArrowRight } from "lucide-astro";
import { BRAND_ICON_SIZES } from "../../lib/brandIconRaster";
import { brandIconUrl, getCompanyConfig } from "../../lib/companyConfig";
import { LOGO_ICON_AVATAR_PATH } from "../../lib/companyLogo";
import {
  DEFAULT_DECK_INDUSTRIES,
  listEnabledDeckIndustries,
} from "../../lib/deckIndustriesStore";

const company = await getCompanyConfig(Astro.request);
const enabled = await listEnabledDeckIndustries();
const industryLabels =
  enabled.length > 0
    ? enabled.map((i) => i.label.trim()).filter(Boolean)
    : DEFAULT_DECK_INDUSTRIES.map((i) => i.label);

const firstIndustry = industryLabels[0] ?? "your business";
const heroIconSrc =
  company.iconSource === "admin"
    ? brandIconUrl(BRAND_ICON_SIZES.png512, company.iconVersion)
    : LOGO_ICON_AVATAR_PATH;
---

<section
  id="home"
  class="home-hero"
  data-home-section="home"
  aria-labelledby="home-hero-title"
>
  <div class="home-hero-mesh" aria-hidden="true"></div>

  <div class="home-hero-inner">
    <div class="home-hero-icon-wrap" data-hero-icon>
      <img
        class="home-hero-icon"
        src={heroIconSrc}
        alt=""
        width="512"
        height="512"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <div class="home-hero-copy">
      <h1 id="home-hero-title" class="home-hero-title">Take Your Time Back</h1>
      <p class="home-hero-tagline">
        An OS for
        <span
          class="home-hero-industry"
          data-hero-industry
          data-industries={JSON.stringify(industryLabels)}
          data-interval-ms="2800"
        >
          <span class="home-hero-industry-slot" aria-live="polite">
            <span class="home-hero-industry-text" data-hero-industry-text>
              {firstIndustry}
            </span>
          </span>
        </span>
      </p>
      <div class="home-hero-cta">
        <a class="home-hero-btn home-hero-btn--primary" href="/demo">
          Demo now
          <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
        </a>
        <a class="home-hero-btn home-hero-btn--ghost" href="/features#plan">
          See pricing
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../lib/heroIndustryRotate.ts";
  import "../../lib/heroIconScroll.ts";
</script>

<style>
  .home-hero {
    position: relative;
    z-index: 0;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--app-header-h, 3.25rem) + 24px) 20px 64px;
    scroll-margin-top: 0;
    overflow: hidden;
  }

  .home-hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 55% at 15% 20%, rgba(244, 114, 182, 0.2) 0%, transparent 62%),
      radial-gradient(ellipse 70% 50% at 85% 25%, rgba(99, 102, 241, 0.18) 0%, transparent 58%),
      radial-gradient(ellipse 90% 60% at 50% 100%, rgba(192, 38, 211, 0.12) 0%, transparent 55%);
  }

  .home-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }

  .home-hero-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(72px, 14vw, 112px);
    height: clamp(72px, 14vw, 112px);
    will-change: transform, opacity;
    transform-origin: center center;
  }

  .home-hero-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 40px rgba(192, 38, 211, 0.35));
  }

  .home-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
  }

  .home-hero-title {
    margin: 0;
    font-family: var(--font-primary);
    font-size: clamp(2.1rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #fff;
    text-wrap: balance;
  }

  .home-hero-tagline {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.35em;
    font-family: var(--font-content);
    font-size: clamp(1.05rem, 2.8vw, 1.35rem);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.68);
  }

  .home-hero-industry {
    display: inline-block;
    vertical-align: baseline;
    min-width: 6ch;
    text-align: left;
  }

  .home-hero-industry-slot {
    display: inline-block;
    position: relative;
    overflow: hidden;
    vertical-align: bottom;
    min-height: 1.35em;
  }

  .home-hero-industry-text {
    display: inline-block;
    font-family: var(--font-primary);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    transition:
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.32s ease;
  }

  .home-hero-industry.is-swapping .home-hero-industry-text {
    transform: translateY(-110%);
    opacity: 0;
  }

  .home-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  .home-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .home-hero-btn--primary {
    color: #0b0512;
    background: var(--brand-gradient);
    box-shadow: 0 8px 28px rgba(192, 38, 211, 0.38);
  }

  .home-hero-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-hero-btn--ghost {
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .home-hero-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.38);
    transform: translateY(-1px);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-icon-wrap {
      will-change: auto;
    }

    .home-hero-industry-text {
      transition: none;
    }
  }
</style>
