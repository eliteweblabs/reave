---
/**
 * Homepage hero — brand icon, headline, and shuffling industry tagline.
 */
import { ArrowRight } from "lucide-astro";
import BrandIconInline from "../../components/BrandIconInline.astro";
import ReaveBgPattern from "../../components/ReaveBgPattern.astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import {
  DEFAULT_DECK_INDUSTRIES,
  listEnabledDeckIndustries,
} from "../../lib/deckIndustriesStore";

const company = await getCompanyConfig(Astro.request);
const enabled = await listEnabledDeckIndustries();
const industryLabels =
  enabled.length > 0
    ? enabled.map((i) => i.label.trim()).filter(Boolean)
    : DEFAULT_DECK_INDUSTRIES.map((i) => i.label);

const startIndex =
  industryLabels.length > 0
    ? Math.floor(Math.random() * industryLabels.length)
    : 0;
const firstIndustry = industryLabels[startIndex] ?? "your business";
---

<section
  id="home"
  class="home-hero"
  data-home-section="home"
  aria-labelledby="home-hero-title"
>
  <div class="home-hero-mesh" aria-hidden="true"></div>
  <ReaveBgPattern class="home-hero-pattern" tileSize="clamp(300px, 42vw, 512px)" opacity={0.085} />

  <div class="home-hero-inner">
    <div class="home-hero-icon-wrap" data-hero-icon>
      <div class="home-hero-icon-glow" data-hero-icon-glow aria-hidden="true"></div>
      <BrandIconInline company={company} />
    </div>

    <div class="home-hero-copy">
      <h1 id="home-hero-title" class="home-hero-title">Take Your Time Back</h1>
      <p class="home-hero-tagline">
        An OS for
        <span
          class="home-hero-industry"
          data-hero-industry
          data-industries={JSON.stringify(industryLabels)}
          data-interval-ms="2500"
        >
          <span
            class="home-hero-industry-viewport"
            data-hero-industry-viewport
            aria-live="polite"
            style={`min-width: ${firstIndustry.length}ch`}
          >
            <span
              class="home-hero-industry-layer home-hero-industry-next"
              data-hero-industry-next
              hidden
            ></span>
            <span
              class="home-hero-industry-layer home-hero-industry-current"
              data-hero-industry-current
            >
              {firstIndustry}
            </span>
          </span>
        </span>
      </p>
      <div class="home-hero-cta">
        <a class="home-hero-btn home-hero-btn--ghost" href="/features#plan">
          See pricing
        </a>
        <a class="home-hero-btn home-hero-btn--primary" href="/demo">
          Demo now
          <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../lib/heroIndustryRotate.ts";
  import "../../lib/heroIconScroll.ts";
  import "../../lib/heroIconGlow.ts";
</script>

<style>
  .home-hero {
    position: relative;
    z-index: 0;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) + 24px) 20px 64px;
    scroll-margin-top: 0;
    overflow: hidden;
  }

  .home-hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 55% at 15% 20%, rgba(244, 114, 182, 0.2) 0%, transparent 62%),
      radial-gradient(ellipse 70% 50% at 85% 25%, rgba(99, 102, 241, 0.18) 0%, transparent 58%),
      radial-gradient(ellipse 90% 60% at 50% 100%, rgba(192, 38, 211, 0.12) 0%, transparent 55%);
  }

  .home-hero-pattern {
    z-index: 1;
    mix-blend-mode: soft-light;
  }

  .home-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }

  .home-hero-icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(180px, 35vw, 280px);
    height: clamp(180px, 35vw, 280px);
    will-change: transform, opacity;
    transform-origin: center center;
    isolation: isolate;
    touch-action: manipulation;
  }

  .home-hero-icon-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    width: 118%;
    height: 118%;
    pointer-events: none;
    opacity: 0;
    transform: translate(calc(-50% + var(--glow-x, 0px)), calc(-50% + var(--glow-y, 0px)));
    transition: opacity 0.45s ease;
    background:
      radial-gradient(
        circle at 50% 50%,
        rgba(244, 114, 182, 0.72) 0%,
        rgba(217, 70, 239, 0.5) 22%,
        rgba(192, 38, 211, 0.38) 38%,
        rgba(99, 102, 241, 0.28) 58%,
        transparent 72%
      ),
      conic-gradient(
        from var(--glow-angle, 120deg) at 50% 50%,
        rgba(99, 102, 241, 0.55) 0deg,
        rgba(168, 85, 247, 0.5) 72deg,
        rgba(192, 38, 211, 0.58) 144deg,
        rgba(244, 114, 182, 0.62) 216deg,
        rgba(236, 72, 153, 0.52) 288deg,
        rgba(99, 102, 241, 0.55) 360deg
      );
    filter: blur(34px) saturate(1.35);
    will-change: transform, opacity;
  }

  .home-hero-icon-wrap--glow-active .home-hero-icon-glow {
    opacity: 0.92;
  }

  .home-hero-icon-wrap--glow-pulse .home-hero-icon-glow {
    opacity: 1;
    filter: blur(38px) saturate(1.55);
  }

  .home-hero-icon,
  .home-hero-icon-wrap :global(svg) {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 40px rgba(192, 38, 211, 0.35));
  }

  .home-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
  }

  .home-hero-title {
    margin: 0;
    font-family: var(--font-primary);
    font-size: clamp(2.1rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #fff;
    text-wrap: balance;
  }

  .home-hero-tagline {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.35em;
    font-family: var(--font-content);
    font-size: clamp(1.05rem, 2.8vw, 1.35rem);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.68);
  }

  .home-hero-industry {
    display: inline-block;
    vertical-align: baseline;
    text-align: left;
  }

  .home-hero-industry-viewport {
    position: relative;
    display: inline-block;
    vertical-align: bottom;
    height: 1.35em;
    overflow: hidden;
    background: #050505;
  }

  .home-hero-industry-layer {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    font-family: var(--font-primary);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: #fff;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .home-hero-industry-current {
    z-index: 1;
  }

  .home-hero-industry-next {
    z-index: 2;
  }

  .home-hero-industry-next[hidden],
  .home-hero-industry-current[hidden] {
    display: none;
  }

  .home-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  .home-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .home-hero-btn--primary {
    color: #0b0512;
    background: var(--brand-gradient);
    box-shadow: 0 8px 28px rgba(192, 38, 211, 0.38);
  }

  .home-hero-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-hero-btn--ghost {
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .home-hero-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.38);
    transform: translateY(-1px);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-icon-wrap {
      will-change: auto;
    }

    .home-hero-icon-glow {
      opacity: 0.45;
      transform: translate(-50%, -50%);
      filter: blur(28px) saturate(1.1);
    }
  }
</style>
