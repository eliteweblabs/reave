---
/**
 * Homepage hero — fixed viewport layout: icon + headline mid-upper, chat scrolls up
 * under them, CTAs pinned to the bottom. Nothing shifts while the demo runs.
 */
import { ArrowRight } from "lucide-astro";
import BrandIconInline from "../../components/BrandIconInline.astro";
import ReaveBgPattern from "../../components/ReaveBgPattern.astro";
import ReaveIcon from "../../components/ReaveIconAnimated.astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import { HERO_DEMO_SCENES } from "../../lib/heroDemoConversation";

const company = await getCompanyConfig(Astro.request);
const demoScenes = HERO_DEMO_SCENES;
---

<section
  id="home"
  class="home-hero"
  data-home-section="home"
  aria-labelledby="home-hero-title"
>
  <div class="home-hero-mesh" aria-hidden="true"></div>
  <ReaveBgPattern class="home-hero-pattern" fit="cover" opacity={0.085} />

  <div class="home-hero-brand" data-hero-brand>
    <div class="home-hero-icon-wrap" data-hero-icon>
      <BrandIconInline company={company} />
    </div>
    <h1 id="home-hero-title" class="home-hero-title">Small Business, <br class="home-hero-title-break" />Smaller Workday.</h1>
  </div>

  <div
    class="home-hero-demo"
    data-hero-demo
    data-scenes={JSON.stringify(demoScenes)}
    aria-live="polite"
    aria-atomic="false"
  >
    <template id="hero-demo-agent-avatar">
      <span class="home-hero-demo-avatar home-hero-demo-avatar--agent" aria-hidden="true">
        <ReaveIcon class="home-hero-demo-avatar-icon" />
      </span>
    </template>
    <template id="hero-demo-user-avatar">
      <span class="home-hero-demo-avatar home-hero-demo-avatar--user" aria-hidden="true">
        <svg class="home-hero-demo-avatar-photo" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="hero-demo-user-bg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#64748b"/>
              <stop offset="100%" stop-color="#334155"/>
            </linearGradient>
          </defs>
          <rect width="64" height="64" rx="32" fill="url(#hero-demo-user-bg)"/>
          <circle cx="32" cy="24" r="11" fill="#e2e8f0"/>
          <ellipse cx="32" cy="54" rx="18" ry="14" fill="#e2e8f0"/>
        </svg>
      </span>
    </template>
    <div class="home-hero-demo-viewport" data-hero-demo-viewport>
      <div class="home-hero-demo-stack" data-hero-demo-stack role="list"></div>
    </div>
  </div>

  <div class="home-hero-copy" data-hero-copy>
    <div class="home-hero-cta">
      <a class="home-hero-btn home-hero-btn--ghost brand-btn-glass" href="/pricing">
        See pricing
      </a>
      <a class="home-hero-btn home-hero-btn--primary" href="/demo">
        Demo now
        <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<script>
  import "../../lib/heroDemoLoop.ts";
</script>

<style>
  .home-hero {
    --home-hero-copy-h: 88px;
    --home-hero-brand-bottom: 42%;
    /*
     * With the brand block centred there is no room for the chat below it, so
     * the lane runs up behind it: --rise is how far past the headline a turn
     * may travel, --fade how long the mask takes to reach full opacity under
     * it. A turn is gone by the time it clears the headline.
     */
    --home-hero-demo-rise: clamp(120px, 18vh, 190px);
    --home-hero-demo-fade: calc(var(--home-hero-demo-rise) + clamp(90px, 13vh, 140px));
    position: relative;
    z-index: 0;
    width: 100%;
    height: 100svh;
    height: 100dvh;
    min-height: 100svh;
    overflow: hidden;
    scroll-margin-top: 0;
  }

  .home-hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 55% at 15% 20%, rgba(255, 0, 255, 0.18) 0%, transparent 62%),
      radial-gradient(ellipse 70% 50% at 85% 25%, rgba(99, 102, 241, 0.18) 0%, transparent 58%),
      radial-gradient(ellipse 90% 60% at 50% 100%, rgba(192, 38, 211, 0.12) 0%, transparent 55%);
  }

  .home-hero-pattern {
    z-index: 1;
    mix-blend-mode: soft-light;
  }

  /* Icon + headline — highest layer, dead centre of the viewport */
  .home-hero-brand {
    position: absolute;
    z-index: 10;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 2vh, 16px);
    width: min(100%, 540px);
    padding: 0 20px;
    pointer-events: none;
  }

  .home-hero-icon-wrap {
    flex: none;
    width: clamp(150px, 32vw, 240px);
    height: clamp(150px, 32vw, 240px);
    pointer-events: none;
  }

  .home-hero-icon-wrap :global(svg),
  .home-hero-icon-wrap :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    filter: var(--brand-glow-filter);
  }

  /* CTAs — pinned to viewport bottom */
  .home-hero-copy {
    position: absolute;
    z-index: 5;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 0 20px calc(28px + env(safe-area-inset-bottom, 0px));
    text-align: center;
    pointer-events: none;
  }

  .home-hero-copy :is(a, button) {
    pointer-events: auto;
  }

  .home-hero-title {
    margin: 0;
    font-family: var(--font-primary);
    font-size: clamp(1.39rem, 3.9vw, 2.625rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: rgba(255, 255, 255, 0.65);
    text-align: center;
    text-wrap: balance;
  }

  /* One line once there's room; forced break only on narrow screens. */
  .home-hero-title-break {
    display: none;
  }

  @media (max-width: 640px) {
    .home-hero-title-break {
      display: inline;
    }
  }

  @media (max-width: 480px) {
    .home-hero-title {
      font-size: clamp(1.24rem, 5.625vw, 1.61rem);
    }
  }

  .home-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 4px;
  }

  .home-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .home-hero-btn--primary {
    color: #0b0512;
    background: linear-gradient(145deg, #ff00ff 0%, #c026d3 52%, #6366f1 100%);
    box-shadow: 0 8px 28px rgba(192, 38, 211, 0.38);
  }

  .home-hero-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-hero-btn--ghost:hover {
    transform: translateY(-1px);
  }

  /* Chat — between headline and CTAs; recedes under the brand block */
  .home-hero-demo {
    position: absolute;
    z-index: 8;
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, 540px);
    padding: 0 20px;
    top: calc(var(--home-hero-brand-bottom, 42%) - var(--home-hero-demo-rise));
    bottom: calc(var(--home-hero-copy-h, 88px) + 16px);
    min-height: 140px;
    overflow: visible;
    pointer-events: none;
    /*
     * Holds near-transparent across the headline before ramping up, so turns
     * are already gone by the time they reach it rather than half-visible
     * behind it. Also clips the stack's overflow past the lane top.
     */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #0000 0,
      #0002 calc(var(--home-hero-demo-fade) * 0.45),
      #000 var(--home-hero-demo-fade)
    );
    mask-image: linear-gradient(
      to bottom,
      #0000 0,
      #0002 calc(var(--home-hero-demo-fade) * 0.45),
      #000 var(--home-hero-demo-fade)
    );
  }

  .home-hero-demo[hidden] {
    display: none;
  }

  .home-hero-demo--stopped {
    opacity: 0;
    transition: opacity 1.13s ease;
  }

  .home-hero-demo-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /*
   * Top-anchored on purpose: a single JS-owned translateY is the whole scroll
   * position (it parks the newest turn on the lane's bottom edge), so the
   * transition below animates every shift instead of only the overflow.
   */
  .home-hero-demo-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    text-align: left;
    overflow: visible;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* Scene resets jump back to the start rather than gliding in from below. */
  .home-hero-demo-stack--instant {
    transition: none;
  }
</style>

<style is:global>
  /* Scene + messages are built in JS — must be global (scoped CSS never matches). */
  .home-hero-demo-scene {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: 2px;
    transition: opacity 0.67s ease;
  }

  .home-hero-demo-scene--exit {
    opacity: 0;
    transition: opacity 0.67s ease;
  }

  .home-hero-demo-msg {
    /*
     * Gutter on the side a turn is *not* coming from. A bubble that fills its
     * max width still stops short of the far edge, so the stack reads as a
     * back-and-forth instead of one column of same-width blocks.
     */
    --demo-gutter: clamp(1.5rem, 18%, 4.5rem);
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    width: 100%;
    margin: 0;
    padding: 0;
    opacity: 1;
    transform: scale(1);
    filter: none;
    transition:
      opacity 0.53s ease,
      transform 0.53s ease,
      filter 0.53s ease;
  }

  .home-hero-demo-msg--user {
    position: relative;
    flex-direction: row;
    justify-content: flex-end;
    padding-inline-start: var(--demo-gutter);
  }

  .home-hero-demo-msg--assistant {
    flex-direction: row;
    justify-content: flex-start;
    padding-inline-end: var(--demo-gutter);
  }

  .home-hero-demo-avatar {
    flex: none;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(15, 15, 20, 0.85);
  }

  .home-hero-demo-avatar--agent {
    padding: 0.28rem;
    background: rgba(8, 8, 12, 0.92);
  }

  .home-hero-demo-avatar-icon {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-hero-demo-avatar-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero-demo-bubble {
    max-width: min(100%, 22rem);
    padding: 0.55rem 0.78rem;
    border-radius: 1rem;
    font-family: var(--font-content);
    font-size: clamp(0.8rem, 2vw, 0.92rem);
    line-height: 1.45;
    word-wrap: break-word;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .home-hero-demo-bubble-text {
    margin: 0;
  }

  .home-hero-demo-ellipsis {
    display: inline-block;
    width: 1.15em;
    text-align: left;
    vertical-align: baseline;
  }

  .home-hero-demo-ellipsis::after {
    content: "…";
    animation: heroDemoEllipsis 1.35s steps(4, end) infinite;
  }

  @keyframes heroDemoEllipsis {
    0%, 20% { content: ""; }
    40% { content: "."; }
    60% { content: ".."; }
    80%, 100% { content: "…"; }
  }

  .home-hero-demo-msg--composing .home-hero-demo-bubble {
    min-width: 2.6rem;
    min-height: 1.45rem;
  }

  .home-hero-demo-bubble-text--cursor::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 0.95em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: rgba(255, 255, 255, 0.92);
    animation: heroDemoCursor 1.13s step-end infinite;
  }

  @keyframes heroDemoCursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .home-hero-demo-slash-picker {
    position: absolute;
    right: calc(1.85rem + 0.55rem);
    bottom: calc(100% + 10px);
    z-index: 5;
    width: min(16.5rem, calc(100vw - 3rem));
    padding: 0.28rem 0;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(12, 12, 16, 0.96);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transform-origin: bottom right;
    transition:
      opacity 0.37s ease,
      transform 0.37s ease;
    pointer-events: none;
  }

  .home-hero-demo-slash-picker--visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .home-hero-demo-slash-picker--exit {
    opacity: 0;
    transform: translateY(4px) scale(0.98);
  }

  .home-hero-demo-slash-picker-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-hero-demo-slash-option {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.38rem 0.65rem;
    font-size: 0.74rem;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background 0.15s ease;
  }

  .home-hero-demo-slash-option.active {
    background: rgba(255, 255, 255, 0.08);
  }

  .home-hero-demo-slash-option-cmd {
    flex: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
  }

  .home-hero-demo-slash-option-summary {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgba(255, 255, 255, 0.48);
  }

  .home-hero-demo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.55rem;
  }

  .home-hero-demo-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.32rem 0.62rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.9);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .home-hero-demo-action--primary {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .home-hero-demo-action--secondary {
    background: rgba(255, 255, 255, 0.06);
  }

  .home-hero-demo-action--pressed {
    transform: scale(0.96);
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.38);
  }

  .home-hero-demo-msg--user .home-hero-demo-bubble {
    color: rgba(255, 255, 255, 0.95);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom-right-radius: 0.28rem;
  }

  .home-hero-demo-msg--assistant .home-hero-demo-bubble {
    color: rgba(255, 255, 255, 0.88);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-left-radius: 0.28rem;
  }

  .home-hero-demo-bubble--slash {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.74rem, 1.85vw, 0.86rem);
    letter-spacing: -0.01em;
  }

  .home-hero-demo-bubble--typing {
    display: flex;
    align-items: center;
    min-height: 1.45rem;
    padding-top: 0.62rem;
    padding-bottom: 0.62rem;
  }

  .home-hero-demo-typing {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    height: 0.55rem;
  }

  .home-hero-demo-typing span {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    animation: heroDemoTyping 1.46s ease-in-out infinite;
  }

  .home-hero-demo-typing span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .home-hero-demo-typing span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes heroDemoTyping {
    0%, 60%, 100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  /*
   * `backwards`, not `both`. A filled-forwards animation outranks inline styles
   * for the whole life of the message, which silently discarded every opacity
   * the depth pass wrote — the fade never rendered at all.
   */
  .home-hero-demo-msg--enter {
    animation: heroDemoEnter 0.56s ease-out backwards;
  }

  @keyframes heroDemoEnter {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-demo-msg--enter,
    .home-hero-demo-scene--exit {
      animation: none;
      transition: none;
    }

    .home-hero-demo-stack {
      transition: none;
    }

    /* Keep the user compose cursor — it's the typing affordance for the demo. */
    .home-hero-demo-slash-picker {
      transition: none;
    }

    .home-hero-demo-ellipsis::after {
      animation: none;
      content: "…";
    }
  }
</style>
