---
/**
 * Homepage hero — icon + headline centered, chat scrolls up under them.
 * Homepage CTAs sit in the sticky track beside this section — not inside
 * it, because isolation:isolate would trap position:fixed.
 */
import BrandIconInline from "../../components/BrandIconInline.astro";
import BrandIconLockup from "../../components/BrandIconLockup.astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import { getPublicMapboxAccessToken } from "../../lib/mapboxAccessToken";
import { getSiteContent, type SiteContentConfig } from "../../lib/siteContent";
import { siteMediaSrc } from "../../lib/siteMedia";
import { HERO_DEMO_SCENES } from "../../lib/heroDemoConversation";

interface Props {
  siteContent?: SiteContentConfig;
}

const { siteContent: siteContentProp } = Astro.props;
const siteContent = siteContentProp ?? getSiteContent();
const company = await getCompanyConfig(Astro.request);
const avatarOverrides = siteContent.homepage.heroDemoAvatars ?? {};
const demoScenes = HERO_DEMO_SCENES.map((scene) => ({
  ...scene,
  userAvatar: avatarOverrides[scene.id] || siteMediaSrc(scene.userAvatar) || undefined,
  pinAvatar: siteMediaSrc(scene.pinAvatar) || undefined,
}));
const homepage = siteContent.homepage;
const showHeroDemo = homepage.showHeroDemo === true && demoScenes.length > 0;
const showHeroCtas = (homepage.ctas?.length ?? 0) > 0;
const mapboxToken = getPublicMapboxAccessToken() || "";
---

<section
  id="home"
  class="home-hero"
  data-home-section="home"
  aria-labelledby="home-hero-title"
>
  <div class="home-hero-brand" data-hero-brand>
    <BrandIconLockup company={company} variant="hero" idPrefix="hero-icon" />
    <h1 id="home-hero-title" class="home-hero-title" set:html={homepage.heroHeadlineHtml} />
  </div>

  {
    showHeroDemo && (
      <div
        class="home-hero-demo"
        data-hero-demo
        data-scenes={JSON.stringify(demoScenes)}
        data-mapbox-token={mapboxToken}
        aria-live="polite"
        aria-atomic="false"
      >
        <template id="hero-demo-agent-avatar">
          <span class="home-hero-demo-avatar home-hero-demo-avatar--agent" aria-hidden="true">
            <BrandIconInline
              company={company}
              class="home-hero-demo-avatar-icon"
              idPrefix="hero-demo-agent"
            />
          </span>
        </template>
        <template id="hero-demo-user-avatar">
          <span class="home-hero-demo-avatar home-hero-demo-avatar--user" aria-hidden="true">
            <svg class="home-hero-demo-avatar-photo" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <linearGradient id="hero-demo-user-bg" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#64748b"/>
                  <stop offset="100%" stop-color="#334155"/>
                </linearGradient>
              </defs>
              <rect width="64" height="64" rx="32" fill="url(#hero-demo-user-bg)"/>
              <circle cx="32" cy="24" r="11" fill="#e2e8f0"/>
              <ellipse cx="32" cy="54" rx="18" ry="14" fill="#e2e8f0"/>
            </svg>
          </span>
        </template>
        {/* Zero-width probe: its bottom edge is where the lane mask reaches full
            opacity. Measuring it beats re-deriving the gradient in JS, which
            cannot resolve dvh/clamp from a custom property. */}
        <div class="home-hero-demo-fade-probe" data-hero-demo-fade-probe aria-hidden="true" />
        <div class="home-hero-demo-viewport" data-hero-demo-viewport>
          <div class="home-hero-demo-stack" data-hero-demo-stack role="list"></div>
        </div>
        {showHeroCtas && <div class="home-sticky-ctas-spacer" aria-hidden="true" />}
      </div>
    )
  }
</section>

{
  showHeroDemo && (
    <script>
      import "../../lib/heroDemoLoop.ts";
    </script>
  )
}

<style>
  .home-hero {
    --home-hero-copy-h: calc(120px + env(safe-area-inset-bottom, 0px));
    --home-sticky-cta-bottom: 5px;
    --home-hero-brand-bottom: 42%;
    --home-hero-icon-size: clamp(190px, 42vw, 312px);
    --home-hero-icon-pad: 1.25rem; /* ~20px at 16px root */
    /*
     * Pasted mark SVGs are 512². Letterforms sit inside ~26.9% empty box
     * above and ~28.5% below. Collapse both so the brand row hugs the ink —
     * otherwise flex-centering the square canvas leaves the visible lockup
     * ~85px below the midline.
     */
    --home-hero-icon-ink-above: 0.269;
    --home-hero-icon-ink-below: 0.285;
    /*
     * With the brand block centred there is no room for the chat below it, so
     * the lane runs up behind it: --rise is how far past the headline a turn
     * may travel, --fade how long the mask takes to reach full opacity under
     * it. A turn is gone by the time it clears the headline.
     */
    /*
     * dvh, not vh: `vh` resolves against the *large* viewport (URL bar
     * retracted), while the hero itself is sized in dvh. On iOS that mismatch
     * made the ramp longer than the box it fades inside, so the lane was still
     * washing out well below where it does on desktop.
     */
    --home-hero-demo-rise: clamp(120px, 18vh, 190px);
    --home-hero-demo-rise: clamp(120px, 18dvh, 190px);
    /* Distance past the brand block before the lane is fully opaque. */
    --home-hero-demo-fade-run: clamp(90px, 13vh, 140px);
    --home-hero-demo-fade-run: clamp(90px, 13dvh, 140px);
    --home-hero-demo-fade: calc(var(--home-hero-demo-rise) + var(--home-hero-demo-fade-run));
    position: relative;
    z-index: 0;
    width: 100%;
    max-width: 100%;
    isolation: isolate;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    /* Center the lockup between the fixed header and the CTA dock. */
    padding-top: var(--app-header-offset, 3.25rem);
    padding-bottom: calc(80px + env(safe-area-inset-bottom, 0px));
    overflow: hidden;
    scroll-margin-top: 0;
  }

  /* Icon + headline — visual lockup center = canvas center below the header */
  .home-hero-brand {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    width: min(100%, 540px);
    padding: 0 20px;
    pointer-events: none;
  }

  .home-hero-title {
    position: relative;
    z-index: 1;
    /* Tuck into empty SVG canvas; leave the 20px pad under the ink. */
    margin: calc(var(--home-hero-icon-size) * var(--home-hero-icon-ink-below) * -1) 0 0;
    font-family: var(--font-primary);
    font-size: clamp(1.39rem, 3.9vw, 2.625rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--site-fg, #171717);
    text-align: center;
    /* Keep the headline on one line above small screens (brand column can wrap it otherwise). */
    white-space: nowrap;
    -webkit-user-select: none;
    user-select: none;
  }

  /* Forced mid-title break only on narrow screens.
     :global — class lives on set:html markup, so scoped attrs never attach. */
  .home-hero-title :global(.home-hero-title-break) {
    display: none;
  }

  @media (min-width: 640px) {
    .home-hero {
      --home-sticky-cta-bottom: 20px;
    }
  }

  @media (max-width: 640px) {
    .home-hero {
      /* Keep the chat lane tucked under the raised brand block. */
      --home-hero-brand-bottom: 32%;
      /*
       * Phones give the lane ~260px under the brand block. A 90px ramp spent a
       * third of that fading, which is what left the top half of an open
       * slash/mention picker washed out. Shorter ramp, same intent.
       */
      --home-hero-demo-fade-run: clamp(56px, 9dvh, 96px);
    }

    .home-hero-title {
      white-space: normal;
      text-wrap: balance;
    }

    .home-hero-title :global(.home-hero-title-break) {
      display: inline;
    }
  }

  @media (max-width: 480px) {
    .home-hero-title {
      font-size: clamp(1.24rem, 5.625vw, 1.61rem);
    }
  }

  /* Chat column — viewport stack + CTAs as siblings; recedes under the brand block */
  .home-hero-demo {
    /* Keep in sync with BrandIconLockup.astro `.home-hero-mark` — artifact cards share this bloom. */
    --home-hero-mark-spectrum:
      radial-gradient(120% 90% at 12% 82%, #ff2d6f 0%, transparent 58%),
      radial-gradient(95% 110% at 86% 18%, #4b6bff 0%, transparent 52%),
      radial-gradient(80% 70% at 48% 46%, #34ff9b 0%, #00e0ff 38%, #ff8a00 72%, #ffe600 100%);
    --hero-sk-shadow:
      0 8px 22px -8px color-mix(in srgb, #ff2d6f 28%, transparent),
      0 0 18px color-mix(in srgb, #4b6bff 20%, transparent),
      0 0 14px color-mix(in srgb, #34ff9b 16%, transparent);
    position: absolute;
    z-index: 8;
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, 540px);
    padding: 0 20px;
    top: calc(var(--home-hero-brand-bottom, 42%) - var(--home-hero-demo-rise));
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 140px;
    overflow: visible;
    pointer-events: none;
    /*
     * Holds near-transparent across the headline before ramping up, so turns
     * are already gone by the time they reach it rather than half-visible
     * behind it. Also clips the stack's overflow past the lane top.
     */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #0000 0,
      #0002 calc(var(--home-hero-demo-fade) * 0.45),
      #000 var(--home-hero-demo-fade)
    );
    mask-image: linear-gradient(
      to bottom,
      #0000 0,
      #0002 calc(var(--home-hero-demo-fade) * 0.45),
      #000 var(--home-hero-demo-fade)
    );
  }

  html[data-theme="dark"] .home-hero-demo {
    --hero-sk-shadow:
      0 8px 24px -8px color-mix(in srgb, #ff2d6f 42%, transparent),
      0 0 22px color-mix(in srgb, #4b6bff 30%, transparent),
      0 0 16px color-mix(in srgb, #34ff9b 24%, transparent);
  }

  .home-hero-demo[hidden] {
    display: none;
  }

  .home-hero-demo--stopped {
    opacity: 0;
    transition: opacity 1.13s ease;
  }

  /* Out of flow and never painted — exists only to be measured. */
  .home-hero-demo-fade-probe {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: var(--home-hero-demo-fade);
    visibility: hidden;
    pointer-events: none;
  }

  .home-hero-demo-viewport {
    position: relative;
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    overflow: visible;
  }

  /* Reserve the CTA band in the chat column — buttons are viewport-fixed.
     Extra inset matches --home-sticky-cta-bottom above the 5px phones keep. */
  .home-sticky-ctas-spacer {
    flex: none;
    width: 100%;
    height: calc(
      var(--home-hero-copy-h, 88px) + var(--home-sticky-cta-bottom, 5px) - 5px
    );
    min-height: calc(
      var(--home-hero-copy-h, 88px) + var(--home-sticky-cta-bottom, 5px) - 5px
    );
    pointer-events: none;
  }

  /*
   * Top-anchored on purpose: a single JS-owned translateY is the whole scroll
   * position (it parks the newest turn on the lane's bottom edge), so the
   * transition below animates every shift instead of only the overflow.
   */
  .home-hero-demo-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    text-align: left;
    overflow: visible;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* Scene resets jump back to the start rather than gliding in from below. */
  .home-hero-demo-stack--instant {
    transition: none;
  }
</style>

<style is:global>
  /* Scene + messages are built in JS — must be global (scoped CSS never matches). */
  .home-hero-demo-scene {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: 8px;
  }

  /* Marker only — per-message opacity is ticked in heroDemoLoop.ts (iOS-safe). */
  .home-hero-demo-scene--exit {
    pointer-events: none;
  }

  .home-hero-demo-msg {
    /*
     * Gutter on the side a turn is *not* coming from. A bubble that fills its
     * max width still stops short of the far edge, so the stack reads as a
     * back-and-forth instead of one column of same-width blocks.
     */
    --demo-gutter: clamp(1.5rem, 18%, 4.5rem);
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    width: 100%;
    margin: 0;
    padding: 0;
    opacity: 1;
    transform: scale(1);
    filter: blur(0px);
    transition:
      opacity 0.53s ease,
      transform 0.53s ease,
      filter 0.53s ease;
  }

  /*
   * WebKit: opacity + scale only. The depth pass never writes a blur here, so
   * `filter` would sit at a permanent `blur(0px)` — enough to promote every
   * bubble to its own layer inside the lane's mask, which is where iOS stops
   * repainting incremental opacity changes.
   */
  .home-hero-demo--webkit .home-hero-demo-msg {
    filter: none;
    transition:
      opacity 0.53s ease,
      transform 0.53s ease;
  }

  /*
   * Outro cascade. `animation-name`, `-duration` and `-delay` are written per
   * bubble as inline longhands by heroDemoLoop.ts — a `--delay` custom
   * property inside the `animation` shorthand is dropped by WebKit, which
   * started every bubble at once on iOS.
   */
  .home-hero-demo-msg.home-hero-demo-msg--exit {
    transition: none;
  }

  @keyframes heroDemoOutro {
    to {
      opacity: 0;
    }
  }

  .home-hero-demo-msg--user {
    position: relative;
    flex-direction: row;
    justify-content: flex-end;
    padding-inline-start: var(--demo-gutter);
    transform-origin: bottom right;
    --hero-picker-gutter: calc(1.85rem + 0.55rem);
    --hero-picker-shift-x: 0px;
  }

  .home-hero-demo-msg--assistant {
    flex-direction: row;
    justify-content: flex-start;
    padding-inline-end: var(--demo-gutter);
    transform-origin: bottom left;
  }

  .home-hero-demo-avatar {
    flex: none;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--demo-line, var(--site-border));
    background: var(--demo-avatar-bg, var(--site-card));
  }

  .home-hero-demo-avatar--agent {
    padding: 0.28rem;
    background: var(--demo-avatar-bg, var(--site-card));
  }

  .home-hero-demo-avatar-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    color: var(--site-fg, #171717);
  }

  html[data-theme="dark"] .home-hero-demo-avatar-icon {
    filter: invert(1);
  }

  .home-hero-demo-avatar-icon.home-hero-icon-name {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-family: var(--font-primary);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    text-align: center;
  }

  .home-hero-demo-avatar-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero-demo-bubble {
    max-width: min(100%, 22rem);
    padding: 0.55rem 0.78rem;
    border-radius: 1rem;
    font-family: var(--font-content);
    font-size: clamp(0.8rem, 2vw, 0.92rem);
    line-height: 1.45;
    word-wrap: break-word;
    overflow-wrap: anywhere;
    /* Greedy wrap — pretty/balance shortens early lines and looks "halved". */
    text-wrap: wrap;
  }

  .home-hero-demo-bubble-text {
    margin: 0;
  }

  /* Invoice (and similar) results — same affordance as a chat markdown link. */
  .home-hero-demo-link {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.16em;
    text-decoration-thickness: from-font;
  }

  /* Inline @mention chips — mirrors .aui-mention-chip on the dark demo surface. */
  .home-hero-demo-mention-chip {
    display: inline;
    padding: 0.05em 0.18em;
    border-radius: 0.3em;
    font-weight: 600;
    white-space: nowrap;
    color: var(--site-fg, #171717);
    background: color-mix(in srgb, var(--site-fg) 12%, transparent);
  }

  .home-hero-demo-mention-chip--team {
    color: var(--site-fg, #171717);
    background: color-mix(in srgb, var(--site-fg) 10%, transparent);
  }

  .home-hero-demo-ellipsis {
    display: inline-block;
    width: 1.15em;
    text-align: left;
    vertical-align: baseline;
  }

  .home-hero-demo-ellipsis::after {
    content: "…";
    animation: heroDemoEllipsis 1.35s steps(4, end) infinite;
  }

  @keyframes heroDemoEllipsis {
    0%, 20% { content: ""; }
    40% { content: "."; }
    60% { content: ".."; }
    80%, 100% { content: "…"; }
  }

  .home-hero-demo-msg--composing .home-hero-demo-bubble {
    min-width: 2.6rem;
    min-height: 1.45rem;
  }

  .home-hero-demo-bubble-text--cursor::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 0.95em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--demo-fg, var(--site-fg));
    animation: heroDemoCursor 1.13s step-end infinite;
  }

  @keyframes heroDemoCursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /*
   * Slash + mention popovers sit on the composing row (not 100vw). Chat parks
   * the newest turn on the lane floor, so both open *above* the bubble. Width
   * is the row minus the avatar gutter — `100vw` overflowed the demo canvas.
   */
  .home-hero-demo-slash-picker {
    position: absolute;
    right: calc(var(--hero-picker-gutter, 2.4rem) + var(--hero-picker-shift-x, 0px));
    bottom: calc(100% + 8px);
    left: auto;
    top: auto;
    z-index: 5;
    box-sizing: border-box;
    width: min(16.5rem, calc(100% - var(--hero-picker-gutter, 2.4rem)));
    max-width: calc(100% - 8px);
    max-height: 12rem;
    overflow-y: auto;
    padding: 0.28rem 0;
    border-radius: 0.75rem;
    border: 1px solid var(--demo-line, var(--site-border));
    background: var(--site-canvas, #fff);
    box-shadow: 0 10px 32px color-mix(in srgb, var(--site-fg) 16%, transparent);
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transform-origin: bottom right;
    transition:
      opacity 0.37s ease,
      transform 0.37s ease;
    pointer-events: none;
  }

  .home-hero-demo-slash-picker--visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .home-hero-demo-slash-picker--exit {
    opacity: 0;
    transform: translateY(4px) scale(0.98);
  }

  .home-hero-demo-slash-picker-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-hero-demo-slash-option {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.38rem 0.65rem;
    font-size: 0.74rem;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background 0.15s ease;
  }

  .home-hero-demo-slash-option.active {
    background: var(--demo-fill, var(--site-card));
  }

  .home-hero-demo-slash-option-cmd {
    flex: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    color: var(--demo-fg, var(--site-fg));
  }

  .home-hero-demo-slash-option-summary {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--demo-fg-muted, var(--site-fg-muted));
  }

  /* Composing bubble is the mock input — anchor overlays here, not in document flow. */
  .home-hero-demo-msg--composing .home-hero-demo-bubble {
    position: relative;
    overflow: visible;
  }

  /* Same lane as slash — above the bubble so it cannot fall off the canvas. */
  .home-hero-demo-mention-picker {
    position: absolute;
    right: calc(var(--hero-picker-gutter, 2.4rem) + var(--hero-picker-shift-x, 0px));
    bottom: calc(100% + 8px);
    left: auto;
    top: auto;
    z-index: 20;
    box-sizing: border-box;
    width: min(20.5rem, calc(100% - var(--hero-picker-gutter, 2.4rem)));
    max-width: calc(100% - 8px);
    max-height: 12rem;
    overflow-y: auto;
    padding: 0.22rem 0;
    border-radius: 0.85rem;
    border: 1px solid var(--demo-line, var(--site-border));
    background: var(--site-canvas, #fff);
    box-shadow: 0 10px 32px color-mix(in srgb, var(--site-fg) 16%, transparent);
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transform-origin: bottom right;
    transition:
      opacity 0.37s ease,
      transform 0.37s ease;
    pointer-events: none;
  }

  .home-hero-demo-mention-picker--visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .home-hero-demo-mention-picker--exit {
    opacity: 0;
    transform: translateY(4px) scale(0.98);
  }

  .home-hero-demo-mention-picker-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-hero-demo-mention-option {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.38rem 0.7rem;
    font-size: 0.74rem;
    line-height: 1.2;
    transition: background 0.15s ease;
  }

  .home-hero-demo-mention-option.active {
    background: var(--demo-fill, var(--site-card));
  }

  .home-hero-demo-mention-option-kind {
    flex: none;
    min-width: 3.4rem;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--demo-fg-muted, var(--site-fg-muted));
  }

  .home-hero-demo-mention-option-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    color: var(--demo-fg, var(--site-fg));
    -webkit-text-fill-color: var(--demo-fg, var(--site-fg));
  }

  .home-hero-demo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.55rem;
  }

  .home-hero-demo-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.32rem 0.62rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    border: 1px solid var(--demo-line, var(--site-border));
    background: var(--demo-fill, var(--site-card));
    color: var(--demo-fg-muted, var(--site-fg-muted));
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease;
  }

  /*
   * Simulated pointer hover — applied by the demo loop only after chips appear
   * idle. Idle chips stay muted so nothing looks pre-selected.
   */
  .home-hero-demo-action--hover {
    background: var(--demo-fill-strong, var(--site-card));
    border-color: var(--demo-line, var(--site-border));
    color: var(--demo-fg, var(--site-fg));
    box-shadow: 0 0 0 1px var(--demo-line, var(--site-border));
  }

  .home-hero-demo-action--pressed {
    transform: scale(0.96);
    background: var(--demo-fill-press, var(--site-card));
    border-color: var(--demo-line, var(--site-border));
    color: var(--demo-fg, var(--site-fg));
    box-shadow: 0 0 0 1px var(--demo-line, var(--site-border));
  }

  /* Artifact cards — full chat width, no avatar gutter. */
  .home-hero-demo-msg--artifact {
    padding-inline: 0;
    --demo-gutter: 0;
    justify-content: stretch;
  }

  .home-hero-demo-sk-invoice {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: 0.85rem 0.95rem 0.8rem;
    border-radius: 1rem;
    border: 1px solid var(--demo-line, var(--site-border));
    background: var(--site-canvas, #fff);
    box-shadow: var(--hero-sk-shadow, 0 8px 14px -8px rgba(0, 0, 0, 0.2));
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    transform-origin: center center;
    opacity: 0;
    transform: scale(0.72);
  }

  .home-hero-demo-sk-invoice--pop {
    animation: heroDemoSkInvoicePop 0.7s cubic-bezier(0.22, 1.35, 0.36, 1) forwards;
  }

  .home-hero-demo-sk-invoice--settled {
    opacity: 1;
    transform: scale(1);
  }

  @keyframes heroDemoSkInvoicePop {
    0% {
      opacity: 0;
      transform: scale(0.72);
    }
    58% {
      opacity: 1;
      transform: scale(1.06);
    }
    78% {
      transform: scale(0.985);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .home-hero-demo-sk-invoice-header,
  .home-hero-demo-sk-invoice-line,
  .home-hero-demo-sk-invoice-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .home-hero-demo-sk-invoice-client {
    display: flex;
  }

  .home-hero-demo-sk-invoice-lines {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    padding: 0.4rem 0 0.12rem;
    border-top: 1px solid var(--demo-line, var(--site-border));
  }

  /* Collapsed until after the card pop — bones grow it and shove the footer down. */
  .home-hero-demo-sk-invoice-payments {
    border-top: 1px solid transparent;
    padding: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease,
      padding 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease;
  }

  .home-hero-demo-sk-invoice-payments--open {
    max-height: 3.5rem;
    opacity: 1;
    padding: 0.38rem 0 0.12rem;
    border-top-color: var(--demo-line, var(--site-border));
  }

  .home-hero-demo-sk-invoice-payment {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "label ."
      "detail amt";
    column-gap: 0.7rem;
    row-gap: 0.28rem;
    align-items: center;
  }

  .home-hero-demo-sk-invoice-footer {
    padding-top: 0.4rem;
    border-top: 1px solid var(--demo-line, var(--site-border));
  }

  /* Static bones — no continuous shimmer. */
  .home-hero-demo-sk-bone {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 4px;
    background: var(--demo-bone, var(--site-card));
  }

  .home-hero-demo-sk-bone--title {
    width: 38%;
    height: 0.55rem;
  }

  .home-hero-demo-sk-bone--meta {
    width: 18%;
    height: 0.4rem;
  }

  .home-hero-demo-sk-bone--client {
    width: 48%;
    height: 0.45rem;
  }

  .home-hero-demo-sk-bone--label {
    width: 22%;
    height: 0.35rem;
  }

  .home-hero-demo-sk-bone--line {
    flex: 1 1 auto;
    height: 0.4rem;
    max-width: 68%;
  }

  .home-hero-demo-sk-bone--amt {
    flex: none;
    width: 2.1rem;
    height: 0.4rem;
  }

  .home-hero-demo-sk-bone--total {
    flex: none;
    width: 2.6rem;
    height: 0.5rem;
  }

  .home-hero-demo-sk-bone--pay-label {
    grid-area: label;
    width: 28%;
    min-width: 2.4rem;
  }

  .home-hero-demo-sk-bone--pay-detail {
    grid-area: detail;
    width: 72%;
  }

  .home-hero-demo-sk-bone--pay-amt {
    grid-area: amt;
    width: 2.1rem;
  }

  /* Payment bones start collapsed; stagger L→R via --pay-in.
   * Avoid scale(0) — WebKit culls that layer and snaps the end state on iOS. */
  .home-hero-demo-sk-invoice-payment [data-hero-sk-pay] {
    height: 0;
    opacity: 0;
    transform: translateX(-10px);
    transition:
      height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      transform 0.36s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-hero-demo-sk-bone--pay-label.home-hero-demo-sk-bone--pay-in {
    height: 0.32rem;
    opacity: 1;
    transform: translateX(0);
  }

  .home-hero-demo-sk-bone--pay-detail.home-hero-demo-sk-bone--pay-in,
  .home-hero-demo-sk-bone--pay-amt.home-hero-demo-sk-bone--pay-in {
    height: 0.4rem;
    opacity: 1;
    transform: translateX(0);
  }

  .home-hero-demo-sk-bone--total-pulse {
    animation: heroDemoSkTotalPulse 0.85s ease;
  }

  @keyframes heroDemoSkTotalPulse {
    0% {
      transform: scale(1);
      background: var(--demo-bone, var(--site-card));
      box-shadow: none;
    }
    35% {
      transform: scale(1.18);
      background: var(--demo-fill-press, var(--site-card));
      box-shadow:
        0 0 14px color-mix(in srgb, #ff2d6f 36%, transparent),
        0 0 10px color-mix(in srgb, #4b6bff 26%, transparent);
    }
    100% {
      transform: scale(1);
      background: var(--demo-bone, var(--site-card));
      box-shadow: none;
    }
  }

  .home-hero-demo-sk-bone--total-pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--site-fg) 28%, transparent) 45%,
      color-mix(in srgb, var(--site-fg) 8%, transparent) 55%,
      transparent 100%
    );
    transform: translateX(-120%);
    animation: heroDemoSkTotalShine 0.85s ease;
  }

  @keyframes heroDemoSkTotalShine {
    0% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(120%);
    }
  }

  .home-hero-demo-sk-invoice--exit {
    /* Duration set from JS to half the sit hold (see --hero-sk-invoice-exit-ms). */
    animation: heroDemoSkInvoiceExit var(--hero-sk-invoice-exit-ms, 0.5s)
      cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes heroDemoSkInvoiceExit {
    0% {
      opacity: 1;
      transform: scale(1) translateX(0);
    }
    100% {
      opacity: 0;
      transform: scale(0.98) translateX(28%);
    }
  }

  /* Review draft — same invoice chrome; sections start collapsed and fill L→R. */
  .home-hero-demo-sk-invoice--review .home-hero-demo-sk-invoice-lines--pending {
    border-top: 1px solid transparent;
    padding: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    gap: 0;
    transition:
      max-height 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      padding 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s ease,
      gap 0.4s ease;
  }

  .home-hero-demo-sk-invoice--review .home-hero-demo-sk-invoice-lines--open {
    max-height: 12rem;
    opacity: 1;
    padding: 0.4rem 0 0.12rem;
    border-top-color: var(--demo-line, var(--site-border));
    gap: 0.42rem;
  }

  .home-hero-demo-sk-invoice--review .home-hero-demo-sk-invoice-line {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-8px);
    transition:
      max-height 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.26s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.28s ease;
  }

  .home-hero-demo-sk-invoice--review .home-hero-demo-sk-invoice-line--in {
    max-height: 1.45rem;
    opacity: 1;
    transform: none;
  }

  .home-hero-demo-sk-invoice--review .home-hero-demo-sk-invoice-line--scan {
    background: var(--demo-fill, var(--site-card));
    border-radius: 6px;
    margin-inline: -0.22rem;
    padding-inline: 0.22rem;
  }

  .home-hero-demo-sk-invoice--review .home-hero-demo-sk-invoice-footer--pending {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding-top: 0;
    border-top-color: transparent;
    transition:
      max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      padding 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s ease;
  }

  .home-hero-demo-sk-invoice--review .home-hero-demo-sk-invoice-footer--open {
    max-height: 2.6rem;
    opacity: 1;
    padding-top: 0.4rem;
    border-top-color: var(--demo-line, var(--site-border));
  }

  /*
   * L→R wipe. clip-path (percent → percent) interpolates on iOS Safari;
   * scaleX(0) and width:0 → var() do not — WebKit snaps those to the end frame.
   */
  .home-hero-demo-sk-invoice--review [data-hero-sk-draw] {
    transform: none;
    transform-origin: left center;
    opacity: 0;
    -webkit-clip-path: inset(0 100% 0 0);
    clip-path: inset(0 100% 0 0);
    transition:
      clip-path 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.26s ease;
  }

  .home-hero-demo-sk-invoice--review [data-hero-sk-draw].home-hero-demo-sk-bone--draw-in {
    transform: none;
    opacity: 1;
    -webkit-clip-path: inset(0 0% 0 0);
    clip-path: inset(0 0% 0 0);
  }

  /* Dashboard notification toast — mirrors admin review alerts (see shell.css). */
  .home-hero-demo-sk-notif {
    position: relative;
    isolation: isolate;
    width: min(100%, 18.5rem);
    margin-inline: auto;
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--demo-line, var(--site-border));
    background: var(--site-canvas, #fff);
    box-shadow: var(--hero-sk-shadow, 0 8px 14px -8px rgba(0, 0, 0, 0.2));
    transform-origin: center center;
    opacity: 0;
    transform: scale(0.72);
  }

  .home-hero-demo-sk-notif-head {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    min-width: 0;
  }

  .home-hero-demo-sk-notif-icon {
    flex: none;
    align-self: flex-start;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    object-fit: cover;
  }

  .home-hero-demo-sk-notif-icon--emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    line-height: 1;
    background: var(--demo-fill, var(--site-card));
  }

  .home-hero-demo-sk-notif--pop {
    animation: heroDemoSkInvoicePop 0.7s cubic-bezier(0.22, 1.35, 0.36, 1) forwards;
  }

  .home-hero-demo-sk-notif--settled {
    opacity: 1;
    transform: scale(1);
  }

  .home-hero-demo-sk-notif-copy {
    flex: 1;
    min-width: 0;
  }

  .home-hero-demo-sk-notif-title,
  .home-hero-demo-sk-notif-detail {
    margin: 0;
    font-family: var(--font-primary);
  }

  .home-hero-demo-sk-notif-title {
    display: block;
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.25;
    margin-bottom: 0.2rem;
    color: var(--demo-fg, var(--site-fg));
  }

  .home-hero-demo-sk-notif-detail {
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--demo-fg-muted, var(--site-fg-muted));
  }

  /* Contract card — line bones draw in, then signature strokes. */
  .home-hero-demo-sk-contract {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: 0.9rem 0.95rem 0.85rem;
    border-radius: 1rem;
    border: 1px solid var(--demo-line, var(--site-border));
    background: var(--site-canvas, #fff);
    box-shadow: var(--hero-sk-shadow, 0 8px 14px -8px rgba(0, 0, 0, 0.2));
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    transform-origin: center center;
    opacity: 0;
    transform: scale(0.72);
  }

  .home-hero-demo-sk-invoice::before,
  .home-hero-demo-sk-notif::before,
  .home-hero-demo-sk-contract::before {
    content: "";
    position: absolute;
    inset: 2px;
    z-index: -1;
    border-radius: inherit;
    background: var(--home-hero-mark-spectrum);
    filter: blur(22px);
    opacity: 0.34;
    pointer-events: none;
  }

  html[data-theme="dark"] .home-hero-demo-sk-invoice::before,
  html[data-theme="dark"] .home-hero-demo-sk-notif::before,
  html[data-theme="dark"] .home-hero-demo-sk-contract::before {
    opacity: 0.52;
  }

  .home-hero-demo-sk-contract--pop {
    animation: heroDemoSkInvoicePop 0.7s cubic-bezier(0.22, 1.35, 0.36, 1) forwards;
  }

  .home-hero-demo-sk-contract--settled {
    opacity: 1;
    transform: scale(1);
  }

  .home-hero-demo-sk-contract-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .home-hero-demo-sk-contract-body {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    padding: 0.35rem 0 0.1rem;
    border-top: 1px solid var(--demo-line, var(--site-border));
  }

  .home-hero-demo-sk-contract-line {
    display: block;
    height: 0.38rem;
    width: var(--hero-contract-line-w, 90%);
    max-width: 100%;
    border-radius: 4px;
    background: var(--demo-bone, var(--site-card));
    opacity: 0;
    -webkit-clip-path: inset(0 100% 0 0);
    clip-path: inset(0 100% 0 0);
    transition:
      clip-path 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.28s ease;
  }

  .home-hero-demo-sk-contract-line--in {
    opacity: 1;
    -webkit-clip-path: inset(0 0% 0 0);
    clip-path: inset(0 0% 0 0);
  }

  .home-hero-demo-sk-contract-sign {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.45rem;
    border-top: 1px solid var(--demo-line, var(--site-border));
  }

  .home-hero-demo-sk-contract-sign-label {
    display: block;
    width: 22%;
    height: 0.32rem;
    border-radius: 4px;
    background: var(--demo-bone, var(--site-card));
  }

  .home-hero-demo-sk-contract-signature {
    width: min(100%, 11.5rem);
    height: 2.4rem;
    overflow: visible;
  }

  /* pathLength="1" on the path — dash 1/1 is the hidden start. JS ticks offset. */
  .home-hero-demo-sk-contract-signature-path {
    fill: none;
    stroke: var(--demo-fg, var(--site-fg));
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .home-hero-demo-sk-contract-signature--drawn .home-hero-demo-sk-contract-signature-path {
    stroke-dashoffset: 0;
  }

  .home-hero-demo-sk-contract-sign-rule {
    display: block;
    width: 58%;
    height: 1px;
    background: var(--demo-line, var(--site-border));
  }

  /* GPS map bubble — map bleeds edge-to-edge; chrome is just the clip + border. */
  .home-hero-demo-msg--gps {
    align-items: flex-end;
  }

  .home-hero-demo-sk-gps {
    width: min(100%, 22rem);
    padding: 0;
    border-radius: 1rem;
    border-bottom-left-radius: 0.28rem;
    border: 1px solid var(--demo-line, var(--site-border));
    /* Same fill as chat bubbles so the translucent --demo-line composites
     * identically. 88% --site-fg inverted in dark mode and lit the stroke. */
    background: var(--demo-bubble-fill, var(--site-card));
    overflow: hidden;
    transform-origin: bottom left;
    opacity: 0;
    transform: scale(0.72);
  }

  .home-hero-demo-sk-gps--pop {
    animation: heroDemoSkInvoicePop 0.7s cubic-bezier(0.22, 1.35, 0.36, 1) forwards;
  }

  .home-hero-demo-sk-gps--settled {
    opacity: 1;
    transform: none;
  }

  .home-hero-demo-sk-gps-viewport {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 9.5rem;
    max-height: 12rem;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #0b0d10;
  }

  .home-hero-demo-sk-gps-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }

  /* WebGL canvas must fill the letterbox — iOS often leaves a dead bar otherwise. */
  .home-hero-demo-sk-gps-map .mapboxgl-map,
  .home-hero-demo-sk-gps-map .mapboxgl-canvas-container,
  .home-hero-demo-sk-gps-map .mapboxgl-canvas {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  .home-hero-demo-sk-gps-map .mapboxgl-canvas {
    outline: none;
  }

  .home-hero-demo-sk-gps-map .mapboxgl-ctrl,
  .home-hero-demo-sk-gps-map .mapboxgl-ctrl-logo,
  .home-hero-demo-sk-gps-map .mapboxgl-ctrl-attrib {
    display: none !important;
  }

  /*
   * Static Images path (iOS / GL fallback). Frames sit at different Mapbox
   * zooms; the loop scales each one so the visible ground resolution is
   * continuous, then hands off to the next. JS owns `transform` and `opacity`
   * here — the overscan below is what lets a frame fade in while still slightly
   * downscaled without exposing its edge.
   */
  .home-hero-demo-sk-gps-map--static {
    overflow: hidden;
  }

  /* Never a dead black box while the first frame is in flight. */
  .home-hero-demo-sk-gps-map--loading::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 20%,
      color-mix(in srgb, var(--site-canvas) 14%, transparent) 50%,
      transparent 80%
    );
    background-size: 220% 100%;
    animation: heroDemoSkGpsLoading 1.5s linear infinite;
  }

  @keyframes heroDemoSkGpsLoading {
    from {
      background-position: 160% 0;
    }
    to {
      background-position: -60% 0;
    }
  }

  /*
   * Its own stacking context: layers are stacked by ladder index, and without
   * this those indices would compete with the centre pin in the viewport's
   * context and bury it.
   */
  .home-hero-demo-sk-gps-static-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    isolation: isolate;
    width: 100%;
    height: 100%;
  }

  .home-hero-demo-sk-gps-static-frame {
    position: absolute;
    left: calc((1 - var(--hero-gps-overscan, 1.34)) * 50%);
    top: calc((1 - var(--hero-gps-overscan, 1.34)) * 50%);
    display: block;
    width: calc(var(--hero-gps-overscan, 1.34) * 100%);
    height: calc(var(--hero-gps-overscan, 1.34) * 100%);
    margin: 0;
    object-fit: cover;
    object-position: center;
    transform: scale(1);
    transform-origin: 50% 50%;
    backface-visibility: hidden;
    will-change: transform, opacity;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Fixed in the letterbox center — not a Mapbox HTML marker. */
  .home-hero-demo-sk-gps-marker {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 3.25rem;
    height: 3.25rem;
    margin: -1.625rem 0 0 -1.625rem;
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
  }

  .home-hero-demo-sk-gps-marker--in {
    animation: heroDemoSkGpsMarkerIn 0.45s cubic-bezier(0.22, 1.35, 0.36, 1) forwards;
  }

  @keyframes heroDemoSkGpsMarkerIn {
    0% {
      opacity: 0;
      transform: scale(0.35) translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Reverse-teardrop person pin — circular face, triangular tip on map center. */
  .home-hero-demo-sk-gps-pin {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 2.35rem;
    height: 2.85rem;
    transform: translate(-50%, -100%);
