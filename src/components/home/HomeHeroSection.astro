---
/**
 * Homepage hero — brand icon, headline, and shuffling industry tagline.
 */
import { ArrowRight } from "lucide-astro";
import BrandIconInline from "../../components/BrandIconInline.astro";
import ReaveBgPattern from "../../components/ReaveBgPattern.astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import {
  DEFAULT_DECK_INDUSTRIES,
  listEnabledDeckIndustries,
} from "../../lib/deckIndustriesStore";

const company = await getCompanyConfig(Astro.request);
const enabled = await listEnabledDeckIndustries();
const industryLabels =
  enabled.length > 0
    ? enabled.map((i) => i.label.trim()).filter(Boolean)
    : DEFAULT_DECK_INDUSTRIES.map((i) => i.label);

const startIndex =
  industryLabels.length > 0
    ? Math.floor(Math.random() * industryLabels.length)
    : 0;
const firstIndustry = industryLabels[startIndex] ?? "your business";
---

<section
  id="home"
  class="home-hero"
  data-home-section="home"
  aria-labelledby="home-hero-title"
>
  <div class="home-hero-mesh" aria-hidden="true"></div>
  <ReaveBgPattern class="home-hero-pattern" fit="cover" opacity={0.085} reveal />

  <div class="home-hero-icon-wrap" data-hero-icon>
    <div class="home-hero-icon-glow-layer" aria-hidden="true">
      <BrandIconInline company={company} variant="glow" />
    </div>
    <div class="home-hero-icon-front">
      <BrandIconInline company={company} variant="front" />
    </div>
  </div>

  <div class="home-hero-inner">
    <div class="home-hero-copy">
      <h1 id="home-hero-title" class="home-hero-title">Take Your Time Back</h1>
      <p class="home-hero-tagline">
        An OS for
        <span
          class="home-hero-industry"
          data-hero-industry
          data-industries={JSON.stringify(industryLabels)}
          data-interval-ms="2500"
        >
          <span
            class="home-hero-industry-viewport"
            data-hero-industry-viewport
            aria-live="polite"
            style={`min-width: ${firstIndustry.length}ch`}
          >
            <span
              class="home-hero-industry-layer home-hero-industry-next"
              data-hero-industry-next
              hidden
            ></span>
            <span
              class="home-hero-industry-layer home-hero-industry-current"
              data-hero-industry-current
            >
              {firstIndustry}
            </span>
          </span>
        </span>
      </p>
      <div class="home-hero-cta">
        <a class="home-hero-btn home-hero-btn--ghost" href="/features#plan">
          See pricing
        </a>
        <a class="home-hero-btn home-hero-btn--primary" href="/demo">
          Demo now
          <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../lib/heroIndustryRotate.ts";
  import "../../lib/heroIconScroll.ts";
</script>

<style>
  .home-hero {
    position: relative;
    z-index: 0;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    padding: calc(var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) + 24px) 20px 64px;
    scroll-margin-top: 0;
    overflow: hidden;
  }

  .home-hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 55% at 15% 20%, rgba(244, 114, 182, 0.2) 0%, transparent 62%),
      radial-gradient(ellipse 70% 50% at 85% 25%, rgba(99, 102, 241, 0.18) 0%, transparent 58%),
      radial-gradient(ellipse 90% 60% at 50% 100%, rgba(192, 38, 211, 0.12) 0%, transparent 55%);
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.55) 78%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.55) 78%,
      transparent 100%
    );
  }

  .home-hero-pattern {
    z-index: 1;
    mix-blend-mode: soft-light;
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 62%,
      rgba(0, 0, 0, 0.45) 82%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 62%,
      rgba(0, 0, 0, 0.45) 82%,
      transparent 100%
    );
  }

  .home-hero-inner {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: calc(50% + clamp(90px, 17.5vw, 140px) + 28px);
    transform: translateX(-50%);
    width: min(100%, 720px);
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
    pointer-events: none;
  }

  .home-hero-inner :is(a, button) {
    pointer-events: auto;
  }

  .home-hero-icon-wrap {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(180px, 35vw, 280px);
    height: clamp(180px, 35vw, 280px);
    will-change: transform, opacity;
    transform: translate(-50%, -50%);
    transform-origin: center center;
    isolation: isolate;
    touch-action: manipulation;
  }

  .home-hero-icon-glow-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .home-hero-icon-glow-layer :global(svg),
  .home-hero-icon-glow-layer :global(img),
  .home-hero-icon-glow-svg {
    display: block;
    width: 105.3%;
    height: 105.3%;
    object-fit: contain;
    filter:
      blur(12px)
      grayscale(1)
      brightness(0.12)
      drop-shadow(0 0 22px rgba(0, 0, 0, 0.75))
      drop-shadow(0 0 42px rgba(0, 0, 0, 0.45));
    animation: home-hero-icon-glow-pulse 3.6s ease-in-out infinite;
    will-change: filter, opacity;
  }

  @keyframes home-hero-icon-glow-pulse {
    0%,
    100% {
      filter:
        blur(10px)
        grayscale(1)
        brightness(0.1)
        drop-shadow(0 0 18px rgba(0, 0, 0, 0.65))
        drop-shadow(0 0 34px rgba(0, 0, 0, 0.38));
      opacity: 0.72;
    }

    50% {
      filter:
        blur(16px)
        grayscale(1)
        brightness(0.16)
        drop-shadow(0 0 28px rgba(0, 0, 0, 0.85))
        drop-shadow(0 0 52px rgba(0, 0, 0, 0.52));
      opacity: 0.92;
    }
  }

  .home-hero-icon-front {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .home-hero-icon,
  .home-hero-icon-front :global(svg),
  .home-hero-icon-front :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 40px rgba(192, 38, 211, 0.35));
  }

  .home-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
  }

  .home-hero-title {
    margin: 0;
    font-family: var(--font-primary);
    font-size: clamp(2.1rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #fff;
    text-wrap: balance;
  }

  .home-hero-tagline {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.35em;
    font-family: var(--font-content);
    font-size: clamp(1.05rem, 2.8vw, 1.35rem);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.68);
  }

  .home-hero-industry {
    display: inline-block;
    vertical-align: baseline;
    text-align: left;
  }

  .home-hero-industry-viewport {
    position: relative;
    display: inline-block;
    vertical-align: bottom;
    height: 1.35em;
    overflow: hidden;
    background: #050505;
  }

  .home-hero-industry-layer {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    font-family: var(--font-primary);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: #fff;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .home-hero-industry-current {
    z-index: 1;
  }

  .home-hero-industry-next {
    z-index: 2;
  }

  .home-hero-industry-next[hidden],
  .home-hero-industry-current[hidden] {
    display: none;
  }

  .home-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  .home-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .home-hero-btn--primary {
    color: #0b0512;
    background: var(--brand-gradient);
    box-shadow: 0 8px 28px rgba(192, 38, 211, 0.38);
  }

  .home-hero-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-hero-btn--ghost {
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .home-hero-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.38);
    transform: translateY(-1px);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-icon-wrap {
      will-change: auto;
    }

    .home-hero-icon-glow-layer :global(svg),
    .home-hero-icon-glow-svg {
      animation: none;
      opacity: 0.75;
      filter:
        blur(10px)
        grayscale(1)
        brightness(0.12)
        drop-shadow(0 0 20px rgba(0, 0, 0, 0.6));
    }
  }
</style>
