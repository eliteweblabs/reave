---
/**
 * Homepage hero — brand icon, scripted demo conversation, headline, and CTAs.
 */
import { ArrowRight } from "lucide-astro";
import BrandIconInline from "../../components/BrandIconInline.astro";
import ReaveBgPattern from "../../components/ReaveBgPattern.astro";
import ReaveIcon from "../../components/ReaveIconAnimated.astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import { HERO_DEMO_EXCHANGES } from "../../lib/heroDemoConversation";

const company = await getCompanyConfig(Astro.request);
const demoExchanges = HERO_DEMO_EXCHANGES;
---

<section
  id="home"
  class="home-hero"
  data-home-section="home"
  aria-labelledby="home-hero-title"
>
  <div class="home-hero-mesh" aria-hidden="true"></div>
  <ReaveBgPattern class="home-hero-pattern" fit="cover" opacity={0.085} reveal />

  <div class="home-hero-center">
    <div class="home-hero-icon-wrap">
      <BrandIconInline company={company} />
    </div>

    <div
      class="home-hero-demo"
      data-hero-demo
      data-exchanges={JSON.stringify(demoExchanges)}
      aria-live="polite"
      aria-atomic="false"
    >
      <template id="hero-demo-agent-avatar">
        <span class="home-hero-demo-avatar home-hero-demo-avatar--agent" aria-hidden="true">
          <ReaveIcon class="home-hero-demo-avatar-icon" />
        </span>
      </template>
      <template id="hero-demo-user-avatar">
        <span class="home-hero-demo-avatar home-hero-demo-avatar--user" aria-hidden="true">
          <svg class="home-hero-demo-avatar-photo" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="hero-demo-user-bg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#64748b"/>
                <stop offset="100%" stop-color="#334155"/>
              </linearGradient>
            </defs>
            <rect width="64" height="64" rx="32" fill="url(#hero-demo-user-bg)"/>
            <circle cx="32" cy="24" r="11" fill="#e2e8f0"/>
            <ellipse cx="32" cy="54" rx="18" ry="14" fill="#e2e8f0"/>
          </svg>
        </span>
      </template>
      <div class="home-hero-demo-stack" data-hero-demo-stack role="list"></div>
    </div>

    <div class="home-hero-copy">
      <h1 id="home-hero-title" class="home-hero-title">Take Your Time Back</h1>
      <div class="home-hero-cta">
        <a class="home-hero-btn home-hero-btn--ghost" href="/#plan">
          See pricing
        </a>
        <a class="home-hero-btn home-hero-btn--primary" href="/demo">
          Demo now
          <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../lib/heroDemoLoop.ts";
</script>

<style>
  .home-hero {
    position: relative;
    z-index: 0;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    padding: calc(var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) + 24px) 20px 64px;
    scroll-margin-top: 0;
    overflow: hidden;
  }

  .home-hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 55% at 15% 20%, rgba(244, 114, 182, 0.2) 0%, transparent 62%),
      radial-gradient(ellipse 70% 50% at 85% 25%, rgba(99, 102, 241, 0.18) 0%, transparent 58%),
      radial-gradient(ellipse 90% 60% at 50% 100%, rgba(192, 38, 211, 0.12) 0%, transparent 55%);
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.55) 78%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.55) 78%,
      transparent 100%
    );
  }

  .home-hero-pattern {
    z-index: 1;
    mix-blend-mode: soft-light;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 62%,
      rgba(0, 0, 0, 0.45) 82%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 62%,
      rgba(0, 0, 0, 0.45) 82%,
      transparent 100%
    );
  }

  .home-hero-center {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(100%, 720px);
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 3vw, 22px);
    text-align: center;
    pointer-events: none;
  }

  .home-hero-center :is(a, button) {
    pointer-events: auto;
  }

  .home-hero-icon-wrap {
    position: relative;
    z-index: 1;
    width: clamp(180px, 35vw, 280px);
    height: clamp(180px, 35vw, 280px);
    flex-shrink: 0;
  }

  .home-hero-icon-wrap :global(svg),
  .home-hero-icon-wrap :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    filter: var(--brand-glow-filter);
  }

  .home-hero-demo {
    width: 100%;
    min-height: 7.5rem;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .home-hero-demo[hidden] {
    display: none;
  }

  .home-hero-demo-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 520px;
    text-align: left;
  }

  .home-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
  }

  .home-hero-title {
    margin: 0;
    font-family: var(--font-primary);
    font-size: clamp(2.1rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #fff;
    text-wrap: balance;
  }

  .home-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 4px;
  }

  .home-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .home-hero-btn--primary {
    color: #0b0512;
    background: var(--brand-gradient);
    box-shadow: 0 8px 28px rgba(192, 38, 211, 0.38);
  }

  .home-hero-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .home-hero-btn--ghost {
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .home-hero-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.38);
    transform: translateY(-1px);
    text-decoration: none;
  }
</style>

<style is:global>
  .home-hero-demo-msg {
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    width: 100%;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .home-hero-demo-msg--user {
    flex-direction: row;
    justify-content: flex-end;
  }

  .home-hero-demo-msg--assistant {
    flex-direction: row;
    justify-content: flex-start;
  }

  .home-hero-demo-avatar {
    flex: none;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(15, 15, 20, 0.85);
  }

  .home-hero-demo-avatar--agent {
    padding: 0.28rem;
    background: rgba(8, 8, 12, 0.92);
  }

  .home-hero-demo-avatar-icon {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-hero-demo-avatar-photo {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-hero-demo-bubble {
    max-width: min(78%, 22rem);
    padding: 0.55rem 0.78rem;
    border-radius: 1rem;
    font-family: var(--font-content);
    font-size: clamp(0.8rem, 2vw, 0.92rem);
    line-height: 1.45;
    word-wrap: break-word;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .home-hero-demo-msg--user .home-hero-demo-bubble {
    color: rgba(255, 255, 255, 0.95);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom-right-radius: 0.28rem;
  }

  .home-hero-demo-msg--assistant .home-hero-demo-bubble {
    color: rgba(255, 255, 255, 0.88);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-left-radius: 0.28rem;
  }

  .home-hero-demo-bubble--slash {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.74rem, 1.85vw, 0.86rem);
    letter-spacing: -0.01em;
  }

  .home-hero-demo-msg--enter {
    animation: heroDemoEnter 0.42s ease-out both;
  }

  .home-hero-demo-msg--exit {
    animation: heroDemoExit 0.65s ease-in forwards;
  }

  @keyframes heroDemoEnter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroDemoExit {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-18px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-demo-msg--enter,
    .home-hero-demo-msg--exit {
      animation: none;
    }
  }
</style>
