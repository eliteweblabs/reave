---
import ClientLogos from "../ClientLogos.astro";
---

<section
  id="about"
  class="home-client-logos"
  data-home-section="about"
  aria-label="Client logos"
>
  <ClientLogos />
</section>

<style>
  .home-client-logos {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 48px 0 56px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .home-client-logos {
      padding: 56px 0 72px;
    }
  }
</style>
