---
import PortfolioMasonry from "../PortfolioMasonry.astro";
import { getSiteContent } from "../../lib/siteContent";

const items = getSiteContent().portfolio ?? [];
---

{
  items.length > 0 && (
<section
  id="portfolio"
  class="home-section about-portfolio"
  data-no-scroll-fade
  aria-labelledby="portfolio-title"
>
  <div class="home-section-inner">
    <header class="home-section-hero">
      <p class="marketing-label">Recent Work</p>
      <h2 id="portfolio-title">Portfolio</h2>
      <p class="marketing-lead">
        Branding, WordPress, managed hosting, a site that just needs to look like
        someone cares — we still take that work. If you later want the whole shop
        in one login, we built an operating system for that. Most people start
        with the thing that’s actually in the way this week.
      </p>
    </header>

    <section class="section--full-bleed">
      <PortfolioMasonry />
    </section>
  </div>
</section>
  )
}
