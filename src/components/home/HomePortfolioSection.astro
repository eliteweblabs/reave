---
import PortfolioMasonry from "../PortfolioMasonry.astro";
---

<section
  id="portfolio"
  class="home-section about-portfolio"
  aria-labelledby="portfolio-title"
>
  <div class="home-section-inner">
    <header class="home-section-hero">
      <p class="marketing-label">Recent Work</p>
      <h2 id="portfolio-title">Portfolio</h2>
      <p class="marketing-lead">
        We still take on bespoke projects — branding, WordPress, managed hosting, training — but the
        core product is the Business OS: one login that replaces the SaaS pile most small businesses
        pay for every month. Every install is white-labeled to your company. Your clients see your
        portal on their phone; you get CRM, projects, inbox, scheduling, billing, and an always-on AI
        agent behind one dashboard.
      </p>
    </header>

    <section class="section--full-bleed">
      <PortfolioMasonry />
    </section>
  </div>
</section>
