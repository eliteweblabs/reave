---
/**
 * Scroll-controlled software showcase — Meter-style pin.
 * Left list highlights one feature at a time; the admin window swaps with it.
 */
import {
  Sparkles,
  Users,
  Eye,
  Palette,
  LayoutDashboard,
  Inbox,
  Briefcase,
  MessageSquare,
  Calendar,
  CheckSquare,
  BookOpen,
  Wallet,
  Settings,
} from "lucide-astro";

const FEATURES = [
  {
    id: "command",
    title: "Command",
    body: "Describe the work in plain English. The agent invoices, books, texts, and files it — the same tools you'd click, including Siri.",
    icon: Sparkles,
    crumb: "Chat",
    pills: ["Agent", "/invoice"],
    rail: 4,
  },
  {
    id: "continuity",
    title: "Continuity",
    body: "Add a contact once. Inbox, jobs, billing, and their portal all share the same record — no second CRM.",
    icon: Users,
    crumb: "Contacts",
    pills: ["Sarah Chen", "Portal live"],
    rail: 2,
  },
  {
    id: "visibility",
    title: "Visibility",
    body: "Open jobs, unpaid invoices, and the inbox on one screen. The status your client sees is the same one you do.",
    icon: Eye,
    crumb: "Dashboard",
    pills: ["This week"],
    rail: 0,
  },
  {
    id: "presence",
    title: "Presence",
    body: "Your name, logo, and domain on the portal, the website, and every email. Clients never see our brand.",
    icon: Palette,
    crumb: "Portal",
    pills: ["Northline", "Your brand"],
    rail: 2,
  },
] as const;

const SIDEBAR = [
  LayoutDashboard,
  Inbox,
  Users,
  Briefcase,
  MessageSquare,
  Calendar,
  CheckSquare,
  BookOpen,
  Wallet,
  Settings,
];
---

<section
  id="software"
  class="home-software"
  data-home-section="software"
  data-no-scroll-fade
  aria-labelledby="home-software-title"
>
  <div class="sw-intro scroll-fade-in">
    <h2 id="home-software-title" class="sw-title">
      One OS. One agent. The whole workday.
    </h2>
    <p class="sw-lead">
      Click it, type it, or ask Siri. Contacts, jobs, inbox, and billing stay on
      the same record — and the agent can run them for you.
    </p>
  </div>

  <div class="sw-track" data-sw-track>
    <div class="sw-pin" data-sw-pin>
      <ul class="sw-list" role="tablist" aria-label="Software features">
        {
          FEATURES.map((feature, index) => {
            const Icon = feature.icon;
            return (
              <li>
                <button
                  type="button"
                  class:list={["sw-item", index === 0 && "is-active"]}
                  role="tab"
                  id={`sw-tab-${feature.id}`}
                  aria-selected={index === 0 ? "true" : "false"}
                  aria-controls={`sw-panel-${feature.id}`}
                  data-sw-item
                  data-sw-index={String(index)}
                  data-sw-crumb={feature.crumb}
                  data-sw-pills={feature.pills.join("|")}
                  data-sw-rail={String(feature.rail)}
                >
                  <span class="sw-item-icon" aria-hidden="true">
                    <Icon size={16} strokeWidth={1.75} />
                  </span>
                  <span class="sw-item-copy">
                    <span class="sw-item-title">{feature.title}</span>
                    <span class="sw-item-body">{feature.body}</span>
                  </span>
                </button>
              </li>
            );
          })
        }
      </ul>

      <div class="sw-window" data-sw-window>
        <aside class="sw-rail" aria-hidden="true">
          {
            SIDEBAR.map((Icon, i) => (
              <span class:list={["sw-rail-btn", i === FEATURES[0].rail && "is-on"]}>
                <Icon size={15} strokeWidth={1.75} />
              </span>
            ))
          }
        </aside>
        <div class="sw-stage">
          <header class="sw-chrome">
            <span class="sw-crumb" data-sw-crumb>{FEATURES[0].crumb}</span>
            <span class="sw-pills" data-sw-pills>
              {FEATURES[0].pills.map((pill) => (
                <span class="sw-pill">{pill}</span>
              ))}
            </span>
          </header>
          <div class="sw-panels">
            <div
              class="sw-panel is-active"
              id="sw-panel-command"
              role="tabpanel"
              aria-labelledby="sw-tab-command"
              data-sw-panel
              aria-hidden="false"
            >
              <div class="sw-split">
                <div class="sw-col">
                  <div class="sw-chat">
                    <div class="sw-bubble sw-bubble--user">
                      Invoice Sarah Chen $2,400 for the Henderson kitchen remodel.
                    </div>
                    <div class="sw-bubble sw-bubble--agent">
                      Drafted <b>INV-1842</b> — $2,400 due on receipt, tied to
                      Henderson kitchen. Ready to send?
                    </div>
                    <div class="sw-actions">
                      <span class="sw-confirm">Send invoice</span>
                      <span class="sw-ghost">Edit draft</span>
                    </div>
                  </div>
                </div>
                <div class="sw-col">
                  <div class="sw-card">
                    <div class="sw-card-head">
                      <strong>INV-1842</strong>
                      <span class="sw-badge">Draft</span>
                    </div>
                    <label class="sw-field">
                      <span>To</span>
                      <span class="sw-input">Sarah Chen · Henderson Kitchen</span>
                    </label>
                    <label class="sw-field">
                      <span>Project</span>
                      <span class="sw-input">Henderson kitchen remodel</span>
                    </label>
                    <label class="sw-field sw-field--split">
                      <span>Amount</span>
                      <span class="sw-input">$2,400.00</span>
                    </label>
                    <p class="sw-note">Lands on her portal Billing tab the moment you send.</p>
                  </div>
                </div>
              </div>
            </div>

            <div
              class="sw-panel"
              id="sw-panel-continuity"
              role="tabpanel"
              aria-labelledby="sw-tab-continuity"
              data-sw-panel
              aria-hidden="true"
            >
              <div class="sw-split">
                <div class="sw-col">
                  <div class="sw-card sw-contact">
                    <div class="sw-contact-head">
                      <span class="sw-avatar" aria-hidden="true">SC</span>
                      <div>
                        <strong>Sarah Chen</strong>
                        <em>Henderson Kitchen</em>
                      </div>
                    </div>
                    <div class="sw-meta">
                      <span>sarah@henderson.demo</span>
                      <span>(415) 555-0142</span>
                    </div>
                    <div class="sw-tags">
                      <span>Client</span>
                      <span>Kitchen</span>
                      <span>Portal</span>
                    </div>
                  </div>
                </div>
                <div class="sw-col">
                  <div class="sw-card">
                    <div class="sw-card-head">
                      <strong>Same record everywhere</strong>
                    </div>
                    {
                      [
                        ["Henderson kitchen", "Active job"],
                        ["INV-1842 · $2,400", "Sent"],
                        ["“See you Thursday”", "Last text"],
                        ["northline.demo/c/sarah", "Portal · 2 viewed"],
                      ].map(([name, detail]) => (
                        <div class="sw-row">
                          <span>{name}</span>
                          <em>{detail}</em>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>

            <div
              class="sw-panel"
              id="sw-panel-visibility"
              role="tabpanel"
              aria-labelledby="sw-tab-visibility"
              data-sw-panel
              aria-hidden="true"
            >
              <div class="sw-split">
                <div class="sw-col">
                  <div class="sw-stats">
                    <div class="sw-stat">
                      <span class="sw-stat-k">Active jobs</span>
                      <span class="sw-stat-v">4</span>
                    </div>
                    <div class="sw-stat">
                      <span class="sw-stat-k">Outstanding</span>
                      <span class="sw-stat-v">$4,280</span>
                    </div>
                    <div class="sw-stat">
                      <span class="sw-stat-k">Unread</span>
                      <span class="sw-stat-v">3</span>
                    </div>
                  </div>
                  <div class="sw-card">
                    <div class="sw-card-head">
                      <strong>Work</strong>
                      <span class="sw-badge sw-badge--ok">Live on portal</span>
                    </div>
                    {
                      [
                        ["Henderson kitchen", "Active", "Fri"],
                        ["Alvarez deck", "Quote", "Tue"],
                        ["Chen bathroom", "Review", "Today"],
                      ].map(([name, status, due]) => (
                        <div class="sw-job">
                          <span>{name}</span>
                          <span class="sw-status">{status}</span>
                          <span class="sw-due">{due}</span>
                        </div>
                      ))
                    }
                  </div>
                </div>
                <div class="sw-col">
                  <div class="sw-card">
                    <div class="sw-card-head">
                      <strong>Inbox</strong>
                    </div>
                    {
                      [
                        ["Sarah Chen", "Signed the proposal"],
                        ["Pete Alvarez", "Running 20 min late"],
                        ["Payments", "INV-1842 paid · $2,400"],
                      ].map(([from, preview]) => (
                        <div class="sw-row">
                          <span>{from}</span>
                          <em>{preview}</em>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>

            <div
              class="sw-panel"
              id="sw-panel-presence"
              role="tabpanel"
              aria-labelledby="sw-tab-presence"
              data-sw-panel
              aria-hidden="true"
            >
              <div class="sw-split">
                <div class="sw-col">
                  <div class="sw-portal">
                    <div class="sw-portal-bar">
                      <span class="sw-portal-mark" aria-hidden="true">N</span>
                      <strong>Northline</strong>
                      <em>Client portal</em>
                    </div>
                    <div class="sw-portal-body">
                      <span class="sw-portal-kicker">Henderson kitchen</span>
                      <p>Remodel is <b>active</b> — same status as the job on your dashboard.</p>
                      <div class="sw-portal-pay">
                        <span>INV-1842</span>
                        <span class="sw-confirm">Pay $2,400</span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="sw-col">
                  <div class="sw-prompt">
                    <p>Change the homepage headline to Summer specials are live.</p>
                  </div>
                  <div class="sw-card">
                    <div class="sw-card-head">
                      <strong>Website</strong>
                      <span class="sw-badge sw-badge--ok">Published</span>
                    </div>
                    <p class="sw-site-line">Summer specials are live.</p>
                    <p class="sw-note">
                      The agent commits the copy. Your host publishes it — no CMS login.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function prefersReducedMotion() {
    return (
      typeof matchMedia !== "undefined" &&
      matchMedia("(prefers-reduced-motion: reduce)").matches
    );
  }

  function bindSoftwareShowcase(root: HTMLElement) {
    if (root.dataset.swBound === "1") return;
    root.dataset.swBound = "1";

    const track = root.querySelector<HTMLElement>("[data-sw-track]");
    const pin = root.querySelector<HTMLElement>("[data-sw-pin]");
    const items = [...root.querySelectorAll<HTMLButtonElement>("[data-sw-item]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-sw-panel]")];
    const crumb = root.querySelector<HTMLElement>("[data-sw-crumb]");
    const pills = root.querySelector<HTMLElement>("[data-sw-pills]");
    const railBtns = [...root.querySelectorAll<HTMLElement>(".sw-rail-btn")];
    if (!track || !pin || items.length === 0) return;

    const count = items.length;
    let active = 0;
    let ticking = false;
    let programmatic = false;

    const headerOffset = () => {
      const styles = getComputedStyle(document.documentElement);
      return Number.parseFloat(styles.scrollPaddingTop) || 0;
    };

    function setChrome(index: number) {
      const item = items[index];
      if (!item) return;
      if (crumb && item.dataset.swCrumb) crumb.textContent = item.dataset.swCrumb;
      if (pills && item.dataset.swPills) {
        pills.replaceChildren(
          ...item.dataset.swPills.split("|").map((label) => {
            const span = document.createElement("span");
            span.className = "sw-pill";
            span.textContent = label;
            return span;
          }),
        );
      }
      const railIdx = Number.parseInt(item.dataset.swRail ?? "0", 10);
      railBtns.forEach((btn, i) => btn.classList.toggle("is-on", i === railIdx));
    }

    function setActive(next: number) {
      if (next === active) return;
      active = next;
      items.forEach((item, i) => {
        const on = i === next;
        item.classList.toggle("is-active", on);
        item.setAttribute("aria-selected", on ? "true" : "false");
        item.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        const on = i === next;
        panel.classList.toggle("is-active", on);
        panel.setAttribute("aria-hidden", on ? "false" : "true");
      });
      setChrome(next);
    }

    function progressToIndex() {
      const rect = track!.getBoundingClientRect();
      const pinH = pin!.offsetHeight;
      const travel = Math.max(1, track!.offsetHeight - pinH);
      const start = headerOffset();
      const raw = (start - rect.top) / travel;
      const p = Math.min(1, Math.max(0, raw));
      return Math.min(count - 1, Math.floor(p * count + 1e-6));
    }

    function onScroll() {
      if (programmatic || ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        setActive(progressToIndex());
      });
    }

    function scrollToIndex(index: number) {
      const pinH = pin!.offsetHeight;
      const travel = Math.max(1, track!.offsetHeight - pinH);
      const start = headerOffset();
      const top = track!.getBoundingClientRect().top + window.scrollY;
      const y = top - start + ((index + 0.35) / count) * travel;
      programmatic = true;
      setActive(index);
      window.scrollTo({
        top: Math.max(0, y),
        behavior: prefersReducedMotion() ? "auto" : "smooth",
      });
      window.setTimeout(() => {
        programmatic = false;
      }, prefersReducedMotion() ? 50 : 700);
    }

    items.forEach((item, i) => {
      item.tabIndex = i === 0 ? 0 : -1;
      item.addEventListener("click", () => scrollToIndex(i));
    });

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    setChrome(0);
    setActive(progressToIndex());
  }

  function boot() {
    document.querySelectorAll<HTMLElement>(".home-software").forEach(bindSoftwareShowcase);
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>

<style>
  .home-software {
    --sw-accent: #6d5cff;
    --sw-accent-soft: #ece9ff;
    --sw-ink: #1c1c22;
    --sw-muted: #6b6b78;
    --sw-line: rgba(28, 28, 34, 0.1);
    --sw-paper: #fff;
    --sw-wash: #f3f3f6;
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--home-section-padding-y, 80px) 24px;
    background: var(--sw-wash);
  }

  .sw-intro {
    width: 100%;
    max-width: 760px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .sw-title {
    margin: 0 0 14px;
    font-family: var(--font-primary);
    font-size: var(--home-section-title-size, clamp(1.5rem, 3.5vw, 2rem));
    font-weight: var(--home-section-title-weight, 700);
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--site-fg, #171717);
  }

  .sw-lead {
    margin: 0 auto;
    max-width: 46ch;
    font-family: var(--font-content);
    font-size: var(--home-copy-lead-size, 1.02rem);
    line-height: 1.55;
    color: var(--site-fg-muted, #525252);
  }

  .sw-track {
    --sw-pin-h: calc(
      100svh - var(--app-header-offset, 4rem) - var(--home-sticky-cta-h, 2.75rem) - 28px
    );
    height: calc(var(--sw-pin-h) * 4);
    position: relative;
  }

  .sw-pin {
    position: sticky;
    top: calc(var(--app-header-offset, 4rem) + 8px);
    height: var(--sw-pin-h);
    display: grid;
    grid-template-columns: minmax(220px, 300px) minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    max-width: 1240px;
    margin: 0 auto;
    padding-bottom: 24px;
  }

  .sw-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sw-item {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 12px;
    width: 100%;
    padding: 10px 8px;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: var(--sw-muted);
    border-radius: 12px;
  }

  .sw-item-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: #e4e4ea;
    color: #7a7a86;
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }

  .sw-item-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding-top: 5px;
  }

  .sw-item-title {
    font-family: var(--font-primary);
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: inherit;
  }

  .sw-item-body {
    display: block;
    max-height: 0;
    overflow: hidden;
    font-family: var(--font-content);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--sw-muted);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      max-height 0.35s ease,
      opacity 0.28s ease,
      transform 0.28s ease;
  }

  .sw-item.is-active {
    color: var(--sw-ink);
  }

  .sw-item.is-active .sw-item-icon {
    background: var(--sw-accent-soft);
    color: var(--sw-accent);
  }

  .sw-item.is-active .sw-item-body {
    max-height: 7.5rem;
    opacity: 1;
    transform: none;
  }

  .sw-window {
    height: min(720px, calc(var(--sw-pin-h) - 8px));
    display: flex;
    min-width: 0;
    background: var(--sw-paper);
    border: 1px solid var(--sw-line);
    border-radius: 16px;
    box-shadow:
      0 24px 60px rgba(28, 28, 34, 0.1),
      0 2px 8px rgba(28, 28, 34, 0.04);
    overflow: hidden;
  }

  .sw-rail {
    width: 48px;
    flex: 0 0 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 0;
    background: #f6f6f8;
    border-right: 1px solid var(--sw-line);
    color: #8b8b96;
  }

  .sw-rail-btn {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 8px;
  }

  .sw-rail-btn.is-on {
    color: var(--sw-accent);
    background: var(--sw-accent-soft);
  }

  .sw-stage {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: #fafafb;
  }

  .sw-chrome {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 16px;
    border-bottom: 1px solid var(--sw-line);
    background: var(--sw-paper);
  }

  .sw-crumb {
    font-family: var(--font-primary);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sw-ink);
  }

  .sw-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .sw-pill {
    font-size: 0.68rem;
    font-weight: 650;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--sw-accent-soft);
    color: var(--sw-accent);
  }

  .sw-panels {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  .sw-panel {
    position: absolute;
    inset: 0;
    padding: 16px;
    overflow: auto;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sw-panel.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .sw-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    min-height: 100%;
  }

  .sw-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .sw-prompt,
  .sw-card,
  .sw-chat,
  .sw-portal {
    background: var(--sw-paper);
    border: 1px solid var(--sw-line);
    border-radius: 12px;
    padding: 12px 14px;
  }

  .sw-prompt p {
    margin: 0;
    font-family: var(--font-content);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--sw-ink);
  }

  .sw-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }

  .sw-card-head strong {
    font-family: var(--font-primary);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .sw-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 999px;
    background: #eef2ff;
    color: #4f46e5;
  }

  .sw-badge--ok {
    background: #ecfdf3;
    color: #15803d;
  }

  .sw-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 8px;
    font-size: 0.7rem;
    color: var(--sw-muted);
  }

  .sw-input {
    display: block;
    padding: 7px 9px;
    border-radius: 8px;
    border: 1px solid var(--sw-line);
    background: #f7f7f9;
    color: var(--sw-ink);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .sw-confirm,
  .sw-ghost {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 650;
  }

  .sw-confirm {
    background: #4f46e5;
    color: #fff;
  }

  .sw-ghost {
    background: #f3f3f6;
    color: var(--sw-ink);
  }

  .sw-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sw-chat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
