---
/**
 * Mobile-first landing for tech / Salesforce consulting firms.
 * Stratus Hub: chalkboard green, gears, boutique shop — not generic SaaS blue.
 */
import type { SiteLandingConfig } from "../../lib/siteContent";
import { getSiteContent } from "../../lib/siteContent";
import { getCompanyConfig } from "../../lib/companyConfig";
import { contactTelHref } from "../../lib/contactApi";

interface Props {
  landing: SiteLandingConfig;
}

const { landing } = Astro.props;
const company = await getCompanyConfig(Astro.request);
const site = getSiteContent();
const year = new Date().getFullYear();

const phoneDisplay = (landing.contact?.phone || company.supportPhone || "").trim();
const digits = contactTelHref(
  landing.contact?.phoneHref?.replace(/^tel:/i, "") || phoneDisplay,
);
const phoneHref = digits ? `tel:${digits}` : "";
const email = (landing.contact?.email || company.supportEmail || "").trim();
const emailHref = email ? `mailto:${email}` : "";

const logoSrc = (landing.heroLogo || "").trim();
const heroImage = (landing.heroImage || "").trim();
const services = landing.services;
const serviceItems =
  services?.items?.map((item) =>
    typeof item === "string"
      ? { label: item, description: undefined as string | undefined }
      : { label: item.label, description: item.description },
  ) ?? [];
const numbers = landing.numbers;
const reviews = landing.reviews;
const about = landing.about;
const contact = landing.contact;
const inquiry = landing.inquiry;
const team = landing.team;
const badges = landing.badges;
const clientLogos = site.clientLogos ?? [];
const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<div class="tech">
  <header class="tech-header">
    {
      logoSrc ? (
        <a class="tech-header__logo" href="#top">
          <img src={logoSrc} alt={landing.name || company.name} width="180" height="50" />
        </a>
      ) : (
        <a class="tech-header__name" href="#top">{landing.name || company.name}</a>
      )
    }
    <div class="tech-header__actions">
      <a class="tech-header__login" href="/sign-in">Login</a>
      <a class="tech-header__contact" href="#contact">Contact</a>
      <button
        class="tech-menu"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="tech-nav"
        data-tech-menu
      >
        <span class="tech-menu__line"></span>
        <span class="tech-menu__line"></span>
      </button>
    </div>
  </header>

  <nav class="tech-nav" id="tech-nav" data-tech-nav>
    {services && <a href="#services">What We Do</a>}
    {clientLogos.length > 0 && <a href="#clients">Clients</a>}
    {reviews && <a href="#reviews">Testimonials</a>}
    {team && <a href="#team">Team</a>}
    <a href="#contact">Contact</a>
    <a href="/sign-in">Login</a>
  </nav>

  <main id="top">
    <section class="tech-hero" style={heroImage ? `--hero:url('${heroImage}')` : undefined}>
      <div class="tech-hero__veil"></div>
      <div class="tech-hero__inner">
        {landing.eyebrow && <p class="tech-kicker">{landing.eyebrow}</p>}
        <div class="tech-hero__card">
          <h1>{landing.heroHeadline || landing.tagline || landing.name}</h1>
        </div>
        {landing.heroBody && <p class="tech-lede">{landing.heroBody}</p>}
        <div class="tech-actions">
          <a class="tech-btn tech-btn--teal" href="#contact">Contact</a>
          {
            phoneHref && (
              <a class="tech-btn tech-btn--ghost" href={phoneHref}>
                {phoneDisplay}
              </a>
            )
          }
        </div>
      </div>
    </section>

    {
      serviceItems.length > 0 && (
        <section class="tech-section" id="services">
          <div class="tech-wrap">
            <p class="tech-kicker">Solutions</p>
            <h2>{services?.heading || "What we do"}</h2>
            <ol class="tech-services">
              {
                serviceItems.map((item, i) => (
                  <li class="tech-service">
                    <span class="tech-service__n">{pad(i)}</span>
                    <div>
                      <h3>{item.label}</h3>
                      {item.description && <p>{item.description}</p>}
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>
      )
    }

    {
      numbers && (
        <section class="tech-board" id="numbers">
          <div class="tech-wrap">
            <p class="tech-kicker tech-kicker--light">Expertise</p>
            <h2>{numbers.heading}</h2>
            {numbers.intro && <p class="tech-intro tech-intro--light">{numbers.intro}</p>}
            <div class="tech-stats">
              {
                numbers.stats.map((stat) => (
                  <article>
                    <strong>{stat.value}</strong>
                    <span>{stat.label}</span>
                  </article>
                ))
              }
            </div>
            {
              badges?.items?.length ? (
                <div class="tech-badges" aria-label={badges.heading || "Certifications"}>
                  {badges.items.map((badge) => (
                    <img src={badge.src} alt={badge.alt} width="220" height="126" />
                  ))}
                </div>
              ) : null
            }
          </div>
        </section>
      )
    }

    {
      clientLogos.length > 0 && (
        <section class="tech-section tech-section--tight" id="clients">
          <div class="tech-wrap">
            <p class="tech-kicker">Our clients</p>
            <h2>Companies we have the pleasure of working with</h2>
            <ul class="tech-logos">
              {
                clientLogos.map((logo) => (
                  <li>
                    <img
                      src={logo.image}
                      alt={logo.name}
                      width={logo.width || 120}
                      height={logo.height || 80}
                    />
                  </li>
                ))
              }
            </ul>
          </div>
        </section>
      )
    }

    {
      reviews?.items?.length ? (
        <section class="tech-section tech-section--paper" id="reviews">
          <div class="tech-wrap">
            <p class="tech-kicker">Testimonials</p>
            <h2>{reviews.heading}</h2>
            {reviews.intro && <p class="tech-intro">{reviews.intro}</p>}
          </div>
          <div class="tech-reviews" data-tech-reviews>
            {
              reviews.items.map((item) => (
                <article class="tech-review">
                  {item.stars && <p class="tech-stars">{item.stars}</p>}
                  <blockquote>“{item.quote}”</blockquote>
                  <cite>{item.cite}</cite>
                </article>
              ))
            }
          </div>
        </section>
      ) : null
    }

    {
      team?.members?.length ? (
        <section class="tech-section" id="team">
          <div class="tech-wrap">
            <p class="tech-kicker">Company</p>
            <h2>{team.heading}</h2>
            {team.intro && <p class="tech-intro">{team.intro}</p>}
            <div class="tech-team">
              {
                team.members.map((member) => (
                  <article class="tech-member">
                    {member.photo && (
                      <img
                        src={member.photo}
                        alt={member.photoAlt || member.name}
                        width="300"
                        height="300"
                      />
                    )}
                    <div>
                      <h3>{member.name}</h3>
                      <p class="tech-member__role">{member.role}</p>
                      {member.bio && <p>{member.bio}</p>}
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </section>
      ) : null
    }

    {
      about && (
        <section class="tech-section tech-section--paper" id="about">
          <div class="tech-wrap tech-about">
            <p class="tech-kicker">About</p>
            <h2>{about.heading}</h2>
            {about.body?.map((para) => <p>{para}</p>)}
            {
              about.highlights?.length ? (
                <ul class="tech-highlights">
                  {about.highlights.map((item) => <li>{item}</li>)}
                </ul>
              ) : null
            }
          </div>
        </section>
      )
    }

    <section class="tech-contact-band" id="contact">
      <div class="tech-wrap tech-contact">
        <div>
          <p class="tech-kicker tech-kicker--light">Contact</p>
          <h2>{contact?.heading || "Start a project."}</h2>
          <p class="tech-intro tech-intro--light">
            Call, email, or send a message — we’ll get back to you quickly.
          </p>
          <ul class="tech-contact-list">
            {
              phoneHref && (
                <li>
                  <strong>Phone</strong>
                  <a href={phoneHref}>{phoneDisplay}</a>
                </li>
              )
            }
            {
              email && (
                <li>
                  <strong>Email</strong>
                  <a href={emailHref}>{email}</a>
                </li>
              )
            }
            {
              contact?.officeLines?.length ? (
                <li>
                  <strong>Office</strong>
                  <address>
                    {
                      contact.officeLines.map((line, i) => (
                        <>
                          {i > 0 && <br />}
                          {line}
                        </>
                      ))
                    }
                  </address>
                </li>
              ) : null
            }
          </ul>
        </div>

        {
          inquiry && (
            inquiry.web3formsAccessKey ? (
              <form class="tech-form" action="https://api.web3forms.com/submit" method="POST">
                <input type="hidden" name="access_key" value={inquiry.web3formsAccessKey} />
                <input type="hidden" name="subject" value={inquiry.subject || "New website inquiry"} />
                <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
                <h2>{inquiry.heading}</h2>
                <p>{inquiry.intro}</p>
                <label>
                  Name
                  <input type="text" name="name" required autocomplete="name" />
                </label>
                <label>
                  Email
                  <input type="email" name="email" required autocomplete="email" />
                </label>
                <label>
                  Phone
                  <input type="tel" name="phone" autocomplete="tel" />
                </label>
                <label>
                  Message
                  <textarea name="message" rows="5" required />
                </label>
                <button class="tech-btn tech-btn--teal" type="submit">
                  {inquiry.submitLabel || "Send message"}
                </button>
              </form>
            ) : (
              <div class="tech-form tech-form--plain">
                <h2>{inquiry.heading}</h2>
                <p>{inquiry.intro}</p>
                <div class="tech-actions">
                  {emailHref && <a class="tech-btn tech-btn--teal" href={emailHref}>Email the team</a>}
                  {phoneHref && <a class="tech-btn tech-btn--ghost" href={phoneHref}>{phoneDisplay}</a>}
                </div>
              </div>
            )
          )
        }
      </div>
    </section>
  </main>

  <footer class="tech-footer">
    <p>&copy; {year} {landing.footer || landing.name || company.name}</p>
  </footer>
</div>

<script is:inline>
  const toggle = document.querySelector("[data-tech-menu]");
  const nav = document.querySelector("[data-tech-nav]");
  const setOpen = (open) => {
    toggle?.classList.toggle("is-open", open);
    nav?.classList.toggle("is-open", open);
    document.body.classList.toggle("tech-nav-open", open);
    if (toggle) {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    }
  };
  toggle?.addEventListener("click", () => setOpen(!toggle.classList.contains("is-open")));
  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
</script>

<style>
  .tech {
    --tech-board: #2f4a2c;
    --tech-leaf: #6f8f3c;
    --tech-teal: #2a7a8a;
    --tech-paper: #f4efe4;
    --tech-ink: #1c1c1c;
    --tech-muted: #5a574e;
    --tech-cream: #fffdf8;
  }

  .tech-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    background: rgba(255, 253, 248, 0.94);
    border-bottom: 1px solid rgba(47, 74, 44, 0.1);
    backdrop-filter: blur(10px);
  }

  .tech-header__logo img {
    display: block;
    height: 2.1rem;
    width: auto;
    max-width: 9.5rem;
    object-fit: contain;
  }

  .tech-header__name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--tech-board);
    text-decoration: none;
  }

  .tech-header__actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .tech-header__login {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tech-board);
    text-decoration: none;
  }

  .tech-header__contact {
    display: none;
    min-height: 2.2rem;
    padding: 0.4rem 0.85rem;
    background: var(--tech-teal);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .tech-menu {
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .tech-menu__line {
    position: absolute;
    left: 0.55rem;
    width: 1.4rem;
    height: 2px;
    background: var(--tech-board);
    transition: transform 0.3s ease;
  }

  .tech-menu__line:first-child { top: 0.95rem; }
  .tech-menu__line:last-child { top: 1.45rem; }

  .tech-menu.is-open .tech-menu__line:first-child {
    transform: translateY(0.25rem) rotate(45deg);
  }

  .tech-menu.is-open .tech-menu__line:last-child {
    transform: translateY(-0.25rem) rotate(-45deg);
  }

  .tech-nav {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    padding: 5rem 1.5rem 2rem;
    background: var(--tech-paper);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .tech-nav.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .tech-nav a {
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(1.6rem, 6vw, 2.2rem);
    font-weight: 500;
    color: var(--tech-board);
    text-decoration: none;
  }

  body.tech-nav-open { overflow: hidden; }

  .tech-hero {
    position: relative;
    min-height: 86vh;
    display: grid;
    align-items: end;
    color: #fff;
    background: var(--tech-board) center/cover no-repeat;
    background-image: var(--hero);
  }

  .tech-hero__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 32, 18, 0.28) 0%, rgba(20, 32, 18, 0.72) 100%);
  }

  .tech-hero__inner {
    position: relative;
    z-index: 1;
    width: min(720px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 5.5rem 0 2.75rem;
  }

  .tech-hero__card {
    background: rgba(255, 253, 248, 0.94);
    color: var(--tech-ink);
    padding: 1.15rem 1.2rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
  }

  .tech-hero h1 {
    margin: 0;
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(1.85rem, 7vw, 3.1rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .tech-lede {
    margin: 1.15rem 0 0;
    max-width: 36rem;
    font-size: 1.02rem;
    line-height: 1.6;
    color: rgba(255, 253, 248, 0.9);
  }

  .tech-kicker {
    margin: 0 0 0.65rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tech-leaf);
  }

  .tech-hero .tech-kicker { color: #d4e3a6; }

  .tech-kicker--light { color: #c5d89a; }

  .tech-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.4rem;
  }

  .tech-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.9rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid transparent;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .tech-btn--teal { background: var(--tech-teal); color: #fff; }
  .tech-btn--ghost { background: transparent; border-color: rgba(255,255,255,0.55); color: #fff; }

  .tech-section { padding: 3.4rem 0; }
  .tech-section--tight { padding: 2.4rem 0; }
  .tech-section--paper { background: var(--tech-paper); }

  .tech-board {
    padding: 3.4rem 0;
    background: var(--tech-board);
    color: #fff;
  }

  .tech-board h2 { color: #fff; }

  .tech-wrap {
    width: min(1080px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .tech-section h2,
  .tech-board h2,
  .tech-contact h2 {
    margin: 0 0 0.85rem;
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(1.7rem, 5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--tech-board);
    letter-spacing: -0.02em;
  }

  .tech-intro {
    margin: 0 0 1.4rem;
    color: var(--tech-muted);
    line-height: 1.6;
    max-width: 38rem;
  }

  .tech-intro--light { color: rgba(255, 253, 248, 0.78); }

  .tech-services {
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .tech-service {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.95rem;
    padding: 1.15rem 1.1rem;
    background: var(--tech-cream);
    border: 1px solid rgba(47, 74, 44, 0.1);
  }

  .tech-service__n {
    font-family: Fraunces, Georgia, serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--tech-leaf);
    line-height: 1;
  }

  .tech-service h3 {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    color: var(--tech-board);
  }

  .tech-service p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--tech-muted);
  }

  .tech-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin-top: 1.4rem;
    background: rgba(255, 255, 255, 0.12);
  }

  .tech-stats article {
    padding: 1.3rem 0.9rem;
    background: rgba(20, 32, 18, 0.28);
    text-align: center;
  }

  .tech-stats strong {
    display: block;
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(1.7rem, 5vw, 2.3rem);
    font-weight: 600;
    color: #d4e3a6;
  }

  .tech-stats span {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.78rem;
    color: rgba(255, 253, 248, 0.75);
  }

  .tech-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.4rem;
    margin-top: 2rem;
  }

  .tech-badges img {
    height: 4.4rem;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.25));
  }

  .tech-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.4rem 1.8rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tech-logos img {
    display: block;
    height: 3.25rem;
    width: auto;
    max-width: 7.5rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.78;
  }

  .tech-reviews {
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 1rem 0.4rem;
    margin-top: 0.4rem;
  }

  .tech-review {
    flex: 0 0 min(86vw, 22rem);
    scroll-snap-align: start;
    padding: 1.3rem 1.25rem;
    background: var(--tech-cream);
    border: 1px solid rgba(47, 74, 44, 0.1);
  }

  .tech-stars { margin: 0 0 0.45rem; color: var(--tech-leaf); }
  .tech-review blockquote {
    margin: 0 0 0.85rem;
    font-family: Fraunces, Georgia, serif;
    font-size: 1.08rem;
    line-height: 1.45;
    color: var(--tech-ink);
  }
  .tech-review cite {
    font-style: normal;
    font-size: 0.82rem;
    color: var(--tech-muted);
  }

  .tech-team { display: grid; gap: 1.4rem; margin-top: 1.2rem; }

  .tech-member {
    display: grid;
    gap: 1rem;
    padding: 1.15rem;
    background: var(--tech-cream);
    border: 1px solid rgba(47, 74, 44, 0.1);
  }

  .tech-member img {
    width: 100%;
    max-width: 11rem;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--tech-paper);
  }

  .tech-member h3 {
    margin: 0;
    font-family: Fraunces, Georgia, serif;
    font-size: 1.35rem;
    color: var(--tech-board);
  }

  .tech-member__role {
    margin: 0.2rem 0 0.7rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tech-teal);
  }

  .tech-member p:last-child {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--tech-muted);
  }

  .tech-about p {
    max-width: 40rem;
    line-height: 1.65;
    color: var(--tech-muted);
  }

  .tech-highlights {
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .tech-highlights li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.95rem;
    color: var(--tech-muted);
  }

  .tech-highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--tech-leaf);
  }

  .tech-contact-band {
    padding: 3.4rem 0;
    background: var(--tech-board);
