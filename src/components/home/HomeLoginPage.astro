---
import Header from "../Header.astro";
import Favicon from "../Favicon.astro";
import ViewportMeta from "../ViewportMeta.astro";
import ThemeInit from "../ThemeInit.astro";
import { isClerkFrontendConfigured } from "../../lib/clerkClient";
import { getCompanyConfig } from "../../lib/companyConfig";
import "../../styles/mobile-touch.css";
import "../../styles/brand.css";

const company = await getCompanyConfig(Astro.request);
const clerkReady = isClerkFrontendConfigured();
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeInit />
    <meta charset="UTF-8" />
    <ViewportMeta />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <title>Sign In — {company.name}</title>
    <Favicon />
  </head>
  <body data-user-id="">
    <Header signInAutoOpen={clerkReady} />
    <main class="login-stage">
      <h1>{company.name}</h1>
      {
        clerkReady ? (
          <p>Sign in to continue.</p>
        ) : (
          <p>Sign-in is not connected on this install yet.</p>
        )
      }
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    color-scheme: light dark;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    background: var(--site-canvas, #fff);
    color: var(--site-fg, #171717);
  }

  .login-stage {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    gap: 0.75rem;
    padding: 5rem 1.5rem 2rem;
    text-align: center;
    color: var(--site-fg, #171717);
  }

  .login-stage h1 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .login-stage p {
    margin: 0;
    color: var(--site-fg-muted, #525252);
    font-size: 0.95rem;
  }
</style>
