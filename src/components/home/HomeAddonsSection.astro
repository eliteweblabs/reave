---
import CardTitle from "../CardTitle.astro";

type Addon = {
  id: string;
  title: string;
  description: string;
  bullets?: string[];
};

const addons: Addon[] = [
  {
    id: "dealership",
    title: "Car Dealership",
    description:
      "Swipe-to-browse inventory, a six-step lead wizard, and test-drive booking — built for one dealership, ready for the next.",
    bullets: [
      "Public inventory search by make, price, and condition",
      "Magic-link deal flow from vehicle pick to deposit",
      "Test-drive booking tied straight to the lead",
      "Voice widget on inventory for hands-free browsing",
    ],
  },
  {
    id: "fleet",
    title: "Fleet GPS Tracking",
    description:
      "Live GPS for every van, truck, and field crew — on a map dispatch can actually use. Assign a vehicle to a driver and location pings start when they open the app.",
    bullets: [
      "Multi-vehicle map with live location updates",
      "No extra hardware — mobile browser GPS",
      "Agent tools for dispatch-style lookups in chat",
      "Separate fleet-api service on Railway",
    ],
  },
  {
    id: "real-estate",
    title: "Real Estate Data",
    description:
      "Property facts, compliance timelines, hazard profiles, and municipal violations — plus a Lead Scanner that finds nearby properties matching your trades.",
    bullets: [
      "Assessor-backed property lookup and floor area",
      "Compliance timeline by age and state (roof, panel, HVAC, etc.)",
      "Daily geofenced Lead Scanner → inquiry projects",
      "Property Liability Radar with trade-specific lead score",
    ],
  },
  {
    id: "client-portal",
    title: "Client Portal",
    description:
      "A branded portal at /c/:uid where clients see projects, pay invoices, access the vault, and sign documents — without another login to manage.",
    bullets: [
      "Overview, projects, billing, vault, and documents tabs",
      "Magic-link access — no password reset loops",
      "Shareable links with engagement tracking",
    ],
  },
  {
    id: "billing",
    title: "Billing & Invoicing",
    description:
      "Crater-backed invoicing with a client-facing pay flow right on the portal. Outstanding, upcoming, and paid — all in one place.",
    bullets: [
      "Create and send invoices from admin",
      "One-tap Pay links on the client portal",
      "Time-tracking bridge for hourly line items",
    ],
  },
  {
    id: "scheduling",
    title: "Scheduling",
    description:
      "Cal.com booking embedded in the platform — discovery calls, onboarding sessions, and test drives without a separate scheduling tool.",
    bullets: [
      "Book-a-call flows on marketing pages",
      "Meeting links tied to contacts and projects",
      "Agent can check availability in chat",
    ],
  },
  {
    id: "documents",
    title: "Document Signing",
    description:
      "Proposals and contracts that get signed on the same portal the client already trusts — no separate e-sign login.",
    bullets: [
      "Templates for paperwork that needs a signature",
      "Documents tab on the client portal",
      "Status tracking from sent to signed",
    ],
  },
  {
    id: "voice",
    title: "Voice & Call Routing",
    description:
      "Real call routing with Telnyx — answer, qualify, hand off, or book without anyone picking up the phone.",
    bullets: [
      "Inbound call routing and IVR-style flows",
      "Works alongside the homepage voice widget",
      "Conversation layer through to booked appointment",
    ],
  },
  {
    id: "vapi",
    title: "Homepage Voice Widget",
    description:
      "A Vapi-powered voice assistant on your homepage — callers browse inventory, ask questions, or start a deal hands-free.",
    bullets: [
      "Optional upsell add-on (off by default)",
      "Syncs with admin for prompt and tool updates",
      "Pairs with dealership inventory and lead flows",
    ],
  },
  {
    id: "email-marketing",
    title: "Newsletter & Lifecycle Email",
    description:
      "Welcome emails, follow-ups, review requests, and win-back campaigns — sent automatically from your domain via Resend.",
    bullets: [
      "Branded HTML wrapper with logo and CTA",
      "Automations on new contact and project complete",
      "Broadcasts and one-click unsubscribe",
    ],
  },
  {
    id: "monitoring",
    title: "Site Monitoring & Audits",
    description:
      "Uptime checks, change detection, and Lighthouse-style audits — so you know before the client does.",
    bullets: [
      "UptimeRobot sync for production domains",
      "ChangeDetection.io for page diffs",
      "SSL, DNS, broken links, and Lighthouse scores",
    ],
  },
  {
    id: "carddav",
    title: "CardDAV Contact Sync",
    description:
      "The master client list, live in the iPhone Contacts app — one CardDAV account, set up once in iOS Settings.",
    bullets: [
      "No Google account or iCloud detour",
      "Contacts added in admin appear on your phone",
      "Standard vCard format",
    ],
  },
  {
    id: "time-tracking",
    title: "Project Time Tracking",
    description:
      "Log hours and notes on any project — then bridge straight into invoicing when billing is enabled.",
    bullets: [
      "Start/stop timers or manual entries with notes",
      "Invoice suggestions from unbilled hours",
      "Enabled per install — off by default",
    ],
  },
  {
    id: "dev-infra",
    title: "Dev & Deploy Infrastructure",
    description:
      "Git, Railway, Kinsta, and deploy status — for agency installs that ship code, not just configure.",
    bullets: [
      "Inspect repos and trigger deploys from admin",
      "Read Railway logs without opening dashboards",
      "Agent answers \"did my push go live?\"",
    ],
  },
  {
    id: "namecom-dns",
    title: "DNS Record Management",
    description:
      "Add and edit Name.com DNS records from admin — no separate registrar login during launch week.",
    bullets: [
      "List, create, and update DNS records",
      "Agent tools or admin flows",
      "Credentials from client vault when needed",
    ],
  },
];

function inquireHref(addon: Addon): string {
  const message = encodeURIComponent(`I'm interested in the ${addon.title} add-on.`);
  return `/?section=contact&message=${message}`;
}
---

<section
  id="addons"
  class="home-section"
  data-home-section="addons"
  aria-labelledby="addons-title"
>
  <div class="home-section-inner home-addons-inner">
    <header class="home-section-hero">
      <p class="marketing-label">Optional Modules</p>
      <h2 id="addons-title">Industry Add-ons</h2>
      <p class="marketing-lead">
        Vertical-specific modules that plug into the REΛVE platform — turn on what fits your
        business and leave the rest off. Every add-on shares the same admin, contacts, and agent.
      </p>
    </header>

    <div class="card-grid home-addons-grid">
      {
        addons.map((addon) => (
          <article class="card home-addon-card">
            <CardTitle text={addon.title} />
            <p>{addon.description}</p>
            {
              addon.bullets && addon.bullets.length > 0 && (
                <ul class="home-addon-bullets">
                  {addon.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )
            }
            <a class="home-addon-inquire" href={inquireHref(addon)}>
              Inquire
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .home-addons-inner {
    max-width: 960px;
  }

  .home-addons-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .home-addon-card {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .home-addon-card p {
    flex: 1;
    margin-bottom: 12px;
  }

  .home-addon-bullets {
    margin: 0 0 16px;
    padding-left: 18px;
  }

  .home-addon-bullets li {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.62);
    margin-bottom: 6px;
  }

  .home-addon-inquire {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    margin-top: auto;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(168, 85, 247, 0.45);
    font-family: var(--font-primary);
    font-size: 0.85rem;
    font-weight: 600;
    color: #c084fc;
    background: rgba(168, 85, 247, 0.08);
    text-decoration: none;
    transition:
      transform 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .home-addon-inquire:hover {
    background: rgba(168, 85, 247, 0.16);
    border-color: rgba(168, 85, 247, 0.65);
    color: #e9d5ff;
    transform: translateY(-1px);
    text-decoration: none;
  }
</style>
