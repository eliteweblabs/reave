---
/**
 * Clean mobile-vet landing — tandem.vet–inspired layout, config-driven copy.
 */
import type { SiteLandingConfig } from "../../lib/siteContent";
import { getCompanyConfig } from "../../lib/companyConfig";
import { getSiteContent } from "../../lib/siteContent";
import { contactTelHref } from "../../lib/contactApi";
import PawIcon from "../icons/PawIcon.astro";
import { loadSiteLandingReviews } from "../../lib/siteLandingGoogleReviews";
import { SIMPLE_ICONS_CDN } from "../../lib/platformStack";
import "../../styles/vet-landing.css";

interface Props {
  landing: SiteLandingConfig;
}

const { landing } = Astro.props;
const company = await getCompanyConfig(Astro.request);
const siteContent = getSiteContent();
const showSignIn = siteContent.nav.showSignIn !== false;
const contact = landing.contact ?? {};
const inquiry = landing.inquiry;
const about = landing.about ?? {};
const services = landing.services;
const reviewsBlock = await loadSiteLandingReviews(landing.reviews);
const googleIconUrl = SIMPLE_ICONS_CDN("google");
const reviewCarouselItems = reviewsBlock?.items.length
  ? [...reviewsBlock.items, ...reviewsBlock.items]
  : [];
const social = landing.pack?.social ?? {};
const SOCIAL_ICON_META: Record<string, { slug: string; color: string }> = {
  instagram: { slug: "instagram", color: "#e1306c" },
  facebook: { slug: "facebook", color: "#1877f2" },
  twitter: { slug: "x", color: "#1d9bf0" },
  linkedin: { slug: "linkedin", color: "#0a66c2" },
  youtube: { slug: "youtube", color: "#ff0000" },
  tiktok: { slug: "tiktok", color: "#ff0050" },
  google: { slug: "google", color: "#4285f4" },
};
const socialLinks = [
  social.instagramUrl ? { id: "instagram", label: "Instagram", href: social.instagramUrl } : null,
  social.facebookUrl ? { id: "facebook", label: "Facebook", href: social.facebookUrl } : null,
  social.twitterUrl ? { id: "twitter", label: "X", href: social.twitterUrl } : null,
  social.linkedinUrl ? { id: "linkedin", label: "LinkedIn", href: social.linkedinUrl } : null,
  social.youtubeUrl ? { id: "youtube", label: "YouTube", href: social.youtubeUrl } : null,
  social.tiktokUrl ? { id: "tiktok", label: "TikTok", href: social.tiktokUrl } : null,
  social.mapsUrl ? { id: "google", label: "Google", href: social.mapsUrl } : null,
]
  .filter((link): link is { id: string; label: string; href: string } => Boolean(link?.href))
  .map((link) => ({
    ...link,
    icon: SOCIAL_ICON_META[link.id] ?? { slug: "google", color: "#4285f4" },
  }));
const year = new Date().getFullYear();

const brandName = landing.name || company.name || "Book";
const logoSrc =
  (landing.heroLogo || "").trim() ||
  (company.logoPath && company.logoSource !== "hidden"
    ? `${company.logoPath}${company.logoVersion ? `?v=${encodeURIComponent(company.logoVersion)}` : ""}`
    : "");

const phoneDisplay = (contact.phone || company.supportPhone || "").trim();
const phoneDigits = contactTelHref(
  contact.phoneHref?.replace(/^tel:/i, "") || phoneDisplay,
);
const phoneHref = phoneDigits ? `tel:${phoneDigits}` : "";
const phonePretty = phoneDisplay || phoneDigits;
const email = (contact.email || company.supportEmail || "").trim();
const scheduleUrl = landing.scheduleUrl || "/form/schedule";
const heroImage = landing.heroImage || landing.pack?.hero?.mainImage || "";
const aboutImage = landing.pack?.hero?.aboutImage || heroImage;

const navLinks = landing.pack?.nav?.length
  ? landing.pack.nav
  : [
      { href: "#services", label: "Services" },
      { href: "#contact", label: "Contact" },
    ];

const serviceItems =
  services?.items?.map((item) => {
    if (typeof item === "string") {
      return { name: item, blurb: "", bookHref: scheduleUrl };
    }
    return {
      name: item.label,
      blurb: item.description || "",
      bookHref: item.bookHref || scheduleUrl,
    };
  }) ?? [];

const location =
  landing.pack?.social?.city ||
  contact.officeLines?.join(" · ") ||
  "";
const contactHref = inquiry?.web3formsAccessKey ? "#inquiry" : email ? `mailto:${email}` : scheduleUrl;
const contactLabel = landing.callCta?.label || "Contact us";
---

<div class="vet" data-vet-root>
  {showSignIn ? <a class="vet-login" href="/sign-in">Login</a> : null}

  <header class="vet-header">
    <div class="vet-header__inner">
      <a class="vet-header__brand" href="#top" aria-label={brandName}>
        {
          logoSrc ? (
            <img class="vet-header__logo" src={logoSrc} alt={brandName} width="180" height="62" />
          ) : (
            <span>{brandName}</span>
          )
        }
      </a>
      <nav class="vet-header__nav" aria-label="Site">
        {navLinks.map((link) => (
          <a
            class:list={{ "vet-header__nav-btn": link.primary }}
            href={link.href}
          >
            {link.primary ? <PawIcon size={14} /> : null}
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main>
    <section id="top" class="vet-hero">
      <div class="vet-hero__inner">
        <div>
          {
            landing.eyebrow && landing.tagline ? (
              <p class="vet-hero__badge">
                {landing.eyebrow} — {landing.tagline}
              </p>
            ) : landing.eyebrow ? (
              <p class="vet-hero__badge">{landing.eyebrow}</p>
            ) : null
          }
          <h1 class="vet-hero__title">{landing.heroHeadline || brandName}</h1>
          {
            landing.heroBody && (
              <p class="vet-hero__lede">{landing.heroBody}</p>
            )
          }
          <div class="vet-hero__actions">
            <a class="vet-btn-primary" href={contactHref}>
              <PawIcon />
              {contactLabel}
            </a>
            {
              phoneHref ? (
                <a class="vet-btn-secondary" href={phoneHref}>
                  {phonePretty}
                </a>
              ) : null
            }
          </div>
        </div>
        {
          heroImage ? (
            <div class="vet-hero__visual">
              <img
                src={heroImage}
                alt={landing.pack?.hero?.mainAlt || brandName}
                width="640"
                height="800"
                loading="eager"
              />
            </div>
          ) : null
        }
      </div>
    </section>

    {
      serviceItems.length ? (
        <section id="services" class="vet-section vet-section--surface">
          <div class="vet-section__inner">
            <p class="vet-section__eyebrow">What we offer</p>
            <h2 class="vet-section__title">{services?.heading || "Services"}</h2>
            {services?.intro && <p class="vet-section__intro">{services.intro}</p>}
            <div class="vet-services">
              {
                serviceItems.map((service) => (
                  <article class="vet-service">
                    <h3 class="vet-service__name">{service.name}</h3>
                    {service.blurb && <p class="vet-service__blurb">{service.blurb}</p>}
                    <a class="vet-btn-primary vet-service__cta" href={service.bookHref}>
                      <PawIcon />
                      {service.bookHref?.includes("#") ? "Contact us" : "Learn more"}
                    </a>
                  </article>
                ))
              }
            </div>
          </div>
        </section>
      ) : null
    }

    {
      about.body?.length || aboutImage ? (
        <section id="about" class="vet-section">
          <div class="vet-section__inner vet-about">
            {
              aboutImage ? (
                <div class="vet-about__photo">
                  <img
                    src={aboutImage}
                    alt={landing.pack?.hero?.aboutAlt || brandName}
                    loading="lazy"
                  />
                </div>
              ) : null
            }
            <div>
              <p class="vet-section__eyebrow">About</p>
              <h2 class="vet-section__title">{about.heading || brandName}</h2>
              {
                about.body?.map((para) => (
                  <p class="vet-section__intro">{para}</p>
                ))
              }
            </div>
          </div>
        </section>
      ) : null
    }

    {
      reviewsBlock?.items.length ? (
        <section id="reviews" class="vet-section vet-section--surface vet-section--reviews">
          <div class="vet-section__inner vet-reviews__header">
            <p class="vet-section__eyebrow">Reviews</p>
            <div class="vet-reviews__title-row">
              <h2 class="vet-section__title">{reviewsBlock.heading}</h2>
              <p class="vet-reviews__google-badge" aria-label="Reviews sourced from Google">
                <img class="vet-reviews__google-mark" src={googleIconUrl} alt="" width="18" height="18" decoding="async" />
                <span>Google™</span>
              </p>
            </div>
            {reviewsBlock.intro && <p class="vet-section__intro">{reviewsBlock.intro}</p>}
          </div>
          <div
            class="vet-reviews-viewport"
            id="vet-reviews-marquee"
            style={`--vet-reviews-duration: ${Math.max(reviewsBlock.items.length * 16, 55)}s`}
          >
            <div class="vet-reviews__track">
                {
                  reviewCarouselItems.map((item) => {
                    const href = item.href || reviewsBlock.mapsUrl;
                    const CardTag = href ? "a" : "article";
                    return (
                      <CardTag
                        class="vet-review"
                        {...(href
                          ? {
                              href,
                              target: "_blank",
                              rel: "noopener noreferrer",
                              "aria-label": `Read ${item.cite}'s review on Google`,
                            }
                          : {})}
                      >
                        <div class="vet-review__head">
                          {item.stars && <p class="vet-review__stars" aria-hidden="true">{item.stars}</p>}
                          <img
                            class="vet-review__google"
                            src={googleIconUrl}
                            alt=""
                            width="16"
                            height="16"
                            decoding="async"
                          />
                        </div>
                        <blockquote class="vet-review__quote">“{item.quote}”</blockquote>
                        <footer class="vet-review__foot">
                          <cite class="vet-review__cite">{item.cite}</cite>
                          {href ? <span class="vet-review__source">View on Google™</span> : null}
                        </footer>
                      </CardTag>
                    );
                  })
                }
              </div>
          </div>
          {
            reviewsBlock.mapsUrl ? (
              <div class="vet-section__inner">
                <p class="vet-reviews__more">
                  <a class="vet-reviews__more-link" href={reviewsBlock.mapsUrl} target="_blank" rel="noopener noreferrer">
                    <img class="vet-reviews__google-mark" src={googleIconUrl} alt="" width="16" height="16" decoding="async" />
                    <span>See all reviews on Google™</span>
                  </a>
                </p>
              </div>
            ) : null
          }
        </section>
      ) : null
    }

    <section id="contact" class="vet-section vet-section--surface">
      <div class="vet-section__inner">
        <p class="vet-section__eyebrow">Get in touch</p>
        <h2 class="vet-section__title">{contact.heading || "Contact"}</h2>
        <div class="vet-contact-grid">
          {
            location ? (
              <div class="vet-contact-card">
                <p class="vet-contact-card__label">Location</p>
                <p class="vet-contact-card__value">{location}</p>
              </div>
            ) : null
          }
          {
            email ? (
              <div class="vet-contact-card">
                <p class="vet-contact-card__label">Email</p>
                <p class="vet-contact-card__value">
                  <a href={`mailto:${email}`}>{email}</a>
                </p>
              </div>
            ) : null
          }
          {
            phonePretty ? (
              <div class="vet-contact-card">
                <p class="vet-contact-card__label">Phone</p>
                <p class="vet-contact-card__value">
                  <a href={phoneHref}>{phonePretty}</a>
                </p>
              </div>
            ) : null
          }
        </div>
        {
          inquiry?.web3formsAccessKey ? (
            <div class="vet-inquiry" id="inquiry">
              <h3 class="vet-inquiry__title">{inquiry.heading}</h3>
              <p class="vet-inquiry__intro">{inquiry.intro}</p>
              <form class="vet-form" action="https://api.web3forms.com/submit" method="POST">
                <input type="hidden" name="access_key" value={inquiry.web3formsAccessKey} />
                <input type="hidden" name="subject" value={inquiry.subject || "New website inquiry"} />
                <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

                <div class="vet-form__row">
                  <label for="vet-name">Full Name</label>
                  <input type="text" id="vet-name" name="name" required autocomplete="name" />
                </div>

                <div class="vet-form__row">
                  <label for="vet-email">Email</label>
                  <input type="email" id="vet-email" name="email" required autocomplete="email" />
                </div>

                <div class="vet-form__row">
                  <label for="vet-city">City / Town</label>
                  <input type="text" id="vet-city" name="city_town" required autocomplete="address-level2" />
                </div>

                <div class="vet-form__row">
                  <label for="vet-pet-details">Pet Details</label>
                  <input type="text" id="vet-pet-details" name="pet_details" required />
                </div>

                <div class="vet-form__row">
                  <label for="vet-message">Message</label>
                  <textarea id="vet-message" name="message" rows="5" required />
                </div>

                <button class="vet-btn-primary" type="submit">
                  <PawIcon />
                  {inquiry.submitLabel || "Send message"}
                </button>
              </form>
            </div>
          ) : null
        }
      </div>
    </section>
  </main>

  <footer class="vet-footer">
    <div class="vet-footer__inner">
      <div class="vet-footer__brand">
        {logoSrc ? <img class="vet-footer__logo" src={logoSrc} alt="" width="120" height="41" /> : null}
        <p class="vet-footer__note">&copy; {year} {brandName}</p>
      </div>
      <div class="vet-footer__links">
        {phoneHref ? <a href={phoneHref}>{phonePretty}</a> : null}
        {email ? <a href={`mailto:${email}`}>{email}</a> : null}
        {location ? <span>{location}</span> : null}
      </div>
      {
        socialLinks.length ? (
          <nav class="vet-footer__social" aria-label="Social">
            {socialLinks.map((link) => (
              <a
                class="vet-social-link"
                href={link.href}
                aria-label={link.label}
                target={link.href.startsWith("#") ? undefined : "_blank"}
                rel={link.href.startsWith("#") ? undefined : "noreferrer"}
              >
                <span
                  class="vet-social-icon"
                  style={`--soc-color:${link.icon.color};--soc-icon:url('${SIMPLE_ICONS_CDN(link.icon.slug)}')`}
                  aria-hidden="true"
                />
              </a>
            ))}
          </nav>
        ) : null
      }
      {
        phoneHref ? (
          <div class="vet-footer__actions">
            <a class="vet-btn-secondary vet-footer__btn" href={phoneHref}>Call</a>
            <a class="vet-btn-primary vet-footer__btn" href={contactHref}>
              <PawIcon size={14} />
              Contact
            </a>
          </div>
        ) : null
      }
      {landing.footer && <p class="vet-footer__note">{landing.footer}</p>}
    </div>
  </footer>
</div>

{
  reviewsBlock?.items.length ? (
    <script is:inline>
      (function () {
        function initVetReviewsMarquee() {
          const viewport = document.getElementById("vet-reviews-marquee");
          const track = viewport?.querySelector(".vet-reviews__track");
          if (!viewport || !track) return;

          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            viewport.classList.add("vet-reviews-viewport--manual");
            return;
          }

          let resumeTimer = 0;
          const pause = () => {
            track.style.animationPlayState = "paused";
            clearTimeout(resumeTimer);
            resumeTimer = window.setTimeout(() => {
              track.style.animationPlayState = "running";
            }, 5000);
          };

          viewport.addEventListener("pointerenter", () => {
            track.style.animationPlayState = "paused";
          });
          viewport.addEventListener("pointerleave", () => {
            track.style.animationPlayState = "running";
          });
          viewport.addEventListener("touchstart", pause, { passive: true });
          viewport.addEventListener("wheel", pause, { passive: true });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initVetReviewsMarquee, { once: true });
        } else {
          initVetReviewsMarquee();
        }
      })();
    </script>
  ) : null
}
