---
/**
 * Premium residential service landing — cream, ink, and gold.
 * Standard home-cleaning layout: hero, services, pricing, gallery, FAQ.
 */
import type { SiteLandingConfig } from "../../lib/siteContent";
import { getCompanyConfig } from "../../lib/companyConfig";
import { contactTelHref } from "../../lib/contactApi";
import { hasFeature } from "../../lib/features";
import { isSiteAssistantConfigured } from "../../lib/siteAssistant";
import { resolveSiteChat } from "../../lib/siteChat";
import SiteAssistantWidget from "../SiteAssistantWidget.astro";

interface Props {
  landing: SiteLandingConfig;
}

const { landing } = Astro.props;
const company = await getCompanyConfig(Astro.request);
const year = new Date().getFullYear();

const phoneDisplay =
  (landing.contact?.phone || company.supportPhone || "").trim();
const digits = contactTelHref(
  landing.contact?.phoneHref?.replace(/^tel:/i, "") || phoneDisplay,
);
const phoneHref = digits ? `tel:${digits}` : "";

const callLabel = landing.callCta?.label || "Call";
const stickyLabel = landing.callCta?.stickyLabel || callLabel;
const services = landing.services;
const serviceItems =
  services?.items?.map((item) =>
    typeof item === "string"
      ? { label: item, description: undefined as string | undefined }
      : item,
  ) ?? [];
const schedule = landing.schedule;
const brandName = landing.name || company.name || "Chat";
const siteChat = resolveSiteChat({
  chat: landing.chat,
  legacy: schedule,
  brandName,
  photoSrc: landing.chat?.avatarSrc,
  photoAlt: landing.chat?.avatarAlt,
  supportEmail: company.supportEmail,
  domain: company.domain,
  serviceLanding: true,
});
const showFooterChat =
  Boolean(siteChat) &&
  hasFeature("portal_assistant") &&
  isSiteAssistantConfigured();
const chatPlaceholder = siteChat?.dockPlaceholder || "Ask a question…";
const introPhrases = siteChat?.introPhrases || [];
const chatGreeting = siteChat?.greeting || `Hi — how can we help?`;
const chatFaceSrc = siteChat?.avatarSrc || "";
const chatFaceAlt = siteChat?.avatarAlt || brandName;
const chatEngagement = siteChat?.engagement || {
  mode: "scroll" as const,
  minScrollPx: 64,
  delayMs: 3000,
  settleMs: 900,
};
const chatOpenOnFocus = siteChat?.openOnFocus !== false;
const chatDismissPersist = siteChat?.dismissPersist || "session";
const chatDismissKey =
  siteChat?.dismissStorageKey || "lux-footer-chat-intro-dismissed";
const chatHistoryKey = siteChat?.historyStorageKey || "sa-chat-site";
const chatRevealFab = siteChat?.revealFabOnEngagement === true;
const about = landing.about;
const contact = landing.contact;
const reviews = landing.reviews;
const numbers = landing.numbers;
const pricing = landing.pricing;
const includes = landing.includes;
const steps = landing.steps;
const areas = landing.areas;
const faq = landing.faq;
const gallery = landing.gallery;

const logoSrc = (landing.heroLogo || "").trim();
const markSrc = logoSrc.replace(/logo\.png$/i, "mark.png");
const heroImage = (landing.heroImage || "").trim();
const scheduleUrl = landing.scheduleUrl || "/form/schedule";

const navLinks = [
  { href: "#services", label: "Services" },
  pricing ? { href: "#pricing", label: "Pricing" } : null,
  includes ? { href: "#includes", label: "Checklist" } : null,
  gallery?.photos?.length ? { href: "#gallery", label: "Gallery" } : null,
  about ? { href: "#about", label: "About" } : null,
  faq ? { href: "#faq", label: "FAQ" } : null,
  contact ? { href: "#contact", label: "Contact" } : null,
].filter(Boolean) as Array<{ href: string; label: string }>;
---

<div class="lux" data-has-phone={phoneHref ? "1" : "0"} data-has-chat={showFooterChat ? "1" : "0"}>
  <header class="lux-header">
    {
      logoSrc ? (
        <a class="lux-header__brand" href="/" aria-label={landing.name || company.name}>
          <img src={logoSrc} alt="" width="280" height="120" decoding="async" />
        </a>
      ) : (
        <a class="lux-header__word" href="/">{landing.name || company.name}</a>
      )
    }
    {
      navLinks.length ? (
        <nav class="lux-header__nav" aria-label="Page sections">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      ) : null
    }
    <div class="lux-header__actions">
      <a class="lux-header__login" href="/sign-in">Login</a>
      {
        phoneHref ? (
          <a class="lux-header__phone" href={phoneHref} aria-label={callLabel}>
            {phoneDisplay}
          </a>
        ) : null
      }
    </div>
  </header>

  <main class="lux-main">
    <section class="lux-hero">
      <div class="lux-hero__copy">
        {landing.eyebrow && <p class="lux-eyebrow">{landing.eyebrow}</p>}
        <h1>{landing.heroHeadline || landing.tagline}</h1>
        {landing.heroBody && <p class="lux-lede">{landing.heroBody}</p>}
        <div class="lux-hero__actions">
          {
            phoneHref ? (
              <a class="lux-btn lux-btn--primary" href={phoneHref}>
                {callLabel}
                {phoneDisplay && <span class="lux-btn__sub">{phoneDisplay}</span>}
              </a>
            ) : null
          }
          {
            scheduleUrl ? (
              <a class="lux-btn lux-btn--ghost" href={scheduleUrl}>
                Request a visit
              </a>
            ) : null
          }
        </div>
        {landing.tagline && landing.heroHeadline && (
          <p class="lux-tagline">{landing.tagline}</p>
        )}
      </div>
      {
        heroImage ? (
          <figure class="lux-hero__media">
            <img src={heroImage} alt="" width="720" height="480" decoding="async" />
          </figure>
        ) : null
      }
    </section>

    {
      numbers?.stats?.length ? (
        <section class="lux-trust" aria-label={numbers.heading || "Highlights"}>
          <ul>
            {numbers.stats.map((stat) => (
              <li>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      serviceItems.length ? (
        <section class="lux-section" id="services">
          <div class="lux-section__head">
            <p class="lux-kicker">Services</p>
            <h2>{services?.heading}</h2>
            {services?.intro && <p>{services.intro}</p>}
          </div>
          <ul class="lux-service-cards">
            {serviceItems.map((item) => (
              <li class:list={["lux-service-card", item.featured && "lux-service-card--featured"]}>
                {
                  item.image ? (
                    <img
                      class="lux-service-card__img"
                      src={item.image}
                      alt={item.imageAlt || item.label}
                      width="640"
                      height="400"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : null
                }
                <div class="lux-service-card__body">
                  {
                    item.kicker ? (
                      <p class="lux-service-card__kicker">{item.kicker}</p>
                    ) : null
                  }
                  <h3>{item.label}</h3>
                  {item.description && <p class="lux-service-card__desc">{item.description}</p>}
                  {
                    item.includes?.length ? (
                      <ul class="lux-service-card__includes">
                        {item.includes.map((line) => (
                          <li>{line}</li>
                        ))}
                      </ul>
                    ) : null
                  }
                  {
                    item.prices?.length ? (
                      <ul class="lux-service-card__prices" aria-label="Starting prices">
                        {item.prices.map((price) => (
                          <li>{price}</li>
                        ))}
                      </ul>
                    ) : null
                  }
                  {
                    item.bookHref || scheduleUrl ? (
                      <a class="lux-service-card__link" href={item.bookHref || scheduleUrl}>
                        Book this service
                      </a>
                    ) : null
                  }
                </div>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      pricing ? (
        <section class="lux-section lux-pricing" id="pricing">
          <div class="lux-section__head">
            <p class="lux-kicker">Pricing</p>
            <h2>{pricing.heading}</h2>
            {pricing.intro && <p>{pricing.intro}</p>}
          </div>
          {
            pricing.tiers?.length ? (
              <ul class="lux-pricing__tiers">
                {pricing.tiers.map((tier) => (
                  <li class:list={["lux-pricing__tier", tier.featured && "lux-pricing__tier--featured"]}>
                    <h3>{tier.name}</h3>
                    <p class="lux-pricing__price">{tier.price}</p>
                    {tier.description && <p class="lux-pricing__desc">{tier.description}</p>}
                    {
                      tier.includes?.length ? (
                        <ul>
                          {tier.includes.map((line) => (
                            <li>{line}</li>
                          ))}
                        </ul>
                      ) : null
                    }
                  </li>
                ))}
              </ul>
            ) : null
          }
          {
            pricing.addOns?.length ? (
              <div class="lux-pricing__addons">
                <h3>Add-ons</h3>
                <ul>
                  {pricing.addOns.map((addon) => (
                    <li>
                      <span>{addon.name}</span>
                      <strong>{addon.price}</strong>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }
          {pricing.note && <p class="lux-pricing__note">{pricing.note}</p>}
        </section>
      ) : null
    }

    {
      includes?.rooms?.length ? (
        <section class="lux-section lux-includes" id="includes">
          <div class="lux-section__head">
            <p class="lux-kicker">Checklist</p>
            <h2>{includes.heading}</h2>
            {includes.intro && <p>{includes.intro}</p>}
          </div>
          <ul class="lux-includes__grid">
            {includes.rooms.map((room) => (
              <li>
                <h3>{room.name}</h3>
                <ul>
                  {room.items.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      steps?.items?.length ? (
        <section class="lux-section lux-steps" id="process">
          <div class="lux-section__head">
            <p class="lux-kicker">Process</p>
            <h2>{steps.heading}</h2>
          </div>
          <ol class="lux-steps__list">
            {steps.items.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          {
            steps.ctaHref && steps.ctaLabel ? (
              <p class="lux-steps__cta">
                <a class="lux-btn lux-btn--ghost" href={steps.ctaHref}>{steps.ctaLabel}</a>
              </p>
            ) : null
          }
        </section>
      ) : null
    }

    {
      gallery?.photos?.length ? (
        <section class="lux-section lux-gallery" id="gallery">
          <div class="lux-section__head">
            <p class="lux-kicker">Gallery</p>
            <h2>{gallery.heading || "Our work"}</h2>
            {gallery.intro && <p>{gallery.intro}</p>}
          </div>
          <ul class="lux-gallery__grid">
            {gallery.photos.map((photo) => (
              <li>
                <img src={photo.src} alt={photo.alt} width="480" height="320" loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
          {gallery.attribution && <p class="lux-gallery__credit">{gallery.attribution}</p>}
        </section>
      ) : null
    }

    {
      areas?.cities?.length ? (
        <section class="lux-section lux-areas" id="areas">
          <div class="lux-section__head">
            <p class="lux-kicker">Area</p>
            <h2>{areas.heading}</h2>
            {areas.intro && <p>{areas.intro}</p>}
          </div>
          <ul class="lux-areas__cities">
            {areas.cities.map((city) => (
              <li>{city}</li>
            ))}
          </ul>
          {areas.note && <p class="lux-areas__note">{areas.note}</p>}
        </section>
      ) : null
    }

    {
      about && (
        <section class="lux-section lux-about" id="about">
          <div class="lux-section__head">
            <p class="lux-kicker">About</p>
            <h2>{about.heading}</h2>
          </div>
          {about.body?.map((p) => (
            <p class="lux-copy">{p}</p>
          ))}
          {about.highlights?.length ? (
            <ul class="lux-highlights">
              {about.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : null}
        </section>
      )
    }

    {
      reviews?.items?.length ? (
        <section class="lux-section" id="reviews">
          <div class="lux-section__head">
            <p class="lux-kicker">Reviews</p>
            <h2>{reviews.heading}</h2>
            {reviews.intro && <p>{reviews.intro}</p>}
          </div>
          <ul class="lux-reviews">
            {reviews.items.map((item) => (
              <li>
                {item.stars && <p class="lux-reviews__stars" aria-hidden="true">{item.stars}</p>}
                <blockquote>“{item.quote}”</blockquote>
                {item.cite && <cite>{item.cite}</cite>}
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      faq?.items?.length ? (
        <section class="lux-section lux-faq" id="faq">
          <div class="lux-section__head">
            <p class="lux-kicker">FAQ</p>
            <h2>{faq.heading}</h2>
            {faq.intro && <p>{faq.intro}</p>}
          </div>
          <div class="lux-faq__list">
            {faq.items.map((item) => (
              <details class="lux-faq__item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      ) : null
    }

    {
      contact && (phoneHref || contact.email) && (
        <section class="lux-section lux-contact" id="contact">
          <div class="lux-section__head">
            <p class="lux-kicker">Contact</p>
            <h2>{contact.heading || "Get in touch"}</h2>
          </div>
          <div class="lux-contact__grid">
            {
              phoneHref && phoneDisplay && (
                <a class="lux-contact__card" href={phoneHref}>
                  <span class="lux-contact__label">Phone</span>
                  <strong>{phoneDisplay}</strong>
                </a>
              )
            }
            {
              contact.email && (
                <a class="lux-contact__card" href={`mailto:${contact.email}`}>
                  <span class="lux-contact__label">Email</span>
                  <strong>{contact.email}</strong>
                </a>
              )
            }
            {
              scheduleUrl ? (
                <a class="lux-contact__card lux-contact__card--cta" href={scheduleUrl}>
                  <span class="lux-contact__label">Online</span>
                  <strong>Request a visit</strong>
                </a>
              ) : null
            }
          </div>
        </section>
      )
    }
  </main>

  <footer class="lux-foot">
    <p>&copy; {year} {landing.footer || landing.name || company.name}</p>
  </footer>

  {
    showFooterChat ? (
      <>
        <SiteAssistantWidget
          brandTitle={brandName}
          headerTitle={siteChat?.headerTitle || brandName}
          headerSubtitle={siteChat?.headerSubtitle}
          greeting={chatGreeting}
          fabLabel={`Chat with ${brandName}`}
          footerPrefix={siteChat?.footerPrefix || "Questions?"}
          supportPhone={phoneDisplay || company.supportPhone}
          supportEmail={company.supportEmail}
          pagePath={Astro.url.pathname}
          inputPlaceholder={siteChat?.inputPlaceholder || chatPlaceholder}
          avatarSrc={chatFaceSrc || undefined}
          storageKey={chatHistoryKey}
          hideFab={siteChat?.hideFab !== false}
          revealFabOnEngagement={chatRevealFab}
        />
        <div class="lux-footer-chat" data-lux-footer-chat role="region" aria-label="Chat">
          {
            introPhrases.length ? (
              <div class="lux-footer-chat__intro" data-lux-intro hidden aria-hidden="true">
                {
                  chatFaceSrc ? (
                    <img
                      class="lux-footer-chat__face"
                      src={chatFaceSrc}
                      alt=""
                      width="40"
                      height="40"
                      decoding="async"
                    />
                  ) : markSrc ? (
                    <img
                      class="lux-footer-chat__face"
                      src={markSrc}
                      alt=""
                      width="40"
                      height="40"
                      decoding="async"
                    />
                  ) : null
                }
                <button type="button" class="lux-footer-chat__bubble-wrap" data-lux-intro-open aria-label="Open chat">
                  <span class="lux-footer-chat__bubble" data-lux-intro-text></span>
                </button>
              </div>
            ) : null
          }
          <form class="lux-footer-chat__dock" data-lux-aw-dock>
            <div class="lux-footer-chat__pill">
              <input
                type="text"
                class="lux-footer-chat__input"
                name="message"
                placeholder={chatPlaceholder}
                autocomplete="off"
                maxlength="2000"
                aria-label={chatPlaceholder}
              />
              <button type="submit" class="lux-footer-chat__send">Send</button>
            </div>
          </form>
        </div>
      </>
    ) : phoneHref ? (
      <div class="lux-sticky" role="region" aria-label="Call">
        <a class="lux-sticky__btn" href={phoneHref}>{stickyLabel}</a>
      </div>
    ) : null
  }
</div>

{
  showFooterChat ? (
    <script
      is:inline
      define:vars={{
        introPhrases,
        chatFaceAlt,
        engagement: chatEngagement,
        openOnFocus: chatOpenOnFocus,
        dismissPersist: chatDismissPersist,
        dismissStorageKey: chatDismissKey,
      }}
    >
      (function () {
        const DISMISS_KEY = dismissStorageKey || "lux-footer-chat-intro-dismissed";
        const persistMode = dismissPersist || "session";
        const dockRoot = document.querySelector("[data-lux-footer-chat]");
        const widget = document.querySelector("[data-assistant-widget]");
        const dockForm = dockRoot?.querySelector("[data-lux-aw-dock]");
        const dockInput = dockForm?.querySelector(".lux-footer-chat__input");
        if (!dockRoot || !widget) return;

        const intro = dockRoot.querySelector("[data-lux-intro]");
        const introText = intro?.querySelector("[data-lux-intro-text]");
        const openBtn = intro?.querySelector("[data-lux-intro-open]");

        function dismissed() {
          try {
            if (persistMode === "local") return localStorage.getItem(DISMISS_KEY) === "1";
            return sessionStorage.getItem(DISMISS_KEY) === "1";
          } catch {
            return false;
          }
        }

        function hideIntro(persist) {
          if (!intro) return;
          intro.hidden = true;
          intro.setAttribute("aria-hidden", "true");
          if (persist) {
            try {
              (persistMode === "local" ? localStorage : sessionStorage).setItem(DISMISS_KEY, "1");
            } catch {}
          }
        }

        function openChat() {
          widget.dispatchEvent(new CustomEvent("aw-open", { bubbles: true }));
          hideIntro(false);
        }

        dockForm?.addEventListener("submit", (ev) => {
          ev.preventDefault();
          openChat();
          const val = dockInput instanceof HTMLInputElement ? dockInput.value.trim() : "";
          if (val) widget.dispatchEvent(new CustomEvent("aw-prefill", { detail: { text: val }, bubbles: true }));
        });

        if (openOnFocus) dockInput?.addEventListener("focus", () => openChat(), { once: false });

        if (intro && introPhrases?.length && introText instanceof HTMLElement && !dismissed()) {
          let idx = 0;
          introText.textContent = introPhrases[0];
          intro.hidden = false;
          intro.removeAttribute("aria-hidden");
          const rotate = setInterval(() => {
            idx = (idx + 1) % introPhrases.length;
            introText.textContent = introPhrases[idx];
          }, 4200);
          openBtn?.addEventListener("click", () => {
            clearInterval(rotate);
            openChat();
          });
        }
      })();
    </script>
  ) : null
}

<style>
  .lux {
    --lux-cream: #f7f4ef;
    --lux-ink: #141414;
    --lux-muted: #5c574f;
    --lux-gold: #b8954a;
    --lux-gold-soft: rgba(184, 149, 74, 0.18);
    --lux-line: rgba(20, 20, 20, 0.1);
    min-height: 100dvh;
    color: var(--lux-ink);
    background: var(--lux-cream);
    padding-bottom: calc(5rem + env(safe-area-inset-bottom, 0px));
  }

  .lux-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem 1rem;
    padding: calc(0.85rem + env(safe-area-inset-top, 0px)) 1.25rem 0.65rem;
    border-bottom: 1px solid var(--lux-line);
  }

  .lux-header__brand img {
    display: block;
    width: min(10rem, 38vw);
    height: auto;
  }

  .lux-header__word {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--lux-ink);
  }

  .lux-header__nav {
    display: none;
    flex: 1 1 100%;
    order: 3;
    gap: 0.35rem 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .lux-header__nav a {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--lux-muted);
  }

  .lux-header__actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: auto;
  }

  .lux-header__login,
  .lux-header__phone {
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .lux-header__login {
    border: 1px solid var(--lux-line);
    color: var(--lux-ink);
    background: rgba(255, 255, 255, 0.35);
  }

  .lux-header__phone {
    border: 1px solid var(--lux-gold);
    color: var(--lux-ink);
    background: var(--lux-gold-soft);
  }

  .lux-main {
    max-width: 56rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  .lux-hero {
    display: grid;
    gap: 1.5rem;
    padding: 0.5rem 0 2rem;
  }

  .lux-hero__copy {
    text-align: center;
  }

  .lux-hero__media {
    margin: 0;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--lux-line);
    box-shadow: 0 18px 40px rgba(20, 20, 20, 0.08);
  }

  .lux-hero__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .lux-eyebrow {
    margin: 0 0 1rem;
    color: var(--lux-gold);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .lux-hero h1 {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.1rem, 8vw, 3rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .lux-lede {
    margin: 1.1rem auto 0;
    max-width: 32rem;
    color: var(--lux-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .lux-hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }

  .lux-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    padding: 0.95rem 1.2rem;
    border-radius: 999px;
    text-decoration: none !important;
