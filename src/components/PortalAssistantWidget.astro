---
/**
 * Client portal "speed dial" help button — a fixed circular button (bottom
 * right) that opens a small chat for the everyday questions clients
 * otherwise call/email about ("I can't get into my Gmail", "what's my
 * login", "what do I owe"). Talks to `/api/c/:uid/assistant` (public,
 * scoped to this one contact — see that route + `src/lib/portalAssistant.ts`).
 *
 * Plain JS (no React) to match the rest of this page — it's a public,
 * iOS-first surface, and this keeps the extra bundle tiny.
 */
import IosBottomSheet from './IosBottomSheet.astro';

export interface Props {
  contactUid: string;
  brandTitle: string;
  clientFirstName?: string;
  supportPhone?: string;
  supportEmail?: string;
}

const { contactUid, brandTitle, clientFirstName = '', supportPhone = '', supportEmail = '' } = Astro.props;

const endpoint = `/api/c/${encodeURIComponent(contactUid)}/assistant`;
const storageKey = `pa-chat-${contactUid}`;

const greetName = clientFirstName.trim();
const greeting = greetName
  ? `Hi ${greetName}! I can help with account access, logins, and quick questions about your project. What's going on?`
  : `Hi! I can help with account access, logins, and quick questions about your project. What's going on?`;

const contactBits = [
  supportPhone ? `call/text ${supportPhone}` : '',
  supportEmail ? `email ${supportEmail}` : '',
].filter(Boolean);
const footerNote = contactBits.length ? `Urgent? ${contactBits.join(' · ')}` : '';
---

<div id="pa-root" class="pa-root" data-uid={contactUid} data-endpoint={endpoint} data-storage-key={storageKey}>
  <button id="pa-fab" class="pa-fab" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label={`Get help from ${brandTitle}`}>
    <svg class="pa-fab-icon-chat" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
    <svg class="pa-fab-icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    </svg>
  </button>

  <IosBottomSheet id="pa-sheet" sheetOnly={true} dismissible={true} class="pa-sheet">
    <div class="pa-chat">
      <header class="pa-header">
        <div class="pa-header-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12c0 1.821.487 3.53 1.338 5L2 22l5-1.338A9.955 9.955 0 0 0 12 22Z"/></svg>
        </div>
        <div class="pa-header-title">
          <span class="pa-header-name">Help &amp; Support</span>
          <span class="pa-header-sub">{brandTitle}</span>
        </div>
        <button class="pa-close" type="button" data-ios-sheet-close aria-label="Close chat">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </header>

      <div id="pa-messages" class="pa-messages">
        <div class="pa-msg pa-msg-assistant">
          <div class="pa-bubble" data-greeting>{greeting}</div>
        </div>
      </div>

      <div id="pa-typing" class="pa-typing" hidden aria-hidden="true"><span></span><span></span><span></span></div>

      <form id="pa-form" class="pa-form">
        <textarea
          id="pa-input"
          class="pa-input"
          rows="1"
          placeholder="Ask a question…"
          autocomplete="off"
          autocorrect="on"
          spellcheck="true"
          maxlength="2000"
        ></textarea>
        <button id="pa-send" class="pa-send" type="submit" aria-label="Send message">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
        </button>
      </form>

      {footerNote && <p class="pa-footer">{footerNote}</p>}
    </div>
  </IosBottomSheet>
</div>

<script src="/ios-sheet.js" defer></script>

<style>
  .pa-root { position: relative; }

  .pa-fab {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: calc(env(safe-area-inset-bottom) + 20px);
    z-index: 70;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: var(--portal-brand-fill, var(--portal-brand-gradient, linear-gradient(135deg, #a855f7, #ec4899)));
    border: 1px solid var(--portal-brand-fill-border, transparent);
    box-shadow: 0 8px 24px rgba(var(--portal-primary-rgb, 168, 85, 247), 0.45), 0 2px 8px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: transform 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .pa-fab:active { transform: scale(0.93); }
  .pa-fab[aria-expanded='true'] { z-index: 6001; }
  .pa-fab-icon-close { display: none; }
  .pa-fab[aria-expanded='true'] .pa-fab-icon-chat { display: none; }
  .pa-fab[aria-expanded='true'] .pa-fab-icon-close { display: block; }

  .pa-chat {
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
  }

  .pa-header {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 14px 16px;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .pa-header-icon {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: var(--portal-brand-fill, var(--portal-brand-gradient, linear-gradient(135deg, #a855f7, #ec4899)));
    border: 1px solid var(--portal-brand-fill-border, transparent);
  }
  .pa-header-title { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .pa-header-name { font-size: 14px; font-weight: 700; color: #fff; }
  .pa-header-sub { font-size: 12px; color: rgba(255, 255, 255, 0.5); }
  .pa-close {
    flex: none;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
  }
  .pa-close:active { background: rgba(255, 255, 255, 0.14); }

  .pa-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    -webkit-overflow-scrolling: touch;
  }
  .pa-msg { display: flex; }
  .pa-msg-user { justify-content: flex-end; }
  .pa-msg-assistant { justify-content: flex-start; }
  .pa-bubble {
    max-width: 84%;
    padding: 10px 13px;
    border-radius: 16px;
    font-size: 14.5px;
    line-height: 1.5;
    word-wrap: break-word;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
  .pa-msg-assistant .pa-bubble {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.92);
    border-bottom-left-radius: 4px;
  }
  .pa-msg-user .pa-bubble {
    background: var(--portal-brand-fill, var(--portal-brand-gradient, linear-gradient(135deg, #a855f7, #ec4899)));
    border: 1px solid var(--portal-brand-fill-border, transparent);
    color: #fff;
    border-bottom-right-radius: 4px;
  }
  .pa-bubble a { color: var(--portal-accent, #d8b4fe); text-decoration: underline; }
  .pa-msg-user .pa-bubble a { color: #fff; }
  .pa-bubble strong { font-weight: 700; }
  .pa-bubble.pa-bubble-error {
    background: rgba(248, 113, 113, 0.12);
    border-color: rgba(248, 113, 113, 0.3);
    color: #fca5a5;
  }

  .pa-typing {
    flex: none;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 20px 8px;
  }
  .pa-typing[hidden] {
    display: none !important;
  }
  .pa-typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.45);
    animation: pa-bounce 1.2s infinite ease-in-out;
  }
  .pa-typing span:nth-child(2) { animation-delay: 0.15s; }
  .pa-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes pa-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  .pa-form {
    flex: none;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 10px 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }
  .pa-input {
    flex: 1;
    resize: none;
    max-height: 110px;
    padding: 10px 13px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(0, 0, 0, 0.3);
    color: #fff;
    font: inherit;
    font-size: 14.5px;
    line-height: 1.4;
    outline: none;
  }
  .pa-input::placeholder { color: rgba(255, 255, 255, 0.35); }
  .pa-input:focus { border-color: rgba(var(--portal-primary-rgb, 168, 85, 247), 0.6); }
  .pa-send {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--portal-brand-fill-border, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: var(--portal-brand-fill, var(--portal-brand-gradient, linear-gradient(135deg, #a855f7, #ec4899)));
    cursor: pointer;
    transition: opacity 0.15s ease, transform 0.1s ease;
  }
  .pa-send:active { transform: scale(0.92); }
  .pa-send:disabled { opacity: 0.45; cursor: default; }

  .pa-footer {
    flex: none;
    margin: 0;
    padding: 0 16px 12px;
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.4);
    text-align: center;
  }
</style>

<style is:global>
  #pa-sheet {
    --ios-sheet-bg: #121016;
    --ios-sheet-fg: #fff;
    --ios-sheet-muted: rgba(255, 255, 255, 0.55);
    --ios-sheet-border: rgba(255, 255, 255, 0.1);
    --ios-sheet-grabber: rgba(255, 255, 255, 0.28);
    color-scheme: dark;
  }

  #pa-sheet .ios-sheet-header {
    display: none;
  }

  #pa-sheet .ios-sheet {
    height: min(85dvh, 640px);
    max-height: min(85dvh, 640px);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.55);
  }

  #pa-sheet .ios-sheet-body {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
</style>

<script>
  type Turn = { role: 'user' | 'assistant'; content: string };

  declare global {
    interface Window {
      IosSheet?: {
        open: (target: string | HTMLElement, opts?: { onClose?: () => void }) => void;
        close: (target?: string | HTMLElement) => void;
      };
    }
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  /** Minimal, safe formatting: escape first, then linkify + bold + line breaks. */
  function formatReply(raw: string): string {
    let out = escapeHtml(raw);
    out = out.replace(/(https?:\/\/[^\s<]+)/g, (url) => {
      const clean = url.replace(/[.,)]+$/, '');
      const trail = url.slice(clean.length);
      return `<a href="${clean}" target="_blank" rel="noopener noreferrer">${clean}</a>${trail}`;
    });
    out = out.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    return out.replace(/\n/g, '<br />');
  }

  function initPortalAssistant(root: HTMLElement) {
    const uid = root.dataset.uid || '';
    const endpoint = root.dataset.endpoint || '';
    const storageKey = root.dataset.storageKey || `pa-chat-${uid}`;
    const sheetId = 'pa-sheet';

    const fab = root.querySelector<HTMLButtonElement>('#pa-fab');
    const sheet = document.getElementById(sheetId);
    const messagesEl = root.querySelector<HTMLDivElement>('#pa-messages');
    const typingEl = root.querySelector<HTMLDivElement>('#pa-typing');
    const form = root.querySelector<HTMLFormElement>('#pa-form');
    const input = root.querySelector<HTMLTextAreaElement>('#pa-input');
    const sendBtn = root.querySelector<HTMLButtonElement>('#pa-send');
    if (!fab || !sheet || !messagesEl || !typingEl || !form || !input || !sendBtn) return;

    let history: Turn[] = [];
    try {
      const raw = sessionStorage.getItem(storageKey);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) history = parsed;
      }
    } catch {
      /* ignore corrupt/blocked storage */
    }

    function persist() {
      try {
        sessionStorage.setItem(storageKey, JSON.stringify(history.slice(-40)));
      } catch {
        /* storage may be unavailable (private mode, quota) — chat still works this session */
      }
    }

    function scrollToBottom() {
      messagesEl!.scrollTop = messagesEl!.scrollHeight;
    }

    function renderMessage(role: 'user' | 'assistant', text: string, isError = false) {
      const row = document.createElement('div');
      row.className = `pa-msg pa-msg-${role}`;
      const bubble = document.createElement('div');
      bubble.className = `pa-bubble${isError ? ' pa-bubble-error' : ''}`;
      bubble.innerHTML = role === 'assistant' ? formatReply(text) : escapeHtml(text).replace(/\n/g, '<br />');
      row.appendChild(bubble);
      messagesEl!.appendChild(row);
      scrollToBottom();
    }

    // Replay saved history (session-only) so a reload mid-conversation isn't jarring.
    if (history.length) {
      const greetingEl = messagesEl.querySelector('[data-greeting]');
      if (greetingEl) greetingEl.closest('.pa-msg')?.remove();
      for (const turn of history) renderMessage(turn.role, turn.content);
      scrollToBottom();
    }

    function isOpen() {
      return sheet!.classList.contains('open');
    }

    function setExpanded(expanded: boolean) {
      fab!.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    }

    function openPanel() {
      window.IosSheet?.open(sheetId);
      setExpanded(true);
      setTimeout(() => input!.focus(), 280);
    }

    function closePanel() {
      window.IosSheet?.close(sheetId);
      setExpanded(false);
    }

    fab.addEventListener('click', () => (isOpen() ? closePanel() : openPanel()));
    sheet.addEventListener('ios-sheet-close', () => setExpanded(false));

    function autosize() {
      input!.style.height = 'auto';
      input!.style.height = `${Math.min(input!.scrollHeight, 110)}px`;
    }
    input.addEventListener('input', autosize);

    let sending = false;
    async function sendMessage(rawText: string) {
      const text = rawText.trim();
      if (sending || !text) return;
      sending = true;
      sendBtn!.disabled = true;

      renderMessage('user', text);
      const priorHistory = history.slice(-20);
      history.push({ role: 'user', content: text });
      persist();

      input!.value = '';
      autosize();
      typingEl!.hidden = false;
      scrollToBottom();

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text, history: priorHistory }),
        });
        let data: { ok?: boolean; reply?: string; error?: string } = {};
        try {
          data = await res.json();
        } catch {
          /* fall through to generic error below */
        }
        typingEl!.hidden = true;

        if (res.ok && data.ok && data.reply) {
          renderMessage('assistant', data.reply);
          history.push({ role: 'assistant', content: data.reply });
        } else {
          const msg = data.error || 'Something went wrong. Please try again in a moment.';
          renderMessage('assistant', msg, true);
          history.push({ role: 'assistant', content: msg });
        }
        persist();
      } catch {
        typingEl!.hidden = true;
        const msg = 'Network error — please check your connection and try again.';
        renderMessage('assistant', msg, true);
        history.push({ role: 'assistant', content: msg });
        persist();
      } finally {
        sending = false;
        sendBtn!.disabled = false;
        scrollToBottom();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void sendMessage(input.value);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        void sendMessage(input.value);
      }
    });
  }

  const root = document.getElementById('pa-root');
  if (root) initPortalAssistant(root);
</script>
