---
/** Client-portal wrapper — `/api/c/:uid/assistant`, portal branding tokens. */
import AssistantWidget from './AssistantWidget.astro';

export interface Props {
  contactUid: string;
  brandTitle: string;
  clientFirstName?: string;
  supportPhone?: string;
  supportEmail?: string;
}

const { contactUid, brandTitle, clientFirstName = '', supportPhone = '', supportEmail = '' } = Astro.props;

const firstName = clientFirstName.trim();
const greeting = firstName
  ? `Hi, ${firstName}. What can I assist you with today?`
  : 'Hi. What can I assist you with today?';
---

<AssistantWidget
  instanceId={contactUid}
  endpoint={`/api/c/${encodeURIComponent(contactUid)}/assistant`}
  storageKey={`pa-chat-${contactUid}`}
  brandTitle={brandTitle}
  headerTitle="Help & Support"
  greeting={greeting}
  fabLabel={`Get help from ${brandTitle}`}
  footerPrefix="Urgent?"
  supportPhone={supportPhone}
  supportEmail={supportEmail}
  variant="portal"
/>
