---
type TileSize = "1x1" | "2x1" | "1x2" | "2x2" | "3x2";

interface PortfolioItem {
  title: string;
  description: string;
  tags: string[];
  image: string;
  imageAlt: string;
  size: TileSize;
  button?: { label: string; href: string };
}

const items: PortfolioItem[] = [
  {
    title: "M-Dot",
    description:
      "Boston hip-hop artist hub — fullscreen album slideshow, bottom dock nav, and swipe-up drawers linking Spotify, Bandcamp, tour dates, and socials.",
    tags: ["Web Design", "Music", "Artist Site"],
    image: "/images/portfolio/mdot-world-featured.png",
    imageAlt: "M-Dot portrait splash page with bottom music and social dock on black",
    size: "2x1",
    button: { label: "View site", href: "https://mdot.world" },
  },
  {
    title: "LUXEMEDS",
    description:
      "Luxury wellness e-commerce with concierge chat, product hero, and a gold-accent brand system.",
    tags: ["Web Design", "E-commerce", "Wellness"],
    image: "/images/portfolio/Screenshot_2026-07-23_at_8.26.37_PM.png",
    imageAlt: "LUXEMEDS homepage with product vial hero and chat concierge",
    size: "1x2",
    button: { label: "View project", href: "/#contact" },
  },
  {
    title: "CREED",
    description:
      "Nightlife venue marketing with neon signage photography, social hooks, and event-hour callouts.",
    tags: ["Venue", "Marketing", "Photography"],
    image: "/images/portfolio/Screenshot_2026-07-23_at_8.25.26_PM.png",
    imageAlt: "CREED hookah lounge sign against a glass skyscraper at dusk",
    size: "2x2",
  },
  {
    title: "Air Race 21",
    description:
      "Race-day livery and event graphics — ornate linework over aviation photography for a national air series.",
    tags: ["Branding", "Events", "Aviation"],
    image: "/images/portfolio/ar-featured.png",
    imageAlt: "Red racing jet with Air Race 21 decorative graphic overlay",
    size: "2x1",
  },
  {
    title: "Kingdom Trails",
    description:
      "Trail-network identity with crown motif, forest photography, and bold outdoor typography.",
    tags: ["Branding", "Outdoor", "Print"],
    image: "/images/portfolio/kingdom-featured.png",
    imageAlt: "Kingdom Trails crown logo over mountain bikers in a pine forest",
    size: "2x1",
  },
  {
    title: "Students for Haiti",
    description:
      "Nonprofit campaign identity — palm-tree mark, bilingual typography, and mission photography.",
    tags: ["Nonprofit", "Branding", "Campaign"],
    image: "/images/portfolio/featured-sfh.png",
    imageAlt: "Students for Haiti logo over volunteer and children in Haiti",
    size: "2x2",
    button: { label: "Learn more", href: "/#contact" },
  },
  {
    title: "Vasodyn",
    description:
      "Medical-device brand visuals — clinical green lighting and anatomical model photography.",
    tags: ["Medical", "Branding", "Photography"],
    image: "/images/portfolio/vasodyn-featured.png",
    imageAlt: "Glass aortic arch model lit in emerald green for Vasodyn",
    size: "1x2",
  },
  {
    title: "blackWater",
    description:
      "Gritty wordmark integrated into weathered stone — high-contrast industrial brand treatment.",
    tags: ["Branding", "Identity", "Environmental"],
    image: "/images/portfolio/blackwater-featured.png",
    imageAlt: "blackWater logo stenciled onto a textured stone wall",
    size: "2x1",
  },
  {
    title: "Box Capital",
    description: "Isometric mark and wordmark for a finance brand — green gradient on dark field.",
    tags: ["Logo", "Finance", "Identity"],
    image: "/images/portfolio/box-captital-logo-dark.png",
    imageAlt: "Box Capital isometric green logo on black",
    size: "1x1",
  },
  {
    title: "Innercity Fire Protection",
    description:
      "Flame icon with city-grid motif — warm gradient mark and industrial sans typography.",
    tags: ["Logo", "Safety", "Identity"],
    image: "/images/portfolio/icfp-logo.png",
    imageAlt: "Innercity Fire Protection flame logo with city grid pattern",
    size: "1x1",
  },
  {
    title: "Lotus Glass",
    description:
      "Artisan glass brand — layered lotus mark, outlined wordmark, and soft bokeh backdrop.",
    tags: ["Branding", "Craft", "Logo"],
    image: "/images/portfolio/lotus-glass-featured-300x225.png",
    imageAlt: "Lotus Glass logo with blue-green lotus flower and outlined text",
    size: "1x1",
  },
  {
    title: "DPM Construction",
    description:
      "Commercial interiors showcase — bold red accent walls, lounge seating, and tech bar staging.",
    tags: ["Construction", "Interiors", "Photography"],
    image: "/images/portfolio/dpm-construction-featured.png",
    imageAlt: "Modern office lounge and computer bar with red accent walls",
    size: "2x1",
  },
  {
    title: "Middlebury College Events",
    description:
      "Arena-scale concert photography from stage — crowd energy, lighting, and venue branding.",
    tags: ["Events", "Photography", "Live Music"],
    image: "/images/portfolio/background-03-1024x6856a.png",
    imageAlt: "Stage view of a packed Middlebury College arena concert",
    size: "3x2",
  },
  {
    title: "Care Plus Mark",
    description:
      "Minimal connected icon system — heart, plus, and circle forms for a wellness identity suite.",
    tags: ["Logo", "Healthcare", "Identity"],
    image: "/images/portfolio/Screenshot_2026-07-23_at_8.07.15_PM.png",
    imageAlt: "Black line-art logo combining a heart, plus sign, and circle",
    size: "1x1",
  },
];
---

<div class="portfolio-masonry" data-portfolio-masonry>
  {
    items.map((item) => (
      <article class:list={["masonry-item", `masonry-item--${item.size}`]}>
        <button
          type="button"
          class="masonry-card"
          aria-label={`${item.title} — ${item.description}`}
          data-masonry-card
        >
          <img
            src={item.image}
            alt={item.imageAlt}
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
            class="masonry-image"
          />
          <div class="masonry-overlay">
            <div class="masonry-overlay-inner">
              <h3 class="masonry-title">{item.title}</h3>
              <p class="masonry-desc">{item.description}</p>
              <ul class="masonry-tags" aria-label="Tags">
                {item.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              {
                item.button ? (
                  <a class="masonry-btn" href={item.button.href} data-masonry-btn>
                    {item.button.label}
                  </a>
                ) : null
              }
            </div>
          </div>
        </button>
      </article>
    ))
  }
</div>

<style>
  .portfolio-masonry {
    --brick-unit: clamp(72px, 9.5vw, 112px);
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: var(--brick-unit);
    grid-auto-flow: dense;
    gap: clamp(8px, 1.2vw, 12px);
    padding: 0 clamp(12px, 2vw, 28px);
  }

  .masonry-item {
    min-width: 0;
    min-height: 0;
  }

  .masonry-item--1x1 {
    grid-column: span 1;
    grid-row: span 1;
  }

  .masonry-item--2x1 {
    grid-column: span 2;
    grid-row: span 1;
  }

  .masonry-item--1x2 {
    grid-column: span 1;
    grid-row: span 2;
  }

  .masonry-item--2x2 {
    grid-column: span 2;
    grid-row: span 2;
  }

  .masonry-item--3x2 {
    grid-column: span 3;
    grid-row: span 2;
  }

  .masonry-card {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.04);
    text-align: left;
    -webkit-tap-highlight-color: transparent;
  }

  .masonry-card:focus-visible {
    outline: 2px solid #a855f7;
    outline-offset: 2px;
  }

  .masonry-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      filter 1.5s ease;
  }

  .masonry-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(10px, 1.5vw, 16px);
    background: linear-gradient(
      180deg,
      rgba(5, 5, 5, 0) 0%,
      rgba(5, 5, 5, 0.35) 38%,
      rgba(5, 5, 5, 0.88) 100%
    );
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .masonry-overlay-inner {
    transform: translateY(8px);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .masonry-title {
    font-family: var(--font-primary);
    font-size: clamp(12px, 1.1vw, 15px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0 0 6px;
    line-height: 1.2;
  }

  .masonry-desc {
    font-family: var(--font-content);
    font-size: clamp(10px, 0.95vw, 12px);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 8px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .masonry-item--1x1 .masonry-desc {
    -webkit-line-clamp: 2;
  }

  .masonry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
  }

  .masonry-tags li {
    font-family: var(--font-primary);
    font-size: clamp(8px, 0.75vw, 10px);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    padding: 3px 7px;
    border-radius: 999px;
    border: 1px solid rgba(168, 85, 247, 0.45);
    background: rgba(168, 85, 247, 0.18);
    margin: 0;
    line-height: 1.2;
  }

  .masonry-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-primary);
    font-size: clamp(9px, 0.8vw, 11px);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--brand-gradient);
    box-shadow: 0 2px 12px rgba(168, 85, 247, 0.35);
    pointer-events: auto;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .masonry-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(168, 85, 247, 0.5);
  }

  @media (hover: hover) and (pointer: fine) {
    .masonry-card:hover .masonry-image,
    .masonry-card:focus-visible .masonry-image {
      transform: scale(1.04);
      filter: grayscale(0%);
    }

    .masonry-card:hover .masonry-overlay,
    .masonry-card:focus-visible .masonry-overlay {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .masonry-card:hover .masonry-overlay-inner,
    .masonry-card:focus-visible .masonry-overlay-inner {
      transform: translateY(0);
    }
  }

  .masonry-card.is-active .masonry-image {
    transform: scale(1.02);
    filter: grayscale(0%);
  }

  .masonry-card.is-active .masonry-overlay {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .masonry-card.is-active .masonry-overlay-inner {
    transform: translateY(0);
  }

  @media (max-width: 960px) {
    .portfolio-masonry {
      grid-template-columns: repeat(4, 1fr);
    }

    .masonry-item--3x2 {
      grid-column: span 4;
      grid-row: span 2;
    }

    .masonry-item--2x2 {
      grid-column: span 2;
      grid-row: span 2;
    }

    .masonry-item--2x1 {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (max-width: 640px) {
    .portfolio-masonry {
      --brick-unit: clamp(64px, 22vw, 96px);
      grid-template-columns: repeat(2, 1fr);
    }

    .masonry-item--3x2,
    .masonry-item--2x2,
    .masonry-item--2x1 {
      grid-column: span 2;
    }

    .masonry-item--1x2 {
      grid-column: span 1;
      grid-row: span 2;
    }

    .masonry-item--1x1 {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>

<script>
  function initPortfolioMasonry(root: HTMLElement) {
    const cards = root.querySelectorAll<HTMLButtonElement>("[data-masonry-card]");

    const closeAll = (except?: HTMLButtonElement) => {
      cards.forEach((card) => {
        if (card !== except) card.classList.remove("is-active");
      });
    };

    cards.forEach((card) => {
      card.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (target.closest("[data-masonry-btn]")) return;

        const isActive = card.classList.contains("is-active");
        closeAll();
        if (!isActive) card.classList.add("is-active");
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (!root.contains(target)) closeAll();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeAll();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-portfolio-masonry]").forEach(initPortfolioMasonry);
</script>
