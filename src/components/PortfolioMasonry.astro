---
import { getSiteContent, type SitePortfolioItem } from "../lib/siteContent";

const items: SitePortfolioItem[] = getSiteContent().portfolio ?? [];
---

{items.length > 0 && (
<div class="portfolio-masonry" data-portfolio-masonry>
  {
    items.map((item) => (
      <article
        class:list={["masonry-item", `masonry-item--${item.imageOrientation ?? "horizontal"}`]}
        data-orientation={item.imageOrientation ?? "horizontal"}
      >
        <button
          type="button"
          class="masonry-card"
          aria-label={`${item.title} — ${item.description}`}
          data-masonry-card
        >
          <img
            src={item.image}
            alt={item.imageAlt}
            class="masonry-image"
            loading="lazy"
            decoding="async"
            style={item.imagePosition ? `--image-position: ${item.imagePosition}` : undefined}
          />
          <div class="masonry-overlay">
            <div class="masonry-overlay-inner">
              <h3 class="masonry-title">{item.title}</h3>
              <p class="masonry-desc">{item.description}</p>
              <ul class="masonry-tags" aria-label="Tags">
                {item.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </div>
        </button>
      </article>
    ))
  }
</div>
)}

<style>
  .portfolio-masonry {
    --masonry-cols: 6;
    --masonry-gap: clamp(8px, 1.2vw, 12px);
    --gutter-x: clamp(12px, 2vw, 28px);
    --tile-aspect-w: 16;
    --tile-aspect-h: 9;
    --brick-ratio: calc(2 * var(--tile-aspect-h) / var(--tile-aspect-w));
    --masonry-col: calc((100vw - (var(--gutter-x) * 2) - (var(--masonry-cols) - 1) * var(--masonry-gap)) / var(--masonry-cols));
    --brick-unit: calc(var(--masonry-col) * var(--brick-ratio));
    display: grid;
    grid-template-columns: repeat(var(--masonry-cols), minmax(0, 1fr));
    grid-auto-rows: minmax(96px, var(--brick-unit));
    grid-auto-flow: dense;
    align-content: start;
    align-items: stretch;
    justify-items: stretch;
    gap: var(--masonry-gap);
    padding: 0 var(--gutter-x) 48px;
    overflow: visible;
  }

  @supports (width: 1cqi) {
    .portfolio-masonry {
      container-type: inline-size;
      --masonry-col: calc((100cqi - (var(--masonry-cols) - 1) * var(--masonry-gap)) / var(--masonry-cols));
    }
  }

  .masonry-item {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 10px;
  }

  .masonry-item--horizontal {
    grid-column: span 2;
    grid-row: span 1;
  }

  .masonry-item--vertical {
    grid-column: span 2;
    grid-row: span 2;
  }

  .masonry-card {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.04);
    text-align: left;
    -webkit-tap-highlight-color: transparent;
  }

  .masonry-card:focus-visible {
    outline: 2px solid var(--site-fg, #171717);
    outline-offset: 2px;
  }

  .masonry-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--image-position, center);
    filter: grayscale(100%);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      filter 1.5s ease;
  }

  .masonry-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(10px, 1.5vw, 16px);
    background: linear-gradient(
      180deg,
      rgba(5, 5, 5, 0) 0%,
      rgba(5, 5, 5, 0.35) 38%,
      rgba(5, 5, 5, 0.88) 100%
    );
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .masonry-overlay-inner {
    transform: translateY(8px);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .masonry-title {
    font-family: var(--font-primary);
    font-size: clamp(12px, 1.1vw, 15px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0 0 6px;
    line-height: 1.2;
  }

  .masonry-desc {
    font-family: var(--font-content);
    font-size: clamp(10px, 0.95vw, 12px);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 8px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .masonry-item--vertical .masonry-desc {
    -webkit-line-clamp: 4;
  }

  .masonry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .masonry-tags li {
    font-family: var(--font-primary);
    font-size: clamp(8px, 0.75vw, 10px);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    padding: 3px 7px;
    border-radius: 999px;
    border: 1px solid rgba(168, 85, 247, 0.45);
    background: rgba(168, 85, 247, 0.18);
    margin: 0;
    line-height: 1.2;
  }

  @media (hover: hover) and (pointer: fine) {
    .masonry-card:hover .masonry-image,
    .masonry-card:focus-visible .masonry-image {
      transform: scale(1.04);
      filter: grayscale(0%);
    }

    .masonry-card:hover .masonry-overlay,
    .masonry-card:focus-visible .masonry-overlay {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .masonry-card:hover .masonry-overlay-inner,
    .masonry-card:focus-visible .masonry-overlay-inner {
      transform: translateY(0);
    }
  }

  .masonry-card.is-active .masonry-image {
    transform: scale(1.02);
    filter: grayscale(0%);
  }

  .masonry-card.is-active .masonry-overlay {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .masonry-card.is-active .masonry-overlay-inner {
    transform: translateY(0);
  }

  @media (max-width: 960px) {
    .portfolio-masonry {
      --masonry-cols: 4;
    }

    .masonry-item--horizontal {
      grid-column: span 4;
      grid-row: span 2;
    }

    .masonry-item--vertical {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
</style>

<script>
  import { bootPortfolioMasonry } from "../lib/portfolioMasonry";

  bootPortfolioMasonry();
  document.addEventListener("astro:page-load", () => bootPortfolioMasonry());
</script>
