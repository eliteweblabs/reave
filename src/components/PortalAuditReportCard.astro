---
/**
 * Client-facing online presence diagnostic — filtered from audit markdown.
 * Admin keeps the raw Work body; this is the plain-language client view.
 */
import {
  AUDIT_GRADE_LEGEND,
  AUDIT_REPORT_DISCLAIMER,
  AUDIT_SCAN_STACK,
  type AuditReportCard,
  type LetterGrade,
  type ReportCardIcon,
} from '../lib/auditReportCard';

interface Props {
  report: AuditReportCard;
  /** Client / business name for “reproduce here” prefill. */
  clientName?: string;
  /** Escaped/linked HTML of the raw audit body (technical notes). */
  bodyHtml?: string;
  /** Website URL for “reproduce here” (falls back to report.website). */
  website?: string;
}

const {
  report,
  clientName = '',
  bodyHtml = '',
  website = '',
} = Astro.props;

function gradeClass(grade: LetterGrade | null | undefined): string {
  if (!grade) return 'grade-na';
  return `grade-${grade.toLowerCase()}`;
}

function gradeLabel(grade: LetterGrade | null | undefined): string {
  return grade || '—';
}

/** Horizontal fill % for each of 5 bars (20 points each). e.g. 62 → [100,100,100,10,0]. */
function scoreBarFills(score: number | null | undefined): number[] {
  if (score == null || Number.isNaN(score)) return [0, 0, 0, 0, 0];
  const clamped = Math.max(0, Math.min(100, score));
  return [0, 1, 2, 3, 4].map((band) => {
    const inBand = clamped - band * 20;
    if (inBand <= 0) return 0;
    if (inBand >= 20) return 100;
    return (inBand / 20) * 100;
  });
}

const ringPct = report.overallScore ?? 0;
const circumference = 2 * Math.PI * 54;
const ringOffset = circumference - (ringPct / 100) * circumference;
const featured = report.featured;
const cats = report.categories || [];
const ideas = (report.ideas || []).slice(0, 5);
const heroStats = report.heroStats || [];

/** Public Digital Audit form — pass website (+ business) so “reproduce here” prefills. */
function buildReproduceAuditHref(website?: string, business?: string): string {
  const params = new URLSearchParams();
  const site = (website || '').trim();
  if (site) {
    const href = /^https?:\/\//i.test(site) ? site : `https://${site}`;
    params.set('url', href);
  }
  const biz = (business || '').trim();
  if (biz) params.set('business', biz);
  const qs = params.toString();
  return qs ? `/digital-audit?${qs}` : '/digital-audit';
}

const reproduceAuditHref = buildReproduceAuditHref(website || report.website, clientName);

const ICON_PATHS: Record<ReportCardIcon, string> = {
  radar: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5" stroke-dasharray="2 3"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>`,
  shield: `<path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3z"/><path d="M9.5 12l1.8 1.8L15 10"/>`,
  globe: `<circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/>`,
  pin: `<path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10z"/><circle cx="12" cy="11" r="2"/>`,
  compass: `<circle cx="12" cy="12" r="9"/><path d="M14.5 9.5L10 14l4.5-1L14.5 9.5z" fill="currentColor" fill-opacity=".85" stroke="none"/><path d="M9.5 14.5L14 10l-4.5 1L9.5 14.5z" fill="currentColor" fill-opacity=".4" stroke="none"/>`,
  search: `<circle cx="11" cy="11" r="6"/><path d="M16 16l4 4"/>`,
  speed: `<path d="M5 16a8 8 0 1 1 14 0"/><path d="M12 16l4-5"/><circle cx="12" cy="16" r="1.2" fill="currentColor" stroke="none"/>`,
  mobile: `<rect x="8" y="4" width="8" height="16" rx="1.5"/><path d="M11 17h2"/>`,
  star: `<path d="M12 3.5l2.2 4.5 5 .7-3.6 3.5.9 5L12 15.4 7.5 17.2l.9-5L4.8 8.7l5-.7L12 3.5z"/>`,
  share: `<circle cx="6" cy="7" r="2"/><circle cx="6" cy="17" r="2"/><circle cx="18" cy="12" r="2"/><path d="M8 8l8 3M8 16l8-3"/>`,
  chart: `<path d="M4 19V5M4 19h16"/><rect x="7" y="12" width="2.5" height="5" fill="currentColor" stroke="none"/><rect x="11.5" y="9" width="2.5" height="8" fill="currentColor" stroke="none"/><rect x="16" y="6" width="2.5" height="11" fill="currentColor" stroke="none"/>`,
  access: `<circle cx="12" cy="6" r="2.5"/><path d="M5 11h14M12 11v8M12 14l-4 5M12 14l4 5"/>`,
  cloud: `<path d="M7 17h10a4 4 0 0 0 .5-8 5.5 5.5 0 0 0-10.5 1.5A3.5 3.5 0 0 0 7 17z"/><path d="M12 14v5M10 17l2 2 2-2"/>`,
  link: `<path d="M9 12h6"/><path d="M10 8H8a4 4 0 0 0 0 8h2"/><path d="M14 8h2a4 4 0 0 1 0 8h-2"/>`,
  content: `<path d="M6 5h9l3 3v11H6z"/><path d="M14 5v4h4M8 12h8M8 15h6"/>`,
  lead: `<rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 12h5M8 15h3"/>`,
  schema: `<rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="9" y="14" width="6" height="6" rx="1"/><path d="M7 10v2h10v-2M12 12v2"/>`,
  mail: `<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 8l9 6 9-6"/>`,
};
---

<div class="opd" data-audit-report>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  {report.inProgress ? (
    <div class="opd-waiting">
      <div class="opd-waiting-pulse" aria-hidden="true" />
      <h3 class="opd-waiting-title">Building your diagnostic</h3>
      <p class="opd-waiting-copy">
        We’re checking how the business shows up online — speed, security, Maps listings, and more.
        This usually finishes in a few minutes.
      </p>
    </div>
  ) : (
    <>
      <h2 class="opd-title">Online presence diagnostic</h2>
      <p class="opd-lede">An independent systems scan of your business’s digital footprint.</p>

      <div class="opd-banner">
        <span class="opd-banner-icon" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICON_PATHS.shield}</svg>`} />
        <p>
          Every score reflects data published by Google, Apple and other third-party platforms. All results can be reproduced{' '}
          <a class="opd-banner-link" href={reproduceAuditHref}>here</a>.
        </p>
      </div>

      <section class="opd-hero">
        <div class="opd-ring-wrap" aria-hidden="true">
          <svg class="opd-ring" viewBox="0 0 140 140" width="140" height="140">
            <circle class="opd-ring-track" cx="70" cy="70" r="54" />
            <circle
              class={`opd-ring-fill ${gradeClass(report.overall)}`}
              cx="70"
              cy="70"
              r="54"
              stroke-dasharray={circumference}
              stroke-dashoffset={ringOffset}
            />
          </svg>
          <div class="opd-ring-center">
            {report.overallScore != null ? (
              <span class="opd-ring-scoreline">
                <span class="opd-ring-score">{report.overallScore}</span><span class="opd-ring-over">/100</span>
              </span>
            ) : null}
            <span class={`opd-ring-grade ${gradeClass(report.overall)}`}>
              {gradeLabel(report.overall)}
            </span>
          </div>
          <div class="opd-ring-caption">Overall grade</div>
        </div>
        <div class="opd-hero-copy">
          <h3 class="opd-headline">
            {report.headline ||
              (clientName
                ? `A plain-language look at how ${clientName} shows up online.`
                : 'A plain-language look at the online presence.')}
          </h3>
          <ul class="opd-stats">
            {heroStats.map((s) => (
              <li class={`opd-stat opd-stat-${s.tone}`}>
                <span class="opd-stat-dot" aria-hidden="true" />
                <span>{s.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {featured && (
        <article class="opd-featured">
          <div class="opd-featured-badge">Key trust signal</div>
          <div class="opd-featured-row">
            <div class="opd-featured-score">
              <span
                class="opd-icon"
                aria-hidden="true"
                set:html={`<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICON_PATHS[featured.icon] || ICON_PATHS.radar}</svg>`}
              />
              <span class={`opd-grade-ring ${gradeClass(featured.grade)}`}>
                {gradeLabel(featured.grade)}
              </span>
              {featured.score != null && (
                <span class="opd-score-num">{featured.score}/100</span>
              )}
            </div>
            <div class="opd-featured-body">
              <h4>{featured.label}</h4>
              <p>{featured.finding || featured.summary}</p>
              <div class="opd-source">
                <span>SOURCE</span>
                {featured.source}
              </div>
            </div>
          </div>
        </article>
      )}

      <div class="opd-grid">
        {cats.map((cat) => {
          const numericScore =
            cat.score ??
            (cat.grade === 'A'
              ? 95
              : cat.grade === 'B'
                ? 85
                : cat.grade === 'C'
                  ? 72
                  : cat.grade === 'D'
                    ? 62
                    : 40);
          const fills = scoreBarFills(numericScore);
          const displayScore = cat.score ?? null;
          return (
            <article class="opd-card">
              <header class="opd-card-head">
                <span
                  class="opd-icon"
                  aria-hidden="true"
                  set:html={`<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICON_PATHS[cat.icon] || ICON_PATHS.search}</svg>`}
                />
                <h4>{cat.label}</h4>
                <span class={`opd-grade-ring sm ${gradeClass(cat.grade)}`}>
                  {gradeLabel(cat.grade)}
                </span>
              </header>
              <div class="opd-card-score">
                <div class="opd-bars" aria-hidden="true">
                  {fills.map((pct, i) => (
                    <span class="opd-bar" style={`height:${6 + i * 4}px`}>
                      {pct > 0 ? (
                        <span
                          class={`opd-bar-fill ${gradeClass(cat.grade)}`}
                          style={`width:${pct}%`}
                        />
                      ) : null}
                    </span>
                  ))}
                </div>
                {displayScore != null && <span class="opd-score-num">{displayScore}/100</span>}
              </div>
              <p class="opd-finding">{cat.finding || cat.summary}</p>
              <div class="opd-source">
                <span>SOURCE</span>
                {cat.source}
              </div>
            </article>
          );
        })}
      </div>

      {ideas.length > 0 && (
        <section class="opd-ideas" aria-labelledby="opd-ideas-heading">
          <h3 id="opd-ideas-heading">What to fix first</h3>
          <p class="opd-ideas-lede">Plain language: what’s broken, and what fixing it does.</p>
          <ul>
            {ideas.map((idea) => (
              <li>
                <span class="opd-idea-tag">{idea.categoryLabel}</span>
                <p class="opd-idea-problem">{idea.problem}</p>
                <p class="opd-idea-fix">{idea.solution}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <footer class="opd-footer">
        <div class="opd-legend">
          <span class="opd-legend-label">Grading scale</span>
          {AUDIT_GRADE_LEGEND.map((row) => (
            <span class="opd-legend-item">
              <i class={`grade-${row.grade.toLowerCase()}`} /> {row.grade} {row.range}
            </span>
          ))}
        </div>
        <p class="opd-stack-kicker">Measurement stack</p>
        <ul class="opd-stack">
          {AUDIT_SCAN_STACK.map((tool) => (
            <li>
              <span class="opd-stack-name">{tool.name}</span>
              <span class="opd-stack-role">{tool.role}</span>
            </li>
          ))}
        </ul>
        <p class="opd-disclaimer">{AUDIT_REPORT_DISCLAIMER}</p>
      </footer>

      {bodyHtml && (
        <details class="opd-notes">
          <summary>Full technical notes</summary>
          <div class="opd-notes-body" set:html={bodyHtml} />
        </details>
      )}
    </>
  )}
</div>

<style>
  .opd {
    --opd-bg: #0b0e13;
    --opd-panel: #131a22;
    --opd-panel-alt: #161e28;
    --opd-hairline: #232e3b;
    --opd-text: #f4f7fb;
    --opd-muted: #c5ced9;
    --opd-dim: #9aa6b5;
    --opd-cyan: #7ad7ef;
    --opd-good: #3ecf8e;
    --opd-warn: #f2b84b;
    --opd-risk: #f2884b;
    --opd-crit: #ff6b72;
    --opd-sans: 'Inter', system-ui, sans-serif;
    --opd-display: 'Space Grotesk', 'Inter', system-ui, sans-serif;
    --opd-mono: 'JetBrains Mono', ui-monospace, monospace;

    color-scheme: dark;
    color: var(--opd-text);
    font-family: var(--opd-sans);
    background:
      radial-gradient(circle at 1px 1px, rgba(35, 46, 59, 0.55) 1px, transparent 0) 0 0 / 22px 22px,
      var(--opd-bg);
    border: 1px solid var(--opd-hairline);
    border-radius: 12px;
    padding: 22px 18px 28px;
    margin: 0 -4px;
  }

  .opd-waiting {
    text-align: center;
    padding: 48px 20px;
  }
  .opd-waiting-pulse {
    width: 48px;
    height: 48px;
    margin: 0 auto 18px;
    border-radius: 50%;
    border: 2px solid var(--opd-cyan);
    border-top-color: transparent;
    animation: opd-spin 0.9s linear infinite;
  }
  @keyframes opd-spin {
    to { transform: rotate(360deg); }
  }
  .opd-waiting-title {
    font-family: var(--opd-display);
    font-size: 1.25rem;
    margin: 0 0 8px;
  }
  .opd-waiting-copy {
    color: var(--opd-muted);
    margin: 0 auto;
    max-width: 36ch;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .opd-title {
    font-family: var(--opd-display);
    font-size: clamp(1.45rem, 4vw, 1.9rem);
    font-weight: 700;
    margin: 0 0 6px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .opd-lede {
    margin: 0 0 16px;
    color: var(--opd-muted);
    font-size: 0.95rem;
  }

  .opd-banner {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    border: 1px solid var(--opd-hairline);
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 18px;
  }
  .opd-banner-icon { color: var(--opd-cyan); flex: none; margin-top: 1px; }
  .opd-banner p {
    margin: 0;
    color: var(--opd-muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .opd-banner p sup {
    font-size: 0.65em;
    line-height: 0;
    vertical-align: super;
  }
  .opd-banner-link {
    color: var(--opd-cyan);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .opd-banner-link:hover {
    color: var(--opd-fg, #f5f5f5);
  }

  .opd-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px 28px;
    background: var(--opd-panel-alt);
    border: 1px solid var(--opd-hairline);
    border-radius: 10px;
    padding: 22px 18px;
    margin-bottom: 18px;
    position: relative;
  }
  .opd-hero::before,
  .opd-hero::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--opd-cyan);
    border-style: solid;
    opacity: 0.7;
  }
  .opd-hero::before {
    top: 8px; left: 8px;
    border-width: 1.5px 0 0 1.5px;
  }
  .opd-hero::after {
    bottom: 8px; right: 8px;
    border-width: 0 1.5px 1.5px 0;
  }

  .opd-ring-wrap {
    position: relative;
    width: 140px;
    text-align: center;
  }
  .opd-ring { display: block; transform: rotate(-90deg); }
  .opd-ring-track {
    fill: none;
    stroke: var(--opd-hairline);
    stroke-width: 10;
  }
  .opd-ring-fill {
    fill: none;
    stroke-width: 10;
    stroke-linecap: round;
    transition: stroke-dashoffset 1.2s ease;
  }
  .opd-ring-fill.grade-a,
  .opd-ring-fill.grade-b { stroke: var(--opd-good); }
  .opd-ring-fill.grade-c { stroke: var(--opd-warn); }
  .opd-ring-fill.grade-d { stroke: var(--opd-risk); }
  .opd-ring-fill.grade-f,
  .opd-ring-fill.grade-na { stroke: var(--opd-crit); }

  .opd-ring-center {
    position: absolute;
    top: 0;
    left: 0;
    width: 140px;
    height: 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    line-height: 1;
    pointer-events: none;
    /* Keep the stack inside the ring's inner circumference (r=54, stroke 10). */
    padding: 28px 22px;
    box-sizing: border-box;
  }
  .opd-ring-scoreline {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    font-family: var(--opd-mono);
    font-size: 11px;
    line-height: 1;
  }
  .opd-ring-score {
    font-weight: 700;
    color: var(--opd-text);
  }
  .opd-ring-over {
    font-weight: 500;
    color: var(--opd-muted);
  }
  .opd-ring-grade {
    font-family: var(--opd-display);
    font-size: 2rem; /* ~50% larger than 1.35rem */
    font-weight: 700;
    line-height: 1;
  }
  .opd-ring-caption {
    font-family: var(--opd-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--opd-muted);
    margin-top: 4px;
  }

  .opd-headline {
    font-family: var(--opd-display);
    font-size: clamp(1.15rem, 3.2vw, 1.4rem);
    font-weight: 600;
    margin: 0 0 16px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .opd-stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .opd-stat {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-family: var(--opd-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--opd-text);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.35;
  }
  .opd-stat-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-top: 3px;
    flex: none;
    background: var(--opd-cyan);
  }
  .opd-stat-crit { color: #ffb3b7; }
  .opd-stat-crit .opd-stat-dot { background: var(--opd-crit); }
  .opd-stat-risk { color: #ffc49a; }
  .opd-stat-risk .opd-stat-dot { background: var(--opd-risk); }

  .grade-a, .grade-b { color: var(--opd-good); }
  .grade-c { color: var(--opd-warn); }
  .grade-d { color: var(--opd-risk); }
  .grade-f, .grade-na { color: var(--opd-crit); }

  .opd-featured {
    background: var(--opd-panel);
    border: 1.2px solid var(--opd-cyan);
    border-radius: 10px;
    padding: 18px 16px 16px;
    margin-bottom: 18px;
  }
  .opd-featured-badge {
    display: inline-block;
    font-family: var(--opd-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--opd-cyan);
    border: 1px solid var(--opd-cyan);
    background: rgba(69, 199, 232, 0.12);
    border-radius: 999px;
    padding: 3px 10px;
    margin-bottom: 14px;
  }
  .opd-featured-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px 18px;
    align-items: start;
  }
  .opd-featured-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--opd-cyan);
    min-width: 64px;
  }
  .opd-featured-body h4 {
    font-family: var(--opd-display);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .opd-featured-body p {
    margin: 0 0 14px;
    color: var(--opd-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .opd-grade-ring {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: none;
    display: grid;
    place-items: center;
    font-family: var(--opd-display);
    font-weight: 700;
    font-size: 15px;
    color: #0b0e13;
    background: var(--opd-dim);
  }
  .opd-grade-ring.grade-a,
  .opd-grade-ring.grade-b { background: var(--opd-good); }
  .opd-grade-ring.grade-c { background: var(--opd-warn); }
  .opd-grade-ring.grade-d { background: var(--opd-risk); }
  .opd-grade-ring.grade-f,
  .opd-grade-ring.grade-na { background: var(--opd-crit); color: #fff; }
  .opd-grade-ring.sm {
    width: 32px;
