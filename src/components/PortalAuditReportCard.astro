---
/**
 * Client-facing audit report card — letter grades + soft graphics.
 * Technical markdown stays available under "Full technical notes".
 */
import type { AuditReportCard, LetterGrade } from '../lib/auditReportCard';
import {
  Lock,
  Globe,
  Search,
  Mail,
  Server,
  MapPin,
  Apple,
  Share2,
  Star,
  Building2,
  ChevronDown,
  TrendingUp,
} from 'lucide-astro';

interface Props {
  report: AuditReportCard;
  /** Escaped/linked HTML of the raw audit body (technical notes). */
  bodyHtml?: string;
}

const { report, bodyHtml = '' } = Astro.props;

const ICONS: Record<string, typeof Lock> = {
  website: Globe,
  search: Search,
  security: Lock,
  email: Mail,
  domain: Server,
  google_business: MapPin,
  apple_business: Apple,
  social: Share2,
  reviews: Star,
  presence: Building2,
};

function gradeClass(grade: LetterGrade | null | undefined, unavailable?: boolean): string {
  if (unavailable || !grade) return 'grade-na';
  return `grade-${grade.toLowerCase()}`;
}

function gradeLabel(grade: LetterGrade | null | undefined, unavailable?: boolean): string {
  if (unavailable || !grade) return '—';
  return grade;
}

const ringPct = report.overallScore ?? 0;
const potentialPct = report.potentialScore ?? ringPct;
const circumference = 2 * Math.PI * 54;
const ringOffset = circumference - (ringPct / 100) * circumference;
---

<div class="audit-report" data-audit-report>
  {report.inProgress ? (
    <div class="audit-waiting">
      <div class="audit-waiting-pulse" aria-hidden="true" />
      <h3 class="audit-waiting-title">Building your report card</h3>
      <p class="audit-waiting-copy">
        We’re checking the website, security, email, and online listings. This usually finishes in a few minutes.
      </p>
    </div>
  ) : (
    <>
      <header class="audit-hero">
        <div class="audit-ring-wrap" aria-hidden="true">
          <svg class="audit-ring" viewBox="0 0 120 120" width="120" height="120">
            <circle class="audit-ring-track" cx="60" cy="60" r="54" />
            <circle
              class={`audit-ring-fill ${gradeClass(report.overall)}`}
              cx="60"
              cy="60"
              r="54"
              stroke-dasharray={circumference}
              stroke-dashoffset={ringOffset}
              data-ring-offset={ringOffset}
            />
          </svg>
          <div class={`audit-ring-grade ${gradeClass(report.overall)}`}>
            {gradeLabel(report.overall)}
          </div>
        </div>
        <div class="audit-hero-copy">
          <p class="audit-kicker">Online presence report card</p>
          <h3 class="audit-overall-title">
            {report.overall
              ? `Overall grade ${report.overall}`
              : 'Audit snapshot'}
          </h3>
          <p class="audit-overall-sub">
            {report.website
              ? `A plain-language look at ${report.website}. Tap any row for the why.`
              : 'A plain-language look at how the business shows up online. Tap any row for the why.'}
          </p>
        </div>
      </header>

      {(report.overallScore != null && report.potentialScore != null && report.potential && report.overall && report.potential !== report.overall) && (
        <div class="audit-benefit" data-benefit>
          <div class="audit-benefit-head">
            <TrendingUp size={16} strokeWidth={2.25} aria-hidden="true" />
            <span>Cost–benefit snapshot</span>
          </div>
          <p class="audit-benefit-copy">
            Fixing the recommended items could lift this from a
            <strong class={gradeClass(report.overall)}> {report.overall}</strong> toward a
            <strong class={gradeClass(report.potential)}> {report.potential}</strong>.
          </p>
          <div class="audit-bars" role="img" aria-label={`Current ${report.overall}, potential ${report.potential}`}>
            <div class="audit-bar-row">
              <span class="audit-bar-label">Today</span>
              <div class="audit-bar-track">
                <div
                  class={`audit-bar-fill ${gradeClass(report.overall)}`}
                  style={`--bar-pct: ${ringPct}%`}
                  data-bar
                />
              </div>
              <span class={`audit-bar-grade ${gradeClass(report.overall)}`}>{report.overall}</span>
            </div>
            <div class="audit-bar-row">
              <span class="audit-bar-label">After work</span>
              <div class="audit-bar-track">
                <div
                  class={`audit-bar-fill potential ${gradeClass(report.potential)}`}
                  style={`--bar-pct: ${potentialPct}%`}
                  data-bar
                />
              </div>
              <span class={`audit-bar-grade ${gradeClass(report.potential)}`}>{report.potential}</span>
            </div>
          </div>
        </div>
      )}

      <ul class="audit-categories" role="list">
        {report.categories.map((cat) => {
          const Icon = ICONS[cat.id] || Globe;
          const na = Boolean(cat.unavailable || !cat.grade);
          return (
            <li class="audit-cat">
              <details class="audit-cat-details">
                <summary class="audit-cat-summary">
                  <span class={`audit-cat-icon ${gradeClass(cat.grade, na)}`} aria-hidden="true">
                    <Icon size={18} strokeWidth={2.25} />
                  </span>
                  <span class="audit-cat-text">
                    <span class="audit-cat-label">{cat.label}</span>
                    <span class="audit-cat-blurb">{cat.summary}</span>
                  </span>
                  <span class={`audit-cat-grade ${gradeClass(cat.grade, na)}`}>
                    {gradeLabel(cat.grade, na)}
                  </span>
                  <span class="audit-cat-chevron" aria-hidden="true">
                    <ChevronDown size={16} strokeWidth={2.25} />
                  </span>
                </summary>
                <div class="audit-cat-body">
                  {cat.why.length > 0 ? (
                    <ul>
                      {cat.why.map((line) => (
                        <li>{line}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="audit-cat-empty">No extra detail for this row yet.</p>
                  )}
                </div>
              </details>
            </li>
          );
        })}
      </ul>

      {report.actionItems.length > 0 && (
        <div class="audit-actions">
          <h4 class="audit-actions-title">Recommended next steps</h4>
          <ol class="audit-actions-list">
            {report.actionItems.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        </div>
      )}

      {bodyHtml && (
        <details class="audit-tech">
          <summary class="audit-tech-summary">
            <span>Full technical notes</span>
            <span class="audit-cat-chevron" aria-hidden="true">
              <ChevronDown size={16} strokeWidth={2.25} />
            </span>
          </summary>
          <div class="audit-tech-body work-description" set:html={bodyHtml} />
        </details>
      )}
    </>
  )}
</div>

<script>
  function animateReport(root: HTMLElement) {
    const ring = root.querySelector<SVGCircleElement>('.audit-ring-fill');
    if (ring) {
      const target = Number(ring.dataset.ringOffset || 0);
      const full = Number(ring.getAttribute('stroke-dasharray') || 0);
      ring.style.strokeDashoffset = String(full);
      requestAnimationFrame(() => {
        ring.style.transition = 'stroke-dashoffset 1.1s cubic-bezier(0.22, 1, 0.36, 1)';
        ring.style.strokeDashoffset = String(target);
      });
    }

    root.querySelectorAll<HTMLElement>('[data-bar]').forEach((bar, i) => {
      bar.style.width = '0%';
      window.setTimeout(() => {
        bar.style.transition = 'width 0.9s cubic-bezier(0.22, 1, 0.36, 1)';
        bar.style.width = getComputedStyle(bar).getPropertyValue('--bar-pct').trim() || '0%';
      }, 180 + i * 120);
    });
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-audit-report]').forEach((el) => {
      if (el.dataset.animated === '1') return;
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            el.dataset.animated = '1';
            animateReport(el);
            io.disconnect();
          }
        },
        { threshold: 0.25 },
      );
      io.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  // Re-run when a work item expands (portal toggles [hidden]).
  document.addEventListener(
    'click',
    () => {
      window.setTimeout(boot, 50);
    },
    true,
  );
</script>

<style>
  .audit-report {
    margin: 14px 0 16px;
    padding: 16px;
    border-radius: 16px;
    background:
      radial-gradient(120% 80% at 0% 0%, rgba(56, 189, 248, 0.12), transparent 55%),
      radial-gradient(100% 70% at 100% 0%, rgba(52, 211, 153, 0.1), transparent 50%),
      rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .audit-waiting {
    position: relative;
    padding: 18px 8px 10px;
    text-align: center;
  }

  .audit-waiting-pulse {
    width: 48px;
    height: 48px;
    margin: 0 auto 14px;
    border-radius: 50%;
    background: rgba(56, 189, 248, 0.2);
    box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.45);
    animation: audit-pulse 1.6s ease-out infinite;
  }

  @keyframes audit-pulse {
    0% { box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.45); }
    70% { box-shadow: 0 0 0 18px rgba(56, 189, 248, 0); }
    100% { box-shadow: 0 0 0 0 rgba(56, 189, 248, 0); }
  }

  .audit-waiting-title {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 700;
  }

  .audit-waiting-copy {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
  }

  .audit-hero {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .audit-ring-wrap {
    position: relative;
    flex: none;
    width: 120px;
    height: 120px;
  }

  .audit-ring {
    display: block;
    transform: rotate(-90deg);
  }

  .audit-ring-track,
  .audit-ring-fill {
    fill: none;
    stroke-width: 8;
  }

  .audit-ring-track {
    stroke: rgba(255, 255, 255, 0.08);
  }

  .audit-ring-fill {
    stroke-linecap: round;
    stroke: #94a3b8;
  }

  .audit-ring-fill.grade-a { stroke: #34d399; }
  .audit-ring-fill.grade-b { stroke: #6ee7b7; }
  .audit-ring-fill.grade-c { stroke: #fbbf24; }
  .audit-ring-fill.grade-d { stroke: #fb923c; }
  .audit-ring-fill.grade-f { stroke: #f87171; }

  .audit-ring-grade {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .audit-hero-copy {
    min-width: 0;
    flex: 1;
  }

  .audit-kicker {
    margin: 0 0 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .audit-overall-title {
    margin: 0 0 6px;
    font-size: 22px;
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .audit-overall-sub {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.62);
  }

  .grade-a { color: #34d399; }
  .grade-b { color: #6ee7b7; }
  .grade-c { color: #fbbf24; }
  .grade-d { color: #fb923c; }
  .grade-f { color: #f87171; }
  .grade-na { color: rgba(255, 255, 255, 0.38); }

  .audit-benefit {
    margin: 0 0 14px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .audit-benefit-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 6px;
  }

  .audit-benefit-copy {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
  }

  .audit-benefit-copy strong {
    font-weight: 750;
  }

  .audit-bars {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .audit-bar-row {
    display: grid;
    grid-template-columns: 72px 1fr 22px;
    gap: 8px;
    align-items: center;
  }

  .audit-bar-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }

  .audit-bar-track {
    height: 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .audit-bar-fill {
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: #94a3b8;
  }

  .audit-bar-fill.grade-a { background: linear-gradient(90deg, #059669, #34d399); }
  .audit-bar-fill.grade-b { background: linear-gradient(90deg, #10b981, #6ee7b7); }
  .audit-bar-fill.grade-c { background: linear-gradient(90deg, #d97706, #fbbf24); }
  .audit-bar-fill.grade-d { background: linear-gradient(90deg, #ea580c, #fb923c); }
  .audit-bar-fill.grade-f { background: linear-gradient(90deg, #dc2626, #f87171); }
  .audit-bar-fill.potential {
    opacity: 0.95;
  }

  .audit-bar-grade {
    font-size: 13px;
    font-weight: 800;
    text-align: center;
  }

  .audit-categories {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .audit-cat-details {
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }

  .audit-cat-summary {
    display: grid;
    grid-template-columns: 36px 1fr auto 16px;
    gap: 10px;
    align-items: center;
    padding: 11px 12px;
    cursor: pointer;
    list-style: none;
  }

  .audit-cat-summary::-webkit-details-marker {
    display: none;
  }

  .audit-cat-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.06);
  }

  .audit-cat-icon.grade-a { background: rgba(52, 211, 153, 0.14); }
  .audit-cat-icon.grade-b { background: rgba(110, 231, 183, 0.12); }
  .audit-cat-icon.grade-c { background: rgba(251, 191, 36, 0.14); }
  .audit-cat-icon.grade-d { background: rgba(251, 146, 60, 0.14); }
  .audit-cat-icon.grade-f { background: rgba(248, 113, 113, 0.14); }

  .audit-cat-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .audit-cat-label {
    font-size: 14px;
    font-weight: 700;
  }

  .audit-cat-blurb {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.52);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .audit-cat-grade {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.03em;
    min-width: 1.25em;
    text-align: center;
  }

  .audit-cat-chevron {
    color: rgba(255, 255, 255, 0.4);
    transition: transform 0.2s ease;
  }

  .audit-cat-details[open] .audit-cat-chevron,
  .audit-tech[open] .audit-cat-chevron {
    transform: rotate(180deg);
  }

  .audit-cat-body {
    padding: 0 14px 12px 58px;
  }

  .audit-cat-body ul {
    margin: 0;
    padding: 0 0 0 1.1em;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .audit-cat-body li {
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
  }

  .audit-cat-empty {
    margin: 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
  }

  .audit-actions {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .audit-actions-title {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .audit-actions-list {
    margin: 0;
    padding-left: 1.2em;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .audit-actions-list li {
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.86);
  }

  .audit-tech {
    margin-top: 14px;
    border-radius: 12px;
    border: 1px dashed rgba(255, 255, 255, 0.14);
    background: rgba(0, 0, 0, 0.18);
  }

  .audit-tech-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    cursor: pointer;
    list-style: none;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.62);
  }

  .audit-tech-summary::-webkit-details-marker {
    display: none;
  }

  .audit-tech-body {
    margin: 0 12px 12px;
    padding: 12px 14px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 13px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }

  .audit-tech-body :global(a) {
    color: var(--portal-accent, #7dd3fc);
  }

  .audit-tech-body :global(.work-body-img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 10px 0;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 420px) {
    .audit-hero {
      flex-direction: column;
      align-items: flex-start;
    }

    .audit-bar-row {
      grid-template-columns: 64px 1fr 20px;
    }

    .audit-cat-body {
      padding-left: 14px;
    }
  }
</style>
