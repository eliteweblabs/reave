---
/**
 * Client-facing audit report card — letter grades + soft graphics.
 * Technical markdown stays available under "Full technical notes".
 */
import type { AuditReportCard, LetterGrade } from '../lib/auditReportCard';
import {
  Lock,
  Gauge,
  Accessibility,
  BadgeCheck,
  Search,
  Mail,
  Server,
  MapPin,
  Apple,
  Share2,
  Star,
  Building2,
  ChevronDown,
  TrendingUp,
  Lightbulb,
  ArrowRight,
  Globe,
} from 'lucide-astro';

interface Props {
  report: AuditReportCard;
  /** Escaped/linked HTML of the raw audit body (technical notes). */
  bodyHtml?: string;
}

const { report, bodyHtml = '' } = Astro.props;

const ICONS: Record<string, typeof Lock> = {
  performance: Gauge,
  accessibility: Accessibility,
  best_practices: BadgeCheck,
  seo: Search,
  security: Lock,
  email: Mail,
  domain: Server,
  google_business: MapPin,
  apple_business: Apple,
  social: Share2,
  reviews: Star,
  presence: Building2,
};

function gradeClass(grade: LetterGrade | null | undefined, unavailable?: boolean): string {
  if (unavailable || !grade) return 'grade-na';
  return `grade-${grade.toLowerCase()}`;
}

function gradeLabel(grade: LetterGrade | null | undefined, unavailable?: boolean): string {
  if (unavailable || !grade) return '—';
  return grade;
}

const ringPct = report.overallScore ?? 0;
const potentialPct = report.potentialScore ?? ringPct;
const circumference = 2 * Math.PI * 54;
const ringOffset = circumference - (ringPct / 100) * circumference;
const ideaCount = report.ideas?.length ?? 0;
const scoredCats = (report.categories || []).filter((c) => c.grade && !c.unavailable);
const weakCount = scoredCats.filter((c) => c.grade === 'D' || c.grade === 'F').length;
---

<div class="audit-report" data-audit-report>
  {report.inProgress ? (
    <div class="audit-waiting">
      <div class="audit-waiting-pulse" aria-hidden="true" />
      <h3 class="audit-waiting-title">Building your report card</h3>
      <p class="audit-waiting-copy">
        We’re checking performance, accessibility, security, email, and online listings. This usually finishes in a few minutes.
      </p>
    </div>
  ) : (
    <>
      <p class="audit-method">
        Scores reflect platform-reported checks (PageSpeed, SSL, DNS, Google / Apple listings, and more) — not a sales opinion.
      </p>

      <header class="audit-hero">
        <div class="audit-ring-wrap" aria-hidden="true">
          <svg class="audit-ring" viewBox="0 0 120 120" width="120" height="120">
            <circle class="audit-ring-track" cx="60" cy="60" r="54" />
            <circle
              class={`audit-ring-fill ${gradeClass(report.overall)}`}
              cx="60"
              cy="60"
              r="54"
              stroke-dasharray={circumference}
              stroke-dashoffset={ringOffset}
              data-ring-offset={ringOffset}
            />
          </svg>
          <div class="audit-ring-center">
            {report.overallScore != null ? (
              <>
                <span class="audit-ring-score">{report.overallScore}</span>
                <span class="audit-ring-over">/ 100</span>
              </>
            ) : null}
            <span class={`audit-ring-grade ${gradeClass(report.overall)}`}>
              {gradeLabel(report.overall)}
            </span>
          </div>
        </div>
        <div class="audit-hero-copy">
          <p class="audit-kicker">Online presence diagnostic</p>
          <h3 class="audit-overall-title">
            {report.overall
              ? `Overall grade ${report.overall}`
              : 'Audit snapshot'}
          </h3>
          <p class="audit-overall-sub">
            {report.website
              ? `A plain-language look at ${report.website}.`
              : 'A plain-language look at how the business shows up online.'}
            {weakCount > 0
              ? ` ${weakCount} area${weakCount === 1 ? '' : 's'} need attention.`
              : ' Tap any row for the why.'}
          </p>
          {ideaCount > 0 && (
            <p class="audit-hero-stat">
              {ideaCount} opportunity{ideaCount === 1 ? '' : 'ies'} to improve presence
            </p>
          )}
        </div>
      </header>

      {ideaCount > 0 && (
        <section class="audit-ideas" aria-labelledby="audit-ideas-heading">
          <div class="audit-ideas-head">
            <Lightbulb size={18} strokeWidth={2.25} aria-hidden="true" />
            <div>
              <h4 id="audit-ideas-heading">Ideas &amp; opportunities</h4>
              <p>Problem → solution. These are the services that would move the grade.</p>
            </div>
          </div>
          <ul class="audit-ideas-list">
            {report.ideas.map((idea) => (
              <li class="audit-idea">
                <span class="audit-idea-tag">{idea.categoryLabel}</span>
                <div class="audit-idea-problem">
                  <span class="audit-idea-label">Problem</span>
                  <p>{idea.problem}</p>
                </div>
                <div class="audit-idea-arrow" aria-hidden="true">
                  <ArrowRight size={16} strokeWidth={2.25} />
                </div>
                <div class="audit-idea-solution">
                  <span class="audit-idea-label">Solution</span>
                  <p>{idea.solution}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(report.overallScore != null && report.potentialScore != null && report.potential && report.overall && report.potential !== report.overall) && (
        <div class="audit-benefit" data-benefit>
          <div class="audit-benefit-head">
            <TrendingUp size={16} strokeWidth={2.25} aria-hidden="true" />
            <span>Cost–benefit snapshot</span>
          </div>
          <p class="audit-benefit-copy">
            Fixing the opportunities above could lift this from a
            <strong class={gradeClass(report.overall)}> {report.overall}</strong> toward a
            <strong class={gradeClass(report.potential)}> {report.potential}</strong>.
          </p>
          <div class="audit-bars" role="img" aria-label={`Current ${report.overall}, potential ${report.potential}`}>
            <div class="audit-bar-row">
              <span class="audit-bar-label">Today</span>
              <div class="audit-bar-track">
                <div
                  class={`audit-bar-fill ${gradeClass(report.overall)}`}
                  style={`--bar-pct: ${ringPct}%`}
                  data-bar
                />
              </div>
              <span class={`audit-bar-grade ${gradeClass(report.overall)}`}>{report.overall}</span>
            </div>
            <div class="audit-bar-row">
              <span class="audit-bar-label">After work</span>
              <div class="audit-bar-track">
                <div
                  class={`audit-bar-fill potential ${gradeClass(report.potential)}`}
                  style={`--bar-pct: ${potentialPct}%`}
                  data-bar
                />
              </div>
              <span class={`audit-bar-grade ${gradeClass(report.potential)}`}>{report.potential}</span>
            </div>
          </div>
        </div>
      )}

      <div class="audit-section-label">Report card</div>
      <ul class="audit-categories" role="list">
        {report.categories.map((cat) => {
          const Icon = ICONS[cat.id] || Globe;
          const na = Boolean(cat.unavailable || !cat.grade);
          const idea = report.ideas.find((i) => i.categoryId === cat.id);
          return (
            <li class="audit-cat">
              <details class="audit-cat-details">
                <summary class="audit-cat-summary">
                  <span class={`audit-cat-icon ${gradeClass(cat.grade, na)}`} aria-hidden="true">
                    <Icon size={18} strokeWidth={2.25} />
                  </span>
                  <span class="audit-cat-text">
                    <span class="audit-cat-label">{cat.label}</span>
                    <span class="audit-cat-blurb">
                      {cat.score != null ? `${cat.score}/100 · ${cat.summary}` : cat.summary}
                    </span>
                  </span>
                  <span class={`audit-cat-grade-ring ${gradeClass(cat.grade, na)}`}>
                    {gradeLabel(cat.grade, na)}
                  </span>
                  <span class="audit-cat-chevron" aria-hidden="true">
                    <ChevronDown size={16} strokeWidth={2.25} />
                  </span>
                </summary>
                <div class="audit-cat-body">
                  {cat.why.length > 0 ? (
                    <ul>
                      {cat.why.map((line) => (
                        <li>{line}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="audit-cat-empty">No extra detail for this row yet.</p>
                  )}
                  {idea && (
                    <div class="audit-cat-idea">
                      <span class="audit-idea-label">Opportunity</span>
                      <p><strong>Problem:</strong> {idea.problem}</p>
                      <p><strong>Solution:</strong> {idea.solution}</p>
                    </div>
                  )}
                </div>
              </details>
            </li>
          );
        })}
      </ul>

      <p class="audit-scale">
        Grading scale · A 90–100 · B 80–89 · C 70–79 · D 60–69 · F below 60
      </p>

      {report.actionItems.length > 0 && (
        <div class="audit-actions">
          <h4 class="audit-actions-title">Recommended next steps</h4>
          <ol class="audit-actions-list">
            {report.actionItems.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        </div>
      )}

      {bodyHtml && (
        <details class="audit-tech">
          <summary class="audit-tech-summary">
            <span>Full technical notes</span>
            <span class="audit-cat-chevron" aria-hidden="true">
              <ChevronDown size={16} strokeWidth={2.25} />
            </span>
          </summary>
          <div class="audit-tech-body work-description" set:html={bodyHtml} />
        </details>
      )}
    </>
  )}
</div>

<script>
  function animateReport(root: HTMLElement) {
    const ring = root.querySelector<SVGCircleElement>('.audit-ring-fill');
    if (ring) {
      const target = Number(ring.dataset.ringOffset || 0);
      const full = Number(ring.getAttribute('stroke-dasharray') || 0);
      ring.style.strokeDashoffset = String(full);
      requestAnimationFrame(() => {
        ring.style.transition = 'stroke-dashoffset 1.1s cubic-bezier(0.22, 1, 0.36, 1)';
        ring.style.strokeDashoffset = String(target);
      });
    }

    root.querySelectorAll<HTMLElement>('[data-bar]').forEach((bar, i) => {
      bar.style.width = '0%';
      window.setTimeout(() => {
        bar.style.transition = 'width 0.9s cubic-bezier(0.22, 1, 0.36, 1)';
        bar.style.width = getComputedStyle(bar).getPropertyValue('--bar-pct').trim() || '0%';
      }, 180 + i * 120);
    });
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-audit-report]').forEach((el) => {
      if (el.dataset.animated === '1') return;
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            el.dataset.animated = '1';
            animateReport(el);
            io.disconnect();
          }
        },
        { threshold: 0.25 },
      );
      io.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  document.addEventListener(
    'click',
    () => {
      window.setTimeout(boot, 50);
    },
    true,
  );
</script>

<style>
  .audit-report {
    --audit-cyan: #45c7e8;
    --audit-good: #3ecf8e;
    --audit-warn: #f2b84b;
    --audit-risk: #f2884b;
    --audit-crit: #f2545b;
    --audit-panel: rgba(19, 26, 34, 0.85);
    --audit-line: #232e3b;
    margin: 14px 0 16px;
    padding: 16px;
    border-radius: 14px;
    background:
      radial-gradient(120% 80% at 0% 0%, rgba(69, 199, 232, 0.1), transparent 55%),
      var(--audit-panel);
    border: 1px solid var(--audit-line);
  }

  .audit-method {
    margin: 0 0 14px;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid var(--audit-line);
    font-size: 12px;
    line-height: 1.45;
    color: rgba(237, 241, 247, 0.62);
  }

  .audit-waiting {
    position: relative;
    padding: 18px 8px 10px;
    text-align: center;
  }

  .audit-waiting-pulse {
    width: 48px;
    height: 48px;
    margin: 0 auto 14px;
    border-radius: 50%;
    background: rgba(69, 199, 232, 0.2);
    box-shadow: 0 0 0 0 rgba(69, 199, 232, 0.45);
    animation: audit-pulse 1.6s ease-out infinite;
  }

  @keyframes audit-pulse {
    0% { box-shadow: 0 0 0 0 rgba(69, 199, 232, 0.45); }
    70% { box-shadow: 0 0 0 18px rgba(69, 199, 232, 0); }
    100% { box-shadow: 0 0 0 0 rgba(69, 199, 232, 0); }
  }

  .audit-waiting-title {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 700;
  }

  .audit-waiting-copy {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
  }

  .audit-hero {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .audit-ring-wrap {
    position: relative;
    flex: none;
    width: 120px;
    height: 120px;
  }

  .audit-ring {
    display: block;
    transform: rotate(-90deg);
  }

  .audit-ring-track,
  .audit-ring-fill {
    fill: none;
    stroke-width: 8;
  }

  .audit-ring-track {
    stroke: rgba(255, 255, 255, 0.08);
  }

  .audit-ring-fill {
    stroke-linecap: round;
    stroke: #94a3b8;
  }

  .audit-ring-fill.grade-a,
  .audit-ring-fill.grade-b { stroke: var(--audit-good); }
  .audit-ring-fill.grade-c { stroke: var(--audit-warn); }
  .audit-ring-fill.grade-d { stroke: var(--audit-risk); }
  .audit-ring-fill.grade-f { stroke: var(--audit-crit); }

  .audit-ring-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    line-height: 1;
  }

  .audit-ring-score {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .audit-ring-over {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.45);
    margin: 2px 0 4px;
  }

  .audit-ring-grade {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .audit-hero-copy {
    min-width: 0;
    flex: 1;
  }

  .audit-kicker {
    margin: 0 0 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--audit-cyan);
  }

  .audit-overall-title {
    margin: 0 0 6px;
    font-size: 22px;
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .audit-overall-sub {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.62);
  }

  .audit-hero-stat {
    margin: 8px 0 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--audit-cyan);
  }

  .grade-a,
  .grade-b { color: var(--audit-good); }
  .grade-c { color: var(--audit-warn); }
  .grade-d { color: var(--audit-risk); }
  .grade-f { color: var(--audit-crit); }
  .grade-na { color: rgba(255, 255, 255, 0.38); }

  .audit-ideas {
    margin: 0 0 14px;
    padding: 14px;
    border-radius: 12px;
    border: 1px solid rgba(69, 199, 232, 0.35);
    background: rgba(69, 199, 232, 0.06);
  }

  .audit-ideas-head {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 12px;
    color: var(--audit-cyan);
  }

  .audit-ideas-head h4 {
    margin: 0 0 2px;
    font-size: 15px;
    font-weight: 750;
    color: #edf1f7;
  }

  .audit-ideas-head p {
    margin: 0;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
  }

  .audit-ideas-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .audit-idea {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 8px 10px;
    padding: 12px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .audit-idea-tag {
    grid-column: 1 / -1;
    justify-self: start;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--audit-cyan);
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(69, 199, 232, 0.12);
    border: 1px solid rgba(69, 199, 232, 0.25);
  }

  .audit-idea-label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 4px;
  }

  .audit-idea-problem p,
  .audit-idea-solution p {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(237, 241, 247, 0.88);
  }

  .audit-idea-solution p {
    color: #9ae6c5;
  }

  .audit-idea-arrow {
    display: grid;
    place-items: center;
    color: var(--audit-cyan);
    align-self: center;
  }

  .audit-benefit {
    margin: 0 0 14px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .audit-benefit-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 6px;
  }

  .audit-benefit-copy {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
  }

  .audit-benefit-copy strong {
    font-weight: 750;
  }

  .audit-bars {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .audit-bar-row {
    display: grid;
    grid-template-columns: 72px 1fr 22px;
    gap: 8px;
    align-items: center;
  }

  .audit-bar-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }

  .audit-bar-track {
    height: 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .audit-bar-fill {
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: #94a3b8;
  }

  .audit-bar-fill.grade-a,
  .audit-bar-fill.grade-b { background: linear-gradient(90deg, #059669, var(--audit-good)); }
  .audit-bar-fill.grade-c { background: linear-gradient(90deg, #d97706, var(--audit-warn)); }
  .audit-bar-fill.grade-d { background: linear-gradient(90deg, #ea580c, var(--audit-risk)); }
  .audit-bar-fill.grade-f { background: linear-gradient(90deg, #dc2626, var(--audit-crit)); }

  .audit-bar-grade {
    font-size: 13px;
    font-weight: 800;
    text-align: center;
  }

  .audit-section-label {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .audit-categories {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .audit-cat-details {
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }

  .audit-cat-summary {
    display: grid;
    grid-template-columns: 36px 1fr auto 16px;
    gap: 10px;
    align-items: center;
    padding: 11px 12px;
    cursor: pointer;
    list-style: none;
  }

  .audit-cat-summary::-webkit-details-marker {
    display: none;
  }

  .audit-cat-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: rgba(69, 199, 232, 0.1);
    color: var(--audit-cyan);
  }

  .audit-cat-icon.grade-a,
  .audit-cat-icon.grade-b { background: rgba(62, 207, 142, 0.14); color: var(--audit-good); }
  .audit-cat-icon.grade-c { background: rgba(242, 184, 75, 0.14); color: var(--audit-warn); }
  .audit-cat-icon.grade-d { background: rgba(242, 136, 75, 0.14); color: var(--audit-risk); }
  .audit-cat-icon.grade-f { background: rgba(242, 84, 91, 0.14); color: var(--audit-crit); }

  .audit-cat-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .audit-cat-label {
    font-size: 14px;
    font-weight: 700;
  }

  .audit-cat-blurb {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.52);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .audit-cat-grade-ring {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -0.03em;
    border: 2px solid currentColor;
  }

  .audit-cat-chevron {
    color: rgba(255, 255, 255, 0.4);
    transition: transform 0.2s ease;
    display: grid;
    place-items: center;
  }

  .audit-cat-details[open] .audit-cat-chevron,
  .audit-tech[open] .audit-cat-chevron {
    transform: rotate(180deg);
  }

  .audit-cat-body {
    padding: 0 14px 12px 58px;
  }

  .audit-cat-body ul {
    margin: 0;
    padding: 0 0 0 1.1em;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .audit-cat-body li {
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
  }

  .audit-cat-empty {
