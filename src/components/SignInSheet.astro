---
import IosBottomSheet from './IosBottomSheet.astro';
import { isClerkFrontendConfigured } from '../lib/clerkClient';

interface Props {
  /** Where to send the user after a successful sign-in. */
  fallbackRedirectUrl?: string;
  allowSignUp?: boolean;
  /** Open automatically once the page loads (e.g. signed-out /admin visit). */
  autoOpen?: boolean;
  /**
   * When false, backdrop / Escape / swipe do not dismiss.
   * Dedicated login pages pass true plus `closeHref` so the X can leave.
   * Defaults to true — the sheet always shows a close control.
   */
  dismissible?: boolean;
  /** Close control navigates here (e.g. `/` from `/sign-in` or `/admin/login`). */
  closeHref?: string;
  /** Current page path+query — Clerk hash routing keeps sign-in/sign-up in the sheet. */
  authPath?: string;
}

const {
  fallbackRedirectUrl = '/admin/',
  allowSignUp = import.meta.env.PUBLIC_CLERK_ALLOW_SIGN_UP !== '0',
  autoOpen = false,
  dismissible: dismissibleProp,
  closeHref = '',
  authPath = '/sign-in',
} = Astro.props;

const clerkReady = isClerkFrontendConfigured();
const dismissible = dismissibleProp ?? true;
const startOnSignUp = allowSignUp && Astro.url.searchParams.get('mode') === 'sign-up';
const sheetAutoOpen = autoOpen && clerkReady;

/** Clerk in the bottom sheet — no nested card chrome; body padding comes from ios-sheet. */
const clerkAppearance = {
  options: {
    elevation: 'flush',
  },
  elements: {
    rootBox: {
      width: '100%',
      maxWidth: '100%',
    },
    cardBox: {
      width: '100%',
      maxWidth: '100%',
      margin: '0',
      padding: '0',
      boxShadow: 'none',
    },
    card: {
      width: '100%',
      maxWidth: '100%',
      margin: '0',
      padding: '0',
      boxShadow: 'none',
      border: 'none',
      borderRadius: '0',
      background: 'transparent',
    },
    scrollBox: {
      width: '100%',
      maxWidth: '100%',
    },
    main: {
      padding: '0',
    },
    footer: {
      padding: '0',
      background: 'transparent',
      boxShadow: 'none',
    },
    footerAction: allowSignUp
      ? { background: 'transparent' }
      : { display: 'none', background: 'transparent' },
    ...(allowSignUp
      ? {}
      : {
          footerActionLink: { display: 'none' },
          footerActionText: { display: 'none' },
        }),
    header: { display: 'none' },
    headerTitle: { display: 'none' },
    headerSubtitle: { display: 'none' },
  },
};
---

<IosBottomSheet
  id="sign-in-sheet"
  title={startOnSignUp ? 'Sign up' : 'Sign in'}
  dismissible={dismissible}
  closeHref={closeHref}
  showClose={true}
  startOpen={sheetAutoOpen}
  class="sign-in-sheet"
>
  {/*
    Mount Clerk client-side only. Never SSR-mount <SignIn> on /admin when the
    browser already has a Clerk user but the server cookie is missing — Clerk
    would redirect to fallbackRedirectUrl (/admin/) forever.
  */}
  {
    clerkReady ? (
      <div id="sign-in-clerk-root"></div>
    ) : (
      <p id="sign-in-clerk-missing" class="sign-in-clerk-missing">
        Sign-in is not connected on this install yet.
      </p>
    )
  }
  <div id="sign-in-session-stuck" class="sign-in-session-stuck" hidden>
    <p>
      This browser is signed in, but the server still does not see your session.
      Sign out and try again — do not keep refreshing.
    </p>
    <button type="button" id="sign-in-stuck-sign-out" class="sign-in-stuck-btn">
      Sign out and try again
    </button>
  </div>
</IosBottomSheet>

<script is:inline src={`/ios-sheet.js?v=${__PUBLIC_ASSET_VERSION__}`} defer></script>

<style is:global>
  /* Match Clerk default theme to sheet light/dark (do not force theme: dark). */
  #sign-in-sheet {
    color-scheme: light dark;
  }

  #sign-in-sheet .ios-sheet-body {
    padding: 0.75rem 1.35rem 1.5rem;
  }

  #sign-in-sheet .sign-in-clerk-missing {
    margin: 0;
    color: inherit;
    font-size: 0.95rem;
    line-height: 1.45;
    opacity: 0.78;
  }

  #sign-in-sheet .cl-rootBox,
  #sign-in-sheet .cl-cardBox,
  #sign-in-sheet .cl-card {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    box-shadow: none;
    border: none;
    border-radius: 0;
    background: transparent;
  }

  #sign-in-sheet .cl-footer,
  #sign-in-sheet .cl-footerAction {
    background: transparent;
    box-shadow: none;
  }

  #sign-in-sheet.ios-sheet-keyboard .cl-rootBox,
  #sign-in-sheet.ios-sheet-keyboard .cl-cardBox,
  #sign-in-sheet.ios-sheet-keyboard .cl-card,
  #sign-in-sheet.ios-sheet-keyboard .cl-scrollBox {
    max-height: 100%;
  }

  .sign-in-session-stuck {
    display: grid;
    gap: 1rem;
    padding: 0.25rem 0 0.5rem;
    color: inherit;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .sign-in-session-stuck[hidden] {
    display: none;
  }

  .sign-in-stuck-btn {
    appearance: none;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 8%, transparent);
    color: inherit;
    font: inherit;
    font-weight: 600;
    padding: 0.7rem 1rem;
    cursor: pointer;
  }
</style>

<script type="module" define:vars={{ autoOpenSignIn: sheetAutoOpen, fallbackRedirectUrl, authPath, allowSignUp, startOnSignUp, clerkAppearance, closeHref }}>
  import { bindClerkSsrSessionSync } from '/admin/shared.js?v=20260813a';

  const AUTH_MOUNT_KEY = '__reaveClerkAuthMounted';
  /** One SSR sync reload after client sign-in — never a loop. */
  const SSR_SYNC_KEY = 'reave-clerk-ssr-sync-once';
  let halfSessionAutoClearAttempted = false;

  function onLoginPage() {
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    return (
      path === '/admin/login' ||
      path === '/sign-in' ||
      authPath === '/admin/login' ||
      authPath === '/sign-in'
    );
  }

  function serverHasStaffSession() {
    return Boolean(document.body?.dataset?.userId?.trim());
  }

  function onAdminPath() {
    return window.location.pathname.startsWith('/admin');
  }

  function ssrSyncAlreadyTried() {
    try {
      return sessionStorage.getItem(SSR_SYNC_KEY) === '1';
    } catch {
      return false;
    }
  }

  function markSsrSyncTried() {
    try {
      sessionStorage.setItem(SSR_SYNC_KEY, '1');
    } catch {
      /* ignore */
    }
  }

  function clearSsrSyncMark() {
    try {
      sessionStorage.removeItem(SSR_SYNC_KEY);
    } catch {
      /* ignore */
    }
  }

  /**
   * After phone OTP, Clerk JS has a user and an HttpOnly `__session` the
   * page cannot read. Reload once so SSR can see the cookie. Never loop.
   */
  function reloadOnceForSsrCookie() {
    if (serverHasStaffSession()) {
      clearSsrSyncMark();
      return false;
    }
    if (ssrSyncAlreadyTried()) return false;
    markSsrSyncTried();
    console.info('[reave] syncing Clerk session cookie to SSR (one reload)');
    window.setTimeout(() => window.location.reload(), 50);
    return true;
  }

  /**
   * Block /admin → /admin hard navigations while Clerk JS has a user but SSR
   * does not — except the single cookie-sync reload above.
   */
  function installHalfSessionRedirectGuard() {
    if (window.__reaveHalfSessionGuard) return;
    window.__reaveHalfSessionGuard = true;

    const shouldBlock = (url) => {
      if (!window.Clerk?.user || serverHasStaffSession()) return false;
      if (!onAdminPath()) return false;
      try {
        const next = new URL(String(url), window.location.origin);
        return next.origin === window.location.origin && next.pathname.startsWith('/admin');
      } catch {
        return false;
      }
    };

    const proto = window.Location?.prototype;
    if (!proto) return;
    for (const method of ['assign', 'replace']) {
      const original = proto[method];
      if (typeof original !== 'function') continue;
      proto[method] = function patchedLocationNav(url) {
        if (shouldBlock(url)) {
          if (reloadOnceForSsrCookie()) return;
          console.warn('[reave] blocked half-session admin redirect loop', url);
          showStuckSession();
          return;
        }
        return original.call(this, url);
      };
    }
  }

  function showStuckSession() {
    const root = document.getElementById('sign-in-clerk-root');
    const stuck = document.getElementById('sign-in-session-stuck');
    if (root) root.hidden = true;
    if (stuck) stuck.hidden = false;
    window.IosSheet?.open('sign-in-sheet');

    const btn = document.getElementById('sign-in-stuck-sign-out');
    if (btn && !btn.dataset.bound) {
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => void clearHalfSessionAndShowSignIn(true));
    }
  }

  /**
   * Drop a client-only Clerk session (common after clearing cache / cookies).
   * On login pages we do this automatically; elsewhere the user taps the button.
   */
  async function clearHalfSessionAndShowSignIn(fromUser = false) {
    if (!fromUser && halfSessionAutoClearAttempted) {
      showStuckSession();
      return;
    }
    if (!fromUser) halfSessionAutoClearAttempted = true;

    const btn = document.getElementById('sign-in-stuck-sign-out');
    if (btn) btn.disabled = true;
    clearSsrSyncMark();
    const root = document.getElementById('sign-in-clerk-root');
    const stuck = document.getElementById('sign-in-session-stuck');
    if (stuck) stuck.hidden = true;
    if (root) root.hidden = false;
    window[AUTH_MOUNT_KEY] = false;
    try {
      await window.Clerk?.signOut?.();
    } catch (err) {
      console.warn('[reave] half-session signOut failed', err);
      if (fromUser) window.location.assign(authPath);
      else showStuckSession();
      return;
    }
    if (btn) btn.disabled = false;
    if (window.Clerk?.user) {
      showStuckSession();
      return;
    }
    mountClerkAuth();
  }

  function mountClerkAuth() {
    if (window[AUTH_MOUNT_KEY]) return;
    const clerk = window.Clerk;
    const root = document.getElementById('sign-in-clerk-root');
    if (!clerk?.loaded || !root || !clerk.mountSignIn) return;

    installHalfSessionRedirectGuard();

    if (clerk.user && serverHasStaffSession()) {
      window[AUTH_MOUNT_KEY] = true;
      clearSsrSyncMark();
      return;
    }

    // Client session without SSR userId: sync once, else clear stale session on login pages.
    if (clerk.user && !serverHasStaffSession()) {
      window[AUTH_MOUNT_KEY] = true;
      if (reloadOnceForSsrCookie()) return;
      if (onLoginPage()) {
        void clearHalfSessionAndShowSignIn();
        return;
      }
      showStuckSession();
      return;
    }

    window[AUTH_MOUNT_KEY] = true;
    const stuck = document.getElementById('sign-in-session-stuck');
    if (stuck) stuck.hidden = true;
    root.hidden = false;

    const signUpPath = `${authPath}?mode=sign-up`;
    const showSignUp =
      allowSignUp &&
      (startOnSignUp ||
        new URLSearchParams(window.location.search).get('mode') === 'sign-up' ||
        /^#\/?sign-up(\/|$)/i.test(window.location.hash));
    const titleEl = document.getElementById('sign-in-sheet-title');
    if (titleEl) titleEl.textContent = showSignUp ? 'Sign up' : 'Sign in';

    const mountOpts = {
      routing: 'hash',
      signInUrl: authPath,
      signUpUrl: allowSignUp ? signUpPath : authPath,
      fallbackRedirectUrl,
      appearance: clerkAppearance,
    };

    if (showSignUp && clerk.mountSignUp) {
      clerk.mountSignUp(root, mountOpts);
    } else {
      clerk.mountSignIn(root, mountOpts);
    }

    // After OTP inside the sheet, cookie appears before any navigation — sync once.
    clerk.addListener?.(({ user }) => {
      if (user && !serverHasStaffSession()) reloadOnceForSsrCookie();
    });
  }

  function onClerkReady() {
    // Fresh login visit after cache clear — allow one SSR cookie sync attempt.
    if (onLoginPage() && !serverHasStaffSession()) clearSsrSyncMark();
    mountClerkAuth();
    bindClerkSsrSessionSync({ autoOpenSignIn });
  }

  if (closeHref) {
    document.getElementById('sign-in-sheet')?.addEventListener('ios-sheet-close', () => {
      if (serverHasStaffSession()) return;
      const next = String(closeHref);
      if (next.startsWith('/') && !next.startsWith('//')) window.location.assign(next);
    });
  }

  if (autoOpenSignIn) {
    const openSheet = () => window.IosSheet?.open('sign-in-sheet');
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', openSheet);
    } else {
      openSheet();
    }
  }

  window.addEventListener('clerk-loaded', onClerkReady, true);
  if (window.Clerk?.loaded) onClerkReady();
  else {
    const started = Date.now();
    const timer = setInterval(() => {
      if (window.Clerk?.loaded) {
        clearInterval(timer);
        onClerkReady();
      } else if (Date.now() - started > 20000) {
        clearInterval(timer);
      }
    }, 50);
  }
</script>
