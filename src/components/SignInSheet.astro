---
import IosBottomSheet from './IosBottomSheet.astro';
import { isClerkFrontendConfigured } from '../lib/clerkClient';

interface Props {
  /** Where to send the user after a successful sign-in. */
  fallbackRedirectUrl?: string;
  allowSignUp?: boolean;
  /** Open automatically once the page loads (e.g. signed-out /admin visit). */
  autoOpen?: boolean;
  /**
   * When false, backdrop / Escape / swipe do not dismiss.
   * Dedicated login pages pass true plus `closeHref` so the X can leave.
   * Defaults to true — the sheet always shows a close control.
   */
  dismissible?: boolean;
  /** Close control navigates here (e.g. `/` from `/sign-in` or `/admin/login`). */
  closeHref?: string;
  /** Current page path+query — Clerk hash routing keeps sign-in/sign-up in the sheet. */
  authPath?: string;
}

const {
  fallbackRedirectUrl = '/admin/',
  allowSignUp = import.meta.env.PUBLIC_CLERK_ALLOW_SIGN_UP !== '0',
  autoOpen = false,
  dismissible: dismissibleProp,
  closeHref = '',
  authPath = '/sign-in',
} = Astro.props;

const clerkReady = isClerkFrontendConfigured();
const dismissible = dismissibleProp ?? true;
const startOnSignUp = allowSignUp && Astro.url.searchParams.get('mode') === 'sign-up';
const sheetAutoOpen = autoOpen && clerkReady;
/** public/ scripts bypass middleware — match AdminBootScripts cache bust. */
const assetVersion = __PUBLIC_ASSET_VERSION__;

const signInSheetConfig = JSON.stringify({
  autoOpenSignIn: sheetAutoOpen,
  fallbackRedirectUrl,
  authPath,
  allowSignUp,
  startOnSignUp,
  closeHref,
  assetVersion,
});
---

<IosBottomSheet
  id="sign-in-sheet"
  title={startOnSignUp ? 'Sign up' : 'Sign in'}
  dismissible={dismissible}
  closeHref={closeHref}
  showClose={true}
  startOpen={sheetAutoOpen}
  class="sign-in-sheet"
>
  {/*
    Mount Clerk client-side only. Never SSR-mount <SignIn> on /admin when the
    browser already has a Clerk user but the server cookie is missing — Clerk
    would redirect to fallbackRedirectUrl (/admin/) forever.
  */}
  {
    clerkReady ? (
      <div id="sign-in-clerk-root"></div>
    ) : (
      <p id="sign-in-clerk-missing" class="sign-in-clerk-missing">
        Sign-in is not connected on this install yet.
      </p>
    )
  }
  <div id="sign-in-session-stuck" class="sign-in-session-stuck" hidden>
    <p id="sign-in-stuck-message">
      Your browser session cookie is out of sync with Clerk. Background updates are paused until
      you sync — tap below to restore API access without leaving this screen.
    </p>
    <button type="button" id="sign-in-stuck-sync" class="sign-in-stuck-btn">
      Sync session
    </button>
    <button type="button" id="sign-in-stuck-sign-out" class="sign-in-stuck-btn sign-in-stuck-btn--ghost">
      Sign out and try again
    </button>
  </div>
</IosBottomSheet>

<script is:inline src={`/ios-sheet.js?v=${__PUBLIC_ASSET_VERSION__}`} defer></script>

<style is:global>
  /* Match Clerk default theme to sheet light/dark (do not force theme: dark). */
  #sign-in-sheet {
    color-scheme: light dark;
  }

  #sign-in-sheet .ios-sheet-body {
    padding: 0.75rem 1.35rem 1.5rem;
  }

  #sign-in-sheet .sign-in-clerk-missing {
    margin: 0;
    color: inherit;
    font-size: 0.95rem;
    line-height: 1.45;
    opacity: 0.78;
  }

  #sign-in-sheet .cl-rootBox,
  #sign-in-sheet .cl-cardBox,
  #sign-in-sheet .cl-card {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    box-shadow: none;
    border: none;
    border-radius: 0;
    background: transparent;
  }

  #sign-in-sheet .cl-footer,
  #sign-in-sheet .cl-footerAction {
    background: transparent;
    box-shadow: none;
  }

  #sign-in-sheet.ios-sheet-keyboard .cl-rootBox,
  #sign-in-sheet.ios-sheet-keyboard .cl-cardBox,
  #sign-in-sheet.ios-sheet-keyboard .cl-card,
  #sign-in-sheet.ios-sheet-keyboard .cl-scrollBox {
    max-height: 100%;
  }

  .sign-in-session-stuck {
    display: grid;
    gap: 1rem;
    padding: 0.25rem 0 0.5rem;
    color: inherit;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .sign-in-session-stuck[hidden] {
    display: none;
  }

  .sign-in-stuck-btn {
    appearance: none;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 8%, transparent);
    color: inherit;
    font: inherit;
    font-weight: 600;
    padding: 0.7rem 1rem;
    cursor: pointer;
  }

  .sign-in-stuck-btn--ghost {
    background: transparent;
    font-weight: 500;
  }
</style>

{clerkReady ? (
  <>
    <script type="application/json" id="sign-in-sheet-config" set:html={signInSheetConfig} />
    <script type="module" src={`/admin/sign-in-sheet-boot.js?v=${assetVersion}`}></script>
  </>
) : null}
