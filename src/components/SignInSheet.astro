---
import { SignIn, SignUp } from '@clerk/astro/components';
import IosBottomSheet from './IosBottomSheet.astro';

interface Props {
  /** Where to send the user after a successful sign-in. */
  fallbackRedirectUrl?: string;
  allowSignUp?: boolean;
  /** Open automatically once the page loads (e.g. signed-out /admin visit). */
  autoOpen?: boolean;
  /** Current page path+query — Clerk hash routing keeps sign-in/sign-up in the sheet. */
  authPath?: string;
}

const {
  fallbackRedirectUrl = '/admin/',
  allowSignUp = import.meta.env.PUBLIC_CLERK_ALLOW_SIGN_UP === '1',
  autoOpen = false,
  authPath = '/sign-in',
} = Astro.props;

/** Clerk in the bottom sheet — no nested card chrome; body padding comes from ios-sheet. */
const clerkAppearance = {
  options: {
    elevation: 'flush',
  },
  elements: {
    rootBox: {
      width: '100%',
      maxWidth: '100%',
    },
    cardBox: {
      width: '100%',
      maxWidth: '100%',
      margin: '0',
      padding: '0',
      boxShadow: 'none',
    },
    card: {
      width: '100%',
      maxWidth: '100%',
      margin: '0',
      padding: '0',
      boxShadow: 'none',
      border: 'none',
      borderRadius: '0',
      background: 'transparent',
    },
    scrollBox: {
      width: '100%',
      maxWidth: '100%',
    },
    main: {
      padding: '0',
    },
    footer: {
      padding: '0',
      background: 'transparent',
      boxShadow: 'none',
    },
    footerAction: {
      background: 'transparent',
    },
    header: { display: 'none' },
    headerTitle: { display: 'none' },
    headerSubtitle: { display: 'none' },
  },
};
---

<IosBottomSheet id="sign-in-sheet" title={allowSignUp ? 'Account' : 'Sign in'} dismissible={true} class="sign-in-sheet">
  <SignIn
    routing="hash"
    signUpUrl={authPath}
    signInUrl={authPath}
    fallbackRedirectUrl={fallbackRedirectUrl}
    appearance={clerkAppearance}
  />
  {allowSignUp && (
    <SignUp
      routing="hash"
      signUpUrl={authPath}
      signInUrl={authPath}
      fallbackRedirectUrl={fallbackRedirectUrl}
      appearance={clerkAppearance}
    />
  )}
  <div class="sign-in-reset" data-signin-reset hidden>
    <p>This device still holds an old session, so the sign-in form can’t load.</p>
    <button type="button">Reset sign-in</button>
  </div>
</IosBottomSheet>

<script src="/ios-sheet.js" defer></script>

<style is:global>
  /* Match Clerk default theme to sheet light/dark (do not force theme: dark). */
  #sign-in-sheet {
    color-scheme: light dark;
  }

  #sign-in-sheet .ios-sheet-body {
    padding: 0.75rem 1.35rem 1.5rem;
  }

  #sign-in-sheet .cl-rootBox,
  #sign-in-sheet .cl-cardBox,
  #sign-in-sheet .cl-card,
  #sign-in-sheet .cl-scrollBox,
  #sign-in-sheet .cl-main {
    width: 100%;
    max-width: 100%;
  }

  #sign-in-sheet .cl-cardBox,
  #sign-in-sheet .cl-card {
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
  }

  #sign-in-sheet .cl-footer,
  #sign-in-sheet .cl-footerAction {
    background: transparent;
    box-shadow: none;
  }

  #sign-in-sheet .sign-in-reset {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    padding: 0.5rem 0 0.25rem;
    text-align: center;
  }

  #sign-in-sheet .sign-in-reset[hidden] {
    display: none;
  }

  #sign-in-sheet .sign-in-reset p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    opacity: 0.75;
  }

  #sign-in-sheet .sign-in-reset button {
    width: 100%;
    padding: 0.7rem 1rem;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
</style>

<script type="module" define:vars={{ autoOpenSignIn: autoOpen }}>
  import { bindClerkSsrSessionSync, bindStuckSignInRecovery } from '/admin/shared.js?v=20260806m';
  bindClerkSsrSessionSync({ autoOpenSignIn });
  bindStuckSignInRecovery();
</script>
