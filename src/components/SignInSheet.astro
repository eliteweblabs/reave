---
import { SignIn, SignUp } from '@clerk/astro/components';
import IosBottomSheet from './IosBottomSheet.astro';

interface Props {
  /** Where to send the user after a successful sign-in. */
  fallbackRedirectUrl?: string;
  allowSignUp?: boolean;
  /** Open automatically once the page loads (e.g. signed-out /admin visit). */
  autoOpen?: boolean;
  /** Current page path+query — Clerk hash routing keeps sign-in/sign-up in the sheet. */
  authPath?: string;
}

const {
  fallbackRedirectUrl = '/admin/',
  allowSignUp = import.meta.env.PUBLIC_CLERK_ALLOW_SIGN_UP === '1',
  autoOpen = false,
  authPath = '/sign-in',
} = Astro.props;

/** Clerk in the bottom sheet — no nested card chrome; body padding comes from ios-sheet. */
const clerkAppearance = {
  options: {
    elevation: 'flush',
  },
  elements: {
    rootBox: {
      width: '100%',
      maxWidth: '100%',
    },
    cardBox: {
      width: '100%',
      maxWidth: '100%',
      margin: '0',
      padding: '0',
      boxShadow: 'none',
    },
    card: {
      width: '100%',
      maxWidth: '100%',
      margin: '0',
      padding: '0',
      boxShadow: 'none',
      border: 'none',
      borderRadius: '0',
      background: 'transparent',
    },
    scrollBox: {
      width: '100%',
      maxWidth: '100%',
    },
    main: {
      padding: '0',
    },
    footer: {
      padding: '0',
      background: 'transparent',
      boxShadow: 'none',
    },
    footerAction: {
      background: 'transparent',
    },
    header: { display: 'none' },
    headerTitle: { display: 'none' },
    headerSubtitle: { display: 'none' },
  },
};
---

<IosBottomSheet id="sign-in-sheet" title={allowSignUp ? 'Account' : 'Sign in'} dismissible={true} class="sign-in-sheet">
  <SignIn
    routing="hash"
    signUpUrl={authPath}
    signInUrl={authPath}
    fallbackRedirectUrl={fallbackRedirectUrl}
    forceRedirectUrl={fallbackRedirectUrl}
    appearance={clerkAppearance}
  />
  {allowSignUp && (
    <SignUp
      routing="hash"
      signUpUrl={authPath}
      signInUrl={authPath}
      fallbackRedirectUrl={fallbackRedirectUrl}
      forceRedirectUrl={fallbackRedirectUrl}
      appearance={clerkAppearance}
    />
  )}
</IosBottomSheet>

<script is:inline>
  /**
   * Today's Clerk instance churn left multiple __client_uat_* cookies on
   * reave.app. That blocks the handshake that sets __session, so OTP can
   * "succeed" in the UI while the server still sees you as signed out (401s
   * + refresh loop). Clear orphaned Clerk cookies once when signed out.
   */
  (function () {
    if (document.body?.dataset?.userId?.trim()) return;
    var names = document.cookie.split(';').map(function (p) {
      return p.trim().split('=')[0];
    });
    var clerkNames = names.filter(function (n) {
      return (
        n === '__session' ||
        n === '__client_uat' ||
        n.indexOf('__client_uat_') === 0 ||
        n.indexOf('__clerk_') === 0
      );
    });
    if (clerkNames.length <= 1) return;
    try {
      sessionStorage.removeItem('reave-clerk-ssr-sync');
    } catch (e) {
      /* ignore */
    }
    var domains = [undefined, 'reave.app', '.reave.app', window.location.hostname];
    clerkNames.forEach(function (name) {
      domains.forEach(function (domain) {
        var base = name + '=; Max-Age=0; Path=/';
        document.cookie = domain ? base + '; Domain=' + domain : base;
      });
    });
  })();
</script>

<script src="/ios-sheet.js" defer></script>

<style is:global>
  /* Match Clerk default theme to sheet light/dark (do not force theme: dark). */
  #sign-in-sheet {
    color-scheme: light dark;
  }

  #sign-in-sheet .ios-sheet-body {
    padding: 0.75rem 1.35rem 1.5rem;
  }

  #sign-in-sheet .cl-rootBox,
  #sign-in-sheet .cl-cardBox,
  #sign-in-sheet .cl-card,
  #sign-in-sheet .cl-scrollBox,
  #sign-in-sheet .cl-main {
    width: 100%;
    max-width: 100%;
  }

  #sign-in-sheet .cl-cardBox,
  #sign-in-sheet .cl-card {
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
  }

  #sign-in-sheet .cl-footer,
  #sign-in-sheet .cl-footerAction {
    background: transparent;
    box-shadow: none;
  }
</style>

<script type="module" define:vars={{ autoOpenSignIn: autoOpen }}>
  import { bindClerkSsrSessionSync } from '/admin/shared.js?v=20260806handshake';
  bindClerkSsrSessionSync({ autoOpenSignIn });
</script>
