---
import { SignIn, SignUp } from '@clerk/astro/components';
import IosBottomSheet from './IosBottomSheet.astro';
import { isDemoMode } from '../lib/demoMode';
import { serverEnv } from '../lib/serverEnv';

interface Props {
  /** Where to send the user after a successful sign-in. */
  fallbackRedirectUrl?: string;
  allowSignUp?: boolean;
  /** Open automatically once the page loads (e.g. signed-out /admin visit). */
  autoOpen?: boolean;
  /** Current page path+query — Clerk hash routing keeps sign-in/sign-up in the sheet. */
  authPath?: string;
}

const {
  fallbackRedirectUrl = '/admin/',
  allowSignUp = import.meta.env.PUBLIC_CLERK_ALLOW_SIGN_UP === '1',
  autoOpen = false,
  authPath = '/sign-in',
} = Astro.props;

const demoPrimarySignIn = isDemoMode();
const primarySignInBase =
  serverEnv('PRIMARY_SIGN_IN_URL')?.trim() || 'https://reave.app/sign-in';
const primarySignInHref = (() => {
  const url = new URL(primarySignInBase);
  url.searchParams.set('returnTo', fallbackRedirectUrl);
  return url.toString();
})();

/** Clerk in the bottom sheet — no nested card chrome; body padding comes from ios-sheet. */
const clerkAppearance = {
  options: {
    elevation: 'flush',
  },
  elements: {
    rootBox: {
      width: '100%',
      maxWidth: '100%',
    },
    cardBox: {
      width: '100%',
      maxWidth: '100%',
      margin: '0',
      padding: '0',
      boxShadow: 'none',
    },
    card: {
      width: '100%',
      maxWidth: '100%',
      margin: '0',
      padding: '0',
      boxShadow: 'none',
      border: 'none',
      borderRadius: '0',
      background: 'transparent',
    },
    scrollBox: {
      width: '100%',
      maxWidth: '100%',
    },
    main: {
      padding: '0',
    },
    footer: {
      padding: '0',
      background: 'transparent',
      boxShadow: 'none',
    },
    footerAction: {
      background: 'transparent',
    },
    header: { display: 'none' },
    headerTitle: { display: 'none' },
    headerSubtitle: { display: 'none' },
  },
};
---

<IosBottomSheet id="sign-in-sheet" title={allowSignUp ? 'Account' : 'Sign in'} dismissible={true} class="sign-in-sheet">
  {demoPrimarySignIn ? (
    <div class="demo-sign-in-panel">
      <p class="demo-sign-in-lead">
        This demo uses the same sign-in as <strong>reave.app</strong>. Continue there to authenticate with Google, then you&apos;ll return here automatically.
      </p>
      <a class="demo-sign-in-btn" href={primarySignInHref}>
        Continue to sign in
      </a>
      <p class="demo-sign-in-note">Password sign-in is not enabled on this Clerk instance — use Google.</p>
    </div>
  ) : (
    <>
      <SignIn
        routing="hash"
        signUpUrl={authPath}
        signInUrl={authPath}
        fallbackRedirectUrl={fallbackRedirectUrl}
        appearance={clerkAppearance}
      />
      {allowSignUp && (
        <SignUp
          routing="hash"
          signUpUrl={authPath}
          signInUrl={authPath}
          fallbackRedirectUrl={fallbackRedirectUrl}
          appearance={clerkAppearance}
        />
      )}
    </>
  )}
</IosBottomSheet>

<script src="/ios-sheet.js" defer></script>

<style is:global>
  /* Match Clerk default theme to sheet light/dark (do not force theme: dark). */
  #sign-in-sheet {
    color-scheme: light dark;
  }

  #sign-in-sheet .ios-sheet-body {
    padding: 0.75rem 1.35rem 1.5rem;
  }

  #sign-in-sheet .cl-rootBox,
  #sign-in-sheet .cl-cardBox,
  #sign-in-sheet .cl-card,
  #sign-in-sheet .cl-scrollBox,
  #sign-in-sheet .cl-main {
    width: 100%;
    max-width: 100%;
  }

  #sign-in-sheet .cl-cardBox,
  #sign-in-sheet .cl-card {
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
  }

  #sign-in-sheet .cl-footer,
  #sign-in-sheet .cl-footerAction {
    background: transparent;
    box-shadow: none;
  }

  #sign-in-sheet .demo-sign-in-panel {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0.25rem 0 0.5rem;
  }

  #sign-in-sheet .demo-sign-in-lead {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--text-secondary, #64748b);
  }

  #sign-in-sheet .demo-sign-in-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    background: var(--brand-indigo, #6366f1);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  #sign-in-sheet .demo-sign-in-note {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--text-secondary, #64748b);
  }
</style>

<script type="module" define:vars={{ autoOpenSignIn: autoOpen }}>
  import { bindClerkSsrSessionSync } from '/admin/shared.js?v=20260806k';
  bindClerkSsrSessionSync({ autoOpenSignIn });
</script>
