---
import { SignIn, SignUp } from '@clerk/astro/components';
import IosBottomSheet from './IosBottomSheet.astro';

interface Props {
  /** Where to send the user after a successful sign-in. */
  fallbackRedirectUrl?: string;
  allowSignUp?: boolean;
  /** Open automatically once the page loads (e.g. signed-out /admin visit). */
  autoOpen?: boolean;
  /** Current page path+query — Clerk hash routing keeps sign-in/sign-up in the sheet. */
  authPath?: string;
}

const {
  fallbackRedirectUrl = '/admin/',
  allowSignUp = import.meta.env.PUBLIC_CLERK_ALLOW_SIGN_UP === '1',
  autoOpen = false,
  authPath = '/sign-in',
} = Astro.props;

/** Clerk in the bottom sheet — no nested card chrome; body padding comes from ios-sheet. */
const clerkAppearance = {
  options: {
    elevation: 'flush',
  },
  elements: {
    rootBox: {
      width: '100%',
      maxWidth: '100%',
    },
    cardBox: {
      width: '100%',
      maxWidth: '100%',
      margin: '0',
      padding: '0',
      boxShadow: 'none',
    },
    card: {
      width: '100%',
      maxWidth: '100%',
      margin: '0',
      padding: '0',
      boxShadow: 'none',
      border: 'none',
      borderRadius: '0',
      background: 'transparent',
    },
    scrollBox: {
      width: '100%',
      maxWidth: '100%',
    },
    main: {
      padding: '0',
    },
    footer: {
      padding: '0',
      background: 'transparent',
      boxShadow: 'none',
    },
    footerAction: {
      background: 'transparent',
    },
    header: { display: 'none' },
    headerTitle: { display: 'none' },
    headerSubtitle: { display: 'none' },
  },
};
---

<script is:inline>
  /**
   * Clerk hash routing writes the current step into the URL (`#/factor-one`).
   * That hash outlives the sign-in attempt, so reloading — or opening a shared or
   * bookmarked mid-flow URL — restores a step the card has no data to render and
   * the sheet comes up empty with no way back to the identifier form.
   *
   * Clerk re-navigates to the right step from a live attempt, so dropping the
   * hash costs nothing when the attempt is still there. Steps that Clerk *lands*
   * on from outside the page (`/sso-callback` after OAuth, `/continue` and the
   * `/verify-*` sign-up steps) must survive, so match the stale steps by name.
   */
  (function () {
    var STALE_STEPS = [
      '#/factor-one',
      '#/factor-two',
      '#/reset-password',
      '#/reset-password-success',
      '#/forgot-password',
      '#/alternative-methods',
      '#/choose-strategy',
    ];
    if (STALE_STEPS.indexOf(window.location.hash) === -1) return;
    try {
      history.replaceState(null, '', window.location.pathname + window.location.search);
    } catch {
      window.location.hash = '';
    }
  })();
</script>

<IosBottomSheet id="sign-in-sheet" title={allowSignUp ? 'Account' : 'Sign in'} dismissible={true} class="sign-in-sheet">
  <SignIn
    routing="hash"
    signUpUrl={authPath}
    signInUrl={authPath}
    fallbackRedirectUrl={fallbackRedirectUrl}
    appearance={clerkAppearance}
  />
  {allowSignUp && (
    <SignUp
      routing="hash"
      signUpUrl={authPath}
      signInUrl={authPath}
      fallbackRedirectUrl={fallbackRedirectUrl}
      appearance={clerkAppearance}
    />
  )}
</IosBottomSheet>

<script src="/ios-sheet.js" defer></script>

<style is:global>
  /* Match Clerk default theme to sheet light/dark (do not force theme: dark). */
  #sign-in-sheet {
    color-scheme: light dark;
  }

  #sign-in-sheet .ios-sheet-body {
    padding: 0.75rem 1.35rem 1.5rem;
  }

  #sign-in-sheet .cl-rootBox,
  #sign-in-sheet .cl-cardBox,
  #sign-in-sheet .cl-card,
  #sign-in-sheet .cl-scrollBox,
  #sign-in-sheet .cl-main {
    width: 100%;
    max-width: 100%;
  }

  #sign-in-sheet .cl-cardBox,
  #sign-in-sheet .cl-card {
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
  }

  #sign-in-sheet .cl-footer,
  #sign-in-sheet .cl-footerAction {
    background: transparent;
    box-shadow: none;
  }
</style>

<script type="module" define:vars={{ autoOpenSignIn: autoOpen }}>
  import { bindClerkSsrSessionSync } from '/admin/shared.js?v=20260806i';
  bindClerkSsrSessionSync({ autoOpenSignIn });
</script>
