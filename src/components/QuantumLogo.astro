---
export interface Props {
  /**
   * Optional brand mask URL (kept on `data-hero-mask` for scrape tooling).
   * WebGL uses `logoSrc` only.
   */
  heroMask?: string;
  /** Full-color logo PNG the animation resolves into (default /branding/logo.png). */
  logoSrc: string;
  /** Canvas host element id. */
  hostId?: string;
  /** Particles rush inward from outside the mask on load. */
  introRush?: boolean;
  /** Rush duration in seconds (default 2). */
  introDuration?: number;
  class?: string;
}

const {
  heroMask,
  logoSrc,
  hostId = "quantumCanvasHost",
  introRush = true,
  introDuration = 4,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "quantum-logo-stack",
    "quantum-logo-stack--centered",
    introRush && "quantum-logo-stack--galaxy",
    !introRush && "quantum-logo-stack--logo",
    className,
  ]}
  data-quantum-logo
  data-host-id={hostId}
  data-logo-src={logoSrc}
  data-hero-mask={heroMask}
  data-intro-rush={introRush ? "true" : "false"}
  data-intro-duration={String(introDuration)}
  aria-hidden="true"
>
  <div id={hostId} class="quantum-host"></div>
</div>

<style>
  .quantum-logo-stack {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    z-index: 0;
    pointer-events: auto;
    cursor: default;
    touch-action: pan-y;
    overflow: hidden;
  }

  .quantum-logo-stack--centered {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Full-viewport galaxy during the collapse — no logo mask on the canvas yet. */
  .quantum-logo-stack--galaxy {
    mask-image: none;
    -webkit-mask-image: none;
    filter: none;
  }

  /* After intro: WebGL resolve plane defines the logo shape (no CSS mask). */
  .quantum-logo-stack--logo {
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.2))
      drop-shadow(0 0 16px rgba(200, 80, 180, 0.14));
  }

  .quantum-host {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    pointer-events: auto;
    touch-action: none;
    overflow: hidden;
  }

  .quantum-host :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
    max-width: none;
    min-height: 100%;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
</style>

<script>
  import { attachQuantumCoreOpticalEngine } from "../lib/quantumCoreOpticalEngine";

  function prefersReducedMotion() {
    return (
      typeof matchMedia !== "undefined" &&
      matchMedia("(prefers-reduced-motion: reduce)").matches
    );
  }

  function initStack(stack: HTMLElement): () => void {
    const hostId = stack.dataset.hostId || "quantumCanvasHost";
    const host = document.getElementById(hostId);
    if (!host) return () => {};

    const logoSrc = stack.dataset.logoSrc || "/branding/logo.png";
    const introRush = stack.dataset.introRush === "true";
    const introDuration = Number(stack.dataset.introDuration) || 4;

    let detach: (() => void) | undefined;
    let delayId = 0;
    let cancelled = false;
    let started = false;

    const start = () => {
      if (cancelled || started) return;
      started = true;
      detach = attachQuantumCoreOpticalEngine(host, {
        introRush: introRush ? { durationSec: introDuration } : undefined,
        logoImageUrl: logoSrc,
      });
    };

    const delayMs = prefersReducedMotion() ? 0 : 0;
    delayId = window.setTimeout(start, delayMs);

    const parent = stack.parentElement;
    let obs: MutationObserver | undefined;
    if (parent) {
      obs = new MutationObserver(() => {
        if (!document.getElementById(hostId)) {
          window.clearTimeout(delayId);
          detach?.();
          detach = undefined;
          obs?.disconnect();
        }
      });
      obs.observe(parent, { childList: true, subtree: true });
    }

    return () => {
      cancelled = true;
      window.clearTimeout(delayId);
      detach?.();
      obs?.disconnect();
    };
  }

  const cleanups = new Map<HTMLElement, () => void>();

  function boot() {
    document
      .querySelectorAll<HTMLElement>("[data-quantum-logo]")
      .forEach((stack) => {
        cleanups.get(stack)?.();
        cleanups.set(stack, initStack(stack));
      });
  }

  function bootWhenReady() {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot, { once: true });
    } else {
      boot();
    }
  }

  bootWhenReady();

  window.addEventListener("pagehide", () => {
    cleanups.forEach((cleanup) => cleanup());
    cleanups.clear();
  });
</script>
