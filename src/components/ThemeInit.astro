---
/**
 * Blocking theme paint — default light so the public canvas is never stuck black.
 * Stored choice wins; otherwise light.
 */
---
<script is:inline>
  (function () {
    var theme = "light";
    try {
      var stored = localStorage.getItem("reave-theme");
      theme = stored === "dark" || stored === "light" ? stored : "light";
      document.documentElement.setAttribute("data-theme", theme);
      document.documentElement.style.colorScheme = theme;
    } catch (e) {
      document.documentElement.setAttribute("data-theme", "light");
      document.documentElement.style.colorScheme = "light";
    }
    var meta = document.querySelector('meta[name="theme-color"]:not([media])');
    if (meta) meta.setAttribute("content", theme === "dark" ? "#111111" : "#ffffff");
  })();
</script>
