---
/**
 * Grand opening hero — fanned playing-card stack. Swipe (or dots) brings one card flat into focus.
 */
import { grandOpeningCardWebpSrc } from "../../lib/grandOpeningHeroImages";

type FanCard = {
  image: string;
  alt: string;
};

const HERO_CARDS: FanCard[] = [
  {
    image: "/grand-opening/paradigm-landscape-mobile.jpg",
    alt: "Paradigm Landscape mobile website",
  },
  {
    image: "/grand-opening/bust-dusters-mobile.jpg",
    alt: "Bust Dusters Cleaning Co. mobile website",
  },
  {
    image: "/grand-opening/levines-law-mobile.png",
    alt: "LevinesLaw.com mobile website",
  },
  {
    image: "/grand-opening/luxe-meds-mobile.png",
    alt: "LUXEMEDS mobile website",
  },
  {
    image: "/grand-opening/mdot-world-mobile.png",
    alt: "MDOT.world mobile website",
  },
  {
    image: "/grand-opening/northshore-mortgage-mobile.jpg",
    alt: "Northshore Mortgage.pro mobile website",
  },
  {
    image: "/grand-opening/pdx-paws-mobile.jpg",
    alt: "PDX Paws mobile website",
  },
  {
    image: "/grand-opening/pat-the-plumber-mobile.jpg",
    alt: "Pat the Plumber mobile website",
  },
];

const cards = HERO_CARDS.map((card, index) => ({
  ...card,
  webp: grandOpeningCardWebpSrc(card.image),
  index,
}));

const fanCount = cards.length || 1;
const initialActive = 0;

/** Stack order: active card on top (highest --card-i). */
function stackCardIndex(originalIndex: number, activeIndex: number, n: number): number {
  const relative = (originalIndex - activeIndex + n) % n;
  return n - 1 - relative;
}

/** Signed offset from the focused card (-3 … +3) for fan spread. */
function cardSpreadOffset(originalIndex: number, activeIndex: number, n: number): number {
  let relative = (originalIndex - activeIndex + n) % n;
  if (relative > n / 2) relative -= n;
  return relative;
}
---

<div
  class="go-card-fan"
  data-card-count={fanCount}
  role="region"
  aria-roledescription="carousel"
  aria-label="Example websites"
>
  <div class="go-card-fan__stage">
    <div class="go-card-fan__stack" tabindex="0">
      {
        cards.map((card) => (
          <figure
            class:list={[
              "go-card-fan__card",
              card.index === initialActive && "is-front",
            ]}
            data-card-index={card.index}
            data-alt={card.alt}
            style={`--card-i: ${stackCardIndex(card.index, initialActive, fanCount)}; --card-n: ${fanCount}; --card-offset: ${cardSpreadOffset(card.index, initialActive, fanCount)};`}
          >
            <picture>
              <source srcset={card.webp} type="image/webp" />
              <img
                src={card.image}
                alt={card.index === initialActive ? card.alt : ""}
                aria-hidden={card.index !== initialActive ? "true" : undefined}
                width="504"
                height="1092"
                loading={card.index === initialActive ? "eager" : "lazy"}
                fetchpriority={card.index === initialActive ? "high" : undefined}
                decoding={card.index === initialActive ? "sync" : "async"}
              />
            </picture>
          </figure>
        ))
      }
    </div>
  </div>

  <div class="go-card-fan__dots" role="tablist" aria-label="Choose a website preview">
    {
      cards.map((card) => (
        <button
          type="button"
          class="go-card-fan__dot"
          role="tab"
          aria-label={`Show ${card.alt}`}
          aria-selected={card.index === initialActive ? "true" : "false"}
          data-slide-to={card.index}
        />
      ))
    }
  </div>

  <p class="go-card-fan__hint">Swipe to browse</p>
</div>

<script is:inline defer src={`/grand-opening-card-fan.js?v=${__PUBLIC_ASSET_VERSION__}`}></script>

<style>
  .go-card-fan {
    position: relative;
    width: 100%;
    max-width: min(100%, 280px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .go-card-fan__stage {
    width: 100%;
    max-width: 100%;
    overflow: visible;
    padding: 8px 12px 20px;
  }

  .go-card-fan__stack {
    position: relative;
    width: min(100%, 252px);
    aspect-ratio: 459 / 994;
    margin-inline: auto;
    touch-action: pan-y pinch-zoom;
    outline: none;
  }

  .go-card-fan__card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    margin: 0;
    overflow: visible;
    background: transparent;
    filter: drop-shadow(0 18px 14px rgba(0, 0, 0, 0.14));
    transform-origin: 50% 100%;
    transform: rotate(calc(var(--card-offset, 0) * 5deg))
      translateY(calc(var(--card-i, 0) * -5px))
      scale(calc(1 - max(var(--card-offset, 0), calc(-1 * var(--card-offset, 0))) * 0.028));
    transition:
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.28s ease,
      z-index 0s linear 0.16s;
    z-index: calc(var(--card-i, 0) + 1);
  }

  .go-card-fan__card.is-front {
    transform: rotate(0deg) translateY(0) scale(1);
    z-index: 40;
    filter: drop-shadow(0 28px 22px rgba(0, 0, 0, 0.22));
    transition:
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      z-index 0s,
      filter 0.28s ease;
  }

  .go-card-fan__card::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -10px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.35) 0%, transparent 72%);
    filter: blur(6px);
    transform: scaleY(0.35);
    opacity: 0.55;
    pointer-events: none;
    z-index: -1;
  }

  .go-card-fan__card.is-front::after {
    opacity: 0.85;
    bottom: -12px;
    height: 20px;
  }

  .go-card-fan__card picture,
  .go-card-fan__card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.06),
      0 1px 2px rgba(255, 255, 255, 0.65) inset,
      0 16px 28px -6px rgba(0, 0, 0, 0.28),
      0 32px 48px -16px rgba(0, 0, 0, 0.2);
    transition: box-shadow 0.35s ease;
  }

  .go-card-fan__card.is-front img {
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.08),
      0 1px 2px rgba(255, 255, 255, 0.7) inset,
      0 22px 36px -4px rgba(0, 0, 0, 0.32),
      0 40px 56px -12px rgba(0, 0, 0, 0.22);
  }

  .go-card-fan__dots {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
    padding: 0 12px;
  }

  .go-card-fan__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--site-fg-faint, #d4d4d4);
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .go-card-fan__dot.is-active,
  .go-card-fan__dot[aria-selected="true"] {
    background: var(--site-fg, #171717);
    transform: scale(1.15);
  }

  .go-card-fan__hint {
    display: block;
    margin: 10px 0 0;
    font-family: var(--font-content);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    text-align: center;
    color: var(--site-fg-faint, #a3a3a3);
  }

  @media (min-width: 860px) {
    .go-card-fan {
      max-width: min(100%, 280px);
      transform: translateY(clamp(-5rem, -14vh, -2rem));
    }

    .go-card-fan__stage {
      padding: 0 18px 28px;
    }

    .go-card-fan__stack {
      width: min(100%, 252px);
    }

    .go-card-fan__card {
      transform-origin: 50% 115%;
      transform: rotate(calc((var(--card-i) - (var(--card-n) - 1) / 2) * 5deg))
        translateY(calc(var(--card-i) * -4px))
        scale(calc(1 - (var(--card-n) - 1 - var(--card-i)) * 0.018));
    }

    .go-card-fan__card.is-front {
      transform: rotate(calc((var(--card-i) - (var(--card-n) - 1) / 2) * 5deg))
        translateY(calc(var(--card-i) * -4px))
        scale(calc(1 - (var(--card-n) - 1 - var(--card-i)) * 0.018));
      z-index: calc(var(--card-i) + 1);
    }

    .go-card-fan__dots,
    .go-card-fan__hint {
      display: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .go-card-fan__stack:hover .go-card-fan__card {
      transform: rotate(calc((var(--card-i) - (var(--card-n) - 1) / 2) * 8deg))
        translateY(calc(var(--card-i) * -10px - 6px))
        scale(calc(1 - (var(--card-n) - 1 - var(--card-i)) * 0.012));
    }

    .go-card-fan__stack:hover .go-card-fan__card:hover {
      z-index: 50;
    }

    .go-card-fan__stack:hover .go-card-fan__card:hover {
      filter: drop-shadow(0 32px 26px rgba(0, 0, 0, 0.24));
    }

    .go-card-fan__stack:hover .go-card-fan__card:hover img {
      box-shadow:
        0 0 0 1px rgba(0, 0, 0, 0.08),
        0 1px 2px rgba(255, 255, 255, 0.7) inset,
        0 22px 36px -4px rgba(0, 0, 0, 0.32),
        0 40px 56px -12px rgba(0, 0, 0, 0.24);
    }

    .go-card-fan__stack:hover .go-card-fan__card:hover::after {
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .go-card-fan__card {
      transition: none;
    }
  }

  @media (max-width: 859px) {
    .go-card-fan {
      max-width: none;
      width: 100%;
      margin-top: 8px;
      transform: none;
    }

    .go-card-fan__stack {
      width: min(78vw, 252px);
    }
  }
</style>
