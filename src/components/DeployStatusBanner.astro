---
/**
 * Sticky banner when enabled modules are not fully deployed, or when a demo suite is pending seed.
 * Admin-only — do not mount from public Layout (homepage / marketing).
 */
import { getDeployStatusClientSummary } from "../lib/deployModuleStatus";
import { demoSuiteSummary, parseDemoSuiteCookie, DEMO_SUITE_COOKIE } from "../lib/demoSuite";
import { isDemoMode } from "../lib/demoMode";

const deployStatus = getDeployStatusClientSummary();
const cookieRaw = Astro.cookies.get(DEMO_SUITE_COOKIE)?.value;
const demoSuite = parseDemoSuiteCookie(cookieRaw);
const showDemoSuite = isDemoMode() && demoSuite && Astro.url.searchParams.has("demoSuite");

type BannerModule = { id: string; label: string; status: string };

const modules: BannerModule[] = deployStatus.modules.map((m) => ({
  id: m.id,
  label: m.label,
  status: m.status,
}));

/** Human-readable status for lead copy and pills. */
const STATUS_LABEL: Record<string, string> = {
  development: "in development",
  request: "requested",
  rejected: "rejected",
  deployed: "deployed",
};

const hasDeployBanner = deployStatus.hasBanner;
const hasBanner = hasDeployBanner || showDemoSuite;
---

{
  hasBanner && (
    <div
      id="deploy-status-banner"
      role="alert"
      class="deploy-status-banner"
      data-demo-suite={showDemoSuite ? "1" : undefined}
    >
      {showDemoSuite && demoSuite && (
        <p class="deploy-status-banner__lead">
          <strong>
            {demoSuite.visitorName
              ? `Demo ready for ${demoSuite.visitorName}`
              : 'Demo suite ready'}
          </strong>{' '}
          — {demoSuiteSummary(demoSuite)}.
          Open <strong>Admin → Chats</strong> and ask to <em>run demo seed</em>, or use the <a href="/demo-loader">demo loader</a>.
        </p>
      )}
      {hasDeployBanner && (
        <p class="deploy-status-banner__lead">
          <strong>Deployment in progress</strong> —{" "}
          {modules.length === 1
            ? `${modules[0]!.label} is ${STATUS_LABEL[modules[0]!.status] ?? modules[0]!.status}.`
            : `${modules.length} modules need setup.`}
        </p>
      )}
      {hasDeployBanner && (
        <ul class="deploy-status-banner__list">
          {modules.map((m) => (
            <li>
              <span
                class={`deploy-status-banner__pill deploy-status-banner__pill--${m.status}`}
              >
                {m.label} · {STATUS_LABEL[m.status] ?? m.status}
              </span>
            </li>
          ))}
        </ul>
      )}
      <button type="button" class="deploy-status-banner__dismiss" data-deploy-dismiss aria-label="Dismiss">
        ×
      </button>
    </div>
  )
}

<script is:inline>
  (function () {
    var banner = document.getElementById('deploy-status-banner');
    if (!banner) return;
    var key = 'reave_deploy_banner_dismiss';
    if (sessionStorage.getItem(key) === '1') {
      banner.remove();
      return;
    }
    var btn = banner.querySelector('[data-deploy-dismiss]');
    if (btn) {
      btn.addEventListener('click', function () {
        sessionStorage.setItem(key, '1');
        banner.remove();
      });
    }
  })();
</script>

<style is:global>
  .deploy-status-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 99990;
    padding: 0.65rem 2.5rem 0.65rem 1rem;
    font: 500 0.82rem/1.45 var(--font-primary, "Space Grotesk", system-ui, sans-serif);
    color: #fdf4ff;
    background:
      linear-gradient(
        105deg,
        rgba(99, 102, 241, 0.92) 0%,
        rgba(192, 38, 211, 0.94) 48%,
        rgba(244, 114, 182, 0.9) 100%
      );
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow:
      0 8px 28px rgba(192, 38, 211, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.12) inset;
    backdrop-filter: blur(16px) saturate(1.35);
    -webkit-backdrop-filter: blur(16px) saturate(1.35);
  }

  .deploy-status-banner__lead {
    margin: 0 0 0.35rem;
  }

  .deploy-status-banner__lead a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .deploy-status-banner__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .deploy-status-banner__pill {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #4a044e;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 1px 8px rgba(99, 102, 241, 0.2);
  }

  .deploy-status-banner__pill--request {
    color: #312e81;
    background: rgba(224, 231, 255, 0.95);
  }

  .deploy-status-banner__dismiss {
    position: absolute;
    top: 0.4rem;
    right: 0.5rem;
    border: none;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.15rem 0.4rem;
    border-radius: 0.4rem;
  }

  .deploy-status-banner__dismiss:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  body:has(.deploy-status-banner) .app-header {
    margin-top: 3.25rem;
  }
</style>
