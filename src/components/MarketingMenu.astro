---
/**
 * Vercel-style marketing navigation — Sign in on desktop, hamburger drawer on small screens.
 */
import { ArrowRight, LayoutDashboard } from "lucide-astro";
import OverlayMenu from "./OverlayMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";
import {
  marketingNavActivePath,
  siteDemoCta,
  siteNavGroupsForUser,
  siteNavLinksForUser,
  siteShowDemoCta,
} from "../lib/marketingNav";
import { getSiteContent, type SiteContentConfig } from "../lib/siteContent";

interface Props {
  pathname: string;
  signedIn: boolean;
  /** When the signed-in avatar menu lives in the header end cluster (homepage). */
  hideAccountNav?: boolean;
  /** Signed-in admin pill — lives in primary nav / hamburger, not the header cluster. */
  showAdminEntry?: boolean;
  siteContent?: SiteContentConfig;
}

const {
  pathname,
  signedIn,
  hideAccountNav = false,
  showAdminEntry = false,
  siteContent: siteContentProp,
} = Astro.props;
const showAccountNav = signedIn && !hideAccountNav;

const siteContent = siteContentProp ?? getSiteContent();
const navLinks = siteNavLinksForUser(signedIn, siteContent);
const navGroups = siteNavGroupsForUser(signedIn, siteContent);
const demoCta = siteDemoCta(siteContent);
const showDemoCta = siteShowDemoCta(signedIn, siteContent, pathname);
const showSignIn = siteContent.nav.showSignIn !== false;
const showOverlayFooter =
  (!signedIn && showDemoCta && Boolean(demoCta)) || (signedIn && showAccountNav);
---

<div class="marketing-nav" data-marketing-nav>
  <nav class="marketing-nav-desktop" aria-label="Website">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "marketing-nav-link",
            marketingNavActivePath(pathname, link.href) && "is-active",
          ]}
          data-hide-below={link.hideBelow ?? undefined}
        >
          {link.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>

  {
    (showDemoCta && demoCta) || (!signedIn && showSignIn) || showAccountNav || showAdminEntry ? (
      <div class="marketing-nav-actions">
        {
          showAdminEntry && (
            <a
              href="/admin/"
              class="brand-btn marketing-nav-admin app-header-admin-entry"
              aria-label="Admin"
            >
              admin
              <ArrowRight size={14} strokeWidth={2.25} aria-hidden="true" />
            </a>
          )
        }
        {
          showDemoCta && demoCta && (
            <a class="marketing-nav-cta" href={demoCta.href}>
              Demo now
              <ArrowRight size={15} strokeWidth={2} aria-hidden="true" />
            </a>
          )
        }
        {
          !signedIn && showSignIn ? (
            <button
              type="button"
              class="marketing-nav-signin"
              data-ios-sheet-open="sign-in-sheet"
            >
              Sign in
            </button>
          ) : showAccountNav ? (
            <nav class="marketing-nav-inline marketing-nav-inline--signed-in" aria-label="Account">
              <a href="/admin/?tab=dashboard" class="marketing-nav-link">
                Administration
              </a>
              <button
                type="button"
                class="marketing-nav-link marketing-nav-link--button"
                data-marketing-sign-out-inline
              >
                Sign out
              </button>
            </nav>
          ) : null
        }
      </div>
    ) : null
  }
</div>

<OverlayMenu
  panelId="marketing-menu-panel"
  label="Website menu"
  kind="marketing"
  htmlClass="marketing-menu-open"
>
  {
    navGroups.map((group) => (
      <section class="overlay-menu-group" aria-labelledby={`menu-${group.id}`}>
        <h2 id={`menu-${group.id}`} class="overlay-menu-group-label">
          {group.label}
        </h2>
        <ul class="overlay-menu-list">
          {group.links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "overlay-menu-link",
                  link.primary && "overlay-menu-link--primary",
                  marketingNavActivePath(pathname, link.href) && "is-active",
                ]}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                data-marketing-menu-link
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    showAdminEntry && (
      <div class="overlay-menu-admin">
        <a
          href="/admin/"
          class="brand-btn marketing-nav-admin app-header-admin-entry"
          aria-label="Admin"
          data-marketing-menu-link
        >
          admin
          <ArrowRight size={14} strokeWidth={2.25} aria-hidden="true" />
        </a>
      </div>
    )
  }

  {
    showOverlayFooter && (
      <footer slot="footer" class="overlay-menu-footer">
        <div class="overlay-menu-footer-row">
          {
            !signedIn && showDemoCta && demoCta && (
              <a class="overlay-menu-footer-cta" href={demoCta.href} data-marketing-menu-link>
                Demo now
                <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
              </a>
            )
          }
          {
            signedIn && showAccountNav && (
              <nav class="overlay-menu-footer-actions" aria-label="Account actions">
                <a
                  href="/admin/profile"
                  class="overlay-menu-action"
                  data-marketing-menu-link
                >
                  Profile
                </a>
                <button
                  type="button"
                  class="overlay-menu-action overlay-menu-action--danger"
                  data-marketing-sign-out
                >
                  Sign out
                </button>
                <button
                  type="button"
                  class="overlay-menu-action"
                  disabled
                  aria-disabled="true"
                  title="Settings coming soon"
                >
                  Settings
                </button>
                <a
                  href="/admin/?tab=dashboard"
                  class="overlay-menu-action overlay-menu-action--icon"
                  aria-label="Dashboard"
                  data-marketing-menu-link
                >
                  <LayoutDashboard size={18} strokeWidth={1.75} aria-hidden="true" />
                </a>
              </nav>
            )
          }
        </div>
      </footer>
    )
  }
</OverlayMenu>

<script>
  import { getMarketingOverlay, setOverlayMenuOpen } from "../lib/overlayMenuDom";

  function setMarketingMenuOpen(open: boolean) {
    setOverlayMenuOpen(getMarketingOverlay(), open);
  }

  function bindMarketingMenu() {
    const root = getMarketingOverlay();
    if (!root) return;
    if (document.documentElement.dataset.marketingMenuBound === "1") return;
    document.documentElement.dataset.marketingMenuBound = "1";

    root.querySelectorAll("[data-marketing-menu-link]").forEach((el) => {
      el.addEventListener("click", () => setMarketingMenuOpen(false));
    });

    async function marketingSignOut() {
      setMarketingMenuOpen(false);
      const { Clerk } = window as Window & { Clerk?: { signOut: () => Promise<void> } };
      if (Clerk) {
        await Clerk.signOut();
        window.location.href = "/";
      } else {
        window.location.href = "/sign-out";
      }
    }

    root.querySelector("[data-marketing-sign-out]")?.addEventListener("click", (ev) => {
      ev.preventDefault();
      void marketingSignOut();
    });

    document.querySelector("[data-marketing-sign-out-inline]")?.addEventListener("click", (ev) => {
      ev.preventDefault();
      void marketingSignOut();
    });
  }

  bindMarketingMenu();
  document.addEventListener("astro:page-load", bindMarketingMenu);
</script>

<style>
  .marketing-nav {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    gap: 0.5rem;
    margin-left: 0.5rem;
    min-width: 0;
  }

  .marketing-nav-desktop {
    display: none;
    align-items: center;
    flex: 1 1 auto;
    gap: 0.05rem;
    min-width: 0;
    overflow: hidden;
  }

  .marketing-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    margin-left: auto;
  }

  .marketing-nav-signin {
    padding: 0.35rem 0.75rem;
    border: none;
    border-radius: 999px;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--site-fg, #171717);
    background: rgba(255, 255, 255, 0.06);
    cursor: pointer;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .marketing-nav-signin:hover {
    color: var(--site-fg, #171717);
    background: var(--site-card, rgba(23, 23, 23, 0.04));
  }

  .marketing-nav-inline {
    display: none;
    align-items: center;
    gap: 0.15rem;
    margin-right: 0.35rem;
  }

  .marketing-nav-link {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--site-fg-muted, #525252);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .marketing-nav-link:hover {
    color: var(--site-fg, #171717);
    background: rgba(255, 255, 255, 0.06);
    text-decoration: none;
  }

  .marketing-nav-link.is-active {
    color: var(--site-fg, #171717);
  }

  .marketing-nav-link--button {
    font: inherit;
    cursor: pointer;
  }

  .marketing-nav-cta {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.82rem;
    font-weight: 600;
    color: #fff;
    -webkit-text-fill-color: #fff;
    background: var(--brand-gradient);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: var(--brand-gradient-shadow);
    transition: filter 0.15s ease, transform 0.15s ease;
  }

  .marketing-nav-cta:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .marketing-nav-actions .marketing-nav-admin {
    display: none;
    flex-shrink: 0;
    height: auto;
    padding: 0.38rem 0.75rem 0.38rem 0.85rem;
    gap: 0.28rem;
    font-size: 0.75rem;
  }

  .marketing-nav-actions .marketing-nav-admin svg {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
  }

  .overlay-menu-admin {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--site-border, rgba(23, 23, 23, 0.1));
  }

  .overlay-menu-admin .marketing-nav-admin {
    width: 100%;
    justify-content: center;
    padding: 0.75rem 1.2rem;
    font-size: 0.92rem;
  }

  @media (min-width: 900px) {
    .marketing-nav-desktop {
      display: flex;
    }

    .marketing-nav-inline--signed-in {
      display: flex;
    }

    .marketing-nav-cta {
      display: inline-flex;
    }

    .marketing-nav-actions .marketing-nav-admin {
      display: inline-flex;
    }
  }

  @media (min-width: 900px) and (max-width: 1079px) {
    .marketing-nav-link[data-hide-below="1080"] {
      display: none;
    }
  }

  @media (min-width: 900px) and (max-width: 1023px) {
    .marketing-nav-link {
      padding: 0.35rem 0.5rem;
      font-size: 0.76rem;
    }

    .marketing-nav-cta {
      padding: 0.38rem 0.72rem;
      font-size: 0.76rem;
    }
  }

  @media (max-width: 899px) {
    .marketing-nav-cta {
      padding: 0.38rem 0.72rem;
      font-size: 0.76rem;
    }
  }
</style>
