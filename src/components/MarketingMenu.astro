---
/**
 * Vercel-style marketing navigation — Sign in on desktop, hamburger drawer on small screens.
 */
import DeployStatusDot from "./DeployStatusDot.astro";
import { ArrowRight, X } from "lucide-astro";
import {
  MARKETING_NAV_GROUPS,
  marketingNavActivePath,
} from "../lib/marketingNav";

interface Props {
  pathname: string;
  signedIn: boolean;
}

const { pathname, signedIn } = Astro.props;

const navGroups = signedIn
  ? MARKETING_NAV_GROUPS.map((group) => ({
      ...group,
      links: group.links.filter((link) => link.href !== "/demo"),
    }))
  : MARKETING_NAV_GROUPS;
---

<div class="marketing-nav" data-marketing-nav>
  <DeployStatusDot />
  {
    !signedIn ? (
      <button
        type="button"
        class="marketing-nav-signin"
        data-ios-sheet-open="sign-in-sheet"
      >
        Sign in
      </button>
    ) : (
      <nav class="marketing-nav-inline marketing-nav-inline--signed-in" aria-label="Account">
        <a href="/admin/?tab=home" class="marketing-nav-link">
          Administration
        </a>
        <button
          type="button"
          class="marketing-nav-link marketing-nav-link--button"
          data-marketing-sign-out-inline
        >
          Sign out
        </button>
      </nav>
    )
  }

  {
    !signedIn && (
      <a class="marketing-nav-cta" href="/demo">
        Demo now
        <ArrowRight size={15} strokeWidth={2} aria-hidden="true" />
      </a>
    )
  }

  <button
    type="button"
    class="marketing-nav-toggle"
    data-marketing-menu-toggle
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="marketing-menu-panel"
  >
    <svg
      class="marketing-nav-toggle-icon marketing-nav-toggle-icon--open"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="4" x2="20" y1="8" y2="8" />
      <line x1="4" x2="20" y1="16" y2="16" />
    </svg>
    <X class="marketing-nav-toggle-icon marketing-nav-toggle-icon--close" size={20} strokeWidth={1.75} aria-hidden="true" />
  </button>
</div>

<div class="marketing-menu" data-marketing-menu hidden>
  <div class="marketing-menu-backdrop" data-marketing-menu-backdrop aria-hidden="true"></div>
  <div
    id="marketing-menu-panel"
    class="marketing-menu-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Site menu"
  >
    <div class="marketing-menu-scroll">
      {
        navGroups.map((group) => (
          <section class="marketing-menu-group" aria-labelledby={`menu-${group.id}`}>
            <h2 id={`menu-${group.id}`} class="marketing-menu-group-label">
              {group.label}
            </h2>
            <ul class="marketing-menu-list">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      "marketing-menu-link",
                      link.primary && "marketing-menu-link--primary",
                      marketingNavActivePath(pathname, link.href) && "is-active",
                    ]}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    data-marketing-menu-link
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      {
        signedIn && (
          <section class="marketing-menu-group" aria-labelledby="menu-account">
            <h2 id="menu-account" class="marketing-menu-group-label">Account</h2>
            <ul class="marketing-menu-list">
              <li>
                <a href="/admin/?tab=home" class="marketing-menu-link" data-marketing-menu-link>
                  Administration
                </a>
              </li>
            </ul>
          </section>
        )
      }
    </div>

    <footer class="marketing-menu-footer">
      <div class="marketing-menu-footer-row">
        {
          !signedIn && (
            <a class="marketing-menu-footer-cta" href="/demo" data-marketing-menu-link>
              Demo now
              <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
            </a>
          )
        }
        {
          signedIn && (
            <button
              type="button"
              class="marketing-menu-footer-signout"
              data-marketing-sign-out
            >
              Sign out
            </button>
          )
        }
      </div>
    </footer>
  </div>
</div>

<script>
  /** Blocks background scroll on iOS without mutating body position (avoids PWA viewport thrash). */
  let menuTouchBlocker: ((e: TouchEvent) => void) | null = null;

  function setMarketingMenuScrollBlocked(block: boolean) {
    const root = document.querySelector("[data-marketing-menu]");
    const scroll = root?.querySelector(".marketing-menu-scroll");

    if (block) {
      if (menuTouchBlocker) return;
      menuTouchBlocker = (e) => {
        const target = e.target;
        if (target instanceof Node && scroll?.contains(target)) return;
        e.preventDefault();
      };
      document.addEventListener("touchmove", menuTouchBlocker, { passive: false });
      return;
    }

    if (menuTouchBlocker) {
      document.removeEventListener("touchmove", menuTouchBlocker);
      menuTouchBlocker = null;
    }
  }

  function setMarketingMenuOpen(open: boolean) {
    const root = document.querySelector("[data-marketing-menu]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-marketing-menu-toggle]");
    if (!root || !toggle) return;

    root.hidden = !open;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    toggle.classList.toggle("is-open", open);
    document.documentElement.classList.toggle("marketing-menu-open", open);
    setMarketingMenuScrollBlocked(open);
  }

  function bindMarketingMenu() {
    const root = document.querySelector("[data-marketing-menu]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-marketing-menu-toggle]");
    const backdrop = document.querySelector("[data-marketing-menu-backdrop]");
    if (!root || !toggle) return;
    if (document.documentElement.dataset.marketingMenuBound === "1") return;
    document.documentElement.dataset.marketingMenuBound = "1";

    toggle.addEventListener("click", (ev) => {
      ev.stopPropagation();
      const open = toggle.getAttribute("aria-expanded") !== "true";
      setMarketingMenuOpen(open);
    });

    backdrop?.addEventListener("click", () => setMarketingMenuOpen(false));

    root.querySelectorAll("[data-marketing-menu-link]").forEach((el) => {
      el.addEventListener("click", () => setMarketingMenuOpen(false));
    });

    async function marketingSignOut() {
      setMarketingMenuOpen(false);
      const { Clerk } = window as Window & { Clerk?: { signOut: () => Promise<void> } };
      if (Clerk) {
        await Clerk.signOut();
        window.location.href = "/";
      } else {
        window.location.href = "/sign-out";
      }
    }

    root.querySelector("[data-marketing-sign-out]")?.addEventListener("click", (ev) => {
      ev.preventDefault();
      void marketingSignOut();
    });

    document.querySelector("[data-marketing-sign-out-inline]")?.addEventListener("click", (ev) => {
      ev.preventDefault();
      void marketingSignOut();
    });

    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape") setMarketingMenuOpen(false);
    });
  }

  bindMarketingMenu();
  document.addEventListener("astro:page-load", bindMarketingMenu);
</script>

<style>
  .marketing-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .marketing-nav-signin {
    padding: 0.35rem 0.75rem;
    border: none;
    border-radius: 999px;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.82);
    background: rgba(255, 255, 255, 0.06);
    cursor: pointer;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .marketing-nav-signin:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .marketing-nav-inline {
    display: none;
    align-items: center;
    gap: 0.15rem;
    margin-right: 0.35rem;
  }

  .marketing-nav-link {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.62);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .marketing-nav-link:hover {
    color: rgba(255, 255, 255, 0.92);
    background: rgba(255, 255, 255, 0.06);
    text-decoration: none;
  }

  .marketing-nav-link.is-active {
    color: #fff;
  }

  .marketing-nav-link--button {
    font: inherit;
    cursor: pointer;
  }

  .marketing-nav-cta {
    display: none; /* hidden for now — keep markup for easy restore */
    align-items: center;
    gap: 6px;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.82rem;
    font-weight: 600;
    color: #0b0512;
    background: var(--brand-gradient);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgba(192, 38, 211, 0.28);
    transition: filter 0.15s ease, transform 0.15s ease;
  }

  .marketing-nav-cta:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .marketing-nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: calc(36px * var(--app-header-chrome-scale, 1));
    height: calc(36px * var(--app-header-chrome-scale, 1));
    padding: 0;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.88);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }

  .marketing-nav-toggle:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }

  .marketing-nav-toggle:active {
    transform: scale(0.94);
  }

  .marketing-nav-toggle-icon {
    position: absolute;
    inset: 0;
    width: 20px;
    height: 20px;
    margin: auto;
  }

  .marketing-nav-toggle-icon--close {
    display: none;
  }

  .marketing-nav-toggle.is-open .marketing-nav-toggle-icon--open {
    display: none;
  }

  .marketing-nav-toggle.is-open .marketing-nav-toggle-icon--close {
    display: block;
  }

  @media (min-width: 900px) {
    .marketing-nav-inline--signed-in {
      display: flex;
    }

    .marketing-nav-toggle {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .marketing-nav-cta {
      padding: 0.38rem 0.72rem;
      font-size: 0.76rem;
    }
  }

  /* ---------- Overlay menu ---------- */

  .marketing-menu[hidden] {
    display: none !important;
  }

  .marketing-menu:not([hidden]) {
    position: fixed;
    inset: 0;
    z-index: 2050;
  }

  .marketing-menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: marketing-menu-fade-in 0.28s ease-out;
    touch-action: none;
  }

  /* Blur over a scrolling page forces full repaints every frame — skip on phone/PWA. */
  @media (max-width: 899px), (display-mode: standalone) {
    .marketing-menu-backdrop {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgba(0, 0, 0, 0.78);
    }
  }

  .marketing-menu-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(420px, 100vw);
    height: 100%;
    display: flex;
    flex-direction: column;
    background: rgba(8, 8, 10, 0.96);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: -24px 0 80px rgba(0, 0, 0, 0.45);
    animation: marketing-menu-slide-in 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes marketing-menu-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes marketing-menu-slide-in {
    from {
      opacity: 0.92;
      transform: translateX(18px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .marketing-menu-scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    padding:
      calc(var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) + 20px)
      28px
      24px;
  }

  .marketing-menu-group + .marketing-menu-group {
    margin-top: 28px;
  }

  .marketing-menu-group-label {
    margin: 0 0 10px;
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .marketing-menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .marketing-menu-link {
    display: flex;
    align-items: center;
    width: 100%;
    touch-action: manipulation;
    padding: 0.72rem 0.2rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    font-family: var(--font-primary);
    font-size: clamp(1.35rem, 4vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: rgba(255, 255, 255, 0.92);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .marketing-menu-link:hover,
  .marketing-menu-link.is-active {
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
    text-decoration: none;
  }

  .marketing-menu-link--primary {
    color: #f472b6;
  }

  .marketing-menu-link--button {
    font: inherit;
  }

  .marketing-menu-footer {
    flex-shrink: 0;
    padding:
      16px 28px
      calc(16px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .marketing-menu-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .marketing-menu-footer-signout {
    margin-left: auto;
    padding: 0.75rem 0.2rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    font-family: var(--font-secondary);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.62);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .marketing-menu-footer-signout:hover {
    color: rgba(255, 255, 255, 0.92);
    background: rgba(255, 255, 255, 0.04);
  }

  .marketing-menu-footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.2rem;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-size: 0.92rem;
    font-weight: 600;
    color: #0b0512;
    background: var(--brand-gradient);
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(192, 38, 211, 0.32);
  }

  .marketing-menu-footer-cta:hover {
    filter: brightness(1.06);
    text-decoration: none;
  }

  /* Keep the header (and hamburger → X toggle) above the menu overlay. */
  :global(html.marketing-menu-open) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(html.marketing-menu-open) .app-header {
    z-index: 2200;
  }

  /* Menu overlay is a fixed sibling inside the header row — sit above it. */
  :global(html.marketing-menu-open .app-header-logo),
  :global(html.marketing-menu-open .marketing-nav) {
    position: relative;
    z-index: 2100;
  }

  @media (prefers-reduced-motion: reduce) {
    .marketing-menu-backdrop,
    .marketing-menu-panel {
      animation: none;
    }
  }
</style>
