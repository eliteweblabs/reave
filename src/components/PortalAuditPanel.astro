---
/**
 * Client portal Audit tab — single live online-presence diagnostic.
 * Audits are filtered out of Projects; one diagnostic per client.
 */
import type { AuditReportCard } from '../lib/auditReportCard';
import PortalAuditReportCard from './PortalAuditReportCard.astro';

interface Props {
  report: AuditReportCard | null;
  bodyHtml?: string;
  clientName?: string;
  website?: string;
  active?: boolean;
}

const {
  report,
  bodyHtml = '',
  clientName = '',
  website = '',
  active = false,
} = Astro.props;
---

<section class={`panel portal-audit ${active ? 'active' : ''}`} data-tab-panel="audit">
  {!report ? (
    <p class="muted">No online presence diagnostic yet.</p>
  ) : (
    <PortalAuditReportCard
      report={report}
      bodyHtml={report.inProgress ? '' : bodyHtml}
      clientName={clientName}
      website={website}
    />
  )}
</section>
