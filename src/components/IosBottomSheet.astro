---
interface Props {
  id: string;
  title?: string;
  /** Override title element id (defaults to `${id}-title`). */
  titleId?: string;
  /** Extra class on the title element. */
  titleClass?: string;
  /** When false, tapping the backdrop does not dismiss (e.g. required sign-in). */
  dismissible?: boolean;
  /**
   * @deprecated All sheets are bottom sheets on every viewport.
   * Kept so existing callers compile; ignored.
   */
  sheetOnly?: boolean;
  /** Show the circular close control (defaults to `dismissible`). */
  showClose?: boolean;
  /** Start with the close button hidden (OS dialog toggles visibility). */
  closeHidden?: boolean;
  /**
   * Close button dataset: `ios` → data-ios-sheet-close;
   * `os-dialog` → data-os-dialog-close (admin controller owns dismiss).
   */
  closeVia?: 'ios' | 'os-dialog';
  /** Extra class on the backdrop (in addition to ios-sheet-backdrop). */
  class?: string;
  /** Extra class on the inner .ios-sheet panel. */
  sheetClass?: string;
  /** Extra class on .ios-sheet-body. */
  bodyClass?: string;
  /** Render the sheet open on first paint (required sign-in). */
  startOpen?: boolean;
}

const {
  id,
  title = '',
  titleId = `${id}-title`,
  titleClass = '',
  dismissible = true,
  showClose = dismissible,
  closeHidden = false,
  closeVia = 'ios',
  class: className = '',
  sheetClass = '',
  bodyClass = '',
  startOpen = false,
} = Astro.props;

const closeAttr = closeVia === 'os-dialog' ? { 'data-os-dialog-close': true } : { 'data-ios-sheet-close': true };
---

<div
  id={id}
  class:list={['ios-sheet-backdrop', className, { open: startOpen }]}
  role="presentation"
  aria-hidden={startOpen ? 'false' : 'true'}
  data-sheet-dismiss={dismissible ? 'true' : 'false'}
>
  <div class:list={['ios-sheet', sheetClass, { 'ios-sheet--visible': startOpen }]} role="dialog" aria-modal="true" aria-labelledby={titleId}>
    <div class="ios-sheet-grabber" aria-hidden="true"></div>
    <header class="ios-sheet-header">
      {showClose && (
        <button
          type="button"
          class="ios-sheet-close"
          {...closeAttr}
          aria-label="Close"
          hidden={closeHidden || undefined}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <!-- IOS_ICONS.x — keep in sync with public/admin/admin-ui.js -->
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
      )}
      <h2 class:list={['ios-sheet-title', titleClass]} id={titleId}>{title}</h2>
      <div class="ios-sheet-header-trailing">
        <slot name="header-action" />
      </div>
    </header>
    <div class:list={['ios-sheet-body', bodyClass]}>
      <slot />
    </div>
  </div>
</div>

<link rel="stylesheet" href={`/ios-sheet.css?v=${__PUBLIC_ASSET_VERSION__}`} />
