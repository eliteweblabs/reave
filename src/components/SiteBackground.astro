/**
 * Site atmosphere — wallpaper that bleeds past Safari overlay chrome.
 * Pad content, not this layer. The veil is a separate fixed layer so it
 * still paints if Safari clips the bled wallpaper at the visual viewport.
 */
---

<div class="site-bg-atmosphere" aria-hidden="true"></div>
<div class="site-bg-atmosphere-veil" aria-hidden="true"></div>
