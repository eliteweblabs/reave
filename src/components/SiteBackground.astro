---
/**
 * Viewport atmosphere — gradient mesh + brand chevron pattern.
 * Layers are position:fixed but inset past Safari’s edge-sampling band
 * (see brand.css) so iPhone does not letterbox them with black chin/forehead.
 */
import ReaveBgPattern from "./ReaveBgPattern.astro";
---

<div class="site-bg-mesh" aria-hidden="true"></div>
<ReaveBgPattern class="site-bg-pattern" fit="cover" opacity={0.085} />
