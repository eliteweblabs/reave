---
/**
 * Site atmosphere — chevron pattern overlay.
 * Gradient mesh is painted on `body` (Layout / portal) so iPhone Safari does
 * not sample a position:fixed full-bleed layer for forehead/chin letterbox bars.
 *
 * Single cover-scaled artwork (pre-Astro-7). Half-size tiling can return later
 * without changing canvas/mesh colors.
 */
import ReaveBgPattern from "./ReaveBgPattern.astro";
---

<ReaveBgPattern class="site-bg-pattern" fit="cover" opacity={0.085} />
