---
/**
 * Client portal Work (Projects) tab — job list with expandable comment threads.
 * Website audits live on the Audit tab, not here.
 */
import type { WorkJobComment } from '../lib/workComments';
import type { WorkStatus } from '../lib/workStore';
import PortalJobComments from './PortalJobComments.astro';
import { escapeHtml } from '../lib/htmlEscape';

export interface PortalWorkJobItem {
  slug: string;
  title: string;
  status: WorkStatus;
  statusLabel: string;
  /** Rich HTML from the project description (admin body field). */
  bodyHtml: string;
  /** Formatted updated/created date for display under the title. */
  dateLabel: string;
  /** Shareable portal URL for this project. */
  portalUrl: string;
}

export interface PortalWorkFileItem {
  id: string;
  filename: string;
  mediaType: string;
  sizeBytes: number;
  url: string;
  source?: string;
}

interface Props {
  jobs: PortalWorkJobItem[];
  commentsBySlug: Record<string, WorkJobComment[]>;
  filesBySlug?: Record<string, PortalWorkFileItem[]>;
  contactUid: string;
  /** Client company logo for client-authored comments. */
  clientAvatarUrl?: string;
  /** Provider logo for staff-authored comments. */
  staffAvatarUrl?: string;
  active?: boolean;
  /** Auto-expand the first (or only) job on load. */
  autoExpand?: boolean;
  /** Deep-link slug from ?project= — expands that job on load. */
  expandSlug?: string;
  /** Tracked share token from ?track= (appended by /go/:token redirect). */
  trackToken?: string;
  /** Dwell time before recording a client view (deep-link or accordion expand). */
  dwellMs?: number;
}

const {
  jobs,
  commentsBySlug,
  filesBySlug = {},
  contactUid,
  clientAvatarUrl = '',
  staffAvatarUrl = '',
  active = false,
  autoExpand = false,
  expandSlug = '',
  trackToken = '',
  dwellMs = 4000,
} = Astro.props;

function fmtFileSize(bytes: number): string {
  const n = Number(bytes) || 0;
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
  return `${(n / (1024 * 1024)).toFixed(1)} MB`;
}

const commentEndpointBase = `/api/c/${encodeURIComponent(contactUid)}/work`;
const filesEndpointBase = commentEndpointBase;
---

<section class={`panel portal-work ${active ? 'active' : ''}`} data-tab-panel="work">

  {jobs.length === 0 ? (
    <p class="muted">No active projects right now.</p>
  ) : (
    <ul class="work-list" id="portal-work-list">
      {jobs.map((job, index) => {
        const comments = commentsBySlug[job.slug] ?? [];
        const files = filesBySlug[job.slug] ?? [];
        const startOpen = (expandSlug && job.slug === expandSlug) || (autoExpand && index === 0);
        return (
          <li class="work-item" data-job-slug={job.slug}>
            <button class="work-item-head" type="button" aria-expanded={startOpen ? 'true' : 'false'}>
              <span class="work-main">
                <span class="work-title">{job.title}</span>
                {job.dateLabel && <span class="work-meta">Updated {job.dateLabel}</span>}
              </span>
              <span class={`work-status work-status-${job.status}`}>{job.statusLabel}</span>
              <span class="work-chevron" aria-hidden="true">›</span>
            </button>

            <div class="work-item-body" hidden={!startOpen || undefined}>
              {job.bodyHtml ? (
                <div class="work-description" set:html={job.bodyHtml} />
              ) : (
                <p class="work-description-empty">Project details will appear here as work progresses.</p>
              )}

              <div class="work-files" data-files-root>
                {files.length > 0 && (
                  <div class="work-files-grid">
                    {files.map((file) => {
                      const isImage = file.mediaType.startsWith('image/');
                      return (
                        <a
                          class="work-file-card"
                          href={file.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-file-id={file.id}
                        >
                          {isImage ? (
                            <img
                              class="work-file-thumb"
                              src={file.url}
                              alt={file.filename}
                              loading="lazy"
                            />
                          ) : (
                            <span class="work-file-doc" aria-hidden="true">PDF</span>
                          )}
                          <span class="work-file-name">{escapeHtml(file.filename)}</span>
                          <span class="work-file-size">{fmtFileSize(file.sizeBytes)}</span>
                        </a>
                      );
                    })}
                  </div>
                )}
                <div class="work-files-upload">
                  <input
                    class="work-files-input"
                    type="file"
                    accept="image/jpeg,image/png,image/gif,image/webp,application/pdf"
                    multiple
                  />
                  <button class="work-files-upload-btn" type="button">Upload files</button>
                </div>
              </div>

              <PortalJobComments
                jobSlug={job.slug}
                comments={comments}
                contactUid={contactUid}
                clientAvatarUrl={clientAvatarUrl}
                staffAvatarUrl={staffAvatarUrl}
              />
            </div>
          </li>
        );
      })}
    </ul>
  )}
</section>

<script define:vars={{ commentEndpointBase, filesEndpointBase, expandSlug, trackToken, dwellMs }}>
  function escHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function fmtFileSize(bytes) {
    const n = Number(bytes) || 0;
    if (n < 1024) return `${n} B`;
    if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
    return `${(n / (1024 * 1024)).toFixed(1)} MB`;
  }

  function renderFileCard(file) {
    const isImage = String(file.mediaType || '').startsWith('image/');
    const card = document.createElement('a');
    card.className = 'work-file-card';
    card.href = file.url;
    card.target = '_blank';
    card.rel = 'noopener noreferrer';
    card.dataset.fileId = file.id;
    card.innerHTML =
      (isImage
        ? `<img class="work-file-thumb" src="${escHtml(file.url)}" alt="${escHtml(file.filename || 'file')}" loading="lazy" />`
        : `<span class="work-file-doc" aria-hidden="true">PDF</span>`) +
      `<span class="work-file-name">${escHtml(file.filename || 'file')}</span>` +
      `<span class="work-file-size">${escHtml(fmtFileSize(file.sizeBytes))}</span>`;
    return card;
  }

  function renderFilesGrid(filesRoot, files) {
    let grid = filesRoot.querySelector('.work-files-grid');
    if (!files.length) {
      if (grid) grid.remove();
      return;
    }

    if (!grid) {
      grid = document.createElement('div');
      grid.className = 'work-files-grid';
      const uploadWrap = filesRoot.querySelector('.work-files-upload');
      filesRoot.insertBefore(grid, uploadWrap);
    }
    grid.innerHTML = '';
    for (const file of files) {
      grid.appendChild(renderFileCard(file));
    }
  }

  const viewedSlugs = new Set();
  const dwellTimers = new Map();

  function cancelDwell(slug) {
    const key = String(slug || '').trim();
    const t = dwellTimers.get(key);
    if (t != null) {
      clearTimeout(t);
      dwellTimers.delete(key);
    }
  }

  function cancelAllDwells() {
    for (const t of dwellTimers.values()) clearTimeout(t);
    dwellTimers.clear();
  }

  function scheduleDwellView(jobSlug) {
    const slugKey = String(jobSlug || '').trim();
    if (!slugKey || viewedSlugs.has(slugKey)) return;
    cancelDwell(slugKey);
    if (document.visibilityState !== 'visible') return;
    dwellTimers.set(
      slugKey,
      window.setTimeout(() => {
        dwellTimers.delete(slugKey);
        recordProjectViewed(slugKey);
      }, dwellMs),
    );
  }

  function recordProjectViewed(jobSlug) {
    const slugKey = String(jobSlug || '').trim();
    if (!slugKey || viewedSlugs.has(slugKey)) return;
    viewedSlugs.add(slugKey);
    cancelDwell(slugKey);
    const payload = trackToken ? { token: trackToken } : {};
    fetch(`${commentEndpointBase}/${encodeURIComponent(slugKey)}/viewed`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    }).catch(() => undefined);
  }

  if (expandSlug) {
    const scheduleDeepLinkDwell = () => {
      if (document.visibilityState !== 'visible') {
        cancelDwell(expandSlug);
        return;
      }
      scheduleDwellView(expandSlug);
    };
    if (document.readyState === 'complete') scheduleDeepLinkDwell();
    else window.addEventListener('load', scheduleDeepLinkDwell, { once: true });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') scheduleDeepLinkDwell();
      else cancelDwell(expandSlug);
    });
  }

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible') cancelAllDwells();
  });

  document.querySelectorAll('.work-item').forEach((item) => {
    const head = item.querySelector('.work-item-head');
    const body = item.querySelector('.work-item-body');
    const slug = item.getAttribute('data-job-slug');
    const textarea = item.querySelector('.work-comment-input');
    const filesRoot = item.querySelector('[data-files-root]');
    const fileInput = item.querySelector('.work-files-input');
    const uploadBtn = item.querySelector('.work-files-upload-btn');
    if (!head || !body || !slug) return;

    if (filesRoot && fileInput && uploadBtn) {
      uploadBtn.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', async () => {
        const picked = [...fileInput.files];
        fileInput.value = '';
        if (!picked.length) return;

        uploadBtn.disabled = true;
        const prev = uploadBtn.textContent;
        uploadBtn.textContent = 'Uploading…';

        try {
          for (const file of picked) {
            const form = new FormData();
            form.append('file', file);
            const res = await fetch(
              `${filesEndpointBase}/${encodeURIComponent(slug)}/files`,
              { method: 'POST', body: form },
            );
            const data = await res.json();
            if (!res.ok || !data.ok) throw new Error(data.error || 'Upload failed');
          }

          const listRes = await fetch(
            `${filesEndpointBase}/${encodeURIComponent(slug)}/files`,
            { cache: 'no-store' },
          );
          const listData = await listRes.json();
          if (!listRes.ok || !listData.ok) throw new Error(listData.error || 'Could not refresh files');
          renderFilesGrid(filesRoot, listData.files || []);
        } catch (e) {
          alert(e instanceof Error ? e.message : 'Upload failed. Please try again.');
        } finally {
          uploadBtn.disabled = false;
          uploadBtn.textContent = prev;
        }
      });
    }

    head.addEventListener('click', () => {
      const open = body.hasAttribute('hidden');
      document.querySelectorAll('.work-item-body').forEach((el) => {
        if (el !== body) {
          el.setAttribute('hidden', '');
          el.previousElementSibling?.setAttribute('aria-expanded', 'false');
          const otherSlug = el.closest('.work-item')?.getAttribute('data-job-slug');
          if (otherSlug) cancelDwell(otherSlug);
        }
      });
      if (open) {
        body.removeAttribute('hidden');
        head.setAttribute('aria-expanded', 'true');
        scheduleDwellView(slug);
        textarea?.focus();
      } else {
        body.setAttribute('hidden', '');
        head.setAttribute('aria-expanded', 'false');
        cancelDwell(slug);
      }
    });
  });
</script>

<style>
  .portal-work .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .work-item {
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    overflow: hidden;
  }

  .work-item-head {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 14px 16px;
    border: none;
    background: transparent;
    color: #fff;
    text-align: left;
    cursor: pointer;
    font: inherit;
  }

  .work-item-head:active {
    background: rgba(var(--portal-primary-rgb, 168, 85, 247), 0.08);
  }

  .work-main {
    flex: 1;
    min-width: 0;
  }

  .work-title {
    display: block;
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .work-meta {
    display: block;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.45);
  }

  .work-grade {
    flex: none;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -0.03em;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
  }

  .work-grade-a { color: #34d399; background: rgba(52, 211, 153, 0.14); }
  .work-grade-b { color: #6ee7b7; background: rgba(110, 231, 183, 0.12); }
  .work-grade-c { color: #fbbf24; background: rgba(251, 191, 36, 0.14); }
  .work-grade-d { color: #fb923c; background: rgba(251, 146, 60, 0.14); }
  .work-grade-f { color: #f87171; background: rgba(248, 113, 113, 0.14); }
  .work-grade-pending { color: #7dd3fc; background: rgba(125, 211, 252, 0.12); }

  .work-status {
    flex: none;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .work-status-inquiry {
    color: #93c5fd;
    background: rgba(147, 197, 253, 0.12);
  }
  .work-status-active {
    color: #86efac;
    background: rgba(134, 239, 172, 0.12);
  }
  .work-status-done {
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.06);
  }

  .work-chevron {
    flex: none;
    font-size: 18px;
    color: rgba(var(--portal-primary-rgb, 168, 85, 247), 0.75);
    transition: transform 0.2s;
  }

  .work-item-head[aria-expanded='true'] .work-chevron {
    transform: rotate(90deg);
  }

  .work-item-body {
    padding: 0 16px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .work-description {
    margin: 14px 0 16px;
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }

  .work-description :global(a) {
    color: var(--portal-accent, #d8b4fe);
  }

  .work-description :global(.work-body-img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 10px 0;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .work-description-empty {
    margin: 14px 0 16px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
  }

  .work-files {
    margin: 0 0 16px;
  }

  .work-files-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 10px;
    margin-bottom: 12px;
  }

  .work-file-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: inherit;
    text-decoration: none;
    min-width: 0;
  }

  .work-file-card:active {
    border-color: rgba(var(--portal-primary-rgb, 168, 85, 247), 0.45);
  }

  .work-file-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
  }

  .work-file-doc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    background: rgba(var(--portal-primary-rgb, 168, 85, 247), 0.12);
    color: var(--portal-accent, #d8b4fe);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .work-file-name {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .work-file-size {
    display: block;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.42);
  }

  .work-files-upload {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .work-files-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .work-files-upload-btn {
    width: 100%;
    padding: 11px 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px dashed rgba(var(--portal-primary-rgb, 168, 85, 247), 0.45);
    border-radius: 12px;
    color: var(--portal-accent, #d8b4fe);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .work-files-upload-btn:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .work-files-upload-btn:active:not(:disabled) {
    transform: scale(0.98);
  }

  .work-item-body :global(.portal-job-comments) {
    margin-top: 4px;
  }
</style>
