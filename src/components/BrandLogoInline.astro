---
import type { CompanyConfig } from '../lib/companyConfig';
import { companyLogoUrl, hasCompanyHeaderLogoImage } from '../lib/companyConfig';
import { svgHasExternalRasterRefs } from '../lib/brandSvg';
import InlineBrandSvg from './InlineBrandSvg.astro';

export interface Props {
  company: CompanyConfig;
}

const { company } = Astro.props;
const customSvg = company.logoSvg?.trim() ?? '';
/** Illustrator exports embed PNG sidecars (inner glow masks) — skip those and use the display name. */
const inlineLogoSvg =
  customSvg && !svgHasExternalRasterRefs(customSvg) ? customSvg : '';
const logoImageUrl = hasCompanyHeaderLogoImage(company)
  ? companyLogoUrl(company.logoPath, company.logoVersion)
  : '';
const displayName = company.name?.trim() || 'Business OS';
---

{
  logoImageUrl ? (
    <img
      src={logoImageUrl}
      alt={displayName}
      class="app-header-logo-img brand-img logo-img"
      width="926"
      height="262"
      decoding="async"
    />
  ) : inlineLogoSvg ? (
    <InlineBrandSvg
      svg={inlineLogoSvg}
      class="app-header-logo-svg brand-img logo-img"
      idPrefix="header-logo"
    />
  ) : (
    <span class="app-header-logo-name">{displayName}</span>
  )
}
