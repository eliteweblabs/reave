---
import type { CompanyConfig } from '../lib/companyConfig';
import {
  companyLogoUrl,
  companyUsableInlineSvg,
  hasCompanyHeaderLogoImage,
} from '../lib/companyConfig';
import InlineBrandSvg from './InlineBrandSvg.astro';

export interface Props {
  company: CompanyConfig;
  idPrefix?: string;
}

const { company, idPrefix = 'header-logo' } = Astro.props;
const inlineLogoSvg = companyUsableInlineSvg(company.logoSvg);
const logoImageUrl = hasCompanyHeaderLogoImage(company)
  ? companyLogoUrl(company.logoPath, company.logoVersion)
  : '';
const displayName = company.name?.trim() || 'Business OS';
---

{
  inlineLogoSvg ? (
    <InlineBrandSvg
      svg={inlineLogoSvg}
      class="app-header-logo-svg"
      idPrefix={idPrefix}
    />
  ) : logoImageUrl ? (
    <img
      src={logoImageUrl}
      alt={displayName}
      class="app-header-logo-img"
      decoding="async"
    />
  ) : (
    <span class="app-header-logo-name">{displayName}</span>
  )
}
