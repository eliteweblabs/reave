---
/**
 * Static compliance mark row — same data as GET /api/compliance-logos.
 * Footer today; audit sales-sheet left column later.
 */
import { listComplianceLogos } from "../lib/complianceLogos";

const logos = listComplianceLogos();
---

{
  logos.length > 0 && (
    <section class="compliance-logos" aria-label="Compliance and accessibility">
      <ul class="compliance-logos-list">
        {
          logos.map((logo) => (
            <li class="compliance-logos-item">
              <img
                src={logo.src}
                alt={logo.name}
                width={logo.width}
                height={logo.height}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </li>
          ))
        }
      </ul>
    </section>
  )
}

<style>
  .compliance-logos {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .compliance-logos-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 16px;
  }

  .compliance-logos-item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .compliance-logos-item img {
    display: block;
    height: 24px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    filter: grayscale(1);
    opacity: 0.62;
    transition: opacity 0.2s ease;
  }

  .compliance-logos:hover .compliance-logos-item img {
    opacity: 0.82;
  }

  @media (min-width: 640px) {
    .compliance-logos-item img {
      height: 28px;
      max-width: 140px;
    }
  }
</style>
