---
/**
 * Static compliance mark row — same data as GET /api/compliance-logos.
 * Footer today; audit sales-sheet left column later.
 */
import {
  complianceLogoIconSrc,
  listComplianceLogos,
} from "../lib/complianceLogos";

const logos = listComplianceLogos();
---

{
  logos.length > 0 && (
    <section class="compliance-logos" aria-label="Compliance and accessibility">
      <ul class="compliance-logos-list">
        {
          logos.map((logo) => {
            const iconSrc = complianceLogoIconSrc(logo);
            return (
              <li class="compliance-logos-item">
                <span class="compliance-badge">
                  {
                    iconSrc && (
                      <img
                        class="compliance-badge-icon"
                        src={iconSrc}
                        alt=""
                        width={16}
                        height={16}
                        loading="lazy"
                        decoding="async"
                        aria-hidden="true"
                        draggable="false"
                      />
                    )
                  }
                  <span class="compliance-badge-label">{logo.name}</span>
                </span>
              </li>
            );
          })
        }
      </ul>
    </section>
  )
}

<style>
  .compliance-logos {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .compliance-logos-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 12px;
  }

  .compliance-logos-item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .compliance-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1.25px solid rgba(23, 23, 23, 0.28);
    border-radius: 4px;
    background: #fff;
    color: rgba(23, 23, 23, 0.72);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    user-select: none;
    pointer-events: none;
  }

  .compliance-badge-icon {
    display: block;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
  }

  .compliance-badge-label {
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .compliance-badge {
      font-size: 10.5px;
      padding: 5px 11px;
    }
  }
</style>
