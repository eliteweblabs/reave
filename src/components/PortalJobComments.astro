---
/**
 * Client portal job comment thread — shared by Projects and Audit tabs.
 * Posts to /api/c/:uid/work/:jobSlug/comments (author: client).
 */
import type { WorkJobComment } from '../lib/workComments';
import { escapeHtml } from '../lib/htmlEscape';

interface Props {
  jobSlug: string;
  comments: WorkJobComment[];
  contactUid: string;
  /** Client company logo for client-authored comments. */
  clientAvatarUrl?: string;
  /** Provider logo for staff-authored comments. */
  staffAvatarUrl?: string;
}

const {
  jobSlug,
  comments,
  contactUid,
  clientAvatarUrl = '',
  staffAvatarUrl = '',
} = Astro.props;

function fmtCommentTime(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function authorInitial(name: string): string {
  const ch = name.trim().charAt(0);
  return ch ? ch.toUpperCase() : '?';
}

function avatarUrlForAuthor(author: WorkJobComment['author']): string {
  return author === 'staff' ? staffAvatarUrl : clientAvatarUrl;
}

const commentEndpoint = `/api/c/${encodeURIComponent(contactUid)}/work/${encodeURIComponent(jobSlug)}/comments`;
---

<div class="portal-job-comments" data-portal-comments data-job-slug={jobSlug}>
  <div class="work-comments" data-comments-root>
    {comments.length > 0 && (
      <ul class="work-comment-list">
        {comments.map((c) => (
          <li class={`work-comment work-comment-${c.author}`} data-comment-id={c.id}>
            <article class="work-comment-inner">
              <div class="work-comment-avatar" aria-hidden="true">
                {avatarUrlForAuthor(c.author) ? (
                  <img src={avatarUrlForAuthor(c.author)} alt="" loading="lazy" />
                ) : (
                  <span class="work-comment-avatar-fallback">{authorInitial(c.authorName)}</span>
                )}
              </div>
              <div class="work-comment-main">
                <header class="work-comment-head">
                  <span class="work-comment-author">{escapeHtml(c.authorName)}</span>
                  <time class="work-comment-time" datetime={c.createdAt}>{fmtCommentTime(c.createdAt)}</time>
                </header>
                <p class="work-comment-text">{escapeHtml(c.text)}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    )}
  </div>

  <textarea
    class="work-comment-input"
    rows="3"
    maxlength="4000"
    aria-label="Ask a question or share an update"
    placeholder="Ask a question or share an update…"
  />
  <button class="brand-btn brand-btn-solid work-comment-submit" type="button">Add comment</button>
</div>

<script define:vars={{ commentEndpoint, clientAvatarUrl, staffAvatarUrl, jobSlug }}>
  (function initPortalJobComments() {
    const roots = [...document.querySelectorAll('[data-portal-comments]')].filter(
      (el) => el.getAttribute('data-job-slug') === jobSlug && el.dataset.commentsBound !== '1',
    );
    for (const root of roots) {
      root.dataset.commentsBound = '1';

      const textarea = root.querySelector('.work-comment-input');
      const submitBtn = root.querySelector('.work-comment-submit');
      const commentsRoot = root.querySelector('[data-comments-root]');
      if (!textarea || !submitBtn || !commentsRoot) continue;

      function escHtml(s) {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function fmtTime(iso) {
        const d = new Date(iso);
        if (Number.isNaN(d.getTime())) return '';
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      }

      function authorInitial(name) {
        const ch = String(name || '').trim().charAt(0);
        return ch ? ch.toUpperCase() : '?';
      }

      function avatarHtml(author, authorName) {
        const url = author === 'staff' ? staffAvatarUrl : clientAvatarUrl;
        if (url) {
          return (
            `<div class="work-comment-avatar" aria-hidden="true">` +
            `<img src="${escHtml(url)}" alt="" loading="lazy" />` +
            `</div>`
          );
        }
        return (
          `<div class="work-comment-avatar" aria-hidden="true">` +
          `<span class="work-comment-avatar-fallback">${escHtml(authorInitial(authorName))}</span>` +
          `</div>`
        );
      }

      function renderComment(c) {
        const li = document.createElement('li');
        li.className = `work-comment work-comment-${c.author}`;
        li.dataset.commentId = c.id;
        const when = escHtml(c.createdLabel || fmtTime(c.createdAt));
        const whenIso = escHtml(c.createdAt || '');
        li.innerHTML =
          `<article class="work-comment-inner">` +
          avatarHtml(c.author, c.authorName) +
          `<div class="work-comment-main">` +
          `<header class="work-comment-head">` +
          `<span class="work-comment-author">${escHtml(c.authorName)}</span>` +
          `<time class="work-comment-time" datetime="${whenIso}">${when}</time>` +
          `</header>` +
          `<p class="work-comment-text">${escHtml(c.text)}</p>` +
          `</div>` +
          `</article>`;
        return li;
      }

      submitBtn.addEventListener('click', async () => {
        const text = textarea.value.trim();
        if (!text) {
          textarea.focus();
          return;
        }

        submitBtn.disabled = true;
        const prev = submitBtn.textContent;
        submitBtn.textContent = 'Posting…';

        try {
          const res = await fetch(commentEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text }),
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to post');

          let list = commentsRoot.querySelector('.work-comment-list');
          if (!list) {
            list = document.createElement('ul');
            list.className = 'work-comment-list';
            commentsRoot.appendChild(list);
          }

          const c = data.comment;
          list.appendChild(
            renderComment({
              ...c,
              createdLabel: fmtTime(c.createdAt),
            }),
          );

          textarea.value = '';
        } catch {
          alert('Could not post your comment. Please try again.');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = prev;
        }
      });
    }
  })();
</script>

<style>
  .portal-job-comments {
    display: flex;
    flex-direction: column;
    margin-top: 4px;
  }

  .work-comments {
    margin: 0;
  }

  .portal-job-comments :global(.work-comment-list) {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .portal-job-comments :global(.work-comment) {
    padding: 16px 0;
    border-bottom: 1px solid var(--site-card-border);
  }

  .portal-job-comments :global(.work-comment:last-child) {
    border-bottom: none;
    padding-bottom: 4px;
  }

  .portal-job-comments :global(.work-comment-inner) {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .portal-job-comments :global(.work-comment-avatar) {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--site-border);
    border: 1px solid var(--site-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .portal-job-comments :global(.work-comment-avatar img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portal-job-comments :global(.work-comment-avatar-fallback) {
    font-size: 15px;
    font-weight: 700;
    color: var(--site-fg-muted);
    line-height: 1;
  }

  .portal-job-comments :global(.work-comment-staff .work-comment-avatar) {
    border-color: var(--site-border, rgba(23, 23, 23, 0.1));
    background: var(--site-card, rgba(23, 23, 23, 0.03));
  }

  .portal-job-comments :global(.work-comment-main) {
    flex: 1;
    min-width: 0;
  }

  .portal-job-comments :global(.work-comment-head) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 6px;
  }

  .portal-job-comments :global(.work-comment-author) {
    font-size: 14px;
    font-weight: 600;
    color: var(--site-fg);
  }

  .portal-job-comments :global(.work-comment-staff .work-comment-author) {
    color: var(--site-fg, #171717);
  }

  .portal-job-comments :global(.work-comment-time) {
    flex: none;
    font-size: 12px;
    color: var(--site-fg-faint);
    white-space: nowrap;
  }

  .portal-job-comments :global(.work-comment-text) {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--site-fg);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .work-comment-input {
    margin-bottom: 10px;
    width: 100%;
    background: var(--site-card);
    border: 1px solid var(--site-border);
    border-radius: 10px;
    color: var(--site-fg);
    font-family: inherit;
    font-size: 14px;
    line-height: 1.5;
    padding: 11px 14px;
    outline: none;
    resize: vertical;
    min-height: 72px;
  }

  .work-comment-input:focus {
    border-color: var(--site-fg, #171717);
  }

  .work-comment-submit {
    width: 100%;
    padding: 12px;
    background: var(--brand-btn-bg, #111);
    border: 1px solid transparent;
    border-radius: 12px;
    color: var(--brand-btn-fg, #fff);
    -webkit-text-fill-color: var(--brand-btn-fg, #fff);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .work-comment-submit {
      width: auto;
      align-self: flex-end;
      padding: 12px 20px;
    }
  }

  .work-comment-submit:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .work-comment-submit:active:not(:disabled) {
    transform: scale(0.98);
  }
</style>
