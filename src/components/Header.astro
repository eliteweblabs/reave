{showHeaderAccountMenu && (
  <script>
    /**
     * Account overlay — same right-drawer chrome as the marketing hamburger.
     * Admin shell pages without os-map-loader (e.g. /admin/components) still
     * need toggle + sign-out; settings links are real /admin/?tab=… anchors
     * so they navigate even when the map SPA is not loaded. On /admin/,
     * os-map-loader intercepts those anchors for in-app tab switches.
     */
    function closeMarketingOverlay() {
      const marketing = document.querySelector<HTMLElement>("[data-marketing-menu]");
      const toggle = document.querySelector<HTMLButtonElement>("[data-marketing-menu-toggle]");
      if (marketing) marketing.hidden = true;
      toggle?.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open menu");
      document.documentElement.classList.remove("marketing-menu-open");
    }

    function setAccountMenuOpen(open: boolean) {
      const menu = document.getElementById("topbar-profile-menu");
      const toggle = document.getElementById("topbar-profile-toggle");
      if (!menu || !toggle) return;

      if (open) closeMarketingOverlay();
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      document.documentElement.classList.toggle("account-menu-open", open);
      document.documentElement.classList.toggle(
        "overlay-menu-open",
        open || Boolean(document.querySelector(".overlay-menu:not([hidden])")),
      );
      (window as Window & { __syncOverlayMenuScrollLock?: () => void }).__syncOverlayMenuScrollLock?.();
    }

    function bindHeaderProfileMenu() {
      // Admin map SPA owns toggle/sign-out via os-map-loader — leave it alone.
      if (document.getElementById("admin-footer-nav")) return;

      const profileToggle = document.getElementById("topbar-profile-toggle");
      const profileMenu = document.getElementById("topbar-profile-menu");
      if (profileToggle && profileMenu && !profileToggle.dataset.bound) {
        profileToggle.dataset.bound = "1";
        profileToggle.addEventListener("click", (ev) => {
          ev.stopPropagation();
          setAccountMenuOpen(profileMenu.hidden);
        });
      }

      const backdrop = document.querySelector("[data-account-menu-backdrop]");
      if (backdrop && !("bound" in (backdrop as HTMLElement).dataset)) {
        (backdrop as HTMLElement).dataset.bound = "1";
        backdrop.addEventListener("click", () => setAccountMenuOpen(false));
      }

      profileMenu?.querySelectorAll("[data-account-menu-link]").forEach((el) => {
        if ((el as HTMLElement).dataset.bound) return;
        (el as HTMLElement).dataset.bound = "1";
        el.addEventListener("click", () => setAccountMenuOpen(false));
      });

      const signOutBtn = document.getElementById("topbar-sign-out");
      if (signOutBtn && !signOutBtn.dataset.bound) {
        signOutBtn.dataset.bound = "1";
        signOutBtn.addEventListener("click", async (ev) => {
          ev.preventDefault();
          setAccountMenuOpen(false);
          const { Clerk } = window as Window & { Clerk?: { signOut: () => Promise<void> } };
          if (Clerk) {
            await Clerk.signOut();
            window.location.href = "/";
          } else {
            window.location.href = "/sign-out";
          }
        });
      }

      if (!document.documentElement.dataset.headerMenuBound) {
        document.documentElement.dataset.headerMenuBound = "1";
        document.addEventListener("keydown", (ev) => {
          if (ev.key === "Escape") setAccountMenuOpen(false);
        });
      }
    }

    bindHeaderProfileMenu();
    document.addEventListener("astro:page-load", bindHeaderProfileMenu);
  </script>
)}
