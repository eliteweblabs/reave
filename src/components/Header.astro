---
import DeployStatusDot from "./DeployStatusDot.astro";
import { getCompanyConfig, companyStaffAvatarUrl } from "../lib/companyConfig";
import type { PortalBrandColors } from "../lib/portalBrandColors";
import { PROFILE_MENU_LABELS, type ProfileMenuKey } from "../lib/installConfig";
import SignInSheet from "./SignInSheet.astro";
import BrandLogoInline from "./BrandLogoInline.astro";
import MarketingMenu from "./MarketingMenu.astro";
import type { SiteContentConfig } from "../lib/siteContent";
import {
  Shield,
  LayoutDashboard,
} from "lucide-astro";

interface Props {
  /** Admin SPA shell — profile menu; tab nav lives in footer */
  adminShell?: boolean;
  /** Vercel-style inline nav + hamburger on public marketing pages */
  marketingNav?: boolean;
  /** Client portal (or similar) — signed-in staff see an obvious Admin indicator */
  staffPreview?: boolean;
  /** Settings links in the account dropdown (from install config). */
  profileMenu?: readonly ProfileMenuKey[];
  /** Open the sign-in bottom sheet on load (signed-out admin shell). */
  signInAutoOpen?: boolean;
  /** Client portal brand colors — tints the REAVE logo and header accents. */
  portalBrand?: PortalBrandColors | null;
  /** Public site content config (nav, homepage). */
  siteContent?: SiteContentConfig;
}

const {
  adminShell = false,
  marketingNav = false,
  staffPreview = false,
  profileMenu = [],
  signInAutoOpen: signInAutoOpenProp = false,
  portalBrand = null,
  siteContent,
} = Astro.props;

const company = await getCompanyConfig(Astro.request);
const profileIconSrc = companyStaffAvatarUrl(company);

const auth = Astro.locals.auth?.();
const userId = auth?.userId ?? null;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const inAdminRoute = adminShell || path.startsWith("/admin");
const logoHref = inAdminRoute ? "/admin/?tab=dashboard" : "/";
const logoAriaLabel = inAdminRoute ? "Dashboard" : company.name || "Home";
/** Always /admin after auth — never "/" (that looped SignIn → / → SignIn). */
const signInRedirect = "/admin/";
const signInAutoOpen =
  signInAutoOpenProp || Astro.url.searchParams.get("auth") === "sign-in" || path === "/sign-in";
const showMarketingNav = marketingNav && !adminShell;
const showHeaderSignIn = !userId && !showMarketingNav;
/** Signed-in profile control in the header end cluster (admin shell or public pages). */
const showHeaderProfile = userId && !showMarketingNav;
/**
 * Marketing pages: avatar account menu on the right (same as homepage) —
 * not inline Administration / Sign out links in MarketingMenu.
 */
const showHeaderHomeProfile = showMarketingNav && Boolean(userId);
const showHeaderAccountMenu = showHeaderProfile || showHeaderHomeProfile;
---

<header
  class:list={[
    "app-header",
    {
      "app-header--admin": adminShell,
      "app-header--portal-brand": !!portalBrand,
    },
  ]}
  id={adminShell ? "topbar" : undefined}
>
  {!adminShell && (
    <div class="app-header-scrim" aria-hidden="true">
      <span class="app-header-scrim-blur"></span>
      <span class="app-header-scrim-blur"></span>
      <span class="app-header-scrim-blur"></span>
    </div>
  )}

  <div class:list={["app-header-row", { "app-header-row--admin": adminShell }]}>
  <a
    href={logoHref}
    class="app-header-logo brand"
    aria-label={logoAriaLabel}
  >
    <span class="app-header-logo-clip" aria-hidden="true">
      <BrandLogoInline company={company} />
    </span>
  </a>

  <div id="topbar-panel-context" class="topbar-panel-context" hidden></div>

  {showMarketingNav && (
    <MarketingMenu
      pathname={path}
      signedIn={Boolean(userId)}
      hideAccountNav={showHeaderHomeProfile}
      siteContent={siteContent}
    />
  )}

  <div class="app-header-end topbar-end">
    {showHeaderSignIn && (
      <div class="topbar-auth-cluster">
        <DeployStatusDot />
        <button
          type="button"
          class="app-header-signin"
          data-ios-sheet-open="sign-in-sheet"
          aria-label="Sign in"
          title="Sign in"
        >
          <!-- IOS_ICONS.user — keep in sync with public/admin/admin-ui.js -->
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </button>
      </div>
    )}

    {showHeaderAccountMenu && (adminShell ? (
        <>
          <button
            type="button"
            id="push-enable-btn"
            class="app-header-icon-btn topbar-icon-btn topbar-push-btn"
            aria-label="Enable push notifications"
            title="Enable push notifications"
            hidden
          >
            <!-- IOS_ICONS.bell — keep in sync with public/admin/admin-ui.js -->
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          </button>
          <div class="topbar-profile-cluster">
            <DeployStatusDot />
            <div class="app-header-menu topbar-menu topbar-profile-menu">
              <button
                type="button"
                id="topbar-profile-toggle"
                class="app-header-profile-btn topbar-profile-btn"
                aria-label="Account menu"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <img
                  src={profileIconSrc}
                  alt=""
                  class="topbar-profile-icon-img"
                  aria-hidden="true"
                  loading="eager"
                  decoding="async"
                />
              </button>
              <span id="topbar-review-badge" class="topbar-badge" hidden>0</span>
              <div id="topbar-profile-menu" class="app-header-dropdown topbar-dropdown" role="menu">
              {profileMenu.map((key) => (
                <button
                  type="button"
                  id={`topbar-${key}-link`}
                  class="topbar-dropdown-item"
                  role="menuitem"
                >
                  {PROFILE_MENU_LABELS[key]}
                </button>
              ))}
              <div class="topbar-dropdown-divider"></div>
              <button type="button" id="topbar-sign-out" class="topbar-dropdown-item topbar-dropdown-item--danger" role="menuitem">
                Sign out
              </button>
              </div>
            </div>
          </div>
        </>
      ) : (
        <div class="topbar-profile-cluster">
          <DeployStatusDot />
          <div class="app-header-menu topbar-menu topbar-profile-menu">
          <button
            type="button"
            id="topbar-profile-toggle"
            class:list={[
              "app-header-profile-btn",
              "topbar-profile-btn",
              { "topbar-profile-btn--admin": staffPreview },
            ]}
            aria-label={staffPreview ? "Admin account (signed in)" : "Account menu"}
            title={staffPreview ? "Signed in as admin" : "Account menu"}
            aria-expanded="false"
            aria-haspopup="true"
          >
            {staffPreview ? (
              <>
                <Shield size={16} strokeWidth={2} aria-hidden="true" />
                <span class="topbar-admin-label">Admin</span>
              </>
            ) : (
              <img
                src={profileIconSrc}
                alt=""
                class="topbar-profile-icon-img"
                aria-hidden="true"
                loading="eager"
                decoding="async"
              />
            )}
          </button>
          <span id="topbar-review-badge" class="topbar-badge" hidden>0</span>
          <div id="topbar-profile-menu" class="app-header-dropdown topbar-dropdown" role="menu">
            {staffPreview && (
              <div class="topbar-dropdown-admin-note" role="presentation">
                Viewing as admin
              </div>
            )}
            <a href="/admin/profile" class="topbar-dropdown-item" role="menuitem">Profile</a>
            <a href="/admin/components" class="topbar-dropdown-item" role="menuitem">Components</a>
            <a href="/admin/" class="topbar-dropdown-item" role="menuitem">
              <span class="topbar-dropdown-icon" aria-hidden="true"><LayoutDashboard size={16} strokeWidth={1.75} /></span>
              <span>Administration</span>
            </a>
            <div class="topbar-dropdown-divider"></div>
            <button type="button" id="topbar-sign-out" class="topbar-dropdown-item topbar-dropdown-item--danger" role="menuitem">
              Sign out
            </button>
          </div>
        </div>
        </div>
      ))}

  </div>

  {adminShell && (
    <time id="topbar-dash-date" class="topbar-dash-date" datetime="" hidden></time>
  )}
  </div>

  {adminShell && (
    <div id="topbar-sleep-toggle" class="topbar-sleep-toggle" hidden>
      <span id="topbar-sleep-toggle-label" class="topbar-sleep-toggle-label">Sleeping until 7:00 AM</span>
      <button
        type="button"
        id="topbar-sleep-toggle-btn"
        class="topbar-sleep-toggle-switch"
        role="switch"
        aria-checked="true"
        aria-label="Sleep mode"
      ></button>
    </div>
  )}

  {adminShell && (
    <div id="admin-setup-alerts" class="admin-setup-alerts" hidden aria-live="polite"></div>
  )}
</header>

{!userId && (
  <SignInSheet
    fallbackRedirectUrl={signInRedirect}
    autoOpen={signInAutoOpen && !showMarketingNav}
    authPath="/sign-in"
  />
)}

{userId && (
  <script is:inline src={`/review-badge.js?v=${__PUBLIC_ASSET_VERSION__}`} defer></script>
)}
<script is:inline src={`/deploy-indicator.js?v=${__PUBLIC_ASSET_VERSION__}`} defer></script>

<script>
  /** iOS can report 0 for env(safe-area-inset-top) on fixed shells — probe and pin px when needed. */
  function syncAppHeaderSafeArea() {
    const probe = document.createElement("div");
    probe.style.cssText =
      "position:fixed;top:0;left:0;height:0;padding-top:env(safe-area-inset-top,0px);pointer-events:none;visibility:hidden;";
    document.documentElement.appendChild(probe);
    const insetTop = parseFloat(getComputedStyle(probe).paddingTop) || 0;
    probe.remove();
    if (insetTop > 0) {
      document.documentElement.style.setProperty("--safe-top", `${insetTop}px`);
    }
  }

  /** Keep pane clearance aligned with the visible header band (row bottom + setup alerts). */
  function syncTopbarMeasuredHeight() {
    const topbar = document.getElementById("topbar");
    if (!topbar) return;
    const alerts = document.getElementById("admin-setup-alerts");
    let clearance = 0;
    if (alerts && !alerts.hidden) {
      clearance = Math.ceil(alerts.getBoundingClientRect().bottom);
    } else {
      const row = topbar.querySelector(".app-header-row");
      clearance = row
        ? Math.ceil(row.getBoundingClientRect().bottom)
        : Math.ceil(topbar.getBoundingClientRect().bottom);
    }
    document.documentElement.style.setProperty("--topbar-measured-h", `${clearance}px`);
  }

  function bindTopbarHeightObserver() {
    const topbar = document.getElementById("topbar");
    if (!topbar || topbar.dataset.topbarHeightObs === "1") return;
    topbar.dataset.topbarHeightObs = "1";
    syncTopbarMeasuredHeight();
    const obs = new ResizeObserver(() => syncTopbarMeasuredHeight());
    obs.observe(topbar);
    window.visualViewport?.addEventListener("resize", syncTopbarMeasuredHeight, { passive: true });
  }

  syncAppHeaderSafeArea();
  bindTopbarHeightObserver();
  document.addEventListener("astro:page-load", () => {
    syncAppHeaderSafeArea();
    bindTopbarHeightObserver();
    syncTopbarMeasuredHeight();
  });
  window.visualViewport?.addEventListener("resize", syncAppHeaderSafeArea, { passive: true });
</script>

<style is:global>
  :root {
    --app-header-h: 3.25rem;
    --safe-top: env(safe-area-inset-top, 0px);
    --app-header-offset: calc(var(--app-header-h) + var(--safe-top));
    /* Chrome band plus the tail the scrim fades out over, below the bar. */
    --app-header-scrim-h: calc(var(--safe-top) + var(--app-header-h) + 3.75rem);
    --app-header-chrome-scale: 1.333;
    --app-header-logo-h: calc(24px * var(--app-header-chrome-scale));
    --app-header-profile-h: calc(24px * var(--app-header-chrome-scale));
    --app-header-profile-icon-h: calc(16px * var(--app-header-chrome-scale));
    --app-header-signin-h: calc(32px * var(--app-header-chrome-scale));
    --app-header-signin-icon-h: calc(18px * var(--app-header-chrome-scale));
    --app-header-icon-btn-h: calc(36px * var(--app-header-chrome-scale));
    --app-header-icon-btn-icon-h: calc(18px * var(--app-header-chrome-scale));
    --radius-input: 8px;
    --control-h: 2.5rem;
    --footer-nav-pill-h: var(--control-h);
    --footer-nav-glass-border: 1px solid rgba(0, 0, 0, 0.08);
    --footer-nav-glass-bg: transparent;
    --footer-nav-glass-blur: blur(18px) saturate(1.15);
    --nav-icon: rgba(0, 0, 0, 0.45);
    --nav-icon-hover: rgba(0, 0, 0, 0.72);
    --nav-icon-active: #0f172a;
    /*
     * --dropdown-bg / --dropdown-shadow are intentionally NOT declared here.
     * This block and the admin shell's <style> (src/pages/admin/index.astro)
     * both target :root with equal specificity, and this component's style
     * ends up later in the cascade — so a value declared here always beat
     * the admin shell's light/dark-aware override, pinning the profile
     * dropdown to dark even on a light-themed admin page. Pages that don't
     * define these variables (the dark-only marketing site, client portal)
     * still get the correct dark look via the `var(--x, <fallback>)` used at
     * the point of use below — only the admin shell (which needs both
     * themes) actually needs to own this variable.
     */
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --footer-nav-glass-border: 1px solid rgba(255, 255, 255, 0.08);
      --nav-icon: rgba(255, 255, 255, 0.58);
      --nav-icon-hover: rgba(255, 255, 255, 0.88);
      --nav-icon-active: #ffffff;
    }
  }

  /*
   * Public/marketing headers are fixed at the layout viewport top. Do not sync
   * visualViewport.offsetTop into `top` — that shove is what clipped the bar
   * during Safari/macOS rubber-band overscroll. Layout html uses
   * overscroll-behavior-y: none so the fixed chrome stays put.
   */

  .app-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
    --app-header-inline-pad: max(0.5rem, env(safe-area-inset-left, 0px));
    padding:
      env(safe-area-inset-top, 0px)
      var(--app-header-inline-pad)
      0
      var(--app-header-inline-pad);
    pointer-events: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .app-header--admin {
    z-index: 20;
    background: transparent;
    border-bottom: none;
  }

  /*
   * Safe-area padding lives on the fixed shell (above). The row only sizes the
   * interactive chrome band below the notch / Dynamic Island.
   */
  .app-header-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: var(--app-header-h);
    padding: 0;
    position: relative;
    overflow: visible;
    z-index: 1;
  }

  /*
   * Public headers are fixed and transparent, so page content scrolls under the
   * logo and nav. The scrim blurs it out: stacked backdrop-filter layers with
   * masks that ramp blur toward the top (radii compound across layers). Admin
   * is excluded — its panes pad below the bar and notice cards live in-header.
   */
  .app-header:not(.app-header--admin) > .app-header-scrim {
    position: absolute;
    top: calc(-1 * env(safe-area-inset-top, 0px));
    left: calc(-1 * var(--app-header-inline-pad));
    right: calc(-1 * var(--app-header-inline-pad));
    height: var(--app-header-scrim-h);
    z-index: 0;
    pointer-events: none;
  }

  .app-header-scrim-blur {
    position: absolute;
    inset: 0;
    /* Safari needs a painted surface before backdrop-filter composites. */
    background: rgba(0, 0, 0, 0.001);
    transform: translateZ(0);
    -webkit-mask-image: var(--app-header-scrim-mask);
    mask-image: var(--app-header-scrim-mask);
  }

  /* Soft progressive blur: each layer starts later and adds a small radius so
   * content going under the bar eases out instead of snapping into heavy blur. */
  .app-header-scrim-blur:nth-child(1) {
    --app-header-scrim-mask: linear-gradient(
      to top,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 22%,
      #000 55%,
      #000 100%
    );
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  .app-header-scrim-blur:nth-child(2) {
    --app-header-scrim-mask: linear-gradient(
      to top,
      transparent 18%,
      rgba(0, 0, 0, 0.4) 42%,
      #000 72%,
      #000 100%
    );
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .app-header-scrim-blur:nth-child(3) {
    --app-header-scrim-mask: linear-gradient(
      to top,
      transparent 40%,
      rgba(0, 0, 0, 0.45) 68%,
      #000 92%,
      #000 100%
    );
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
  }

  .app-header--admin::before {
    content: none;
  }

  .app-header--admin .app-header-row > * {
    position: relative;
    z-index: 1;
  }

  .app-header--admin .app-header-row .topbar-end {
    margin-left: auto;
  }

  .topbar-panel-context {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
    margin-left: 0.15rem;
    overflow: hidden;
  }

  .topbar-panel-context[hidden] {
    display: none !important;
  }

  .topbar-panel-context .topbar-panel-title {
    flex: 1;
    min-width: 0;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .topbar-panel-context .ch-model-badge,
  .topbar-panel-context .ch-model-switcher {
    margin-left: 0;
    flex-shrink: 0;
  }

  .topbar-panel-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    margin-left: 0.15rem;
  }
  .topbar-end .topbar-panel-actions {
    margin-left: 0;
  }
  /* Match panel action buttons to topbar icon-btn size (ios-icon-btn defaults to 44px). */
  .app-header--admin .topbar-end .topbar-panel-actions .ios-icon-btn {
    width: var(--app-header-icon-btn-h);
    height: var(--app-header-icon-btn-h);
  }
  .app-header--admin .topbar-end .topbar-panel-actions .ios-icon-btn svg {
    width: var(--app-header-icon-btn-icon-h);
    height: var(--app-header-icon-btn-icon-h);
  }

  .app-header--admin.topbar-has-panel-context .topbar-dash-date,
  .app-header--admin.topbar-has-panel-context .topbar-sleep-toggle {
    display: none !important;
  }

  .topbar-sleep-toggle {
    position: absolute;
    left: 50%;
    top: calc(var(--safe-top) + var(--app-header-h) / 2);
    transform: translate(-50%, -50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: min(78vw, 20rem);
    padding: 0.22rem 0.55rem 0.22rem 0.75rem;
    border-radius: 999px;
    border: var(--footer-nav-glass-border, 1px solid rgba(255, 255, 255, 0.08));
    background: var(--footer-nav-glass-bg, rgba(18, 23, 34, 0.72));
    backdrop-filter: var(--footer-nav-glass-blur, blur(18px) saturate(1.15));
    -webkit-backdrop-filter: var(--footer-nav-glass-blur, blur(18px) saturate(1.15));
    pointer-events: auto;
  }

  .topbar-sleep-toggle[hidden] {
    display: none !important;
  }

  .topbar-sleep-toggle-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--muted, rgba(255, 255, 255, 0.62));
    white-space: nowrap;
    user-select: none;
  }

  .topbar-sleep-toggle-switch {
    flex-shrink: 0;
    width: 2.35rem;
    height: 1.35rem;
    border: none;
    border-radius: 999px;
    background: var(--panel-border, rgba(255, 255, 255, 0.18));
    position: relative;
    cursor: pointer;
    padding: 0;
    transition: background 0.15s, opacity 0.15s;
  }

  .topbar-sleep-toggle-switch::after {
    content: '';
    position: absolute;
    top: 0.12rem;
    left: 0.12rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.15s;
  }

  .topbar-sleep-toggle-switch[aria-checked='true'] {
    background: #6366f1;
  }

  .topbar-sleep-toggle-switch[aria-checked='true']::after {
    transform: translateX(1rem);
  }

  .topbar-sleep-toggle-switch:disabled {
    opacity: 0.55;
    cursor: wait;
  }

  .app-header--admin.topbar-has-panel-context .topbar-end {
    margin-left: 0;
  }

  .app-header > *,
  .app-header-row > * {
    pointer-events: auto;
  }

  .app-header-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    line-height: 0;
    text-decoration: none;
  }

  .app-header-logo-clip {
    display: flex;
    align-items: center;
    height: var(--app-header-logo-h);
    max-width: min(42vw, 280px);
  }

  .app-header-logo-clip :global(svg) {
    filter: var(--brand-glow-filter);
  }

  .app-header-logo-img {
    display: block;
    height: var(--app-header-logo-h);
    width: auto;
    max-width: 100%;
  }

  .app-header-logo-svg {
    display: block;
    height: var(--app-header-logo-h);
    width: calc(var(--app-header-logo-h) * (926.878 / 262.015));
  }

  .app-header--portal-brand .topbar-profile-btn--admin {
    background: rgba(var(--portal-primary-rgb, 168, 85, 247), 0.14);
    color: var(--portal-accent, #e9d5ff);
  }

  .app-header--portal-brand .topbar-profile-btn--admin:hover,
  .app-header--portal-brand .topbar-profile-menu:has(.topbar-dropdown.open) .topbar-profile-btn--admin {
    background: rgba(var(--portal-primary-rgb, 168, 85, 247), 0.22);
    color: #fff;
  }

  .topbar-dash-date {
    flex-shrink: 0;
    margin-left: 0;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted, rgba(255, 255, 255, 0.55));
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-align: right;
  }

  .app-header--admin:not(.topbar-has-panel-context):not(:has(.app-header-row .topbar-end .topbar-icon-btn:not([hidden]))) .topbar-dash-date:not([hidden]) {
    position: absolute;
    right: max(0.65rem, env(safe-area-inset-right, 0px));
    top: calc(var(--safe-top) + var(--app-header-h) / 2);
    transform: translateY(-50%);
  }

  .topbar-dash-date[hidden] {
    display: none !important;
  }

  .app-header-end,
  .topbar-end {
    display: flex;
    align-items: center;
