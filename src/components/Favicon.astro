---
/**
 * Universal favicon links — single source of truth for every page.
 * Icons are rasterized at request time from admin PNG/SVG branding, or the
 * first letter of the company name when nothing is configured.
 */
import { getCompanyConfig, companyFaviconUrls } from "../lib/companyConfig";
import { getSiteContent, siteLandingFaviconUrls } from "../lib/siteContent";

const company = await getCompanyConfig(Astro.request);
const siteContent = getSiteContent();
const siteFavicons = siteLandingFaviconUrls(siteContent);
const favicons = siteFavicons ?? companyFaviconUrls(company);
---

{favicons.svg && <link rel="icon" href={favicons.svg} type="image/svg+xml" />}
<link rel="icon" type="image/png" sizes="32x32" href={favicons.png32} />
<link rel="icon" type="image/png" sizes="16x16" href={favicons.png16} />
<link rel="apple-touch-icon" type="image/png" sizes="180x180" href={favicons.appleTouchIcon} />
