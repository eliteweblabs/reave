  { id: "v-bottom", d: "M634.176,200.499c3.21.635,9.772-11.877,12.806-16.889,21.215-36.272,49.098-84.07,70.294-120.302,5.265-9.073,9.305-15.677,10.864-19.739,2.145-5.589-1.081-6.292-6.244-6.762-41.177-.787-121.816-.016-163.181-.283-4.204-.005-9.018.035-12.636.311-5.229.473-8.192,1.477-5.672,7.326,22.14,40.427,55.734,95.567,79.31,136.687,3.468,5.609,10.995,20.385,14.421,19.65h.038Z" },
