  { id: "r", d: "M40.58,226.774c-2.548-1.756-2.095-4.854-2.35-7.45-.164-6.849-.046-19.225-.083-34.496.03-46.424-.062-119.108.048-140.191-.09-5.579,1.672-8.406,9.635-8.617,21.893-.643,49.358-.143,72.205-.292,41.202-.163,78.199-.775,102.02,27.544,11.096,14.365,14.276,33.712,8.513,50.07-11.282,31.842-55.809,28.874-44.715,46.531,11.964,17.476,30.917,38.465,43.647,54.966,5.616,7.058,8.176,10.658,6.035,12.035-37.749,3.106-146.68.164-183.456,1.137-4.218-.05-8.439.169-11.401-1.18l-.099-.058h.002-.002Z" },
