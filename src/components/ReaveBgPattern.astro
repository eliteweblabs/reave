---
/**
 * Full REΛVE chevron pattern artwork (not a CSS tile repeat).
 * Inline SVG keeps every path in the DOM for per-element styling/animation.
 * Scales uniformly via preserveAspectRatio — never stretch x/y independently.
 */
import { renderReaveBgPatternSvg, type ReaveBgPatternFit } from '../lib/reaveBgPatternSvg';

interface Props {
  class?: string;
  opacity?: number;
  /** contain = full pattern visible; cover = fill the box uniformly (may crop). */
  fit?: ReaveBgPatternFit;
}

const { class: className = '', opacity, fit = 'contain' } = Astro.props;
const style = opacity != null ? `opacity: ${opacity}` : undefined;
const svg = renderReaveBgPatternSvg(fit);
---

<div class:list={['reave-bg-pattern', className]} style={style} aria-hidden="true">
  <Fragment set:html={svg} />
</div>
