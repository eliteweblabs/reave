---
/**
 * Tiled REΛVE chevron background — CSS only (no JS, no inline SVG scale hacks).
 * Document flow (absolute on body); size via --reave-bg-pattern-tile (default 400%).
 */
interface Props {
  class?: string;
  /** Uniform tile size, e.g. "256px". Defaults to --reave-bg-pattern-tile. */
  tileSize?: string;
  opacity?: number;
}

const { class: className = "", tileSize, opacity } = Astro.props;

const styleParts: string[] = [];
if (tileSize) styleParts.push(`--reave-bg-pattern-tile: ${tileSize}`);
if (opacity != null) styleParts.push(`opacity: ${opacity}`);
const style = styleParts.length > 0 ? styleParts.join("; ") : undefined;
---

<div class:list={["reave-bg-pattern", className]} aria-hidden="true" style={style}></div>
