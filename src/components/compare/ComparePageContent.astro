---
/**
 * Compare page — interactive top-down flow: industry waste → features → cost.
 */
import { ArrowRight, Check, Minus, X } from "lucide-astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import {
  COMPARE_FLOW_STEPS,
  COMPARE_MATRIX,
  COMPARE_SOURCES,
  COST_SCENARIOS,
  CUSTOM_PAIN,
  LICENSE_BREAKDOWN,
  MONEY_STATS,
  PROBLEM_HEADLINES,
  REAVE_WINS,
  SAAS_PAIN,
  SOLUTION_HEADLINES,
  WASTE_SPECTRUM,
  type CompareIndicator,
} from "../../lib/comparePageData";

const company = await getCompanyConfig(Astro.request);
const supportMail = company.supportEmail || (company.domain ? `hello@${company.domain}` : "");
const quoteHref = supportMail ? `mailto:${supportMail}` : "/schedule";

function indicatorIcon(ind: CompareIndicator) {
  if (ind === "strong") return Check;
  if (ind === "mixed") return Minus;
  return X;
}

function indicatorLabel(ind: CompareIndicator): string {
  if (ind === "strong") return "Strong";
  if (ind === "mixed") return "Mixed";
  return "Weak";
}

const flowData = {
  companyName: company.name,
  licenseBreakdown: LICENSE_BREAKDOWN,
  wasteSpectrum: WASTE_SPECTRUM,
  moneyStats: MONEY_STATS,
  compareMatrix: COMPARE_MATRIX,
  costScenarios: COST_SCENARIOS,
};
---

<div class="cmp-page">
  <section class="cmp-hero scroll-fade-in" aria-labelledby="compare-title">
    <p class="cmp-kicker">Compare</p>
    <h1 id="compare-title" class="cmp-h1">
      Box-stock SaaS. Bespoke builds. There's a third way.
    </h1>
    <p class="cmp-lead">
      Most businesses land on one of two bad options: a pile of disconnected subscriptions
      nobody fully uses, or a six-figure custom build that takes months to ship.{" "}
      {company.name} is the operating system in the middle — complete on day one, tailored
      where it counts.
    </p>
    <div class="cmp-cta-row">
      <a class="cmp-btn cmp-btn--primary" href="/demo">
        Demo now
        <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
      </a>
      <a class="cmp-btn cmp-btn--ghost brand-btn-glass" href="/pricing">See pricing</a>
    </div>
  </section>

  <div id="compare-flow" class="cmp-flow scroll-fade-in" data-cmp-flow>
    <nav class="cmp-flow-nav" aria-label="Compare sections">
      {
        COMPARE_FLOW_STEPS.map((step, i) => (
          <button
            type="button"
            class:list={["cmp-flow-nav__btn", i === 0 && "cmp-flow-nav__btn--active"]}
            data-cmp-nav={step.id}
            aria-current={i === 0 ? "step" : "false"}
          >
            <span class="cmp-flow-nav__num">{i + 1}</span>
            {step.label}
          </button>
        ))
      }
    </nav>

    <div class="cmp-flow-body">
      <div class="cmp-flow-spine-wrap" data-cmp-spine-wrap aria-hidden="true">
        <div class="cmp-flow-spine" data-cmp-spine></div>
      </div>

      <div class="cmp-flow-panels">
        <!-- 1: Overspending -->
        <section
          id="cmp-panel-waste"
          class="cmp-flow-panel cmp-flow-step cmp-flow-step--active"
          data-cmp-step="waste"
          aria-labelledby="waste-title"
        >
          <p class="cmp-section-kicker cmp-section-kicker--warn">The problem</p>
          <h2 id="waste-title" class="cmp-h2">Overspending on SaaS.</h2>
          <p class="cmp-section-lead">
            More apps, more seats, more invoices — and a growing share of spend that never
            converts to outcomes.
          </p>

          <div class="cmp-callout cmp-callout--inline">
            <p class="cmp-callout-stat">65%</p>
            <p class="cmp-callout-text">
              of SaaS licenses are unused or underutilized — waste grows fastest at the
              largest companies.
            </p>
            <p class="cmp-callout-source">Vertice Q2 2026 · $75B+ processed spend</p>
          </div>

          <div class="cmp-money-grid">
            {
              MONEY_STATS.map((s) => (
                <div class="cmp-money-card">
                  <p class="cmp-money-value">{s.value}</p>
                  <p class="cmp-money-label">{s.label}</p>
                  <p class="cmp-money-source">{s.source}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- 2: Under-utilization -->
        <section
          id="cmp-panel-utilization"
          class="cmp-flow-panel cmp-flow-step"
          data-cmp-step="utilization"
          aria-labelledby="utilization-title"
        >
          <p class="cmp-section-kicker">License utilization</p>
          <h2 id="utilization-title" class="cmp-h2">Under-utilization — where dollars go.</h2>
          <p class="cmp-section-lead">
            Vertice tracks shelfware separately from underutilization — tools that are active
            but paying for far more seats than anyone uses.
          </p>

          <div class="cmp-donut-block">
            <div class="cmp-donut-row">
              <div class="cmp-donut" data-cmp-donut role="img" aria-label="License utilization donut chart"></div>
              <ul class="cmp-legend">
                {
                  LICENSE_BREAKDOWN.map((seg) => (
                    <li>
                      <button
                        type="button"
                        class={`cmp-legend__btn cmp-legend--${seg.tone}`}
                        data-cmp-seg={seg.id}
                      >
                        <span class="cmp-legend__swatch" />
                        <span class="cmp-legend__pct">{seg.pct}%</span>
                        <span class="cmp-legend__label">{seg.label}</span>
                      </button>
                    </li>
                  ))
                }
              </ul>
            </div>
            <p class="cmp-seg-detail" data-cmp-seg-detail>
              Click a segment or legend item for detail. Vertice Q2 2026 · 65% total waste.
            </p>
          </div>
        </section>

        <!-- 3: Waste spectrum -->
        <section
          id="cmp-panel-spectrum"
          class="cmp-flow-panel cmp-flow-step"
          data-cmp-step="spectrum"
          aria-labelledby="spectrum-title"
        >
          <p class="cmp-section-kicker cmp-section-kicker--warn">The waste spectrum</p>
          <h2 id="spectrum-title" class="cmp-h2">The problem gets worse as you scale.</h2>
          <p class="cmp-section-lead">
            Click a tier to explore how waste compounds — from shelfware to app-switching fatigue.
          </p>

          <div class="cmp-spectrum-layout">
            <ol class="cmp-tier-list cmp-tier-list--open">
              {
                WASTE_SPECTRUM.map((tier) => (
                  <li>
                    <button
                      type="button"
                      class={`cmp-tier cmp-tier--${tier.severity.toLowerCase()}`}
                      data-cmp-tier={tier.id}
                    >
                      <span class="cmp-tier__meta">
                        <span class="cmp-tier__severity">{tier.severity}</span>
                        <span class="cmp-tier__theme">{tier.theme}</span>
                      </span>
                      <span class="cmp-tier__headline">{tier.headline}</span>
                      <span class="cmp-tier__stat">{tier.stat}</span>
                    </button>
                  </li>
                ))
              }
            </ol>

            <div class="cmp-detail-panel" data-cmp-detail>
              <p class="cmp-detail-kicker">Select a tier</p>
              <p class="cmp-detail-headline">Explore how waste compounds as you scale.</p>
              <p class="cmp-detail-body">
                From shelfware licenses to shadow IT sprawl — each layer adds cost without
                adding capability.
              </p>
            </div>
          </div>
        </section>

        <!-- 4: Three paths -->
        <section
          id="cmp-panel-paths"
          class="cmp-flow-panel cmp-flow-step"
          data-cmp-step="paths"
          aria-labelledby="paths-title"
        >
          <p class="cmp-section-kicker cmp-section-kicker--center">Left · center · right</p>
          <h2 id="paths-title" class="cmp-h2 cmp-h2--center">Three paths. One sweet spot.</h2>
          <p class="cmp-section-lead cmp-section-lead--center">
            Sign up fast and pay forever. Build from scratch and wait half a year. Or ship a
            complete Business OS and bolt on the last 10%.
          </p>

          <div class="cmp-three-col">
            <article class="cmp-col cmp-col--saas">
              <header class="cmp-col-head">
                <p class="cmp-col-tag">Left</p>
                <h3 class="cmp-col-title">Box-stock SaaS</h3>
                <p class="cmp-col-sub">The stack</p>
              </header>
              <p class="cmp-col-desc">
                HubSpot, QuickBooks, Calendly, Slack, DocuSign, Mailchimp — a dozen logins,
                none of them talking to each other.
              </p>
              <dl class="cmp-col-stats">
                <div>
                  <dt>Typical monthly</dt>
                  <dd>$500–2K+</dd>
                </div>
                <div>
                  <dt>Apps per org</dt>
                  <dd>101 avg.</dd>
                </div>
              </dl>
              <ul class="cmp-pain-list">
                {
                  SAAS_PAIN.map((p) => (
                    <li>
                      <span class="cmp-pain-key">{p.label}</span>
                      <span class="cmp-pain-val">{p.value}</span>
                    </li>
                  ))
                }
              </ul>
              <p class="cmp-col-tagline">Sign up fast. Pay forever. Nothing syncs.</p>
            </article>

            <article class="cmp-col cmp-col--reave">
              <header class="cmp-col-head">
                <p class="cmp-col-tag cmp-col-tag--highlight">Center</p>
                <h3 class="cmp-col-title">{company.name}</h3>
                <p class="cmp-col-sub">The Business OS</p>
              </header>
              <p class="cmp-col-desc">
                90% of what you need on day zero. The last 10% is whatever makes this client
                uniquely theirs — bolted on, not rebuilt.
              </p>
              <dl class="cmp-col-stats">
                <div>
                  <dt>Steady state</dt>
                  <dd>$250–625/mo</dd>
                </div>
                <div>
                  <dt>Install ramp</dt>
                  <dd>$2K–5K mo 1</dd>
                </div>
              </dl>
              <ul class="cmp-win-list">
                {
                  REAVE_WINS.map((w) => (
                    <li>
                      <Check size={14} strokeWidth={2.5} aria-hidden="true" />
                      {w}
                    </li>
                  ))
                }
              </ul>
              <p class="cmp-col-tagline">Not a blank canvas. Not a $100K build.</p>
            </article>

            <article class="cmp-col cmp-col--custom">
              <header class="cmp-col-head">
                <p class="cmp-col-tag">Right</p>
                <h3 class="cmp-col-title">Bespoke development</h3>
                <p class="cmp-col-sub">The agency build</p>
              </header>
              <p class="cmp-col-desc">
                Custom CRM, portal, and integrations from scratch — perfect fit, long timeline,
                unpredictable maintenance.
              </p>
              <dl class="cmp-col-stats">
                <div>
                  <dt>Typical build</dt>
                  <dd>$40K–100K</dd>
                </div>
                <div>
                  <dt>Timeline</dt>
                  <dd>3–6 months</dd>
                </div>
              </dl>
              <ul class="cmp-pain-list">
                {
                  CUSTOM_PAIN.map((p) => (
                    <li>
                      <span class="cmp-pain-key">{p.label}</span>
                      <span class="cmp-pain-val">{p.value}</span>
                    </li>
                  ))
                }
              </ul>
              <p class="cmp-col-tagline">Built for you. Billed like you'd expect.</p>
            </article>
          </div>
        </section>

        <!-- 5: 90/10 model -->
        <section
          id="cmp-panel-model"
          class="cmp-flow-panel cmp-flow-step"
          data-cmp-step="model"
          aria-labelledby="model-title"
        >
          <p class="cmp-section-kicker">90 / 10</p>
          <h2 id="model-title" class="cmp-h2">Complete on day one. Custom where it counts.</h2>
          <p class="cmp-section-lead">
            Most platforms hand you a blank canvas and a monthly bill. {company.name} ships a
            complete operating system — contacts, portal, billing, inbox, AI, mobile — and snaps
            industry-specific pieces onto the same core.
          </p>

          <div
            class="cmp-ninety-meter"
            role="img"
            aria-label="90 percent core platform, 10 percent custom bolt-ons"
          >
            <div class="cmp-ninety-core">
              <span class="cmp-ninety-pct">90%</span>
              <span class="cmp-ninety-name">Core OS</span>
              <span class="cmp-ninety-detail">CRM · Portal · Billing · Inbox · AI · Mobile</span>
            </div>
            <div class="cmp-ninety-custom">
              <span class="cmp-ninety-pct">+10%</span>
              <span class="cmp-ninety-name">Bolt-ons</span>
              <span class="cmp-ninety-detail">Industry plugins · Custom flows</span>
            </div>
          </div>
        </section>

        <!-- 6: Feature matrix -->
        <section
          id="cmp-panel-matrix"
          class="cmp-flow-panel cmp-flow-step"
          data-cmp-step="matrix"
          aria-labelledby="matrix-title"
        >
          <p class="cmp-section-kicker">Feature matrix</p>
          <h2 id="matrix-title" class="cmp-h2">Side by side.</h2>
          <p class="cmp-section-lead">
            Hover or click a column header to highlight. Every dimension that matters when you're
            choosing between stack, OS, or build.
          </p>

          <div class="cmp-table-wrap" data-cmp-matrix>
            <table class="cmp-table">
              <thead>
                <tr>
                  <th scope="col">Dimension</th>
                  <th scope="col" data-cmp-col="saas" class="cmp-table-col">Box SaaS</th>
                  <th scope="col" data-cmp-col="reave" class="cmp-table-col cmp-table-col--reave">{company.name}</th>
                  <th scope="col" data-cmp-col="custom" class="cmp-table-col">Custom dev</th>
                </tr>
              </thead>
              <tbody>
                {
                  COMPARE_MATRIX.map((row) => {
                    const SaasIcon = indicatorIcon(row.saas);
                    const ReaveIcon = indicatorIcon(row.reave);
                    const CustomIcon = indicatorIcon(row.custom);
                    return (
                      <tr>
                        <th scope="row">{row.dimension}</th>
                        <td data-cmp-cell="saas">
                          <span class={`cmp-ind cmp-ind--${row.saas}`}>
                            <SaasIcon size={12} strokeWidth={2.5} aria-hidden="true" />
                            <span class="sr-only">{indicatorLabel(row.saas)}</span>
                          </span>
                          {row.saasNote}
                        </td>
                        <td data-cmp-cell="reave" class="cmp-table-reave">
                          <span class={`cmp-ind cmp-ind--${row.reave}`}>
                            <ReaveIcon size={12} strokeWidth={2.5} aria-hidden="true" />
                            <span class="sr-only">{indicatorLabel(row.reave)}</span>
                          </span>
                          {row.reaveNote}
                        </td>
                        <td data-cmp-cell="custom">
                          <span class={`cmp-ind cmp-ind--${row.custom}`}>
                            <CustomIcon size={12} strokeWidth={2.5} aria-hidden="true" />
                            <span class="sr-only">{indicatorLabel(row.custom)}</span>
                          </span>
                          {row.customNote}
                        </td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>
        </section>

        <!-- 7: Cost comparison -->
        <section
          id="cmp-panel-cost"
          class="cmp-flow-panel cmp-flow-step"
          data-cmp-step="cost"
          aria-labelledby="cost-title"
        >
          <p class="cmp-section-kicker cmp-section-kicker--cost">Total cost of ownership</p>
          <h2 id="cost-title" class="cmp-h2">Three-year math (typical small business).</h2>
          <p class="cmp-section-lead">
            SaaS looks cheap until you multiply by headcount, duplicates, and waste. Custom
            looks perfect until maintenance invoices arrive. {company.name} flattens the curve.
          </p>

          <div class="cmp-cost-chart" data-cmp-cost-chart role="img" aria-label="Three-year cost comparison chart"></div>

          <div class="cmp-cost-grid">
            {
              COST_SCENARIOS.map((s) => (
                <article class={`cmp-cost-card cmp-cost-card--${s.tone}`}>
                  <h3 class="cmp-cost-label">{s.label}</h3>
                  <dl class="cmp-cost-numbers">
                    <div>
                      <dt>Year 1</dt>
                      <dd>{s.year1}</dd>
                    </div>
                    <div>
                      <dt>3-year total</dt>
                      <dd>{s.year3}</dd>
                    </div>
                  </dl>
                  <p class="cmp-cost-note">{s.note}</p>
                </article>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </div>

  <section class="cmp-section scroll-fade-in" aria-labelledby="headlines-title">
    <p class="cmp-section-kicker">Copy-ready</p>
    <h2 id="headlines-title" class="cmp-h2">Headlines for decks and ads.</h2>

    <div class="cmp-headline-grid">
      <div class="cmp-headline-col">
        <h3 class="cmp-h3">The problem</h3>
        <ul class="cmp-headline-list">
          {PROBLEM_HEADLINES.map((h) => <li>&ldquo;{h}&rdquo;</li>)}
        </ul>
      </div>
      <div class="cmp-headline-col cmp-headline-col--solution">
        <h3 class="cmp-h3">The answer</h3>
        <ul class="cmp-headline-list">
          {SOLUTION_HEADLINES.map((h) => <li>&ldquo;{h}&rdquo;</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="cmp-closing scroll-fade-in" aria-label="Next steps">
    <h2 class="cmp-h2 cmp-h2--center">See the OS in action.</h2>
    <p class="cmp-closing-lead">
      Walk through contacts, portal, billing, and the AI agent on a live demo — or book
      a call to map your install tier.
    </p>
    <div class="cmp-cta-row">
      <a class="cmp-btn cmp-btn--primary" href="/demo">
        Demo now
        <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
      </a>
      <a class="cmp-btn cmp-btn--ghost brand-btn-glass" href={quoteHref}>Get a quote</a>
      <a class="cmp-btn cmp-btn--ghost brand-btn-glass" href="/features">Full platform tour</a>
    </div>
  </section>

  <footer class="cmp-sources scroll-fade-in" aria-label="Data sources">
    <p class="cmp-sources-title">Sources</p>
    <ul class="cmp-sources-list">
      {COMPARE_SOURCES.map((s) => <li>{s}</li>)}
    </ul>
    <p class="cmp-note">
      Figures vary by methodology (unused vs. underutilized vs. shadow spend). Prefer
      ranges over false precision in external materials.
    </p>
  </footer>
</div>

<script define:vars={{ flowData }}>
  import { initCompareFlow, enrichCostScenarios } from "../../scripts/compare-flow.ts";

  const root = document.getElementById("compare-flow");
  if (root) {
    initCompareFlow(root, {
      ...flowData,
      costScenarios: enrichCostScenarios(flowData.costScenarios),
    });
  }
</script>

<style>
  .cmp-page {
    min-height: 100vh;
    padding: calc(64px + 40px) 20px 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cmp-hero,
  .cmp-flow,
  .cmp-section,
  .cmp-closing,
  .cmp-sources {
    width: 100%;
    max-width: 1080px;
  }

  .cmp-hero {
    text-align: center;
    margin-bottom: 32px;
    max-width: 760px;
  }

  .cmp-kicker,
  .cmp-section-kicker,
  .cmp-col-tag,
  .cmp-sources-title,
  .cmp-viz-label {
    font-family: var(--font-secondary);
  }

  .cmp-lead,
  .cmp-section-lead,
  .cmp-col-desc,
  .cmp-closing-lead {
    font-family: var(--font-content);
  }

  .cmp-kicker {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a855f7;
    margin: 0 0 14px;
  }

  .cmp-h1 {
    margin: 0 0 16px;
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: #fff;
  }

  .cmp-h2 {
    margin: 0 0 12px;
    font-size: clamp(1.35rem, 3.8vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #fff;
  }

  .cmp-h2--center {
    text-align: center;
  }

  .cmp-h3 {
    margin: 0 0 12px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
  }

  .cmp-lead,
  .cmp-section-lead {
    margin: 0 0 28px;
    font-size: 1.02rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.68);
  }

  .cmp-lead {
    margin-left: auto;
    margin-right: auto;
    max-width: 580px;
  }

  .cmp-section-lead--center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    max-width: 620px;
  }

  .cmp-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .cmp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, filter 0.15s ease;
    white-space: nowrap;
  }

  .cmp-btn--primary {
    color: #0b0512;
    background: linear-gradient(145deg, #f472b6 0%, #c026d3 52%, #6366f1 100%);
    box-shadow: 0 8px 24px rgba(192, 38, 211, 0.35);
  }

  .cmp-btn--primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .cmp-btn--ghost:hover {
    transform: translateY(-1px);
  }

  /* ── Interactive flow shell ── */
  .cmp-flow {
    margin-bottom: 56px;
  }

  .cmp-flow-nav {
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    justify-content: flex-start;
    margin-bottom: 28px;
    padding: 8px 10px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    position: sticky;
    top: calc(64px + 8px);
    z-index: 20;
    backdrop-filter: blur(12px);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .cmp-flow-nav::-webkit-scrollbar {
    display: none;
  }

  .cmp-flow-nav__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.55rem 1rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .cmp-flow-nav__btn:hover {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.06);
  }

  .cmp-flow-nav__btn--active {
    color: #fff;
    background: rgba(168, 85, 247, 0.22);
    box-shadow: inset 0 0 0 1px rgba(168, 85, 247, 0.35);
  }

  .cmp-flow-nav__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    background: rgba(255, 255, 255, 0.08);
  }

  .cmp-flow-nav__btn--active .cmp-flow-nav__num {
