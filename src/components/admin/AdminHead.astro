---
import Favicon from "../Favicon.astro";
import BrandFontHead from "../BrandFontHead.astro";
import ViewportMeta from "../ViewportMeta.astro";
import type { ResolvedBrandFonts } from "../../lib/brandFonts";

interface Props {
  companyName: string;
  fonts: ResolvedBrandFonts;
}

const { companyName, fonts } = Astro.props;
const appName = companyName || "Business OS";
---

<head>
  <script is:inline>
    (function () {
      if (window.__reaveClerkFetchGuard) return;
      window.__reaveClerkFetchGuard = 1;
      var resetKey = 'reave-clerk-js-reset';
      var nativeFetch = window.fetch.bind(window);
      window.fetch = function (input, init) {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        if (url.indexOf('/v1/client/sign_ins') !== -1 && url.indexOf('2024-05-12') !== -1) {
          try {
            if (!sessionStorage.getItem(resetKey)) {
              sessionStorage.setItem(resetKey, '1');
              var reload = function () {
                window.location.reload();
              };
              var clearAndReload = function () {
                if ('serviceWorker' in navigator) {
                  navigator.serviceWorker.getRegistration('/admin/').then(function (reg) {
                    return reg && reg.unregister();
                  }).finally(reload);
                } else {
                  reload();
                }
              };
              if ('caches' in window) {
                caches.keys().then(function (keys) {
                  return Promise.all(keys.map(function (key) {
                    return caches.delete(key);
                  }));
                }).then(clearAndReload).catch(clearAndReload);
              } else {
                clearAndReload();
              }
            }
          } catch (e) { /* ignore */ }
        }
        return nativeFetch(input, init);
      };
    })();
  </script>
  <meta charset="utf-8" />
  <ViewportMeta />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0a0d14" media="(prefers-color-scheme: dark)" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content={appName} />
  <meta name="application-name" content={appName} />
  <link rel="manifest" href="/admin/manifest.webmanifest" />
  <title>{appName} Admin</title>
  <Favicon />
  <BrandFontHead fonts={fonts} />
  <link rel="stylesheet" href="/ios-sheet.css" />
</head>
