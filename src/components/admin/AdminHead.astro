---
import Favicon from "../Favicon.astro";
import BrandFontHead from "../BrandFontHead.astro";
import PwaDocumentTitle from "../PwaDocumentTitle.astro";
import ViewportMeta from "../ViewportMeta.astro";
import ThemeInit from "../ThemeInit.astro";
import type { ResolvedBrandFonts } from "../../lib/brandFonts";
import type { CompanyConfig } from "../../lib/companyConfig";
import { formatHtmlPageTitle, formatPwaAppTitle } from "../../lib/pageTitle";
import BrandLcpPreload from "../BrandLcpPreload.astro";

interface Props {
  companyName: string;
  fonts: ResolvedBrandFonts;
  /** Browser-tab title. Standalone PWA / push "from" stays `companyName`. */
  pageTitle?: string;
  company?: CompanyConfig;
}

const { companyName, fonts, pageTitle, company } = Astro.props;
const appName = formatPwaAppTitle(companyName);
const docTitle = formatHtmlPageTitle({ page: pageTitle, siteName: appName });
---

<head>
  <ThemeInit />
  <meta charset="utf-8" />
  <ViewportMeta />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <!-- black-translucent: PWA paints under the status bar and home indicator
       (viewport-fit=cover). `default` letterboxes a white safe-area band. -->
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={appName} />
  <meta name="application-name" content={appName} />
  <link rel="manifest" href="/admin/manifest.webmanifest" />
  <title>{docTitle}</title>
  <PwaDocumentTitle pwaTitle={appName} />
  <Favicon />
  {company ? <BrandLcpPreload company={company} /> : null}
  <BrandFontHead fonts={fonts} />
  <link rel="stylesheet" href={`/ios-sheet.css?v=${__PUBLIC_ASSET_VERSION__}`} />
</head>
