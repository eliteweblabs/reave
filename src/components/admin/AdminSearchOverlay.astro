---
/** Full-screen section/client search overlay (os-map-loader.js). */
---

<div id="search-overlay" aria-hidden="true">
  <div class="search-overlay-bar">
    <div class="control-field search-overlay-field has-slash-search-hint">
      <input
        id="search-overlay-input"
        class="search-overlay-input"
        type="text"
        placeholder="Search Sections And Clients…"
        autocomplete="off"
        aria-label="Type / to Search Sections And Clients…"
        data-search-placeholder-raw="Search Sections And Clients…"
      />
      <span class="panel-list-search-hint" aria-hidden="true">Type <kbd class="panel-list-search-kbd">/</kbd> to Search Sections And Clients…</span>
      <button type="button" id="search-overlay-clear" class="search-overlay-clear panel-list-search-adornment is-search" data-mode="search" aria-label="Search">
        <!-- IOS_ICONS.search — keep in sync with public/admin/admin-ui.js -->
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
    </div>
  </div>
  <div id="search-overlay-results" class="search-overlay-results"></div>
</div>
