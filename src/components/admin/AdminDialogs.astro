---
/** Shared admin modals: create-drawer scrim, confirm dialog, share sheet. */
---

<div id="create-drawer-scrim" class="create-drawer-scrim" role="presentation" hidden></div>

<div id="os-dialog-backdrop" class="ios-sheet-backdrop" role="presentation" aria-hidden="true" data-sheet-dismiss="false">
  <div class="ios-sheet os-dialog" role="dialog" aria-modal="true" aria-labelledby="os-dialog-title">
    <div class="ios-sheet-grabber" aria-hidden="true"></div>
    <header class="ios-sheet-header">
      <button type="button" class="ios-sheet-close" data-os-dialog-close aria-label="Close" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <h2 class="ios-sheet-title os-dialog-title" id="os-dialog-title"></h2>
    </header>
    <div class="ios-sheet-body os-dialog-sheet-body">
      <div class="os-dialog-body" id="os-dialog-body"></div>
      <div class="os-dialog-actions" id="os-dialog-actions"></div>
    </div>
  </div>
</div>

<div id="reave-share-backdrop" class="ios-sheet-backdrop" role="presentation" aria-hidden="true" data-sheet-dismiss="true">
  <div class="ios-sheet reave-share-sheet" role="dialog" aria-modal="true" aria-labelledby="reave-share-title">
    <div class="ios-sheet-grabber" aria-hidden="true"></div>
    <header class="ios-sheet-header">
      <h2 class="ios-sheet-title" id="reave-share-title">Share</h2>
    </header>
    <div class="ios-sheet-body reave-share-body">
      <div class="reave-share-qr" id="reave-share-qr" hidden>
        <img id="reave-share-qr-img" class="reave-share-qr-img" alt="Project page QR code" width="200" height="200" />
      </div>
      <p class="reave-share-sub" id="reave-share-sub"></p>
      <label class="reave-share-note-label" for="reave-share-note">Personal note <span class="reave-share-optional">(optional)</span></label>
      <textarea id="reave-share-note" class="reave-share-note" rows="2" placeholder="Add a short note for the recipient…"></textarea>
      <div class="reave-share-actions" id="reave-share-actions"></div>
      <p class="reave-share-status" id="reave-share-status" hidden role="status"></p>
    </div>
  </div>
</div>
