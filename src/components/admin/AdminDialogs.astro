---
/** Shared admin modals: create-drawer scrim, confirm dialog, share sheet. */
import IosBottomSheet from '../IosBottomSheet.astro';
---

<div id="create-drawer-scrim" class="create-drawer-scrim" role="presentation" hidden></div>

<IosBottomSheet
  id="os-dialog-backdrop"
  title=""
  titleId="os-dialog-title"
  titleClass="os-dialog-title"
  dismissible={false}
  showClose={true}
  closeHidden={true}
  closeVia="os-dialog"
  sheetClass="os-dialog"
  bodyClass="os-dialog-sheet-body"
>
  <div class="os-dialog-body" id="os-dialog-body"></div>
  <div class="os-dialog-actions" id="os-dialog-actions"></div>
</IosBottomSheet>

<IosBottomSheet
  id="reave-share-backdrop"
  title="Share"
  titleId="reave-share-title"
  dismissible={true}
  sheetClass="reave-share-sheet"
  bodyClass="reave-share-body"
>
  <div class="reave-share-qr" id="reave-share-qr" hidden>
    <img id="reave-share-qr-img" class="reave-share-qr-img" alt="Project page QR code" width="200" height="200" />
  </div>
  <p class="reave-share-sub" id="reave-share-sub"></p>
  <label class="reave-share-note-label" for="reave-share-note">Personal note <span class="reave-share-optional">(optional)</span></label>
  <textarea id="reave-share-note" class="reave-share-note" rows="2" placeholder="Add a short note for the recipient…"></textarea>
  <div class="reave-share-actions" id="reave-share-actions"></div>
  <p class="reave-share-status" id="reave-share-status" hidden role="status"></p>
</IosBottomSheet>

<IosBottomSheet
  id="email-lab-intro-backdrop"
  title="Email Lab Mode"
  titleId="email-lab-intro-title"
  dismissible={true}
  sheetClass="em-lab-intro-sheet"
  bodyClass="em-lab-intro-body"
>
  <button slot="header-action" type="button" class="ios-sheet-header-action" data-email-lab-begin>
    Begin
  </button>
  <p>Select any phrase in this email — From, subject, or the message. Each selection becomes a line in a new rule.</p>
  <p>When you have the phrases you want, tap <strong>Create Rule</strong> to set the routing.</p>
</IosBottomSheet>

<IosBottomSheet
  id="address-picker-backdrop"
  title="Address"
  titleId="address-picker-title"
  dismissible={true}
  class="address-picker-sheet"
  sheetClass="address-picker-panel"
  bodyClass="address-picker-body"
>
  <button
    slot="header-action"
    type="button"
    class="ios-sheet-header-action"
    id="address-picker-confirm"
    hidden
  >
    Confirm
  </button>
  <div class="address-picker-search-wrap">
    <div class="address-picker-search-field control-field panel-list-search-field">
      <input
        id="address-picker-search"
        class="address-picker-search panel-list-search"
        type="search"
        placeholder="Business or street address"
        autocomplete="off"
        autocapitalize="words"
        enterkeyhint="search"
      />
    </div>
  </div>
  <div id="address-picker-list" class="address-picker-list" role="listbox" aria-labelledby="address-picker-title"></div>
  <div id="address-picker-map" class="address-picker-map" aria-label="Address preview map"></div>
</IosBottomSheet>
