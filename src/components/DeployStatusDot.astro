---
/** Railway deploy status bulb — polled by /deploy-indicator.js */
interface Props {
  /** When true, /api/deploy/indicator is public — poll without a signed-in session. */
  publicAccess?: boolean;
}

const { publicAccess = false } = Astro.props;
---
<button
  type="button"
  id="topbar-deploy-dot"
  class="topbar-deploy-dot tt-left"
  hidden
  aria-label="Deploy status"
  data-tooltip=""
  data-deploy-public={publicAccess ? "1" : undefined}
></button>
