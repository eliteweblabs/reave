---
// Desaturated "worked with" logo marquee. Images come from the media library
// via site content (config/sites/{key}-config.json → clientLogos).
import { getSiteContent } from "../lib/siteContent";

interface ClientLogo {
  name: string;
  src: string;
  width: number;
  height: number;
}

function shuffle<T>(items: T[]): T[] {
  const a = items.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function isCompact(logo: ClientLogo): boolean {
  return logo.width / Math.max(logo.height, 1) < 1.8;
}

/** Shuffle, but never put two compact marks next to each other while a wide one remains. */
function arrangeLogos(items: ClientLogo[]): ClientLogo[] {
  const compact = shuffle(items.filter(isCompact));
  const wide = shuffle(items.filter((logo) => !isCompact(logo)));
  const out: ClientLogo[] = [];
  let ci = 0;
  let wi = 0;
  let compactStreak = 0;

  while (ci < compact.length || wi < wide.length) {
    const preferWide =
      wi < wide.length && (compactStreak >= 1 || ci >= compact.length || Math.random() < 0.55);
    if (preferWide) {
      out.push(wide[wi++]);
      compactStreak = 0;
      continue;
    }
    out.push(compact[ci++]);
    compactStreak += 1;
  }
  return out;
}

const configured = getSiteContent().clientLogos ?? [];
const logos: ClientLogo[] = arrangeLogos(
  configured.map((logo) => ({
    name: logo.name,
    src: logo.image,
    width: logo.width,
    height: logo.height,
  })),
);

const LOOP_COPIES = 3;
const trackLogos = Array.from({ length: LOOP_COPIES }, () => logos).flat();
---

{
  logos.length > 0 && (

<div
  class="client-logos-viewport"
  data-client-logos
  data-loop-copies={LOOP_COPIES}
  style={`--loop-copies: ${LOOP_COPIES}`}
  aria-label="Client logos"
  role="region"
>
  <div class="client-logos-drag">
    <div class="client-logos-track">
      {
        trackLogos.map((logo, index) => (
          <div class="client-logo-item" aria-hidden={index >= logos.length ? "true" : undefined}>
            <img
              src={logo.src}
              alt={index < logos.length ? logo.name : ""}
              width={logo.width}
              height={logo.height}
              loading="eager"
              decoding="async"
              draggable="false"
            />
          </div>
        ))
      }
    </div>
  </div>
</div>
  )
}

<style>
  .client-logos-viewport {
    --logo-gap: 34px;
    position: relative;
    width: 100%;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 8%,
      #000 92%,
      transparent 100%
    );
    mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  .client-logos-viewport.is-dragging {
    cursor: grabbing;
    touch-action: none;
  }

  /*
   * Two stacked transforms that never fight: the drag layer carries the swipe
   * offset (set from JS), the track carries the autoplay animation. Autoplay is
   * pure CSS so it survives a busy main thread and any JS hiccup.
   */
  .client-logos-drag {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  /*
   * Deliberately not gated on prefers-reduced-motion: that gate froze the strip
   * outright for anyone with Reduce Motion on, and this is a slow, linear,
   * decorative drift rather than a vestibular trigger.
   */
  .client-logos-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: client-logos-scroll var(--marquee-duration, 52s) linear infinite;
    will-change: transform;
  }

  @keyframes client-logos-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-100% / var(--loop-copies, 3)), 0, 0);
    }
  }

  .client-logo-item {
    flex: 0 0 auto;
    width: fit-content;
    max-width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px calc(var(--logo-gap) / 2);
    box-sizing: border-box;
    -webkit-user-select: none;
    user-select: none;
  }

  .client-logo-item img {
    /*
     * A definite height (not max-height) plus the intrinsic width/height
     * attributes' aspect-ratio is what lets the browser derive a width here.
     * The item is content-sized (flex: 0 0 auto) with height:auto too, so
     * without a definite height anywhere in the chain, "width: auto" has
     * nothing to resolve against and the image collapses to 0×0.
     *
     * display:block keeps the wrapper flush to the painted logo — inline
     * replaced elements leave descender strut space that reads as uneven
     * padding beside square marks (Acura, Porsche, etc.).
     *
     * max-width caps very wide-aspect logos (e.g. Johnnie Walker ~10:1) on
     * narrow viewports so they don't dwarf the rest of the strip. The value
     * scales with the viewport so it feels proportional at every breakpoint.
     */
    display: block;
    height: 34px;
    width: auto;
    max-width: min(140px, 38vw);
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    filter: grayscale(100%) invert(100%);
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .client-logos-viewport:hover .client-logo-item img {
    opacity: 0.75;
  }

  @media (min-width: 480px) {
    .client-logos-viewport {
      --logo-gap: 44px;
    }

    .client-logo-item img {
      max-width: min(180px, 32vw);
    }
  }

  @media (min-width: 640px) {
    .client-logos-viewport {
      --logo-gap: 52px;
    }

    .client-logo-item img {
      max-width: min(200px, 28vw);
    }
  }

  @media (min-width: 768px) {
    .client-logos-viewport {
      --logo-gap: 64px;
    }

    .client-logo-item img {
      /* Desktop: logos are small decorative elements — no need to cap tightly */
      max-width: 220px;
    }
  }
</style>

<script>
  import "../lib/clientLogosMarquee";
</script>
