---
// Constrained 4/8-column logo wall. Each column is a vertical reel that
// translateY-cycles like a slot machine — no more full-bleed horizontal slide.
import { getSiteContent } from "../lib/siteContent";

interface ClientLogo {
  name: string;
  src: string;
  width: number;
  height: number;
}

function shuffle<T>(items: T[]): T[] {
  const a = items.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const COLS = 8;
const MIN_PER_REEL = 3;
const LOOP_COPIES = 2;

const configured = getSiteContent().clientLogos ?? [];
const logos: ClientLogo[] = shuffle(
  configured.map((logo) => ({
    name: logo.name,
    src: logo.image,
    width: logo.width,
    height: logo.height,
  })),
);

function dealReels(items: ClientLogo[]): ClientLogo[][] {
  const reels: ClientLogo[][] = Array.from({ length: COLS }, () => []);
  items.forEach((logo, i) => reels[i % COLS].push(logo));

  for (const reel of reels) {
    if (reel.length === 0 && items.length > 0) {
      reel.push(items[0]);
    }
    let i = 0;
    while (reel.length < MIN_PER_REEL && items.length > 0) {
      const extra = items[i % items.length];
      if (!reel.some((logo) => logo.name === extra.name) || i >= items.length) {
        reel.push(extra);
      }
      i += 1;
      if (i > items.length * 4) break;
    }
  }
  return reels;
}

const DURATIONS = [11, 14, 9, 16, 12, 10, 15, 13];
const DELAYS = [0, -3.2, -1.4, -5.1, -2.1, -4.6, -0.7, -6.3];

const reels = dealReels(logos).map((reel) =>
  Array.from({ length: LOOP_COPIES }, () => reel).flat(),
);
---

{
  logos.length > 0 && (
    <div class="client-logos" aria-label="Client logos" role="region">
      {
        reels.map((track, col) => (
          <div
            class="client-logos-reel"
            style={`--reel-duration: ${DURATIONS[col]}s; --reel-delay: ${DELAYS[col]}s; --reel-dir: ${col % 2 === 0 ? "normal" : "reverse"}`}
          >
            <div class="client-logos-reel-track">
              {
                track.map((logo, index) => (
                  <div
                    class="client-logo-item"
                    aria-hidden={index > 0 ? "true" : undefined}
                  >
                    <img
                      src={logo.src}
                      alt={index === 0 ? logo.name : ""}
                      width={logo.width}
                      height={logo.height}
                      loading="eager"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  )
}

<style>
  .client-logos {
    --slot-h: 52px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 12px;
    row-gap: 14px;
    width: 100%;
    max-width: 100%;
  }

  .client-logos-reel {
    position: relative;
    height: var(--slot-h);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 28%,
      #000 72%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 28%,
      #000 72%,
      transparent 100%
    );
  }

  .client-logos-reel-track {
    display: flex;
    flex-direction: column;
    animation: client-logos-slot var(--reel-duration, 12s) linear infinite;
    animation-delay: var(--reel-delay, 0s);
    animation-direction: var(--reel-dir, normal);
    will-change: transform;
  }

  .client-logos:hover .client-logos-reel-track {
    animation-play-state: paused;
  }

  @keyframes client-logos-slot {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -50%, 0);
    }
  }

  .client-logo-item {
    flex: 0 0 var(--slot-h);
    height: var(--slot-h);
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 0 4px;
  }

  .client-logo-item img {
    display: block;
    height: 28px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    filter: var(--client-logo-filter, grayscale(1));
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .client-logos:hover .client-logo-item img {
    opacity: 0.75;
  }

  @media (min-width: 640px) {
    .client-logos {
      --slot-h: 56px;
      column-gap: 16px;
    }

    .client-logo-item img {
      height: 32px;
    }
  }

  @media (min-width: 1024px) {
    .client-logos {
      --slot-h: 58px;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: 18px;
    }
  }
</style>
