---
// Constrained 4/8-column logo wall. Each column is a vertical reel that
// translateY-cycles like a slot machine — no more full-bleed horizontal slide.
import { getSiteContent } from "../lib/siteContent";
import { CLIENT_LOGO_COLS, dealClientLogoReels } from "../lib/clientLogoReels";

interface ClientLogo {
  name: string;
  src: string;
  width: number;
  height: number;
  scale?: number;
}

function shuffle<T>(items: T[]): T[] {
  const a = items.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const LOOP_COPIES = 2;

const configured = getSiteContent().clientLogos ?? [];
const logos: ClientLogo[] = shuffle(
  configured.map((logo) => ({
    name: logo.name,
    src: logo.image,
    width: logo.width,
    height: logo.height,
    scale: logo.scale,
  })),
);

const dealt = dealClientLogoReels(logos);
const cols = dealt.length || CLIENT_LOGO_COLS;

/** One column advances, then the wall waits 3.5s before the next column moves. */
const STEP_S = 3.5;

function slotSteps(count: number): 0 | 2 | 3 | 4 | 5 {
  if (count <= 1) return 0;
  if (count === 2) return 2;
  if (count === 3) return 3;
  if (count === 4) return 4;
  return 5;
}

const reels = dealt.map((reel, col) => {
  const steps = slotSteps(reel.length);
  const animate = steps > 0;
  return {
    track: Array.from({ length: animate ? LOOP_COPIES : 1 }, () =>
      steps === 5 ? reel.slice(0, 5) : reel,
    ).flat(),
    steps,
    animate,
    duration: Math.max(steps, 1) * cols * STEP_S,
    delay: col * STEP_S,
  };
});
---

{
  logos.length > 0 && (
    <div class="client-logos" aria-label="Client logos" role="region" style={`--cols: ${cols}`}>
      {
        reels.map((reel) => (
          <div
            class={`client-logos-reel${reel.animate ? ` is-steps-${reel.steps}` : " is-static"}`}
            style={`--reel-duration: ${reel.duration}s; --reel-delay: ${reel.delay}s`}
          >
            <div class="client-logos-reel-track">
              {
                reel.track.map((logo, index) => (
                  <div
                    class="client-logo-item"
                    aria-hidden={index > 0 ? "true" : undefined}
                    style={logo.scale != null ? `--logo-scale: ${logo.scale}` : undefined}
                  >
                    <img
                      src={logo.src}
                      alt={index === 0 ? logo.name : ""}
                      width={logo.width}
                      height={logo.height}
                      loading="eager"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  )
}

<style>
  .client-logos {
    --slot-h: 52px;
    --cols: 8;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 28px;
    row-gap: 28px;
    width: 100%;
    max-width: 100%;
  }

  .client-logos-reel {
    position: relative;
    height: var(--slot-h);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 16%,
      #000 84%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 16%,
      #000 84%,
      transparent 100%
    );
  }

  .client-logos-reel-track {
    display: flex;
    flex-direction: column;
    animation-duration: var(--reel-duration, 56s);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-delay: var(--reel-delay, 0s);
    will-change: transform;
  }

  .client-logos:hover .client-logos-reel-track {
    animation-play-state: paused;
  }

  .client-logos-reel.is-static .client-logos-reel-track {
    animation: none;
  }

  .client-logos-reel.is-steps-2 .client-logos-reel-track {
    animation-name: client-logos-slot-2;
  }

  .client-logos-reel.is-steps-3 .client-logos-reel-track {
    animation-name: client-logos-slot-3;
  }

  .client-logos-reel.is-steps-4 .client-logos-reel-track {
    animation-name: client-logos-slot-4;
  }

  .client-logos-reel.is-steps-5 .client-logos-reel-track {
    animation-name: client-logos-slot-5;
  }

  /*
   * Each reel holds its own unique marks (duplicated for a seamless loop).
   * Duration is steps × columns × 3.5s so only one column eases at a time.
   *
   * Keyframes must ease near the START of each 1/steps slice (≈ STEP_S into
   * the cycle when cols=8), then hold while the other columns take their turn.
   * Holding until ~50% made the wall look frozen for half a minute.
   */
  @keyframes client-logos-slot-2 {
    0%,
    6.25% {
      transform: translate3d(0, 0, 0);
    }
    6.75%,
    56.25% {
      transform: translate3d(0, calc(var(--slot-h) * -1), 0);
    }
    56.75%,
    100% {
      transform: translate3d(0, calc(var(--slot-h) * -2), 0);
    }
  }

  @keyframes client-logos-slot-3 {
    0%,
    4.17% {
      transform: translate3d(0, 0, 0);
    }
    4.67%,
    37.5% {
      transform: translate3d(0, calc(var(--slot-h) * -1), 0);
    }
    38%,
    70.83% {
      transform: translate3d(0, calc(var(--slot-h) * -2), 0);
    }
    71.33%,
    100% {
      transform: translate3d(0, calc(var(--slot-h) * -3), 0);
    }
  }

  @keyframes client-logos-slot-4 {
    0%,
    3.125% {
      transform: translate3d(0, 0, 0);
    }
    3.625%,
    28.125% {
      transform: translate3d(0, calc(var(--slot-h) * -1), 0);
    }
    28.625%,
    53.125% {
      transform: translate3d(0, calc(var(--slot-h) * -2), 0);
    }
    53.625%,
    78.125% {
      transform: translate3d(0, calc(var(--slot-h) * -3), 0);
    }
    78.625%,
    100% {
      transform: translate3d(0, calc(var(--slot-h) * -4), 0);
    }
  }

  @keyframes client-logos-slot-5 {
    0%,
    2.5% {
      transform: translate3d(0, 0, 0);
    }
    3%,
    22.5% {
      transform: translate3d(0, calc(var(--slot-h) * -1), 0);
    }
    23%,
    42.5% {
      transform: translate3d(0, calc(var(--slot-h) * -2), 0);
    }
    43%,
    62.5% {
      transform: translate3d(0, calc(var(--slot-h) * -3), 0);
    }
    63%,
    82.5% {
      transform: translate3d(0, calc(var(--slot-h) * -4), 0);
    }
    83%,
    100% {
      transform: translate3d(0, calc(var(--slot-h) * -5), 0);
    }
  }

  .client-logo-item {
    flex: 0 0 var(--slot-h);
    height: var(--slot-h);
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 0 10px;
  }

  .client-logo-item img {
    display: block;
    height: calc(28px * var(--logo-scale, 1));
    width: auto;
    max-width: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    filter: var(--client-logo-filter, grayscale(1));
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .client-logos:hover .client-logo-item img {
    opacity: 0.75;
  }

  @media (min-width: 640px) {
    .client-logos {
      --slot-h: 56px;
      column-gap: 40px;
      row-gap: 32px;
    }

    .client-logo-item img {
      height: calc(32px * var(--logo-scale, 1));
    }
  }

  @media (min-width: 1024px) {
    .client-logos {
      --slot-h: 58px;
      grid-template-columns: repeat(var(--cols, 8), minmax(0, 1fr));
      column-gap: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-logos-reel-track {
      animation: none;
    }
  }
</style>
