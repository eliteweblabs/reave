---
// Constrained 4/8-column logo wall. Each column is a vertical reel that
// translateY-cycles like a slot machine — no more full-bleed horizontal slide.
import { getSiteContent } from "../lib/siteContent";

interface ClientLogo {
  name: string;
  src: string;
  width: number;
  height: number;
}

function shuffle<T>(items: T[]): T[] {
  const a = items.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const COLS = 8;
const PER_REEL = 5;
const LOOP_COPIES = 2;

const configured = getSiteContent().clientLogos ?? [];
const logos: ClientLogo[] = shuffle(
  configured.map((logo) => ({
    name: logo.name,
    src: logo.image,
    width: logo.width,
    height: logo.height,
  })),
);

/** Each column starts on a different logo and walks the list by 3s so neighbors don't share a reel. */
function dealReels(items: ClientLogo[]): ClientLogo[][] {
  if (items.length === 0) return [];
  const size = Math.min(PER_REEL, items.length);
  return Array.from({ length: COLS }, (_, col) => {
    const reel: ClientLogo[] = [];
    const seen = new Set<string>();
    for (let i = 0; i < items.length * 2 && reel.length < size; i++) {
      const logo = items[(col + i * 3) % items.length];
      if (seen.has(logo.name) && reel.length < items.length) continue;
      seen.add(logo.name);
      reel.push(logo);
    }
    return reel;
  });
}

/** One column advances, then the wall waits 3.5s before the next column moves. */
const STEP_S = 3.5;
const DURATION_S = PER_REEL * COLS * STEP_S;
const DELAYS = Array.from({ length: COLS }, (_, col) => col * STEP_S);

const reels = dealReels(logos).map((reel) =>
  Array.from({ length: LOOP_COPIES }, () => reel).flat(),
);
---

{
  logos.length > 0 && (
    <div class="client-logos" aria-label="Client logos" role="region">
      {
        reels.map((track, col) => (
          <div
            class="client-logos-reel"
            style={`--reel-duration: ${DURATION_S}s; --reel-delay: ${DELAYS[col]}s`}
          >
            <div class="client-logos-reel-track">
              {
                track.map((logo, index) => (
                  <div
                    class="client-logo-item"
                    aria-hidden={index > 0 ? "true" : undefined}
                  >
                    <img
                      src={logo.src}
                      alt={index === 0 ? logo.name : ""}
                      width={logo.width}
                      height={logo.height}
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  )
}

<style>
  .client-logos {
    --slot-h: 52px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 28px;
    row-gap: 28px;
    width: 100%;
    max-width: 100%;
  }

  .client-logos-reel {
    position: relative;
    height: var(--slot-h);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 16%,
      #000 84%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 16%,
      #000 84%,
      transparent 100%
    );
  }

  .client-logos-reel-track {
    display: flex;
    flex-direction: column;
    animation: client-logos-slot var(--reel-duration, 140s) ease-in-out infinite;
    animation-delay: var(--reel-delay, 0s);
    will-change: transform;
  }

  .client-logos:hover .client-logos-reel-track {
    animation-play-state: paused;
  }

  /*
   * Five logos per reel (duplicated for a seamless loop). Duration is
   * 5 × 8 × 3.5s = 140s. Each reel holds, eases ~0.7s to the next mark,
   * then waits out the rest of the 28s round while the other columns take
   * their turn — only one logo on the wall moves at a time.
   */
  @keyframes client-logos-slot {
    0%,
    2.5% {
      transform: translate3d(0, 0, 0);
    }
    3%,
    22.5% {
      transform: translate3d(0, calc(var(--slot-h) * -1), 0);
    }
    23%,
    42.5% {
      transform: translate3d(0, calc(var(--slot-h) * -2), 0);
    }
    43%,
    62.5% {
      transform: translate3d(0, calc(var(--slot-h) * -3), 0);
    }
    63%,
    82.5% {
      transform: translate3d(0, calc(var(--slot-h) * -4), 0);
    }
    83%,
    100% {
      transform: translate3d(0, calc(var(--slot-h) * -5), 0);
    }
  }

  .client-logo-item {
    flex: 0 0 var(--slot-h);
    height: var(--slot-h);
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 0 10px;
  }

  .client-logo-item img {
    display: block;
    height: 28px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    filter: var(--client-logo-filter, grayscale(1));
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .client-logos:hover .client-logo-item img {
    opacity: 0.75;
  }

  @media (min-width: 640px) {
    .client-logos {
      --slot-h: 56px;
      column-gap: 40px;
      row-gap: 32px;
    }

    .client-logo-item img {
      height: 32px;
    }
  }

  @media (min-width: 1024px) {
    .client-logos {
      --slot-h: 58px;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-logos-reel-track {
      animation: none;
    }
  }
</style>
