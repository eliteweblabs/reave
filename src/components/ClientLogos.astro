---
// Desaturated "worked with" logo marquee.
// Assets live in /public/logos/clients — see that folder for sourcing notes.
interface ClientLogo {
  name: string;
  src: string;
  // Intrinsic aspect ratio (any consistent unit works — most are the
  // source SVG's viewBox). Several of these SVGs have no width/height
  // attribute of their own, so without this the <img> has no intrinsic
  // size for the browser to size against once its container is
  // content-sized rather than fixed-width, and it collapses to 0×0.
  width: number;
  height: number;
}

const logos: ClientLogo[] = [
  { name: "Porsche", src: "/logos/clients/porsche.svg", width: 24, height: 24 },
  { name: "The New York Times", src: "/logos/clients/newyorktimes.svg", width: 24, height: 24 },
  { name: "Red Bull", src: "/logos/clients/redbull.svg", width: 24, height: 24 },
  { name: "Chase Bank", src: "/logos/clients/chase.svg", width: 24, height: 24 },
  { name: "Acura", src: "/logos/clients/acura.svg", width: 24, height: 24 },
  { name: "Bombay Sapphire", src: "/logos/clients/bombay-sapphire.png", width: 3564, height: 765 },
  { name: "Live Nation", src: "/logos/clients/live-nation.svg", width: 868.6, height: 96.1 },
  { name: "Johnnie Walker", src: "/logos/clients/johnnie-walker.svg", width: 100.75, height: 10.3 },
  {
    name: "Worcester Polytechnic Institute",
    src: "/logos/clients/wpi.svg",
    width: 390.27,
    height: 146.14,
  },
  { name: "Kingdom Trails", src: "/logos/clients/kingdom-trails.svg", width: 260, height: 60 },
  { name: "UC Law San Francisco", src: "/logos/clients/uc-law-sf.svg", width: 340, height: 72 },
  { name: "Mohegan Sun", src: "/logos/clients/mohegan-sun.svg", width: 185, height: 83 },
  { name: "Sharpie", src: "/logos/clients/sharpie.svg", width: 1000, height: 332.43 },
  { name: "The Overlook", src: "/logos/clients/overlook.svg", width: 280, height: 60 },
  { name: "Coinbase", src: "/logos/clients/coinbase.svg", width: 240, height: 48 },
];

const LOOP_COPIES = 3;
const trackLogos = Array.from({ length: LOOP_COPIES }, () => logos).flat();
---

<div
  class="client-logos-viewport"
  data-client-logos
  data-loop-copies={LOOP_COPIES}
  style={`--loop-copies: ${LOOP_COPIES}`}
  aria-label="Client logos"
  role="region"
>
  <div class="client-logos-drag">
    <div class="client-logos-track">
      {
        trackLogos.map((logo, index) => (
          <div class="client-logo-item" aria-hidden={index >= logos.length ? "true" : undefined}>
            <img
              src={logo.src}
              alt={index < logos.length ? logo.name : ""}
              width={logo.width}
              height={logo.height}
              loading="eager"
              decoding="async"
              draggable="false"
            />
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .client-logos-viewport {
    --logo-gap: 34px;
    position: relative;
    width: 100%;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 8%,
      #000 92%,
      transparent 100%
    );
    mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  .client-logos-viewport.is-dragging {
    cursor: grabbing;
    touch-action: none;
  }

  /*
   * Two stacked transforms that never fight: the drag layer carries the swipe
   * offset (set from JS), the track carries the autoplay animation. Autoplay is
   * pure CSS so it survives a busy main thread and any JS hiccup.
   */
  .client-logos-drag {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  /*
   * Deliberately not gated on prefers-reduced-motion: that gate froze the strip
   * outright for anyone with Reduce Motion on, and this is a slow, linear,
   * decorative drift rather than a vestibular trigger.
   */
  .client-logos-track {
    display: flex;
    align-items: center;
    gap: var(--logo-gap);
    width: max-content;
    animation: client-logos-scroll var(--marquee-duration, 52s) linear infinite;
    will-change: transform;
  }

  @keyframes client-logos-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-100% / var(--loop-copies, 3)), 0, 0);
    }
  }

  .client-logo-item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 0;
    box-sizing: border-box;
    -webkit-user-select: none;
    user-select: none;
  }

  .client-logo-item img {
    /*
     * A definite height (not max-height) plus the intrinsic width/height
     * attributes' aspect-ratio is what lets the browser derive a width here.
     * The item is content-sized (flex: 0 0 auto) with height:auto too, so
     * without a definite height anywhere in the chain, "width: auto" has
     * nothing to resolve against and the image collapses to 0×0.
     *
     * max-width caps very wide-aspect logos (e.g. Johnnie Walker ~10:1) on
     * narrow viewports so they don't dwarf the rest of the strip. The value
     * scales with the viewport so it feels proportional at every breakpoint.
     */
    height: 34px;
    width: auto;
    max-width: min(140px, 38vw);
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    filter: grayscale(100%) invert(100%);
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .client-logos-viewport:hover .client-logo-item img {
    opacity: 0.75;
  }

  @media (min-width: 480px) {
    .client-logos-viewport {
      --logo-gap: 44px;
    }

    .client-logo-item img {
      max-width: min(180px, 32vw);
    }
  }

  @media (min-width: 640px) {
    .client-logos-viewport {
      --logo-gap: 52px;
    }

    .client-logo-item img {
      max-width: min(200px, 28vw);
    }
  }

  @media (min-width: 768px) {
    .client-logos-viewport {
      --logo-gap: 64px;
    }

    .client-logo-item img {
      /* Desktop: logos are small decorative elements — no need to cap tightly */
      max-width: 220px;
    }
  }
</style>

<script>
  import "../lib/clientLogosMarquee";
</script>
