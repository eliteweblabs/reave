---
/**
 * Shared Chat / SMS / Call block (ContactChannelGroup + lazy chat panel) — same
 * module as rekko.studio `/` grand-opening apply section.
 */
import ContactChannelGroup from "../contact/ContactChannelGroup.astro";
import "../../styles/marketing-sections.css";

interface Props {
  heading?: string;
  lead?: string;
  hideHeader?: boolean;
  /** Channels + chat panel only (no outer `<section>`). */
  bare?: boolean;
  /** Element id for the chat panel (must be unique per page). */
  chatPanelId?: string;
  /** Prefilled SMS body (optional). */
  smsBody?: string;
  /** Lazy-loaded chat partial (same pattern as grand-opening). */
  lazyChatHref?: string;
  class?: string;
  channelsClass?: string;
  panelClass?: string;
}

const {
  heading = "Contact",
  lead = "Chat here, or reach us by SMS or phone.",
  hideHeader = false,
  bare = false,
  chatPanelId = "contact-chat-panel",
  smsBody = "",
  lazyChatHref = "/partials/marketing-contact-chat",
  class: className = "",
  channelsClass = "",
  panelClass = "",
} = Astro.props;

const panelClasses = ["contact-chat-panel", panelClass].filter(Boolean).join(" ");
---

{
  bare ? (
    <div class:list={["marketing-contact-bare", className]} data-marketing-contact>
      <ContactChannelGroup
        chatPanelId={chatPanelId}
        smsBody={smsBody}
        class={channelsClass}
      />
      <div
        id={chatPanelId}
        class={panelClasses}
        hidden
        data-lazy-chat-href={lazyChatHref}
      />
    </div>
  ) : (
    <section
      id="contact"
      class:list={["home-section", "marketing-contact-section", className]}
      data-home-section="contact"
      data-marketing-contact
      aria-labelledby={hideHeader ? undefined : "marketing-contact-title"}
    >
      <div class="home-section-inner">
        {
          !hideHeader && (
            <header class="home-section-hero">
              <h2 id="marketing-contact-title">{heading}</h2>
              {lead ? <p class="marketing-contact-lead">{lead}</p> : null}
            </header>
          )
        }
        <ContactChannelGroup
          chatPanelId={chatPanelId}
          smsBody={smsBody}
          class={channelsClass}
        />
        <div
          id={chatPanelId}
          class={panelClasses}
          hidden
          data-lazy-chat-href={lazyChatHref}
        />
      </div>
    </section>
  )
}

<style>
  .marketing-contact-bare {
    width: 100%;
  }

  .marketing-contact-section {
    scroll-margin-top: calc(
      var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) + 8px
    );
  }

  .marketing-contact-lead {
    margin: 0 auto;
    max-width: 34rem;
    font-family: var(--font-content);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--site-fg-muted, #525252);
  }
</style>
