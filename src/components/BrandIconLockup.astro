---
/**
 * Admin icon mark — glass-neon when the pasted SVG can mask, otherwise the
 * solid inline icon. Homepage hero and /card share this so a Company icon
 * change lands in both places.
 */
import type { CompanyConfig } from '../lib/companyConfig';
import { companyHeroIconSvg } from '../lib/companyConfig';
import { prepareInlineBrandSvg, svgHasExternalRasterRefs, withSvgFill } from '../lib/brandSvg';
import BrandIconInline from './BrandIconInline.astro';

export interface Props {
  company: CompanyConfig;
  /** `hero` fills the homepage lockup; `card` is the NFC-scale mark. */
  variant?: 'hero' | 'card';
  idPrefix?: string;
}

const { company, variant = 'hero', idPrefix = 'hero-icon' } = Astro.props;

const heroIconSvg = companyHeroIconSvg(company);
const maskPrefix = `${idPrefix}-mask`;
const heroMaskSvg = heroIconSvg
  ? prepareInlineBrandSvg(withSvgFill(heroIconSvg, '#000'), { idPrefix: maskPrefix })
  : null;
const heroMaskUsable = Boolean(
  heroMaskSvg && /xmlns\s*=/i.test(heroMaskSvg) && /viewBox\s*=/i.test(heroMaskSvg),
);
const neonMark = heroMaskUsable && !svgHasExternalRasterRefs(heroIconSvg);
const heroMarkSilhouette = neonMark
  ? `url('data:image/svg+xml,${encodeURIComponent(heroMaskSvg as string)
      .replace(/\(/g, '%28')
      .replace(/\)/g, '%29')
      .replace(/'/g, '%27')}')`
  : '';
---

<div
  class:list={['brand-icon-lockup', `brand-icon-lockup--${variant}`, variant === 'hero' && 'home-hero-icon-wrap']}
  data-hero-icon={variant === 'hero' ? '' : undefined}
  aria-hidden="true"
>
  {neonMark ? (
    <span
      class="home-hero-mark"
      style={`--home-hero-mark-silhouette: ${heroMarkSilhouette};`}
    >
      <span class="home-hero-mark-bloom">
        <span class="home-hero-mark-paint">
          <span class="home-hero-mark-sweep"></span>
        </span>
      </span>
      <span class="home-hero-mark-paint home-hero-mark-paint--face">
        <span class="home-hero-mark-sweep"></span>
        <span class="home-hero-mark-sheen"></span>
      </span>
    </span>
  ) : (
    <BrandIconInline company={company} class="home-hero-icon" idPrefix={idPrefix} />
  )}
</div>

<style>
  .brand-icon-lockup {
    --brand-icon-size: var(--home-hero-icon-size, clamp(190px, 42vw, 312px));
    --brand-icon-pad: var(--home-hero-icon-pad, 1.25rem);
    --brand-icon-ink-above: var(--home-hero-icon-ink-above, 0.269);
    position: relative;
    z-index: 1;
    flex: none;
    box-sizing: content-box;
    width: var(--brand-icon-size);
    height: var(--brand-icon-size);
    padding: var(--brand-icon-pad);
    margin-top: calc(var(--brand-icon-size) * var(--brand-icon-ink-above) * -1);
    pointer-events: none;
    overflow: visible;
    isolation: isolate;
  }

  .brand-icon-lockup--card {
    --brand-icon-size: clamp(5.5rem, 22vw, 7.5rem);
    --brand-icon-pad: 0;
    --brand-icon-ink-above: 0.12;
    margin-bottom: 0.35rem;
  }

  /* ---- Glass-neon mark: the glyph as a mask over a moving spectrum ---- */

  .home-hero-mark {
    /*
     * One saturated spectrum rather than a field of coloured blobs. Blobs left
     * gaps between them, and a gap falls through to whatever is underneath —
     * on a near-black canvas that reads as a hole in the logo. A gradient has
     * no gaps, so every part of the glyph is lit at all times.
     *
     * Period is in px so the travel per loop can match it exactly; the last stop
     * repeats the first so the wrap has no hard edge.
     */
    --home-hero-mark-period: 210px;
    --home-hero-mark-spectrum: repeating-linear-gradient(
      45deg,
      #ff2d6f 0px,
      #ff8a00 35px,
      #ffe600 70px,
      #34ff9b 105px,
      #00e0ff 140px,
      #4b6bff 175px,
      #ff2d6f 210px
    );
    --home-hero-mark-ink: saturate(1.15) brightness(0.94);
    --home-hero-mark-bloom-blur: 22px;
    --home-hero-mark-bloom-opacity: 0.5;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(html[data-theme='dark']) .home-hero-mark {
    --home-hero-mark-ink: saturate(1.2) brightness(1.06);
    --home-hero-mark-bloom-opacity: 0.75;
  }

  .home-hero-mark-paint {
    position: absolute;
    inset: 0;
    filter: var(--home-hero-mark-ink);
    -webkit-mask-image: var(--home-hero-mark-silhouette);
    mask-image: var(--home-hero-mark-silhouette);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /*
   * The moving part, and it moves by transform rather than by background-position.
   * Animating a paint property on a layer that also carries a mask and a filter
   * works on desktop but is the kind of thing mobile Safari rasterises once and
   * never repaints — the mark just sat there on iOS. A transform is composited,
   * so it animates without asking anything to repaint, which is also cheaper on
   * a phone.
   *
   * Repeating rather than a one-shot ramp, because that makes the loop exact:
   * shifting a periodic gradient by exactly one period reproduces the same
   * pixels, so this can run continuously instead of ping-ponging, with no seam
   * and no reversal. Keep --home-hero-mark-period and the keyframe in step —
   * the translation is one period along the 45deg axis, i.e. period ÷ √2 on
   * each axis.
   */
  .home-hero-mark-sweep {
    position: absolute;
    inset: -150%;
    background: var(--home-hero-mark-spectrum);
    animation: homeHeroMarkSweep 3.5s linear infinite;
  }

  .home-hero-mark-bloom {
    position: absolute;
    inset: 0;
    filter: blur(var(--home-hero-mark-bloom-blur));
    opacity: var(--home-hero-mark-bloom-opacity);
  }

  .home-hero-mark-sheen {
    position: absolute;
    inset: -20%;
    background: linear-gradient(
      118deg,
      transparent 34%,
      rgba(255, 255, 255, 0.55) 47%,
      rgba(255, 255, 255, 0.16) 53%,
      transparent 66%
    );
    opacity: 0.4;
    animation: homeHeroMarkSheen 5.25s ease-in-out infinite;
    animation-delay: -1.75s;
  }

  @keyframes homeHeroMarkSweep {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(148.49px, -148.49px, 0);
    }
  }

  @keyframes homeHeroMarkSheen {
    0%,
    100% {
      transform: translate3d(-26%, -12%, 0);
    }
    50% {
      transform: translate3d(26%, 12%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-mark-sweep,
    .home-hero-mark-sheen {
      animation: none;
    }
  }

  .brand-icon-lockup > :global(svg),
  .brand-icon-lockup > :global(img) {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    filter: none;
  }

  .brand-icon-lockup > :global(.home-hero-icon-name) {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0 8px;
    font-family: var(--font-primary);
    font-size: clamp(1.35rem, 3.2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-align: center;
    color: var(--site-fg, #171717);
  }
</style>
