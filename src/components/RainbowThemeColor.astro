---
/**
 * Scroll-driven rainbow `<meta name="theme-color">`.
 * Loaded only when the frontend site config sets `rainbowThemeColor`.
 *
 * Safari often ignores `content` updates on an existing meta, and Safari 26
 * Liquid Glass tints chrome from the html background — so we replace the
 * meta, paint `html`, and keep a thin visible bar so the cycle is obvious.
 */
---

<div class="rainbow-theme-bar" aria-hidden="true"></div>

<style>
  .rainbow-theme-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 8px;
    background: var(--rainbow-theme-color, transparent);
    pointer-events: none;
    z-index: 2200;
  }
</style>

<script>
  document.documentElement.dataset.rainbowThemeColor = "1";

  const root = document.documentElement;
  let rafId = 0;
  let lastHex = "";

  function hslToHex(h: number, s: number, l: number): string {
    s /= 100;
    l /= 100;
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => {
      const k = (n + h / 30) % 12;
      return Math.round(255 * (l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1))));
    };
    const hex = (n: number) => (n < 16 ? "0" : "") + n.toString(16);
    return `#${hex(f(0))}${hex(f(8))}${hex(f(4))}`;
  }

  function getScrollPercentage(): number {
    const top = window.scrollY || root.scrollTop || 0;
    const range = root.scrollHeight - root.clientHeight;
    if (range <= 0) return 0;
    return Math.min(1, Math.max(0, top / range));
  }

  function replaceThemeColor(hex: string) {
    const prev = document.querySelector('meta[name="theme-color"]:not([media])');
    const next = document.createElement("meta");
    next.setAttribute("name", "theme-color");
    next.setAttribute("content", hex);
    if (prev?.parentNode) prev.parentNode.replaceChild(next, prev);
    else document.head.appendChild(next);
  }

  function apply() {
    if (rafId) return;
    rafId = window.requestAnimationFrame(() => {
      rafId = 0;
      const hex = hslToHex(getScrollPercentage() * 360, 90, 45);
      if (hex === lastHex) return;
      lastHex = hex;
      root.style.setProperty("--rainbow-theme-color", hex);
      root.style.backgroundColor = hex;
      replaceThemeColor(hex);
    });
  }

  window.addEventListener("scroll", apply, { passive: true });
  window.addEventListener("resize", apply);
  apply();
</script>
