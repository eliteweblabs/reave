---
/**
 * Scroll-driven Safari chrome tint. Opt-in via site config `rainbowThemeColor`.
 *
 * Safari 26 dropped `theme-color` for Liquid Glass. It samples `body`
 * background-color (or a top `position: fixed` paint). A visible page bar is
 * the wrong layer — keep the page as-is and only retint `body` + the meta
 * (older Safari / Chrome Android).
 */
---

<script>
  document.documentElement.dataset.rainbowThemeColor = "1";

  const body = document.body;
  let rafId = 0;
  let lastRgb = "";
  let nudged = false;

  function hslToRgb(h: number, s: number, l: number): { r: number; g: number; b: number } {
    s /= 100;
    l /= 100;
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => {
      const k = (n + h / 30) % 12;
      return Math.round(255 * (l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1))));
    };
    return { r: f(0), g: f(8), b: f(4) };
  }

  function getScrollPercentage(): number {
    const el = document.documentElement;
    const top = window.scrollY || el.scrollTop || 0;
    const range = el.scrollHeight - el.clientHeight;
    if (range <= 0) return 0;
    return Math.min(1, Math.max(0, top / range));
  }

  function setThemeColorMeta(rgb: string) {
    const viewport = document.querySelector('meta[name="viewport"]');
    let meta = document.querySelector('meta[name="theme-color"]:not([media])');
    if (!meta) {
      meta = document.createElement("meta");
      meta.setAttribute("name", "theme-color");
      if (viewport?.after) viewport.after(meta);
      else document.head.appendChild(meta);
    }
    meta.setAttribute("content", rgb);
  }

  function apply() {
    if (rafId) return;
    rafId = window.requestAnimationFrame(() => {
      rafId = 0;
      const { r, g, b } = hslToRgb(getScrollPercentage() * 360, 90, 45);
      const rgb = `rgb(${r}, ${g}, ${b})`;
      if (rgb === lastRgb) return;
      lastRgb = rgb;
      body.style.backgroundColor = rgb;
      setThemeColorMeta(rgb);
      if (!nudged) {
        nudged = true;
        window.scrollBy(0, -1);
        window.scrollBy(0, 1);
      }
    });
  }

  window.addEventListener("scroll", apply, { passive: true });
  window.addEventListener("resize", apply);
  apply();
</script>
