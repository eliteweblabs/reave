---
/**
 * iOS 26 Safari Liquid Glass chrome tint probes.
 *
 * Safari 26 ignores theme-color. It samples background-color on position:fixed
 * elements within ~4px of the top / ~3px of the bottom (full-width, ≥3px tall).
 * Transparent fixed chrome at those edges (header, CTA dock) makes the status
 * bar and home-indicator strips fall back to solid black under color-scheme:dark.
 *
 * These probes sit mostly off-screen with an explicit purple canvas color so
 * Liquid Glass tints match the page atmosphere. Hidden outside iOS Safari.
 */
---

<div class="safari-chrome-tint safari-chrome-tint--top" aria-hidden="true"></div>
<div class="safari-chrome-tint safari-chrome-tint--bottom" aria-hidden="true"></div>

<style is:global>
  .safari-chrome-tint {
    display: none;
    pointer-events: none;
    position: fixed;
    left: 0;
    width: 100%;
    height: 12px;
    /* Must be a real color — transparent here recreates the black bars. */
    background-color: var(--site-canvas, #180a28);
    /* Above the root paint, below UI chrome. Off-screen strip is not visible. */
    z-index: 1;
  }

  .safari-chrome-tint--top {
    top: -8px;
  }

  .safari-chrome-tint--bottom {
    bottom: -8px;
  }

  /* iOS Safari (incl. 26 Liquid Glass). Keep off iPad/desktop widths. */
  @supports (-webkit-text-size-adjust: none) and (font: -apple-system-body) and (-webkit-touch-callout: none) {
    @media (width < 768px) {
      .safari-chrome-tint {
        display: block;
      }
    }
  }
</style>
