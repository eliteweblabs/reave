---
/**
 * iOS 26 Safari Liquid Glass chrome tint probes.
 *
 * Safari 26 ignores theme-color. It samples background-color on the topmost
 * position:fixed element within ~4px of the top / ~3px of the bottom.
 * Our marketing header is position:fixed; top:0 with NO background — that
 * sits above a z-index:1 probe and Safari samples transparent → solid black
 * under color-scheme:dark (the bars in Web Inspector outside <html>/<body>).
 *
 * Probes use an opaque --site-canvas fill and z-index above the header so
 * they win the edge sample. Mostly off-screen; only a few px peek in.
 */
---

<div class="safari-chrome-tint safari-chrome-tint--top" aria-hidden="true"></div>
<div class="safari-chrome-tint safari-chrome-tint--bottom" aria-hidden="true"></div>

<style is:global>
  .safari-chrome-tint {
    display: none;
    pointer-events: none;
    position: fixed;
    left: 0;
    width: 100%;
    height: 12px;
    /* Must be opaque — transparent recreates the black bars. */
    background-color: var(--site-canvas, #0c0614);
    /*
     * Above .app-header (2000) and sticky CTAs (940). The peek strip is under
     * system chrome / just above the toolbar, so it is not a visible UI bar.
     */
    z-index: 2500;
  }

  .safari-chrome-tint--top {
    top: -8px;
  }

  .safari-chrome-tint--bottom {
    bottom: -8px;
  }

  /* iOS Safari (incl. 26 Liquid Glass). Keep off iPad/desktop widths. */
  @supports (-webkit-text-size-adjust: none) and (font: -apple-system-body) and (-webkit-touch-callout: none) {
    @media (width < 768px) {
      .safari-chrome-tint {
        display: block;
      }
    }
  }
</style>
