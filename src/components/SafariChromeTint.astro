---
/**
 * iOS Safari Liquid Glass chrome tint probes.
 *
 * Safari 26 ignores theme-color. It samples background-color on the topmost
 * position:fixed element within ~4px of the top / ~3px of the bottom.
 * Transparent fixed chrome at those edges (header, CTA dock) makes the status
 * bar and home-indicator strips fall back to solid black under color-scheme:dark.
 *
 * Probes use an opaque --site-canvas fill and z-index above the header so
 * they win the edge sample. Sized to cover the safe-area inset plus the sample band.
 */
---

<div class="safari-chrome-tint safari-chrome-tint--top" aria-hidden="true"></div>
<div class="safari-chrome-tint safari-chrome-tint--bottom" aria-hidden="true"></div>

<script is:inline>
  (function () {
    try {
      if (!CSS.supports("-webkit-touch-callout", "none")) return;
      if (!window.matchMedia("(max-width: 767.98px)").matches) return;
      function tickle() {
        var y = window.scrollY;
        window.scrollTo(0, y + 1);
        requestAnimationFrame(function () {
          window.scrollTo(0, y);
        });
      }
      requestAnimationFrame(function () {
        requestAnimationFrame(tickle);
      });
      window.addEventListener("load", tickle);
      window.addEventListener("pageshow", tickle);
    } catch (_) {}
  })();
</script>

<style is:global>
  .safari-chrome-tint {
    display: none;
    pointer-events: none;
    position: fixed;
    left: 0;
    width: 100%;
    /* Must be opaque — transparent recreates the black bars. */
    background-color: var(--site-canvas, #0c0614);
    /*
     * Above .app-header (2000) and sticky CTAs (940). Dropdowns at 10000 only
     * cover this while open; edge strips sit under system chrome anyway.
     */
    z-index: 9000;
  }

  .safari-chrome-tint--top {
    top: 0;
    height: max(12px, calc(env(safe-area-inset-top, 0px) + 4px));
  }

  .safari-chrome-tint--bottom {
    bottom: 0;
    height: max(12px, calc(env(safe-area-inset-bottom, 0px) + 4px));
  }

  /* iOS Safari (incl. 26 Liquid Glass). Keep off iPad/desktop widths. */
  @supports (-webkit-touch-callout: none) {
    @media (width < 768px) {
      .safari-chrome-tint {
        display: block;
      }
    }
  }
</style>
