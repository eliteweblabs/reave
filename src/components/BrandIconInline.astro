---
import type { CompanyConfig } from '../lib/companyConfig';
import { companyHeroIconImageUrl, companyHeroIconSvg } from '../lib/companyConfig';
import InlineBrandSvg from './InlineBrandSvg.astro';

export interface Props {
  company: CompanyConfig;
  class?: string;
  idPrefix?: string;
}

const { company, class: className = 'home-hero-icon', idPrefix = 'hero-icon' } = Astro.props;
const inlineIconSvg = companyHeroIconSvg(company);
const iconImageUrl = inlineIconSvg ? '' : companyHeroIconImageUrl(company);
const displayName = company.name?.trim() || 'Business OS';
---

{
  inlineIconSvg ? (
    <InlineBrandSvg
      svg={inlineIconSvg}
      class={className}
      idPrefix={idPrefix}
    />
  ) : iconImageUrl ? (
    <img
      src={iconImageUrl}
      alt=""
      class={className}
      width="512"
      height="512"
      decoding="async"
    />
  ) : (
    <span class:list={[className, 'home-hero-icon-name']}>{displayName}</span>
  )
}
