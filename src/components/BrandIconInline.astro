---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import type { CompanyConfig } from '../lib/companyConfig';
import {
  brandIconUrl,
  companyBrandingVersion,
  companyHeroIconSvg,
} from '../lib/companyConfig';
import { prepareInlineBrandSvg } from '../lib/brandSvg';

export interface Props {
  company: CompanyConfig;
  variant?: 'front' | 'glow';
}

const { company, variant = 'front' } = Astro.props;
const isGlow = variant === 'glow';
const className = isGlow
  ? 'home-hero-icon-glow-svg reave-icon-svg'
  : 'home-hero-icon reave-icon-svg';
const idPrefix = isGlow ? 'hero-icon-glow' : 'hero-icon';

/** Public REΛVE icon SVG — used when admin has not pasted an Icon/Logo SVG. */
const DEFAULT_HERO_ICON_SVG = readFileSync(
  path.join(process.cwd(), 'public/reave-icon.svg'),
  'utf8',
);

const customSvg = companyHeroIconSvg(company);
const svgSource = customSvg || DEFAULT_HERO_ICON_SVG;
const inlineSvg = prepareInlineBrandSvg(svgSource, { className, idPrefix });
const rasterFallbackUrl =
  company.iconSource === 'admin' && company.iconPath.includes('/api/branding/icon')
    ? brandIconUrl(512, companyBrandingVersion(company))
    : '/reave-icon.png';
const useAdminRaster =
  !inlineSvg &&
  Boolean(customSvg) &&
  company.iconSource === 'admin' &&
  company.iconPath.includes('/api/branding/icon');
---

{
  inlineSvg ? (
    <Fragment set:html={inlineSvg} />
  ) : useAdminRaster ? (
    <img
      src={rasterFallbackUrl}
      alt=""
      class={className}
      width="512"
      height="512"
      decoding="async"
      aria-hidden="true"
    />
  ) : (
    <img
      src="/reave-icon.png"
      alt=""
      class={className}
      width="512"
      height="512"
      decoding="async"
      aria-hidden="true"
    />
  )
}
