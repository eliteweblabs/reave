---
import { poweredByLabel, type CompanyConfig } from '../lib/companyConfig';
import SiteLegalLinks from './SiteLegalLinks.astro';
import FootBostonTag from './FootBostonTag.astro';

export interface Props {
  company: CompanyConfig;
  showLegalLinks?: boolean;
  tone?: 'dark' | 'light';
  /** Optional leading label (e.g. document id on signed PDF pages). */
  leading?: string;
  class?: string;
}

const {
  company,
  showLegalLinks = true,
  tone = 'dark',
  leading = '',
  class: className,
} = Astro.props;

const poweredBy = poweredByLabel(company);
---

<footer class:list={['site-foot', `site-foot--${tone}`, className]}>
  <span class="site-foot-brand">{leading || poweredBy}</span>
  <div class="site-foot-meta">
    {showLegalLinks && <SiteLegalLinks />}
    <div class="site-foot-brand-row">
      {leading && <span class="site-foot-powered">{poweredBy}</span>}
      <FootBostonTag />
    </div>
  </div>
</footer>

<style>
  .site-foot {
    margin-top: 36px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.35);
  }

  .site-foot-brand {
    letter-spacing: 0.5px;
  }

  .site-foot-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .site-foot-meta :global(.site-legal-links) {
    padding: 0;
    font-size: 12px;
  }

  .site-foot-brand-row {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-foot-powered {
    letter-spacing: 0.5px;
  }

  .site-foot--light {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid #eee;
    color: #bbb;
  }

  .site-foot--light .site-foot-brand,
  .site-foot--light .site-foot-powered {
    color: #bbb;
  }

  .site-foot--light .site-foot-meta :global(.site-legal-links-sep) {
    color: rgba(0, 0, 0, 0.22);
  }

  .site-foot--light .site-foot-meta :global(.site-legal-links-link) {
    color: rgba(0, 0, 0, 0.42);
  }

  .site-foot--light .site-foot-meta :global(.site-legal-links-link:hover) {
    color: rgba(0, 0, 0, 0.72);
  }

  .site-foot--light .site-foot-meta :global(.site-legal-links-link.active) {
    color: rgba(0, 0, 0, 0.78);
  }
</style>
