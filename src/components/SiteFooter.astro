---
import SiteLegalLinks from './SiteLegalLinks.astro';
import FootBostonTag from './FootBostonTag.astro';

export interface Props {
  showLegalLinks?: boolean;
  tone?: 'dark' | 'light';
  /** Optional leading label (e.g. document id on signed PDF pages). */
  leading?: string;
  class?: string;
}

const {
  showLegalLinks = true,
  tone = 'dark',
  leading = '',
  class: className,
} = Astro.props;
---

<footer class:list={['site-foot', `site-foot--${tone}`, className]}>
  {leading && <span class="site-foot-leading">{leading}</span>}
  <div class="site-foot-meta">
    <FootBostonTag />
    {showLegalLinks && <SiteLegalLinks />}
  </div>
</footer>

<style>
  .site-foot {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    font-size: 12px;
    color: var(--site-fg-muted, #525252);
  }

  .site-foot-leading {
    letter-spacing: 0.5px;
  }

  .site-foot-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .site-foot-meta :global(.site-legal-links) {
    padding: 0;
    font-size: 12px;
  }

  .site-foot--light {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid #eee;
    color: #bbb;
  }

  .site-foot--light .site-foot-leading {
    color: #bbb;
  }

  .site-foot--light .site-foot-meta :global(.site-legal-links-sep) {
    color: rgba(0, 0, 0, 0.22);
  }

  .site-foot--light .site-foot-meta :global(.site-legal-links-link) {
    color: rgba(0, 0, 0, 0.42);
  }

  .site-foot--light .site-foot-meta :global(.site-legal-links-link:hover) {
    color: rgba(0, 0, 0, 0.72);
  }

  .site-foot--light .site-foot-meta :global(.site-legal-links-link.active) {
    color: rgba(0, 0, 0, 0.78);
  }
</style>
