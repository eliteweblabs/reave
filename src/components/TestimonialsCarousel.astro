---
interface Testimonial {
  quote: string;
  name: string;
  title: string;
}

const testimonials: Testimonial[] = [
  {
    quote:
      "I am extremely pleased with the result of our website. Incredibly professional and tuned in to the needs of his clients. High quality work with a quick turn. He delivered on every level.",
    name: "Torey Champagne",
    title: "13x Emmy Winner — ESPN / Comcast",
  },
  {
    quote:
      "His assistance was critical in the smooth launch of Worcester Polytechnic Institute's new website. His abilities with CSS, Photoshop and Dreamweaver were crucial in maintaining our strict timeline.",
    name: "L. Salsich",
    title: "Web Project Manager — Worcester Polytechnic Institute",
  },
  {
    quote:
      "He did a fantastic job building our website from scratch. His creativity and cutting edge web designing skills were exactly what we needed to establish a current, fresh and modern presence.",
    name: "Kathy Singh",
    title: "Director — Stem & Regenerative Medicine Int.",
  },
  {
    quote:
      "Being able to trust one company for my marketing needs is a huge asset. Cost effective pricing, prompt service and quality work.",
    name: "Nick Chacharone",
    title: "President — Aster Group",
  },
  {
    quote:
      "The reave.app simplified my inbox overnight. Triage, contacts, and follow-ups all live in one place — I stopped bouncing between email, CRM, and a dozen other tabs.",
    name: "Tony Barletta Jr.",
    title: "5 Star Loan Officer",
  },
  {
    quote:
      "The site looks like the shop — clean, sharp, and easy to book. Clients pick a chair without calling the front. That is how a barbershop was always meant to run online.",
    name: "Horell Cruz",
    title: "Master Barber — The Barber's Edge",
  },
  {
    quote:
      "I already had a site. What I needed was hosting I could trust and someone to consult when the technical side needed a call. Professional, straightforward, and exactly the support my practice needed.",
    name: "Barry Levine, Esquire",
    title: "The Law Office of Barry R. Levine",
  },
];

const LOOP_COPIES = 3;
const marqueeTestimonials = Array.from({ length: LOOP_COPIES }, () => testimonials).flat();
---

<section class="testimonials-section section--full-bleed" aria-label="Client testimonials">
  <div
    class="testimonials-marquee"
    data-testimonials-marquee
    data-loop-copies={LOOP_COPIES}
    aria-label="Client testimonials. Drag to scroll."
    role="region"
  >
    <div class="testimonials-marquee-drag">
      <div class="testimonials-marquee-track">
        {
          marqueeTestimonials.map((testimonial, index) => (
            <article
              class="testimonial-card"
              aria-hidden={index >= testimonials.length ? "true" : undefined}
            >
              <header class="testimonial-card-header">
                <div class="testimonial-avatar" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="12" cy="9" r="3.5" fill="currentColor" />
                    <path
                      d="M5.5 19.5c1.4-3 3.8-4.5 6.5-4.5s5.1 1.5 6.5 4.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </div>
                <div class="testimonial-card-meta">
                  <p class="testimonial-name">{testimonial.name}</p>
                  <p class="testimonial-title">{testimonial.title}</p>
                </div>
              </header>
              <p class="testimonial-quote">{testimonial.quote}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    margin-bottom: 40px;
  }

  .testimonial-card {
    box-sizing: border-box;
    flex: 0 0 min(340px, 78vw);
    width: min(340px, 78vw);
    margin-right: 16px;
    padding: 20px;
    border-radius: 14px;
    border: 1px solid var(--site-border, rgba(23, 23, 23, 0.12));
    background: rgba(255, 255, 255, 0.82);
    text-align: left;
  }

  html[data-theme="dark"] .testimonial-card {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(0, 0, 0, 0.62);
  }

  .testimonial-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .testimonial-avatar {
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    color: var(--site-fg-muted, #525252);
  }

  html[data-theme="dark"] .testimonial-avatar {
    color: rgba(255, 255, 255, 0.45);
  }

  .testimonial-avatar svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .testimonial-card-meta {
    min-width: 0;
  }

  .testimonial-name {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--site-fg, #171717);
  }

  html[data-theme="dark"] .testimonial-name {
    color: rgba(255, 255, 255, 0.95);
  }

  .testimonial-title {
    margin: 2px 0 0;
    font-size: 13px;
    line-height: 1.35;
    color: var(--site-fg-muted, #525252);
  }

  html[data-theme="dark"] .testimonial-title {
    color: rgba(255, 255, 255, 0.5);
  }

  .testimonial-quote {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--site-fg-muted, #525252);
  }

  html[data-theme="dark"] .testimonial-quote {
    color: rgba(255, 255, 255, 0.78);
  }

  .testimonials-marquee {
    position: relative;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .testimonials-marquee.is-dragging {
    cursor: grabbing;
    touch-action: none;
  }

  .testimonials-marquee-drag {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .testimonials-marquee-track {
    display: flex;
    width: max-content;
    padding: 4px 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    animation: testimonials-marquee-scroll 80s linear infinite;
    will-change: transform;
  }

  /*
   * Hard-code -33.333% (three loop copies). Safari does not interpolate
   * custom properties / calc() inside @keyframes reliably.
   * Cards use margin, not gap, so one third of the track is an exact set.
   */
  @keyframes testimonials-marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-33.33333%, 0, 0);
    }
  }

  @-webkit-keyframes testimonials-marquee-scroll {
    from {
      -webkit-transform: translate3d(0, 0, 0);
      transform: translate3d(0, 0, 0);
    }
    to {
      -webkit-transform: translate3d(-33.33333%, 0, 0);
      transform: translate3d(-33.33333%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials-marquee-track {
      animation-play-state: paused;
    }
  }
</style>

<script>
  import { bootTestimonialsMarquees } from "../lib/testimonialsMarquee";

  bootTestimonialsMarquees();
  document.addEventListener("astro:page-load", () => bootTestimonialsMarquees());
</script>
