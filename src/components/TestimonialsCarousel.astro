---
interface Testimonial {
  quote: string;
  name: string;
  title: string;
}

const testimonials: Testimonial[] = [
  {
    quote:
      "I am extremely pleased with the result of our website. Incredibly professional and tuned in to the needs of his clients. High quality work with a quick turn. He delivered on every level.",
    name: "Torey Champagne",
    title: "13x Emmy Winner — ESPN / Comcast",
  },
  {
    quote:
      "His assistance was critical in the smooth launch of Worcester Polytechnic Institute's new website. His abilities with CSS, Photoshop and Dreamweaver were crucial in maintaining our strict timeline.",
    name: "L. Salsich",
    title: "Web Project Manager — Worcester Polytechnic Institute",
  },
  {
    quote:
      "He did a fantastic job building our website from scratch. His creativity and cutting edge web designing skills were exactly what we needed to establish a current, fresh and modern presence.",
    name: "Kathy Singh",
    title: "Director — Stem & Regenerative Medicine Int.",
  },
  {
    quote:
      "Being able to trust one company for my marketing needs is a huge asset. Cost effective pricing, prompt service and quality work.",
    name: "Nick Chacharone",
    title: "President — Aster Group",
  },
];

const LOOP_COPIES = 2;
const marqueeTestimonials = Array.from({ length: LOOP_COPIES }, () => testimonials).flat();
---

<section class="testimonials-section section--full-bleed" aria-label="Client testimonials">
  <!-- Desktop: infinite scroll, no pointer interaction -->
  <div
    class="testimonials-marquee"
    aria-label="Client testimonials"
    role="region"
    style={`--loop-copies: ${LOOP_COPIES}`}
  >
    <div class="testimonials-marquee-track">
      {
        marqueeTestimonials.map((testimonial, index) => (
          <article
            class="testimonial-card"
            aria-hidden={index >= testimonials.length ? "true" : undefined}
          >
            <header class="testimonial-card-header">
              <div class="testimonial-avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5" />
                  <circle cx="12" cy="9" r="3.5" fill="currentColor" />
                  <path
                    d="M5.5 19.5c1.4-3 3.8-4.5 6.5-4.5s5.1 1.5 6.5 4.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              </div>
              <div class="testimonial-card-meta">
                <p class="testimonial-name">{testimonial.name}</p>
                <p class="testimonial-title">{testimonial.title}</p>
              </div>
            </header>
            <p class="testimonial-quote">{testimonial.quote}</p>
          </article>
        ))
      }
    </div>
  </div>

  <!-- Mobile: centered peek carousel, swipeable + autoplay -->
  <div
    class="testimonials-mobile"
    data-testimonials-mobile
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label="Client testimonials. Swipe to change."
  >
    <div class="testimonials-mobile-track" data-testimonials-mobile-track>
      {
        testimonials.map((testimonial, index) => (
          <article
            class="testimonial-card"
            data-testimonial-slide
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <header class="testimonial-card-header">
              <div class="testimonial-avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5" />
                  <circle cx="12" cy="9" r="3.5" fill="currentColor" />
                  <path
                    d="M5.5 19.5c1.4-3 3.8-4.5 6.5-4.5s5.1 1.5 6.5 4.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              </div>
              <div class="testimonial-card-meta">
                <p class="testimonial-name">{testimonial.name}</p>
                <p class="testimonial-title">{testimonial.title}</p>
              </div>
            </header>
            <p class="testimonial-quote">{testimonial.quote}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    margin-bottom: 40px;
  }

  .testimonial-card {
    box-sizing: border-box;
    padding: 20px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    text-align: left;
  }

  .testimonial-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .testimonial-avatar {
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    color: rgba(255, 255, 255, 0.45);
  }

  .testimonial-avatar svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .testimonial-card-meta {
    min-width: 0;
  }

  .testimonial-name {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.95);
  }

  .testimonial-title {
    margin: 2px 0 0;
    font-size: 13px;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.5);
  }

  .testimonial-quote {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
  }

  /* --- Desktop marquee --- */
  .testimonials-marquee {
    display: none;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .testimonials-marquee-track {
    display: flex;
    gap: 16px;
    width: max-content;
    padding: 4px 0;
    animation: testimonials-marquee-scroll 70s linear infinite;
    will-change: transform;
  }

  @keyframes testimonials-marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-100% / var(--loop-copies, 2)), 0, 0);
    }
  }

  .testimonials-marquee .testimonial-card {
    flex: 0 0 min(340px, 78vw);
  }

  /* --- Mobile carousel --- */
  .testimonials-mobile {
    --card-width: 72vw;
    --card-gap: 12px;
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
  }

  .testimonials-mobile:focus-visible {
    outline: 2px solid rgba(168, 85, 247, 0.65);
    outline-offset: 6px;
    border-radius: 12px;
  }

  .testimonials-mobile-track {
    display: flex;
    gap: var(--card-gap);
    width: max-content;
    padding-inline: calc((100% - var(--card-width)) / 2);
    will-change: transform;
  }

  .testimonials-mobile .testimonial-card {
    flex: 0 0 var(--card-width);
    max-width: 340px;
  }

  @media (min-width: 768px) {
    .testimonials-marquee {
      display: block;
    }

    .testimonials-mobile {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials-marquee-track {
      animation: none;
    }
  }
</style>

<script>
  import { bootTestimonialsMobileCarousels } from "../lib/testimonialsMobileCarousel";

  bootTestimonialsMobileCarousels();
  document.addEventListener("astro:page-load", () => bootTestimonialsMobileCarousels());
</script>
