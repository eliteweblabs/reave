---
interface Testimonial {
  quote: string;
  name: string;
  title: string;
}

const testimonials: Testimonial[] = [
  {
    quote:
      "I am extremely pleased with the result of our website. Incredibly professional and tuned in to the needs of his clients. High quality work with a quick turn. He delivered on every level.",
    name: "Torey Champagne",
    title: "13x Emmy Winner — ESPN / Comcast",
  },
  {
    quote:
      "His assistance was critical in the smooth launch of Worcester Polytechnic Institute's new website. His abilities with CSS, Photoshop and Dreamweaver were crucial in maintaining our strict timeline.",
    name: "L. Salsich",
    title: "Web Project Manager — Worcester Polytechnic Institute",
  },
  {
    quote:
      "He did a fantastic job building our website from scratch. His creativity and cutting edge web designing skills were exactly what we needed to establish a current, fresh and modern presence.",
    name: "Kathy Singh",
    title: "Director — Stem & Regenerative Medicine Int.",
  },
  {
    quote:
      "Being able to trust one company for my marketing needs is a huge asset. Cost effective pricing, prompt service and quality work.",
    name: "Nick Chacharone",
    title: "President — Aster Group",
  },
  {
    quote:
      "The REΛVE app simplified my inbox overnight. Triage, contacts, and follow-ups all live in one place — I stopped bouncing between email, CRM, and a dozen other tabs.",
    name: "Tony Barletta Jr.",
    title: "5 Star Loan Officer",
  },
  {
    quote:
      "The site looks like the shop — clean, sharp, and easy to book. Clients pick a chair without calling the front. That is how a barbershop was always meant to run online.",
    name: "Horell Cruz",
    title: "Master Barber — The Barber's Edge",
  },
  {
    quote:
      "I already had a site. What I needed was hosting I could trust and someone to consult when the technical side needed a call. Professional, straightforward, and exactly the support my practice needed.",
    name: "Barry Levine, Esquire",
    title: "The Law Office of Barry R. Levine",
  },
];

const LOOP_COPIES = 2;
const marqueeTestimonials = Array.from({ length: LOOP_COPIES }, () => testimonials).flat();
---

<section class="testimonials-section section--full-bleed" aria-label="Client testimonials">
  <!-- Desktop: infinite scroll, no pointer interaction -->
  <div
    class="testimonials-marquee"
    aria-label="Client testimonials"
    role="region"
  >
    <div class="testimonials-marquee-track">
      {
        marqueeTestimonials.map((testimonial, index) => (
          <article
            class="testimonial-card"
            aria-hidden={index >= testimonials.length ? "true" : undefined}
          >
            <header class="testimonial-card-header">
              <div class="testimonial-avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5" />
                  <circle cx="12" cy="9" r="3.5" fill="currentColor" />
                  <path
                    d="M5.5 19.5c1.4-3 3.8-4.5 6.5-4.5s5.1 1.5 6.5 4.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              </div>
              <div class="testimonial-card-meta">
                <p class="testimonial-name">{testimonial.name}</p>
                <p class="testimonial-title">{testimonial.title}</p>
              </div>
            </header>
            <p class="testimonial-quote">{testimonial.quote}</p>
          </article>
        ))
      }
    </div>
  </div>

  <!-- Mobile: centered peek carousel, swipeable + autoplay -->
  <div
    class="testimonials-mobile"
    data-testimonials-mobile
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label="Client testimonials. Swipe to change."
  >
    <div class="testimonials-mobile-track" data-testimonials-mobile-track>
      {
        testimonials.map((testimonial, index) => (
          <article
            class="testimonial-card"
            data-testimonial-slide
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <header class="testimonial-card-header">
              <div class="testimonial-avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5" />
                  <circle cx="12" cy="9" r="3.5" fill="currentColor" />
                  <path
                    d="M5.5 19.5c1.4-3 3.8-4.5 6.5-4.5s5.1 1.5 6.5 4.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              </div>
              <div class="testimonial-card-meta">
                <p class="testimonial-name">{testimonial.name}</p>
                <p class="testimonial-title">{testimonial.title}</p>
              </div>
            </header>
            <p class="testimonial-quote">{testimonial.quote}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    margin-bottom: 40px;
  }

  .testimonial-card {
    box-sizing: border-box;
    padding: 20px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(0, 0, 0, 0.62);
    text-align: left;
  }

  .testimonial-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .testimonial-avatar {
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    color: rgba(255, 255, 255, 0.45);
  }

  .testimonial-avatar svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .testimonial-card-meta {
    min-width: 0;
  }

  .testimonial-name {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.95);
  }

  .testimonial-title {
    margin: 2px 0 0;
    font-size: 13px;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.5);
  }

  .testimonial-quote {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
  }

  /* --- Desktop marquee --- */
  .testimonials-marquee {
    display: none;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .testimonials-marquee-track {
    display: flex;
    gap: 16px;
    width: max-content;
    padding: 4px 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    animation: testimonials-marquee-scroll 130s linear infinite;
    -webkit-animation: testimonials-marquee-scroll 130s linear infinite;
  }

  /*
   * Hard-code -50% (two loop copies). Safari does not interpolate
   * custom properties / calc() inside @keyframes reliably, which made
   * the desktop marquee look stuck on iPad.
   */
  @keyframes testimonials-marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @-webkit-keyframes testimonials-marquee-scroll {
    from {
      -webkit-transform: translate3d(0, 0, 0);
      transform: translate3d(0, 0, 0);
    }
    to {
      -webkit-transform: translate3d(-50%, 0, 0);
      transform: translate3d(-50%, 0, 0);
    }
  }

  .testimonials-marquee .testimonial-card {
    flex: 0 0 min(340px, 78vw);
  }

  /* --- Touch / small-viewport carousel (native scroll-snap) --- */
  .testimonials-mobile {
    --card-width: min(72vw, 340px);
    --card-gap: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    touch-action: auto;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
  }

  .testimonials-mobile::-webkit-scrollbar {
    display: none;
  }

  .testimonials-mobile:focus-visible {
    outline: 2px solid rgba(168, 85, 247, 0.65);
    outline-offset: 6px;
    border-radius: 12px;
  }

  .testimonials-mobile-track {
    display: flex;
    gap: var(--card-gap);
    width: max-content;
    padding-inline: calc((100% - var(--card-width)) / 2);
  }

  .testimonials-mobile .testimonial-card {
    flex: 0 0 var(--card-width);
    max-width: 340px;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  @media (min-width: 768px) and (hover: hover) and (pointer: fine) {
    .testimonials-marquee {
      display: block;
    }

    .testimonials-mobile {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials-marquee-track {
      animation: none;
      -webkit-animation: none;
    }

    .testimonials-mobile {
      scroll-snap-type: x mandatory;
    }
  }
</style>

<script>
  import { bootTestimonialsMobileCarousels } from "../lib/testimonialsMobileCarousel";

  bootTestimonialsMobileCarousels();
  document.addEventListener("astro:page-load", () => bootTestimonialsMobileCarousels());
</script>
