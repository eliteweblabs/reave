---
import BrandIconInline from "./BrandIconInline.astro";
import { getCompanyConfig } from "../lib/companyConfig";

interface Props {
  slug: string;
  /** Inline on marketing pages instead of full-screen /form route. */
  embedded?: boolean;
  /**
   * Compact footer dock: input only until the user sends.
   * Skips the opening robot greeting so a host intro bubble can sit above.
   */
  dock?: boolean;
  /** Match homepage hero demo chat — avatars + bubble layout. */
  heroChat?: boolean;
  /** Brand name for SMS consent disclaimer copy. */
  brandName?: string;
  /** Override the first field’s input placeholder (embedded footers, etc.). */
  inputPlaceholder?: string;
}

const {
  slug,
  embedded = false,
  dock = false,
  heroChat = false,
  brandName = "reave.app",
  inputPlaceholder = "",
} = Astro.props;
const company = heroChat ? await getCompanyConfig(Astro.request) : null;
const bookingApiUrl = import.meta.env.PUBLIC_BOOKING_API_URL || "";
const rootClass = [
  "conversational-form-root",
  embedded || dock ? "conversational-form-root--embedded" : "",
  dock ? "conversational-form-root--dock" : "",
  heroChat ? "conversational-form-root--hero-chat" : "",
]
  .filter(Boolean)
  .join(" ");
---

<div class={rootClass} data-cf-dock={dock ? "1" : undefined} data-cf-hero-chat={heroChat ? "1" : undefined}>
  {
    heroChat && company && (
      <>
        <template id="cf-agent-avatar">
          <span class="cf-avatar cf-avatar--agent" aria-hidden="true">
            <BrandIconInline
              company={company}
              class="cf-avatar-icon"
              idPrefix="cf-agent"
            />
          </span>
        </template>
        <template id="cf-user-avatar">
          <span class="cf-avatar cf-avatar--user" aria-hidden="true">
            <svg class="cf-avatar-photo" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <linearGradient id="cf-user-bg" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#64748b"></stop>
                  <stop offset="100%" stop-color="#334155"></stop>
                </linearGradient>
              </defs>
              <rect width="64" height="64" rx="32" fill="url(#cf-user-bg)"></rect>
              <circle cx="32" cy="24" r="11" fill="#e2e8f0"></circle>
              <ellipse cx="32" cy="54" rx="18" ry="14" fill="#e2e8f0"></ellipse>
            </svg>
          </span>
        </template>
      </>
    )
  }
  <form id="conversational-form" class="conversation">
    <div class="conversation-scroll" id="conversation-scroll">
      <div id="questions-container"></div>
    </div>

    <div class="input-area" id="input-area">
      <div class="input-pill">
        <input type="text" id="user-input" placeholder={inputPlaceholder || "Type your answer…"} autocomplete="off" />
        <button type="submit">Send</button>
      </div>
    </div>
  </form>

  <div id="success-message" class="hidden">
    <h2>&#10003; All done!</h2>
    <p id="success-text"></p>
  </div>

  <div id="error-message" class="hidden">
    <p id="error-text"></p>
    <button id="retry-btn" type="button">Try again</button>
  </div>
</div>

<style is:global>
  .conversational-form-root {
    --cf-input-h: 3rem;
    max-width: 640px;
    margin: 0 auto;
    min-height: calc(100dvh - 4.5rem);
    padding:
      calc(4.5rem + env(safe-area-inset-top, 0px))
      max(1rem, env(safe-area-inset-right, 0px))
      calc(var(--cf-input-h) + 1.5rem + env(safe-area-inset-bottom, 0px))
      max(1rem, env(safe-area-inset-left, 0px));
    color: var(--site-fg, #171717);
    font-family: "Inter", sans-serif;
  }

  .conversational-form-root--embedded {
    max-width: none;
    min-height: 0;
    margin: 16px 0 0;
    padding: 20px 18px 24px;
    border-radius: 14px;
    border: 1px solid var(--site-card-border, rgba(23, 23, 23, 0.1));
    background: var(--site-card, rgba(23, 23, 23, 0.03));
  }

  .conversational-form-root .conversation {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 100%;
  }

  .conversational-form-root .conversation-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }

  .conversational-form-root #questions-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .conversational-form-root .conversation-scroll::-webkit-scrollbar {
    display: none;
  }

  .conversational-form-root .message {
    max-width: 88%;
    animation: cfFadeIn 0.3s ease;
    line-height: 1.55;
    font-size: 15px;
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }

  .conversational-form-root .message.robot {
    align-self: flex-start;
    padding: 10px 14px;
    border-radius: 14px;
    border-bottom-left-radius: 4px;
    background: var(--site-card, rgba(23, 23, 23, 0.03));
    border: 1px solid var(--site-card-border, rgba(23, 23, 23, 0.1));
    color: var(--site-fg, #171717);
  }

  .conversational-form-root .message.robot .word {
    display: inline;
  }

  .conversational-form-root .message.robot .word.just-typed {
    filter: blur(0);
    opacity: 1;
  }

  .conversational-form-root .message.user {
    align-self: flex-end;
    text-align: right;
    padding: 10px 14px;
    border-radius: 14px;
    border-bottom-right-radius: 4px;
    background: var(--site-card, rgba(23, 23, 23, 0.04));
    border: 1px solid var(--site-card-border, rgba(23, 23, 23, 0.12));
    color: var(--site-fg, #171717);
  }

  .conversational-form-root .options-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-self: flex-start;
    max-width: 100%;
    padding: 0.15rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    animation: cfFadeIn 0.3s ease;
  }

  .conversational-form-root .option-btn {
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--site-border, rgba(23, 23, 23, 0.14));
    background: var(--site-card, rgba(23, 23, 23, 0.04));
    color: var(--site-fg, #171717);
    font-size: 14px;
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.15s;
  }

  .conversational-form-root .option-btn:hover {
    background: var(--brand-glass-bg-hover, rgba(23, 23, 23, 0.07));
    border-color: var(--site-fg, #171717);
    transform: translateY(-1px);
  }

  .conversational-form-root .loading-msg {
    color: var(--site-fg-muted, #525252);
    font-style: italic;
    font-size: 14px;
    align-self: flex-start;
    animation: cfFadeIn 0.3s ease;
  }

  .conversational-form-root .input-area {
    display: flex;
    position: fixed;
    left: 50%;
    bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    max-width: 640px;
    width: min(640px, calc(100% - 2rem));
    z-index: 20;
  }

  .conversational-form-root--embedded .conversation-scroll {
    max-height: min(52vh, 26rem);
  }

  .conversational-form-root--embedded .input-area {
    position: sticky;
    bottom: 0;
    left: auto;
    transform: none;
    width: 100%;
    max-width: none;
    margin-top: 8px;
    z-index: 1;
  }

  .conversational-form-root--dock {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .conversational-form-root--dock:not(.is-active) .conversation-scroll,
  .conversational-form-root--dock:not(.is-active) #success-message,
  .conversational-form-root--dock:not(.is-active) #error-message {
    display: none;
  }

  .conversational-form-root--dock .input-area {
    position: static;
    margin-top: 0;
  }

  .conversational-form-root--dock.is-active {
    padding: 0.75rem 0.85rem 0.85rem;
    border-radius: 1rem;
    border: 1px solid rgba(15, 23, 42, 0.1);
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.14);
  }

  .conversational-form-root--dock.is-active .conversation-scroll {
    display: flex;
    max-height: min(32vh, 14rem);
  }

  .conversational-form-root--dock.is-active .input-area {
    margin-top: 0.55rem;
  }

  .conversational-form-root .input-pill {
    display: flex;
    align-items: stretch;
    flex: 1;
    min-width: 0;
    border-radius: 999px;
    border: 1px solid var(--site-border, rgba(23, 23, 23, 0.14));
    background: var(--site-card, rgba(23, 23, 23, 0.03));
    overflow: hidden;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .conversational-form-root .input-pill:focus-within {
    border-color: var(--site-fg, #171717);
    box-shadow: none;
  }

  .conversational-form-root .input-pill input {
    flex: 1;
    min-width: 0;
    width: 0;
    padding: 10px 14px;
    border: none;
    border-radius: 0;
    background: transparent;
    color: var(--site-fg, #171717);
    font-size: 16px;
    outline: none;
  }

  .conversational-form-root .input-pill input::placeholder {
    color: var(--site-fg-faint, #a3a3a3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .conversational-form-root .input-pill button[type="submit"] {
    flex-shrink: 0;
    padding: 10px 18px;
    border: none;
    border-radius: 0;
    background: var(--brand-btn-bg, #111);
    color: var(--brand-btn-fg, #fff);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .conversational-form-root .input-pill button[type="submit"]:hover {
    opacity: 0.92;
  }

  @media (max-width: 640px) {
    .conversational-form-root {
      padding-left: max(0.75rem, env(safe-area-inset-left, 0px));
      padding-right: max(0.75rem, env(safe-area-inset-right, 0px));
    }

    .conversational-form-root .message {
      max-width: 92%;
      font-size: 14px;
    }

    .conversational-form-root .input-area {
      width: calc(100% - 1.5rem);
    }

    .conversational-form-root .input-pill input {
      padding: 9px 12px;
    }

    .conversational-form-root .input-pill button[type="submit"] {
      padding: 9px 14px;
      font-size: 13px;
    }
  }

  .conversational-form-root #success-message h2 {
    background: none;
    color: var(--site-fg, #171717);
    -webkit-text-fill-color: var(--site-fg, #171717);
    margin: 0 0 8px;
    font-size: 22px;
  }

  .conversational-form-root #success-message p {
    margin: 0;
    color: var(--site-fg-muted, #525252);
  }

  .conversational-form-root #error-message {
    padding: 20px;
    border-radius: 12px;
    border: 1px solid rgba(239, 68, 68, 0.4);
    background: rgba(239, 68, 68, 0.1);
    color: #fca5a5;
  }

  .conversational-form-root #retry-btn {
    margin-top: 12px;
    padding: 10px 20px;
    border-radius: 10px;
    border: 1px solid rgba(239, 68, 68, 0.5);
    background: transparent;
    color: #fca5a5;
    cursor: pointer;
    font-size: 14px;
    transition: background 0.2s;
  }

  .conversational-form-root #retry-btn:hover {
    background: rgba(239, 68, 68, 0.15);
  }

  .conversational-form-root .hidden {
    display: none !important;
  }

  .conversational-form-root .sms-consent-panel {
    align-self: flex-start;
    max-width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--site-border, rgba(23, 23, 23, 0.12));
    background: var(--site-card, rgba(23, 23, 23, 0.03));
    animation: cfFadeIn 0.3s ease;
  }

  .conversational-form-root .sms-consent-panel h3 {
    margin: 0 0 10px;
    font-size: 14px;
    font-weight: 700;
    color: var(--site-fg, #171717);
  }

  .conversational-form-root .sms-consent-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 14px;
    line-height: 1.45;
    cursor: pointer;
  }

  .conversational-form-root .sms-consent-label input {
    margin-top: 3px;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    accent-color: var(--site-fg, #171717);
  }

  .conversational-form-root .sms-consent-disclaimer {
    margin: 0 0 8px;
    font-size: 12px;
    line-height: 1.55;
    color: var(--site-fg-muted, #525252);
  }

  .conversational-form-root .sms-consent-links {
    margin: 0 0 12px;
    font-size: 12px;
  }

  .conversational-form-root .sms-consent-links a {
    color: var(--site-accent, #171717);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .conversational-form-root .sms-consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @keyframes cfFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Homepage hero demo chat — avatars + bubble turns */
  .conversational-form-root--hero-chat.conversational-form-root--embedded {
    padding: 0;
    border: none;
    background: transparent;
  }

  .conversational-form-root--hero-chat .conversation-scroll {
    gap: 0;
  }

  .conversational-form-root--hero-chat #questions-container {
    gap: 16px;
  }

  .conversational-form-root--hero-chat .cf-msg {
    --cf-gutter: clamp(1.5rem, 18%, 4.5rem);
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    width: 100%;
    animation: cfFadeIn 0.3s ease;
  }

  .conversational-form-root--hero-chat .cf-msg--assistant {
    justify-content: flex-start;
    padding-inline-end: var(--cf-gutter);
  }

  .conversational-form-root--hero-chat .cf-msg--user {
    justify-content: flex-end;
    padding-inline-start: var(--cf-gutter);
  }

  .conversational-form-root--hero-chat .cf-avatar {
    flex: none;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--demo-line, var(--site-border, rgba(255, 255, 255, 0.14)));
    background: var(--demo-avatar-bg, var(--site-card, rgba(255, 255, 255, 0.06)));
  }

  .conversational-form-root--hero-chat .cf-avatar--agent {
    padding: 0.28rem;
  }

  .conversational-form-root--hero-chat .cf-avatar-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    color: var(--site-fg, #171717);
  }

  html[data-theme="dark"] .conversational-form-root--hero-chat .cf-avatar-icon {
    filter: invert(1);
  }

  .conversational-form-root--hero-chat .cf-avatar-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .conversational-form-root--hero-chat .message {
    max-width: min(100%, 22rem);
    margin: 0;
    animation: none;
  }

  .conversational-form-root--hero-chat .message.robot,
  .conversational-form-root--hero-chat .message.user {
    align-self: auto;
    text-align: left;
    padding: 0.55rem 0.78rem;
    border-radius: 1rem;
    font-family: var(--font-content, inherit);
    font-size: clamp(0.8rem, 2vw, 0.92rem);
    line-height: 1.45;
    color: var(--demo-fg, var(--site-fg, #171717));
    background: var(--demo-bubble-fill, var(--site-card, rgba(255, 255, 255, 0.06)));
    border: 1px solid var(--demo-line, var(--site-border, rgba(255, 255, 255, 0.14)));
  }

  .conversational-form-root--hero-chat .message.robot {
    border-bottom-left-radius: 0.28rem;
  }

  .conversational-form-root--hero-chat .message.user {
    border-bottom-right-radius: 0.28rem;
  }

  .conversational-form-root--hero-chat .loading-msg {
    display: none;
  }

  .conversational-form-root--hero-chat .cf-typing-bubble {
    display: flex;
    align-items: center;
    min-height: 1.45rem;
    padding: 0.62rem 0.78rem;
    border-radius: 1rem;
    border-bottom-left-radius: 0.28rem;
    border: 1px solid var(--demo-line, var(--site-border, rgba(255, 255, 255, 0.14)));
    background: var(--demo-bubble-fill, var(--site-card, rgba(255, 255, 255, 0.06)));
  }

  .conversational-form-root--hero-chat .cf-typing-dots {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    height: 0.55rem;
  }

  .conversational-form-root--hero-chat .cf-typing-dots span {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: var(--demo-fg-muted, var(--site-fg-muted, #a3a3a3));
    animation: cfTypingDot 1.46s ease-in-out infinite;
  }

  .conversational-form-root--hero-chat .cf-typing-dots span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .conversational-form-root--hero-chat .cf-typing-dots span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes cfTypingDot {
    0%, 60%, 100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  .conversational-form-root--hero-chat .options-wrapper {
    align-self: auto;
    padding: 0;
    background: transparent;
    gap: 8px;
  }

  .conversational-form-root--hero-chat .option-btn {
    border-radius: 999px;
    border: 1px solid var(--demo-line, var(--site-border, rgba(255, 255, 255, 0.14)));
    background: var(--demo-bubble-fill, var(--site-card, rgba(255, 255, 255, 0.06)));
    color: var(--demo-fg, var(--site-fg, #171717));
    font-size: 0.82rem;
  }

  .conversational-form-root--hero-chat .option-btn:hover {
    border-color: var(--site-fg, #171717);
    background: color-mix(in srgb, var(--site-fg) 8%, transparent);
  }

  .conversational-form-root--hero-chat .sms-consent-panel {
    max-width: min(100%, 22rem);
    border-radius: 1rem;
    border-bottom-left-radius: 0.28rem;
    border-color: var(--demo-line, var(--site-border, rgba(255, 255, 255, 0.14)));
    background: var(--demo-bubble-fill, var(--site-card, rgba(255, 255, 255, 0.06)));
  }

  .conversational-form-root--hero-chat.conversational-form-root--embedded .input-area {
    justify-content: center;
  }

  .conversational-form-root--hero-chat.conversational-form-root--embedded .input-pill {
    flex: 0 1 auto;
    width: min(100%, 420px);
    max-width: 420px;
  }
</style>

<script define:vars={{ bookingApiUrl, slug, brandName, embedded, dock, inputPlaceholder, heroChat }}>
  const BOOKING_API = bookingApiUrl;
  const FORM_SLUG = slug;
  const BRAND_NAME = brandName;
  const IS_EMBEDDED = Boolean(embedded) || Boolean(dock);
  const IS_DOCK = Boolean(dock);
  const HERO_CHAT = Boolean(heroChat);
  const INPUT_PLACEHOLDER_OVERRIDE = String(inputPlaceholder || "").trim();
  const SMS_USE_CASES = "inquiry updates and appointment reminders";

  function smsConsentCheckboxLabel() {
    return `I agree to receive SMS ${SMS_USE_CASES} from ${BRAND_NAME}.`;
  }

  function smsConsentDisclaimer() {
    return `By providing your phone number, you agree to receive SMS ${SMS_USE_CASES} from ${BRAND_NAME}. Message frequency may vary. Standard Message and Data Rates may apply. Reply STOP to opt out. Reply HELP for help. We will not share mobile information with third parties for promotional or marketing purposes.`;
  }

  let currentFieldIndex = 0;
  let formData = {};
  let formDef = null;
  let availabilityDays = [];
  let typewriterInProgress = false;
  let urlPrefill = {};

  const root = () => document.querySelector(".conversational-form-root");
  const container = () => root()?.querySelector("#questions-container");
  const scrollArea = () => root()?.querySelector("#conversation-scroll");
  const inputArea = () => root()?.querySelector("#input-area");
  const userInput = () => root()?.querySelector("#user-input");

  function scrollToLatest() {
    const area = scrollArea();
    if (!area) return;
    area.scrollTop = area.scrollHeight;
  }

  // Placeholders clip with an ellipsis, so only short prompts move into the input.
  const MAX_PLACEHOLDER_LENGTH = 48;

  function placeholderForField(field, prompt) {
    if (prompt && prompt.length <= MAX_PLACEHOLDER_LENGTH) return prompt;
    switch (field.type) {
      case "email":
        return "you@example.com";
      case "tel":
        return "Phone number";
      case "password":
        return "Password";
      case "textarea":
        return "Type your message…";
      default:
        if (field.name === "name") return "Your name";
        if (field.name === "company") return "Company name";
        if (field.name === "website") return "example.com";
        if (field.name === "registrar_username") return "Registrar login email";
        return "Type your answer…";
    }
  }

  function inputModeForField(field) {
    const input = userInput();
    if (!input) return;
    if (field.type === "password") {
      input.type = "password";
      input.inputMode = "text";
      input.autocomplete = "current-password";
      return;
    }
    input.type = field.type === "email" ? "email" : "text";
    input.inputMode =
      field.type === "email"
        ? "email"
        : field.type === "tel"
          ? "tel"
          : "text";
    input.autocomplete = field.name === "email" ? "email" : field.name === "name" ? "name" : "off";
  }

  function getPrefillFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const prefill = {};
    for (const [key, value] of params) {
      const trimmed = value.trim();
      if (trimmed) prefill[key] = trimmed;
    }
    return prefill;
  }

  function firstNameFrom(fullName) {
    const trimmed = String(fullName || "").trim();
    if (!trimmed) return "";
    return trimmed.split(/\s+/)[0] || "";
  }

  function interpolateQuestion(text) {
    const registrarLabel = String(formData.registrar || "").trim() || "domain registrar";
    const domainLabel =
      String(formData.domain || formData.website || "").trim() || "your domain";
    return String(text || "")
      .replace(/\{\{registrar\}\}/g, registrarLabel)
      .replace(/\{\{domain\}\}/g, domainLabel);
  }

  function fieldShouldShow(field) {
    const cond = field["cf-show-if"];
    if (!cond) return true;
    if (cond === "phone") {
      return Boolean(String(formData.phone || "").trim());
    }
    const expected = field["cf-show-if-value"];
    const value = formData[cond];
    if (expected !== undefined && expected !== null && expected !== "") {
      return String(value || "") === String(expected);
    }
    return Boolean(String(value || "").trim());
  }

  function advanceToNextVisibleField() {
    while (formDef && currentFieldIndex < formDef.fields.length) {
      const field = formDef.fields[currentFieldIndex];
      if (fieldShouldShow(field)) return field;
      currentFieldIndex++;
    }
    return null;
  }

  function showOptionalSkip(onSkip) {
    showOptionButtons([{ value: "skip", label: "Skip" }], () => onSkip());
  }

  function applyPrefill() {
    if (!formDef) return 0;
    let skipped = 0;
    while (currentFieldIndex < formDef.fields.length) {
      const field = formDef.fields[currentFieldIndex];
      const value = urlPrefill[field.name];
      if (!value) break;
      formData[field.name] = value;
      currentFieldIndex++;
      skipped++;
    }
    return skipped;
  }

  function activateDock() {
    const el = root();
    if (!el || !IS_DOCK || el.classList.contains("is-active")) return;
    el.classList.add("is-active");
    el.dispatchEvent(new CustomEvent("cf-dock-expand", { bubbles: true }));
  }

  async function prepareDockField() {
    const field = advanceToNextVisibleField();
    if (!field) {
      activateDock();
      await submitForm();
      return;
    }
    if (
      field.type === "availability" ||
      field.type === "domain_lookup" ||
      (field.type === "select" && field.options) ||
      field.type === "sms_consent"
    ) {
      activateDock();
      await showQuestion();
      return;
    }
    const questionText = field["cf-questions"] || `What's your ${field.name}?`;
    const parts = questionText.split("&&").map((s) => s.trim());
    const promptLine = parts[parts.length - 1];
    const defaultPlaceholder = placeholderForField(field, promptLine);
    const placeholder = INPUT_PLACEHOLDER_OVERRIDE || defaultPlaceholder;
    setInputVisible(true);
    inputModeForField(field);
    if (userInput()) {
      userInput().placeholder = placeholder;
      userInput().setAttribute("aria-label", promptLine || placeholder);
      userInput().value = "";
    }
  }

  async function loadForm() {
    urlPrefill = getPrefillFromUrl();
    try {
      const res = await fetch(`/forms/${FORM_SLUG}.json`);
      if (!res.ok) throw new Error("Form not found");
      formDef = await res.json();
      const skipped = applyPrefill();
      if (skipped > 0 && urlPrefill.name) {
        const firstName = firstNameFrom(urlPrefill.name);
        if (firstName) {
          activateDock();
          await appendTypewriter(`Hi ${firstName}!`);
          await delay(300);
        }
      }
      if (IS_DOCK && skipped === 0) {
        await prepareDockField();
      } else {
        if (skipped > 0) activateDock();
        await showQuestion();
      }
    } catch (err) {
      console.error(err);
      activateDock();
      showError("This form could not be loaded. Please try again later.");
    }
  }

  function cloneAvatar(role) {
    const id = role === "agent" ? "cf-agent-avatar" : "cf-user-avatar";
    const tpl = root()?.querySelector(`#${id}`);
    return tpl?.content?.firstElementChild?.cloneNode(true) ?? null;
  }

  function wrapChatTurn(el, role) {
    if (!HERO_CHAT) return el;
    const row = document.createElement("div");
    row.className = `cf-msg cf-msg--${role === "user" ? "user" : "assistant"}`;
    if (role !== "user") {
      const avatar = cloneAvatar("agent");
      if (avatar) row.appendChild(avatar);
    }
    row.appendChild(el);
    if (role === "user") {
      const avatar = cloneAvatar("user");
      if (avatar) row.appendChild(avatar);
    }
    return row;
  }

  function appendMessage(text, type) {
    const msg = document.createElement("div");
    msg.className = `message ${type}`;
    msg.textContent = text;
    container()?.appendChild(wrapChatTurn(msg, type));
    scrollToLatest();
  }

  async function appendTypewriter(text) {
    const msg = document.createElement("div");
    msg.className = "message robot";
    const row = wrapChatTurn(msg, "assistant");
    container()?.appendChild(row);
    scrollToLatest();

    const words = text.split(" ");
    typewriterInProgress = true;

    for (let i = 0; i < words.length; i++) {
      const wordSpan = document.createElement("span");
      wordSpan.className = "word just-typed";
      wordSpan.textContent = words[i] + (i < words.length - 1 ? " " : "");
      wordSpan.style.filter = "blur(8px)";
      wordSpan.style.opacity = "0.3";
      wordSpan.style.transition = "filter 0.15s ease-out, opacity 0.15s ease-out";
      msg.appendChild(wordSpan);
      wordSpan.offsetHeight;
      wordSpan.style.filter = "blur(0)";
      wordSpan.style.opacity = "1";
      scrollToLatest();
      await new Promise((r) => setTimeout(r, 60));
    }

    typewriterInProgress = false;
  }

  function appendLoading(text) {
    if (HERO_CHAT) {
      const row = document.createElement("div");
      row.className = "cf-msg cf-msg--assistant cf-msg--loading";
      row.dataset.cfLoading = "1";
      const avatar = cloneAvatar("agent");
      if (avatar) row.appendChild(avatar);
      const bubble = document.createElement("div");
      bubble.className = "cf-typing-bubble";
      bubble.setAttribute("aria-label", text || "Loading");
      bubble.innerHTML =
        '<span class="cf-typing-dots" aria-hidden="true"><span></span><span></span><span></span></span>';
      row.appendChild(bubble);
      container()?.appendChild(row);
      scrollToLatest();
      return row;
    }
    const el = document.createElement("div");
    el.className = "loading-msg";
    el.textContent = text;
    container()?.appendChild(el);
    scrollToLatest();
    return el;
  }

  function showOptionButtons(options, onPick) {
    root()?.querySelector("#current-options")?.remove();

    const wrapper = document.createElement("div");
    wrapper.className = "options-wrapper";
    wrapper.id = "current-options";

    options.forEach((opt) => {
      const btn = document.createElement("button");
      btn.className = "option-btn";
      btn.textContent = opt.label;
      btn.type = "button";
      btn.addEventListener("click", () => {
        wrapper.closest(".cf-msg")?.remove();
        wrapper.remove();
        onPick(opt.value, opt.label);
      });
      wrapper.appendChild(btn);
    });

    if (HERO_CHAT) {
      const row = document.createElement("div");
      row.className = "cf-msg cf-msg--assistant";
      row.id = "current-options-row";
      const avatar = cloneAvatar("agent");
      if (avatar) row.appendChild(avatar);
      row.appendChild(wrapper);
      container()?.appendChild(row);
    } else {
      container()?.appendChild(wrapper);
    }
    scrollToLatest();
  }

  function setInputVisible(visible) {
    if (inputArea()) inputArea().style.display = visible ? "flex" : "none";
  }

  async function delay(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  async function showMessages(text) {
    const parts = text.split("&&").map((s) => s.trim());
    for (let i = 0; i < parts.length; i++) {
      if (i > 0) await delay(500);
      await appendTypewriter(parts[i]);
    }
    await delay(300);
  }

  function showSmsConsentPanel(field, onComplete) {
    root()?.querySelector("#current-options")?.remove();
    root()?.querySelector("#sms-consent-panel")?.remove();
    setInputVisible(false);

    const panel = document.createElement("div");
    panel.className = "sms-consent-panel";
    panel.id = "sms-consent-panel";

    const heading = document.createElement("h3");
    heading.textContent = field["cf-questions"] || "Optional SMS updates";
    panel.appendChild(heading);

    const label = document.createElement("label");
    label.className = "sms-consent-label";

    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.name = field.name;
    checkbox.value = "yes";

    const labelText = document.createElement("span");
    labelText.textContent = smsConsentCheckboxLabel();

    label.appendChild(checkbox);
    label.appendChild(labelText);
    panel.appendChild(label);

    const disclaimer = document.createElement("p");
    disclaimer.className = "sms-consent-disclaimer";
    disclaimer.textContent = smsConsentDisclaimer();
    panel.appendChild(disclaimer);

    const links = document.createElement("p");
    links.className = "sms-consent-links";
    links.innerHTML =
      '<a href="/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>' +
      ' · ' +
      '<a href="/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a>';
    panel.appendChild(links);

    const actions = document.createElement("div");
    actions.className = "sms-consent-actions";

    const continueBtn = document.createElement("button");
    continueBtn.type = "button";
    continueBtn.className = "option-btn";
    continueBtn.textContent = "Continue";
    continueBtn.addEventListener("click", () => {
      const optedIn = checkbox.checked;
      panel.remove();
      onComplete(optedIn ? "yes" : "no", optedIn ? "SMS updates: Yes" : "SMS updates: No");
    });

    const skipBtn = document.createElement("button");
    skipBtn.type = "button";
    skipBtn.className = "option-btn";
    skipBtn.textContent = "Skip SMS updates";
    skipBtn.addEventListener("click", () => {
      panel.remove();
      onComplete("no", "SMS updates: No");
    });

    actions.appendChild(continueBtn);
    actions.appendChild(skipBtn);
    panel.appendChild(actions);

    container()?.appendChild(panel);
    scrollToLatest();
  }

  async function showQuestion() {
    const field = advanceToNextVisibleField();
    if (!field) {
      await submitForm();
      return;
    }

    let questionText = interpolateQuestion(field["cf-questions"] || `What's your ${field.name}?`);
    if (field.name === "email" && formData.name) {
      const firstName = firstNameFrom(formData.name);
      questionText = firstName
        ? `Nice to meet you, ${firstName}!&&What's your email address?`
        : "What's your email address?";
    }
    const parts = questionText.split("&&").map((s) => s.trim());

    if (field.type === "availability" || (field.type === "select" && field.options)) {
      await showMessages(questionText);
      if (field.type === "availability") {
        setInputVisible(false);
        await handleAvailabilityField(field);
      } else {
        setInputVisible(false);
        showOptionButtons(field.options, (value, label) => {
          appendMessage(label, "user");
          formData[field.name] = value;
          currentFieldIndex++;
          setTimeout(showQuestion, 500);
        });
      }
    } else if (field.type === "sms_consent") {
      await showMessages(questionText);
      showSmsConsentPanel(field, (value, label) => {
        appendMessage(label, "user");
        formData[field.name] = value;
        currentFieldIndex++;
        setTimeout(showQuestion, 500);
      });
    } else {
      const promptLine = parts[parts.length - 1];
      const defaultPlaceholder = placeholderForField(field, promptLine);
      const placeholder =
        currentFieldIndex === 0 && INPUT_PLACEHOLDER_OVERRIDE
          ? INPUT_PLACEHOLDER_OVERRIDE
          : defaultPlaceholder;
      const spokenLines =
        defaultPlaceholder === promptLine ? parts.slice(0, -1) : parts;
      for (let i = 0; i < spokenLines.length; i++) {
        if (i > 0) await delay(500);
        if (i === spokenLines.length - 1) {
          await appendTypewriter(spokenLines[i]);
        } else {
          appendMessage(spokenLines[i], "robot");
        }
      }
      await delay(200);
      setInputVisible(true);
      inputModeForField(field);
      if (userInput()) {
        userInput().placeholder = placeholder;
        userInput().setAttribute("aria-label", promptLine);
        userInput().value = "";
        // Homepage contact chat is embedded mid-page — never steal focus on load.
        // Dedicated /form pages can still autofocus the input.
        if (!IS_EMBEDDED) {
          userInput().focus({ preventScroll: true });
        }
      }
      if (field.required === false) {
        showOptionalSkip(() => {
          appendMessage("Skip", "user");
          currentFieldIndex++;
          setTimeout(showQuestion, 500);
        });
      }
    }
  }

  async function handleAvailabilityField(field) {
    const loadingEl = appendLoading("Checking availability...");
    try {
      const res = await fetch(`${BOOKING_API}/api/booking/availability`);
      const data = await res.json();
      loadingEl.remove();

      if (!res.ok || !data.days || data.days.length === 0) {
        appendMessage(
          "No available times found. Please contact us directly.",
          "robot",
        );
        return;
      }

      availabilityDays = data.days;
      appendMessage("Pick a day:", "robot");
      showOptionButtons(
        availabilityDays.map((d) => ({ value: d.date, label: d.label })),
        (value, label) => {
          const pickedDay = availabilityDays.find((d) => d.date === value);
          appendMessage(label, "user");
          setTimeout(() => {
            appendMessage("Pick a time:", "robot");
            showOptionButtons(
              (pickedDay?.slots || []).map((s) => ({
                value: s.iso,
                label: s.label,
              })),
              (slotIso, slotLabel) => {
                appendMessage(slotLabel, "user");
                formData[field.name] = slotIso;
                currentFieldIndex++;
                setTimeout(showQuestion, 500);
              },
            );
          }, 400);
        },
      );
    } catch (err) {
      loadingEl.remove();
      appendMessage("Failed to load availability. Please try again.", "robot");
      console.error(err);
    }
  }

  function buildSubmitPayload() {
    const payload = { ...formData };
    root()?.querySelectorAll("[data-cf-extra-field]").forEach((el) => {
      if (el.name) payload[el.name] = el.value ?? "";
    });
    payload.subject =
      formDef.submitSubject ||
      (formDef.title ? `New ${formDef.title} submission` : "New form submission");
    if (!payload.message && formDef.fields?.length) {
      payload.message = formDef.fields
        .filter((field) => fieldShouldShow(field))
        .map((field) => `${field.name}: ${formData[field.name] || ""}`)
        .join("\n");
    }
    if (payload.selected_addons) {
      payload.message = `${payload.message || ""}\n\nInterested add-ons: ${payload.selected_addons}`.trim();
    }
    return payload;
  }

  function normalizeDomainInput(raw) {
    const trimmed = String(raw || "")
      .trim()
      .replace(/^https?:\/\//i, "")
      .replace(/\/.*$/, "")
      .replace(/:\d+$/, "");
    if (!trimmed || /^none$/i.test(trimmed) || /^no$/i.test(trimmed)) return null;
    if (!/^[a-z0-9][a-z0-9.-]*[a-z0-9]\.[a-z]{2,}$/i.test(trimmed)) return null;
    return trimmed.toLowerCase();
  }

  async function handleDomainLookup(field, value) {
    appendMessage(value, "user");
    formData[field.name] = value;
    userInput().value = "";
    setInputVisible(false);

    const domain = normalizeDomainInput(value);
    formData.domain = domain || value.trim();

    if (!domain) {
      await showMessages(
        "No problem — we'll help you pick a domain if you need one.&&Let's keep going.",
      );
      currentFieldIndex++;
      setTimeout(showQuestion, 400);
      return;
    }

    const loadingEl = appendLoading("Checking your domain…");
    try {
      const res = await fetch(
        `${BOOKING_API}/api/domain/registrar?domain=${encodeURIComponent(domain)}`,
      );
      const data = await res.json();
      loadingEl.remove();

      formData.domain = data.domain || domain;
      formData.registrar = data.registrar || "";

      if (data.registrar) {
        await showMessages(
          `${formData.domain} is registered with ${data.registrar}.&&We'll need registrar access to launch on your domain.`,
        );
      } else {
        await showMessages(
          `Got ${formData.domain}. We couldn't confirm the registrar automatically — we'll look it up on our end.`,
        );
      }
    } catch (err) {
      loadingEl.remove();
      console.error(err);
      await appendTypewriter(
        "Got it — we'll look up your registrar and follow up if we need anything else.",
      );
    }

    currentFieldIndex++;
    setTimeout(showQuestion, 400);
  }

  async function submitForm() {
    activateDock();
    root()?.querySelector("#conversational-form")?.classList.add("hidden");

    if (formDef.submitEndpoint) {
      const loadingText =
        formDef.submittingMessage || "Submitting your response...";
      const loadingEl = appendLoading(loadingText);
      try {
        const endpoint = formDef.submitEndpoint.startsWith("/")
          ? `${BOOKING_API}${formDef.submitEndpoint}`
          : formDef.submitEndpoint;
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(buildSubmitPayload()),
        });
        loadingEl.remove();
        if (!res.ok) {
          showError("Something went wrong. Please try again.");
          return;
        }
      } catch (err) {
        loadingEl.remove();
        showError("Network error. Please try again.");
        console.error(err);
        return;
      }
    }

    root()?.querySelector("#success-message")?.classList.remove("hidden");
    const successText = root()?.querySelector("#success-text");
    if (successText) {
      successText.textContent = formDef.onComplete?.message || "Thanks!";
    }

    if (formDef.onComplete?.redirect) {
      setTimeout(
        () => (window.location.href = formDef.onComplete.redirect),
        2000,
      );
    }
  }

  function showError(msg) {
    activateDock();
    root()?.querySelector("#error-message")?.classList.remove("hidden");
    const errorText = root()?.querySelector("#error-text");
    if (errorText) errorText.textContent = msg;
  }

  function handleSubmit(e) {
    e.preventDefault();
    const value = userInput()?.value.trim();
    if (!value) return;

    const field = formDef?.fields[currentFieldIndex];
    if (!field) return;

    activateDock();

    if (field.type === "domain_lookup") {
      void handleDomainLookup(field, value);
      return;
    }

    appendMessage(value, "user");
    formData[field.name] = value;
    userInput().value = "";
    setInputVisible(false);

    currentFieldIndex++;
    setTimeout(showQuestion, 500);
  }

  root()?.querySelector("#conversational-form")?.addEventListener("submit", handleSubmit);
  userInput()?.addEventListener("focus", () => {
    window.setTimeout(scrollToLatest, 300);
  });
  root()?.querySelector("#retry-btn")?.addEventListener("click", () => {
    window.location.reload();
  });

  function startFormWhenVisible() {
    const el = root();
    if (!el) return;

    if (!IS_EMBEDDED && !IS_DOCK) {
      loadForm();
      return;
    }

    if (typeof IntersectionObserver === "undefined") {
      loadForm();
      return;
    }

    let started = false;
    const observer = new IntersectionObserver(
      (entries) => {
        if (started) return;
        if (!entries.some((entry) => entry.isIntersecting)) return;
        started = true;
        observer.disconnect();
        loadForm();
      },
      { root: null, rootMargin: "0px 0px -5% 0px", threshold: 0.15 },
    );
    observer.observe(el);
  }

  startFormWhenVisible();
</script>
