---
/**
 * Client portal Punch list tab — shared checklist that writes the same
 * to-do rows staff see in Admin → To-do.
 */
import type { PublicPunchlistItem } from '../lib/punchlist';
import { escapeHtml } from '../lib/htmlEscape';

interface Props {
  items: PublicPunchlistItem[];
  contactUid: string;
  active?: boolean;
}

const { items, contactUid, active = false } = Astro.props;
const endpoint = `/api/c/${encodeURIComponent(contactUid)}/punchlist`;
const openItems = items.filter((i) => i.status === 'open');
const doneItems = items.filter((i) => i.status === 'done');

function itemRow(item: PublicPunchlistItem) {
  const done = item.status === 'done';
  const mine = item.created_by === 'client';
  return `<li class="punch-item${done ? ' is-done' : ''}" data-id="${item.id}" data-mine="${mine ? '1' : '0'}">
    <button type="button" class="punch-check" aria-pressed="${done ? 'true' : 'false'}" aria-label="${done ? 'Mark not done' : 'Mark done'}">
      <span class="punch-box" aria-hidden="true"></span>
    </button>
    <span class="punch-title">${escapeHtml(item.title)}</span>
    ${mine ? `<button type="button" class="punch-remove" aria-label="Remove item">×</button>` : ''}
  </li>`;
}
---

<section
  class={`panel portal-punchlist ${active ? 'active' : ''}`}
  data-tab-panel="punchlist"
  data-punchlist
>
  <p class="punch-intro">Add leftover work here. It shows up on our to-do list as soon as you save it. Checking an item off updates both sides.</p>
  <form class="punch-add" data-punch-add>
    <input
      class="punch-input"
      type="text"
      name="title"
      maxlength="500"
      autocomplete="off"
      placeholder="Add an item…"
      aria-label="New punch-list item"
    />
    <button class="brand-btn brand-btn-solid punch-add-btn" type="submit">Add</button>
  </form>
  <ul class="punch-list" data-punch-open set:html={openItems.map(itemRow).join('')} />
  <p class="punch-empty muted" data-punch-empty hidden={openItems.length > 0}>
    Nothing open yet. Add the first item above.
  </p>
  <h3 class="group-title punch-done-title" data-punch-done-title hidden={doneItems.length === 0}>Done</h3>
  <ul class="punch-list punch-list--done" data-punch-done set:html={doneItems.map(itemRow).join('')} />
</section>

<script define:vars={{ endpoint }}>
  (function initPortalPunchlist() {
    const root = document.querySelector('[data-punchlist]');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const form = root.querySelector('[data-punch-add]');
    const input = form?.querySelector('.punch-input');
    const addBtn = form?.querySelector('.punch-add-btn');
    const openList = root.querySelector('[data-punch-open]');
    const doneList = root.querySelector('[data-punch-done]');
    const emptyEl = root.querySelector('[data-punch-empty]');
    const doneTitle = root.querySelector('[data-punch-done-title]');

    function escHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function syncEmpty() {
      const openCount = openList ? openList.querySelectorAll('.punch-item').length : 0;
      const doneCount = doneList ? doneList.querySelectorAll('.punch-item').length : 0;
      if (emptyEl) emptyEl.hidden = openCount > 0;
      if (doneTitle) doneTitle.hidden = doneCount === 0;
    }

    function rowHtml(item) {
      const done = item.status === 'done';
      const mine = item.created_by === 'client';
      return (
        `<button type="button" class="punch-check" aria-pressed="${done ? 'true' : 'false'}" aria-label="${done ? 'Mark not done' : 'Mark done'}">` +
        `<span class="punch-box" aria-hidden="true"></span></button>` +
        `<span class="punch-title">${escHtml(item.title)}</span>` +
        (mine ? `<button type="button" class="punch-remove" aria-label="Remove item">×</button>` : '')
      );
    }

    function mountItem(item) {
      const li = document.createElement('li');
      li.className = 'punch-item' + (item.status === 'done' ? ' is-done' : '');
      li.dataset.id = String(item.id);
      li.dataset.mine = item.created_by === 'client' ? '1' : '0';
      li.innerHTML = rowHtml(item);
      return li;
    }

    function placeItem(li, status) {
      const list = status === 'done' ? doneList : openList;
      if (!list) return;
      list.prepend(li);
      li.classList.toggle('is-done', status === 'done');
      const check = li.querySelector('.punch-check');
      if (check) {
        check.setAttribute('aria-pressed', status === 'done' ? 'true' : 'false');
        check.setAttribute('aria-label', status === 'done' ? 'Mark not done' : 'Mark done');
      }
      syncEmpty();
    }

    async function patchItem(id, body) {
      const res = await fetch(`${endpoint}/${encodeURIComponent(id)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
      return data.item;
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = String(input?.value || '').trim();
      if (!title || !input || !addBtn) return;
      addBtn.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
        if (data.item) placeItem(mountItem(data.item), 'open');
        input.value = '';
        input.focus();
      } catch (err) {
        window.alert(err instanceof Error ? err.message : 'Could not add item.');
      } finally {
        addBtn.disabled = false;
      }
    });

    root.addEventListener('click', async (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const row = target.closest('.punch-item');
      if (!row) return;
      const id = row.dataset.id;
      if (!id) return;

      if (target.closest('.punch-remove')) {
        if (row.dataset.mine !== '1') return;
        row.classList.add('is-busy');
        try {
          const res = await fetch(`${endpoint}/${encodeURIComponent(id)}`, { method: 'DELETE' });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
          row.remove();
          syncEmpty();
        } catch (err) {
          row.classList.remove('is-busy');
          window.alert(err instanceof Error ? err.message : 'Could not remove item.');
        }
        return;
      }

      if (!target.closest('.punch-check')) return;
      const next = row.classList.contains('is-done') ? 'open' : 'done';
      row.classList.add('is-busy');
      try {
        const item = await patchItem(id, { status: next });
        row.classList.remove('is-busy');
        placeItem(row, item.status);
      } catch (err) {
        row.classList.remove('is-busy');
        window.alert(err instanceof Error ? err.message : 'Could not update item.');
      }
    });
  })();
</script>

<style>
  .punch-intro {
    margin: 0 0 16px;
    color: var(--site-fg-muted, #525252);
    font-size: 15px;
    line-height: 1.55;
  }
  .punch-add {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .punch-input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--site-card-border, rgba(23, 23, 23, 0.1));
    background: var(--site-card, rgba(23, 23, 23, 0.03));
    color: var(--site-fg, #171717);
    font: inherit;
    font-size: 16px;
  }
  .punch-input:focus {
    outline: 2px solid var(--brand-primary, #171717);
    outline-offset: 1px;
  }
  .punch-add-btn.brand-btn {
    flex-shrink: 0;
    height: 44px;
    padding: 0 16px;
  }
  .punch-list {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--site-card-border, rgba(23, 23, 23, 0.1));
  }
  .punch-list:empty {
    display: none;
  }
  .punch-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: var(--site-card, rgba(23, 23, 23, 0.03));
    border-top: 1px solid var(--site-border, rgba(23, 23, 23, 0.1));
  }
  .punch-item:first-child {
    border-top: none;
  }
  .punch-item.is-busy {
    opacity: 0.55;
    pointer-events: none;
  }
  .punch-check {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
  }
  .punch-box {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 1.75px solid currentColor;
    background: transparent;
  }
  .punch-item.is-done .punch-box {
    background: currentColor;
    box-shadow: inset 0 0 0 3px var(--site-card, #fff);
  }
  .punch-title {
    flex: 1;
    min-width: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
    word-break: break-word;
  }
  .punch-item.is-done .punch-title {
    color: var(--site-fg-muted, #525252);
    text-decoration: line-through;
  }
  .punch-remove {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--site-fg-faint, #a3a3a3);
    font-size: 22px;
    line-height: 1;
  }
  .punch-remove:active {
    background: var(--site-border, rgba(23, 23, 23, 0.1));
  }
  .punch-empty {
    margin: 0 0 16px;
  }
  .punch-done-title {
    margin-top: 8px;
  }
</style>
