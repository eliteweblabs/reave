---
/**
 * Installation tier pricing table + tier cards — used on /pricing and /features.
 */
import { getCompanyConfig } from "../../lib/companyConfig";
import { INSTALLATION_TIERS, formatInstallUsd } from "../../lib/installationTiers";

interface Props {
  /** Prefix for tier feature deep links (e.g. "/features" on the pricing page). */
  featureHrefPrefix?: string;
  /** Heading copy — features page references accordions below; pricing page stands alone. */
  variant?: "features" | "standalone";
}

const { featureHrefPrefix = "", variant = "features" } = Astro.props;

const company = await getCompanyConfig(Astro.request);
const supportMail = company.supportEmail || (company.domain ? `hello@${company.domain}` : "");
const quoteHref = supportMail ? `mailto:${supportMail}` : "/schedule";

const heading =
  variant === "standalone"
    ? "Four tiers — pick the scope that fits your business."
    : "Four tiers — mapped to the features below.";
---

<section
  class="fx-pricing scroll-fade-in"
  aria-label="Installation plan and pricing"
  id="plan"
>
  <span id="pricing" hidden aria-hidden="true"></span>
  <p class="fx-pricing-kicker">Installation plan</p>
  <h2 class="fx-pricing-h2">{heading}</h2>
  <p class="fx-pricing-lead">
    Every install starts at full tier price for month one. Each month after that, the fee
    drops by half until month four — then it holds steady for as long as you run the
    platform. Higher tiers include everything in the tiers below, plus the modules listed
    for that tier.
  </p>

  <div class="fx-pricing-table-wrap">
    <table class="fx-pricing-table">
      <thead>
        <tr>
          <th scope="col">Plan</th>
          <th scope="col">Month 1</th>
          <th scope="col">Month 2</th>
          <th scope="col">Month 3</th>
          <th scope="col">Month 4+</th>
        </tr>
      </thead>
      <tbody>
        {
          [...INSTALLATION_TIERS].reverse().map((t) => (
            <tr>
              <th scope="row">{t.name}</th>
              <td>{formatInstallUsd(t.month1)}</td>
              <td>{formatInstallUsd(t.month2)}</td>
              <td>{formatInstallUsd(t.month3)}</td>
              <td>{formatInstallUsd(t.month4Plus)}/mo</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="fx-tier-grid">
    {
      [...INSTALLATION_TIERS].reverse().map((t) => (
        <article class="fx-tier-card">
          <header class="fx-tier-card-head">
            <h3 class="fx-tier-card-title">{t.name}</h3>
            <p class="fx-tier-card-summary">{t.summary}</p>
            <p class="fx-tier-card-price">
              {formatInstallUsd(t.month1)} → {formatInstallUsd(t.month4Plus)}/mo
            </p>
          </header>
          <ul class="fx-tier-feature-list">
            {
              t.features.map((f) => (
                <li>
                  {
                    f.href ? (
                      <a href={`${featureHrefPrefix}${f.href}`}>{f.label}</a>
                    ) : (
                      f.label
                    )
                  }
                </li>
              ))
            }
          </ul>
        </article>
      ))
    }
  </div>

  <div class="fx-cta-row">
    <a class="fx-btn fx-btn--ghost brand-btn-glass" href={quoteHref}>Get a quote for your plan</a>
    {
      variant === "standalone" && (
        <a class="fx-btn fx-btn--ghost brand-btn-glass" href="/features">See full platform tour</a>
      )
    }
  </div>
</section>

<style>
  .fx-pricing {
    width: 100%;
    max-width: 920px;
    text-align: center;
    margin-bottom: 56px;
    padding: 28px 22px 32px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(34, 197, 94, 0.1), transparent 70%),
      rgba(255, 255, 255, 0.02);
  }

  .fx-pricing-kicker {
    font-family: var(--font-secondary);
  }

  .fx-pricing-lead {
    font-family: var(--font-content);
  }

  .fx-pricing-kicker {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #4ade80;
    margin: 0 0 12px;
  }

  .fx-pricing-h2 {
    margin: 0 0 12px;
    font-size: clamp(1.35rem, 3.8vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #fff;
  }

  .fx-pricing-lead {
    margin: 0 auto 24px;
    max-width: 620px;
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.62);
  }

  .fx-pricing-table-wrap {
    overflow-x: auto;
    margin-bottom: 16px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.22);
  }

  .fx-pricing-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: center;
  }

  .fx-pricing-table th,
  .fx-pricing-table td {
    padding: 12px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .fx-pricing-table thead th {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.48);
    background: rgba(255, 255, 255, 0.03);
  }

  .fx-pricing-table tbody th {
    font-weight: 700;
    color: #bbf7d0;
    text-align: left;
    white-space: nowrap;
  }

  .fx-pricing-table tbody td {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
    font-variant-numeric: tabular-nums;
  }

  .fx-pricing-table tbody tr:last-child th,
  .fx-pricing-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .fx-tier-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 20px;
    text-align: left;
  }

  .fx-tier-card {
    padding: 18px 18px 16px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.18);
  }

  .fx-tier-card-title {
    margin: 0 0 8px;
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
  }

  .fx-tier-card-summary {
    margin: 0 0 10px;
    font-size: 0.82rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.55);
  }

  .fx-tier-card-price {
    margin: 0 0 12px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #bbf7d0;
    font-variant-numeric: tabular-nums;
  }

  .fx-tier-feature-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .fx-tier-feature-list li {
    position: relative;
    padding-left: 14px;
    font-size: 0.8rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.72);
  }

  .fx-tier-feature-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(74, 222, 128, 0.75);
  }

  .fx-tier-feature-list a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.22);
    text-underline-offset: 2px;
  }

  .fx-tier-feature-list a:hover {
    color: #fff;
    text-decoration-color: rgba(255, 255, 255, 0.45);
  }

  .fx-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 0;
  }

  .fx-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, filter 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  .fx-btn--ghost:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 720px) {
    .fx-tier-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
