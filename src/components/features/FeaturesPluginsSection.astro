---
/**
 * Optional modules accordion — the fx-plugins block, now canonical on /modules.
 */
import { ChevronDown } from "lucide-astro";
import {
  Car,
  Truck,
  ShoppingBag,
  Building2,
  FileSignature,
  PhoneCall,
  Mic,
  Contact,
  Send,
  Monitor,
  Clock,
  GitBranch,
  Globe,
  PenLine,
} from "lucide-astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import { PLATFORM_PLUGINS } from "../../lib/platformPlugins";

interface Props {
  /** Standalone /modules page vs embedded (unused today — reserved). */
  standalone?: boolean;
}

const { standalone = true } = Astro.props;

const company = await getCompanyConfig(Astro.request);
const supportMail = company.supportEmail || (company.domain ? `hello@${company.domain}` : "");
const quoteHref = supportMail ? `mailto:${supportMail}` : "/schedule";

const pluginIcons = {
  dealership: Car,
  fleet: Truck,
  inventory: ShoppingBag,
  "real-estate": Building2,
  documents: FileSignature,
  voice: PhoneCall,
  vapi: Mic,
  carddav: Contact,
  newsletter: Send,
  monitoring: Monitor,
  "time-tracking": Clock,
  "dev-infra": GitBranch,
  "namecom-dns": Globe,
  "content-management": PenLine,
} as const;
---

<section
  class="fx-plugins scroll-fade-in"
  aria-label="Optional modules"
  id="modules-detail"
>
  <p class="fx-plugins-kicker">The last 10%</p>
  <h2 class="fx-plugins-h2">Bolt on what makes this client 100%.</h2>
  <p class="fx-plugins-lead">
    The core OS is the 90% — it ships on every install. Everything below is opt-in:
    flipped on per client in one config line. Dealership inventory, fleet tracking,
    e-sign, voice routing — built once, reused on the next install that needs it.
  </p>

  <div class="mod-acc-list" data-modules-acc-list>
    {
      PLATFORM_PLUGINS.map((p) => {
        const Icon = pluginIcons[p.id as keyof typeof pluginIcons] ?? Monitor;
        return (
          <div
            class="mod-acc-item mod-acc-item--plugin scroll-fade-in"
            data-modules-acc-item
            id={`plugin-${p.id}`}
          >
            <button type="button" class="mod-acc-trigger" aria-expanded="true">
              <span class="mod-acc-icon mod-acc-icon--plugin">
                <Icon size={20} strokeWidth={1.75} aria-hidden="true" />
              </span>
              <span class="mod-acc-heading">
                <span class="mod-acc-title">{p.title}</span>
                <span class="mod-acc-teaser">{p.teaser}</span>
              </span>
              <span class="mod-acc-chev" aria-hidden="true">
                <ChevronDown size={18} strokeWidth={2} />
              </span>
            </button>
            <div class="mod-acc-panel">
              <div class="mod-acc-panel-inner">
                <p>{p.body}</p>
                {
                  p.bullets && (
                    <ul class="mod-acc-bullets">
                      {p.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                  )
                }
              </div>
            </div>
          </div>
        );
      })
    }
  </div>

  {
    standalone && (
      <div class="fx-plugins-cta">
        <a class="fx-plugins-btn brand-btn-glass" href={quoteHref}>Ask about a module</a>
        <a class="fx-plugins-btn brand-btn-glass" href="/features">See the core platform</a>
      </div>
    )
  }
</section>

<script>
  (function () {
    const items = document.querySelectorAll<HTMLElement>("[data-modules-acc-item]");
    if (!items.length) return;

    function setOpen(item: HTMLElement, open: boolean, animate: boolean) {
      const trigger = item.querySelector<HTMLButtonElement>(".mod-acc-trigger");
      const panel = item.querySelector<HTMLElement>(".mod-acc-panel");
      if (!trigger || !panel) return;
      trigger.setAttribute("aria-expanded", open ? "true" : "false");
      item.classList.toggle("open", open);
      if (!animate) {
        panel.style.transition = "none";
        panel.style.maxHeight = open ? panel.scrollHeight + "px" : "0px";
        requestAnimationFrame(() => {
          panel.style.transition = "";
        });
        return;
      }
      panel.style.maxHeight = open ? panel.scrollHeight + "px" : "0px";
    }

    items.forEach((item, idx) => {
      setOpen(item, idx === 0, false);
      const trigger = item.querySelector<HTMLButtonElement>(".mod-acc-trigger");
      trigger?.addEventListener("click", () => {
        setOpen(item, !item.classList.contains("open"), true);
      });
    });

    if (location.hash) {
      const target = document.querySelector<HTMLElement>(location.hash);
      if (target?.hasAttribute("data-modules-acc-item")) {
        setOpen(target, true, false);
        target.scrollIntoView({ block: "start" });
      }
    }

    window.addEventListener("resize", () => {
      document.querySelectorAll<HTMLElement>("[data-modules-acc-item].open").forEach((item) => {
        const panel = item.querySelector<HTMLElement>(".mod-acc-panel");
        if (panel) panel.style.maxHeight = panel.scrollHeight + "px";
      });
    });
  })();
</script>

<style>
  .fx-plugins {
    width: 100%;
    max-width: 920px;
    margin-top: 0;
    margin-bottom: 56px;
    padding: 32px clamp(16px, 4vw, 32px);
    border: 1px dashed rgba(56, 189, 248, 0.32);
    border-radius: 24px;
    background:
      radial-gradient(ellipse 120% 100% at 50% -10%, rgba(56, 189, 248, 0.08) 0%, transparent 60%),
      rgba(255, 255, 255, 0.015);
  }

  .fx-plugins-kicker {
    font-family: var(--font-secondary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #38bdf8;
    margin: 0 0 10px;
    text-align: center;
  }

  .fx-plugins-h2 {
    margin: 0 0 12px;
    font-size: clamp(1.3rem, 3.4vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #fff;
    text-align: center;
  }

  .fx-plugins-lead {
    font-family: var(--font-content);
    margin: 0 auto 26px;
    max-width: 560px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.58);
    text-align: center;
  }

  .mod-acc-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mod-acc-item {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .mod-acc-item.open {
    border-color: rgba(56, 189, 248, 0.32);
    background: rgba(255, 255, 255, 0.035);
  }

  .mod-acc-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    background: transparent;
    border: 0;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .mod-acc-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    background: rgba(56, 189, 248, 0.14);
    color: #7dd3fc;
  }

  .mod-acc-heading {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .mod-acc-title {
    font-family: var(--font-primary);
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .mod-acc-teaser {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.52);
    line-height: 1.45;
  }

  .mod-acc-chev {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.32);
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .mod-acc-item.open .mod-acc-chev {
    transform: rotate(180deg);
    color: #7dd3fc;
  }

  .mod-acc-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mod-acc-panel-inner {
    padding: 0 18px 22px 72px;
  }

  .mod-acc-panel-inner p {
    margin: 0 0 12px;
    font-size: 0.93rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
  }

  .mod-acc-bullets {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mod-acc-bullets li {
    position: relative;
    padding-left: 20px;
    font-size: 0.87rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.64);
  }

  .mod-acc-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(56, 189, 248, 0.75);
  }

  .fx-plugins-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }

  .fx-plugins-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .fx-plugins-btn:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .mod-acc-panel-inner {
      padding-left: 18px;
    }
  }
</style>
