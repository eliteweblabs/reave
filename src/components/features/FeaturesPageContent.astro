type Chip = (typeof apiFeatures)[number];

/** Mobile / tablet / desktop row counts for the chip marquee. */
const CHIP_ROW_LAYOUTS = [
  { key: "mobile", rows: 6 },
  { key: "tablet", rows: 4 },
  { key: "desktop", rows: 3 },
] as const;

/** Round-robin so each row gets a similar mix of short/long labels. */
function splitChipsIntoRows(items: Chip[], rowCount: number): Chip[][] {
  const rows: Chip[][] = Array.from({ length: rowCount }, () => []);
  items.forEach((item, i) => {
    rows[i % rowCount].push(item);
  });
  return rows.filter((row) => row.length > 0);
}

/** Two copies per track so translateX(-50%) loops seamlessly. */
function loopChipRow(row: Chip[]): Chip[] {
  return row.length > 0 ? [...row, ...row] : [];
}

const chipRowLayouts = CHIP_ROW_LAYOUTS.map((layout) => ({
  ...layout,
  tracks: splitChipsIntoRows(apiFeatures, layout.rows).map((row, rowIndex) => ({
    direction: rowIndex % 2 === 0 ? "normal" : "reverse",
    chips: loopChipRow(row),
    uniqueCount: row.length,
  })),
}));

