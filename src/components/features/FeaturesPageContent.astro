 * Sales-deck-style tour of the whole platform — used on /features and embedded on the homepage.
 * Accordion sections, dark brand theme, plugins called out separately at the end.
 */
import BrandLogoGrid from "../BrandLogoGrid.astro";
import { getCompanyConfig } from "../../lib/companyConfig";
import { INSTALLATION_TIERS, formatInstallUsd } from "../../lib/installationTiers";
