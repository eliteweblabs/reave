<div
  class:list={[
    "fx-page",
    embedded && "fx-page--embedded",
    introOnly && "fx-page--intro",
    hideIntro && "fx-page--tour",
    tight && "fx-page--tight",
  ]}
  data-features-content
  id={introOnly ? "features" : undefined}
>
    {
      showIntro && (
    <>
    <section class="fx-hero">
      {/*
        Standalone /features keeps this as the page h1. On the homepage it is
        embedded under HomeHeroSection's h1, so demote to h2 — same visual class.

        Fade the copy only — not this section. The chip marquee’s mask +
        infinite transform is a known iOS Safari tripwire for view()
        timelines on the following block (“Baseline baked in” stuck faded).
      */}
      <div class="fx-hero-copy scroll-fade-in">
        {embedded ? (
          <h2 class="fx-h1">
            Runs the whole business — not your credit card.
          </h2>
        ) : (
          <h1 class="fx-h1">
            Runs the whole business — not your credit card.
          </h1>
        )}
        <p class="fx-lead">
          Contacts, billing, projects, inbox, scheduling, newsletters, social metrics,
          website editing, and white-label branding — one login, one AI agent that is Siri capable,
          and a dead simple client portal with passwordless MagicLinks. Add industry spec plugins to supercharge your workflows.
        </p>
      </div>
    </section>
    {
      introOnly ? (
        <div class="fx-chips fx-chips--cluster" data-no-scroll-fade aria-label="Platform features">
          {
            apiFeatures.map((chip) => {
              const classes = ["fx-chip", chip.kind === "nav" && "fx-chip--link"];
              return chip.href ? (
                <a class:list={classes} href={chip.href} data-feature-id={chip.id}>
                  {chip.label}
                </a>
              ) : (
                <span class:list={classes} data-feature-id={chip.id}>
                  {chip.label}
                </span>
              );
            })
          }
        </div>
      ) : (
    <>
    {/*
      Keep the marquee outside the fading hero. Infinite translateX + mask-image
      inside a view() subject inflates the scrollport so later sections stall
      mid fade-in (iOS especially).
    */}
    <div class="fx-chips" data-feature-chips data-no-scroll-fade aria-label="Platform features">
      {
        chipRowLayouts.map((layout) => (
          <div class:list={["fx-chips-set", `fx-chips-set--${layout.key}`]}>
            {
              layout.tracks.map((track) => (
                <div
                  class="fx-chips-row"
                  style={`--fx-chip-direction: ${track.direction};`}
                >
                  <div class="fx-chips-track">
                    {
                      track.chips.map((chip, index) => {
                        const duplicate = index >= track.uniqueCount;
                        const classes = [
                          "fx-chip",
                          chip.kind === "nav" && "fx-chip--link",
                        ];
                        return chip.href ? (
                          <a
                            class:list={classes}
                            href={chip.href}
                            data-feature-id={chip.id}
                            tabindex={duplicate ? -1 : undefined}
                            aria-hidden={duplicate ? "true" : undefined}
                          >
                            {chip.label}
                          </a>
                        ) : (
                          <span
                            class:list={classes}
                            data-feature-id={chip.id}
                            aria-hidden={duplicate ? "true" : undefined}
                          >
                            {chip.label}
                          </span>
                        );
                      })
                    }
                  </div>
                </div>
              ))
            }
          </div>
        ))
      }
    </div>
    </>
      )
    }
    </>
      )
    }

    {
      showTour && !coreOnly && showLogoStack && (
        <section class="fx-stack scroll-fade-in" aria-label="Apps this platform replaces">
          <p class="fx-stack-kicker">Replace the stack</p>
