interface Props {
  /** Show the static replaced-apps logo grid (homepage already has the marquee). */
  showLogoStack?: boolean;
  /** Tighter padding when nested inside the homepage scroll container. */
  embedded?: boolean;
}

const { showLogoStack = true, embedded = false } = Astro.props;

