<script>
  (function () {
    const items = document.querySelectorAll<HTMLElement>("[data-acc-item]");
    if (!items.length) return;

    function setOpen(item: HTMLElement, open: boolean, animate: boolean) {
      const trigger = item.querySelector<HTMLButtonElement>(".acc-trigger");
      const panel = item.querySelector<HTMLElement>(".acc-panel");
      if (!trigger || !panel) return;
      trigger.setAttribute("aria-expanded", open ? "true" : "false");
      item.classList.toggle("open", open);
      if (!animate) {
        panel.style.transition = "none";
        panel.style.maxHeight = open ? panel.scrollHeight + "px" : "0px";
        // Re-enable transitions on the next frame.
        requestAnimationFrame(() => {
          panel.style.transition = "";
        });
        return;
      }
      panel.style.maxHeight = open ? panel.scrollHeight + "px" : "0px";
    }

    // Progressive enhancement: content is visible without JS (for crawlers +
    // no-JS clients); once JS runs, collapse everything except the first item.
    items.forEach((item, idx) => {
      setOpen(item, idx === 0, false);

      const trigger = item.querySelector<HTMLButtonElement>(".acc-trigger");
      trigger?.addEventListener("click", () => {
        const isOpen = item.classList.contains("open");
        setOpen(item, !isOpen, true);
      });
    });

    // Deep-link support: /features#feature-billing opens that section.
    if (location.hash) {
      const target = document.querySelector<HTMLElement>(location.hash);
      if (target && target.hasAttribute("data-acc-item")) {
        setOpen(target, true, false);
        target.scrollIntoView({ block: "start" });
      }
    }

    window.addEventListener("resize", () => {
      document.querySelectorAll<HTMLElement>("[data-acc-item].open").forEach((item) => {
        const panel = item.querySelector<HTMLElement>(".acc-panel");
        if (panel) panel.style.maxHeight = panel.scrollHeight + "px";
      });
    });
  })();
</script>

