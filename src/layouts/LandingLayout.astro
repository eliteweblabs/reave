---\nimport Favicon from \"../components/Favicon.astro\";\nimport ViewportMeta from \"../components/ViewportMeta.astro\";\nimport { getCompanyConfig, companyOgImageUrl } from \"../lib/companyConfig\";\nimport { shareSafeText } from \"../lib/shareSafeText\";\nimport { companyHtmlStyleAttr } from \"../lib/companyBrandColors\";\nimport { getSiteContent, siteLandingOgImage } from \"../lib/siteContent\";\nimport { requestOrigin } from \"../lib/requestOrigin\";\nimport { BRANDING_OG_PATH } from \"../lib/companyLogo\";\nimport { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from \"../lib/ogImageSize\";\nimport CookieNotice from \"../components/CookieNotice.astro\";\nimport PwaDocumentTitle from \"../components/PwaDocumentTitle.astro\";\nimport ScrollFadeIn from \"../components/ScrollFadeIn.astro\";\nimport { formatHtmlPageTitle, formatPwaAppTitle } from \"../lib/pageTitle\";\nimport PlausibleScript from \"../components/PlausibleScript.astro\";\nimport \"../styles/scroll-fade.css\";\n\nexport interface Props {\n  title?: string;\n  description?: string;\n  /** Overrides the Company default share image (admin → Company → Social sharing). */\n  ogImage?: string;\n  themeColor?: string;\n  noIndex?: boolean;\n}\n\nconst {\n  title: titleProp,\n  description: descriptionProp,\n  ogImage: ogImageProp,\n  themeColor: themeColorProp,\n  noIndex = false,\n} = Astro.props;\n\nconst company = await getCompanyConfig(Astro.request);\nconst siteContent = getSiteContent();\nconst landing = siteContent.landing ?? {};\nconst isEditorial = landing.variant === \"editorial\";\nconst isPack = landing.variant === \"pack\";\nconst isService = landing.variant === \"service\";\nconst isTech = landing.variant === \"tech\";\nconst isVet = landing.variant === \"vet\";\nconst pathNorm = Astro.url.pathname.replace(/\\/$/, \"\") || \"/\";\nconst isIndexPage = pathNorm === \"/\";\nconst siteName = (landing.name ?? company.name).trim() || formatPwaAppTitle(company.name);\nconst pageName = titleProp?.trim() || \"\";\nlet docTitle: string;\nif (pageName) {\n  docTitle = formatHtmlPageTitle({ page: pageName, siteName });\n} else if (isIndexPage && landing.title?.trim()) {\n  docTitle = landing.title.trim();\n} else if (isIndexPage) {\n  docTitle = formatHtmlPageTitle({\n    siteName,\n    tagline: landing.tagline?.trim() || company.description?.trim(),\n  });\n} else {\n  docTitle = formatHtmlPageTitle({ siteName });\n}\nif (!docTitle.trim()) docTitle = siteName || \"Home\";\nconst pwaTitle = formatPwaAppTitle(company.name);\nconst description = descriptionProp ?? landing.description ?? company.description;\nconst shareTitle = shareSafeText(landing.name ?? company.name);\nconst ogImage = ogImageProp ?? siteLandingOgImage(siteContent) ?? landing.ogImage ?? companyOgImageUrl(company);\nconst isCompanyOg = ogImage.split(\"?\")[0] === BRANDING_OG_PATH;\nconst isLandingOg = Boolean(siteLandingOgImage(siteContent) || landing.ogImage);\nconst ogImageAlt = shareSafeText(landing.name ?? company.name);\nconst themeColor =\n  themeColorProp ??\n  landing.themeColor ??\n  (isVet ? \"#fafafa\" : isPack ? \"#1c1410\" : isEditorial ? \"#f4efe6\" : isService ? \"#f4f7fb\" : isTech ? \"#2f4a2c\" : \"#01061d\");\nconst origin = requestOrigin(Astro.request);\nconst publicOrigin = company.domain ? `https://${company.domain}` : origin;\nconst canonical = `${publicOrigin}${Astro.url.pathname}${Astro.url.search}`;\nconst ogImageAbsolute = ogImage.startsWith(\"http\") ? ogImage : `${origin}${ogImage}`;\nconst ogImageSafe = /\\.gif(?:\\?|$)/i.test(ogImageAbsolute)\n  ? `${origin}${BRANDING_OG_PATH}`\n  : ogImageAbsolute;\nconst htmlStyle =\n  isEditorial || isService || isTech || isPack || isVet\n    ? undefined\n    : companyHtmlStyleAttr(company.fonts, company.brandPrimary, company.brandSecondary);\n\n// JSON-LD Structured Data\nconst structuredData = landing.structuredData;\nconst jsonLdData = structuredData ? {\n  \"@context\": \"https://schema.org\",\n  \"@type\": structuredData.type || \"LocalBusiness\",\n  \"name\": structuredData.name || siteName,\n  \"description\": structuredData.description || description,\n  \"image\": structuredData.image || ogImageSafe,\n  \"url\": structuredData.url || canonical,\n  ...(structuredData.telephone && { \"telephone\": structuredData.telephone }),\n  ...(structuredData.email && { \"email\": structuredData.email }),\n  ...(structuredData.areaServed && { \"areaServed\": structuredData.areaServed }),\n  ...(structuredData.priceRange && { \"priceRange\": structuredData.priceRange }),\n  ...(structuredData.ratingValue && {\n    \"aggregateRating\": {\n      \"@type\": \"AggregateRating\",\n      \"ratingValue\": structuredData.ratingValue,\n      \"ratingCount\": structuredData.ratingCount\n    }\n  })\n} : null;\n\n// Web App Manifest\nconst manifest = landing.manifest;\nconst manifestPath = manifest ? `/manifest-${landing.name?.toLowerCase().replace(/\\s+/g, '-')}.json` : null;\n---\n\n<!doctype html>\n<html lang=\"en\" style={htmlStyle}>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <ViewportMeta />\n    <meta name=\"theme-color\" content={themeColor} />\n    <meta name=\"apple-mobile-web-app-title\" content={pwaTitle} />\n    <meta name=\"application-name\" content={pwaTitle} />\n    <meta name=\"generator\" content={Astro.generator} />\n    <Favicon />\n    <title>{docTitle}</title>\n    <PwaDocumentTitle pwaTitle={pwaTitle} />\n    <meta name=\"description\" content={description} />\n    {noIndex && <meta name=\"robots\" content=\"noindex, nofollow\" />}\n    <link rel=\"canonical\" href={canonical} />\n    <meta property=\"og:title\" content={shareTitle} />\n    <meta property=\"og:description\" content={description} />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content={canonical} />\n    <meta property=\"og:image\" content={ogImageSafe} />\n    {(isEditorial || isCompanyOg || isLandingOg) && <meta property=\"og:image:width\" content={String(OG_IMAGE_WIDTH)} />}\n    {(isEditorial || isCompanyOg || isLandingOg) && <meta property=\"og:image:height\" content={String(OG_IMAGE_HEIGHT)} />}\n    {isLandingOg && <meta property=\"og:image:alt\" content={ogImageAlt} />}\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content={shareTitle} />\n    <meta name=\"twitter:description\" content={description} />\n    <meta name=\"twitter:image\" content={ogImageSafe} />\n    {manifest && <link rel=\"manifest\" href={`/sites/${siteContent.key}/manifest.json`} />}\n    {jsonLdData && <script type=\"application/ld+json\" set:html={JSON.stringify(jsonLdData)} />}\n    <PlausibleScript />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    {isPack ? (\n      <link\n        href=\"https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Figtree:wght@400;500;600;700&family=Fredoka:wght@500;600;700&display=swap\"\n        rel=\"stylesheet\"\n      />\n    ) : isEditorial ? (\n      <link\n        href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Great+Vibes&family=Outfit:wght@400;500;600&display=swap\"\n        rel=\"stylesheet\"\n      />\n    ) : isService ? (\n      <link\n        href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap\"\n        rel=\"stylesheet\"\n      />\n    ) : isTech ? (\n      <link\n        href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;600;700&display=swap\"\n        rel=\"stylesheet\"\n      />\n    ) : isVet ? (\n      <link\n        href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\"\n        rel=\"stylesheet\"\n      />\n    ) : (\n      <link\n        href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\"\n        rel=\"stylesheet\"\n      />\n    )}\n  </head>\n  <body class={isVet ? \"vet-body\" : isPack ? \"pack-body\" : isEditorial ? \"editorial-body\" : isService ? \"service-body\" : isTech ? \"tech-body\" : \"landing-body\"}>\n    <slot />\n    <ScrollFadeIn />\n    <CookieNotice />\n  </body>\n</html>\n\n{isVet ? (\n<style is:global>\n  * { box-sizing: border-box; }\n  html, body.vet-body {\n    margin: 0;\n    min-height: 100%;\n    scroll-behavior: smooth;\n    -webkit-font-smoothing: antialiased;\n    background: #fafafa;\n    -webkit-user-select: none;\n    user-select: none;\n  }\n  body.vet-body :is(\n    input:not([type=\"button\"]):not([type=\"submit\"]):not([type=\"reset\"]),\n    textarea,\n    a[href^=\"mailto:\"]:not(.vet-btn-primary):not(.vet-btn-secondary),\n    a[href^=\"tel:\"]:not(.vet-btn-primary):not(.vet-btn-secondary)\n  ) {\n    -webkit-user-select: text;\n    user-select: text;\n  }\n  body.vet-body a:not(.vet-btn-primary):not(.vet-btn-secondary):not(.vet-header__nav-btn) {\n    color: inherit;\n  }\n</style>\n) : isPack ? (\n<style is:global>\n  * { box-sizing: border-box; }\n  html, body.pack-body {\n    margin: 0;\n    min-height: 100%;\n    scroll-behavior: smooth;\n    -webkit-font-smoothing: antialiased;\n    background: #fbf4e6;\n    -webkit-user-select: none;\n    user-select: none;\n  }\n  body.pack-body :is(\n    input:not([type=\"button\"]):not([type=\"submit\"]):not([type=\"reset\"]),\n    textarea,\n    a[href^=\"mailto:\"],\n    a[href^=\"tel:\"]\n  ) {\n    -webkit-user-select: text;\n    user-select: text;\n  }\n  body.pack-body a { color: inherit; }\n</style>\n) : isEditorial ? (\n<style is:global>\n  * { box-sizing: border-box; }\n  html, body.editorial-body {\n    margin: 0;\n    min-height: 100%;\n    font-family: Outfit, system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    color: #161410;\n    background: #fbf8f2;\n    -webkit-user-select: none;\n    user-select: none;\n  }\n  body.editorial-body :is(\n    input:not([type=\"button\"]):not([type=\"submit\"]):not([type=\"reset\"]),\n    textarea,\n    a[href^=\"mailto:\"],\n    a[href^=\"tel:\"]\n  ) {\n    -webkit-user-select: text;\n    user-select: text;\n  }\n  body.editorial-body a { color: inherit; }\n</style>\n) : isService ? (\n<style is:global>\n  * { box-sizing: border-box; }\n  html, body.service-body {\n    margin: 0;\n    min-height: 100%;\n    font-family: \"Source Sans 3\", system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    color: #0f172a;\n    background: #f4f7fb;\n    -webkit-user-select: none;\n    user-select: none;\n  }\n  body.service-body :is(\n    input:not([type=\"button\"]):not([type=\"submit\"]):not([type=\"reset\"]),\n    textarea,\n    a[href^=\"mailto:\"],\n    a[href^=\"tel:\"]\n  ) {\n    -webkit-user-select: text;\n    user-select: text;\n  }\n  body.service-body a { color: inherit; }\n</style>\n) : isTech ? (\n<style is:global>\n  * { box-sizing: border-box; }\n  html, body.tech-body {\n    margin: 0;\n    min-height: 100%;\n    font-family: \"DM Sans\", Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    -webkit-font-smoothing: antialiased;\n    color: #1c1c1c;\n    background: #f4efe4;\n    -webkit-user-select: none;\n    user-select: none;\n  }\n  body.tech-body :is(\n    input:not([type=\"button\"]):not([type=\"submit\"]):not([type=\"reset\"]),\n    textarea,\n    a[href^=\"mailto:\"],\n    a[href^=\"tel:\"]\n  ) {\n    -webkit-user-select: text;\n    user-select: text;\n  }\n  body.tech-body a { color: inherit; }\n</style>\n) : (\n<style is:global>\n  * {\n    box-sizing: border-box;\n  }\n\n  html,\n  body.landing-body {\n    margin: 0;\n    min-height: 100%;\n    font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    -webkit-font-smoothing: antialiased;\n    color: #fff;\n    background: linear-gradient(180deg, #01061d, #01092b);\n    -webkit-user-select: none;\n    user-select: none;\n  }\n  body.landing-body :is(\n    input:not([type=\"button\"]):not([type=\"submit\"]):not([type=\"reset\"]),\n    textarea,\n    a[href^=\"mailto:\"],\n    a[href^=\"tel:\"]\n  ) {\n    -webkit-user-select: text;\n    user-select: text;\n  }\n\n  a {\n    color: #60a5fa;\n    text-decoration: none;\n  }\n\n  a:hover {\n    text-decoration: underline;\n  }\n</style>\n)}\n