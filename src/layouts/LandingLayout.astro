---
import Favicon from "../components/Favicon.astro";
import ViewportMeta from "../components/ViewportMeta.astro";
import { getCompanyConfig, companyOgImageUrl } from "../lib/companyConfig";
import { shareSafeText } from "../lib/shareSafeText";
import { companyHtmlStyleAttr } from "../lib/companyBrandColors";
import { getSiteContent } from "../lib/siteContent";
import { requestOrigin } from "../lib/requestOrigin";
import { BRANDING_OG_PATH, LOGO_ICON_OG_PATH } from "../lib/companyLogo";
import CookieNotice from "../components/CookieNotice.astro";
import PwaDocumentTitle from "../components/PwaDocumentTitle.astro";
import ScrollFadeIn from "../components/ScrollFadeIn.astro";
import { formatPwaAppTitle } from "../lib/pageTitle";
import PlausibleScript from "../components/PlausibleScript.astro";
import "../styles/scroll-fade.css";

export interface Props {
  title?: string;
  description?: string;
  /** Overrides the Company default share image (admin → Company → Social sharing). */
  ogImage?: string;
  themeColor?: string;
  noIndex?: boolean;
}

const {
  title: titleProp,
  description: descriptionProp,
  ogImage: ogImageProp,
  themeColor: themeColorProp,
  noIndex = false,
} = Astro.props;

const company = await getCompanyConfig(Astro.request);
const siteContent = getSiteContent();
const landing = siteContent.landing ?? {};
const isEditorial = landing.variant === "editorial";
const isPack = landing.variant === "pack";
const isService = landing.variant === "service";
const isTech = landing.variant === "tech";
const isVet = landing.variant === "vet";
const title = (titleProp ?? landing.title ?? company.name).trim();
const pwaTitle = formatPwaAppTitle(company.name);
const description = descriptionProp ?? landing.description ?? company.description;
const shareTitle = shareSafeText(landing.name ?? company.name);
const ogImage = ogImageProp ?? landing.ogImage ?? companyOgImageUrl(company);
const isCompanyOg = ogImage.split("?")[0] === BRANDING_OG_PATH;
const themeColor =
  themeColorProp ??
  landing.themeColor ??
  (isVet ? "#fafafa" : isPack ? "#1c1410" : isEditorial ? "#f4efe6" : isService ? "#f4f7fb" : isTech ? "#2f4a2c" : "#01061d");
const origin = requestOrigin(Astro.request);
const publicOrigin = company.domain ? `https://${company.domain}` : origin;
const canonical = `${publicOrigin}${Astro.url.pathname}${Astro.url.search}`;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `${origin}${ogImage}`;
const ogImageSafe = /\.gif(?:\?|$)/i.test(ogImageAbsolute)
  ? `${origin}${LOGO_ICON_OG_PATH}`
  : ogImageAbsolute;
const htmlStyle =
  isEditorial || isService || isTech || isPack || isVet
    ? undefined
    : companyHtmlStyleAttr(company.fonts, company.brandPrimary, company.brandSecondary);
---

<!doctype html>
<html lang="en" style={htmlStyle}>
  <head>
    <meta charset="UTF-8" />
    <ViewportMeta />
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-title" content={pwaTitle} />
    <meta name="application-name" content={pwaTitle} />
    <meta name="generator" content={Astro.generator} />
    <Favicon />
    <title>{title}</title>
    <PwaDocumentTitle pwaTitle={pwaTitle} />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageSafe} />
    {(isEditorial || isCompanyOg) && <meta property="og:image:width" content="1200" />}
    {(isEditorial || isCompanyOg) && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageSafe} />
    <PlausibleScript />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {isPack ? (
      <link
        href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Figtree:wght@400;500;600;700&family=Fredoka:wght@500;600;700&display=swap"
        rel="stylesheet"
      />
    ) : isEditorial ? (
      <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Great+Vibes&family=Outfit:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    ) : isService ? (
      <link
        href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap"
        rel="stylesheet"
      />
    ) : isTech ? (
      <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;600;700&display=swap"
        rel="stylesheet"
      />
    ) : isVet ? (
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    ) : (
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    )}
  </head>
  <body class={isVet ? "vet-body" : isPack ? "pack-body" : isEditorial ? "editorial-body" : isService ? "service-body" : isTech ? "tech-body" : "landing-body"}>
    <slot />
    <ScrollFadeIn />
    <CookieNotice />
  </body>
</html>

{isVet ? (
<style is:global>
  * { box-sizing: border-box; }
  html, body.vet-body {
    margin: 0;
    min-height: 100%;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    background: #fafafa;
    -webkit-user-select: none;
    user-select: none;
  }
  body.vet-body :is(
    input:not([type="button"]):not([type="submit"]):not([type="reset"]),
    textarea,
    a[href^="mailto:"],
    a[href^="tel:"]
  ) {
    -webkit-user-select: text;
    user-select: text;
  }
  body.vet-body a { color: inherit; }
</style>
) : isPack ? (
<style is:global>
  * { box-sizing: border-box; }
  html, body.pack-body {
    margin: 0;
    min-height: 100%;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    background: #fbf4e6;
    -webkit-user-select: none;
    user-select: none;
  }
  body.pack-body :is(
    input:not([type="button"]):not([type="submit"]):not([type="reset"]),
    textarea,
    a[href^="mailto:"],
    a[href^="tel:"]
  ) {
    -webkit-user-select: text;
    user-select: text;
  }
  body.pack-body a { color: inherit; }
</style>
) : isEditorial ? (
<style is:global>
  * { box-sizing: border-box; }
  html, body.editorial-body {
    margin: 0;
    min-height: 100%;
    font-family: Outfit, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    color: #161410;
    background: #fbf8f2;
    -webkit-user-select: none;
    user-select: none;
  }
  body.editorial-body :is(
    input:not([type="button"]):not([type="submit"]):not([type="reset"]),
    textarea,
    a[href^="mailto:"],
    a[href^="tel:"]
  ) {
    -webkit-user-select: text;
    user-select: text;
  }
  body.editorial-body a { color: inherit; }
</style>
) : isService ? (
<style is:global>
  * { box-sizing: border-box; }
  html, body.service-body {
    margin: 0;
    min-height: 100%;
    font-family: "Source Sans 3", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    color: #0f172a;
    background: #f4f7fb;
    -webkit-user-select: none;
    user-select: none;
  }
  body.service-body :is(
    input:not([type="button"]):not([type="submit"]):not([type="reset"]),
    textarea,
    a[href^="mailto:"],
    a[href^="tel:"]
  ) {
    -webkit-user-select: text;
    user-select: text;
  }
  body.service-body a { color: inherit; }
</style>
) : isTech ? (
<style is:global>
  * { box-sizing: border-box; }
  html, body.tech-body {
    margin: 0;
    min-height: 100%;
    font-family: "DM Sans", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    color: #1c1c1c;
    background: #f4efe4;
    -webkit-user-select: none;
    user-select: none;
  }
  body.tech-body :is(
    input:not([type="button"]):not([type="submit"]):not([type="reset"]),
    textarea,
    a[href^="mailto:"],
    a[href^="tel:"]
  ) {
    -webkit-user-select: text;
    user-select: text;
  }
  body.tech-body a { color: inherit; }
</style>
) : (
<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body.landing-body {
    margin: 0;
    min-height: 100%;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    color: #fff;
    background: linear-gradient(180deg, #01061d, #01092b);
    -webkit-user-select: none;
    user-select: none;
  }
  body.landing-body :is(
    input:not([type="button"]):not([type="submit"]):not([type="reset"]),
    textarea,
    a[href^="mailto:"],
    a[href^="tel:"]
  ) {
    -webkit-user-select: text;
    user-select: text;
  }

  a {
    color: #60a5fa;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
)}
