---
/**
 * Public inner-page layout — same chrome as Layout, plus the site help chat
 * when `portal_assistant` is enabled. Homepage service landings mount their
 * own docked trigger; /demo-loader uses Layout.astro directly so this stays off.
 */
import Layout from "./Layout.astro";
import type { Props as LayoutProps } from "./Layout.astro";
import SiteAssistantWidget from "../components/SiteAssistantWidget.astro";
import { getCompanyConfig } from "../lib/companyConfig";
import { hasFeature } from "../lib/features";
import { isSiteAssistantConfigured } from "../lib/siteAssistant";

export type Props = LayoutProps & {
  /** Set false to hide the floating site assistant on this page. */
  showSiteAssistant?: boolean;
};

const props = Astro.props;
const { showSiteAssistant: showSiteAssistantProp, ...layoutProps } = props;
const company = await getCompanyConfig(Astro.request);
const showSiteAssistant =
  showSiteAssistantProp !== false &&
  hasFeature("portal_assistant") &&
  isSiteAssistantConfigured();
---

<Layout {...layoutProps}>
  <slot />
  {
    showSiteAssistant && (
      <SiteAssistantWidget
        slot="end"
        brandTitle={company.name}
        supportPhone={company.supportPhone}
        supportEmail={company.supportEmail}
        pagePath={Astro.url.pathname}
      />
    )
  }
</Layout>
