---
import Header from "../components/Header.astro";
import HomepageSectionScroll from "../components/HomepageSectionScroll.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteAssistantWidget from "../components/SiteAssistantWidget.astro";
import Favicon from "../components/Favicon.astro";
import BrandFontHead from "../components/BrandFontHead.astro";
import SiteBackground from "../components/SiteBackground.astro";
import { SITE } from "../config/site";
import { LOGO_ICON_OG_PATH } from "../lib/companyLogo";
import { companyHtmlStyleAttr } from "../lib/companyBrandColors";
import { getCompanyConfig, companyOgImageUrl } from "../lib/companyConfig";
import { hasFeature } from "../lib/features";
import { isSiteAssistantConfigured } from "../lib/siteAssistant";
import { isMarketingPagePath, getSiteContent } from "../lib/siteContent";
import { requestOrigin } from "../lib/requestOrigin";
import ViewportMeta from "../components/ViewportMeta.astro";
import "../styles/brand.css";

export interface Props {
  /** Page-specific title. Rendered as "Page | {company name}". Omit to show just the company name. */
  title?: string;
  /** Meta description for search results and OG cards. */
  description?: string;
  /**
   * Absolute or root-relative path to the OG / social-share image.
   * Defaults to SITE.ogImage.
   */
  ogImage?: string;
  /** OG type. Defaults to "website". */
  ogType?: "website" | "article";
  /** Override the canonical URL. Defaults to the current request URL. */
  canonicalUrl?: string;
  /**
   * Set true on private or internal pages (dev tools, client portals, etc.)
   * that should not appear in search engines.
   */
  noIndex?: boolean;
	/** Initial `<meta name="theme-color">`. Defaults to --site-status-bar black. */
  themeColor?: string;
}

const {
  title,
  description: descriptionProp,
  ogImage: ogImageProp,
  ogType = SITE.ogType,
  canonicalUrl,
  noIndex = false,
  themeColor = "#000000",
} = Astro.props;

const company = await getCompanyConfig(Astro.request);
const siteContent = getSiteContent();
const description = descriptionProp ?? company.description;
const ogImage = ogImageProp ?? companyOgImageUrl(company);
/** Browser tab title — "Page | Company | Tagline" (tagline from admin → Company → description). */
const titleParts = [title, company.name, company.description]
  .map((part) => part?.trim())
  .filter((part, i, arr): part is string => Boolean(part) && arr.indexOf(part) === i);
const pageTitle = titleParts.join(" | ");
/** Link-preview title — page name on inner pages, company name on homepage. */
const shareTitle = title?.trim() || company.name;
/** Omit on homepage: og:site_name + og:title with the same value renders as "Name · Name" in iMessage/Slack. */
const shareSiteName = title?.trim() ? company.name : undefined;
const origin = requestOrigin(Astro.request);
const publicOrigin = company.domain ? `https://${company.domain}` : origin;
const canonical =
  canonicalUrl ?? `${publicOrigin}${Astro.url.pathname}${Astro.url.search}`;
const ogImageAbsolute = ogImage.startsWith("http")
  ? ogImage
  : `${origin}${ogImage}`;
/** Animated GIFs are a poor OG preview — fall back to the static logo mark. */
const ogImageSafe = /\.gif(?:\?|$)/i.test(ogImageAbsolute)
  ? `${origin}${LOGO_ICON_OG_PATH}`
  : ogImageAbsolute;

const pathNorm = Astro.url.pathname.replace(/\/$/, "") || "/";
const isIndexPage = pathNorm === "/" || pathNorm === "/index.html";
const marketingNav = isMarketingPagePath(Astro.url.pathname, siteContent);
const showLegalLinks = isIndexPage ? siteContent.homepage.showLegalLinks !== false : true;
/** Help chat FAB on secondary marketing pages only — homepage traffic rarely opens it. */
const showSiteAssistant =
  !isIndexPage && hasFeature("portal_assistant") && isSiteAssistantConfigured();
const userId = Astro.locals.auth()?.userId ?? null;
---

<!doctype html>
<html lang="en" style={companyHtmlStyleAttr(company.fonts, company.brandPrimary, company.brandSecondary)}>
	<head>
		<meta charset="UTF-8" />
		<ViewportMeta />
		<meta name="theme-color" content={themeColor} />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="generator" content={Astro.generator} />

		<!-- Favicons -->
		<Favicon />

		<BrandFontHead fonts={company.fonts} />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noIndex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:title" content={shareTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageSafe} />
		{shareSiteName && <meta property="og:site_name" content={shareSiteName} />}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={shareTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageSafe} />
	</head>
	<body data-user-id={userId ?? ""}>
		<SiteBackground />
		<Header marketingNav={marketingNav} siteContent={siteContent} />
		<main id="main-content">
			{/*
			  Fallback page title for layouts that do not render their own h1.
			  Skip on the homepage — HomeHeroSection already provides the real h1,
			  and a second one breaks the heading outline (and reads as a smaller
			  title before later section headlines).
			*/}
			{!isIndexPage && <h1 class="sr-only">{company.name}</h1>}
			<slot />
			<div class="site-foot-wrap">
				<SiteFooter showLegalLinks={showLegalLinks} />
			</div>
		</main>
		{marketingNav && <HomepageSectionScroll />}
		{
			showSiteAssistant && (
				<SiteAssistantWidget
					brandTitle={company.name}
					supportPhone={company.supportPhone}
					supportEmail={company.supportEmail}
					pagePath={Astro.url.pathname}
				/>
			)
		}
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	/*
	 * Device canvas + viable area
	 * -----------------------------
	 * --device-height: full hardware fold (large viewport), including the strips
	 * under the status bar / home indicator when viewport-fit=cover is on.
	 * --viable-*: the interactive content box inside env(safe-area-inset-*).
	 * Background paint must cover --device-height; chrome/content pad to --viable-*.
	 *
	 * Do NOT lock html/body to height:100dvh/100lvh — that reflows the layout
	 * viewport and shears position:fixed headers. Use min-height only so the
	 * paint box is at least one device tall and can still grow with content.
	 *
	 * background-color on html is true black (--site-status-bar) so the iOS
	 * inset matches; body keeps --site-canvas for the fold below the fade.
	 * Atmosphere is viewport-fixed so the black→purple band stays under the
	 * status bar while content scrolls.
	 */
	:root {
		--safe-top: env(safe-area-inset-top, 0px);
		--safe-right: env(safe-area-inset-right, 0px);
		--safe-bottom: env(safe-area-inset-bottom, 0px);
		--safe-left: env(safe-area-inset-left, 0px);
		--device-height: 100vh;
		--device-height: -webkit-fill-available;
		--device-height: 100dvh;
		--device-height: 100lvh;
		--viable-top: var(--safe-top);
		--viable-right: var(--safe-right);
		--viable-bottom: var(--safe-bottom);
		--viable-left: var(--safe-left);
		--viable-height: calc(
			var(--device-height) - var(--safe-top) - var(--safe-bottom)
		);
	}

	html {
		/*
		 * Do NOT set height:100% — on iOS Safari that locks the root to a short
		 * initial containing block, so the inspector shows <html>/<body> ending
		 * above the toolbar and color-scheme:dark paints the gap black.
		 * min-height through 100lvh fills the large (chrome-collapsed) viewport
		 * so the canvas paints under the status bar and home indicator too.
		 */
		min-height: 100%;
		min-height: -webkit-fill-available;
		min-height: 100dvh;
		min-height: 100lvh;
		min-height: var(--device-height);
		background-color: var(--site-status-bar, #000000);
		background-image: var(--site-mesh-atmosphere);
		background-repeat: no-repeat;
		background-attachment: fixed;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		font-family: var(--font-content);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		/*
		 * Kill rubber-band overscroll so position:fixed header chrome does not
		 * shear/clip under Safari (macOS + iOS). Matches admin shell.
		 */
		overscroll-behavior-y: none;
		/*
		 * Default every page to the dark theme (matches the homepage) so pages
		 * never fall back to the browser's white default — which otherwise
		 * causes white text (styled for a dark background) to render invisibly
		 * on a white page. Pages can still override this per-element as needed.
		 * Use background-color (not the background shorthand) so Safari’s
		 * chrome/overscroll sampling stays predictable on iOS 26+.
		 * TODO: replace with a proper color-mode/theme variable system.
		 */
		background-color: var(--site-canvas, #0c0614);
		color: #e5e5e5;
		color-scheme: dark;
	}

	body {
		/*
		 * Same fill stack as html. Grow with content beyond the fold.
		 * Avoid height locks (100dvh/100lvh) — those shear fixed headers.
		 */
		min-height: 100%;
		min-height: -webkit-fill-available;
		min-height: 100dvh;
		min-height: 100lvh;
		min-height: var(--device-height);
		position: relative;
		/*
		 * Viewport-fixed atmosphere: black at the top (matches the status-bar
		 * inset), easing into purple glows. Content scrolls over this layer.
		 */
		background-image: var(--site-mesh-atmosphere);
		background-repeat: no-repeat;
		background-attachment: fixed;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: var(--font-primary);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/*
	 * Interactive chrome — prevent accidental text/emoji selection on tap (esp. iOS).
	 * Content areas (inputs, textareas, article copy) stay selectable by default.
	 */
	button:not(:disabled),
	input[type="button"],
	input[type="submit"],
	input[type="reset"],
	input[type="checkbox"],
	input[type="radio"],
	select,
	summary,
	[role="button"] {
		-webkit-user-select: none;
		user-select: none;
		-webkit-touch-callout: none;
	}

	.app-header,
	.app-header a,
	.app-header button {
		-webkit-user-select: none;
		user-select: none;
		-webkit-touch-callout: none;
	}

	button svg,
	a[aria-label] svg,
	[role="button"] svg {
		-webkit-user-select: none;
		user-select: none;
	}

	.site-foot-wrap {
		max-width: 920px;
		margin: 0 auto;
		padding: 0 24px calc(24px + var(--viable-bottom, env(safe-area-inset-bottom, 0px)));
	}

	/*
	 * Page content above the fixed chevron pattern (z-index 1) so text is not
	 * clipped by the tile layer when it slides under the transparent header.
	 */
	main#main-content {
		position: relative;
		z-index: 2;
	}
</style>
