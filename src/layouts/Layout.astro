---
import Header from "../components/Header.astro";
import HomepageSectionScroll from "../components/HomepageSectionScroll.astro";
import ScrollFadeIn from "../components/ScrollFadeIn.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteAssistantWidget from "../components/SiteAssistantWidget.astro";
import Favicon from "../components/Favicon.astro";
import BrandFontHead from "../components/BrandFontHead.astro";
import SiteBackground from "../components/SiteBackground.astro";
import { SITE } from "../config/site";
import { BRANDING_OG_PATH, LOGO_ICON_OG_PATH } from "../lib/companyLogo";
import { OG_IMAGE_HEIGHT as PORTAL_OG_HEIGHT, OG_IMAGE_WIDTH as PORTAL_OG_WIDTH } from "../lib/ogImageSize";
import { companyHtmlStyleAttr } from "../lib/companyBrandColors";
import { getCompanyConfig, companyOgImageUrl } from "../lib/companyConfig";
import { shareSafeText } from "../lib/shareSafeText";
import { hasFeature } from "../lib/features";
import { isSiteAssistantConfigured } from "../lib/siteAssistant";
import { isMarketingPagePath, getSiteContent } from "../lib/siteContent";
import { requestOrigin } from "../lib/requestOrigin";
import ViewportMeta from "../components/ViewportMeta.astro";
import CookieNotice from "../components/CookieNotice.astro";
import ThemeInit from "../components/ThemeInit.astro";
import "../styles/brand.css";

export interface Props {
  /** Page-specific title. Rendered as "Page | {company name}". Omit to show just the company name. */
  title?: string;
  /** Meta description for search results and OG cards. */
  description?: string;
  /**
   * Absolute or root-relative path to the OG / social-share image.
   * Overrides the Company default (admin → Company → Social sharing).
   */
  ogImage?: string;
  /** OG type. Defaults to "website". */
  ogType?: "website" | "article";
  /** Override the canonical URL. Defaults to the current request URL. */
  canonicalUrl?: string;
  /**
   * Set true on private or internal pages (dev tools, client portals, etc.)
   * that should not appear in search engines.
   */
  noIndex?: boolean;
	/** Initial `<meta name="theme-color">`. Canvas-matched so Safari chrome is not a black bar. */
  themeColor?: string;
  /**
   * Paint under the overlay header (homepage hero, forms with their own pad).
   * Default: homepage only. Inner pages get one shared header clearance on
   * `main` so they don't each invent `100vh` / `64px` wrappers.
   */
  fullBleed?: boolean;
}

const {
  title,
  description: descriptionProp,
  ogImage: ogImageProp,
  ogType = SITE.ogType,
  canonicalUrl,
  noIndex = false,
	themeColor: themeColorProp,
  fullBleed: fullBleedProp,
} = Astro.props;

const company = await getCompanyConfig(Astro.request);
const themeColor = themeColorProp ?? "#ffffff";
const siteContent = getSiteContent();
const description = descriptionProp ?? company.description;
const ogImage = ogImageProp ?? companyOgImageUrl(company);
/** Browser tab title — "Page | Company | Tagline" (tagline from admin → Company → description). */
const titleParts = [title, company.name, company.description]
  .map((part) => shareSafeText(part?.trim() ?? ""))
  .filter((part, i, arr): part is string => Boolean(part) && arr.indexOf(part) === i);
const pageTitle = titleParts.join(" | ");
/** Link-preview title — page name on inner pages, company name on homepage. ASCII-folded so iMessage does not render reΛVe as re/\Ve. */
const shareTitle = shareSafeText(title?.trim() || company.name);
/** Omit on homepage: og:site_name + og:title with the same value renders as "Name · Name" in iMessage/Slack. */
const shareSiteName = title?.trim() ? shareSafeText(company.name) : undefined;
const origin = requestOrigin(Astro.request);
const publicOrigin = company.domain ? `https://${company.domain}` : origin;
const canonical =
  canonicalUrl ?? `${publicOrigin}${Astro.url.pathname}${Astro.url.search}`;
const ogImageAbsolute = ogImage.startsWith("http")
  ? ogImage
  : `${origin}${ogImage}`;
/** Animated GIFs are a poor OG preview — fall back to the static logo mark. */
const ogImageSafe = /\.gif(?:\?|$)/i.test(ogImageAbsolute)
  ? `${origin}${LOGO_ICON_OG_PATH}`
  : ogImageAbsolute;
const isCompanyOg = ogImage.split("?")[0] === BRANDING_OG_PATH;

const pathNorm = Astro.url.pathname.replace(/\/$/, "") || "/";
const isIndexPage = pathNorm === "/" || pathNorm === "/index.html";
const fullBleed = fullBleedProp ?? isIndexPage;
const marketingNav = isMarketingPagePath(Astro.url.pathname, siteContent);
const showLegalLinks = isIndexPage ? siteContent.homepage.showLegalLinks !== false : true;
const showSiteAssistant =
	hasFeature("portal_assistant") && isSiteAssistantConfigured();
const userId = Astro.locals.auth()?.userId ?? null;
---

<!doctype html>
<html
		lang="en"
		class:list={[
			marketingNav && "site-marketing",
			isIndexPage && "site-home",
			!fullBleed && "site-page",
		]}
		style={companyHtmlStyleAttr(company.fonts, company.brandPrimary, company.brandSecondary)}
	>
	<head>
		<ThemeInit />
		<meta charset="UTF-8" />
		<ViewportMeta />
		<meta name="theme-color" content={themeColor} />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="generator" content={Astro.generator} />

		<!-- Favicons -->
		<Favicon />

		<BrandFontHead fonts={company.fonts} />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noIndex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:title" content={shareTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageSafe} />
		{isCompanyOg && <meta property="og:image:width" content={String(PORTAL_OG_WIDTH)} />}
		{isCompanyOg && <meta property="og:image:height" content={String(PORTAL_OG_HEIGHT)} />}
		{shareSiteName && <meta property="og:site_name" content={shareSiteName} />}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={shareTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageSafe} />
	</head>
	<body data-user-id={userId ?? ""}>
		<SiteBackground />
		<Header marketingNav={marketingNav} siteContent={siteContent} />
		<main id="main-content">
			{/*
			  Fallback page title for layouts that do not render their own h1.
			  Skip on the homepage — HomeHeroSection already provides the real h1,
			  and a second one breaks the heading outline (and reads as a smaller
			  title before later section headlines).
			*/}
			{!isIndexPage && <h1 class="sr-only">{company.name}</h1>}
			<slot />
			<div class="site-foot-wrap" data-no-scroll-fade>
				<SiteFooter showLegalLinks={showLegalLinks} />
			</div>
		</main>
		{marketingNav && <HomepageSectionScroll />}
		<ScrollFadeIn />
		<CookieNotice />
		{
			showSiteAssistant && (
				<SiteAssistantWidget
					brandTitle={company.name}
					supportPhone={company.supportPhone}
					supportEmail={company.supportEmail}
					pagePath={Astro.url.pathname}
					hideFabForHero={isIndexPage}
				/>
			)
		}
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	:root {
		--safe-top: env(safe-area-inset-top, 0px);
		--safe-right: env(safe-area-inset-right, 0px);
		--safe-bottom: env(safe-area-inset-bottom, 0px);
		--safe-left: env(safe-area-inset-left, 0px);
		--device-height: 100vh;
		--viable-top: var(--safe-top);
		--viable-right: var(--safe-right);
		--viable-bottom: var(--safe-bottom);
		--viable-left: var(--safe-left);
		--viable-height: calc(
			var(--device-height) - var(--safe-top) - var(--safe-bottom)
		);
	}

	html {
		/*
		 * Do not lock html to 100vh. That sizes the document to Safari’s
		 * layout viewport, which excludes the overlay status bar / toolbar —
		 * scrolling content never enters the upper safe area. Let the
		 * document grow; viewport-fit=cover then paints into the chrome.
		 * Do not set overscroll-behavior or overflow-y here — either one
		 * kills iOS pull-to-refresh.
		 */
		min-height: 100%;
		background-color: var(--site-canvas, #fff);
	}

	html,
	body {
		margin: 0;
		width: 100%;
		font-family: var(--font-content);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		/*
		 * Explicit root color is Safari 26’s Liquid Glass fallback. Pad
		 * header / CTAs with env(safe-area-inset-*), not the wallpaper.
		 */
		background-color: var(--site-canvas, #fff);
		color: var(--site-fg, #171717);
		color-scheme: light dark;
	}

	html[data-theme="light"] {
		color-scheme: light;
	}

	html[data-theme="dark"] {
		color-scheme: dark;
	}

	body {
		min-height: 100%;
		position: relative;
		background-color: var(--site-canvas, #fff);
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: var(--font-primary);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/*
	 * Interactive chrome — prevent accidental text/emoji selection on tap (esp. iOS).
	 * Content areas (inputs, textareas, article copy) stay selectable by default.
	 */
	button:not(:disabled),
	input[type="button"],
	input[type="submit"],
	input[type="reset"],
	input[type="checkbox"],
	input[type="radio"],
	select,
	summary,
	[role="button"],
	.brand-btn,
	.brand-btn-glass,
	.fx-chip,
	.fx-btn,
	a[class*="-btn"],
	a[class*="-cta"] {
		-webkit-user-select: none;
		user-select: none;
		-webkit-touch-callout: none;
	}

	.app-header,
	.app-header a,
	.app-header button {
		-webkit-user-select: none;
		user-select: none;
		-webkit-touch-callout: none;
	}

	button svg,
	a[aria-label] svg,
	[role="button"] svg {
		-webkit-user-select: none;
		user-select: none;
	}

	.site-foot-wrap {
		max-width: 920px;
		margin: 0 auto;
		padding: 0 24px calc(24px + var(--viable-bottom, env(safe-area-inset-bottom, 0px)));
	}

	body:has(.about-page) .site-foot-wrap {
		max-width: none;
		width: 100%;
		background: #000;
		padding: 32px 24px calc(28px + var(--viable-bottom, env(safe-area-inset-bottom, 0px)));
	}

	body:has(.about-page) .site-foot {
		margin-top: 0;
		color: rgba(255, 255, 255, 0.68);
	}

	body:has(.about-page) .site-legal-links-sep {
		color: rgba(255, 255, 255, 0.4);
	}

	body:has(.about-page) .site-legal-links-link {
		color: rgba(255, 255, 255, 0.62);
	}

	body:has(.about-page) .site-legal-links-link:hover {
		color: rgba(255, 255, 255, 0.92);
	}

	/*
	 * Page content above the fixed atmosphere (z-index 0). The public
	 * header is out of flow, so the homepage hero already starts at the
	 * viewport top — do not pull main up there.
	 */
	main#main-content {
		position: relative;
		z-index: 2;
	}

	/*
	 * One header clearance for every inner public page. Do not min-height
	 * 100vh on page shells — that sizes to Safari’s layout viewport and
	 * keeps scrolling content out of the overlay status bar. Homepage
	 * (site-home / fullBleed) stays edge-to-edge under the header.
	 */
	html.site-page main#main-content {
		padding-top: calc(
			var(--app-header-offset, calc(var(--app-header-h, 3.25rem) + env(safe-area-inset-top, 0px))) +
				var(--site-page-pad-top, 40px)
		);
	}

	@media (min-width: 769px) {
		html,
		body {
			background-color: var(--site-canvas, #fff);
		}
	}
</style>
