---
/** Minimal document for HTML fragments fetched client-side (no site chrome). */
interface Props {
  title?: string;
}

const { title = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    {title ? <title>{title}</title> : null}
  </head>
  <body>
    <slot />
  </body>
</html>
