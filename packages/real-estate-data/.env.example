# Provider selection — mock | propdata | assessorsearch | attom
REAL_ESTATE_DATA_PROVIDER=mock

# ATTOM (30-day trial) — https://api.developer.attomdata.com/
# REAL_ESTATE_DATA_PROVIDER=attom
# ATTOM_API_KEY=

# PropData (recommended primary) — https://propdata.proptechusa.ai/docs
# RapidAPI: https://rapidapi.com/propdata-propdata-default/api/propdata-real-estate-market-intelligence-api
PROPDATA_API_KEY=
PROPDATA_BASE_URL=https://propdata-api-worker.sales-fd3.workers.dev

# Violations — registry uses company office from admin (30 mi radius, top 50% municipalities)
# VIOLATIONS_PROVIDER=registry   # registry (default) | mock
# SOCRATA_APP_TOKEN=             # optional — higher Socrata rate limits
