{
  "name": "reave",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "VITE_USE_POLLING=1 astro dev",
    "dev:nopoll": "astro dev",
    "dev:railway": "railway run -- npm run dev",
    "railway:vars": "railway variable list -k > .env.railway",
    "sync:env": "bash scripts/sync-local-env.sh",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "sync:resend-dns": "node --experimental-strip-types scripts/sync-resend-dns.ts",
    "sync:vapi": "node --experimental-strip-types scripts/sync-vapi-assistant.ts",
    "seed:demo": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/seed-demo.ts",
    "deploy:checklist": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/generate-deploy-checklist.ts",
    "seed:bookings": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/seed-bookings.ts",
    "seed:site-media": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/seed-site-media.ts",
    "push:demo": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/send-demo-push.ts",
    "prebuild": "node --experimental-strip-types scripts/sync-vapi-assistant.ts",
    "build": "astro build && node scripts/version-public-assets.mjs",
    "check": "astro check",
    "check:chat": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-chat-resilience.ts",
    "check:chat-nav": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-chat-button-nav.ts",
    "check:agent-model": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-agent-model.ts",
    "check:drain": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-agent-run-drain.ts",
    "check:notif-dedupe": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-dashboard-notification-dedupe.ts",
    "check:calendar-reminders": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-calendar-reminders.ts",
    "check:vault-merge": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-portal-vault.ts",
    "check:email-reply": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-email-reply.ts",
    "check:email-project-title": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-email-project-title.ts",
    "check:email-triage": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-email-triage-scenarios.ts",
    "check:email-meeting": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-email-meeting-parse.ts",
    "check:inbound-install": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-inbound-install.ts",
    "check:deploy-wizard": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-deploy-wizard.ts",
    "check:court-radius": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-court-radius.ts",
    "check:website-editor": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-website-editor-repo.ts",
    "check:visits": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-visit-planner.ts",
    "check:logo-contrast": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-logo-contrast-adapt.ts",
    "check:audit-report": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-audit-report-card.ts",
    "check:audit-notifications": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-audit-notifications.ts",
    "check:sales-sheet": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-audit-sales-sheet.ts",
    "check:media-thumb": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-media-pdf-thumb.ts",
    "check:module-groups": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-module-groups.ts",
    "deck:validate": "node --experimental-strip-types src/deck/validate-cli.ts",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "logos:replaced-apps": "node scripts/fetch-replaced-app-logos.mjs",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.24",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@astrojs/node": "^11.1.1",
    "@astrojs/react": "^6.0.2",
    "@clerk/astro": "^4.0.11",
    "@clerk/ui": "^1.23.0",
    "@napi-rs/canvas": "^1.0.6",
    "@reave/plugin-real-estate-data": "file:packages/real-estate-data",
    "@svgdotjs/svg.js": "^3.2.8",
    "@vapi-ai/web": "^2.5.2",
    "astro": "^7.2.1",
    "cheerio": "^1.2.0",
    "lucide-astro": "^0.556.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.20.0",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "ssh2": "^1.17.0",
    "three": "^0.160.0",
    "unified": "^11.0.5",
    "web-push": "^3.6.7",
    "whois-json": "^2.0.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@types/three": "^0.160.0",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.9.3"
  }
}
