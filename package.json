{
  "name": "reave",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "VITE_USE_POLLING=1 astro dev",
    "dev:nopoll": "astro dev",
    "dev:railway": "railway run -- npm run dev",
    "railway:vars": "railway variable list -k > .env.railway",
    "sync:env": "bash scripts/sync-local-env.sh",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "sync:resend-dns": "node --experimental-strip-types scripts/sync-resend-dns.ts",
    "sync:vapi": "node --experimental-strip-types scripts/sync-vapi-assistant.ts",
    "seed:demo": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/seed-demo.ts",
    "deploy:checklist": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/generate-deploy-checklist.ts",
    "seed:bookings": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/seed-bookings.ts",
    "push:demo": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/send-demo-push.ts",
    "portfolio:optimize": "node scripts/optimize-portfolio-images.mjs",
    "prebuild": "node --experimental-strip-types scripts/sync-vapi-assistant.ts && node scripts/optimize-portfolio-images.mjs",
    "build": "astro build && node scripts/version-public-assets.mjs",
    "check": "astro check",
    "check:chat": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-chat-resilience.ts",
    "check:notif-dedupe": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-dashboard-notification-dedupe.ts",
    "check:visits": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-visit-planner.ts",
    "check:logo-contrast": "node --import ./scripts/ts-extensionless-resolve.mjs --experimental-strip-types scripts/verify-logo-contrast-adapt.ts",
    "deck:validate": "node --experimental-strip-types src/deck/validate-cli.ts",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "logos:replaced-apps": "node scripts/fetch-replaced-app-logos.mjs",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.24",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^6.0.0",
    "@clerk/astro": "^3.4.2",
    "@clerk/ui": "^1.23.0",
    "@reave/plugin-real-estate-data": "file:packages/real-estate-data",
    "@svgdotjs/svg.js": "^3.2.8",
    "@vapi-ai/web": "^2.5.2",
    "astro": "^5.14.8",
    "cheerio": "^1.2.0",
    "lucide-astro": "^0.556.0",
    "pg": "^8.20.0",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "three": "^0.160.0",
    "web-push": "^3.6.7",
    "whois-json": "^2.0.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.160.0",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.9.3"
  }
}
