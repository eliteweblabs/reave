# Copy to .env for local docker compose testing

# HTTP port (Railway sets PORT automatically)
PORT=8080

# Public URL shown to browsers (compose sets http://localhost:8080/)
# GALENE_PUBLIC_URL=https://your-app.up.railway.app/

# Server admin (galenectl / admin API)
GALENE_ADMIN_USERNAME=admin
GALENE_ADMIN_PASSWORD=change-me-admin

# Default room /group/meet/ — moderator login
GALENE_GROUP_PASSWORD=change-me-host

# TURN (required on Railway for reliable calls)
# After adding a Railway TCP proxy on application port 1194, set:
# GALENE_TURN_PUBLIC=your-tcp-proxy.up.railway.app:12345
# Railway TCP proxy application port must be 3478 (not 1194 — Railway binds that internally)
GALENE_TURN_USERNAME=galene
GALENE_TURN_PASSWORD=change-me-turn

# Force all WebRTC media through TURN (recommended on Railway)
GALENE_RELAY_ONLY=1

# Optional
# GALENE_DEFAULT_GROUP=meet
# GALENE_CANONICAL_HOST=meet.example.com
# GALENE_UDP_MUX_PORT=50000
