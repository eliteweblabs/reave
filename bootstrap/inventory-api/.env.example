# Required
API_KEY=change-me

# Optional
APP_NAME=inventory-api
HOST=0.0.0.0
PORT=8080
ALLOWED_ORIGINS=*
CACHE_TTL_SECONDS=300
MOCK_PROVIDER=1

# Shopify (live sync — ships when client enables inventory_sync)
# SHOPIFY_SHOP=your-store.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_...

# WooCommerce (per-store REST credentials)
# WOOCOMMERCE_URL=https://shop.example.com
# WOOCOMMERCE_KEY=ck_...
# WOOCOMMERCE_SECRET=cs_...

# Square Catalog + Inventory
# SQUARE_ACCESS_TOKEN=EAAA...
# SQUARE_LOCATION_ID=L...
